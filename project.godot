; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="JoJo's Fish game"
run/main_scene="res://scenes/boot.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"
config/use_custom_user_dir.template=true
config/custom_user_dir_name.template="JoJosFishGame"

[autoload]

Settings="*res://Scripts/Core/settings.gd"
SceneLoader="*res://Scripts/Core/scene_loader.gd"
Skills="*res://Scripts/Core/skills.gd"
StandMemory="*res://Scripts/Core/stand_memory.gd"
Story="*res://Scripts/Core/story.gd"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/custom="res://assets/ui/menu_theme.tres"

