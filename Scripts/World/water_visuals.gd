# The water's splashes (water.gd, its parent): every splash() throws up droplets (water_splash.gd) where
# it broke the surface, sized by its strength. The rings spreading from it are the water's own ripples.
# Purely presentation: it only listens to the water's `splashed`.
# Generated by Claude Code.
extends Node

const WaterSplash := preload("res://Scripts/Water/water_splash.gd")

@export var min_strength := 0.05 ## Weaker splashes than this make rings but no droplets.

@onready var water: Node3D = get_parent()


func _ready() -> void:
	water.splashed.connect(_on_splashed)


func _on_splashed(point: Vector3, strength: float) -> void:
	if strength < min_strength:
		return
	var splash := WaterSplash.new()
	var scene := get_tree().current_scene if get_tree().current_scene else get_tree().root
	scene.add_child(splash)
	splash.global_position = point
	splash.play(strength)
