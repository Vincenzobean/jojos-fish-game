# A floating target dummy for testing stand attacks on something physical (scenes/target_dummy.tscn;
# spawned with F2 in debug builds, debug_dummy_spawner.gd). A real rigid body, so punches (stand_combat.gd)
# shove it, and their take_stand_hit() hook tells it about each hit: it rocks back from the blow,
# then floats back to where it was put and turns upright again, like a sandbag on a spring. It counts
# the damage, and hits that come within combo_time of each other as one combo.
#
# It fights back: when a summoned stand (the "summoned_stands" group, possession.gd) comes within
# punch_range it turns to face it and, every punch_interval, winds up (the tell), then throws a straight
# punch in front of it, hitting any stand there through its take_stand_hit() (the same dictionary stands
# hit with). Hitting it during the windup knocks the punch off. fights_back turns this off.
# It learns like every opponent (StandMemory, stand_memory.gd), by what's known of the kind of stand it's
# fighting: the more familiar that stand, the more often it punches and the quicker its windup, and when
# the player makes a choice it may read what they usually choose next and punch early into it, or hold
# its punch until that's over (`read`), learning which works.
#
# It can be beaten: hits wear down its health, and at 0 it's `defeated` (it stops fighting and crumbles
# away and is freed). Behind it stands its "stand user" (dummy_user.gd), whom the stand that beat it
# finishes (stand_combat.gd target_defeated, Scripts/Stands/Finisher/): get_stand_user().
#
# Gameplay only: target_dummy_visuals.gd (its "Visuals" child) draws it and shows the numbers.
# Generated by Claude Code.
extends RigidBody3D

## A hit landed (the hit dictionary stand_combat.gd sends: damage, knockback, direction, point, move, stand).
signal hit_taken(hit: Dictionary)
## A combo ended: no hit for combo_time.
signal combo_ended(hits: int, damage: float)
## It started winding up a punch (the tell)...
signal punch_windup
## ...threw it (`landed` if it hit a stand)...
signal punch_thrown(landed: bool)
## ...or was hit out of its windup, and the punch is off.
signal punch_cancelled
## Its health ran out (`hit` the last blow): it crumbles away.
signal defeated(hit: Dictionary)
## It read the player's next choice (`predicted`) and is winding up to punch, early or held (`response`).
signal read(predicted: StringName, response: String)

const StandShape := preload("res://Scripts/Stands/stand_shape.gd")
## How it can answer each choice it reads the player is about to make.
const READ_RESPONSES := {
	&"open": ["punch_early", "hold"], &"chain": ["punch_early", "hold"], &"rush": ["punch_early", "hold"],
	&"dash": ["punch_early", "hold"], &"heavy": ["punch_early", "hold"], &"finisher": ["punch_early", "hold"],
	&"barrage": ["hold"], &"special": ["hold"], &"block": ["hold"], &"stop": ["punch_early"],
}

enum Fight { IDLE, WINDUP, PUNCH, RECOVER }

@export var spring := 16.0 ## How hard it's pulled back to its spot (per second squared, per meter)...
@export var damping := 4.0 ## ...and how quickly its swinging dies down (per second).
@export var upright_spring := 30.0 ## How hard it turns back to how it was put...
@export var upright_damping := 5.0 ## ...and how quickly its rocking dies down.
@export var knockback_taken := 0.35 ## Share of a hit's knockback it keeps, so it stays in reach for combos.
@export var rock := 0.25 ## Radians per second it rocks back per m/s of knockback.
@export var combo_time := 1.5 ## Seconds without a hit before a combo counts as over.
@export var max_health := 120.0
@export var user_scene: PackedScene = preload("res://scenes/dummy_user.tscn") ## Its stand user, standing behind it.
@export var user_distance := 3.0 ## Meters behind it its user stands.

@export_group("Fighting back")
@export var fights_back := true ## Punches at stands that come close (Ctrl+F2 toggles it, debug_dummy_spawner.gd).
@export var punch_range := 3.0 ## Meters to a stand's middle within which it starts a punch...
@export var punch_interval := 2.5 ## ...at most once every this many seconds.
@export var windup_time := 0.7 ## Seconds it winds up (the tell)...
@export var punch_time := 0.12 ## ...then the arm snaps out, hitting at the end...
@export var recover_time := 0.45 ## ...and comes back.
@export var punch_damage := 12.0
@export var punch_knockback := 8.0 ## m/s.
@export var punch_reach := 2.1 ## Meters in front of its middle the glove ends up; it hits all along the way...
@export var punch_radius := 0.55 ## ...anything within this of the arm's path.
@export var turn_speed := 4.0 ## How quickly it turns to face a stand nearby (per second).
@export var familiar_quickness := 0.36 ## Share its punch interval and windup shrink by against a fully familiar stand.
@export var hold_time := 0.6 ## Seconds a read answered by holding waits before winding up.

var home: Transform3D ## Where it floats back to.
var total_damage := 0.0
var health := 120.0
var combo_hits := 0
var combo_damage := 0.0
var _since_hit := 0.0
var _rocking := Vector3.ZERO # Spin from hits, added on the next physics step.
var fight := Fight.IDLE
var _fight_time := 0.0 # Seconds into the current stage of a punch.
var _punch_wait := 0.0 # Seconds until it may punch again.
var _defeated := false
var _user: Node3D
var _target_stand: Node3D # The stand it's facing (stand_body.gd), or null...
var _memory_key := "" # ...and its kind, what StandMemory knows it by.
var _read_left := -1.0 # Seconds until it acts on a read, or -1...
var _read_move: StringName = &"" # ...the choice it read the player making...
var _read_response := "" # ...and how it answers it.
var _judged_move: StringName = &"" # The read whose punch is under way, scored once it lands or is knocked off.
var _judged_response := ""


func _ready() -> void:
	gravity_scale = 0.0
	can_sleep = false
	home = global_transform
	add_to_group("target_dummies")
	add_to_group("stand_opponents") # What a stand learns to fight (possession.gd, StandMemory).
	health = max_health
	_spawn_user.call_deferred()


## Puts it somewhere new to float at.
func place(at: Transform3D) -> void:
	home = at
	global_transform = at
	linear_velocity = Vector3.ZERO
	angular_velocity = Vector3.ZERO
	_place_user()


## Called by stand_combat.gd for every hit that touches it (the knockback impulse is applied there).
func take_stand_hit(hit: Dictionary) -> void:
	var damage := float(hit.get("damage", 0.0))
	total_damage += damage
	combo_hits += 1
	combo_damage += damage
	_since_hit = 0.0
	var push: Vector3 = hit.get("knockback", Vector3.ZERO)
	apply_central_impulse(-push * (1.0 - knockback_taken) * mass) # Takes only part of the shove it was given.
	# Rocks back: its top swings away along the blow.
	var flat := Vector3(push.x, 0.0, push.z)
	_rocking += Vector3.UP.cross(flat) * rock
	health = maxf(health - damage, 0.0)
	hit_taken.emit(hit)
	if health <= 0.0 and not _defeated:
		_defeated = true
		fights_back = false
		fight = Fight.IDLE
		defeated.emit(hit)
		get_tree().create_timer(0.8, false).timeout.connect(queue_free) # Gone once it has crumbled.
		return
	if fight == Fight.WINDUP: # Hit out of its windup: the punch is off.
		_judge_read(-1.0)
		_set_fight(Fight.RECOVER)
		punch_cancelled.emit()


func _physics_process(delta: float) -> void:
	if combo_hits > 0:
		_since_hit += delta
		if _since_hit >= combo_time:
			combo_ended.emit(combo_hits, combo_damage)
			combo_hits = 0
			combo_damage = 0.0
	_fight_back(delta)


func _integrate_forces(state: PhysicsDirectBodyState3D) -> void:
	var step := state.step
	state.angular_velocity += _rocking
	_rocking = Vector3.ZERO
	# A damped spring back to its spot...
	var to_home := home.origin - state.transform.origin
	state.linear_velocity += (to_home * spring - state.linear_velocity * damping) * step
	# ...and its turn back to how it was put.
	var turn := (home.basis.get_rotation_quaternion() * state.transform.basis.get_rotation_quaternion().inverse()).normalized()
	if turn.w < 0.0:
		turn = -turn
	var angle := turn.get_angle()
	var axis := turn.get_axis() if angle > 0.0001 else Vector3.ZERO
	state.angular_velocity += (axis * angle * upright_spring - state.angular_velocity * upright_damping) * step


# Faces the nearest stand in range and punches it now and then: windup (the tell), punch, recover.
func _fight_back(delta: float) -> void:
	_fight_time += delta
	_punch_wait -= delta
	var target := _nearest_stand() if fights_back else null
	if target:
		var to := target.global_position - global_position
		to.y = 0.0
		if to.length() > 0.1:
			var facing := Basis.looking_at(to.normalized(), Vector3.UP)
			home.basis = home.basis.slerp(facing, 1.0 - exp(-turn_speed * delta)).orthonormalized()
	var known := StandMemory.familiarity(_memory_key) if target else 0.0
	var quicker := 1.0 - familiar_quickness * known
	_watch_stand(delta)
	match fight:
		Fight.IDLE:
			var reading := _read_left == 0.0
			if target and (_punch_wait <= 0.0 or reading):
				if reading:
					read.emit(_read_move, _read_response)
					_judged_move = _read_move
					_judged_response = _read_response
				_read_left = -1.0
				_set_fight(Fight.WINDUP)
				punch_windup.emit()
		Fight.WINDUP:
			if _fight_time >= windup_time * quicker:
				_set_fight(Fight.PUNCH)
		Fight.PUNCH:
			if _fight_time >= punch_time:
				var landed := _punch()
				_judge_read(1.0 if landed else -0.3)
				punch_thrown.emit(landed)
				_set_fight(Fight.RECOVER)
		Fight.RECOVER:
			if _fight_time >= recover_time:
				_set_fight(Fight.IDLE)
				_punch_wait = punch_interval * quicker


# A read waiting out its delay counts down.
func _watch_stand(delta: float) -> void:
	if _read_left > 0.0:
		_read_left = maxf(_read_left - delta, 0.0)


# The stand it faces made a choice (stand_combat.gd `action_taken`, or a dash): what does the player
# usually do next, from here? Read like every opponent does (StandMemory.read()) and answered with one of
# READ_RESPONSES, picked by how well each has worked against this stand: punching early into it, or
# holding the punch to throw it once that's over.
func _on_stand_action(action: StringName) -> void:
	if _read_left >= 0.0 or fight != Fight.IDLE or _memory_key == "" or not is_instance_valid(_target_stand):
		return
	var guess := StandMemory.read(_memory_key, action, _band())
	var predicted: StringName = guess["action"]
	if predicted == &"" or not READ_RESPONSES.has(predicted) or randf() >= float(guess["chance"]):
		return
	var response := StandMemory.pick_response(_memory_key, predicted, READ_RESPONSES[predicted])
	_read_left = float(guess["delay"]) + (hold_time if response == "hold" else 0.0)
	_read_move = predicted
	_read_response = response


# How far the stand is, sorted the way StandMemory.band() sorts the player's choices.
func _band() -> String:
	var torso: Node3D = _target_stand.get("torso")
	return StandMemory.band(torso.global_position.distance_to(global_position), StandShape.size(_target_stand))


# How the read's punch went, for StandMemory: it landed, missed, or was knocked off.
func _judge_read(score: float) -> void:
	if _judged_response != "":
		StandMemory.reward_response(_memory_key, _judged_move, _judged_response, score)
		_judged_response = ""


# Starts (or stops) hearing the choices `stand` makes, to read them.
func _listen_to(stand: Node3D, on: bool) -> void:
	if not is_instance_valid(stand):
		return
	var combat: Node = stand.get_node_or_null("Combat")
	if combat and combat.has_signal("action_taken") and combat.action_taken.is_connected(_on_stand_action) != on:
		if on:
			combat.action_taken.connect(_on_stand_action)
		else:
			combat.action_taken.disconnect(_on_stand_action)
	var controller: Node = stand.get_node_or_null("Controller")
	if controller and controller.has_signal("dashed") and controller.dashed.is_connected(_on_stand_dashed) != on:
		if on:
			controller.dashed.connect(_on_stand_dashed)
		else:
			controller.dashed.disconnect(_on_stand_dashed)


func _on_stand_dashed(_direction: Vector3) -> void:
	_on_stand_action(&"dash")


func _set_fight(stage: Fight) -> void:
	fight = stage
	_fight_time = 0.0


# The middle of the nearest summoned stand within punch_range that isn't being beaten, or null.
func _nearest_stand() -> Node3D:
	var best: Node3D = null
	var best_distance := punch_range
	for stand in get_tree().get_nodes_in_group("summoned_stands"):
		var torso: Node3D = stand.get("torso")
		if torso == null or not is_instance_valid(torso) or (stand.has_method("is_dying") and stand.is_dying()):
			continue
		var distance := torso.global_position.distance_to(global_position)
		if distance < best_distance:
			best = torso
			best_distance = distance
	var stand := best.get_parent() as Node3D if best else null
	if stand != _target_stand:
		_listen_to(_target_stand, false)
		_target_stand = stand
		_memory_key = stand.scene_file_path if stand else ""
		_read_left = -1.0
		_listen_to(stand, true)
	return best


# The punch shoots straight out in front of it: every stand anywhere along the arm's path, from its chest
# out to punch_reach, takes it (so one right up close is hit too). Returns whether any did.
func _punch() -> bool:
	var facing := StandShape.facing(self)
	var start := global_position + Vector3.UP * 0.2 + facing * 0.3 # Its front, where the arm sets off...
	var end := global_position + Vector3.UP * 0.2 + facing * punch_reach # ...to where the glove ends up.
	var path := CapsuleShape3D.new()
	path.radius = punch_radius
	path.height = start.distance_to(end) + punch_radius * 2.0
	var along := Basis(facing.cross(Vector3.UP).normalized(), facing, Vector3.ZERO)
	along.z = along.x.cross(along.y) # The capsule's axis (its Y) lies along the punch.
	var query := PhysicsShapeQueryParameters3D.new()
	query.shape = path
	query.transform = Transform3D(along, (start + end) * 0.5)
	query.exclude = [get_rid()]
	var struck: Array[Node] = []
	for result in get_world_3d().direct_space_state.intersect_shape(query, 16):
		var receiver := _hit_receiver(result["collider"])
		if receiver and receiver not in struck:
			struck.append(receiver)
			# It lands where the arm passes closest to what it hit.
			var target: Node3D = result["collider"]
			var point := Geometry3D.get_closest_point_to_segment(target.global_position, start, end)
			receiver.take_stand_hit({"damage": punch_damage, "knockback": facing * punch_knockback,
				"direction": facing, "point": point, "attacker": self})
	return not struck.is_empty()


# What a punch touching `node` hurts: the nearest node up from it with take_stand_hit() (a stand's body
# root, stand_body.gd), but never another dummy.
func _hit_receiver(node: Node) -> Node:
	while node and node != get_tree().current_scene:
		if node.has_method("take_stand_hit"):
			return null if node.is_in_group("target_dummies") else node
		node = node.get_parent()
	return null


## Whether its health has run out.
func is_defeated() -> bool:
	return _defeated


## Its stand user (dummy_user.gd), for a finisher; null if it has none (any more).
func get_stand_user() -> Node3D:
	return _user if is_instance_valid(_user) else null


func _spawn_user() -> void:
	if user_scene == null or not is_inside_tree():
		return
	_user = user_scene.instantiate()
	get_parent().add_child(_user)
	_place_user()


# Its user stands user_distance behind it on the ground below, facing the way it does.
func _place_user() -> void:
	if not is_instance_valid(_user) or not _user.is_inside_tree():
		return
	var front := StandShape.flat(-home.basis.z)
	_user.stand_at(home.origin - front * user_distance, front)


func _exit_tree() -> void:
	if not _defeated and is_instance_valid(_user):
		_user.queue_free() # Cleared away: its user goes with it (a beaten one's is left for its finisher).
