# Draws a rival stand user (rival_user.gd, its parent): a low-poly person about 1.75 m tall in a long coat
# whose colour says his island's zone (sea teal in zone 1, deep blue, violet, blood red in zone 4), with an
# armband the colour of his stand, boots, gloves, a head with short hair and dark eyes. Built once with the
# stands' Builder (stand_body_model.gd) and shared by every rival, so ~50 of them stay cheap; each coat colour
# is its own shared mesh. Drawn with the stands' manga shading. Faces -Z, feet at its origin.
#
# He moves by his state: waiting with his hands clasped behind his back, breathing, his head following the player once
# they're near; TAUNT, one arm thrust out pointing; WATCHING, arms folded; CAUGHT dangling and kicking;
# FLYING flailing (and tumbling, if told); DOWN flat on his back. A hit flashes him white and jolts him; he
# dissolves away at the end of a finisher, and then (DEFEATED) a white flag stands where he waited, so a
# cleared island can be told from the water.
# His challenge prompt shows at the bottom of the screen: one label shared by all rivals (only one can be
# near the player at a time).
# Purely presentation.
# Generated by Claude Code.
extends Node3D

const StandBodyModel := preload("res://Scripts/Stands/stand_body_model.gd")
const UserState := preload("res://Scripts/World/rival_user.gd").State
const RivalUser := preload("res://Scripts/World/rival_user.gd")

const ZONE_COATS := {1: Color(0.16, 0.62, 0.6), 2: Color(0.16, 0.3, 0.72), 3: Color(0.48, 0.2, 0.7), 4: Color(0.72, 0.12, 0.12)}
const STAND_BANDS := {"anchovy_stand": Color(0.75, 0.85, 0.95), "squid_stand": Color(0.95, 0.45, 0.7),
	"lobster_stand": Color(0.95, 0.5, 0.2), "jellyfish_stand": Color(0.98, 0.97, 0.95)} ## By stand scene name; others get BAND.
const BAND := Color(1.0, 0.85, 0.3)
const SKIN := Color(0.93, 0.76, 0.62)
const HAIR := Color(0.18, 0.12, 0.1)
const TROUSERS := Color(0.2, 0.2, 0.24)
const BOOTS := Color(0.12, 0.09, 0.08)
const INK := Color(0.08, 0.07, 0.07)
const FLAG := Color(0.97, 0.97, 0.95)
const POLE := Color(0.45, 0.32, 0.2)
const MIDDLE := 0.95 # Height of his middle, which he tumbles about.
const UNDERLEVEL := Color(1.0, 0.68, 0.3) ## His prompt's colour when the player is below his recommended level.

@onready var user: Node3D = get_parent()

static var _meshes := {} # "Body:<zone>", "Arm:<zone>", "Head", "Leg", "Flag" -> ArrayMesh.
static var _band_meshes := {} # Band colour -> its armband mesh.
static var _prompt: Label # The one prompt all rivals share...
static var _prompt_owner: Node # ...and which rival it's showing.

var _body: Node3D # Everything, pivoting about his middle.
var _head: Node3D
var _limbs := {} # "ArmL", "ArmR", "LegL", "LegR" -> pivot.
var _flag: Node3D
var _all: Array[MeshInstance3D] = []
var _time := 0.0
var _tumble := 0.0
var _flash := 0.0
var _jolt := 0.0
var _fade := 1.0
var _fading := 0.0
var _look := 0.0 # Degrees his head is turned toward the player.


func _ready() -> void:
	var zone: int = user.zone
	var band: Color = STAND_BANDS.get(String(user.stand_path).get_file().get_basename(), BAND)
	_body = Node3D.new()
	_body.position = Vector3(0.0, MIDDLE, 0.0)
	add_child(_body)
	_add_mesh(_body, _mesh("Body", zone))
	_head = Node3D.new()
	_head.position = Vector3(0.0, 0.55, 0.0)
	_body.add_child(_head)
	_add_mesh(_head, _mesh("Head", 0))
	for limb: String in ["ArmL", "ArmR", "LegL", "LegR"]:
		var side := -1.0 if limb.ends_with("L") else 1.0
		var pivot := Node3D.new()
		pivot.position = Vector3(side * 0.25, 0.44, 0.0) if limb.begins_with("Arm") else Vector3(side * 0.11, -0.08, 0.0)
		_body.add_child(pivot)
		if limb.begins_with("Arm"):
			_add_mesh(pivot, _mesh("Arm", zone))
			if limb == "ArmL":
				_add_mesh(pivot, _band(band))
		else:
			_add_mesh(pivot, _mesh("Leg", 0))
		_limbs[limb] = pivot
	_flag = Node3D.new()
	add_child(_flag)
	var flag_mesh := MeshInstance3D.new()
	flag_mesh.mesh = _mesh("Flag", 0)
	_flag.add_child(flag_mesh)
	_flag.visible = false
	user.struck.connect(func() -> void:
		_flash = 1.0
		_jolt = 1.0)
	user.dissolving.connect(func(seconds: float) -> void: _fading = maxf(seconds, 0.01))
	user.state_changed.connect(_on_state_changed)
	user.prompt_changed.connect(_on_prompt_changed)


func _exit_tree() -> void:
	if _prompt_owner == user and is_instance_valid(_prompt):
		_prompt.visible = false
		_prompt_owner = null


func _on_state_changed(state: int) -> void:
	var gone := state == UserState.DEFEATED
	_body.visible = not gone
	_flag.visible = gone
	if gone:
		_flag.scale = Vector3(1.0, 0.05, 1.0)
		create_tween().tween_property(_flag, "scale", Vector3.ONE, 0.6).set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_OUT)
	elif state == UserState.IDLE:
		_fade = 1.0
		_fading = 0.0


func _on_prompt_changed(text: String) -> void:
	if not is_instance_valid(_prompt):
		_prompt = _make_prompt()
	if text != "":
		_prompt_owner = user
		_prompt.text = text
		_prompt.visible = true
		# Amber when he's meant for a higher level than the player's.
		var warn: bool = user.outlevels_player()
		_prompt.add_theme_color_override("font_color", UNDERLEVEL if warn else Color.WHITE)
	elif _prompt_owner == user:
		_prompt.visible = false
		_prompt_owner = null


func _process(delta: float) -> void:
	if not _body.visible:
		return
	_time += delta
	var t := _time
	# Degrees: x swings the hanging limb forward (positive, toward -Z where he faces) or back (negative), z
	# out to the side (positive, mirrored for the left) or in across him (negative).
	var arm_l := Vector3.ZERO
	var arm_r := Vector3.ZERO
	var legs := Vector3.ZERO
	var body := Vector3.ZERO
	var lift := 0.0
	var kick := 0.0
	match user.state:
		UserState.IDLE:
			arm_l = Vector3(-24.0 - 2.0 * sin(t * 1.4), 0.0, -6.0) # Hands clasped behind his back.
			arm_r = arm_l
			lift = 0.012 * sin(t * 1.8)
		UserState.TAUNT:
			arm_l = Vector3(-5.0, 0.0, 8.0)
			arm_r = Vector3(84.0, 0.0, -6.0) # Pointing straight ahead, at whoever challenged him.
		UserState.WATCHING:
			arm_l = Vector3(62.0, 0.0, -40.0) # Folded across his chest.
			arm_r = Vector3(56.0, 0.0, -44.0)
			lift = 0.01 * sin(t * 1.6)
		UserState.CAUGHT:
			arm_l = Vector3(-40.0, 0.0, 70.0 + 25.0 * sin(t * 17.0))
			arm_r = arm_l
			legs = Vector3(0.0, 0.0, 10.0)
			kick = 40.0 * sin(t * 14.0)
			body = Vector3(10.0, 0.0, 0.0)
		UserState.FLYING:
			arm_l = Vector3(30.0 * sin(t * 11.0), 0.0, 110.0 + 30.0 * sin(t * 9.0))
			arm_r = arm_l
			legs = Vector3(20.0 * sin(t * 10.0 + 1.0), 0.0, 25.0 + 10.0 * sin(t * 8.0))
		UserState.DOWN:
			arm_l = Vector3(0.0, 0.0, 80.0)
			arm_r = arm_l
			legs = Vector3(0.0, 0.0, 25.0)
			body = Vector3(-90.0, 0.0, 0.0) # Flat on his back.
			lift = 0.16 - MIDDLE
	if user.tumbling and user.state != UserState.DOWN:
		_tumble += delta * 12.0
	elif user.state == UserState.DOWN:
		_tumble = 0.0
	else:
		_tumble = lerp_angle(_tumble, 0.0, 1.0 - exp(-6.0 * delta))
	_jolt = move_toward(_jolt, 0.0, delta * 5.0)
	body.x -= 18.0 * _jolt
	_body.rotation = Vector3(deg_to_rad(body.x) + _tumble, deg_to_rad(body.y), deg_to_rad(body.z))
	_body.position = Vector3(0.0, MIDDLE + lift, 0.0)
	var waiting: bool = user.state == UserState.IDLE or user.state == UserState.WATCHING
	_look = lerpf(_look, _look_target() if waiting else 0.0, 1.0 - exp(-4.0 * delta))
	_head.rotation = Vector3(0.0, deg_to_rad(_look), 0.0)
	for limb: String in _limbs:
		var side := -1.0 if limb.ends_with("L") else 1.0
		var angles: Vector3 = (arm_l if limb == "ArmL" else arm_r) if limb.begins_with("Arm") else legs
		var swing := angles.x + (kick * side if limb.begins_with("Leg") else 0.0)
		(_limbs[limb] as Node3D).rotation = Vector3(deg_to_rad(swing), 0.0, deg_to_rad(angles.z * side))

	_flash = move_toward(_flash, 0.0, delta * 4.0)
	if _fading > 0.0:
		_fade = move_toward(_fade, 0.0, delta / _fading)
	for mesh in _all:
		mesh.set_instance_shader_parameter(&"flash", _flash)
		mesh.set_instance_shader_parameter(&"fade", _fade)


# Degrees to turn his head toward the player, if they're near.
func _look_target() -> float:
	var player := get_tree().get_first_node_in_group("player") as Node3D
	if player == null:
		return 0.0
	var local := user.global_transform.affine_inverse() * player.global_position
	if local.length() > RivalUser.LOOK_RANGE:
		return 0.0
	return clampf(rad_to_deg(atan2(-local.x, -local.z)), -70.0, 70.0)


func _add_mesh(parent: Node3D, mesh: Mesh) -> void:
	var instance := MeshInstance3D.new()
	instance.mesh = mesh
	parent.add_child(instance)
	_all.append(instance)


static func _make_prompt() -> Label:
	var label := HudStyle.label(26, "")
	var layer := CanvasLayer.new()
	layer.layer = 20
	var tree := Engine.get_main_loop() as SceneTree
	(tree.current_scene if tree.current_scene else tree.root).add_child(layer)
	layer.add_child(label)
	label.set_anchors_and_offsets_preset(Control.PRESET_CENTER_BOTTOM)
	label.offset_top = -150.0
	label.offset_bottom = -110.0
	label.grow_horizontal = Control.GROW_DIRECTION_BOTH
	label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	label.visible = false
	return label


# The shared mesh for `part` (the coat colour by `zone` for the body and arms), built the first time.
static func _mesh(part: String, zone: int) -> ArrayMesh:
	var key := "%s:%d" % [part, zone]
	if not _meshes.has(key):
		_meshes[key] = _build(part, ZONE_COATS.get(zone, ZONE_COATS[1]))
	return _meshes[key]


static func _band(color: Color) -> ArrayMesh:
	if not _band_meshes.has(color):
		var band := StandBodyModel.Builder.new()
		band.loft([[-0.12, 0.068, 0.068, 0.0], [-0.2, 0.068, 0.068, 0.0]], color)
		_band_meshes[color] = band.commit(StandBodyModel.material())
	return _band_meshes[color]


# One part, laid out about its pivot (the body about his middle, the head about his neck, limbs hanging
# from their joints, the flag from the ground).
static func _build(part: String, coat: Color) -> ArrayMesh:
	var b := StandBodyModel.Builder.new()
	match part:
		"Body":
			# The coat: [height, half width, half depth, z shift], flaring out below the belt.
			b.loft([[-0.62, 0.25, 0.19, 0.02], [-0.2, 0.21, 0.15, 0.0], [0.05, 0.2, 0.14, 0.0], [0.38, 0.25, 0.15, 0.0], [0.5, 0.16, 0.11, 0.0]], coat)
			b.loft([[-0.04, 0.205, 0.145, 0.0], [0.03, 0.205, 0.145, 0.0]], INK) # Belt.
			b.box(Vector3(0.0, 0.2, -0.145), Vector3(0.12, 0.34, 0.02), coat.darkened(0.35)) # Lapels.
			b.loft([[0.47, 0.07, 0.07, 0.0], [0.56, 0.06, 0.06, 0.0]], SKIN) # Neck.
		"Head":
			b.ellipsoid(Vector3(0.0, 0.13, 0.0), Vector3(0.13, 0.15, 0.14), SKIN, 4, 8)
			b.ellipsoid(Vector3(0.0, 0.2, 0.02), Vector3(0.14, 0.1, 0.14), HAIR, 3, 8)
			for s in [-1.0, 1.0]:
				b.ellipsoid(Vector3(s * 0.05, 0.14, -0.125), Vector3(0.022, 0.026, 0.015), INK, 2, 6)
				b.box(Vector3(s * 0.05, 0.185, -0.13), Vector3(0.06, 0.012, 0.012), HAIR) # Brows.
			b.box(Vector3(0.0, 0.065, -0.135), Vector3(0.06, 0.01, 0.012), INK)
		"Arm":
			b.loft([[-0.02, 0.07, 0.07, 0.0], [-0.3, 0.065, 0.065, 0.0], [-0.52, 0.055, 0.055, 0.0]], coat)
			b.ellipsoid(Vector3(0.0, -0.58, 0.0), Vector3(0.05, 0.065, 0.05), INK, 2, 6) # Glove.
		"Leg":
			b.loft([[0.03, 0.085, 0.085, 0.0], [-0.6, 0.065, 0.065, 0.0]], TROUSERS)
			b.loft([[-0.6, 0.075, 0.08, -0.01], [-0.86, 0.072, 0.1, -0.03]], BOOTS)
		"Flag":
			b.loft([[0.0, 0.03, 0.03, 0.0], [2.2, 0.025, 0.025, 0.0]], POLE)
			b.box(Vector3(0.0, 2.15, 0.0), Vector3(0.09, 0.09, 0.09), POLE.lightened(0.3))
			b.box(Vector3(0.42, 1.85, 0.0), Vector3(0.8, 0.5, 0.02), FLAG) # Flying out to the side, broadside to the sea he faced.
	return b.commit(StandBodyModel.material())
