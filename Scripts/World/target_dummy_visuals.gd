# Draws a floating target dummy (target_dummy.gd, its parent): a stuffed canvas sack tied with rope at
# the waist and neck, a round sack head with button eyes and a stitched mouth, a red and white target
# painted on its chest, and a tail tapering to a point where it floats. Built in code with the stands'
# Builder (stand_body_model.gd) and drawn with the same manga shading and ink outline. It faces -Z.
#
# When it's hit it squashes and jolts, a damage number pops out where the hit landed and floats up,
# and while a combo lasts a counter above its head shows the hits and damage so far; once the combo
# ends the counter shows the total for a moment, then fades.
# Its health shows under the counter once it's been hurt. Beaten, it crumbles: shards break away as it
# dissolves away.#
# Fighting back (target_dummy.gd): a rope-wrapped arm with a red boxing glove sticks out of its right
# side. Winding up, the arm pulls back and up, shaking, the dummy flashes and a "!" pops over its head
# (the tell); then the arm shoots straight out, and springs back. A windup that's a read of the stand's
# next move (it learned the player's habits: stand_memory.gd) shows a gold "!!" instead.
# Purely presentation.
# Generated by Claude Code.
extends Node3D

const StandBodyModel := preload("res://Scripts/Stands/stand_body_model.gd")

const CANVAS := Color(0.86, 0.78, 0.6)
const CANVAS_DARK := Color(0.7, 0.6, 0.43)
const ROPE := Color(0.5, 0.33, 0.18)
const RED := Color(0.85, 0.16, 0.14)
const WHITE := Color(0.97, 0.96, 0.92)
const INK := Color(0.08, 0.07, 0.07)
const ARM_LENGTH := 1.85 # Meters from the shoulder to the glove with the arm fully out (target_dummy.gd punch_reach).

@onready var dummy: RigidBody3D = get_parent()

static var _mesh: ArrayMesh
static var _arm_mesh: ArrayMesh
static var _glove_mesh: ArrayMesh

var _model: MeshInstance3D
var _counter: Label3D
var _jolt := 0.0 # How hard it's jolting from the last hit, dying away.
var _jolt_dir := Vector3.ZERO
var _counter_fade := 0.0
var _shoulder: Node3D # The arm's pivot: its -Y points along the arm...
var _arm: MeshInstance3D # ...the stub, stretched to `_reach`...
var _glove: MeshInstance3D # ...and the glove on its end.
var _reach := 0.3 # How far out the arm is, 0 tucked in to 1 fully out.
var _raise := 20.0 # Degrees the arm is swung forward from hanging down.
var _alert: Label3D # The "!" over its head while it winds up.
var _reading := false # The windup coming is a read of the stand's next move.
var _flash := -1.0
var _hp: Label3D # Its health, under the counter.
var _crumble := -1.0 # Seconds into crumbling once beaten, or -1.


func _ready() -> void:
	if _mesh == null:
		_mesh = _build()
	_model = MeshInstance3D.new()
	_model.mesh = _mesh
	add_child(_model)
	_counter = _label(64)
	_counter.position = Vector3(0.0, 1.55, 0.0)
	_counter.modulate.a = 0.0
	add_child(_counter)
	dummy.hit_taken.connect(_on_hit)
	dummy.combo_ended.connect(_on_combo_ended)
	dummy.defeated.connect(_on_defeated)
	_hp = _label(40)
	_hp.position = Vector3(0.0, 1.38, 0.0)
	_hp.visible = false
	add_child(_hp)
	_build_arm()
	_alert = _label(110)
	_alert.text = "!"
	_alert.modulate = Color(1.0, 0.3, 0.2)
	_alert.position = Vector3(0.0, 1.95, 0.0)
	_alert.visible = false
	add_child(_alert)
	dummy.punch_windup.connect(_on_punch_windup)
	dummy.punch_thrown.connect(_on_punch_thrown)
	dummy.punch_cancelled.connect(func() -> void: _alert.visible = false)
	dummy.read.connect(func(_predicted: StringName, _response: String) -> void: _reading = true)


func _process(delta: float) -> void:
	# Squash and jolt from the last hit.
	_jolt = move_toward(_jolt, 0.0, delta * 3.0)
	var squash := _jolt * _jolt
	_model.scale = Vector3(1.0 + 0.18 * squash, 1.0 - 0.14 * squash, 1.0 + 0.18 * squash)
	_model.position = global_basis.inverse() * _jolt_dir * 0.12 * squash * sin(_jolt * 40.0)
	if dummy.combo_hits == 0:
		_counter_fade = move_toward(_counter_fade, 0.0, delta * 0.7)
		_counter.modulate.a = clampf(_counter_fade, 0.0, 1.0)
	_animate_arm(delta)
	if _crumble >= 0.0:
		_crumble += delta
		var left := clampf(1.0 - _crumble / 0.7, 0.0, 1.0)
		for mesh: MeshInstance3D in [_model, _arm, _glove]:
			mesh.set_instance_shader_parameter(&"fade", left)


func _on_hit(hit: Dictionary) -> void:
	_jolt = 1.0
	_jolt_dir = hit.get("direction", Vector3.ZERO)
	var damage := float(hit.get("damage", 0.0))
	_pop_number(damage, hit.get("point", global_position))
	_counter.text = "%d HIT%s  %d" % [dummy.combo_hits, "" if dummy.combo_hits == 1 else "S", roundi(dummy.combo_damage)]
	_counter.modulate = Color(1, 1, 1, 1)
	_counter_fade = 1.0
	_hp.visible = true
	_hp.text = "HP %d/%d" % [ceili(dummy.health), roundi(dummy.max_health)]


func _on_combo_ended(hits: int, damage: float) -> void:
	_counter.text = "%d HIT%s  %d DMG" % [hits, "" if hits == 1 else "S", roundi(damage)]
	_counter.modulate = Color(1.0, 0.85, 0.3, 1.0)
	_counter_fade = 2.0 # Stays a moment before fading.


# A damage number that pops out where the hit landed, floats up and fades. Bigger hits are bigger.
func _pop_number(damage: float, at: Vector3) -> void:
	var number := _label(int(lerpf(48.0, 96.0, clampf(damage / 25.0, 0.0, 1.0))))
	number.text = str(roundi(damage))
	number.top_level = true
	get_tree().current_scene.add_child(number)
	number.global_position = at + Vector3(randf_range(-0.2, 0.2), 0.2, randf_range(-0.2, 0.2))
	number.scale = Vector3.ONE * 0.4
	var tween := number.create_tween().set_parallel()
	tween.tween_property(number, "scale", Vector3.ONE, 0.12).set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_OUT)
	tween.tween_property(number, "global_position:y", number.global_position.y + 1.0, 0.9).set_ease(Tween.EASE_OUT)
	tween.tween_property(number, "modulate:a", 0.0, 0.3).set_delay(0.6)
	tween.chain().tween_callback(number.queue_free)


# A label drawn like manga lettering: white, edged in ink, always facing the camera and on top.
func _label(font_size: int) -> Label3D:
	var label := Label3D.new()
	label.font_size = font_size
	label.outline_size = font_size / 4
	label.modulate = WHITE
	label.outline_modulate = INK
	label.pixel_size = 0.01
	label.billboard = BaseMaterial3D.BILLBOARD_ENABLED
	label.no_depth_test = true
	label.render_priority = 10
	label.outline_render_priority = 9
	return label


# Laid out about 2.2 m tall around its middle, facing -Z.
static func _build() -> ArrayMesh:
	var b := StandBodyModel.Builder.new()
	# The sack body: [height, half width, half depth, z shift], tapering to a point at the bottom.
	b.loft([
		[-1.1, 0.04, 0.04, 0.0],
		[-0.9, 0.2, 0.18, 0.0],
		[-0.55, 0.34, 0.29, 0.0],
		[-0.15, 0.4, 0.33, 0.0],
		[0.3, 0.4, 0.33, 0.0],
		[0.52, 0.33, 0.28, 0.0],
		[0.62, 0.19, 0.17, 0.0],
	], CANVAS)
	# Seams down the sides.
	for s in [-1.0, 1.0]:
		b.box(Vector3(s * 0.395, -0.1, 0.0), Vector3(0.02, 0.9, 0.04), CANVAS_DARK)
	# Rope tied round the waist and the neck.
	b.loft([[-0.62, 0.335, 0.285, 0.0], [-0.54, 0.35, 0.3, 0.0]], ROPE)
	b.loft([[0.56, 0.27, 0.235, 0.0], [0.66, 0.2, 0.18, 0.0]], ROPE)
	b.ellipsoid(Vector3(0.0, -0.6, -0.31), Vector3(0.06, 0.05, 0.04), ROPE, 3, 6) # Knot.
	# The target on its chest.
	var rings := [[0.27, WHITE], [0.21, RED], [0.14, WHITE], [0.07, RED]]
	for i in rings.size():
		var radius: float = rings[i][0]
		b.ellipsoid(Vector3(0.0, 0.08, -0.29 - 0.012 * i), Vector3(radius, radius, 0.05), rings[i][1], 2, 12)
	# The head: a round sack, tied off in a tuft on top.
	b.ellipsoid(Vector3(0.0, 0.9, 0.0), Vector3(0.27, 0.27, 0.26), CANVAS, 4, 9)
	b.ellipsoid(Vector3(0.0, 1.17, 0.0), Vector3(0.05, 0.04, 0.05), ROPE, 2, 6)
	b.ellipsoid(Vector3(0.0, 1.22, 0.0), Vector3(0.09, 0.05, 0.08), CANVAS_DARK, 2, 7)
	# Button eyes and a stitched mouth.
	for s in [-1.0, 1.0]:
		b.ellipsoid(Vector3(s * 0.1, 0.96, -0.235), Vector3(0.05, 0.05, 0.03), INK, 2, 8)
	b.box(Vector3(0.0, 0.8, -0.25), Vector3(0.18, 0.012, 0.02), INK)
	for x in [-0.07, -0.023, 0.023, 0.07]:
		b.box(Vector3(x, 0.8, -0.252), Vector3(0.012, 0.05, 0.02), INK)
	return b.commit(StandBodyModel.material())


# The arm: a pivot at its right shoulder, a stub that stretches out along it and a glove on the end.
func _build_arm() -> void:
	if _arm_mesh == null:
		_arm_mesh = _build_arm_mesh()
		_glove_mesh = _build_glove_mesh()
	_shoulder = Node3D.new()
	_shoulder.position = Vector3(0.36, 0.3, 0.0)
	add_child(_shoulder)
	_arm = MeshInstance3D.new()
	_arm.mesh = _arm_mesh
	_shoulder.add_child(_arm)
	_glove = MeshInstance3D.new()
	_glove.mesh = _glove_mesh
	_shoulder.add_child(_glove)


# Poses the arm for the punch stage: hanging a little forward and tucked in at rest; winding up, drawn
# back and raised, shaking; punching, shot straight out; recovering, springing back.
func _animate_arm(delta: float) -> void:
	var reach := 0.3
	var raise := 20.0
	var shake := 0.0
	var snap := 10.0
	match dummy.fight:
		dummy.Fight.WINDUP:
			reach = 0.08
			raise = 75.0
			shake = 4.0
			snap = 12.0
			_set_flash(0.3 + 0.25 * sin(Time.get_ticks_msec() * 0.03)) # Flashing: about to swing.
		dummy.Fight.PUNCH:
			reach = 1.0
			raise = 90.0
			snap = 40.0
			_set_flash(0.0)
		_:
			_set_flash(0.0)
	_reach = lerpf(_reach, reach, 1.0 - exp(-snap * delta))
	_raise = lerpf(_raise, raise, 1.0 - exp(-snap * delta))
	_shoulder.rotation = Vector3(deg_to_rad(_raise + randf_range(-shake, shake)), deg_to_rad(randf_range(-shake, shake)), 0.0)
	_arm.scale = Vector3(1.0, maxf(_reach, 0.05), 1.0)
	_glove.position = Vector3(0.0, -ARM_LENGTH * _reach - 0.12, 0.0)


func _on_punch_windup() -> void:
	# A windup it started by reading the stand's next move (target_dummy.gd `read`) shows as a gold "!!".
	_alert.text = "!!" if _reading else "!"
	_alert.modulate = Color(1.0, 0.82, 0.25) if _reading else Color(1.0, 0.3, 0.2)
	_reading = false
	_alert.visible = true
	_alert.scale = Vector3.ONE * 0.3
	var tween := _alert.create_tween()
	tween.tween_property(_alert, "scale", Vector3.ONE, 0.15).set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_OUT)


func _on_punch_thrown(landed: bool) -> void:
	_alert.visible = false
	if landed:
		StandEffects.spawn("impact", get_tree().current_scene, _glove.global_position, 2.2)


func _set_flash(amount: float) -> void:
	if is_equal_approx(amount, _flash):
		return
	_flash = amount
	for mesh: MeshInstance3D in [_model, _arm, _glove]:
		mesh.set_instance_shader_parameter(&"flash", amount)


# The arm's stub, hanging down ARM_LENGTH from its shoulder (squashed shorter until it punches): a
# canvas tube wrapped in rope.
static func _build_arm_mesh() -> ArrayMesh:
	var b := StandBodyModel.Builder.new()
	b.loft([[0.05, 0.08, 0.08, 0.0], [-ARM_LENGTH, 0.065, 0.065, 0.0]], CANVAS)
	for y in [-0.4, -0.9, -1.4]:
		b.loft([[y + 0.03, 0.075, 0.075, 0.0], [y - 0.03, 0.075, 0.075, 0.0]], ROPE)
	return b.commit(StandBodyModel.material())


# A red boxing glove, knuckles down (along the arm), with a white cuff and thumb.
static func _build_glove_mesh() -> ArrayMesh:
	var b := StandBodyModel.Builder.new()
	b.loft([[0.12, 0.1, 0.1, 0.0], [0.04, 0.11, 0.11, 0.0]], WHITE) # Cuff.
	b.ellipsoid(Vector3(0.0, -0.08, 0.0), Vector3(0.17, 0.16, 0.16), RED, 4, 9)
	b.ellipsoid(Vector3(0.12, 0.0, -0.06), Vector3(0.06, 0.09, 0.06), RED, 3, 6) # Thumb.
	return b.commit(StandBodyModel.material())


# Beaten: it crumbles, shards breaking off it as it dissolves; then it's gone.
func _on_defeated(_hit: Dictionary) -> void:
	_crumble = 0.0
	_alert.visible = false
	_counter.text = "K.O."
	_counter.modulate = Color(1.0, 0.35, 0.25)
	_counter_fade = 2.0
	_hp.visible = false
	for y in [-0.6, 0.0, 0.6]:
		StandEffects.spawn("shatter", get_tree().current_scene, global_position + Vector3.UP * y, 2.4)
