# The final boss's arena, on the final island's plateau (island_field.gd builds it there with setup()):
# a ring of stone pillars round the plateau's edge, open on the side facing the map's middle (where the
# player swims in from), and a tall spire behind the far side, its tip glowing so the island can be found
# from anywhere on the map. Lord Verity (villain_user.gd) waits at the far side; challenging him starts the
# fight (stand_encounter.gd challenge()), which takes these spots:
#   * villain_spot: where he stands and watches;
#   * boss_spot: where his stand (the Mantis Shrimp Stand) appears;
#   * player_spot: where the player is put for the fight, facing him;
#   * respawn_spot: where the player comes to after losing, at the open side.
# All spots are world positions on the plateau's surface; `front` points from the far side to the open
# side. set_fighting() says whether the fight is on (`fight_changed`, for the visuals).
#
# Gameplay only: the pillars' and spire's collision is here; final_arena_visuals.gd (its Visuals child)
# draws them and the glowing tip, and lights the ring up while the fight is on.
# Generated by Claude Code.
extends Node3D

## The fight started (true) or ended (false).
signal fight_changed(fighting: bool)

const VILLAIN_SCENE := "res://scenes/villain_user.tscn" # Loaded when the arena is built, not preloaded (see scene_loader.gd).
const VisualsScript := preload("res://Scripts/World/final_arena_visuals.gd")

const PILLAR_COUNT := 12 ## Round the edge, the two facing the open side left out.
const PILLAR_RING := 0.88 ## Share of the plateau's radius the pillars stand at.
const PILLAR_SIZE := Vector3(1.8, 7.0, 1.8)
const SPIRE_HEIGHT := 48.0
const SPIRE_RADIUS := 2.6
const SPIRE_BEHIND := 1.18 ## Share of the plateau's radius behind the middle the spire stands.

var center := Vector3.ZERO ## The middle of the plateau, on its surface.
var radius := 26.0 ## The plateau's radius.
var front := Vector3.LEFT ## From the far side toward the open side (toward the map's middle), flat.
var villain_spot := Vector3.ZERO
var boss_spot := Vector3.ZERO
var player_spot := Vector3.ZERO
var respawn_spot := Vector3.ZERO
var spire_top := Vector3.ZERO ## The glowing tip.
var pillars: Array[Vector3] = [] ## Where each pillar stands (its foot).
var villain: Node3D ## Lord Verity (villain_user.gd).

var _fighting := false


## Builds the arena on `island` (island_generator.gd, already built) and puts Lord Verity in it.
func setup(island: Node3D) -> void:
	add_to_group("final_arena")
	radius = island.plateau_radius
	var summit: Vector2 = island.summit_position
	var middle: Vector3 = island.global_position + Vector3(summit.x, 0.0, summit.y)
	center = _on_ground(middle)
	var toward_origin := Vector3(-middle.x, 0.0, -middle.z)
	front = toward_origin.normalized() if toward_origin.length() > 0.1 else Vector3.LEFT
	villain_spot = _on_ground(center - front * radius * 0.62)
	boss_spot = _on_ground(center - front * radius * 0.3)
	player_spot = _on_ground(center + front * radius * 0.3)
	respawn_spot = _on_ground(center + front * radius * 0.8)

	var right := front.cross(Vector3.UP)
	for i in PILLAR_COUNT:
		var angle := TAU * (float(i) + 0.5) / PILLAR_COUNT
		var direction := front * cos(angle) + right * sin(angle)
		if direction.dot(front) > 0.85:
			continue # The opening.
		var foot := _on_ground(center + direction * radius * PILLAR_RING)
		pillars.append(foot)
		_add_collider(foot + Vector3.UP * PILLAR_SIZE.y * 0.5, BoxShape3D.new(), PILLAR_SIZE)
	var spire_foot := _on_ground(center - front * radius * SPIRE_BEHIND) - Vector3.UP * 2.0
	var spire_shape := CylinderShape3D.new()
	spire_shape.radius = SPIRE_RADIUS
	spire_shape.height = SPIRE_HEIGHT
	_add_collider(spire_foot + Vector3.UP * SPIRE_HEIGHT * 0.5, spire_shape)
	spire_top = spire_foot + Vector3.UP * SPIRE_HEIGHT

	var visuals := Node3D.new()
	visuals.name = "Visuals"
	visuals.set_script(VisualsScript)
	add_child(visuals)

	villain = (load(VILLAIN_SCENE) as PackedScene).instantiate()
	add_child(villain)
	villain.stand_at(villain_spot, front)
	villain.arena = self


## Whether the fight is on.
func is_fighting() -> bool:
	return _fighting


func set_fighting(fighting: bool) -> void:
	if fighting == _fighting:
		return
	_fighting = fighting
	fight_changed.emit(fighting)


# A static collider of `shape` (a box gets `size`) centered at `at`.
func _add_collider(at: Vector3, shape: Shape3D, size := Vector3.ONE) -> void:
	if shape is BoxShape3D:
		(shape as BoxShape3D).size = size
	var body := StaticBody3D.new()
	var collision := CollisionShape3D.new()
	collision.shape = shape
	body.add_child(collision)
	add_child(body)
	body.global_position = at


# `point` dropped onto the ground below (or above) it. The ray is nudged a hair off the point, so it can't
# slip between triangles exactly at a vertex (the island's middle is one).
func _on_ground(point: Vector3) -> Vector3:
	var x := point.x + 0.013
	var z := point.z + 0.017
	var query := PhysicsRayQueryParameters3D.create(Vector3(x, 500.0, z), Vector3(x, -50.0, z))
	var hit := get_world_3d().direct_space_state.intersect_ray(query)
	return Vector3(point.x, hit["position"].y if not hit.is_empty() else point.y, point.z)
