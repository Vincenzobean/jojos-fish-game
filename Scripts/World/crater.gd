# A small crater left where a finisher slams a stand user into the ground (Scripts/Stands/Finisher/):
# a dark dish, darkest in the middle, with a raised lip round it, cracks running out across the ground
# and broken rock chunks thrown up round the rim. It's shaped to the ground it lands on: every point of
# it is measured down onto the terrain there (so on a slope it tilts and bends with the hill instead of
# cutting into it), then lifted just clear of it, the lip raised round the rim. Built in code with the
# stands' Builder (stand_body_model.gd) and drawn with their manga shading. It stays a while, then
# dissolves.
# Purely presentation; make one with Crater.make().
# Generated by Claude Code.
extends Node3D

const StandBodyModel := preload("res://Scripts/Stands/stand_body_model.gd")

const DISH := Color(0.16, 0.13, 0.11)
const DISH_MID := Color(0.27, 0.23, 0.19)
const DISH_EDGE := Color(0.38, 0.33, 0.27)
const LIP := Color(0.5, 0.45, 0.37)
const ROCK := Color(0.52, 0.48, 0.43)
const CRACK := Color(0.12, 0.1, 0.09)
const RINGS := [0.0, 0.25, 0.5, 0.72, 0.9, 1.0, 1.14, 1.4] # Radii of the rings it's built from, in radii.
const SEGMENTS := 18

@export var radius := 1.6 ## Meters to its rim.
@export var lifetime := 20.0 ## Seconds before it starts to dissolve.

var depth := 0.0 ## How far its middle is sunk below the ground (meters): it lies on it.
var _meshes: Array[MeshInstance3D] = []


## Leaves a crater in `world` at `at` (on the ground), `crater_radius` meters to its rim.
static func make(world: Node, at: Vector3, crater_radius := 1.6) -> Node3D:
	var crater: Node3D = (load("res://Scripts/World/crater.gd") as GDScript).new()
	crater.radius = crater_radius
	world.add_child(crater)
	crater.global_position = at
	crater.build()
	return crater


## Shapes it to the ground round it (it must be in the world, placed).
func build() -> void:
	var dish := StandBodyModel.Builder.new()
	var rocks := StandBodyModel.Builder.new()
	# The surface: rings of points laid on the ground, sunk into a bowl inside the rim and raised in a lip.
	var points: Array = []
	for r: float in RINGS:
		var ring: Array[Vector3] = []
		var count := 1 if r == 0.0 else SEGMENTS
		for i in count:
			var angle := TAU * i / SEGMENTS
			var flat := Vector3(cos(angle), 0.0, sin(angle)) * r * radius * (1.0 + 0.06 * sin(angle * 3.0 + r * 5.0))
			ring.append(_on_ground(flat) + Vector3.UP * _profile(r))
		points.append(ring)
	for k in range(1, RINGS.size()):
		var inner: Array[Vector3] = points[k - 1]
		var outer: Array[Vector3] = points[k]
		var color: Color = DISH if RINGS[k] <= 0.5 else (DISH_MID if RINGS[k] <= 0.72 else (DISH_EDGE if RINGS[k] <= 1.0 else LIP))
		for i in SEGMENTS:
			var j := (i + 1) % SEGMENTS
			var a: Vector3 = inner[0] if inner.size() == 1 else inner[i]
			var b: Vector3 = inner[0] if inner.size() == 1 else inner[j]
			var below := (a + outer[i] + outer[j]) / 3.0 + Vector3.DOWN
			dish.triangle(a, outer[i], outer[j], below, color)
			if inner.size() > 1:
				dish.triangle(a, outer[j], b, below, color)
	# Cracks running out across the ground from the lip.
	for i in 7:
		var angle := TAU * i / 7.0 + 0.3 * sin(i * 2.3)
		var out := Vector3(cos(angle), 0.0, sin(angle))
		var across := Vector3(-out.z, 0.0, out.x)
		var start := out * radius * 1.3
		var end := out * radius * (1.3 + 0.45 + 0.3 * fmod(i * 0.37, 1.0))
		var lift := Vector3.UP * 0.03
		dish.quad(_on_ground(start - across * 0.05) + lift, _on_ground(start + across * 0.05) + lift,
			_on_ground(end + across * 0.01) + lift, _on_ground(end - across * 0.01) + lift, (start + end) * 0.5 + Vector3.DOWN * 5.0, CRACK)
	# Broken rock chunks thrown up round the rim.
	for i in 14:
		var angle := TAU * i / 14.0 + 0.2 * sin(i * 1.7)
		var flat := Vector3(cos(angle), 0.0, sin(angle)) * radius * (1.05 + 0.15 * fmod(i * 0.43, 1.0))
		var chunk := radius * (0.09 + 0.06 * fmod(i * 0.61, 1.0))
		rocks.ellipsoid(_on_ground(flat) + Vector3.UP * (_profile(1.1) + chunk * 0.3), Vector3(chunk, chunk * 0.6, chunk * 0.8), ROCK, 2, 5)
	# The ground-hugging surface without an ink outline (it would show as lines across the ground);
	# the rocks with one.
	var plain := ShaderMaterial.new()
	plain.shader = StandBodyModel.MangaShader
	for part: Array in [[dish.commit(plain), plain], [rocks.commit(StandBodyModel.material()), null]]:
		var mesh := MeshInstance3D.new()
		mesh.mesh = part[0]
		add_child(mesh)
		_meshes.append(mesh)
	var tween := create_tween()
	tween.tween_interval(lifetime)
	tween.tween_method(_set_fade, 1.0, 0.0, 1.5)
	tween.tween_callback(queue_free)


# How far the surface is raised `r` radii out from the middle: just above the ground inside the rim (the
# terrain's solid, so a real hollow would be hidden in it), then a raised lip, then back down.
func _profile(r: float) -> float:
	if r <= 1.0:
		return 0.04 # Laid on the ground: the dark shading inside the lip reads as the hollow.
	if r <= 1.14:
		return lerpf(0.03, radius * 0.08, (r - 1.0) / 0.14)
	return lerpf(radius * 0.08, 0.02, clampf((r - 1.14) / 0.26, 0.0, 1.0))


# The ground straight below (or above) `flat` (an offset from the crater's middle, along the ground),
# relative to the crater. Only scenery counts, not anything moving about on it.
func _on_ground(flat: Vector3) -> Vector3:
	var space := get_world_3d().direct_space_state
	var from := global_position + flat + Vector3.UP * 4.0
	var bottom := from + Vector3.DOWN * 10.0
	for attempt in 6:
		var hit := space.intersect_ray(PhysicsRayQueryParameters3D.create(from, bottom))
		if hit.is_empty():
			break
		if hit["collider"] is StaticBody3D and _is_terrain(hit["collider"], hit["shape"]):
			return hit["position"] - global_position
		from = hit["position"] + Vector3.DOWN * 0.05 # Something on the ground (a tree, a stand): look past it.
	return flat


# Whether shape number `shape` of `body` is ground (an island's terrain mesh), not a tree or rock on it.
static func _is_terrain(body: StaticBody3D, shape: int) -> bool:
	var owner_node := body.shape_owner_get_owner(body.shape_find_owner(shape)) as CollisionShape3D
	return owner_node == null or owner_node.shape is ConcavePolygonShape3D or owner_node.shape is HeightMapShape3D


func _set_fade(amount: float) -> void:
	for mesh in _meshes:
		mesh.set_instance_shader_parameter(&"fade", amount)
