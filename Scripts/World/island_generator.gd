# Procedural island mesh generator.
#
# Every island has a flat circular base of radius `radius`. Its height there is a smooth envelope,
# (1 - (r/radius)^2)^2, multiplied by a "relief" that gives each island its own character:
#   * The envelope is exactly 0 at the rim with zero slope, so the island always meets the
#     surrounding water smoothly, and it's built from x^2+z^2 (not the distance r itself) so it has
#     no sharp corner at its center.
#   * The relief is a low base level plus a main hill and a few secondary hills, each a Gaussian
#     bump that can be stretched into a ridge and turned to any angle. The main hill's position is
#     random, so the summit is usually off-center. The result is then scaled so the highest point
#     is exactly `peak_height`.
# To break up the smooth surface further, several points are chosen at uniformly random positions
# across the island (uniform by area); at each one the surface is blended toward its tangent plane
# there, flattening it into a facet. Points nearer the edge flatten a larger area, more strongly.
# The mesh is deliberately low-poly: a coarse grid with slightly jittered vertices, flat-shaded with
# one colour per triangle. With auto_detail on, the grid density scales with the island's size so
# big islands keep the same triangle size as small ones. A matching StaticBody3D collision shape is
# built so the island can be walked on.
# Plants are then scattered over the finished surface by island_flora.gd: bigger islands get more of
# them, and more complex ones (tall grass everywhere, then ferns and bushes, then trees).
#
# Speed: islands are generated at load, so the height maths is written for GDScript's hot loops.
#   * The hills and flatten points live in packed arrays (no per-vertex objects), and a coarse grid
#     lists which flatten points can reach each cell, so a vertex only visits the few that matter
#     (this is the big win: every vertex used to test every flatten point).
#   * The work is split in two. prepare() is pure maths on this island's own data, so island_field.gd
#     runs it for all islands at once on worker threads; build() makes the scene nodes and must run
#     on the main thread. generate() simply does both, one after the other.
# Generated by Claude Code.
extends Node3D

@export var radius := 6.0 # Meters.
@export var peak_height := 10.0 # Meters; the highest point comes out at exactly this.
@export var rings := 8 # Overwritten by prepare() when auto_detail is on (as are radial_segments and flatten_point_count).
@export var radial_segments := 20
@export var vertex_jitter := 0.3 # How far inner vertices wander off the regular grid, as a fraction of the ring spacing.
@export var color_variation := 0.06 # How much each face's brightness can vary from its neighbours.
@export var flatten_point_count := 10
@export var flatten_radius_min_factor := 0.15 # Flatten radius near the center, as a fraction of `radius`.
@export var flatten_radius_max_factor := 0.5 # Flatten radius near the edge, as a fraction of `radius`.
@export var flatten_strength_min := 0.3 # How strongly a center-ward point pulls toward its tangent plane.
@export var flatten_strength_max := 1.0 # How strongly an edge-ward point pulls toward its tangent plane.
@export var sand_color := Color(0.98, 0.89, 0.6)
@export var grass_color := Color(0.22, 0.8, 0.3)
@export var peak_color := Color(0.1, 0.5, 0.2) # A deeper green for the highest ground; islands are short enough now that bare rock doesn't make sense.

@export_group("Detail")
@export var auto_detail := true # Scale rings, segments and flatten points with the island's radius.
@export var target_edge_length := 2.5 # Roughly how long a triangle edge should be, in meters, when auto_detail is on.

@export_group("Shape variation")
@export var hill_count_min := 0 # Secondary hills, on top of the main one.
@export var hill_count_max := 3
@export var summit_offset_max := 0.5 # How far off-center the main hill can sit, as a fraction of `radius`.
@export var base_level_min := 0.3 # Height of the low ground between hills, relative to the hills.
@export var base_level_max := 0.6
@export var hill_spread_min := 0.2 # A hill's width, as a fraction of `radius`.
@export var hill_spread_max := 0.5
@export var hill_elongation_max := 2.2 # How much a hill can be stretched into a ridge (1 = round).

@export_group("Flora")
@export var flora_enabled := true # Scatter plants over the island (see island_flora.gd); bigger islands grow more, and more complex, plants.
@export var flora_clearing_radius := 0.0 # Meters. Keeps trees and bushes this far from the summit (the tutorial island's spawn point); 0 = no clearing.

@export_group("Plateau")
@export var plateau_radius := 0.0 # Meters. Flattens the summit into a level disc this wide (the final island's arena); 0 = none.
@export var plateau_blend := 0.4 # How far past the disc the ground eases back into the hill, as a fraction of plateau_radius.

const IslandFlora := preload("res://Scripts/World/island_flora.gd")

const SUMMIT_SEARCH_STEPS := 48 # The summit is the highest point of a grid with this many cells per side.
const FLATTEN_GRID_CELLS := 12 # Cells per side of the lookup grid that maps a position to the flatten points reaching it.
const GRADIENT_STEP_FACTOR := 0.002 # Step for the numeric slope, as a fraction of `radius`.
const SAND_END := 0.15 # Height (as a fraction of peak_height) where the sand-to-grass blend ends.

# Where the highest point is, in the island's own coordinates (meters, x/z). Set by prepare().
var summit_position := Vector2.ZERO

var _rng := RandomNumberGenerator.new()
var _radius_sq := 1.0
var _base_level := 0.5
var _relief_scale := 1.0
var _faces := {} # {vertices, normals, colors} from prepare(), waiting for build().
var _flora := {} # Plant placements from prepare() (see IslandFlora.scatter), waiting for build().
var _plateau_level := 0.0 # Height of the plateau's flat top (set by prepare() when plateau_radius > 0).

# The hills, one entry per hill in each parallel array. A hill is a Gaussian bump, optionally
# stretched along `direction` (a unit vector) into a ridge; the sigmas are stored inverted so the
# hot loop multiplies instead of divides.
var _hill_count := 0
var _hill_x := PackedFloat64Array()
var _hill_z := PackedFloat64Array()
var _hill_amplitude := PackedFloat64Array()
var _hill_dir_x := PackedFloat64Array()
var _hill_dir_z := PackedFloat64Array()
var _hill_inv_sigma_major := PackedFloat64Array()
var _hill_inv_sigma_minor := PackedFloat64Array()

# The flatten points, in the order they must be applied (edge-ward last), one entry per point in each
# parallel array. The tangent plane at a point is stored as its height at (0, 0) plus its slope.
var _flat_x := PackedFloat64Array()
var _flat_z := PackedFloat64Array()
var _flat_radius := PackedFloat64Array() # Influence radius.
var _flat_strength := PackedFloat64Array()
var _flat_plane_h0 := PackedFloat64Array()
var _flat_slope_x := PackedFloat64Array()
var _flat_slope_z := PackedFloat64Array()
# Lookup grid over the island's bounding square: for each cell, the indices (in application order)
# of the flatten points whose influence circle overlaps that cell.
var _flat_grid: Array[PackedInt32Array] = []
var _cell_size := 1.0


# One randomly chosen surface point whose tangent plane locally flattens the surface nearby.
# Only used while choosing points; they are packed into the arrays above once sorted.
class FlattenPoint:
	var position: Vector2
	var edge_t: float # 0 at the island's center, 1 at its edge.
	var plane_height_at_origin: float # The tangent plane's height at (0, 0), for a quick evaluation.
	var gradient: Vector2 # The surface's slope at this point; defines the tangent plane's tilt.
	var influence_radius: float
	var strength: float


# Builds (or rebuilds) the island's mesh and collision. Pass a seed for a repeatable island,
# or leave it out for a random one each time. This is prepare() then build(); a caller with many
# islands can instead run prepare() on worker threads and call build() on the main thread.
func generate(seed_value: int = -1) -> void:
	prepare(seed_value)
	build()


# The heavy, scene-free half of generation: picks the shape and computes the mesh's raw arrays.
# It touches nothing outside this island (own RNG, own arrays), so it is safe to call from
# WorkerThreadPool for several islands at once.
func prepare(seed_value: int = -1) -> void:
	if seed_value >= 0:
		_rng.seed = seed_value
	else:
		_rng.randomize()

	if auto_detail:
		rings = maxi(4, roundi(radius / target_edge_length))
		radial_segments = maxi(10, roundi(TAU * radius / (target_edge_length * 2.5)))
		flatten_point_count = maxi(4, roundi(radius * radius / 40.0))

	_radius_sq = radius * radius
	_make_hills()
	_normalize_relief()
	_make_flatten_points()
	if plateau_radius > 0.0:
		# The top is level with the hillside at the disc's rim, so the disc is cut into the hill, not raised on it.
		var rim := summit_position + Vector2(plateau_radius, 0.0)
		_plateau_level = _base_height(rim.x, rim.y)
	_faces = _build_faces()
	_flora = {}
	if flora_enabled:
		# Plants go on grass only: past the sand band, where the colour has fully turned green.
		_flora = IslandFlora.scatter(_rng, _faces.vertices, _faces.normals, radius, SAND_END * peak_height,
				summit_position, flora_clearing_radius)


# The scene half of generation: turns the arrays from prepare() into the mesh and collision nodes.
# Must run on the main thread.
func build() -> void:
	var arrays := []
	arrays.resize(Mesh.ARRAY_MAX)
	arrays[Mesh.ARRAY_VERTEX] = _faces.vertices
	arrays[Mesh.ARRAY_NORMAL] = _faces.normals
	arrays[Mesh.ARRAY_COLOR] = _faces.colors
	var mesh := ArrayMesh.new()
	mesh.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, arrays)

	for child in get_children():
		child.queue_free()

	var mesh_instance := MeshInstance3D.new()
	mesh_instance.mesh = mesh
	var material := StandardMaterial3D.new()
	material.vertex_color_use_as_albedo = true
	material.roughness = 0.9
	# The generated mesh's triangle winding faces the wrong way for default backface culling
	# (the same issue worked around for collision below with backface_collision) — without this,
	# the surface disappears and you see straight through the island from outside.
	material.cull_mode = BaseMaterial3D.CULL_DISABLED
	mesh_instance.material_override = material
	add_child(mesh_instance)

	# The collision shape is built straight from the vertices we already have, rather than asking
	# the mesh to convert itself back into triangles (which is much slower).
	var body := StaticBody3D.new()
	var shape := CollisionShape3D.new()
	var trimesh := ConcavePolygonShape3D.new()
	trimesh.set_faces(_faces.vertices)
	# Without this, a raycast (or anything else) approaching a triangle from its back face passes
	# straight through instead of colliding with it, which is easy to get backwards on a generated
	# mesh like this one.
	trimesh.backface_collision = true
	shape.shape = trimesh
	body.add_child(shape)
	add_child(body)
	IslandFlora.build(self, body, _flora, radius)
	_faces = {} # The arrays now live in the mesh; drop our copy.
	_flora = {}


# Picks this island's hills: one main hill (amplitude 1, possibly far off-center) plus a few
# smaller ones, and a random base level for the low ground between them.
func _make_hills() -> void:
	_hill_x.clear()
	_hill_z.clear()
	_hill_amplitude.clear()
	_hill_dir_x.clear()
	_hill_dir_z.clear()
	_hill_inv_sigma_major.clear()
	_hill_inv_sigma_minor.clear()
	_base_level = _rng.randf_range(base_level_min, base_level_max)

	var main_angle := _rng.randf_range(0.0, TAU)
	var main_offset := radius * _rng.randf_range(0.0, summit_offset_max)
	_add_hill(Vector2.from_angle(main_angle) * main_offset, 1.0, 1.0)

	for i in _rng.randi_range(hill_count_min, hill_count_max):
		# Uniformly random within 75% of the radius (sqrt keeps them from bunching at the center).
		var r := radius * 0.75 * sqrt(_rng.randf())
		var center := Vector2.from_angle(_rng.randf_range(0.0, TAU)) * r
		_add_hill(center, _rng.randf_range(0.3, 0.8), _rng.randf_range(0.6, 1.0))
	_hill_count = _hill_x.size()


# Adds one hill. `size_scale` shrinks or grows its width; its sigma (spread) is split into a longer and a
# shorter axis (by sqrt of the elongation each way) so stretching it into a ridge keeps its footprint area.
func _add_hill(center: Vector2, amplitude: float, size_scale: float) -> void:
	# The rim envelope shrinks everything away from the center, which would drag every summit back toward
	# the middle. Boosting a hill by the envelope value at its center (capped at 2x) lets it hold its
	# ground where it was placed.
	var envelope := maxf(0.0, 1.0 - center.length_squared() / _radius_sq)
	var sigma := radius * _rng.randf_range(hill_spread_min, hill_spread_max) * size_scale
	var elongation := _rng.randf_range(1.0, hill_elongation_max)
	var direction := Vector2.from_angle(_rng.randf_range(0.0, PI))
	_hill_x.append(center.x)
	_hill_z.append(center.y)
	_hill_amplitude.append(amplitude / maxf(envelope * envelope, 0.5))
	_hill_dir_x.append(direction.x)
	_hill_dir_z.append(direction.y)
	_hill_inv_sigma_major.append(1.0 / (sigma * sqrt(elongation)))
	_hill_inv_sigma_minor.append(sqrt(elongation) / sigma)


# The island's unscaled shape at (x, z): the rim envelope times the relief from the base level and hills.
# Each hill is evaluated in its own rotated frame (along/across its ridge line). This is the hottest
# function, so it works on plain floats and packed arrays.
func _raw_height(x: float, z: float) -> float:
	var falloff := maxf(0.0, 1.0 - (x * x + z * z) / _radius_sq)
	var relief := _base_level
	for i in _hill_count:
		var off_x := x - _hill_x[i]
		var off_z := z - _hill_z[i]
		var along := (off_x * _hill_dir_x[i] + off_z * _hill_dir_z[i]) * _hill_inv_sigma_major[i]
		var across := (off_z * _hill_dir_x[i] - off_x * _hill_dir_z[i]) * _hill_inv_sigma_minor[i]
		relief += _hill_amplitude[i] * exp(-0.5 * (along * along + across * across))
	return falloff * falloff * relief


# Finds the highest point of the raw shape, then sets the scale so it comes out at exactly
# `peak_height`, and remembers where it is.
func _normalize_relief() -> void:
	var best := 0.0
	var best_x := 0.0
	var best_z := 0.0
	for ix in SUMMIT_SEARCH_STEPS + 1:
		var x := lerpf(-radius, radius, float(ix) / SUMMIT_SEARCH_STEPS)
		# Outside the rim the envelope (and so the height) is zero, so only sample inside it.
		var half_height_sq := _radius_sq - x * x
		if half_height_sq <= 0.0:
			continue
		var half_height := sqrt(half_height_sq)
		for iz in SUMMIT_SEARCH_STEPS + 1:
			var z := lerpf(-radius, radius, float(iz) / SUMMIT_SEARCH_STEPS)
			if z < -half_height or z > half_height:
				continue
			var h := _raw_height(x, z)
			if h > best:
				best = h
				best_x = x
				best_z = z
	_relief_scale = peak_height / maxf(best, 0.0001)
	summit_position = Vector2(best_x, best_z)


# The smooth, unflattened surface height at a 2D point (before any tangent-plane flattening).
func _base_height(x: float, z: float) -> float:
	return _relief_scale * _raw_height(x, z)


# Chooses the flatten points and packs them into the parallel arrays and the lookup grid.
func _make_flatten_points() -> void:
	var points: Array[FlattenPoint] = []
	var step := radius * GRADIENT_STEP_FACTOR
	for i in flatten_point_count:
		# Uniformly random across the island's area: sqrt(randf()) keeps points from bunching up
		# near the center, which a plain random radius would do.
		var r := radius * sqrt(_rng.randf())
		var angle := _rng.randf_range(0.0, TAU)
		var pos := Vector2(cos(angle), sin(angle)) * r

		var point := FlattenPoint.new()
		point.position = pos
		point.edge_t = r / radius
		# The tangent plane at this point is the surface's height there, tilted by its gradient. The
		# gradient is found numerically (central differences) now that the surface is too irregular
		# for a closed-form formula.
		point.gradient = Vector2(
			_base_height(pos.x + step, pos.y) - _base_height(pos.x - step, pos.y),
			_base_height(pos.x, pos.y + step) - _base_height(pos.x, pos.y - step)
		) / (2.0 * step)
		point.plane_height_at_origin = _base_height(pos.x, pos.y) - point.gradient.dot(pos)
		# Flatten a bigger area, more strongly, the closer this point is to the island's edge.
		point.influence_radius = lerpf(radius * flatten_radius_min_factor, radius * flatten_radius_max_factor, point.edge_t)
		point.strength = lerpf(flatten_strength_min, flatten_strength_max, point.edge_t)
		points.append(point)

	# Apply edge-ward points last, so their stronger, wider flattening wins out over any
	# center-ward point whose influence happens to reach the same spot.
	points.sort_custom(func(a: FlattenPoint, b: FlattenPoint): return a.edge_t < b.edge_t)

	_flat_x.resize(points.size())
	_flat_z.resize(points.size())
	_flat_radius.resize(points.size())
	_flat_strength.resize(points.size())
	_flat_plane_h0.resize(points.size())
	_flat_slope_x.resize(points.size())
	_flat_slope_z.resize(points.size())
	_cell_size = 2.0 * radius / FLATTEN_GRID_CELLS
	_flat_grid.clear()
	_flat_grid.resize(FLATTEN_GRID_CELLS * FLATTEN_GRID_CELLS)
	for i in points.size():
		var p := points[i]
		_flat_x[i] = p.position.x
		_flat_z[i] = p.position.y
		_flat_radius[i] = p.influence_radius
		_flat_strength[i] = p.strength
		_flat_plane_h0[i] = p.plane_height_at_origin
		_flat_slope_x[i] = p.gradient.x
		_flat_slope_z[i] = p.gradient.y
		_register_in_grid(i)


# Adds flatten point `i` to every grid cell its influence circle touches. The test is conservative
# (a cell is only skipped if the circle truly misses it), so looking up a cell gives exactly the
# points that could affect a position in it. Points are registered in application order, so each
# cell's list keeps that order.
func _register_in_grid(i: int) -> void:
	var px := _flat_x[i]
	var pz := _flat_z[i]
	var reach := _flat_radius[i]
	var last := FLATTEN_GRID_CELLS - 1
	var cell_x0 := clampi(floori((px - reach + radius) / _cell_size), 0, last)
	var cell_x1 := clampi(floori((px + reach + radius) / _cell_size), 0, last)
	var cell_z0 := clampi(floori((pz - reach + radius) / _cell_size), 0, last)
	var cell_z1 := clampi(floori((pz + reach + radius) / _cell_size), 0, last)
	for cell_z in range(cell_z0, cell_z1 + 1):
		var min_z := cell_z * _cell_size - radius
		var dz := pz - clampf(pz, min_z, min_z + _cell_size)
		for cell_x in range(cell_x0, cell_x1 + 1):
			var min_x := cell_x * _cell_size - radius
			var dx := px - clampf(px, min_x, min_x + _cell_size)
			# Skip cells the circle's bounding box touches but the circle itself doesn't.
			if dx * dx + dz * dz < reach * reach:
				_flat_grid[cell_z * FLATTEN_GRID_CELLS + cell_x].append(i)


# The final surface height at (x, z): the smooth base blended toward each nearby flatten point's
# tangent plane, clamped to [0, peak_height].
func _height_at(x: float, z: float) -> float:
	var height := _base_height(x, z)
	var cell_x := clampi(floori((x + radius) / _cell_size), 0, FLATTEN_GRID_CELLS - 1)
	var cell_z := clampi(floori((z + radius) / _cell_size), 0, FLATTEN_GRID_CELLS - 1)
	for i in _flat_grid[cell_z * FLATTEN_GRID_CELLS + cell_x]:
		var dx := x - _flat_x[i]
		var dz := z - _flat_z[i]
		var dist_sq := dx * dx + dz * dz
		var reach := _flat_radius[i]
		if dist_sq < reach * reach:
			var falloff := 0.5 * (1.0 + cos(PI * sqrt(dist_sq) / reach))
			var plane_height := _flat_plane_h0[i] + _flat_slope_x[i] * x + _flat_slope_z[i] * z
			height += (plane_height - height) * falloff * _flat_strength[i]
	if plateau_radius > 0.0:
		height = _flatten_plateau(x, z, height)
	return clampf(height, 0.0, peak_height)


# Levels `height` at (x, z) to the plateau's top inside its disc, easing back over the blend band outside it.
func _flatten_plateau(x: float, z: float, height: float) -> float:
	var distance := Vector2(x, z).distance_to(summit_position)
	var outer := plateau_radius * (1.0 + plateau_blend)
	if distance >= outer:
		return height
	var weight := 1.0 if distance <= plateau_radius else smoothstep(outer, plateau_radius, distance)
	return lerpf(height, _plateau_level, weight)


# Lays out the grid of points (one center vertex, then `rings` rings of `radial_segments` vertices)
# and turns it into flat-shaded triangles. Returns {vertices, normals, colors} as packed arrays.
func _build_faces() -> Dictionary:
	# First the shared grid of points. Each vertex only stores where it is; colour comes later, per face.
	var positions := PackedVector3Array()
	positions.resize(1 + rings * radial_segments)
	positions[0] = Vector3(0.0, _height_at(0.0, 0.0), 0.0)

	var ring_spacing := radius / float(rings)
	var angle_step := TAU / float(radial_segments)
	var next_vertex := 1
	for ring in range(1, rings + 1):
		var r := ring_spacing * ring
		for seg in radial_segments:
			var angle := angle_step * seg
			var x := cos(angle) * r
			var z := sin(angle) * r
			var h := 0.0
			if ring < rings:
				# Nudge inner vertices off the regular grid so the triangles don't all look identical,
				# then take the height at the nudged spot so the surface stays consistent.
				# Scale the nudge to the local grid spacing: near the center the vertices in a ring are packed much
				# closer together than the rings are apart, and a nudge bigger than that folds triangles into slivers.
				var jitter := minf(ring_spacing, angle_step * r) * vertex_jitter
				x += _rng.randf_range(-jitter, jitter)
				z += _rng.randf_range(-jitter, jitter)
				h = _height_at(x, z)
			# The outermost ring is left un-jittered and forced flat to exactly 0, so the base stays a
			# clean circle that meets the surrounding ground seamlessly.
			positions[next_vertex] = Vector3(x, h, z)
			next_vertex += 1

	# Triangles as index triples into `positions`: a fan from the center to the first ring, then two
	# triangles per quad between each pair of consecutive rings.
	var triangles := PackedInt32Array()
	triangles.resize((2 * rings - 1) * radial_segments * 3)
	var t := 0
	for seg in radial_segments:
		triangles[t] = 0
		triangles[t + 1] = 1 + (seg + 1) % radial_segments
		triangles[t + 2] = 1 + seg
		t += 3
	for ring in range(1, rings):
		var inner_start := 1 + (ring - 1) * radial_segments
		var outer_start := 1 + ring * radial_segments
		for seg in radial_segments:
			var next_seg := (seg + 1) % radial_segments
			var i0 := inner_start + seg
			var i1 := inner_start + next_seg
			var o0 := outer_start + seg
			var o1 := outer_start + next_seg
			triangles[t] = i0
			triangles[t + 1] = o1
			triangles[t + 2] = o0
			triangles[t + 3] = i0
			triangles[t + 4] = i1
			triangles[t + 5] = o1
			t += 6

	# Flat shading: every triangle gets its own three vertices, its own face normal, and a single
	# colour, so faces read as distinct facets instead of blending smoothly into their neighbours.
	var vertices := PackedVector3Array()
	var normals := PackedVector3Array()
	var colors := PackedColorArray()
	vertices.resize(triangles.size())
	normals.resize(triangles.size())
	colors.resize(triangles.size())
	for i in range(0, triangles.size(), 3):
		var a := positions[triangles[i]]
		var b := positions[triangles[i + 1]]
		var c := positions[triangles[i + 2]]
		var face_normal := (b - a).cross(c - a).normalized()
		# A little random brightness per face gives the hand-painted low-poly feel.
		var brightness := 1.0 + _rng.randf_range(-color_variation, color_variation)
		var base_color := _color_for((a.y + b.y + c.y) / 3.0)
		var face_color := Color(base_color.r * brightness, base_color.g * brightness, base_color.b * brightness)
		vertices[i] = a
		vertices[i + 1] = b
		vertices[i + 2] = c
		normals[i] = face_normal
		normals[i + 1] = face_normal
		normals[i + 2] = face_normal
		colors[i] = face_color
		colors[i + 1] = face_color
		colors[i + 2] = face_color
	return {"vertices": vertices, "normals": normals, "colors": colors}


# Sand near the water line blending to grass, then to a deeper green toward the peak.
func _color_for(height: float) -> Color:
	var t := clampf(height / peak_height, 0.0, 1.0)
	if t < SAND_END:
		return sand_color.lerp(grass_color, t / SAND_END)
	return grass_color.lerp(peak_color, (t - SAND_END) / (1.0 - SAND_END))
