# Scatters procedurally generated islands (see island_generator.gd) across the map in concentric
# progression zones, then puts the player on the tutorial island.
#
# The map is a circle of MAP_RADIUS (just inside the skybox) split into ZONE_COUNT equal-width
# rings around the origin. Zone 0 is the center disc; the player starts there and the game leads
# outward. Moving out through the zones, islands get both bigger and more densely packed:
# each zone's island radius range and its coverage (the share of the zone's area that islands
# take up) are interpolated between the ZONE_INNER_* and ZONE_OUTER_* values below.
#
# Islands are big on purpose: fights will take place on them, so they need room to move around in
# (center zone 24-32 m radius, outermost 56-80 m). Each island also gets a random peak height that
# scales with its size, with a floor (so even the smallest island clearly rises above the sea) and
# a cap (so the biggest ones stay broad and walkable rather than steep).
#
# Placement is by rejection sampling: a spot is picked uniformly by area inside the island's zone
# and rejected if the island would poke past the map edge or crowd an island that's already placed.
#
# Island shapes are generated in parallel: placement is decided first (cheap, sequential, so the
# random stream and the "tutorial island first" order stay deterministic), then every island's mesh
# is computed on worker threads and the nodes are built here on the main thread.
#
# The tutorial island is the first one in zone 0, at the map's center. The player starts on its
# highest point, dropped straight down onto the terrain so they rest on the surface instead of
# spawning buried inside it or floating above it.
#
# With reference_island ticked you instead get the single size-reference island: a fixed 20 m
# radius, centered on the origin, for eyeballing scale.
#
# One island is always the same and always in the same place: the final island (FINAL_ISLAND_*), out in
# the outermost zone, a broad dome whose summit is flattened into a level plateau (island_generator.gd
# plateau_radius) for the final boss's arena (final_arena.gd), which is built on it once the player is
# placed. Its spot is reserved before the others are placed, so none crowd it.
#
# Every other island (all but the tutorial island and the final one) gets a rival stand user
# (rival_user.gd) waiting on its summit, facing the map's middle, his stand and strength set by the island's
# zone; trees are kept off the summit (RIVAL_CLEARING_RADIUS) so he can be seen and fought there. They're
# placed with the player, and `rivals` lists them.
#
# Each zone has a recommended player level (RECOMMENDED_LEVEL, Skills level()), and the final boss his own
# (FINAL_BOSS_LEVEL): rivals and Lord Verity say it in their prompts, and the HUD (level_hud.gd) says it
# whenever the player crosses into a new zone. zone_at() says which zone a point is in.
#
# It is a SceneLoader loading task: the loading screen stays up until the player has been placed
# (is_loaded() / `loaded`), since that happens a physics tick after _ready.
# Generated by Claude Code.
extends Node3D

## Every island is built and the player is in place.
signal loaded

const MAP_RADIUS := 1350.0 # Meters. The islands' circular map, just inside the skybox's +/-1500 m bounds.
const ZONE_COUNT := 5 # Equal-width rings; zone 0 is the center disc.
const ZONE_INNER_MIN_RADIUS := 24.0 # Island radius range in the center zone (islands are arenas for fights, so even the tutorial island is roomy)...
const ZONE_INNER_MAX_RADIUS := 32.0
const ZONE_OUTER_MIN_RADIUS := 56.0 # ...and in the outermost zone.
const ZONE_OUTER_MAX_RADIUS := 80.0
const ZONE_INNER_COVERAGE := 0.01 # Share of a zone's area covered by islands: sparse in the center...
const ZONE_OUTER_COVERAGE := 0.06 # ...and busy at the edge.
const REFERENCE_ISLAND_RADIUS := 20.0 # Meters. Size of the single island used in reference_island mode.
const REFERENCE_PEAK_RATIO := 0.25 # That island's peak height, as a fraction of its radius.
const MIN_PEAK_RATIO := 0.10 # Peak height as a fraction of the island's radius: very gentle...
const MAX_PEAK_RATIO := 0.25 # ...to fairly hilly.
const MIN_PEAK_HEIGHT := 4.0 # Meters. Floor on peak height so an island always stands clear of the water...
const MAX_PEAK_HEIGHT := 14.0 # ...and a cap so the biggest islands stay broad and walkable instead of turning into mountains.
const ISLAND_GAP := 20.0 # Meters. Minimum stretch of open water left between two islands.
const PLACEMENT_ATTEMPTS := 60 # Random spots tried per island before giving up on it.
const SPAWN_CLEARING_RADIUS := 12.0 # Meters. No trees or bushes this close to where the player spawns.
const FINAL_ISLAND_POS := Vector2(1240.0, 0.0) # Meters. The final island's center, due east at the map's edge...
const FINAL_ISLAND_RADIUS := 78.0 # ...its size...
const FINAL_ISLAND_PEAK := 18.0 # ...the height of its dome...
const FINAL_ISLAND_PLATEAU := 26.0 # ...the radius of the arena plateau on top...
const FINAL_ISLAND_SEED := 4019 # ...and its seed, so it's the same island every time.
## The player level each zone is meant for, from the tutorial disc (0) out to the edge (4)...
const RECOMMENDED_LEVEL := {0: 1, 1: 2, 2: 5, 3: 8, 4: 11}
## ...and the final boss's.
const FINAL_BOSS_LEVEL := 14
const RIVAL_CLEARING_RADIUS := 8.0 # Meters. No trees or bushes this close to a rival, on his island's summit.
const RIVAL_SCENE := "res://scenes/rival_user.tscn" # Loaded once the islands are built, not preloaded (see scene_loader.gd).

const IslandGeneratorScript := preload("res://Scripts/World/island_generator.gd")
const FinalArenaScript := preload("res://Scripts/World/final_arena.gd")

@export var reference_island := false # Spawn only the size-reference island instead of the zoned map.

var _rng := RandomNumberGenerator.new()
var _loaded := false
var final_island: Node3D ## The final island (none in reference_island mode).
var final_arena: Node3D ## The arena on it (final_arena.gd), once loaded.
var rivals: Array[Node3D] = [] ## The rival on every island that has one (rival_user.gd), once loaded.


func _ready() -> void:
	add_to_group(&"loading_task")
	_rng.randomize()

	var islands: Array[Node3D] = []
	var seeds: Array[int] = [] # One generation seed per island, drawn in spawn order.
	var zones: Array[int] = [] # Each island's zone, in the same order.
	if reference_island:
		var reference := {"pos": Vector2.ZERO, "radius": REFERENCE_ISLAND_RADIUS}
		seeds.append(_rng.randi())
		islands.append(_spawn_island(reference, REFERENCE_ISLAND_RADIUS * REFERENCE_PEAK_RATIO))
	else:
		# The final island's spot is taken first, so nothing else is placed on top of it.
		var placed: Array[Dictionary] = [{"pos": FINAL_ISLAND_POS, "radius": FINAL_ISLAND_RADIUS}]
		for zone in ZONE_COUNT:
			for i in _island_count_for_zone(zone):
				# The first island of zone 0 is the tutorial island, at the very center.
				var placement := _find_placement(placed, zone, zone == 0 and i == 0)
				if placement.is_empty():
					continue
				placed.append(placement)
				var radius: float = placement.radius
				var peak := clampf(radius * _rng.randf_range(MIN_PEAK_RATIO, MAX_PEAK_RATIO), MIN_PEAK_HEIGHT, MAX_PEAK_HEIGHT)
				seeds.append(_rng.randi())
				islands.append(_spawn_island(placement, peak))
				zones.append(zone)

	# Keep trees and bushes off the tutorial island's summit, where the player spawns.
	if not islands.is_empty():
		for i in range(1, islands.size()):
			islands[i].flora_clearing_radius = RIVAL_CLEARING_RADIUS # Where their rivals will stand.
		islands[0].flora_clearing_radius = SPAWN_CLEARING_RADIUS
	var rival_islands := islands.slice(1) if not reference_island else []
	if not reference_island:
		final_island = _spawn_final_island()
		islands.append(final_island)
		seeds.append(FINAL_ISLAND_SEED)

	# Generating an island is pure number-crunching that only touches its own data, so all of them are
	# prepared at once on worker threads; only the cheap node creation then happens here.
	var task := WorkerThreadPool.add_group_task(func(i: int) -> void: islands[i].prepare(seeds[i]), islands.size())
	WorkerThreadPool.wait_for_group_task_completion(task)
	for island in islands:
		island.build()

	# Wait a physics tick so the islands' freshly created collision shapes are registered with the
	# physics server before we raycast against them.
	await get_tree().physics_frame
	_place_player(islands)
	_place_rivals(rival_islands, zones.slice(1))
	if final_island:
		final_arena = Node3D.new()
		final_arena.name = "FinalArena"
		final_arena.set_script(FinalArenaScript)
		final_island.add_child(final_arena)
		final_arena.setup(final_island)
	_loaded = true
	loaded.emit()


func is_loaded() -> bool:
	return _loaded


## The zone `point` (world) is in: 0 in the center disc out to ZONE_COUNT - 1 at the edge (and beyond it).
static func zone_at(point: Vector3) -> int:
	var distance := Vector2(point.x, point.z).length()
	return clampi(int(distance / (MAP_RADIUS / ZONE_COUNT)), 0, ZONE_COUNT - 1)


## The level recommended for `zone`.
static func recommended_level(zone: int) -> int:
	return int(RECOMMENDED_LEVEL.get(clampi(zone, 0, ZONE_COUNT - 1), 1))


# How far along the way from the center zone (0) to the outermost zone (1) a zone is.
func _zone_progress(zone: int) -> float:
	return float(zone) / float(ZONE_COUNT - 1)


func _zone_inner_radius(zone: int) -> float:
	return MAP_RADIUS * zone / ZONE_COUNT


func _zone_outer_radius(zone: int) -> float:
	return MAP_RADIUS * (zone + 1) / ZONE_COUNT


func _zone_min_island_radius(zone: int) -> float:
	return lerpf(ZONE_INNER_MIN_RADIUS, ZONE_OUTER_MIN_RADIUS, _zone_progress(zone))


func _zone_max_island_radius(zone: int) -> float:
	return lerpf(ZONE_INNER_MAX_RADIUS, ZONE_OUTER_MAX_RADIUS, _zone_progress(zone))


# Enough islands to cover the zone's target share of its area, given the zone's typical island size.
# The center zone always gets at least one, since that's where the tutorial island goes.
func _island_count_for_zone(zone: int) -> int:
	var inner := _zone_inner_radius(zone)
	var outer := _zone_outer_radius(zone)
	var zone_area := PI * (outer * outer - inner * inner)
	var coverage := lerpf(ZONE_INNER_COVERAGE, ZONE_OUTER_COVERAGE, _zone_progress(zone))
	var mean_radius := (_zone_min_island_radius(zone) + _zone_max_island_radius(zone)) * 0.5
	var count := roundi(coverage * zone_area / (PI * mean_radius * mean_radius))
	return maxi(count, 1) if zone == 0 else count


# Picks a random radius and position for one island in `zone` (or dead center if `at_center`), retrying
# up to PLACEMENT_ATTEMPTS times. Returns {pos: Vector2, radius: float}, or {} if nothing fit.
func _find_placement(placed: Array[Dictionary], zone: int, at_center: bool) -> Dictionary:
	var inner := _zone_inner_radius(zone)
	var outer := _zone_outer_radius(zone)
	for attempt in PLACEMENT_ATTEMPTS:
		var radius: float = _rng.randf_range(_zone_min_island_radius(zone), _zone_max_island_radius(zone))
		var pos := Vector2.ZERO
		if not at_center:
			# Uniform by area within the ring: pick the squared distance uniformly, then take its root.
			var distance := sqrt(_rng.randf_range(inner * inner, outer * outer))
			pos = Vector2.from_angle(_rng.randf_range(0.0, TAU)) * distance
			if pos.length() + radius > MAP_RADIUS:
				continue
		var overlaps := false
		for other in placed:
			var min_dist: float = radius + float(other.radius) + ISLAND_GAP
			if pos.distance_to(other.pos) < min_dist:
				overlaps = true
				break
		if not overlaps:
			return {"pos": pos, "radius": radius}
	return {}


# Creates the island node at its spot with its size and height. Its mesh is filled in later by
# prepare() and build() (see _ready), so this is cheap.
func _spawn_island(placement: Dictionary, peak_height: float) -> Node3D:
	var island := Node3D.new()
	island.set_script(IslandGeneratorScript)
	island.radius = placement.radius
	island.peak_height = peak_height
	add_child(island)
	island.position = Vector3(placement.pos.x, 0.0, placement.pos.y)
	return island


# The final island: one broad dome (no other hills, its summit in the middle) with the arena plateau on
# top, its flora kept clear of the plateau.
func _spawn_final_island() -> Node3D:
	var island := Node3D.new()
	island.set_script(IslandGeneratorScript)
	island.name = "FinalIsland"
	island.radius = FINAL_ISLAND_RADIUS
	island.peak_height = FINAL_ISLAND_PEAK
	island.hill_count_min = 0
	island.hill_count_max = 0
	island.summit_offset_max = 0.0
	island.hill_spread_min = 0.45 # A broad dome, not a spike.
	island.hill_spread_max = 0.5
	island.hill_elongation_max = 1.2
	island.base_level_min = 0.15
	island.base_level_max = 0.15
	island.plateau_radius = FINAL_ISLAND_PLATEAU
	island.flora_clearing_radius = FINAL_ISLAND_PLATEAU * 1.5
	add_child(island)
	island.position = Vector3(FINAL_ISLAND_POS.x, 0.0, FINAL_ISLAND_POS.y)
	return island


# Puts the player on the tutorial island's summit.
func _place_player(islands: Array[Node3D]) -> void:
	var player := get_parent().get_node_or_null("Player") as CharacterBody3D
	if islands.is_empty() or player == null:
		return
	# The first island spawned is always the center-zone tutorial island.
	var tutorial: Node3D = islands[0]
	var player_xz: Vector2 = Vector2(tutorial.position.x, tutorial.position.z) + tutorial.summit_position
	var excluded: Array[RID] = [player.get_rid()]
	_put_on_ground(player, player_xz, 0.8, excluded)


# A rival on the summit of each of `on` (with its zone in `zones`), facing the map's middle.
func _place_rivals(on: Array, zones: Array) -> void:
	if on.is_empty():
		return
	var scene := load(RIVAL_SCENE) as PackedScene
	for i in on.size():
		var island: Node3D = on[i]
		# Nudged a hair off the summit: it's a mesh vertex, and a ray straight down onto a vertex can slip
		# between its triangles and miss the island.
		var xz: Vector2 = Vector2(island.position.x, island.position.z) + island.summit_position + Vector2(0.013, 0.017)
		var ground := _ground_height(xz, [])
		if is_nan(ground):
			continue
		var rival: Node3D = scene.instantiate()
		rival.name = "Rival"
		rival.setup(zones[i], _rng)
		island.add_child(rival)
		rival.stand_at(Vector3(xz.x, ground, xz.y), Vector3(-xz.x, 0.0, -xz.y))
		rivals.append(rival)


# Rests a node on the ground at the given x/z, with `clearance` above the surface (roughly half the
# node's own height), and stops any motion it had.
func _put_on_ground(node: Node3D, xz: Vector2, clearance: float, excluded: Array[RID]) -> void:
	var ground := _ground_height(xz, excluded)
	if is_nan(ground):
		return
	node.global_position = Vector3(xz.x, ground + clearance, xz.y)
	if node is CharacterBody3D:
		node.velocity = Vector3.ZERO
	elif node is RigidBody3D:
		node.linear_velocity = Vector3.ZERO
		node.angular_velocity = Vector3.ZERO


# Height of the topmost solid surface at an x/z position, or NAN if there is none.
func _ground_height(xz: Vector2, excluded: Array[RID]) -> float:
	var space_state := get_world_3d().direct_space_state
	var query := PhysicsRayQueryParameters3D.create(Vector3(xz.x, 500.0, xz.y), Vector3(xz.x, -500.0, xz.y))
	query.exclude = excluded
	var result := space_state.intersect_ray(query)
	if result.is_empty():
		return NAN
	return result.position.y
