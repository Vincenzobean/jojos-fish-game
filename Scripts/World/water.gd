# Water surface: the single place that knows where the water is, so anything that floats, swims, sinks
# or splashes asks it (surface_height_at()) instead of hard-coding a height. The surface really moves,
# and the water shader (assets/water/water.gdshader) draws it from exactly the same numbers, so what
# floats rides the waves you see:
#   * swells: three long sine waves rolling across the sea, low enough not to flood the beaches;
#   * ripples: rings that spread out from wherever something disturbs the water (disturb(), splash(),
#     and wake() for things moving through it), fading as they go; a ring buffer of MAX_RIPPLES;
#   * presses: the surface pushed down under something hovering just over it (press(), every frame).
# Its `time` runs with the game (it stops while paused and slows with slow motion).
#
# The mesh is built here: a 2 m grid of flat facets around the camera, with a coarse skirt out to the
# horizon, following the camera in 2 m steps so the facets stay put in the world. splash() also tells the
# visuals (water_visuals.gd, the Visuals child) to throw up droplets.
# Generated by Claude Code.
extends MeshInstance3D

## Something splashed into the water at `point` with `strength` (0 a plop, 1 a huge splash).
signal splashed(point: Vector3, strength: float)

const MAX_RIPPLES := 48
const MAX_PRESSES := 8
const CELL := 2.0 # Meters per facet of the fine grid...
const CELLS := 96 # ...this many across...
const SKIRT := [400.0, 1600.0] # ...then a coarse skirt out to these half-widths.

@export_group("Swells")
## Each swell: [direction (x, z), wavelength in meters, height in meters (crest above the middle)].
@export var swells: Array[Vector4] = [
	Vector4(0.8, 0.6, 38.0, 0.1),
	Vector4(-0.4, 0.92, 23.0, 0.07),
	Vector4(0.97, -0.26, 14.0, 0.04),
]

@export_group("Ripples")
@export var ripple_life := 4.0 ## Seconds a ripple spreads before it's gone.
@export var ripple_damping := 0.9 ## How quickly ripples die down (per second).
@export var wake_spacing := 1.4 ## Meters something moves through the water between its wake's rings.
@export var wake_damping := 0.45 ## Wakes die down slower than other ripples, so they trail behind.

var time := 0.0 ## Seconds of water time, shared with the shader.

var _sea_level := 0.0
var _ripples := PackedVector4Array() # x, z, start time, height (m).
var _shapes := PackedVector4Array() # wavelength, speed, damping, life.
var _next := 0
var _presses: Array[Vector4] = [] # x, z, radius, depth: being made this physics tick...
var _pressed_now: Array[Vector4] = [] # ...and the last tick's, which are the ones in effect.
var _wakes := {} # Source -> where its last wake ring was.
var _material: ShaderMaterial


func _enter_tree() -> void:
	add_to_group("water")


func _ready() -> void:
	_sea_level = global_position.y
	process_physics_priority = -10 # Before anything presses on it this tick.
	_ripples.resize(MAX_RIPPLES)
	_shapes.resize(MAX_RIPPLES)
	for i in MAX_RIPPLES:
		_ripples[i] = Vector4(0.0, 0.0, -1000.0, 0.0)
		_shapes[i] = Vector4(1.0, 1.0, 1.0, 0.0)
	mesh = _build_mesh()
	_material = material_override as ShaderMaterial
	_push()


## Height of the water surface at `point` (only its x and z matter), right now. Without `with_presses`,
## leaving out where it's pushed down: for whatever is pushing it, so it doesn't sink into its own dent.
func surface_height_at(point: Vector3, with_presses := true) -> float:
	var height := _sea_level + _swell(point.x, point.z) + _ripple(point.x, point.z)
	return height - _pressed(point.x, point.z) if with_presses else height


## The surface's up direction at `point`.
func surface_normal_at(point: Vector3) -> Vector3:
	var e := 0.5
	var dx := surface_height_at(point + Vector3(e, 0.0, 0.0)) - surface_height_at(point - Vector3(e, 0.0, 0.0))
	var dz := surface_height_at(point + Vector3(0.0, 0.0, e)) - surface_height_at(point - Vector3(0.0, 0.0, e))
	return Vector3(-dx, 2.0 * e, -dz).normalized()


## Sets rings spreading out from `point`: `height` meters high at first, `wavelength` meters apart.
## `damping` (per second) overrides ripple_damping. Returns false if it only joined rings that had just
## started there.
func disturb(point: Vector3, height: float, wavelength := 2.5, damping := -1.0) -> bool:
	# Several parts of one thing hitting the water together (a ragdoll's limbs) make one ring, not ten.
	for i in MAX_RIPPLES:
		var near := _ripples[i]
		if time - near.z < 0.1 and Vector2(point.x - near.x, point.z - near.y).length() < wavelength * 0.5:
			_ripples[i] = Vector4(near.x, near.y, near.z, maxf(near.w, height))
			return false
	var speed := 1.25 * sqrt(maxf(wavelength, 0.3))
	_ripples[_next] = Vector4(point.x, point.z, time, height)
	_shapes[_next] = Vector4(wavelength, speed, ripple_damping if damping < 0.0 else damping, ripple_life)
	_next = (_next + 1) % MAX_RIPPLES
	return true


## Something splashed in at `point`: rings sized by `strength` (0 a plop, 1 a huge splash), and droplets
## (one splash for several at once in the same spot).
func splash(point: Vector3, strength: float) -> void:
	strength = clampf(strength, 0.0, 1.0)
	if disturb(point, lerpf(0.05, 0.35, strength), lerpf(1.5, 4.5, strength)):
		splashed.emit(Vector3(point.x, surface_height_at(point), point.z), strength)


## Pushes the surface down by `depth` meters round `point` (out to about `radius`), for one physics tick:
## call it every tick something hovers over the water.
func press(point: Vector3, radius: float, depth: float) -> void:
	if _presses.size() < MAX_PRESSES:
		_presses.append(Vector4(point.x, point.z, maxf(radius, 0.1), depth))


## `source` (anything, as a key) is moving through the water at `point` with `velocity`: every
## wake_spacing meters it leaves a ring, bigger the faster it goes, so it trails a wake.
func wake(source: Object, point: Vector3, velocity: Vector3) -> void:
	var speed := Vector2(velocity.x, velocity.z).length()
	var key := source.get_instance_id()
	var last: Vector3 = _wakes.get(key, Vector3.INF)
	if speed < 0.6:
		return
	if last != Vector3.INF and Vector2(point.x - last.x, point.z - last.z).length() < wake_spacing:
		return
	_wakes[key] = point
	disturb(point, clampf(speed * 0.022, 0.03, 0.2), clampf(1.6 + speed * 0.15, 2.0, 3.5), wake_damping)


func _process(delta: float) -> void:
	time += delta
	var camera := get_viewport().get_camera_3d()
	if camera:
		var at := camera.global_position
		global_position = Vector3(snappedf(at.x, CELL), _sea_level, snappedf(at.z, CELL))
	_push()


# The presses made last tick take effect (things press in their own physics step, after this one).
func _physics_process(_delta: float) -> void:
	_pressed_now = _presses
	_presses = []


# Hands this frame's water to the shader.
func _push() -> void:
	if _material == null:
		return
	var presses := PackedVector4Array()
	presses.resize(MAX_PRESSES)
	for i in _pressed_now.size():
		presses[i] = _pressed_now[i]
	_material.set_shader_parameter("water_time", time)
	_material.set_shader_parameter("swells", PackedVector4Array(swells))
	_material.set_shader_parameter("ripples", _ripples)
	_material.set_shader_parameter("ripple_shapes", _shapes)
	_material.set_shader_parameter("presses", presses)


# The swells' height at (x, z). Mirrored in the shader's swell().
func _swell(x: float, z: float) -> float:
	var height := 0.0
	for swell in swells:
		var k := TAU / swell.z
		var omega := sqrt(9.8 * k)
		height += swell.w * sin(k * (swell.x * x + swell.y * z) - omega * time)
	return height


# The ripples' height at (x, z). Mirrored in the shader's ripple().
func _ripple(x: float, z: float) -> float:
	var height := 0.0
	for i in MAX_RIPPLES:
		var ripple := _ripples[i]
		var shape := _shapes[i]
		var age := time - ripple.z
		if ripple.w == 0.0 or age < 0.0 or age > shape.w:
			continue
		var front := shape.y * age
		var width := shape.x * 0.9 + front * 0.1
		var r := Vector2(x - ripple.x, z - ripple.y).length()
		if absf(r - front) > width * 2.5:
			continue
		var envelope := exp(-pow((r - front) / width, 2.0))
		var fade := exp(-age * shape.z) / sqrt(1.0 + front * 0.5) * smoothstep(0.0, 0.12, age) * (1.0 - smoothstep(shape.w * 0.7, shape.w, age))
		height += ripple.w * envelope * fade * cos(TAU * (r - front) / shape.x)
	return height


# How far the presses push the surface down at (x, z). Mirrored in the shader's pressed().
func _pressed(x: float, z: float) -> float:
	var depth := 0.0
	for press_at in _pressed_now:
		var r := Vector2(x - press_at.x, z - press_at.y).length()
		depth += press_at.w * exp(-2.0 * pow(r / press_at.z, 2.0))
	return depth


# The fine grid round the middle, then a skirt of long quads out to the horizon, each ring with the
# same vertices along its edge as the one inside it so nothing cracks when the grid is displaced.
func _build_mesh() -> ArrayMesh:
	var vertices := PackedVector3Array()
	var indices := PackedInt32Array()
	var half := CELL * CELLS * 0.5
	var side := CELLS + 1
	for j in side:
		for i in side:
			vertices.append(Vector3(-half + i * CELL, 0.0, -half + j * CELL))
	for j in CELLS:
		for i in CELLS:
			var a := j * side + i
			indices.append_array([a, a + 1, a + side, a + 1, a + side + 1, a + side])
	# The edge of the grid, all the way round.
	var edge := PackedInt32Array()
	for i in CELLS:
		edge.append(i) # Top row, left to right.
	for j in CELLS:
		edge.append(j * side + CELLS) # Right column, down.
	for i in CELLS:
		edge.append(CELLS * side + CELLS - i) # Bottom row, right to left.
	for j in CELLS:
		edge.append((CELLS - j) * side) # Left column, up.
	var inner := edge
	var inner_half := half
	for outer_half: float in SKIRT:
		var outer := PackedInt32Array()
		for index in inner:
			outer.append(vertices.size())
			vertices.append(vertices[index] * (outer_half / inner_half))
		for k in inner.size():
			var n := (k + 1) % inner.size()
			indices.append_array([inner[k], outer[k], inner[n], inner[n], outer[k], outer[n]])
		inner = outer
		inner_half = outer_half
	var normals := PackedVector3Array()
	normals.resize(vertices.size())
	normals.fill(Vector3.UP)
	var arrays := []
	arrays.resize(Mesh.ARRAY_MAX)
	arrays[Mesh.ARRAY_VERTEX] = vertices
	arrays[Mesh.ARRAY_NORMAL] = normals
	arrays[Mesh.ARRAY_INDEX] = indices
	var built := ArrayMesh.new()
	built.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, arrays)
	built.custom_aabb = AABB(Vector3(-SKIRT[-1], -4.0, -SKIRT[-1]), Vector3(SKIRT[-1] * 2.0, 8.0, SKIRT[-1] * 2.0))
	return built
