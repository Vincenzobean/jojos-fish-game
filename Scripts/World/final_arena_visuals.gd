# Draws the final arena (final_arena.gd, its parent) in the stands' manga style (stand_body_model.gd's
# Builder and material): weathered stone pillars with capstones and a band of green carving, a stone ring
# set into the plateau round the fighting ground, and the spire, tapering up in stacked blocks to a
# glowing crystal tip (with a light, seen across the map) that slowly turns and pulses. While the fight is
# on (its is_fighting()) the ring's carving and the crystal glow brighter and pulse faster.
# Purely presentation.
# Generated by Claude Code.
extends Node3D

const StandBodyModel := preload("res://Scripts/Stands/stand_body_model.gd")
const STONE := Color(0.55, 0.55, 0.6)
const DARK_STONE := Color(0.3, 0.31, 0.36)
const CARVING := Color(0.3, 0.95, 0.7)

@onready var arena: Node3D = get_parent()

var _crystal: MeshInstance3D
var _crystal_material: StandardMaterial3D
var _ring_material: StandardMaterial3D
var _light: OmniLight3D
var _time := 0.0
var _heat := 0.0 # 0 calm, 1 while the fight is on.

static var _pillar: ArrayMesh
static var _spire: ArrayMesh
static var _band: ArrayMesh


func _ready() -> void:
	var material := StandBodyModel.material()
	_ring_material = StandardMaterial3D.new()
	_ring_material.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
	_ring_material.albedo_color = CARVING
	for foot: Vector3 in arena.pillars:
		_add(_pillar_mesh(material), foot)
		var band := MeshInstance3D.new()
		band.mesh = _band_mesh()
		band.material_override = _ring_material
		add_child(band)
		band.global_position = foot + Vector3.UP * arena.PILLAR_SIZE.y * 0.62
	# The ring set into the ground round the fighting area.
	var ring := MeshInstance3D.new()
	var torus := TorusMesh.new()
	torus.inner_radius = arena.radius * 0.7
	torus.outer_radius = arena.radius * 0.7 + 0.5
	torus.rings = 48
	torus.ring_segments = 4
	ring.mesh = torus
	ring.material_override = _ring_material
	add_child(ring)
	ring.global_position = arena.center + Vector3.UP * 0.05
	ring.scale = Vector3(1.0, 0.15, 1.0)

	var spire_foot: Vector3 = arena.spire_top - Vector3.UP * arena.SPIRE_HEIGHT
	_add(_spire_mesh(material), spire_foot)
	_crystal = MeshInstance3D.new()
	var crystal_mesh := PrismMesh.new()
	crystal_mesh.size = Vector3(2.4, 4.5, 2.4)
	_crystal.mesh = crystal_mesh
	_crystal_material = StandardMaterial3D.new()
	_crystal_material.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
	_crystal_material.albedo_color = CARVING
	_crystal.material_override = _crystal_material
	add_child(_crystal)
	_crystal.global_position = arena.spire_top + Vector3.UP * 3.0
	_light = OmniLight3D.new()
	_light.light_color = CARVING
	_light.omni_range = 60.0
	_light.light_energy = 3.0
	add_child(_light)
	_light.global_position = arena.spire_top + Vector3.UP * 3.0


func _process(delta: float) -> void:
	_time += delta
	_heat = move_toward(_heat, 1.0 if arena.is_fighting() else 0.0, delta * 0.8)
	var pulse := 0.5 + 0.5 * sin(_time * lerpf(1.2, 5.0, _heat))
	_crystal.rotation.y = _time * 0.4
	_crystal.position.y = arena.spire_top.y - global_position.y + 3.0 + 0.4 * sin(_time * 0.9)
	_crystal_material.albedo_color = CARVING.lerp(Color.WHITE, 0.25 * pulse + 0.4 * _heat)
	_light.light_energy = lerpf(2.0, 4.0, pulse) * (1.0 + _heat)
	_ring_material.albedo_color = CARVING.darkened(0.55 * (1.0 - _heat) * (1.0 - 0.4 * pulse))


func _add(mesh: ArrayMesh, at: Vector3) -> void:
	var instance := MeshInstance3D.new()
	instance.mesh = mesh
	add_child(instance)
	instance.global_position = at


# A stone pillar, foot at the origin: a stepped base, a slightly tapering shaft, a capstone.
static func _pillar_mesh(material: Material) -> ArrayMesh:
	if _pillar:
		return _pillar
	var b := StandBodyModel.Builder.new()
	var size: Vector3 = preload("res://Scripts/World/final_arena.gd").PILLAR_SIZE
	b.box(Vector3(0.0, 0.3, 0.0), Vector3(size.x * 1.4, 0.6, size.z * 1.4), DARK_STONE)
	b.loft([[0.5, size.x * 0.5, size.z * 0.5, 0.0], [size.y * 0.6, size.x * 0.46, size.z * 0.46, 0.0], [size.y - 0.5, size.x * 0.42, size.z * 0.42, 0.0]], STONE)
	b.box(Vector3(0.0, size.y - 0.3, 0.0), Vector3(size.x * 1.3, 0.6, size.z * 1.3), DARK_STONE)
	_pillar = b.commit(material)
	return _pillar


# A band of carving round a pillar.
static func _band_mesh() -> ArrayMesh:
	if _band:
		return _band
	var torus := TorusMesh.new()
	torus.inner_radius = 0.82
	torus.outer_radius = 0.98
	torus.rings = 8
	torus.ring_segments = 4
	var arrays := torus.get_mesh_arrays()
	_band = ArrayMesh.new()
	_band.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, arrays)
	return _band


# The spire, foot at the origin: stacked, narrowing blocks.
static func _spire_mesh(material: Material) -> ArrayMesh:
	if _spire:
		return _spire
	var arena_script := preload("res://Scripts/World/final_arena.gd")
	var height: float = arena_script.SPIRE_HEIGHT
	var r: float = arena_script.SPIRE_RADIUS
	var b := StandBodyModel.Builder.new()
	var rings := []
	for i in 7:
		var t := float(i) / 6.0
		rings.append([height * t, r * lerpf(1.2, 0.35, t), r * lerpf(1.2, 0.35, t), 0.0])
	b.loft(rings, STONE)
	for i in 5:
		var y := height * (0.12 + 0.18 * i)
		var w := r * lerpf(1.25, 0.5, y / height)
		b.loft([[y - 0.4, w, w, 0.0], [y + 0.4, w, w, 0.0]], DARK_STONE)
	_spire = b.commit(material)
	return _spire
