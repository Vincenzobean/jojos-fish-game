# The "stand user" of a target dummy (target_dummy.gd): a little straw person standing on the ground
# behind it, the way a stand's user stands back while it fights. Nothing hits it in a fight; it's there
# so that beating the dummy has someone for the winning stand to finish (Scripts/Stands/Finisher/),
# which moves it about and tells it what's happening to it through `state`. Its origin is at its feet.
#
# Gameplay only: dummy_user_visuals.gd (its "Visuals" child) draws and animates it.
# Generated by Claude Code.
extends Node3D

## What's happening to it, for its visuals.
enum State {
	IDLE, ## Standing by its dummy.
	CAUGHT, ## Held up by the collar, kicking.
	FLYING, ## Thrown or knocked through the air, flailing.
	DOWN, ## Laid out flat (in its crater).
}

## Its state changed.
signal state_changed(state: State)
## It was hit (flash).
signal struck
## It started dissolving away (over `seconds`); it's freed after.
signal dissolving(seconds: float)

var state := State.IDLE
var tumbling := false ## Spinning head over heels while it flies.


func set_state(new_state: State) -> void:
	state = new_state
	state_changed.emit(new_state)


## Something hit it: its visuals flash and jolt.
func hit() -> void:
	struck.emit()


## Dissolves away over `seconds`, then it's gone for good.
func dissolve(seconds := 1.0) -> void:
	dissolving.emit(seconds) # Fading where it lies.
	await get_tree().create_timer(seconds, false).timeout
	queue_free()


## Stands it on the ground (or the water) at `spot`, facing along `facing`.
func stand_at(spot: Vector3, facing: Vector3) -> void:
	var ground := spot.y
	var query := PhysicsRayQueryParameters3D.create(spot + Vector3.UP * 20.0, spot + Vector3.DOWN * 40.0)
	var hit_result := get_world_3d().direct_space_state.intersect_ray(query) if is_inside_tree() else {}
	if not hit_result.is_empty() and not hit_result["collider"].is_in_group("target_dummies"):
		ground = hit_result["position"].y
	var water := get_tree().get_first_node_in_group("water") if is_inside_tree() else null
	if water:
		ground = maxf(ground, water.surface_height_at(spot))
	var flat := Vector3(facing.x, 0.0, facing.z)
	global_transform = Transform3D(Basis.looking_at(flat.normalized() if flat.length() > 0.01 else Vector3.FORWARD, Vector3.UP),
		Vector3(spot.x, ground, spot.z))
