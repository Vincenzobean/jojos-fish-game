# Scatters plants from the nature pack across a generated island (see island_generator.gd).
#
# Bigger islands get more plants, and more complex ones. Each plant type starts to appear at a
# minimum island radius, then its density ramps up until the island reaches full_density_radius:
#   * tall grass grows on every island, even the smallest;
#   * ferns join from 28 m and bushes from 34 m;
#   * broad trees from 44 m and tall trees from 54 m, so only the outer zones grow real woods.
# (For scale: island_field.gd makes 24-32 m islands in the center zone and 56-80 m at the edge.)
#
# Plants are placed on the island's actual triangles: a random triangle, weighted by the ground area
# it covers, then a random point inside it. So they sit exactly on the low-poly surface rather than on
# the smooth height function the mesh only approximates. Only dry, grassy ground qualifies (above the
# sand band) and each type has a steepest slope it will grow on. Grass and ferns tilt to follow the
# ground; trees and bushes stay upright and are sunk a little so the downhill side of their base
# doesn't float.
#
# Trees and bushes follow a noise "fertility" field, so they gather into groves with open ground
# between them (islands are fight arenas and need that room), and big plants keep a minimum spacing
# so their canopies don't grow into each other. An optional clearing (used around the player's spawn
# on the tutorial island) keeps everything but grass and ferns away from one spot.
#
# Like the island mesh, this is split in two: scatter() is pure maths on the island's own data, safe on
# worker threads; build() runs on the main thread and makes one MultiMeshInstance3D per plant type
# (cheap to draw hundreds of instances) plus a cylinder collider for each tree trunk. The pack's unshaded
# materials are swapped for lit copies so the plants are shaded by the sun like the island itself, except
# for the ferns, which have to stay flat (see "lit" in PLANTS).
#
# The models are "Nature Pack Ps1 - Half Life style" by EREMA_GEP, licensed CC-BY-4.0 (see the pack's
# license.txt for the required credit).
# Generated by Claude Code.
extends RefCounted

const PACK_PATH := "res://assets/Enviornments/nature_pack_ps1_-_half_life_style/scene.gltf"

# One entry per plant type, placed in this order (big plants first, so they claim their space before
# the undergrowth fills in around them).
#   node: the MeshInstance3D in the pack.
#   min_island_radius / full_density_radius: where the type first appears, and where it reaches `density`.
#   density: plants per square meter of plantable ground at full density.
#   scale: random uniform scale range.
#   spacing: meters of personal space (times scale) kept clear of other spaced plants; 0 = none.
#   grove: 0 = spread evenly, 1 = only grows where the fertility noise is high.
#   max_slope: steepest ground it grows on, in degrees.
#   align: 0 = stays upright, 1 = tilts fully to the ground's slope.
#   footprint: base radius (times scale), for how far to sink it into sloped ground.
#   trunk_radius / trunk_height: size of the trunk collider (times scale); 0 = no collision.
#   in_clearing: whether it may grow inside the spawn clearing.
#   view_range: drawn out to this many meters beyond the island's rim; 0 = always drawn.
#   shadows: whether it casts shadows.
#   lit: shaded by the sun (a lit copy of the pack's unshaded material) or left flat like the original pack.
#     Ferns stay flat on purpose: their lit alpha-cut-out foliage hangs the Intel GPU driver under D3D12
#     (Windows resets it: LiveKernelEvent 141, "device removed"), found by bisecting a freeze at the
#     fern-heavy outer islands. Every other plant is fine lit. Retest before turning it back on.
const PLANTS := [
	{
		"name": "TallTrees", "node": "Object_4",
		"min_island_radius": 54.0, "full_density_radius": 72.0, "density": 0.004,
		"scale": Vector2(0.8, 1.3), "spacing": 2.5, "grove": 0.85,
		"max_slope": 30.0, "align": 0.0, "footprint": 0.35,
		"trunk_radius": 0.3, "trunk_height": 3.5, "in_clearing": false,
		"view_range": 0.0, "shadows": true, "lit": true,
	},
	{
		"name": "BroadTrees", "node": "Object_8",
		"min_island_radius": 44.0, "full_density_radius": 64.0, "density": 0.004,
		"scale": Vector2(0.8, 1.2), "spacing": 3.0, "grove": 0.8,
		"max_slope": 30.0, "align": 0.0, "footprint": 0.35,
		"trunk_radius": 0.35, "trunk_height": 2.5, "in_clearing": false,
		"view_range": 0.0, "shadows": true, "lit": true,
	},
	{
		"name": "Bushes", "node": "Object_10",
		"min_island_radius": 34.0, "full_density_radius": 56.0, "density": 0.006,
		"scale": Vector2(0.8, 1.6), "spacing": 0.8, "grove": 0.6,
		"max_slope": 35.0, "align": 0.0, "footprint": 0.6,
		"trunk_radius": 0.0, "trunk_height": 0.0, "in_clearing": false,
		"view_range": 300.0, "shadows": true, "lit": true,
	},
	{
		"name": "Ferns", "node": "Object_14",
		"min_island_radius": 28.0, "full_density_radius": 48.0, "density": 0.01,
		"scale": Vector2(0.6, 1.2), "spacing": 0.6, "grove": 0.4,
		"max_slope": 40.0, "align": 0.7, "footprint": 0.3,
		"trunk_radius": 0.0, "trunk_height": 0.0, "in_clearing": true,
		"view_range": 150.0, "shadows": false, "lit": false,
	},
	{
		"name": "TallGrass", "node": "Object_12",
		"min_island_radius": 0.0, "full_density_radius": 40.0, "density": 0.08,
		"scale": Vector2(0.6, 1.1), "spacing": 0.0, "grove": 0.3,
		"max_slope": 40.0, "align": 1.0, "footprint": 0.0,
		"trunk_radius": 0.0, "trunk_height": 0.0, "in_clearing": true,
		"view_range": 120.0, "shadows": false, "lit": true,
	},
]

const MIN_PLANT_HEIGHT := 1.2 # Meters. Plants only grow on triangles entirely above this (clear of the waves).
const START_DENSITY := 0.4 # Share of full density a type has on an island just big enough to grow it.
const ATTEMPTS_PER_PLANT := 6 # Random spots tried per plant wanted, before settling for fewer.
const BASE_SINK := 0.05 # Meters every plant is pushed into the ground, so no seam shows under it.
const GROVE_NOISE_FREQUENCY := 1.0 / 30.0 # About how many groves per meter; 1/30 gives groves a few tens of meters across.
const GROVE_LOW := -0.05 # Fertility noise below this grows nothing grove-bound...
const GROVE_HIGH := 0.35 # ...and above this, everything.
const SPACING_CELL := 8.0 # Meters. Cell size of the spacing lookup; must be at least twice the largest spacing * scale.
const VIEW_RANGE_MARGIN := 20.0 # Meters over which a plant type fades out at the end of its view range.

# The pack's meshes, one per PLANTS entry, and the transform that stands each one upright with its
# base at y = 0. Loaded once, on first build(), and shared by every island.
static var _meshes: Array[Mesh] = []
static var _base_transforms: Array[Transform3D] = []
static var _materials: Array[Material] = [] # Lit versions of the pack's materials (see _lit_copy).


# Picks every plant's transform on one island. `vertices` and `normals` are the island's flat-shaded
# triangle arrays (three entries per triangle). The spawn clearing is a circle in the island's own x/z;
# pass a radius of 0 for none. Returns {instances: one Array[Transform3D] per PLANTS entry,
# trunks: [[base: Vector3, radius: float, height: float], ...]}, all in the island's own space.
static func scatter(rng: RandomNumberGenerator, vertices: PackedVector3Array, normals: PackedVector3Array,
		island_radius: float, min_height: float, clearing_center: Vector2, clearing_radius: float) -> Dictionary:
	# The plantable triangles, with a running total of their ground area to pick them by.
	var tri_first := PackedInt32Array() # Index of the triangle's first vertex.
	var tri_up := PackedFloat32Array() # How upright its face is (1 = flat).
	var cumulative_area := PackedFloat32Array()
	var total_area := 0.0
	min_height = maxf(min_height, MIN_PLANT_HEIGHT)
	for i in range(0, vertices.size(), 3):
		var a := vertices[i]
		var b := vertices[i + 1]
		var c := vertices[i + 2]
		if minf(a.y, minf(b.y, c.y)) < min_height:
			continue
		# Ground area, i.e. the area seen from above, so density is per square meter of map.
		var area := 0.5 * absf((b - a).cross(c - a).y)
		if area <= 0.0:
			continue
		total_area += area
		tri_first.append(i)
		tri_up.append(absf(normals[i].y))
		cumulative_area.append(total_area)

	var instances := []
	var trunks := []
	var result := {"instances": instances, "trunks": trunks}
	if total_area <= 0.0:
		for plant in PLANTS:
			instances.append([] as Array[Transform3D])
		return result

	var fertility := FastNoiseLite.new()
	fertility.noise_type = FastNoiseLite.TYPE_SIMPLEX_SMOOTH
	fertility.seed = rng.randi()
	fertility.frequency = GROVE_NOISE_FREQUENCY
	fertility.fractal_octaves = 2

	var spaced := {} # Vector2i cell -> Array of Vector3(x, z, personal space) for plants that keep spacing.
	var clearing_sq := clearing_radius * clearing_radius
	var last_tri := cumulative_area.size() - 1

	for plant: Dictionary in PLANTS:
		var placed: Array[Transform3D] = []
		instances.append(placed)
		if island_radius < plant.min_island_radius:
			continue
		var growth := clampf(inverse_lerp(plant.min_island_radius, plant.full_density_radius, island_radius), 0.0, 1.0)
		var wanted := roundi(plant.density * total_area * lerpf(START_DENSITY, 1.0, growth))
		var min_up := cos(deg_to_rad(plant.max_slope))
		var grove: float = plant.grove
		var spacing: float = plant.spacing
		var scale_range: Vector2 = plant.scale
		var align: float = plant.align
		var footprint: float = plant.footprint
		var trunk_radius: float = plant.trunk_radius
		var trunk_height: float = plant.trunk_height

		for attempt in wanted * ATTEMPTS_PER_PLANT:
			if placed.size() >= wanted:
				break
			var k := mini(cumulative_area.bsearch(rng.randf() * total_area), last_tri)
			if tri_up[k] < min_up:
				continue
			# A uniformly random point in the triangle (folding the far half of the square back in).
			var u := rng.randf()
			var v := rng.randf()
			if u + v > 1.0:
				u = 1.0 - u
				v = 1.0 - v
			var i := tri_first[k]
			var a := vertices[i]
			var point := a + (vertices[i + 1] - a) * u + (vertices[i + 2] - a) * v
			var xz := Vector2(point.x, point.z)

			if not plant.in_clearing and xz.distance_squared_to(clearing_center) < clearing_sq:
				continue
			if grove > 0.0:
				var fertile := smoothstep(GROVE_LOW, GROVE_HIGH, fertility.get_noise_2d(point.x, point.z))
				if rng.randf() > lerpf(1.0, fertile, grove):
					continue
			var size := rng.randf_range(scale_range.x, scale_range.y)
			var personal_space := spacing * size
			if personal_space > 0.0:
				if _crowded(spaced, xz, personal_space):
					continue
				var cell := Vector2i(floori(xz.x / SPACING_CELL), floori(xz.y / SPACING_CELL))
				if not spaced.has(cell):
					spaced[cell] = []
				spaced[cell].append(Vector3(xz.x, xz.y, personal_space))

			# Face normals come out pointing down or up depending on winding; we want the upward one.
			var normal := normals[i]
			if normal.y < 0.0:
				normal = -normal
			var up := Vector3.UP.slerp(normal, align).normalized()
			var basis := Basis(Quaternion(Vector3.UP, up)) * Basis(Vector3.UP, rng.randf() * TAU).scaled(Vector3.ONE * size)
			# How far the ground drops away across the plant's base, measured along its up axis.
			var slope_tan := tan(acos(clampf(normal.dot(up), -1.0, 1.0)))
			var base := point - up * (BASE_SINK + footprint * size * slope_tan)
			placed.append(Transform3D(basis, base))
			if trunk_radius > 0.0:
				trunks.append([base, trunk_radius * size, trunk_height * size])
	return result


# Whether a plant with `personal_space` at `xz` would come too close to one already placed.
static func _crowded(spaced: Dictionary, xz: Vector2, personal_space: float) -> bool:
	var cell := Vector2i(floori(xz.x / SPACING_CELL), floori(xz.y / SPACING_CELL))
	for dz in range(-1, 2):
		for dx in range(-1, 2):
			var bucket = spaced.get(cell + Vector2i(dx, dz))
			if bucket == null:
				continue
			for other: Vector3 in bucket:
				var needed := personal_space + other.z
				if xz.distance_squared_to(Vector2(other.x, other.y)) < needed * needed:
					return true
	return false


# Adds the plants from scatter() to `island`, and their trunk colliders to `body`. Main thread only.
static func build(island: Node3D, body: StaticBody3D, flora: Dictionary, island_radius: float) -> void:
	if flora.is_empty():
		return
	_load_meshes()
	for t in PLANTS.size():
		var plant: Dictionary = PLANTS[t]
		var placed: Array = flora.instances[t]
		if placed.is_empty():
			continue
		var multimesh := MultiMesh.new()
		multimesh.transform_format = MultiMesh.TRANSFORM_3D
		multimesh.mesh = _meshes[t]
		multimesh.instance_count = placed.size()
		for k in placed.size():
			multimesh.set_instance_transform(k, placed[k] * _base_transforms[t])
		var instance := MultiMeshInstance3D.new()
		instance.name = plant.name
		instance.multimesh = multimesh
		instance.material_override = _materials[t]
		if not plant.shadows:
			instance.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
		if plant.view_range > 0.0:
			# Visibility range is measured to the island's center, hence adding its radius.
			instance.visibility_range_end = island_radius + plant.view_range
			instance.visibility_range_end_margin = VIEW_RANGE_MARGIN
			instance.visibility_range_fade_mode = GeometryInstance3D.VISIBILITY_RANGE_FADE_SELF
		island.add_child(instance)

	for trunk: Array in flora.trunks:
		var cylinder := CylinderShape3D.new()
		cylinder.radius = trunk[1]
		cylinder.height = trunk[2]
		var shape := CollisionShape3D.new()
		shape.shape = cylinder
		shape.position = trunk[0] + Vector3.UP * (trunk[2] * 0.5)
		body.add_child(shape)


# Pulls each plant's mesh out of the pack once. The pack lays its models out side by side, some scaled
# or turned, so each keeps its own node's rotation and scale but is moved to stand on y = 0 at the origin.
static func _load_meshes() -> void:
	if not _meshes.is_empty():
		return
	var pack: Node = (load(PACK_PATH) as PackedScene).instantiate()
	for plant: Dictionary in PLANTS:
		var mesh_instance := pack.find_child(plant.node, true, false) as MeshInstance3D
		var basis := ((mesh_instance.get_parent() as Node3D).transform * mesh_instance.transform).basis
		var bounds := Transform3D(basis, Vector3.ZERO) * mesh_instance.mesh.get_aabb()
		_meshes.append(mesh_instance.mesh)
		_base_transforms.append(Transform3D(basis, Vector3(0.0, -bounds.position.y, 0.0)))
		var material := mesh_instance.mesh.surface_get_material(0)
		_materials.append(_lit_copy(material) if plant.lit else material)
	pack.free()


# The pack's materials are unshaded (flat, PS1 style), which leaves the plants glowing evenly while the
# island around them is lit by the sun. A lit copy makes them shade, and take shadows, like the terrain.
static func _lit_copy(source: Material) -> Material:
	var material := source.duplicate() as BaseMaterial3D
	if material == null:
		return source
	material.shading_mode = BaseMaterial3D.SHADING_MODE_PER_PIXEL
	material.metallic = 0.0
	material.roughness = 0.9 # Matches the island's own material.
	# Both sides of each leaf are drawn; light them both (the back face with its normal flipped) rather
	# than leaving the far side of every canopy dark.
	material.cull_mode = BaseMaterial3D.CULL_DISABLED
	return material
