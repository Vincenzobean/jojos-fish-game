# Lord Verity, the final boss: a stand user who waits in the arena on the final island (final_arena.gd)
# with his stand, Still Water (the Mantis Shrimp Stand), until the player comes to challenge him. Walk up
# to him with a stand ready and `prompt` shows; press challenge (F) and the fight begins (stand_encounter.gd
# challenge()). He never fights himself: he stands back and watches while his stand does (WATCHING).
#
# He's a stand user like a target dummy's straw one (dummy_user.gd), with the same states and methods,
# so a finisher (Scripts/Stands/Finisher/) can play on him when his stand is beaten; beaten, he crumbles
# away (dissolve()) and stays gone until reset() brings him back for a rematch. His origin is at his feet.
#
# Gameplay only: villain_user_visuals.gd (its "Visuals" child) draws, poses and shows his prompt.
# Generated by Claude Code.
extends Node3D

## What's happening to him, for his visuals. The first four are a dummy user's (dummy_user.gd), so
## finishers can tell him the same things.
enum State {
	IDLE, ## Standing waiting, arms folded behind his back.
	CAUGHT, ## Held up by the collar, struggling.
	FLYING, ## Thrown or knocked through the air.
	DOWN, ## Laid out flat (in a crater).
	TAUNT, ## Pointing at the player, the challenge accepted (the intro: boss_intro_director.gd).
	WATCHING, ## Arms folded, watching his stand fight.
	DEFEATED, ## Gone (crumbled away), until reset().
}

## His state changed.
signal state_changed(state: State)
## He was hit (flash).
signal struck
## He started crumbling away (over `seconds`).
signal dissolving(seconds: float)
## The challenge prompt appeared (`text`) or went away ("").
signal prompt_changed(text: String)
## The player challenged him.
signal challenged

const DISPLAY_NAME := "Lord Verity"
const STAND_NAME := "Still Water"

@export var challenge_range := 7.0 ## Meters within which he can be challenged.
@export var return_time := 20.0 ## Seconds after he crumbles away that he's back, waiting for a rematch.

var state := State.IDLE
var tumbling := false ## Spinning head over heels while he flies.
var arena: Node3D ## The arena he waits in (final_arena.gd), set by it.
var prompt := "" ## The prompt showing ("" for none).

var _home := Transform3D()


func _ready() -> void:
	add_to_group("villains")


func set_state(new_state: State) -> void:
	state = new_state
	state_changed.emit(new_state)


## Something hit him: his visuals flash and jolt.
func hit() -> void:
	struck.emit()


## Crumbles away over `seconds`, then he's gone (DEFEATED) for return_time, then back (reset()).
func dissolve(seconds := 1.0) -> void:
	dissolving.emit(seconds)
	await get_tree().create_timer(seconds, false).timeout
	visible = false
	set_state(State.DEFEATED)
	await get_tree().create_timer(return_time, false).timeout
	if state == State.DEFEATED:
		reset()


## Back where he waits, standing, for a rematch.
func reset() -> void:
	visible = true
	tumbling = false
	global_transform = _home
	set_state(State.IDLE)


## Stands him on the ground at `spot`, facing along `facing`; the first time, that's where he waits.
func stand_at(spot: Vector3, facing: Vector3) -> void:
	var ground := spot.y
	if is_inside_tree():
		var query := PhysicsRayQueryParameters3D.create(spot + Vector3.UP * 20.0, spot + Vector3.DOWN * 40.0)
		var hit_result := get_world_3d().direct_space_state.intersect_ray(query)
		if not hit_result.is_empty():
			ground = hit_result["position"].y
	var flat := Vector3(facing.x, 0.0, facing.z)
	global_transform = Transform3D(Basis.looking_at(flat.normalized() if flat.length() > 0.01 else Vector3.FORWARD, Vector3.UP),
		Vector3(spot.x, ground, spot.z))
	if _home == Transform3D():
		_home = global_transform


## Where his head is (for cutscenes and the camera).
func head() -> Vector3:
	return global_position + Vector3.UP * 1.75


func _physics_process(_delta: float) -> void:
	var text := _prompt_text()
	if text != prompt:
		prompt = text
		prompt_changed.emit(text)


func _unhandled_input(event: InputEvent) -> void:
	if prompt == "" or not event.is_action_pressed("challenge"):
		return
	var encounter := _encounter()
	if encounter and encounter.can_challenge_boss():
		get_viewport().set_input_as_handled()
		challenged.emit()
		encounter.challenge(arena)


# What the prompt should say: the challenge if the player is near and can take him on, why not if they
# can't, or nothing.
func _prompt_text() -> String:
	if state != State.IDLE or arena == null:
		return ""
	var player := _player()
	if player == null or player.global_position.distance_to(global_position) > challenge_range:
		return ""
	var encounter := _encounter()
	if encounter == null or encounter.is_active():
		return ""
	if encounter.can_challenge_boss():
		return "[%s] Challenge %s  (Lv %d)" % [preload("res://Scripts/World/rival_user.gd").challenge_key(), DISPLAY_NAME,
			preload("res://Scripts/World/island_field.gd").FINAL_BOSS_LEVEL]
	return "You need a stand ready to face %s" % DISPLAY_NAME


func _player() -> Node3D:
	return get_tree().get_first_node_in_group("player") as Node3D


func _encounter() -> Node:
	var player := _player()
	return player.get_node_or_null("StandEncounter") if player else null
