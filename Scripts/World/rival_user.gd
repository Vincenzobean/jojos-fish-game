# A rival stand user: one waits on every island but the tutorial one and the final one (island_field.gd
# puts them there with setup()), each with a stand and a strength that come from the island's zone. Walk up
# to one with a stand ready and `prompt` shows; press challenge (F) and the fight begins (stand_encounter.gd
# duel()). Like Lord Verity (villain_user.gd) he never fights himself: he watches while his stand does.
#
# Which stand he has: ENEMY_STANDS lists every stand a rival can use with the zones it turns up in, and his
# zone's pool is every entry that covers it (pool_for()), so a new enemy stand is one more line there. (The
# Dolphin is the player's alone, the Violet Stand is only a test model and the Mantis Shrimp is the final
# boss's, so none of them is listed.) How strong it is: ZONE_STRENGTH, by zone, scales his stand's health and
# damage, sets how sharp its AI fights (enemy_stand_brain.gd `skill`) and how much XP beating him is worth.
#
# Beaten (his stand dies and the player's stand finishes him), he crumbles away and the island is cleared:
# he stays DEFEATED, with a white flag left where he stood, for the rest of this play session (the map is
# new every launch, so nothing is saved). Beat the player instead and he's back waiting (reset()) for
# another go. He has the dummy user's states and methods (dummy_user.gd), so finishers can play on him.
# His origin is at his feet.
#
# Gameplay only: rival_user_visuals.gd (its "Visuals" child) draws, poses and shows his prompt.
# Generated by Claude Code.
extends Node3D

## What's happening to him, for his visuals. The first four are a dummy user's (dummy_user.gd), so
## finishers can tell him the same things.
enum State {
	IDLE, ## Standing waiting on his island.
	CAUGHT, ## Held up by the collar, struggling.
	FLYING, ## Thrown or knocked through the air.
	DOWN, ## Laid out flat (in a crater).
	TAUNT, ## Pointing at the player as his stand comes out (rival_intro_director.gd).
	WATCHING, ## Arms folded, watching his stand fight.
	DEFEATED, ## Beaten and gone: the island is cleared.
}

## His state changed.
signal state_changed(state: State)
## He was hit (flash).
signal struck
## He started crumbling away (over `seconds`).
signal dissolving(seconds: float)
## The challenge prompt appeared (`text`) or went away ("").
signal prompt_changed(text: String)
## The player challenged him.
signal challenged
## He was beaten: his island is cleared.
signal cleared_island

## Every stand a rival can have, the zones (from, to, inclusive) it turns up in, and how likely it is
## there against the others ("weight", 1 if left out). Add new enemy stands here; each zone's pool
## (pool_for()) picks them up. The Jellyfish is rare: it counters the final boss's time stop.
const ENEMY_STANDS := [
	{"path": "res://scenes/stands/anchovy_stand.tscn", "zones": Vector2i(1, 3)},
	{"path": "res://scenes/stands/squid_stand.tscn", "zones": Vector2i(2, 4)},
	{"path": "res://scenes/stands/lobster_stand.tscn", "zones": Vector2i(2, 4)},
	{"path": "res://scenes/stands/jellyfish_stand.tscn", "zones": Vector2i(3, 4), "weight": 0.1}, # About 1 rival in 25 there.
]
## How strong a rival is, by zone (zone 0, the tutorial island's, uses zone 1's): his stand's health and
## damage times, its AI's skill (0-1) and the XP for beating him.
const ZONE_STRENGTH := {
	1: {"health": 0.8, "damage": 0.8, "skill": 0.2, "xp": 120},
	2: {"health": 1.0, "damage": 1.0, "skill": 0.45, "xp": 180},
	3: {"health": 1.25, "damage": 1.15, "skill": 0.7, "xp": 260},
	4: {"health": 1.5, "damage": 1.3, "skill": 0.9, "xp": 360},
}
const NAMES := ["Marlo", "Brine", "Coral Jo", "Skiff", "Old Haddie", "Nerissa", "Tack", "Wade", "Gully",
	"Shoal", "Pike", "Mira Kelp", "Dory", "Bosun", "Reef", "Captain Sill"]
const SettingsMenu := preload("res://Scripts/UI/settings_menu.gd")
const IslandField := preload("res://Scripts/World/island_field.gd")
const LOOK_RANGE := 25.0 ## Meters within which he turns his head to follow the player.

@export var challenge_range := 6.0 ## Meters within which he can be challenged.

var state := State.IDLE
var tumbling := false ## Spinning head over heels while he flies.
var prompt := "" ## The prompt showing ("" for none).
var zone := 1 ## His island's zone (1 to 4).
var stand_path := "" ## His stand's scene.
var display_name := "Rival" ## His name.
var cleared := false ## Beaten: his island stays cleared.

var _home := Transform3D()
var _player: Node3D


## Gives him his island's `zone` and, with `rng`, his name and his stand from that zone's pool.
func setup(island_zone: int, rng: RandomNumberGenerator) -> void:
	zone = clampi(island_zone, 1, ZONE_STRENGTH.size())
	stand_path = pick_stand(zone, rng.randf())
	display_name = NAMES[rng.randi_range(0, NAMES.size() - 1)]


## The stands a rival in `zone_index` can have: every ENEMY_STANDS entry whose zones cover it, or, if none
## does, the entry nearest to it.
static func pool_for(zone_index: int) -> Array[String]:
	var pool: Array[String] = []
	var nearest := ""
	var nearest_gap := 1 << 30
	for entry: Dictionary in ENEMY_STANDS:
		var zones: Vector2i = entry["zones"]
		if zone_index >= zones.x and zone_index <= zones.y:
			pool.append(entry["path"])
		var gap := mini(absi(zone_index - zones.x), absi(zone_index - zones.y))
		if gap < nearest_gap:
			nearest_gap = gap
			nearest = entry["path"]
	if pool.is_empty() and nearest != "":
		pool.append(nearest)
	return pool


## A stand for a rival in `zone_index`, picked from its pool by weight with `roll` (0 to 1).
static func pick_stand(zone_index: int, roll: float) -> String:
	var pool := pool_for(zone_index)
	var total := 0.0
	for path in pool:
		total += weight_of(path)
	var left := roll * total
	for path in pool:
		left -= weight_of(path)
		if left < 0.0:
			return path
	return pool[pool.size() - 1] if not pool.is_empty() else ""


## How likely the stand at `path` is against the others in a pool (ENEMY_STANDS "weight").
static func weight_of(path: String) -> float:
	for entry: Dictionary in ENEMY_STANDS:
		if entry["path"] == path:
			return float(entry.get("weight", 1.0))
	return 1.0


## His zone's strength (ZONE_STRENGTH's row).
func strength() -> Dictionary:
	return ZONE_STRENGTH[zone]


## XP for beating him.
func win_xp() -> float:
	return float(strength()["xp"])


## The player level his island's zone is meant for (island_field.gd RECOMMENDED_LEVEL).
func recommended_level() -> int:
	return IslandField.recommended_level(zone)


## Whether the player is below the level he's meant for (his prompt is tinted to warn them).
func outlevels_player() -> bool:
	return Skills.level() < recommended_level()


## His stand's name, as the HUD says it ("Anchovy Stand").
func stand_name() -> String:
	return stand_path.get_file().get_basename().capitalize()


func _ready() -> void:
	add_to_group("rivals")


func set_state(new_state: State) -> void:
	state = new_state
	state_changed.emit(new_state)


## Something hit him: his visuals flash and jolt.
func hit() -> void:
	struck.emit()


## Crumbles away over `seconds` (the end of a finisher): he's beaten, and his island is cleared for good.
func dissolve(seconds := 1.0) -> void:
	dissolving.emit(seconds)
	await get_tree().create_timer(seconds, false).timeout
	tumbling = false
	global_transform = _home # His flag goes where he stood.
	cleared = true
	set_state(State.DEFEATED)
	cleared_island.emit()


## Back where he waits, standing, for another go (after he beat the player).
func reset() -> void:
	if cleared:
		return
	tumbling = false
	global_transform = _home
	set_state(State.IDLE)


## Stands him on the ground at `spot`, facing along `facing`; the first time, that's where he waits.
func stand_at(spot: Vector3, facing: Vector3) -> void:
	var ground := spot.y
	if is_inside_tree():
		var query := PhysicsRayQueryParameters3D.create(spot + Vector3.UP * 20.0, spot + Vector3.DOWN * 40.0)
		var hit_result := get_world_3d().direct_space_state.intersect_ray(query)
		if not hit_result.is_empty():
			ground = hit_result["position"].y
	var flat := Vector3(facing.x, 0.0, facing.z)
	global_transform = Transform3D(Basis.looking_at(flat.normalized() if flat.length() > 0.01 else Vector3.FORWARD, Vector3.UP),
		Vector3(spot.x, ground, spot.z))
	if _home == Transform3D():
		_home = global_transform


## Turns him where he stands to face `point` (the player who challenged him; reset() turns him back).
func face(point: Vector3) -> void:
	var flat := Vector3(point.x - global_position.x, 0.0, point.z - global_position.z)
	if flat.length() > 0.01:
		global_basis = Basis.looking_at(flat.normalized(), Vector3.UP)


## Where his head is (for cutscenes and the camera).
func head() -> Vector3:
	return global_position + Vector3.UP * 1.6


func _physics_process(_delta: float) -> void:
	var text := _prompt_text()
	if text != prompt:
		prompt = text
		prompt_changed.emit(text)


func _unhandled_input(event: InputEvent) -> void:
	if prompt == "" or not event.is_action_pressed("challenge"):
		return
	var encounter := _encounter()
	if encounter and encounter.can_challenge_user():
		get_viewport().set_input_as_handled()
		challenged.emit()
		encounter.duel(self)


# What the prompt should say: the challenge if the player is near and can take him on, why not if they
# can't, or nothing.
func _prompt_text() -> String:
	if state != State.IDLE or cleared:
		return ""
	var player := _find_player()
	if player == null:
		return ""
	var distance := player.global_position.distance_to(global_position)
	if distance > challenge_range:
		return ""
	var encounter := _encounter()
	if encounter == null or encounter.is_active():
		return ""
	if encounter.can_challenge_user():
		return "[%s] Challenge %s  ·  %s  (Lv %d)" % [challenge_key(), display_name, stand_name(), recommended_level()]
	return "You need a stand ready to face %s" % display_name


## The key challenging is bound to, as the prompts say it ("F" unless it's been rebound).
static func challenge_key() -> String:
	var binding: InputEvent = Settings.get_binding(&"challenge")
	return SettingsMenu._binding_name(binding) if binding else "F"


func _find_player() -> Node3D:
	if not is_instance_valid(_player):
		_player = get_tree().get_first_node_in_group("player") as Node3D
	return _player


func _encounter() -> Node:
	var player := _find_player()
	return player.get_node_or_null("StandEncounter") if player else null
