# Draws Lord Verity (villain_user.gd, its parent): the "Lord Verity RIG" model (CC-BY-4.0, CheaterPMCPL on
# Sketchfab; credited in the ending, ending_screen.gd), scaled to `height` with his feet at the origin,
# facing -Z, and posed in code by turning its skeleton's (Mixamo-named) bones: the model has no animations.
# The model comes with a whole rack of swappable emoji heads; he wears HEAD (the toothy grin), fixed onto
# his head bone, and the rest are hidden.
#
# His poses by state: waiting (IDLE) with his hands clasped behind his back, chest out, breathing, his
# head turning slowly to follow the player once they're near; TAUNT, one arm thrust out pointing ahead;
# WATCHING, arms folded; CAUGHT dangling and kicking; FLYING, limbs flung out (and
# tumbling, if told); DOWN, flat on his back. A hit flashes him white and jolts him; dissolving fades him out.
# His challenge prompt shows at the bottom of the screen (HudStyle).
# Purely presentation.
# Generated by Claude Code.
extends Node3D

const UserState := preload("res://Scripts/World/villain_user.gd").State
const MODEL_SCENE := "res://assets/Enemies/Villian/lord_verity_rig/scene.gltf" # Loaded when he appears, not preloaded (see scene_loader.gd).
const HEAD := "Scary" ## The model's head he wears (the node whose name starts with this).

@export var height := 2.0 ## Meters tall.
@export var model_yaw := 180.0 ## Degrees the model is turned so it faces -Z.

@onready var user: Node3D = get_parent()

# Each pose: bone (the part of its Mixamo name after "mixamorig_") -> degrees about the model's axes
# (before it's turned round), from the model's own A-pose: +x tips a bone that points up forward (the
# spine) and swings one that hangs down back (arms, legs), y turns, +z raises an arm or leg out to the
# side. A right-side bone not in the pose mirrors its left one (_side()).
var poses := {
	UserState.IDLE: {"LeftArm": Vector3(35, 0, -45), "LeftForeArm": Vector3(0, 30, -70), "Spine1": Vector3(-5, 0, 0)},
	UserState.TAUNT: {"LeftArm": Vector3(0, 0, -45), "RightArm": Vector3(-80, 0, 0), "RightForeArm": Vector3.ZERO,
		"Spine1": Vector3(0, 15, 0)},
	UserState.WATCHING: {"LeftArm": Vector3(-20, 20, -45), "LeftForeArm": Vector3(0, -90, 0), "Spine1": Vector3(-4, 0, 0)},
	UserState.CAUGHT: {"LeftArm": Vector3(0, 0, 60), "LeftForeArm": Vector3(0, 0, 40), "LeftUpLeg": Vector3(-15, 0, 0),
		"Neck": Vector3(20, 0, 0)},
	UserState.FLYING: {"LeftArm": Vector3(0, 0, 70), "LeftForeArm": Vector3(0, 0, 10), "LeftUpLeg": Vector3(0, 0, -25),
		"LeftLeg": Vector3(20, 0, 0)},
	UserState.DOWN: {"LeftArm": Vector3(0, 0, 20), "LeftUpLeg": Vector3(0, 0, -10)},
}
const MIDDLE := 1.0 # Height of his middle, which he tumbles and lies about.
const HEAD_SHARE := 1.2 # His full height, over his height to his head bone (the head he wears on top).

var _model: Node3D
var _skeleton: Skeleton3D
var _bones := {} # Short bone name -> index.
var _angles := {} # Short bone name -> Vector3 degrees shown now (easing toward the pose).
var _meshes: Array[MeshInstance3D] = [] # What's drawn of him: his body and his head.
var _flash_material: StandardMaterial3D
var _time := 0.0
var _flash := 0.0
var _jolt := 0.0
var _tumble := 0.0
var _fade := 1.0
var _fading := 0.0
var _look := 0.0 # Degrees his head is turned toward the player.
var _prompt: Label


func _ready() -> void:
	_model = (load(MODEL_SCENE) as PackedScene).instantiate()
	add_child(_model)
	_skeleton = _model.find_children("*", "Skeleton3D", true, false)[0] as Skeleton3D
	for i in _skeleton.get_bone_count():
		# "mixamorig_LeftArm_09_26" (or "mixamorig:LeftArm_09_26") -> "LeftArm".
		var short := _skeleton.get_bone_name(i).trim_prefix("mixamorig_").trim_prefix("mixamorig:").get_slice("_", 0)
		if short != "":
			_bones[short] = i
	_fit()
	_wear_head()
	_flash_material = StandardMaterial3D.new()
	_flash_material.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
	_flash_material.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA
	_flash_material.albedo_color = Color(1, 1, 1, 0)
	for mesh in _meshes:
		mesh.material_overlay = _flash_material
	user.struck.connect(func() -> void:
		_flash = 1.0
		_jolt = 1.0)
	user.dissolving.connect(func(seconds: float) -> void: _fading = maxf(seconds, 0.01))
	user.state_changed.connect(func(state: int) -> void:
		if state == UserState.IDLE:
			_fade = 1.0
			_fading = 0.0
			_set_fade(1.0))
	_prompt = HudStyle.label(26, "")
	var layer := CanvasLayer.new()
	layer.layer = 20
	add_child(layer)
	layer.add_child(_prompt)
	_prompt.set_anchors_and_offsets_preset(Control.PRESET_CENTER_BOTTOM)
	_prompt.offset_top = -150.0
	_prompt.offset_bottom = -110.0
	_prompt.grow_horizontal = Control.GROW_DIRECTION_BOTH
	_prompt.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	_prompt.visible = false
	user.prompt_changed.connect(func(text: String) -> void:
		_prompt.text = text
		_prompt.visible = text != "")


# Scales the model so he's `height` tall (his toes to his head bone, plus the head he wears on it) with
# his feet at the origin, turned to face -Z.
func _fit() -> void:
	if not (_bones.has("Head") and _bones.has("LeftToe") and _bones.has("Hips")):
		return
	var to_model := _model.global_transform.affine_inverse() * _skeleton.global_transform
	var top := to_model * _skeleton.get_bone_global_pose(_bones["Head"]).origin
	var toe := to_model * _skeleton.get_bone_global_pose(_bones["LeftToe"]).origin
	var hips := to_model * _skeleton.get_bone_global_pose(_bones["Hips"]).origin
	var tall := (top.y - toe.y) * HEAD_SHARE
	if tall <= 0.0:
		return
	var grow := height / tall
	_model.scale = Vector3.ONE * grow
	_model.rotation.y = deg_to_rad(model_yaw)
	_model.position = -(Basis(Vector3.UP, deg_to_rad(model_yaw)) * Vector3(hips.x, toe.y, hips.z) * grow)


# Hides every head on the model's rack but HEAD, and fixes that one onto his head bone, sitting on his neck.
func _wear_head() -> void:
	var worn: Node3D = null
	for node in _model.find_children(HEAD + "*", "Node3D", true, false):
		worn = node as Node3D
		break
	for node in _model.find_children("*", "MeshInstance3D", true, false):
		var mesh := node as MeshInstance3D
		if mesh.skin != null:
			_meshes.append(mesh) # The body.
		elif worn and worn.is_ancestor_of(mesh):
			_meshes.append(mesh)
		else:
			mesh.visible = false # Another head, or a rig control.
	if worn == null or not _bones.has("Head"):
		return
	var attach := BoneAttachment3D.new()
	attach.bone_name = _skeleton.get_bone_name(_bones["Head"])
	_skeleton.add_child(attach)
	attach.global_transform = _skeleton.global_transform * _skeleton.get_bone_global_pose(_bones["Head"])
	worn.reparent(attach, true)
	# Its ball (its biggest part) sits just above the head bone.
	var ball: MeshInstance3D = null
	for mesh in _meshes:
		if worn.is_ancestor_of(mesh) and (ball == null or mesh.get_aabb().get_volume() > ball.get_aabb().get_volume()):
			ball = mesh
	if ball:
		var box := ball.global_transform * ball.get_aabb()
		worn.global_position += attach.global_position + Vector3.UP * box.size.y * 0.42 - box.get_center()


func _process(delta: float) -> void:
	_time += delta
	var state: int = user.state
	var target: Dictionary = poses.get(state, poses[UserState.IDLE])
	var blend := 1.0 - exp(-10.0 * delta)
	for bone: String in _bones:
		var wanted: Vector3 = _side(bone, target)
		_angles[bone] = (_angles.get(bone, Vector3.ZERO) as Vector3).lerp(wanted, blend)
	# Breathing, and the head following the player while he waits.
	_angles["Spine2"] = _angles.get("Spine2", Vector3.ZERO) + Vector3(2.0 * sin(_time * 1.6), 0, 0)
	_look = lerpf(_look, _look_target() if state == UserState.IDLE or state == UserState.WATCHING else 0.0, blend * 0.4)
	_angles["Head"] = _angles.get("Head", Vector3.ZERO) + Vector3(0, _look, 0)
	if state == UserState.CAUGHT:
		_angles["LeftUpLeg"] += Vector3(30.0 * sin(_time * 14.0), 0, 0)
		_angles["RightUpLeg"] += Vector3(-30.0 * sin(_time * 14.0), 0, 0)
	_jolt = move_toward(_jolt, 0.0, delta * 5.0)
	_angles["Spine"] = _angles.get("Spine", Vector3.ZERO) + Vector3(-18.0 * _jolt, 0, 0)
	for bone: String in _angles:
		if _bones.has(bone):
			_pose_bone(bone, _angles[bone])

	# The whole body: tumbling while flying, flat on his back when down.
	if user.tumbling and state == UserState.FLYING:
		_tumble += delta * 12.0
	else:
		_tumble = lerp_angle(_tumble, 0.0, 1.0 - exp(-6.0 * delta))
	var lying := state == UserState.DOWN
	var tilt := -PI * 0.5 if lying else _tumble
	var pivot := Vector3.UP * (0.2 if lying else MIDDLE)
	transform = Transform3D(Basis(Vector3.RIGHT, tilt), pivot - Basis(Vector3.RIGHT, tilt) * (Vector3.UP * MIDDLE))

	_flash = move_toward(_flash, 0.0, delta * 4.0)
	_flash_material.albedo_color.a = _flash * 0.85
	if _fading > 0.0:
		_fade = move_toward(_fade, 0.0, delta / _fading)
		_set_fade(_fade)


# The pose's angles for `bone`, from its left-side entry for a right-side bone (mirrored).
func _side(bone: String, pose: Dictionary) -> Vector3:
	if pose.has(bone):
		return pose[bone]
	if bone.begins_with("Right"):
		var left := "Left" + bone.trim_prefix("Right")
		if pose.has(left):
			var angles: Vector3 = pose[left]
			return Vector3(angles.x, -angles.y, -angles.z)
	return Vector3.ZERO


# Turns `bone` from its rest by `degrees` about the model's axes (see `poses`).
func _pose_bone(bone: String, degrees: Vector3) -> void:
	var index: int = _bones[bone]
	var rest := _skeleton.get_bone_rest(index).basis.get_rotation_quaternion()
	if degrees.length_squared() < 0.0001:
		_skeleton.set_bone_pose_rotation(index, rest)
		return
	var global_rest := _skeleton.get_bone_global_rest(index).basis.get_rotation_quaternion()
	var turn := Quaternion.from_euler(Vector3(deg_to_rad(degrees.x), deg_to_rad(degrees.y), deg_to_rad(degrees.z)))
	_skeleton.set_bone_pose_rotation(index, rest * (global_rest.inverse() * turn * global_rest))


# Degrees to turn his head toward the player, if they're near.
func _look_target() -> float:
	var player := get_tree().get_first_node_in_group("player") as Node3D
	if player == null:
		return 0.0
	var local := user.global_transform.affine_inverse() * player.global_position
	if local.length() > 25.0:
		return 0.0
	return clampf(rad_to_deg(atan2(-local.x, -local.z)), -60.0, 60.0)


func _set_fade(amount: float) -> void:
	for mesh in _meshes:
		mesh.transparency = 1.0 - amount
