# Draws a dummy's "stand user" (dummy_user.gd, its parent): a little straw person about 1.7 m tall, a
# canvas sack body tied with a rope belt, a round sack head with button eyes and a straw tuft, and
# stubby straw-stuffed arms and legs, built with the stands' Builder (stand_body_model.gd) and drawn
# with their manga shading. It faces -Z, feet at its origin.
#
# It moves by its state: swaying idly; dangling and kicking when caught by the collar; flailing (and
# tumbling head over heels, if told) when flying; spread-eagled flat on its back when down; it dissolves away
# where it lies when it's finished with. A hit flashes it white and jolts it.
# Purely presentation.
# Generated by Claude Code.
extends Node3D

const StandBodyModel := preload("res://Scripts/Stands/stand_body_model.gd")
const UserState := preload("res://Scripts/World/dummy_user.gd").State

const CANVAS := Color(0.84, 0.75, 0.56)
const STRAW := Color(0.93, 0.8, 0.38)
const ROPE := Color(0.5, 0.33, 0.18)
const PATCH := Color(0.55, 0.62, 0.78)
const INK := Color(0.08, 0.07, 0.07)
const MIDDLE := 0.9 # Height of its middle, which it tumbles about.

@onready var user: Node3D = get_parent()

static var _meshes := {}

var _body: Node3D # Everything, pivoting about its middle.
var _limbs := {} # "ArmL", "ArmR", "LegL", "LegR" -> pivot.
var _all: Array[MeshInstance3D] = []
var _time := 0.0
var _tumble := 0.0 # Radians turned head over heels.
var _flash := 0.0
var _fade := 1.0
var _fading := 0.0 # Seconds the dissolve takes (0 while not dissolving).


func _ready() -> void:
	if _meshes.is_empty():
		_meshes = _build()
	_body = Node3D.new()
	_body.position = Vector3(0.0, MIDDLE, 0.0)
	add_child(_body)
	_add_mesh(_body, "Body")
	for limb: String in ["ArmL", "ArmR", "LegL", "LegR"]:
		var side := -1.0 if limb.ends_with("L") else 1.0
		var pivot := Node3D.new()
		pivot.position = Vector3(side * 0.24, 0.4, 0.0) if limb.begins_with("Arm") else Vector3(side * 0.11, -0.12, 0.0)
		_body.add_child(pivot)
		_add_mesh(pivot, limb.substr(0, 3))
		_limbs[limb] = pivot
	user.struck.connect(func() -> void: _flash = 1.0)
	user.dissolving.connect(func(seconds: float) -> void: _fading = maxf(seconds, 0.01))


func _process(delta: float) -> void:
	_time += delta
	var t := _time
	var arms := Vector3.ZERO # Degrees: x swings forward, z out to the side (mirrored for the left).
	var legs := Vector3.ZERO
	var body := Vector3.ZERO
	var lift := 0.0
	var kick := 0.0
	match user.state:
		UserState.IDLE:
			arms = Vector3(5.0 * sin(t * 1.3), 0.0, 8.0 + 3.0 * sin(t * 1.1))
			lift = 0.02 * sin(t * 2.2)
		UserState.CAUGHT:
			arms = Vector3(-40.0, 0.0, 70.0 + 25.0 * sin(t * 17.0))
			legs = Vector3(0.0, 0.0, 10.0)
			kick = 40.0 * sin(t * 14.0)
			body = Vector3(10.0, 0.0, 0.0)
		UserState.FLYING:
			arms = Vector3(30.0 * sin(t * 11.0), 0.0, 110.0 + 30.0 * sin(t * 9.0))
			legs = Vector3(20.0 * sin(t * 10.0 + 1.0), 0.0, 25.0 + 10.0 * sin(t * 8.0))
		UserState.DOWN:
			arms = Vector3(0.0, 0.0, 80.0)
			legs = Vector3(0.0, 0.0, 30.0)
			body = Vector3(-90.0, 0.0, 0.0) # Flat on its back.
			lift = 0.18 - MIDDLE
	if user.tumbling and user.state != UserState.DOWN:
		_tumble += delta * 12.0
	elif user.state == UserState.DOWN:
		_tumble = 0.0
	else:
		_tumble = lerp_angle(_tumble, 0.0, 1.0 - exp(-6.0 * delta))
	_body.rotation = Vector3(deg_to_rad(body.x) + _tumble, deg_to_rad(body.y), deg_to_rad(body.z))
	_body.position = Vector3(0.0, MIDDLE + lift, 0.0)
	for limb: String in _limbs:
		var side := -1.0 if limb.ends_with("L") else 1.0
		var angles := arms if limb.begins_with("Arm") else legs
		var swing := angles.x + (kick * side if limb.begins_with("Leg") else 0.0)
		(_limbs[limb] as Node3D).rotation = Vector3(deg_to_rad(swing), 0.0, deg_to_rad(angles.z * side))

	_flash = move_toward(_flash, 0.0, delta * 4.0)
	if _fading > 0.0:
		_fade = move_toward(_fade, 0.0, delta / _fading)
	for mesh in _all:
		mesh.set_instance_shader_parameter(&"flash", _flash)
		mesh.set_instance_shader_parameter(&"fade", _fade)


func _add_mesh(parent: Node3D, part: String) -> void:
	var mesh := MeshInstance3D.new()
	mesh.mesh = _meshes[part]
	parent.add_child(mesh)
	_all.append(mesh)


# The parts, each laid out about its pivot (the body about its middle, limbs hanging from their joints).
static func _build() -> Dictionary:
	var material := StandBodyModel.material()
	var body := StandBodyModel.Builder.new()
	# The sack body: [height, half width, half depth, z shift].
	body.loft([[-0.15, 0.17, 0.13, 0.0], [0.05, 0.21, 0.15, 0.0], [0.35, 0.22, 0.14, 0.0], [0.48, 0.15, 0.11, 0.0]], CANVAS)
	body.loft([[-0.02, 0.215, 0.155, 0.0], [0.04, 0.215, 0.155, 0.0]], ROPE) # Belt.
	body.box(Vector3(0.08, 0.22, -0.145), Vector3(0.1, 0.1, 0.02), PATCH) # A patch.
	# The head: a round sack with a straw tuft, button eyes and a stitched frown.
	body.ellipsoid(Vector3(0.0, 0.66, 0.0), Vector3(0.18, 0.19, 0.17), CANVAS, 4, 8)
	body.ellipsoid(Vector3(0.0, 0.86, 0.0), Vector3(0.1, 0.06, 0.09), STRAW, 2, 6)
	for s in [-1.0, 1.0]:
		body.ellipsoid(Vector3(s * 0.065, 0.69, -0.155), Vector3(0.035, 0.035, 0.02), INK, 2, 6)
	body.box(Vector3(0.0, 0.59, -0.165), Vector3(0.1, 0.01, 0.015), INK)
	var arm := StandBodyModel.Builder.new()
	arm.loft([[0.03, 0.06, 0.06, 0.0], [-0.42, 0.05, 0.05, 0.0]], CANVAS)
	arm.ellipsoid(Vector3(0.0, -0.48, 0.0), Vector3(0.06, 0.07, 0.06), STRAW, 2, 6) # Straw sticking out.
	var leg := StandBodyModel.Builder.new()
	leg.loft([[0.03, 0.08, 0.08, 0.0], [-0.62, 0.065, 0.065, 0.0]], CANVAS)
	leg.loft([[-0.5, 0.07, 0.07, 0.0], [-0.56, 0.07, 0.07, 0.0]], ROPE)
	leg.ellipsoid(Vector3(0.0, -0.7, -0.03), Vector3(0.07, 0.07, 0.09), STRAW, 2, 6)
	return {"Body": body.commit(material), "Arm": arm.commit(material), "Leg": leg.commit(material)}
