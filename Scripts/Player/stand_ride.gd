# Swimming, the only way the player has: on their stand's back. When the player wades in deep
# (enter_depth), their stand comes for them: one that's out rushes back to them (possession hands it
# over), otherwise one comes up out of the inventory (an arrow that's out is reeled straight in first)
# right in front of them. It heaves them up into the air, rolls onto its front underneath, and they land
# on its back. Then it swims (stand_swimmer.gd) with them riding on it, watched from behind
# (third_person_camera.gd): WASD swims, sprint is a hard stroke. Swimming into the shallows or up to a
# shore, they hop off onto land and the stand goes back into the inventory, the way it would when sent
# back (possession.gd).
#
# Swimming has to be learned first (the player's skill tree, the Skills autoload): until it is, deep water
# sinks you just the same. Its other skills swim faster and throw you higher.
#
# With no stand to come (none caught, only ones that can't be summoned, or the one they have is
# recovering), they sink while the view fades to black, and they're put back on the last dry ground
# they stood on.
#
# Gameplay only: stand_ride_visuals.gd (the Visuals child) draws the fade and messages; the stand's own
# visuals play its toss and its swim.
# Generated by Claude Code.
extends Node

## The stand is coming up under the player in the water (or rushing back to them).
signal caught(stand: Node3D)
## It threw the player up into the air.
signal tossed(stand: Node3D)
## The player landed on its back; they're riding it.
signal mounted(stand: Node3D)
## They hopped off onto land; the stand is going back.
signal dismounted
## No stand came: the player is sinking, and is put back on land in `seconds`; `reason` says why.
signal sinking(seconds: float, reason: String)
## They were put back on land after sinking.
signal respawned

const StandShape := preload("res://Scripts/Stands/stand_shape.gd")
const StandSwimmer := preload("res://Scripts/Stands/stand_swimmer.gd")
const ThirdPersonCamera := preload("res://Scripts/Player/third_person_camera.gd")

enum State { IDLE, CATCH, TOSS, RIDING, DISMOUNT, SINKING }

@export var enter_depth := 0.5 ## How far under the player must be (player.gd submersion()) before their stand comes.
@export var catch_depth := 0.3 ## Meters under the surface the stand's middle comes up to, in front of the player.
@export var catch_gap := 0.9 ## Meters in front of the player it comes up.
@export var rush_time := 0.45 ## Seconds a stand that's out takes to rush back to the player.
@export var toss_time := 0.3 ## Seconds into its heave that it throws them (DefaultStandAnimations.TOSS_TIME).
@export var toss_speed := 10.0 ## m/s up it throws them...
@export var toss_forward := 1.2 ## ...and forward.
@export var hop_time := 0.6 ## Seconds hopping off onto land takes...
@export var hop_height := 1.5 ## ...leaping this many meters above the straight line there.
@export var sink_time := 2.2 ## Seconds sinking, fading to black, before being put back on land.

@onready var player: CharacterBody3D = get_parent()
@onready var possession: Node = player.get_node("Possession")

var state := State.IDLE
var _stand: Node3D
var _swimmer: Node
var _camera: Camera3D
var _last_safe: Transform3D # The last dry ground the player stood on.
var _dried := true # Out of the water since the last time in, so the stand can come again.
var _wet_time := 0.0


func _ready() -> void:
	_last_safe = player.global_transform


func is_riding() -> bool:
	return state == State.RIDING


## Whether anything is happening (the stand catching them, riding, hopping off, sinking): no summoning.
func is_busy() -> bool:
	return state != State.IDLE


## The stand being ridden (or catching them), or null.
func get_stand() -> Node3D:
	return _stand if is_instance_valid(_stand) else null


## Where the player is put back after sinking.
func last_safe_ground() -> Vector3:
	return _last_safe.origin


## ...and facing the way they were (losing a fight puts them back here too: stand_encounter.gd).
func last_safe_transform() -> Transform3D:
	return _last_safe


func _physics_process(delta: float) -> void:
	match state:
		State.IDLE:
			_watch_water(delta)
		State.TOSS:
			_follow_toss()
		State.RIDING:
			_pin()


func _process(_delta: float) -> void:
	if state == State.RIDING:
		_pin() # Again as it's drawn, so the player sits right on the stand's back between physics steps.


# Remembers dry ground the player stands on, and starts the stand coming once they're in deep.
func _watch_water(delta: float) -> void:
	var possessing: bool = possession.is_possessing()
	if not possessing and player.is_safe_ground():
		_last_safe = Transform3D(Basis(Vector3.UP, player.rotation.y), player.global_position)
	var depth: float = player.submersion()
	if depth < 0.2:
		_dried = true
		_wet_time = 0.0
	elif not _dried:
		_wet_time += delta
		if _wet_time > 1.5:
			_dried = true # Hopped off into water after all: let it come again.
	if depth < enter_depth or not _dried or possession.is_returning() or possession.is_in_finisher():
		return
	if not Skills.allows(Skills.PLAYER, &"swim"):
		if not possessing:
			_dried = false
			_sink("You haven't learned to swim with your stand...")
		return
	_dried = false
	var stand: Node3D = possession.release_for_ride() if possessing else null
	if stand:
		_catch(stand, true)
		return
	var path: String = possession.ride_stand_path()
	if path == "":
		_sink("You can't swim without a stand...")
		return
	possession.bow.recall()
	_catch(possession.spawn_for_ride(path, _catch_point()), false)


# Where the stand comes up: just in front of the player, mostly under the water.
func _catch_point() -> Vector3:
	var water := get_tree().get_first_node_in_group("water")
	var point := player.global_position + _forward() * catch_gap
	point.y = (water.surface_height_at(point) if water else player.global_position.y) - catch_depth
	return point


func _forward() -> Vector3:
	return StandShape.facing(player)


# The stand comes up in front of the player (rushing there first, if it was out) and throws them up.
func _catch(stand: Node3D, rushing: bool) -> void:
	state = State.CATCH
	_stand = stand
	possession.set_player_active(false)
	for body in StandShape.bodies(stand):
		player.add_collision_exception_with(body)
	_camera = ThirdPersonCamera.new()
	add_child(_camera)
	_camera.setup(stand, player.rotation.y)
	_camera.pitch = deg_to_rad(-6.0) # Low, to keep the player in view as they go up.
	_camera.make_current()
	_swimmer = StandSwimmer.new()
	_swimmer.name = "Swimmer"
	stand.add_child(_swimmer)
	_swimmer.setup(stand, _camera, player)
	# Every rank of Strong Swimmer speeds all of it up: its pace, the limits on it and its hard stroke.
	for stat: String in ["swim_speed", "min_speed", "max_speed", "stroke_speed", "acceleration"]:
		_swimmer.set(stat, Skills.scaled(Skills.PLAYER, "swim_speed", _swimmer.get(stat)))
	_swimmer.depth = catch_depth
	_swimmer.facing = _forward()
	caught.emit(stand)
	if rushing:
		await _swimmer.rush_to(_catch_point(), rush_time)
	await get_tree().process_frame # Its visuals pick up the swimmer.
	if not _still_riding(stand):
		return
	_swimmer.heave()
	await get_tree().create_timer(toss_time, false).timeout
	if not _still_riding(stand):
		return
	# The throw.
	player.set_physics_process(true)
	player.stun(3.0) # No walking about in mid-air.
	player.velocity = Vector3.UP * Skills.scaled(Skills.PLAYER, "toss", toss_speed) + _forward() * toss_forward
	stand.set_swimming(true)
	_swimmer.depth = 0.1
	_swimmer.mode = StandSwimmer.Mode.FOLLOW
	state = State.TOSS
	tossed.emit(stand)


func _still_riding(stand: Node3D) -> bool:
	return is_instance_valid(stand) and stand == _stand and is_instance_valid(_swimmer)


# In the air: the stand swims to where the player will come down, and they land on its back.
func _follow_toss() -> void:
	if not _still_riding(_stand):
		_abandon()
		return
	var seat: Vector3 = _swimmer.seat()
	var feet: float = player.global_position.y - player.body_height * 0.5
	var gravity := player.get_gravity().length()
	var fall := player.velocity.y + sqrt(maxf(player.velocity.y * player.velocity.y + 2.0 * gravity * maxf(feet - seat.y, 0.0), 0.0))
	var landing := player.global_position + Vector3(player.velocity.x, 0.0, player.velocity.z) * (fall / maxf(gravity, 0.1))
	_swimmer.target = landing - (seat - StandShape.center_of_mass(StandShape.bodies(_stand)))
	if player.velocity.y < 0.0 and feet <= seat.y + 0.05:
		_mount()


func _mount() -> void:
	player.set_physics_process(false)
	player.velocity = Vector3.ZERO
	state = State.RIDING
	_swimmer.mode = StandSwimmer.Mode.STEER
	_swimmer.reached_shore.connect(_dismount, CONNECT_ONE_SHOT)
	_pin()
	mounted.emit(_stand)


# Sits the player on the stand's back, facing the way it faces.
func _pin() -> void:
	if not _still_riding(_stand):
		_abandon()
		return
	player.global_position = _swimmer.seat() + Vector3.UP * player.body_height * 0.5
	var front: Vector3 = -_stand.torso.global_basis.z if "torso" in _stand else _forward()
	if Vector2(front.x, front.z).length() > 0.01:
		player.rotation.y = atan2(-front.x, -front.z)


# Reached land: the player hops off onto `spot` and the stand goes back.
func _dismount(spot: Vector3) -> void:
	state = State.DISMOUNT
	var stand := _stand
	_swimmer.mode = StandSwimmer.Mode.HOLD
	# A leap in an arc that comes down on the spot in hop_time.
	var start := player.global_position
	var end: Vector3 = spot + Vector3.UP * (player.body_height * 0.5 + 0.05)
	var tween := create_tween()
	tween.tween_method(func(t: float) -> void:
		player.global_position = start.lerp(end, t) + Vector3.UP * hop_height * 4.0 * t * (1.0 - t),
		0.0, 1.0, hop_time)
	_camera.watch(player, player.body_height, spot)
	stand.set_swimming(false)
	_swimmer.queue_free()
	_swimmer = null
	_stand = null
	possession.store_from_ride(stand)
	dismounted.emit()
	await tween.finished
	player.velocity = Vector3.ZERO
	_hand_back()


# The ride's over: first person again, and the player is theirs to move.
func _hand_back() -> void:
	if _camera:
		_camera.queue_free()
		_camera = null
	possession.set_player_active(true)
	(player.get_node("Camera3D") as Camera3D).make_current()
	Input.mouse_mode = Input.MOUSE_MODE_CAPTURED
	state = State.IDLE


# The stand went missing mid-ride (freed some other way): drop the player back into the water.
func _abandon() -> void:
	if is_instance_valid(_swimmer):
		_swimmer.queue_free()
	_swimmer = null
	_stand = null
	_hand_back()


# No stand came: they sink while the view fades out, and are put back on dry land.
func _sink(reason: String) -> void:
	state = State.SINKING
	player.stun(sink_time + 0.4)
	sinking.emit(sink_time, reason)
	await get_tree().create_timer(sink_time, false).timeout
	player.global_transform = _last_safe
	player.velocity = Vector3.ZERO
	_dried = true
	state = State.IDLE
	respawned.emit()
