# Fishing: puts something on the end of the line. The instant the arrowhead goes under water (sunk,
# stuck in the seabed, or even mid-reel), a stand bites: one from BITES is spawned around the arrowhead
# and the arrow is hooked into its nearest body, so the bow's normal body-reeling hauls it in. What bites
# depends on where: each entry in BITES bites from its zone outward (island_field.gd zone_at()), picked by
# weight, so further out there's more to catch; the Jellyfish is rare (it counters the final boss's time
# stop). A new stand is one more line there. The scenes load the first time they bite, not preloaded.
# The tutorial cast, the one that carries the pufferfish into the water, always hooks tutorial_stand
# (the Dolphin Stand) instead, and only that once.
#
# If the player already has a stand ready and what bites can be summoned, it isn't hooked at all: it comes
# out of the water fighting (stand_encounter.gd can_challenge() and begin()).
#
# Otherwise it fights the line: a thrasher (thrasher.gd) makes the stand thrash in bursts with calm spells between,
# and while it thrashes the haul slows to a crawl, so it comes in mostly during the calm spells. It
# can't get away. Haul it all the way in and it's caught: `caught` is emitted, and the inventory
# (inventory.gd) takes it out of the world.
#
# Stands can be any scene made of RigidBody3Ds: the thrasher only measures their size and mass. A
# stand with a `start_limp` property (the shared stand body, stand_body.gd) has it set before it's added.
#
# Gameplay only: it reads the bow (bow.gd, its parent) and drives the stand through its thrasher. The
# HUD and messages live in fishing_visuals.gd (the Visuals child), which reads the state
# exposed below and listens to the signals.
# Generated by Claude Code.
extends Node

## Something bit and is now hooked on the arrow.
signal bite(stand: Node3D)
## The stand was hauled all the way in.
signal caught(stand: Node3D)

enum State { IDLE, HOOKED }

const Thrasher := preload("res://Scripts/Stands/thrasher.gd")
const StandShape := preload("res://Scripts/Stands/stand_shape.gd")

## What can bite: each stand's scene, the zone it starts biting from (island_field.gd), and its weight
## among the others biting there.
const BITES := [
	{"path": "res://scenes/stands/anchovy_stand.tscn", "from_zone": 0, "weight": 1.0},
	{"path": "res://scenes/stands/test_crate.tscn", "from_zone": 0, "weight": 1.0},
	{"path": "res://scenes/stands/squid_stand.tscn", "from_zone": 1, "weight": 1.0},
	{"path": "res://scenes/stands/lobster_stand.tscn", "from_zone": 2, "weight": 1.0},
	{"path": "res://scenes/stands/jellyfish_stand.tscn", "from_zone": 3, "weight": 0.17}, # About 1 bite in 25 there.
]
const IslandField := preload("res://Scripts/World/island_field.gd")

static var _loaded := {} # Path -> PackedScene, loaded on first bite.
## The tutorial stand: what bites the arrow carrying the pufferfish into the water. That happens once
## ever, so it can never be caught again; it's never one of the random bites.
@export var tutorial_stand: PackedScene = preload("res://scenes/stands/dolphin_stand.tscn")

@export_group("Fight")
@export var min_reel_scale := 0.2 # Share of the bow's normal haul speed while the stand thrashes its hardest.
@export var bite_splash_strength := 0.6 # How big a splash (water.gd splash()) a bite makes.

## The player's stand_encounter.gd (it sets this itself): asked whether a bite comes out fighting instead.
var encounter: Node

@onready var bow: Node3D = get_parent()

var _state := State.IDLE
var _stand: Node3D
var _thrasher: Node
var _hooked_body: RigidBody3D
var _tutorial_pending := false # The tutorial stand's deferred hook is on its way; no random bite meanwhile.


func _ready() -> void:
	bow.body_reeled_in.connect(_on_body_reeled_in)
	bow.pufferfish_lost.connect(_on_pufferfish_lost)


## The path of what bites in `zone`, picked by weight with `roll` (0 to 1) among BITES biting there.
static func pick_bite(zone: int, roll: float) -> String:
	var total := 0.0
	for bite: Dictionary in BITES:
		if zone >= int(bite["from_zone"]):
			total += float(bite["weight"])
	var left := roll * total
	for bite: Dictionary in BITES:
		if zone >= int(bite["from_zone"]):
			left -= float(bite["weight"])
			if left < 0.0:
				return bite["path"]
	return BITES[0]["path"]


## The scene at `path`, loaded once.
static func scene_for(path: String) -> PackedScene:
	if not _loaded.has(path):
		_loaded[path] = load(path)
	return _loaded[path]


func is_hooked() -> bool:
	return _state == State.HOOKED


## True while the hooked stand is thrashing (the haul is slowed).
func is_thrashing() -> bool:
	return _state == State.HOOKED and is_instance_valid(_thrasher) and _thrasher.is_thrashing()


## The hooked stand, or null.
func get_stand() -> Node3D:
	return _stand


## The hooked stand's thrasher, or null.
func get_thrasher() -> Node:
	return _thrasher


func _physics_process(delta: float) -> void:
	var arrow: RigidBody3D = bow.get_arrow()
	match _state:
		State.IDLE:
			# The pufferfish cast is the tutorial's to hook (_on_pufferfish_lost).
			if arrow and arrow.is_in_water() and not arrow.carries_pufferfish and not _tutorial_pending:
				var scene := scene_for(pick_bite(IslandField.zone_at(arrow.head.global_position), randf()))
				if encounter and encounter.can_challenge(scene):
					encounter.begin(scene, arrow.head.global_position) # It comes out fighting.
				else:
					_hook(arrow, scene)
		State.HOOKED:
			if arrow == null or not is_instance_valid(_stand) or not is_instance_valid(_thrasher):
				_finish()
			else:
				_fight(delta)


# The pufferfish went into the water on the arrow: the tutorial stand takes it, instead of a random
# bite. Deferred, as this comes from the arrow's physics step.
func _on_pufferfish_lost() -> void:
	if _state == State.HOOKED or tutorial_stand == null:
		return
	var arrow: RigidBody3D = bow.get_arrow()
	if arrow:
		_tutorial_pending = true
		_hook.call_deferred(arrow, tutorial_stand)


func _hook(arrow: RigidBody3D, stand_scene: PackedScene) -> void:
	_tutorial_pending = false
	var stand: Node3D = stand_scene.instantiate()
	if "start_limp" in stand:
		stand.start_limp = true
	var head: Vector3 = arrow.head.global_position
	stand.position = head # The scene root sits at the origin, so position is global.
	stand.rotation.y = randf() * TAU
	var scene := get_tree().current_scene if get_tree().current_scene else get_tree().root
	scene.add_child(stand)

	var thrasher := Thrasher.new()
	thrasher.name = "Thrasher"
	stand.add_child(thrasher)
	thrasher.setup(stand, bow)
	# Centre the stand on the arrowhead, whatever shape it is.
	var offset := head - thrasher.center_of_mass()
	for body: RigidBody3D in thrasher.get_bodies():
		body.global_position += offset
		body.add_collision_exception_with(arrow)
	# Report contacts, so the haul can tell when the stand reaches the shore.
	StandShape.report_contacts(thrasher.get_bodies())
	_hooked_body = thrasher.nearest_body(head)
	arrow.hook_into(_hooked_body)

	_stand = stand
	_thrasher = thrasher
	var water := get_tree().get_first_node_in_group("water")
	if water:
		water.splash(thrasher.center_of_mass(), bite_splash_strength) # It breaks the surface.
	_state = State.HOOKED
	bite.emit(stand)


func _fight(delta: float) -> void:
	bow.body_reel_speed_scale = lerpf(1.0, min_reel_scale, _thrasher.intensity)
	# Haul it flat through open water, so it stays in to fight; lift it once it reaches the shore.
	bow.body_reel_lift = 1.0 if StandShape.touching_ground(_thrasher.get_bodies()) else 0.0
	if bow.is_reeling():
		_drag_rest_of_stand(delta)


# The bow hauls only the body the arrow is in. For stands made of several bodies, pull the others
# along at the same horizontal speed, so the rest isn't dragged behind as dead weight. Their vertical
# speed is left alone, so gravity always acts on them.
func _drag_rest_of_stand(delta: float) -> void:
	var lead := Vector2(_hooked_body.linear_velocity.x, _hooked_body.linear_velocity.z)
	for body: RigidBody3D in _thrasher.get_bodies():
		if body == _hooked_body or not is_instance_valid(body):
			continue
		var velocity := body.linear_velocity
		var horizontal := Vector2(velocity.x, velocity.z).move_toward(lead, bow.body_reel_acceleration * delta)
		body.linear_velocity = Vector3(horizontal.x, velocity.y, horizontal.y)


func _on_body_reeled_in(body: RigidBody3D) -> void:
	if _state != State.HOOKED or body != _hooked_body:
		return
	var landed := _stand
	_thrasher.queue_free() # Landed stands lie still.
	_finish()
	caught.emit(landed)


func _finish() -> void:
	_state = State.IDLE
	_stand = null
	_thrasher = null
	_hooked_body = null
	bow.body_reel_speed_scale = 1.0
	bow.body_reel_lift = 1.0
