# Debug tool for testing stands: press F1 to put a stand straight into the inventory (inventory.gd)
# without fishing for it. Each press adds one of every stand in `stands`, so it's ready to summon with
# Q or pick from the inventory screen. Only active in debug builds (running from the editor), never in
# an exported game. The key is fixed rather than in the rebindable controls, since it's a dev tool.
# Generated by Claude Code.
extends Node

@export var inventory: Node # inventory.gd
@export var stands: Array[String] = [
	"res://scenes/stands/dolphin_stand.tscn",
	"res://scenes/stands/anchovy_stand.tscn",
	"res://scenes/stands/squid_stand.tscn",
	"res://scenes/stands/lobster_stand.tscn",
	"res://scenes/stands/jellyfish_stand.tscn",
] # What F1 adds (loaded when pressed, not preloaded: see scene_loader.gd).
@export var key := KEY_F1


func _ready() -> void:
	if not OS.is_debug_build():
		queue_free()


func _unhandled_input(event: InputEvent) -> void:
	if event is InputEventKey and event.pressed and not event.echo and event.keycode == key:
		get_viewport().set_input_as_handled()
		for path in stands:
			_add(load(path) as PackedScene)


# Stores one stand of `scene`'s kind, named and flagged just as a caught one would be.
func _add(scene: PackedScene) -> void:
	var state := scene.get_state()
	var summonable := true
	for i in state.get_node_property_count(0):
		if state.get_node_property_name(0, i) == &"metadata/summonable":
			summonable = state.get_node_property_value(0, i)
	inventory.store(scene.resource_path, scene.resource_path.get_file().get_basename().capitalize(), summonable)
	print("Debug: added %s to the inventory (now x%d)" % [scene.resource_path.get_file().get_basename().capitalize(), inventory.count(scene.resource_path)])
