# Fishing presentation: a "Fish on!" HUD while it's hooked (the title pulses while the stand thrashes,
# when the reel is slowed), and a short message when it's caught. The bite's splash is the water's
# (fishing.gd calls water.gd splash()).
# Purely presentation. It only reads the fishing gameplay node (fishing.gd, its parent): is_hooked(),
# is_thrashing(), get_thrasher() and its signals. Gameplay never reads anything here.
# Generated by Claude Code.
extends Node

@export var bottom_offset := 190.0 # Pixels from the bottom of the screen to the HUD (above the bow's reel prompt).
@export var hooked_color := Color(1.0, 0.85, 0.35)
@export var thrash_color := Color(0.95, 0.35, 0.25)
@export var thrash_pulse_speed := 14.0 # Radians per second of the title's pulsing while the stand thrashes.
@export var caught_color := Color(0.35, 0.85, 0.45)
@export var message_time := 1.8 # Seconds the caught message stays before fading out.

@onready var fishing: Node = get_parent()

var _hud: Control
var _title: Label
var _message: Label
var _message_tween: Tween
var _time := 0.0


func _ready() -> void:
	_build_ui()
	fishing.caught.connect(func(_stand: Node3D) -> void: _show_message("Caught! Added to inventory", caught_color))


func _process(delta: float) -> void:
	_hud.visible = fishing.is_hooked()
	if not _hud.visible:
		return
	_time += delta
	if fishing.is_thrashing():
		var pulse := 0.5 + 0.5 * sin(_time * thrash_pulse_speed)
		_title.add_theme_color_override("font_color", thrash_color)
		_title.scale = Vector2.ONE * (1.0 + 0.12 * pulse)
	else:
		_title.add_theme_color_override("font_color", hooked_color)
		_title.scale = Vector2.ONE


func _show_message(text: String, color: Color) -> void:
	_message.add_theme_color_override("font_color", color)
	_message_tween = HudStyle.flash(_message, text, message_time, _message_tween)


func _build_ui() -> void:
	var layer := CanvasLayer.new()
	add_child(layer)

	_hud = VBoxContainer.new()
	_hud.alignment = BoxContainer.ALIGNMENT_END
	_hud.mouse_filter = Control.MOUSE_FILTER_IGNORE
	layer.add_child(_hud)
	_hud.set_anchors_and_offsets_preset(Control.PRESET_CENTER_BOTTOM, Control.PRESET_MODE_KEEP_WIDTH)
	_hud.offset_left = -200.0
	_hud.offset_right = 200.0
	_hud.offset_top = -bottom_offset - 70.0
	_hud.offset_bottom = -bottom_offset
	_hud.visible = false

	_title = HudStyle.label(30, "Fish on!")
	_title.resized.connect(func() -> void: _title.pivot_offset = _title.size / 2.0)
	_hud.add_child(_title)
	_hud.add_child(HudStyle.label(16, "Reel it in - it slows you down while it thrashes"))

	_message = HudStyle.label(36, "")
	_message.modulate.a = 0.0
	layer.add_child(_message)
	_message.set_anchors_and_offsets_preset(Control.PRESET_CENTER, Control.PRESET_MODE_MINSIZE)
	_message.offset_left = -300.0
	_message.offset_right = 300.0
	_message.offset_top = -120.0
	_message.offset_bottom = -70.0
