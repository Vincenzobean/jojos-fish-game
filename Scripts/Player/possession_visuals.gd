# Possession presentation: while a stand is controlled, a prompt with its controls; otherwise a small
# corner hint for summoning, the inventory screen and the skill trees. Refused summons
# show their reason as a short fading message, and so does a stand reaching the edge of its range, and
# XP won by beating a target dummy (Skills; a wild stand's fight says its own).
# A beaten stand washes the screen red and says so.
# The summon hint hides while the player rides their stand (stand_ride.gd).
# Purely presentation. It only reads the possession node (possession.gd, its parent), its inventory and
# Skills, and listens to their signals. Gameplay never reads anything here.
# Generated by Claude Code.
extends Node

@export var message_time := 1.6 # Seconds a refusal stays before fading out.
@export var message_color := Color(1.0, 0.55, 0.45)

@onready var possession: Node = get_parent()

var _prompt: Label
var _hint: Label
var _message: Label
var _message_tween: Tween
var _was_at_limit := false
var _flash: ColorRect # A red wash over the screen when the stand is beaten, fading.


func _ready() -> void:
	_build_ui()
	possession.summoned.connect(_on_summoned)
	possession.returned.connect(_refresh)
	possession.returning.connect(func(_stand: Node3D) -> void: _refresh())
	possession.summon_refused.connect(_show_message)
	possession.stand_died.connect(_on_stand_died)
	possession.inventory.changed.connect(_refresh)
	Skills.xp_gained.connect(_on_xp_gained)
	_refresh()


func _process(_delta: float) -> void:
	# A stand reaching the edge of its range (stand_controller.gd) says so once each time.
	var stand: Node3D = possession.get_possessed()
	var controller: Node = stand.get_node_or_null("Controller") if stand else null
	var at_limit: bool = controller != null and controller.at_range_limit()
	if at_limit and not _was_at_limit:
		_show_message("Out of range")
	_was_at_limit = at_limit
	_prompt.visible = possession.is_possessing() and not possession.is_returning() and not possession.is_in_finisher()
	# Riding the stand through the water (stand_ride.gd) has its own prompt: no summon hint meanwhile.
	var riding: bool = possession.ride != null and possession.ride.is_busy()
	_hint.visible = not possession.is_possessing() and not riding


func _refresh() -> void:
	var inventory: Node = possession.inventory
	var possessing: bool = possession.is_possessing()
	_prompt.visible = possessing and not possession.is_returning()
	if possessing:
		var path: String = possession.get_possessed().scene_file_path
		_prompt.text = "Controlling %s  -  WASD fly, Shift dash, Space/Ctrl up/down, LMB light, RMB heavy, F block, K skills, Q return" % path.get_file().get_basename().capitalize()

	var stand: String = inventory.stand_to_summon()
	if stand != "":
		_hint.text = "Q: summon %s (x%d)   Tab: inventory   K: skills" % [inventory.display_name(stand), inventory.count(stand)]
	else:
		_hint.text = "Tab: inventory   K: skills"


func _on_summoned(_stand: Node3D) -> void:
	_refresh()


# XP won outside a wild stand's fight (a target dummy beaten; the encounter's visuals say their own).
func _on_xp_gained(_key: String, amount: int, multiplier: float, _points_gained: int) -> void:
	if possession.encounter and possession.encounter.is_active():
		return
	var text := "+%d XP" % amount
	if multiplier > 1.01:
		text += "  (x%.1f catch-up)" % multiplier
	_show_message(text)


# The stand was beaten: the screen washes red and fades, and a message says so.
func _on_stand_died(stand: Node3D) -> void:
	_show_message("%s was defeated" % stand.scene_file_path.get_file().get_basename().capitalize())
	_flash.color.a = 0.45
	var tween := create_tween()
	tween.tween_property(_flash, "color:a", 0.0, 1.6).set_ease(Tween.EASE_IN)


func _show_message(text: String) -> void:
	_message_tween = HudStyle.flash(_message, text, message_time, _message_tween)


func _build_ui() -> void:
	var layer := CanvasLayer.new()
	add_child(layer)

	_flash = ColorRect.new()
	_flash.color = Color(0.75, 0.05, 0.05, 0.0)
	_flash.mouse_filter = Control.MOUSE_FILTER_IGNORE
	layer.add_child(_flash)
	_flash.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)

	_prompt = HudStyle.label(20)
	layer.add_child(_prompt)
	_prompt.set_anchors_and_offsets_preset(Control.PRESET_CENTER_BOTTOM, Control.PRESET_MODE_MINSIZE)
	_prompt.offset_left = -400.0
	_prompt.offset_right = 400.0
	_prompt.offset_top = -70.0
	_prompt.offset_bottom = -40.0

	_hint = HudStyle.label(16)
	_hint.horizontal_alignment = HORIZONTAL_ALIGNMENT_RIGHT
	layer.add_child(_hint)
	_hint.set_anchors_and_offsets_preset(Control.PRESET_TOP_RIGHT, Control.PRESET_MODE_MINSIZE)
	_hint.offset_left = -520.0
	_hint.offset_right = -16.0
	_hint.offset_top = 12.0
	_hint.offset_bottom = 40.0

	_message = HudStyle.label(30)
	_message.add_theme_color_override("font_color", message_color)
	_message.modulate.a = 0.0
	layer.add_child(_message)
	_message.set_anchors_and_offsets_preset(Control.PRESET_CENTER, Control.PRESET_MODE_MINSIZE)
	_message.offset_left = -300.0
	_message.offset_right = 300.0
	_message.offset_top = -170.0
	_message.offset_bottom = -130.0
