# The pufferfish's tutorial: voice lines (assets/audio/puffertutorial) that walk the player from waking up
# to catching the Dolphin Stand. Each line asks for something, and the next plays once it's done:
#   wake (look around) -> looked (WASD) -> moved (Space) -> jumped, lore (fire the bow) -> launch (the
#   pufferfish's scream as it flies) -> reel (once the Dolphin Stand bites) -> final (once it's caught).
# If they don't look around within nudge_time of the wake line ending, the impatient line plays, once.
# Firing, the bite and the catch skip straight to their own lines whenever they happen, so a player who
# runs ahead isn't held back; the scream cuts off whatever was playing.
#
# It starts start_delay seconds after the player gets control: the title screen keeps the player (and
# so this) disabled until Play's transition is over. The pufferfish isn't saved (bow.gd), so neither is
# this: it plays every launch.
#
# Lines play one at a time on the Voice bus (the "Mute Voices" setting, settings.gd), queued in order.
# Generated by Claude Code.
extends Node

enum Step { WAIT, LOOK, MOVE, JUMP, CAST, HOOK, CATCH, DONE }

const DIR := "res://assets/audio/puffertutorial/"
const LINES := {
	&"wake": preload(DIR + "I just woke up.wav"),
	&"impatient": preload(DIR + "Impatient puffer.wav"),
	&"looked": preload(DIR + "First Puffer request Complete.wav"),
	&"moved": preload(DIR + "successful wasd presses.wav"),
	&"jumped": preload(DIR + "successful jump.wav"),
	&"lore": preload(DIR + "lore dump.wav"),
	&"launch": preload(DIR + "Launch Scream.wav"),
	&"reel": preload(DIR + "Reel in command.wav"),
	&"final": preload(DIR + "Final tutorial piece.wav"),
}

@export var bow: Node3D # bow.gd
@export var fishing: Node # fishing.gd: its tutorial_stand is the one this waits on.
@export var start_delay := 1.0 ## Seconds after the player gets control before the first line.
@export var nudge_time := 3.0 ## Seconds after the wake line ends, without looking around, before the impatient line.
@export var look_needed := 0.6 ## Radians of looking around (turning plus tilting, all added up) that count.
@export var move_needed := 2.0 ## Metres walked that count as moving.

@onready var player: CharacterBody3D = get_parent()

var _step := Step.WAIT
var _start_left := 0.0
var _voice: AudioStreamPlayer
var _queue: Array[StringName] = []
var _current := &"" # The line playing, or &"".
var _wake_done := false
var _nudge_left := 0.0
var _nudged := false
var _looked := 0.0
var _last_yaw := 0.0
var _last_pitch := 0.0
var _move_from := Vector3.ZERO


func _ready() -> void:
	_start_left = start_delay
	_nudge_left = nudge_time
	_voice = AudioStreamPlayer.new()
	_voice.bus = Settings.VOICE_BUS
	_voice.finished.connect(_on_line_done)
	add_child(_voice)
	bow.fired.connect(_on_fired)
	fishing.bite.connect(_on_bite)
	fishing.caught.connect(_on_caught)


## The step the tutorial is waiting on.
func get_step() -> Step:
	return _step


## The line playing, or &"".
func get_line() -> StringName:
	return _current


func _process(delta: float) -> void:
	match _step:
		Step.WAIT:
			_start_left -= delta
			if _start_left <= 0.0:
				_say(&"wake")
				_last_yaw = player.rotation.y
				_last_pitch = player.camera.rotation.x
				_step = Step.LOOK
		Step.LOOK:
			_looked += absf(angle_difference(_last_yaw, player.rotation.y)) + absf(player.camera.rotation.x - _last_pitch)
			_last_yaw = player.rotation.y
			_last_pitch = player.camera.rotation.x
			if _looked >= look_needed:
				_say(&"looked")
				_move_from = player.global_position
				_step = Step.MOVE
			elif _wake_done and not _nudged:
				_nudge_left -= delta
				if _nudge_left <= 0.0:
					_nudged = true
					_say(&"impatient")
		Step.MOVE:
			var walked := player.global_position - _move_from
			if Vector2(walked.x, walked.z).length() >= move_needed:
				_say(&"moved")
				_step = Step.JUMP
		Step.JUMP:
			if not player.is_on_floor() and player.velocity.y > 1.0:
				_say(&"jumped")
				_say(&"lore")
				_step = Step.CAST


func _on_fired(_draw_amount: float) -> void:
	if _step >= Step.HOOK or not bow.has_pufferfish():
		return
	_interrupt(&"launch")
	_step = Step.HOOK


func _on_bite(stand: Node3D) -> void:
	if _step >= Step.CATCH or not _is_tutorial_stand(stand):
		return
	_say(&"reel")
	_step = Step.CATCH


func _on_caught(stand: Node3D) -> void:
	if _step >= Step.DONE or not _is_tutorial_stand(stand):
		return
	_say(&"final")
	_step = Step.DONE


func _is_tutorial_stand(stand: Node3D) -> bool:
	return fishing.tutorial_stand != null and is_instance_valid(stand) \
			and stand.scene_file_path == fishing.tutorial_stand.resource_path


# Queues a line after whatever's playing.
func _say(id: StringName) -> void:
	_queue.append(id)
	if _current == &"":
		_play_next()


# Cuts off the line playing and anything queued, and plays this instead.
func _interrupt(id: StringName) -> void:
	_queue.clear()
	_voice.stop()
	_current = &""
	_say(id)


func _play_next() -> void:
	if _queue.is_empty():
		return
	_current = _queue.pop_front()
	_voice.stream = LINES[_current]
	_voice.play()


func _on_line_done() -> void:
	if _current == &"wake":
		_wake_done = true
	_current = &""
	_play_next()
