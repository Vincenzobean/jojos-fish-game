# The player's inventory of stands. Every stand fishing (fishing.gd) hauls in is taken out of the world
# and stored here by kind (its scene file), with a count. Kinds are listed in the order first caught.
#
# Most stands can be summoned and controlled (possession.gd). A stand scene opts out by putting
# `summonable = false` in its root's metadata (the test crate does). The `selected` kind is the one the
# summon key brings out. Lasts for the session only.
# Generated by Claude Code.
extends Node

## The contents or the selection changed.
signal changed

@export var fishing: Node # The fishing node (fishing.gd) whose stands end up here.

## The kind the summon key brings out (a scene path), or "" for none.
var selected := ""

var _order: Array[String] = []
var _kinds := {} # Scene path -> {name: String, summonable: bool, count: int}


func _ready() -> void:
	if fishing:
		fishing.caught.connect(_on_caught)


## Stores `stand` (a stand scene's root) and removes it from the world.
func add(stand: Node) -> void:
	var path := stand.scene_file_path
	store(path, path.get_file().get_basename().capitalize(), stand.get_meta("summonable", true))
	stand.queue_free()


## Adds one of the kind at `path` (named `display_name`) without needing it in the world.
func store(path: String, display_name: String, summonable := true) -> void:
	if not _kinds.has(path):
		_kinds[path] = {"name": display_name, "summonable": summonable, "count": 0}
		_order.append(path)
	_kinds[path].count += 1
	changed.emit()


## Takes one of the kind at `path` out. Returns false if there were none.
func remove_one(path: String) -> bool:
	if count(path) == 0:
		return false
	_kinds[path].count -= 1
	if _kinds[path].count == 0:
		_kinds.erase(path)
		_order.erase(path)
	changed.emit()
	return true


func count(path: String) -> int:
	return _kinds[path].count if _kinds.has(path) else 0


## Every kind held, in the order first caught.
func kinds() -> Array[String]:
	return _order


func display_name(path: String) -> String:
	return _kinds[path].name if _kinds.has(path) else ""


## Whether a stand of the kind at `path` is held and can be summoned.
func is_summonable(path: String) -> bool:
	return _kinds.has(path) and _kinds[path].summonable


func is_empty() -> bool:
	return _order.is_empty()


## The kind the summon key should bring out: the selected one if it's held and summonable, otherwise
## the first summonable kind held, otherwise "".
func stand_to_summon() -> String:
	if is_summonable(selected):
		return selected
	for path in _order:
		if is_summonable(path):
			return path
	return ""


func select(path: String) -> void:
	selected = path
	changed.emit()


func _on_caught(stand: Node3D) -> void:
	add(stand)
