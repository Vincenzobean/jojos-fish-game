# Debug tool for skill trees (the Skills autoload): F3 gives `points` skill points to the shared pool;
# F4 takes back everything bought in the player's tree and every kind of stand held (inventory.gd),
# returning the points to the pool.
# Only active in debug builds (running from the editor), never in an exported game. The keys are fixed
# rather than in the rebindable controls, since it's a dev tool.
# Generated by Claude Code.
extends Node

@export var inventory: Node # inventory.gd
@export var points := 5
@export var key := KEY_F3 ## Gives points...
@export var refund_key := KEY_F4 ## ...and refunds every tree.


func _ready() -> void:
	if not OS.is_debug_build():
		queue_free()


func _unhandled_input(event: InputEvent) -> void:
	if not (event is InputEventKey and event.pressed and not event.echo):
		return
	if event.keycode == key:
		get_viewport().set_input_as_handled()
		Skills.grant_points(points)
		print("Debug: gave %d skill points to the pool" % points)
	elif event.keycode == refund_key:
		get_viewport().set_input_as_handled()
		var keys: Array[String] = [Skills.PLAYER]
		for path: String in inventory.kinds():
			if inventory.is_summonable(path):
				keys.append(path)
		for tree_key in keys:
			Skills.refund_all(tree_key)
		print("Debug: refunded the skills of %s" % ", ".join(keys))
