# 3rd-person camera for a possessed stand (see possession.gd): orbits the stand's center of mass,
# turned with the mouse (the same sensitivity and invert Y settings as the player's view). Its `yaw` is
# what the stand controller (stand_controller.gd) treats as "forward".
#
# It sits further back for bigger stands, and the mouse wheel zooms in and out (remembered between
# summons). A ray from the stand to where the camera wants to be pulls it
# in front of anything in the way, so it never ends up inside an island, and it's kept just above the
# water so it doesn't dip under the surface. It follows smoothly rather than rigidly.
# Generated by Claude Code.
extends Camera3D

const StandShape := preload("res://Scripts/Stands/stand_shape.gd")

@export var mouse_sensitivity := 0.002 # Radians per pixel, before the Settings multiplier (matches player.gd).
@export var min_pitch := -70.0 # Degrees; negative looks down from above...
@export var max_pitch := 30.0 # ...positive looks up from below.
@export var start_pitch := -20.0
@export var base_distance := 2.0 # Meters behind the stand, plus...
@export var size_distance := 2.5 # ...this many lengths of the stand.
@export var target_height := 0.3 # Aim this many lengths of the stand above its center of mass.
@export var follow_sharpness := 10.0 # Higher catches up with the wanted position faster.
@export var obstacle_margin := 0.3 # Meters kept between the camera and anything it's pulled in front of.
@export var water_clearance := 0.3 # Meters kept above the water surface.
@export_group("Zoom")
@export var zoom_step := 0.12 # Share of the distance each mouse wheel notch zooms in or out.
@export var min_zoom := 0.25 # Closest, as a share of the normal distance...
@export var max_zoom := 1.6 # ...and furthest.

## Which way the camera faces around the vertical axis, in radians (0 looks along -Z).
var yaw := 0.0
var pitch := 0.0

var _bodies: Array[RigidBody3D] = []
var _size := 1.0
var _water: Node
var _placed := false
static var _zoom := 1.0 # Share of the normal distance; kept between summons.
var _watch: Node3D # Something watched instead of the stand (see watch()), or null.


## Starts following `stand_root`, looking in the direction `start_yaw`.
func setup(stand_root: Node3D, start_yaw: float) -> void:
	_bodies = StandShape.bodies(stand_root)
	_size = StandShape.size(stand_root)
	_water = get_tree().get_first_node_in_group("water")
	yaw = start_yaw
	pitch = deg_to_rad(start_pitch)
	_placed = false


## Stops following the stand and orbits `node` instead (framed for something `node_size` tall), turned
## to look past it toward `look_toward`: used to watch a stand fly home into its user.
func watch(node: Node3D, node_size: float, look_toward: Vector3) -> void:
	_watch = node
	_size = node_size
	var toward := look_toward - node.global_position
	if Vector2(toward.x, toward.z).length() > 0.01:
		yaw = atan2(-toward.x, -toward.z)
	pitch = deg_to_rad(-10.0)


func _unhandled_input(event: InputEvent) -> void:
	if event is InputEventMouseMotion and Input.mouse_mode == Input.MOUSE_MODE_CAPTURED:
		var look: Vector2 = event.relative * mouse_sensitivity * Settings.get_value("controls", "mouse_sensitivity")
		if Settings.get_value("controls", "invert_y"):
			look.y = -look.y
		yaw -= look.x
		pitch = clampf(pitch - look.y, deg_to_rad(min_pitch), deg_to_rad(max_pitch))
	elif event is InputEventMouseButton and event.pressed and event.button_index in [MOUSE_BUTTON_WHEEL_UP, MOUSE_BUTTON_WHEEL_DOWN]:
		# Wheel up zooms in. Smooth-scrolling devices report part-notches in `factor`.
		var notches: float = event.factor if event.factor > 0.0 else 1.0
		if event.button_index == MOUSE_BUTTON_WHEEL_UP:
			notches = -notches
		_zoom = clampf(_zoom * pow(1.0 + zoom_step, notches), min_zoom, max_zoom)
	elif event is InputEventMouseButton and event.pressed:
		Input.mouse_mode = Input.MOUSE_MODE_CAPTURED


# Follows in the physics step, in lockstep with the stand: the stand only moves on physics ticks, so
# following it once per drawn frame made the view shudder whenever the frame rate wasn't the physics
# rate (frames with no tick, then frames with two). That showed most out at sea, where less to draw
# pushes the frame rate up.
func _physics_process(delta: float) -> void:
	var target: Vector3
	if _watch != null and is_instance_valid(_watch):
		target = _watch.global_position + Vector3.UP * _size * target_height
	elif not _bodies.is_empty() and is_instance_valid(_bodies[0]):
		target = StandShape.center_of_mass(_bodies) + Vector3.UP * _size * target_height
	else:
		return
	var offset := Basis(Vector3.UP, yaw) * Basis(Vector3.RIGHT, pitch) * Vector3(0.0, 0.0, (base_distance + _size * size_distance) * _zoom)
	var wanted := _unblocked(target, target + offset)
	if _water:
		wanted.y = maxf(wanted.y, _water.surface_height_at(wanted) + water_clearance)

	if _placed:
		global_position = global_position.lerp(wanted, 1.0 - exp(-follow_sharpness * delta))
	else:
		global_position = wanted
		_placed = true
	if global_position.distance_squared_to(target) > 0.0001:
		look_at(target)


# Where the camera can actually go: `wanted`, or just in front of whatever is between it and the stand.
func _unblocked(target: Vector3, wanted: Vector3) -> Vector3:
	var query := PhysicsRayQueryParameters3D.create(target, wanted)
	var excluded: Array[RID] = []
	for body in _bodies:
		if is_instance_valid(body):
			excluded.append(body.get_rid())
	if _watch is CollisionObject3D and is_instance_valid(_watch):
		excluded.append((_watch as CollisionObject3D).get_rid())
	query.exclude = excluded
	var hit := get_world_3d().direct_space_state.intersect_ray(query)
	if hit.is_empty():
		return wanted
	return hit.position + (target - wanted).normalized() * obstacle_margin
