# The rope tethering the arrow to the bow, simulated as a chain of points so it trails behind the arrow
# in flight, sags under gravity, and drapes over the islands and floats on the water once the arrow lands.
# Reeling pulls the slack in until it's taut, and it wobbles while being reeled.
#
# Purely presentation. It only reads the gameplay bow (bow.gd, its parent): get_arrow(), is_reeling(),
# arrow_spawn and camera. Gameplay never reads the rope; its physics only moves the drawn rope, never
# the arrow or anything else.
#
# How it works:
#   * Physics (_physics_process): Verlet integration. Each point remembers where it was last tick, so
#     its velocity is implicit; gravity and air drag act on it, then the gaps between neighbours are
#     pulled back to at most one segment length (a rope resists stretching but not bunching up). The
#     first point is pinned to the bow's ArrowSpawn and the last to the arrow.
#   * Length: the rope pays out `slack` more than the distance to the arrow, so it hangs loosely. While
#     reeling, the slack is taken up fast until it's taut, then it shortens with the arrow.
#   * Ground: each tick one short raycast per point finds the ground under it, and the constraint loop
#     keeps points above it after every pass, so the rope drapes over the islands without the length
#     and the ground fighting each other. Points resting on the ground lose most sideways speed.
#   * Water: not a floor. Under the surface, rope is buoyed up and heavily slowed, so loose rope floats
#     while rope tied to a sunken arrow dips down to it.
#   * Drawing (_process): a smooth curve through the points, turned into a tube mesh each frame with the
#     twisted-rope shader. The reel wobble is added here as sideways offsets along the curve, fading out
#     near both ends so the rope stays attached.
# Generated by Claude Code.
extends Node

const ROPE_SHADER := preload("res://assets/rope/rope.gdshader")
const DEFAULT_WATER_HEIGHT := 0.4 # Meters. Used if there's no water node to ask.
const GROUND_PROBE_HEIGHT := 1.0 # Meters above a point (or where it was last tick) the ground raycast starts...
const GROUND_PROBE_DEPTH := 2.0 # ...and below it that it ends.
const GROUND_CONTACT := 0.02 # Meters. A point this close to the ground counts as resting on it.

@export_group("Physics")
@export var point_count := 48 # Points along the rope, ends included.
@export var slack := 0.06 # Extra rope paid out, as a share of the distance to the arrow.
@export var gravity := 9.8
@export var air_drag := 1.5 # Share of speed lost per second to the air; keeps the rope from swinging forever.
@export var constraint_iterations := 20 # More holds the rope's length more stiffly (less stretchy-looking).
@export var ground_friction := 0.6 # 0-1: how much sideways speed a point resting on the ground loses each tick.
@export var rope_buoyancy := 14.7 # Upward push on rope under the water, m/s^2; above gravity, so loose rope floats up to the surface.
@export var rope_water_drag := 6.0 # Share of speed lost per second under the water; much more than in air, so it floats up gently.
@export var reel_take_up_speed := 80.0 # Meters per second of slack pulled in when reeling starts.
@export var collide := true # Drape over islands; off lets the rope pass through them (it still floats on water).

@export_group("Look")
@export var radius := 0.01 # Meters.
@export var radial_segments := 6 # Sides of the tube.
@export var render_subdivisions := 4 # Smooth-curve points drawn per physics segment.

@export_group("Reel wobble")
@export var wobble_max_amplitude := 0.15 # Meters of sideways swing on a long rope...
@export var wobble_amplitude_per_meter := 0.03 # ...but no more than this much per meter of rope.
@export var wobble_wavelength := 4.0 # Meters per wave along the rope...
@export var wobble_max_waves := 10.0 # ...capped so a very long rope's waves stay smooth.
@export var wobble_speed := 3.0 # Waves per second rippling toward the bow.
@export var wobble_pin_length := 1.5 # Meters at each end over which the swing eases down to nothing.
@export var wobble_ease_in_time := 0.15 # Seconds to build up to full wobble once reeling starts...
@export var wobble_ease_out_time := 0.4 # ...and to settle once it stops.

@onready var bow: Node3D = get_parent()

var _points := PackedVector3Array() # Where each point is now...
var _previous := PackedVector3Array() # ...and where it was last tick (Verlet: the difference is its velocity).
var _rope_length := 0.0 # Meters of rope currently paid out.
var _active := false # Whether the simulation is running (an arrow is out).
var _ray := PhysicsRayQueryParameters3D.new()
var _water_height := DEFAULT_WATER_HEIGHT
var _ground := PackedFloat32Array() # Lowest each point may go this tick (ground height + radius), from _probe_ground.

var _mesh_instance: MeshInstance3D
var _mesh := ArrayMesh.new()
var _material: ShaderMaterial
var _indices := PackedInt32Array() # The tube's triangles; the same every frame, so built once.
var _wobble := 0.0 # 0 = none, 1 = full wobble.
var _wobble_time := 0.0


func _ready() -> void:
	_material = ShaderMaterial.new()
	_material.shader = ROPE_SHADER
	_mesh_instance = MeshInstance3D.new()
	_mesh_instance.mesh = _mesh
	_mesh_instance.material_override = _material
	_mesh_instance.top_level = true # Vertices are built in world space.
	_mesh_instance.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	_mesh_instance.visible = false
	add_child(_mesh_instance)
	_build_indices()


func _physics_process(delta: float) -> void:
	var arrow: RigidBody3D = bow.get_arrow()
	if arrow == null:
		_active = false
		return
	var anchor: Vector3 = bow.arrow_spawn.global_position
	var tail := arrow.global_position
	if not _active:
		_start(anchor, arrow)

	var distance := anchor.distance_to(tail)
	if bow.is_reeling():
		_rope_length = maxf(distance, _rope_length - reel_take_up_speed * delta)
	else:
		_rope_length = maxf(_rope_length, distance * (1.0 + slack))

	_integrate(delta)
	_probe_ground()
	_apply_length(anchor, tail)
	_apply_ground_friction()


func _process(delta: float) -> void:
	_mesh_instance.visible = _active
	if not _active:
		_wobble = 0.0
		return
	if bow.is_reeling():
		_wobble = minf(_wobble + delta / maxf(wobble_ease_in_time, 0.001), 1.0)
	else:
		_wobble = maxf(_wobble - delta / maxf(wobble_ease_out_time, 0.001), 0.0)
	_wobble_time += delta
	_draw()


# Lays the whole rope out at the bow, at rest, for a freshly fired arrow.
func _start(anchor: Vector3, arrow: RigidBody3D) -> void:
	_active = true
	_rope_length = 0.0
	_points.resize(maxi(point_count, 3))
	_points.fill(anchor)
	_previous = _points.duplicate()
	# The rope shouldn't rest on the arrow it's tied to, or on the player holding it.
	var ignored: Array[RID] = [arrow.get_rid()]
	var player := bow.camera.get_parent() as CollisionObject3D
	if player:
		ignored.append(player.get_rid())
	_ray.exclude = ignored
	var water := get_tree().get_first_node_in_group("water")
	_water_height = water.surface_height_at(anchor) if water else DEFAULT_WATER_HEIGHT


# Moves every free point on by its own velocity, slowed by the air, and pulls it down by gravity.
# Under the water it's instead buoyed up (more strongly than gravity, so loose rope floats) and slowed
# much harder, so a rope tied to a sunken arrow can still be pulled down to it.
func _integrate(delta: float) -> void:
	var keep_in_air := exp(-air_drag * delta)
	var keep_in_water := exp(-rope_water_drag * delta)
	var fall := Vector3.DOWN * gravity * delta * delta
	var float_up := Vector3.UP * (rope_buoyancy - gravity) * delta * delta
	for i in range(1, _points.size() - 1):
		var point := _points[i]
		var underwater := point.y < _water_height
		var velocity := (point - _previous[i]) * (keep_in_water if underwater else keep_in_air)
		_previous[i] = point
		_points[i] = point + velocity + (float_up if underwater else fall)


# Finds the ground under every free point, for _apply_length to keep them above. Probed once per tick,
# from a little above the point (or where it was last tick, if higher, so a point that fell through
# something still finds it) to a little below, so ground the constraints might push a point into this
# tick is known too. No ground found is -INF.
func _probe_ground() -> void:
	var count := _points.size()
	if _ground.size() != count:
		_ground.resize(count)
	_ground.fill(-INF)
	if not collide:
		return
	var space := bow.get_world_3d().direct_space_state
	for i in range(1, count - 1):
		var point := _points[i]
		_ray.from = Vector3(point.x, maxf(point.y, _previous[i].y) + GROUND_PROBE_HEIGHT, point.z)
		_ray.to = Vector3(point.x, point.y - GROUND_PROBE_DEPTH, point.z)
		var hit := space.intersect_ray(_ray)
		if not hit.is_empty():
			_ground[i] = hit.position.y + radius


# Pins the ends, then repeatedly pulls apart any neighbours further than one segment apart back
# together, lifting any point pushed into the ground back out after each pass. Doing both in the same
# loop lets them settle on a shape that satisfies both, instead of fighting each other every tick.
# A pinned end doesn't move, so its neighbour takes the whole correction.
func _apply_length(anchor: Vector3, tail: Vector3) -> void:
	var last := _points.size() - 1
	_points[0] = anchor
	_previous[0] = anchor
	_points[last] = tail
	_previous[last] = tail
	var segment := _rope_length / last
	for iteration in constraint_iterations:
		for i in last:
			var a := _points[i]
			var b := _points[i + 1]
			var gap := b - a
			var length := gap.length()
			if length <= segment or length < 0.000001:
				continue
			var correction := gap * ((length - segment) / length)
			if i == 0:
				_points[1] = b - correction
			elif i + 1 == last:
				_points[i] = a + correction
			else:
				_points[i] = a + correction * 0.5
				_points[i + 1] = b - correction * 0.5
		for i in range(1, last):
			var point := _points[i]
			if point.y < _ground[i]:
				point.y = _ground[i]
				_points[i] = point


# Points resting on the ground don't bounce, and most of their sideways drift is rubbed away.
func _apply_ground_friction() -> void:
	for i in range(1, _points.size() - 1):
		var point := _points[i]
		if point.y > _ground[i] + GROUND_CONTACT:
			continue
		var before := _previous[i]
		_previous[i] = Vector3(lerpf(before.x, point.x, ground_friction), point.y, lerpf(before.z, point.z, ground_friction))



# Builds the tube mesh along a smooth curve through the points, with the reel wobble added on.
func _draw() -> void:
	var centers := _smooth_curve()
	var count := centers.size()
	var along := PackedFloat32Array() # Meters from the bow to each curve point.
	along.resize(count)
	for i in range(1, count):
		along[i] = along[i - 1] + centers[i].distance_to(centers[i - 1])
	var total := maxf(along[count - 1], 0.001)
	_material.set_shader_parameter("rope_length", total)

	var amplitude := minf(wobble_max_amplitude, total * wobble_amplitude_per_meter) * smoothstep(0.0, 1.0, _wobble)
	var waves := clampf(total / wobble_wavelength, 1.0, wobble_max_waves)
	var pin := maxf(wobble_pin_length, 0.001)

	var ring := radial_segments + 1 # One extra vertex per ring so the texture's seam wraps cleanly.
	var vertices := PackedVector3Array()
	var normals := PackedVector3Array()
	var uvs := PackedVector2Array()
	vertices.resize(count * ring)
	normals.resize(count * ring)
	uvs.resize(count * ring)

	# Each ring is oriented by carrying the previous ring's "side" direction along the curve with as
	# little twist as possible, so the tube doesn't pinch where the rope bends.
	var tangent := (centers[count - 1] - centers[0]).normalized()
	if tangent.length_squared() < 0.5:
		tangent = Vector3.FORWARD
	var side := tangent.cross(Vector3.UP)
	if side.length_squared() < 0.0001:
		side = tangent.cross(Vector3.RIGHT)
	side = side.normalized()
	for i in count:
		if i > 0:
			var next_tangent := (centers[i] - centers[i - 1]).normalized()
			if next_tangent.length_squared() > 0.5:
				tangent = next_tangent
			var flattened := side - tangent * side.dot(tangent)
			if flattened.length_squared() > 0.000001:
				side = flattened.normalized()
		var up := tangent.cross(side)

		var center := centers[i]
		if amplitude > 0.0:
			var from_arrow := total - along[i]
			var pinned := smoothstep(0.0, pin, along[i]) * smoothstep(0.0, pin, from_arrow)
			var phase := TAU * (from_arrow / total * waves - _wobble_time * wobble_speed)
			# Two directions, with a faster ripple on each, so it snakes in 3D rather than one flat sine wave.
			center += side * (amplitude * pinned * (sin(phase) + 0.35 * sin(2.3 * phase + 1.7)))
			center += up * (amplitude * pinned * 0.7 * (cos(1.3 * phase) + 0.3 * sin(3.1 * phase)))

		for j in ring:
			var angle := TAU * j / radial_segments
			var normal := side * cos(angle) + up * sin(angle)
			var k := i * ring + j
			vertices[k] = center + normal * radius
			normals[k] = normal
			uvs[k] = Vector2(float(j) / radial_segments, along[i] / total)

	var arrays := []
	arrays.resize(Mesh.ARRAY_MAX)
	arrays[Mesh.ARRAY_VERTEX] = vertices
	arrays[Mesh.ARRAY_NORMAL] = normals
	arrays[Mesh.ARRAY_TEX_UV] = uvs
	arrays[Mesh.ARRAY_INDEX] = _indices
	_mesh.clear_surfaces()
	_mesh.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, arrays)


# A Catmull-Rom curve through the physics points, render_subdivisions points per segment, so the
# rope bends smoothly instead of in straight pieces.
func _smooth_curve() -> PackedVector3Array:
	var last := _points.size() - 1
	var steps := maxi(render_subdivisions, 1)
	var curve := PackedVector3Array()
	curve.resize(last * steps + 1)
	for i in last:
		var p0 := _points[maxi(i - 1, 0)]
		var p1 := _points[i]
		var p2 := _points[i + 1]
		var p3 := _points[mini(i + 2, last)]
		for s in steps:
			var t := float(s) / steps
			var t2 := t * t
			var t3 := t2 * t
			curve[i * steps + s] = 0.5 * ((2.0 * p1) + (p2 - p0) * t
					+ (2.0 * p0 - 5.0 * p1 + 4.0 * p2 - p3) * t2 + (3.0 * p1 - p0 - 3.0 * p2 + p3) * t3)
	curve[last * steps] = _points[last]
	return curve


# The tube's triangles: two per quad between each pair of neighbouring rings.
func _build_indices() -> void:
	var count := (maxi(point_count, 3) - 1) * maxi(render_subdivisions, 1) + 1
	var ring := radial_segments + 1
	_indices.clear()
	for i in count - 1:
		for j in radial_segments:
			var a := i * ring + j
			var b := a + ring
			_indices.append_array([a, b, a + 1, a + 1, b, b + 1])
