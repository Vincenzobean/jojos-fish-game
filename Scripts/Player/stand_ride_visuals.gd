# Riding presentation (stand_ride.gd, its parent): while the player rides their stand, a prompt with the
# swimming controls; a splash as they land on its back. When no stand comes and they sink, the view slowly
# fades to black with a message, then fades back in once they're back on land.
# Purely presentation: it only listens to the ride's signals.
# Generated by Claude Code.
extends Node

@onready var ride: Node = get_parent()

var _fade: ColorRect
var _prompt: Label
var _message: Label


func _ready() -> void:
	_build_ui()
	ride.mounted.connect(_on_mounted)
	ride.dismounted.connect(func() -> void: _prompt.visible = false)
	ride.sinking.connect(_on_sinking)
	ride.respawned.connect(_on_respawned)


func _on_mounted(stand: Node3D) -> void:
	_prompt.text = "Riding %s  -  WASD swim, Shift hard stroke, swim to land to get off" % stand.scene_file_path.get_file().get_basename().capitalize()
	_prompt.visible = true
	var player: Node3D = ride.player
	StandEffects.spawn("splash", get_tree().current_scene, player.global_position + Vector3.DOWN * 0.8, 1.2)


func _process(_delta: float) -> void:
	if _prompt.visible and not ride.is_riding():
		_prompt.visible = false


# Sinking: the view darkens slowly to black.
func _on_sinking(seconds: float, reason: String) -> void:
	_message.text = reason
	var tween := create_tween().set_parallel()
	tween.tween_property(_fade, "color:a", 1.0, seconds).set_ease(Tween.EASE_IN).set_trans(Tween.TRANS_SINE)
	tween.tween_property(_message, "modulate:a", 1.0, seconds * 0.4)


# Back on land: the view comes back.
func _on_respawned() -> void:
	var tween := create_tween().set_parallel()
	tween.tween_property(_fade, "color:a", 0.0, 0.8).set_delay(0.2)
	tween.tween_property(_message, "modulate:a", 0.0, 0.6).set_delay(0.6)


func _build_ui() -> void:
	var layer := CanvasLayer.new()
	layer.layer = 5 # Over the HUD.
	add_child(layer)

	_fade = ColorRect.new()
	_fade.color = Color(0.0, 0.0, 0.0, 0.0)
	_fade.mouse_filter = Control.MOUSE_FILTER_IGNORE
	layer.add_child(_fade)
	_fade.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)

	_message = HudStyle.label(30)
	_message.modulate.a = 0.0
	layer.add_child(_message)
	_message.set_anchors_and_offsets_preset(Control.PRESET_CENTER, Control.PRESET_MODE_MINSIZE)
	_message.offset_left = -400.0
	_message.offset_right = 400.0
	_message.offset_top = -20.0
	_message.offset_bottom = 20.0

	_prompt = HudStyle.label(20)
	_prompt.visible = false
	layer.add_child(_prompt)
	_prompt.set_anchors_and_offsets_preset(Control.PRESET_CENTER_BOTTOM, Control.PRESET_MODE_MINSIZE)
	_prompt.offset_left = -400.0
	_prompt.offset_right = 400.0
	_prompt.offset_top = -70.0
	_prompt.offset_bottom = -40.0
