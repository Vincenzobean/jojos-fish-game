# Summoning and controlling stands. Press the summon action (Q) to bring a stand out of the inventory
# (inventory.gd): it appears in front of the player, the view switches to a 3rd-person camera behind it
# (third_person_camera.gd), and WASD, mouse and jump drive it (stand_controller.gd), and it fights with
# the attack buttons (stand_combat.gd), while the player's
# own body stands frozen with its bow put away. Press summon again to send it back: it plays its
# unsummon animation (some stands fly home and dive into the player), then goes into the inventory and
# control returns to the player.
#
# A stand also has health and stamina (stand_health.gd). Beaten, it plays its death and goes back into
# the inventory, where it needs recover_time before it can come out again, and the player is stunned.
# Beating something that has a stand user (a target dummy's) plays the stand's finisher on the user. The
# player's skills (the Skills autoload) shorten a beaten stand's recovery and their stun.
#
# In deep water the player's stand catches them and they ride it (stand_ride.gd, the player's StandRide):
# the ride takes stands through ride_stand_path(), spawn_for_ride(), release_for_ride() and
# store_from_ride(), and summoning waits while it's busy.
#
# A fished stand that charges the player (stand_encounter.gd) brings the stand out itself
# (spawn_for_clash(), then possess()); summoning waits while that plays, and once the fight is on the
# stand can't be sent back. Beaten in that fight, the wild stand's finisher plays on the player
# (stand_encounter.gd play_defeat()) before control comes back.
#
# Every choice the controlled stand makes near an opponent is remembered (StandMemory, stand_memory.gd), so
# opponents learn how the player fights with each kind of stand.
#
# Summoning needs the bow's arrow home (nothing is being fished or reeled) and a summonable stand in the
# inventory; otherwise `summon_refused` explains why. Which stand comes out is the inventory's
# selection, or the first summonable stand held.
#
# Gameplay only; possession_visuals.gd (the Visuals child) shows the prompts and messages.
# Generated by Claude Code.
extends Node

## A stand was summoned and is now being controlled.
signal summoned(stand: Node3D)
## The stand started going back (its unsummon is playing); `returned` follows when it's stored.
signal returning(stand: Node3D)
## The stand went back into the inventory and control returned to the player.
signal returned
## Summoning was refused; `reason` says why, for the player.
signal summon_refused(reason: String)
## The stand was beaten (its health, stand_health.gd, ran out): its death is playing, then it's stored.
signal stand_died(stand: Node3D)

const StandShape := preload("res://Scripts/Stands/stand_shape.gd")
const StandController := preload("res://Scripts/Stands/stand_controller.gd")
const StandCombat := preload("res://Scripts/Stands/stand_combat.gd")
const StandHealth := preload("res://Scripts/Stands/stand_health.gd")
const StandStatus := preload("res://Scripts/Stands/stand_status.gd")
const ThirdPersonCamera := preload("res://Scripts/Player/third_person_camera.gd")

@export var inventory: Node # inventory.gd
@export var bow: Node3D # bow.gd: summoning waits for its arrow, and it's put away while possessing.
@export var spawn_gap := 1.5 # Meters between the player and the summoned stand, plus the stand's own size.
@export var head_offset := Vector3(0.0, 0.8, 0.0) # The top of the player's head from its origin; stands that fly home dive here.
@export var return_linger := 0.45 # Seconds the outside view holds after a stand dives home, before first person returns.
@export var recover_time := 8.0 # Seconds a beaten stand needs before it can be summoned again.
@export var death_stun := 1.5 # Seconds the player is stunned when their stand is beaten.
@export var opponent_range := 30.0 # Meters within which an opponent makes the stand's choices worth learning from.
@export var dummy_xp := 30.0 # XP (Skills, the shared pool) for beating something with a stand user: a target dummy.

@onready var player: CharacterBody3D = get_parent()
@onready var ride: Node = player.get_node_or_null("StandRide") # stand_ride.gd
@onready var encounter: Node = player.get_node_or_null("StandEncounter") # stand_encounter.gd

var _stand: Node3D
var _camera: Camera3D
var _returning := false
var _recovering := {} # Scene path -> seconds until that beaten stand can be summoned again.
var _finishing := false # A finisher (Scripts/Stands/Finisher/) is playing.
var _losing := false # A wild stand's finisher is playing on the player (stand_encounter.gd play_defeat()).


func is_possessing() -> bool:
	return is_instance_valid(_stand)


## The stand being controlled, or null.
func get_possessed() -> Node3D:
	return _stand if is_possessing() else null


func _unhandled_input(event: InputEvent) -> void:
	if event.is_action_pressed("summon"):
		get_viewport().set_input_as_handled()
		if ride and ride.is_busy():
			return # Riding the stand (or sinking): Q does nothing.
		if encounter and encounter.is_busy():
			return # A fished stand's charge is playing out.
		if is_possessing() and encounter and encounter.in_battle():
			summon_refused.emit("You can't run from this fight!")
		elif is_possessing():
			return_stand()
		else:
			summon(inventory.stand_to_summon())


func _physics_process(delta: float) -> void:
	for path: String in _recovering.keys():
		_recovering[path] -= delta
		if _recovering[path] <= 0.0:
			_recovering.erase(path)
	# If the stand is ever removed from under us, hand control back.
	if _camera and not is_possessing() and not _losing:
		_restore_player()


## Summons the stand kind at `path` (a scene path held in the inventory). Returns whether it worked.
func summon(path: String) -> bool:
	if is_possessing() or (ride and ride.is_busy()):
		return false
	if bow.get_arrow() != null:
		summon_refused.emit("Reel your arrow in first")
		return false
	if path == "" or not inventory.is_summonable(path):
		summon_refused.emit("You have no willpower")
		return false
	if _recovering.has(path):
		summon_refused.emit("Your stand is recovering (%ds)" % ceili(_recovering[path]))
		return false

	possess(_spawn_stand(path))
	return true


# The controlled `stand` made the choice `action`: remembered (StandMemory) with how far the nearest
# opponent (the "stand_opponents" group: wild stands, target dummies) was, if one is within
# opponent_range; with none near, there's nothing to learn from.
func _record_action(action: StringName, stand: Node3D) -> void:
	if not is_instance_valid(stand) or stand.get("torso") == null:
		return
	var at: Vector3 = stand.torso.global_position
	var nearest := INF
	for opponent: Node in get_tree().get_nodes_in_group("stand_opponents"):
		var body: Node3D = opponent.get("torso") if opponent.get("torso") != null else opponent as Node3D
		if body and is_instance_valid(body):
			nearest = minf(nearest, body.global_position.distance_to(at))
	if nearest > opponent_range:
		return
	StandMemory.record_action(stand.scene_file_path, action, StandMemory.band(nearest, StandShape.size(stand)))


## Takes control of `stand`, already out in the world (summon(), or the clash when a fished stand charges
## the player: stand_encounter.gd): the stand camera, its controls, fighting and health.
func possess(stand: Node3D) -> void:
	_camera = ThirdPersonCamera.new()
	add_child(_camera)
	_camera.setup(stand, player.rotation.y)
	_camera.make_current()
	var controller := StandController.new()
	controller.name = "Controller"
	stand.add_child(controller)
	controller.setup(stand, _camera, player)
	var combat := StandCombat.new()
	combat.name = "Combat"
	stand.add_child(combat)
	combat.setup(stand, controller, player)
	var status := StandStatus.new()
	status.name = "Status"
	stand.add_child(status)
	var health := StandHealth.new()
	health.name = "Health"
	stand.add_child(health)
	health.setup(stand, controller, combat)
	health.died.connect(_on_stand_died.bind(stand))
	combat.target_defeated.connect(_on_target_defeated.bind(stand))
	combat.formation_requested.connect(_on_formation_requested.bind(stand, combat))
	# Opponents learn how the player fights with each kind of stand (stand_memory.gd): every choice made
	# with one of them near.
	combat.action_taken.connect(_record_action.bind(stand))
	controller.dashed.connect(func(_direction: Vector3) -> void: _record_action(&"dash", stand))
	stand.add_to_group("summoned_stands") # Things that fight stands (target_dummy.gd) look for them here.

	_stand = stand
	set_player_active(false)
	Input.mouse_mode = Input.MOUSE_MODE_CAPTURED
	summoned.emit(stand)


# The stand's formation (the Anchovy's School Formation) asked for its cutscene (stand_combat.gd): it
# plays, and the stand is formed at its end (formation_director.gd).
func _on_formation_requested(move: SchoolFormationMove, stand: Node3D, combat: Node) -> void:
	var director := FormationDirector.new()
	add_child(director)
	director.setup(stand, combat, move, _camera)
	await director.run()
	director.queue_free()


# Takes a stand of the kind at `path` out of the inventory and into the world, standing upright, facing
# the way the player faces: with its middle at `at`, or else set down in front of the player (on the
# ground or afloat).
func _spawn_stand(path: String, at := Vector3.INF) -> Node3D:
	var stand: Node3D = (load(path) as PackedScene).instantiate()
	if "start_limp" in stand:
		stand.start_limp = true
	var forward := StandShape.facing(player)
	stand.rotation.y = player.rotation.y # Face the way the player faces.
	stand.position = player.global_position + forward * spawn_gap if at == Vector3.INF else at
	var world := get_tree().current_scene if get_tree().current_scene else get_tree().root
	world.add_child(stand)
	if stand.has_method("pose_upright"):
		stand.pose_upright() # A summoned stand stands straight instead of dangling as a ragdoll.

	# Now it can be measured: put its middle in place.
	var bodies := StandShape.bodies(stand)
	var spot := at
	if spot == Vector3.INF:
		var size := StandShape.size(stand)
		spot = player.global_position + forward * (spawn_gap + size)
		spot.y = _spawn_height(spot, size, bodies)
	var offset := spot - StandShape.center_of_mass(bodies, stand.global_position)
	for body in bodies:
		body.global_position += offset
		body.linear_velocity = Vector3.ZERO

	inventory.remove_one(path)
	inventory.select(path)
	return stand


## The kind of stand that comes to catch the player in the water (stand_ride.gd): the one the summon key
## would bring out, or any other summonable one, as long as it isn't recovering; "" if there's none.
## Unlike summoning, an arrow being out doesn't matter (the ride reels it in).
func ride_stand_path() -> String:
	var paths: Array[String] = [inventory.stand_to_summon()]
	paths.append_array(inventory.kinds())
	for path in paths:
		if path != "" and inventory.is_summonable(path) and not _recovering.has(path):
			return path
	return ""


## Brings a stand of the kind at `path` out for the ride (stand_ride.gd), its middle at `at`. Nothing
## controls it: the ride does.
func spawn_for_ride(path: String, at: Vector3) -> Node3D:
	return _spawn_stand(path, at)


## Brings a stand of the kind at `path` out for the clash with a fished stand (stand_encounter.gd), its
## middle at `at`, or else set down in front of the player (on the ground or afloat, as summoning does: the
## final boss's intro). Nothing controls it until possess().
func spawn_for_clash(path: String, at := Vector3.INF) -> Node3D:
	return _spawn_stand(path, at)


## Hands the stand being controlled over to the ride (stand_ride.gd): its controls and health go and the
## stand camera with them, and possession lets it go (the player stays frozen; the ride has them now).
## Returns it, or null if there's none (or it's busy going back or finishing).
func release_for_ride() -> Node3D:
	if not is_possessing() or _returning or _finishing:
		return null
	var stand := _stand
	for node_name in ["Controller", "Combat", "Health", "Status"]:
		var node := stand.get_node_or_null(node_name)
		if node:
			stand.remove_child(node)
			node.queue_free()
	stand.remove_from_group("summoned_stands")
	_stand = null
	if _camera:
		_camera.queue_free()
		_camera = null
	return stand


## Sends a stand the ride is done with back: its unsummon plays (one that flies home dives into the
## player wherever they are), then it's put in the inventory.
func store_from_ride(stand: Node3D) -> void:
	var duration: float = stand.begin_unsummon(player, head_offset) if stand.has_method("begin_unsummon") else 0.0
	if duration > 0.0:
		await get_tree().create_timer(duration, false).timeout
	if is_instance_valid(stand):
		inventory.add(stand)


## True while a stand is on its way back (its unsummon animation playing) and can't be controlled.
func is_returning() -> bool:
	return _returning and is_possessing()


## Sends the stand back: control stops, its unsummon plays (stand_body.gd begin_unsummon(); a stand
## that flies home into the player is watched from behind the player), then it's put back in the
## inventory and control returns to the player.
func return_stand() -> void:
	if not is_possessing() or _returning or _finishing or (encounter and encounter.in_battle()):
		return
	var stand := _stand
	var duration := 0.0
	if stand.has_method("begin_unsummon"):
		_returning = true
		var controller := stand.get_node_or_null("Controller")
		if controller:
			controller.set_physics_process(false)
		var combat := stand.get_node_or_null("Combat")
		if combat:
			combat.set_physics_process(false)
		if stand.get_animations().unsummon_returns_to_user and _camera:
			_camera.watch(player, head_offset.y * 2.0, StandShape.center_of_mass(StandShape.bodies(stand)))
		duration = stand.begin_unsummon(player, head_offset)
		returning.emit(stand)
	if duration > 0.0:
		# A stand that dove into the player leaves an effect on their head; hold the outside view until
		# it's over, so the first-person camera doesn't come back inside it.
		if stand.has_method("get_animations") and stand.get_animations().unsummon_returns_to_user:
			duration += return_linger
		await get_tree().create_timer(duration, false).timeout
	_returning = false
	if not is_instance_valid(stand) or stand != _stand:
		return # Removed some other way meanwhile; control was already handed back.
	inventory.add(stand)
	_stand = null
	_restore_player()


## True while the stand's finisher is playing (the cutscene has the stand; no controls).
func is_in_finisher() -> bool:
	return _finishing and is_possessing()


# The stand beat something with a stand user: it plays its finisher on them, as a cutscene
# (finisher_director.gd), then control comes back.
func _on_target_defeated(_target: Node, user: Node3D, stand: Node3D) -> void:
	if stand != _stand or _returning or _finishing:
		return
	StandMemory.note_fight(stand.scene_file_path, 0.33) # A lesser fight than a wild stand's.
	Skills.grant_xp(stand.scene_file_path, dummy_xp) # XP only ever for a win.
	await play_finisher(user)


## Plays the controlled stand's finisher on `user` (a stand user: dummy_user.gd, or Lord Verity,
## villain_user.gd, once his stand is beaten: stand_encounter.gd), as a cutscene, then control comes back.
## Await it.
func play_finisher(user: Node3D) -> void:
	if not is_possessing() or _returning or _finishing:
		return
	_finishing = true
	var director := FinisherDirector.new()
	add_child(director)
	director.setup(_stand, user, _camera)
	await director.run()
	director.queue_free()
	_finishing = false


## Seconds until the stand kind at `path` has recovered from being beaten (0 if it can be summoned).
func recovering_time(path: String) -> float:
	return maxf(float(_recovering.get(path, 0.0)), 0.0)


# The stand was beaten: control stops, its death plays (watched from behind it), then it goes back into
# the inventory to recover for recover_time, and the player comes to, stunned for a moment.
func _on_stand_died(stand: Node3D) -> void:
	if stand != _stand or _returning:
		return
	_returning = true
	for node_name in ["Controller", "Combat"]:
		var node := stand.get_node_or_null(node_name)
		if node:
			node.set_physics_process(false)
	stand_died.emit(stand)
	var duration: float = stand.begin_death() if stand.has_method("begin_death") else 0.0
	if duration > 0.0:
		await get_tree().create_timer(duration, false).timeout
	_returning = false
	if not is_instance_valid(stand) or stand != _stand:
		return
	_recovering[stand.scene_file_path] = Skills.scaled(Skills.PLAYER, "recover_time", recover_time)
	var lost_battle: bool = encounter != null and encounter.in_battle()
	inventory.add(stand)
	_stand = null
	if lost_battle:
		_losing = true
		await encounter.play_defeat() # Beaten by a wild stand: it finishes the player too.
		_losing = false
	_restore_player()
	if player.has_method("stun"):
		player.stun(Skills.scaled(Skills.PLAYER, "death_stun", death_stun))


func _restore_player() -> void:
	if _camera:
		_camera.queue_free()
		_camera = null
	(player.get_node("Camera3D") as Camera3D).make_current()
	set_player_active(true)
	Input.mouse_mode = Input.MOUSE_MODE_CAPTURED
	returned.emit()


## Freezes the player's body and puts the bow away (and the HUD) while a stand is controlled or ridden,
## or brings them back.
func set_player_active(active: bool) -> void:
	player.velocity = Vector3.ZERO
	player.set_physics_process(active)
	player.set_process_unhandled_input(active)
	bow.process_mode = Node.PROCESS_MODE_INHERIT if active else Node.PROCESS_MODE_DISABLED
	bow.visible = active # It's a first-person viewmodel; from behind the stand it would float in mid-air.
	var hud := player.get_node_or_null("HUD") as CanvasLayer
	if hud:
		hud.visible = active


# Height to put the stand's middle at: afloat at the surface if there's water above the ground there,
# otherwise resting on the ground.
func _spawn_height(spot: Vector3, size: float, bodies: Array[RigidBody3D]) -> float:
	var excluded: Array[RID] = [player.get_rid()]
	for body in bodies:
		excluded.append(body.get_rid())
	var query := PhysicsRayQueryParameters3D.create(spot + Vector3.UP * 50.0, spot + Vector3.DOWN * 50.0)
	query.exclude = excluded
	var hit := player.get_world_3d().direct_space_state.intersect_ray(query)
	var ground: float = hit.position.y if not hit.is_empty() else -INF
	var water := get_tree().get_first_node_in_group("water")
	var surface: float = water.surface_height_at(spot) if water else -INF
	if surface > ground:
		return surface
	if ground == -INF:
		return player.global_position.y
	return ground + size * 0.6
