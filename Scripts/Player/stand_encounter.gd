# A wild stand fighting the player's stand. Fishing (fishing.gd) asks can_challenge() when something bites:
# if the player has a stand ready (a summonable one that isn't recovering, possession.gd ride_stand_path())
# and what bit can be summoned too, it isn't hooked; begin() takes over instead. Otherwise (no stand, or
# the test crate) fishing hooks it and it's reeled in as usual.
#
#   1. Clash: the arrow snaps home, the wild stand comes up out of the water posed upright, and the
#      player's stand is brought out (possession.gd spawn_for_clash()). The cutscene (clash_director.gd)
#      plays: it charges, the player's stand's arm catches its fist, a right hook knocks it away, and the
#      player's stand appears.
#   2. Battle: the player takes control of their stand (possession.gd possess()), and the wild stand
#      fights back with the same controller, combat and health the player's has, driven by an AI
#      (enemy_stand_brain.gd), without the player's skills for its kind.
#   3. Beat it and its death plays and it goes into the inventory (`won`). There's no running: the
#      player's stand can't be sent back mid-fight (possession.gd asks in_battle()).
#   4. Beaten instead, the player's stand dies as usual, then the wild stand plays the generic finisher
#      (StandFinisher, through a FinisherDirector) on the player, a straw stand-in (dummy_user.tscn)
#      taking their place; the player comes to on their last safe ground having lost a little XP
#      (defeat_penalty, `defeated`), and the wild stand dives back into the sea.
#
# XP: only winning earns any, win_xp into the shared pool (Skills.grant_xp(), with the catch-up bonus of
# the stand that won); damage dealt earns nothing, so a lost fight only costs the penalty. Every fight
# also teaches opponents about the player's stand (StandMemory.note_fight()), and the wild stand's AI
# fights with what they've learned about it.
#
# The final boss (challenge()) is fought the same way, but started from the arena on the final island
# (final_arena.gd) by challenging Lord Verity (villain_user.gd) rather than by a bite: the player is put
# at the arena's player_spot, his intro plays (boss_intro_director.gd) and brings out his stand (the Mantis
# Shrimp Stand, boss_scene_path) and the player's, and his stand fights with a boss's brain
# (boss_stand_brain.gd: three phases, `boss_phase_changed`). Beaten, it isn't caught: its death plays, then
# the player's stand plays its finisher on Lord Verity, the win is saved (Story "boss_defeated", with
# boss_xp) and `boss_beaten` brings up the ending (ending_screen.gd). Losing goes as against a wild stand,
# but his stand plays its own finisher (Final Second), then goes back to him, and the player comes to at the
# arena's respawn_spot. Rematches are allowed.
#
# A rival on an island (rival_user.gd, duel()) is fought the same way too, from where the player stands when
# they challenge him: his short intro (rival_intro_director.gd) brings out his stand beside him and the
# player's, and his stand fights with a wild stand's brain, but as strong as his island's zone makes it
# (rival_user.gd ZONE_STRENGTH: its health and damage, and the brain's `skill`). Beaten, his stand isn't
# caught: its death plays, the player's stand plays its finisher on him, the win earns his zone's XP and his
# island is cleared (`rival_beaten`). Losing goes as against a wild stand (the same penalty), but his stand
# goes back to him rather than diving, and he waits to be challenged again.
#
# Gameplay only; stand_encounter_visuals.gd (the Visuals child) shows its health and what happened.
# Generated by Claude Code.
extends Node

## A wild stand bit and the clash began.
signal started(enemy: Node3D)
## The cutscene's over and the fight is on: `enemy` the wild stand, `ally` the player's.
signal battle_started(enemy: Node3D, ally: Node3D)
## The wild stand was beaten and caught: `display_name` is its kind's name.
signal won(display_name: String)
## The wild stand got away (the player's stand vanished mid-fight).
signal escaped(enemy: Node3D)
## The player lost: the wild stand's finisher is about to play on them.
signal defeat_started(enemy: Node3D)
## ...the finisher's over and the screen goes dark while the player is put back on safe ground...
signal respawning
## ...and they're back, `lost_xp` poorer.
signal defeated(lost_xp: int)
## The player challenged the final boss: his intro is about to play.
signal boss_started(villain: Node3D)
## The boss's stand entered phase `phase` (0, 1 or 2, boss_stand_brain.gd).
signal boss_phase_changed(phase: int)
## The final boss was beaten and finished: the ending follows.
signal boss_beaten
## The player challenged a rival on his island: his intro is about to play.
signal duel_started(rival: Node3D)
## A rival was beaten and finished, his island cleared, for `xp`.
signal rival_beaten(rival: Node3D, xp: float)

enum State { IDLE, CLASH, BATTLE, DEFEAT, ENDING }

const StandShape := preload("res://Scripts/Stands/stand_shape.gd")
const StandController := preload("res://Scripts/Stands/stand_controller.gd")
const StandCombat := preload("res://Scripts/Stands/stand_combat.gd")
const StandHealth := preload("res://Scripts/Stands/stand_health.gd")
const StandStatus := preload("res://Scripts/Stands/stand_status.gd")
const EnemyStandBrain := preload("res://Scripts/Stands/enemy_stand_brain.gd")
const BossStandBrain := preload("res://Scripts/Stands/boss_stand_brain.gd")
const BossIntroDirector := preload("res://Scripts/Stands/Cutscene/boss_intro_director.gd")
const VillainState := preload("res://Scripts/World/villain_user.gd").State
const RivalState := preload("res://Scripts/World/rival_user.gd").State
const RivalIntroDirector := preload("res://Scripts/Stands/Cutscene/rival_intro_director.gd")
const DummyUserScene := preload("res://scenes/dummy_user.tscn") # Stands in for the player in a finisher.

@export var inventory: Node # inventory.gd
@export var possession: Node # possession.gd
@export var bow: Node3D # bow.gd
@export var fishing: Node # fishing.gd: told about this, so it asks before hooking a bite.
@export var escape_time := 0.7 ## Seconds a wild stand takes to dive away when it wins.
@export var win_xp := 100.0 ## XP for beating a wild stand (nothing for damage).
@export var defeat_penalty := 0.15 ## Losing costs this share of the XP the next point takes (from the bar only).
@export var respawn_fade := 0.6 ## Seconds the screen takes to go dark before the player is put back.
@export_file("*.tscn") var boss_scene_path := "res://scenes/stands/mantis_shrimp_stand.tscn" ## The final boss's stand (loaded when challenged, not preloaded: see scene_loader.gd).
@export var boss_xp := 600.0 ## XP for beating the final boss.

@onready var player: CharacterBody3D = get_parent()
@onready var ride: Node = player.get_node_or_null("StandRide") # stand_ride.gd

var _state := State.IDLE
var _enemy: Node3D
var _ally: Node3D
var _ally_key := "" # The player's stand's kind (scene path), kept once the stand itself is gone.
var _arena: Node3D # The final arena (final_arena.gd) while the boss is being fought.
var _rival: Node3D # The rival (rival_user.gd) whose stand is being fought.


func _ready() -> void:
	if fishing:
		fishing.encounter = self
	possession.stand_died.connect(_on_ally_died)
	possession.returning.connect(_on_ally_gone)


## True while the clash cutscene plays (nothing else may take the player's stand or controls).
func is_busy() -> bool:
	return _state == State.CLASH


## True from the bite until the fight is settled.
func is_active() -> bool:
	return _state != State.IDLE


## True while the player is in the fight and can't leave it: the clash, the battle and losing it.
func in_battle() -> bool:
	return _state == State.CLASH or _state == State.BATTLE or _state == State.DEFEAT


## The kind of the player's stand in the fight (its scene path), or "".
func get_ally_key() -> String:
	return _ally_key


## True while the fight is the final boss's.
func is_boss() -> bool:
	return _arena != null


## True while the fight is against a rival's stand.
func is_rival() -> bool:
	return _rival != null


## The rival being fought (rival_user.gd), or null.
func get_rival() -> Node3D:
	return _rival


## Whether the player can challenge a stand user (a rival or the final boss) now: nothing else going on and
## a stand ready.
func can_challenge_user() -> bool:
	if _state != State.IDLE or possession.is_possessing() or (ride and ride.is_busy()):
		return false
	return possession.ride_stand_path() != ""


## The same, asked by Lord Verity (villain_user.gd).
func can_challenge_boss() -> bool:
	return can_challenge_user()


## A fight with `rival` (rival_user.gd) begins: the player turns to face him where they stand, his intro
## brings out his stand (as strong as his zone makes it) and theirs, then they fight.
func duel(rival: Node3D) -> void:
	if not can_challenge_user() or rival.cleared or rival.stand_path == "":
		return
	_state = State.CLASH
	_rival = rival
	bow.recall()
	possession.set_player_active(false)
	var facing := StandShape.flat(rival.global_position - player.global_position)
	player.rotation.y = atan2(-facing.x, -facing.z)
	player.velocity = Vector3.ZERO
	rival.face(player.global_position)
	duel_started.emit(rival)

	var ally_path: String = possession.ride_stand_path()
	var strength: Dictionary = rival.strength()
	var beside: Vector3 = rival.global_position - facing.cross(Vector3.UP) * 1.8 + facing * 0.8 + Vector3.UP * 2.0
	var director := RivalIntroDirector.new()
	add_child(director)
	director.setup(rival, player, player.get_node("Camera3D") as Camera3D,
		func() -> Node3D:
			_enemy = _spawn_enemy(load(rival.stand_path), beside, strength)
			return _enemy,
		func() -> Node3D:
			_ally = possession.spawn_for_clash(ally_path) # In front of the player, on the ground.
			return _ally)
	await director.run()
	director.free_cutscene()
	director.queue_free()
	if not is_instance_valid(_enemy) or not is_instance_valid(_ally):
		if is_instance_valid(_enemy):
			_enemy.queue_free()
		if is_instance_valid(rival):
			rival.reset()
		_finish()
		possession.set_player_active(true)
		return
	possession.possess(_ally)
	_ally_key = _ally.scene_file_path
	_arm(_enemy, _ally, false, float(strength["skill"]))
	rival.set_state(RivalState.WATCHING)
	_state = State.BATTLE
	battle_started.emit(_enemy, _ally)


## The final boss fight begins, in `arena` (final_arena.gd): the player is put at its player_spot facing
## Lord Verity, his intro plays and brings out both stands, then they fight.
func challenge(arena: Node3D) -> void:
	if not can_challenge_boss():
		return
	_state = State.CLASH
	_arena = arena
	bow.recall()
	possession.set_player_active(false)
	var villain: Node3D = arena.villain
	var facing := StandShape.flat(arena.villain_spot - arena.player_spot)
	player.global_position = arena.player_spot + Vector3.UP * _half_height()
	player.rotation.y = atan2(-facing.x, -facing.z)
	player.velocity = Vector3.ZERO
	boss_started.emit(villain)

	var ally_path: String = possession.ride_stand_path()
	var director := BossIntroDirector.new()
	add_child(director)
	director.setup(villain, arena, player.get_node("Camera3D") as Camera3D,
		func() -> Node3D:
			_enemy = _spawn_enemy(load(boss_scene_path), arena.boss_spot + Vector3.UP * 2.2)
			return _enemy,
		func() -> Node3D:
			_ally = possession.spawn_for_clash(ally_path) # In front of the player, standing on the ground.
			return _ally)
	await director.run()
	director.free_cutscene()
	director.queue_free()
	if not is_instance_valid(_enemy) or not is_instance_valid(_ally):
		if is_instance_valid(_enemy):
			_enemy.queue_free()
		_finish()
		possession.set_player_active(true)
		return
	possession.possess(_ally)
	_ally_key = _ally.scene_file_path
	_arm(_enemy, _ally, true)
	villain.set_state(VillainState.WATCHING)
	arena.set_fighting(true)
	_state = State.BATTLE
	battle_started.emit(_enemy, _ally)


## The wild stand being fought, or null.
func get_enemy() -> Node3D:
	return _enemy if _state == State.BATTLE and is_instance_valid(_enemy) else null


## Whether a bite of `scene` should become a fight instead of being hooked: the player has a stand ready,
## and `scene` is a stand that can be summoned (so it can fight).
func can_challenge(scene: PackedScene) -> bool:
	if _state != State.IDLE or scene == null or possession.is_possessing() or (ride and ride.is_busy()):
		return false
	return possession.ride_stand_path() != "" and _summonable(scene)


## The fight begins: `scene` bit at `at` (the arrowhead).
func begin(scene: PackedScene, at: Vector3) -> void:
	_state = State.CLASH
	bow.recall()
	_enemy = _spawn_enemy(scene, at)
	possession.set_player_active(false)
	var forward := StandShape.flat(at - player.global_position)
	_ally = possession.spawn_for_clash(possession.ride_stand_path(), player.global_position + forward + Vector3.UP * 0.25)
	started.emit(_enemy)

	var director := ClashDirector.new()
	add_child(director)
	director.setup(_enemy, _ally, player, player.get_node("Camera3D") as Camera3D)
	await director.run()
	if not is_instance_valid(_enemy) or not is_instance_valid(_ally):
		director.free_cutscene()
		director.queue_free()
		_state = State.IDLE
		possession.set_player_active(true)
		return
	possession.possess(_ally)
	director.free_cutscene()
	director.queue_free()
	_ally_key = _ally.scene_file_path
	_arm(_enemy, _ally)
	_state = State.BATTLE
	battle_started.emit(_enemy, _ally)


# The wild stand, out of the water at `at`, standing upright, facing the player. A rival's comes with his
# zone's `strength` (rival_user.gd ZONE_STRENGTH), which scales its health and damage before it's armed.
func _spawn_enemy(scene: PackedScene, at: Vector3, strength := {}) -> Node3D:
	var stand: Node3D = scene.instantiate()
	if "start_limp" in stand:
		stand.start_limp = true
	if not strength.is_empty():
		stand.max_health *= float(strength["health"])
		stand.damage_scale *= float(strength["damage"])
	stand.position = at # The scene root sits at the origin, so position is global.
	var world := get_tree().current_scene if get_tree().current_scene else get_tree().root
	world.add_child(stand)
	if stand.has_method("pose_upright"):
		stand.pose_upright()
	var bodies := StandShape.bodies(stand)
	var offset := at - StandShape.center_of_mass(bodies, stand.global_position)
	for body in bodies:
		body.global_position += offset
		body.linear_velocity = Vector3.ZERO
	return stand


# Gives the wild stand its fight: the AI first (so its presses are seen the same frame), then the same
# controller, combat and health the player's stand has, all reading the AI's buttons.
# A rival's stand fights with his zone's `skill` (enemy_stand_brain.gd).
func _arm(enemy: Node3D, ally: Node3D, boss := false, skill := 0.5) -> void:
	enemy.add_to_group("stand_opponents") # What the player's stand learns to fight against (StandMemory).
	var brain: Node3D = BossStandBrain.new() if boss else EnemyStandBrain.new()
	brain.name = "Brain"
	if not boss:
		brain.skill = skill
	enemy.add_child(brain)
	brain.setup(enemy, ally, ally.scene_file_path)
	if boss:
		brain.phase_changed.connect(func(phase: int) -> void: boss_phase_changed.emit(phase))
	var controller := StandController.new()
	controller.name = "Controller"
	controller.input = brain.input
	enemy.add_child(controller)
	controller.setup(enemy, brain, null, false)
	var combat := StandCombat.new()
	combat.name = "Combat"
	combat.input = brain.input
	enemy.add_child(combat)
	combat.setup(enemy, controller, null, false)
	var status := StandStatus.new()
	status.name = "Status"
	enemy.add_child(status)
	var health := StandHealth.new()
	health.name = "Health"
	enemy.add_child(health)
	health.setup(enemy, controller, combat, false)
	health.died.connect(_on_enemy_beaten)


# The wild stand was beaten: its death plays, then it's caught.
func _on_enemy_beaten() -> void:
	if _state != State.BATTLE or not is_instance_valid(_enemy):
		return
	_state = State.ENDING
	var enemy := _enemy
	_stop(enemy)
	if is_boss():
		await _boss_beaten(enemy)
		return
	if is_rival():
		await _rival_beaten(enemy)
		return
	var duration: float = enemy.begin_death() if enemy.has_method("begin_death") else 0.0
	if duration > 0.0:
		await get_tree().create_timer(duration, false).timeout
	if is_instance_valid(enemy):
		var path := enemy.scene_file_path
		inventory.add(enemy)
		won.emit(inventory.display_name(path))
	Skills.grant_xp(_ally_key, win_xp)
	StandMemory.note_fight(_ally_key)
	_finish()


# The boss's stand was beaten: its death plays, then the player's stand finishes Lord Verity himself, and
# the win is saved; the ending follows (`boss_beaten`).
func _boss_beaten(enemy: Node3D) -> void:
	var arena := _arena
	var duration: float = enemy.begin_death() if enemy.has_method("begin_death") else 0.0
	if duration > 0.0:
		await get_tree().create_timer(duration, false).timeout
	if is_instance_valid(enemy):
		enemy.queue_free()
	if is_instance_valid(arena) and is_instance_valid(arena.villain):
		await possession.play_finisher(arena.villain)
	Story.set_flag(&"boss_defeated")
	Skills.grant_xp(_ally_key, boss_xp)
	StandMemory.note_fight(_ally_key)
	if is_instance_valid(arena):
		arena.set_fighting(false)
	_finish()
	boss_beaten.emit()


# A rival's stand was beaten: its death plays (it isn't caught), then the player's stand finishes him, the
# win earns his zone's XP, and his island is cleared (his dissolve() at the finisher's end sees to that).
func _rival_beaten(enemy: Node3D) -> void:
	var rival := _rival
	var duration: float = enemy.begin_death() if enemy.has_method("begin_death") else 0.0
	if duration > 0.0:
		await get_tree().create_timer(duration, false).timeout
	if is_instance_valid(enemy):
		enemy.queue_free()
	var xp := 0.0
	if is_instance_valid(rival):
		xp = rival.win_xp()
		await possession.play_finisher(rival)
	Skills.grant_xp(_ally_key, xp)
	StandMemory.note_fight(_ally_key)
	_finish()
	if is_instance_valid(rival):
		rival_beaten.emit(rival, xp)


# The player's stand was beaten: the wild stand stops fighting while its death plays; possession then
# hands over to play_defeat().
func _on_ally_died(stand: Node3D) -> void:
	if _state != State.BATTLE or stand != _ally or not is_instance_valid(_enemy):
		return
	_state = State.DEFEAT
	_stop(_enemy)


## The player lost (called by possession.gd once their stand's death has played): the wild stand plays the
## generic finisher on them, a straw stand-in taking their place, then they're put back on their last safe
## ground having lost a little of their stand's XP, and the wild stand dives away. Await it.
func play_defeat() -> void:
	var enemy := _enemy
	if _state != State.DEFEAT or not is_instance_valid(enemy):
		_finish()
		return
	# The penalty (a small share of a point, from what's on the bar); said after the respawn (`defeated`).
	var lost := Skills.lose_xp(roundi(Skills.xp_to_next() * defeat_penalty))
	StandMemory.note_fight(_ally_key)
	defeat_started.emit(enemy)

	# The stand-in, where the player stands, facing the wild stand; the player's capsule hides meanwhile.
	var capsule := player.get_node_or_null("MeshInstance3D") as Node3D
	if capsule:
		capsule.visible = false
	var stand_in: Node3D = DummyUserScene.instantiate()
	player.get_parent().add_child(stand_in)
	stand_in.stand_at(player.global_position - Vector3.UP * _half_height(), enemy.torso.global_position - player.global_position)
	var director := FinisherDirector.new()
	add_child(director)
	director.setup(enemy, stand_in, player.get_node("Camera3D") as Camera3D) # From the player's eyes, and back.
	await director.run()
	director.queue_free()
	if is_instance_valid(stand_in):
		stand_in.queue_free()

	# Coming to on safe ground while the wild stand dives away; then what it cost (`defeated`).
	respawning.emit()
	var arena := _arena
	var rival := _rival
	if is_instance_valid(enemy):
		_stop(enemy) # The finisher handed its controls back.
		if arena:
			_return_to_user(enemy, arena.villain, arena)
		elif rival:
			_return_to_user(enemy, rival)
		else:
			_dive_away(enemy)
	await get_tree().create_timer(respawn_fade, false).timeout
	if arena:
		var facing := StandShape.flat(arena.villain_spot - arena.respawn_spot)
		player.global_position = arena.respawn_spot + Vector3.UP * _half_height()
		player.rotation.y = atan2(-facing.x, -facing.z)
	elif ride:
		player.global_transform = ride.last_safe_transform()
	player.velocity = Vector3.ZERO
	if capsule:
		capsule.visible = true
	defeated.emit(lost)
	_finish()


# The player's stand went back mid-fight (possession refuses that now, so only if something else sent it):
# the wild stand dives back into the sea (a rival's goes back to him).
func _on_ally_gone(stand: Node3D) -> void:
	if _state != State.BATTLE or stand != _ally or not is_instance_valid(_enemy):
		return
	_state = State.ENDING
	var enemy := _enemy
	_stop(enemy)
	escaped.emit(enemy)
	if is_rival():
		await _return_to_user(enemy, _rival)
	else:
		await _dive_away(enemy)
	_finish()


# A stand user's stand, having won, fades back into him (Lord Verity, with his `arena`, or a rival), and he
# waits to be challenged again.
func _return_to_user(enemy: Node3D, user: Node3D, arena: Node3D = null) -> void:
	var visuals := enemy.get_node_or_null("Visuals")
	enemy.torso.freeze = true
	if visuals:
		var tween := create_tween()
		tween.tween_method(_fade_all.bind(visuals), 1.0, 0.0, escape_time)
		await tween.finished
	if is_instance_valid(enemy):
		enemy.queue_free()
	if is_instance_valid(arena):
		arena.set_fighting(false)
	if is_instance_valid(user):
		user.reset()


# The wild stand sinks back under the water, fading, with a splash, and is gone. Await it.
func _dive_away(enemy: Node3D) -> void:
	var torso: RigidBody3D = enemy.torso
	torso.freeze = true
	var visuals := enemy.get_node_or_null("Visuals")
	var water := get_tree().get_first_node_in_group("water")
	var surface: float = water.surface_height_at(torso.global_position) if water else torso.global_position.y - 2.0
	var tween := create_tween()
	tween.tween_property(torso, "global_position", Vector3(torso.global_position.x, surface - StandShape.size(enemy), torso.global_position.z), escape_time) \
		.set_trans(Tween.TRANS_QUAD).set_ease(Tween.EASE_IN)
	if visuals:
		tween.parallel().tween_method(_fade_all.bind(visuals), 1.0, 0.0, escape_time)
	await get_tree().create_timer(escape_time * 0.6, false).timeout
	if water and is_instance_valid(enemy):
		water.splash(Vector3(torso.global_position.x, surface, torso.global_position.z), 0.8)
	await tween.finished
	if is_instance_valid(enemy):
		enemy.queue_free()


# Fades every part of a stand (through its `visuals`) to `amount`.
static func _fade_all(amount: float, visuals: Node) -> void:
	for part: String in ClashDirector.PARTS + ["Companion"]:
		visuals.set_part_fade(part, amount)


# The wild stand stops fighting (and lets time move, if it had stopped it).
func _stop(enemy: Node3D) -> void:
	var time_stop := TimeStop.current()
	if time_stop:
		time_stop.cancel()
	var brain := enemy.get_node_or_null("Brain")
	if brain:
		brain.stop()
	for node_name in ["Controller", "Combat"]:
		var node := enemy.get_node_or_null(node_name)
		if node:
			node.set_physics_process(false)


func _finish() -> void:
	_state = State.IDLE
	_arena = null
	_rival = null
	_enemy = null
	_ally = null
	_ally_key = ""


# Half the player's height: from their origin down to their feet.
func _half_height() -> float:
	var shape := player.get_node_or_null("CollisionShape3D") as CollisionShape3D
	if shape and shape.shape is CapsuleShape3D:
		return (shape.shape as CapsuleShape3D).height * 0.5
	return 0.8


# Whether the stand scene can be summoned: not marked `summonable = false` in its root's metadata.
static func _summonable(scene: PackedScene) -> bool:
	var state := scene.get_state()
	for i in state.get_node_property_count(0):
		if state.get_node_property_name(0, i) == &"metadata/summonable":
			return bool(state.get_node_property_value(0, i))
	return true
