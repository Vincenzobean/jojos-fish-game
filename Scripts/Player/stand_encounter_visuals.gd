# The fight with a wild stand, on screen (stand_encounter.gd, its parent): while it's on, the wild stand's
# health across the top, drawn like the player's stand wheel (stand_hud.gd): an ink-edged paper bar,
# the health just lost lingering as a pale chunk, shaking and flashing when hit, its name above. When
# the fight ends messages say how (caught, got away) and what it earned: the XP (with its catch-up
# bonus, Skills); a level reached is level_hud.gd's banner.
#
# What opponents have learned (StandMemory) shows too: a warning as the fight starts when they know the
# player's stand well, and a gold "!!" over the wild stand each time it reads the player's next move.
# Losing, the screen goes dark while the player is put back on safe ground, and says what it cost.
#
# Against the final boss (encounter is_boss()) the bar is wider and names him and his stand, with notches
# where its phases change (boss_stand_brain.gd PHASES) and the bar's colour turning with each phase; each new
# phase is announced in the middle of the screen as his stand roars (its roar animation,
# mantis_shrimp_stand_animations.gd make_roar()). Beating him brings up the ending (ending_screen.tscn).
# Against a rival (encounter is_rival()) the bar names him and his stand, and beating him says so and that
# his island is cleared.
# Purely presentation: it only reads the encounter, the wild stand's health and brain, Skills and
# StandMemory.
# Generated by Claude Code.
extends Node

const INK := HudStyle.INK
const PAPER := HudStyle.PAPER
const TRACK := Color(0.78, 0.76, 0.72)
const HEALTH := Color(0.86, 0.14, 0.12)
const CHUNK := Color(1.0, 0.93, 0.72)
const READ := Color(1.0, 0.82, 0.25)
const PHASE_COLORS := [Color(0.86, 0.14, 0.12), Color(0.95, 0.45, 0.1), Color(0.6, 0.15, 0.85)] ## The boss bar per phase.
const ENDING_SCENE := "res://scenes/ending_screen.tscn" # Loaded when the player arrives, not preloaded (see scene_loader.gd).
const BossBrain := preload("res://Scripts/Stands/boss_stand_brain.gd")

@export var message_time := 2.0 ## Seconds a message stays before fading out (the next waits for it).
@export var warn_familiarity := 0.5 ## Familiarity from which the start of a fight warns that they know the stand.

@onready var encounter: Node = get_parent()

var _bar: Bar
var _message: Label
var _message_tween: Tween
var _queue: Array[String] = [] # Messages waiting their turn.
var _health: Node
var _dark: ColorRect # Over the screen while a beaten player is put back.
var _ending: CanvasLayer # ending_screen.gd


func _ready() -> void:
	var layer := CanvasLayer.new()
	add_child(layer)
	_bar = Bar.new()
	_bar.mouse_filter = Control.MOUSE_FILTER_IGNORE
	layer.add_child(_bar)
	_bar.set_anchors_and_offsets_preset(Control.PRESET_CENTER_TOP, Control.PRESET_MODE_MINSIZE)
	_bar.offset_left = -260.0
	_bar.offset_right = 260.0
	_bar.offset_top = 18.0
	_bar.offset_bottom = 18.0 + 70.0
	_bar.visible = false

	_message = HudStyle.label(34, "", 8)
	_message.add_theme_color_override("font_color", Color(1.0, 0.92, 0.45))
	_message.modulate.a = 0.0
	layer.add_child(_message)
	_message.set_anchors_and_offsets_preset(Control.PRESET_CENTER, Control.PRESET_MODE_MINSIZE)
	_message.offset_left = -320.0
	_message.offset_right = 320.0
	_message.offset_top = -170.0
	_message.offset_bottom = -126.0

	_dark = ColorRect.new()
	_dark.color = Color(0.0, 0.0, 0.0, 0.0)
	_dark.mouse_filter = Control.MOUSE_FILTER_IGNORE
	layer.add_child(_dark)
	_dark.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	layer.move_child(_message, -1) # Messages over the dark.

	encounter.won.connect(func(display_name: String) -> void: _show_message("%s caught!" % display_name))
	encounter.escaped.connect(func(_enemy: Node3D) -> void: _show_message("It got away..."))
	encounter.battle_started.connect(_on_battle_started)
	encounter.respawning.connect(_on_respawning)
	encounter.defeated.connect(_on_defeated)
	encounter.boss_phase_changed.connect(_on_boss_phase)
	encounter.rival_beaten.connect(func(rival: Node3D, _xp: float) -> void:
		_show_message("%s defeated! Island cleared" % rival.display_name))
	Skills.xp_gained.connect(_on_xp_gained)
	_ending = (load(ENDING_SCENE) as PackedScene).instantiate()
	add_child(_ending)
	encounter.boss_beaten.connect(func() -> void:
		await get_tree().create_timer(1.0, false).timeout
		_ending.open())


# The fight's on: a warning if opponents know this stand well, and a watch on the wild stand's reads.
func _on_battle_started(enemy: Node3D, ally: Node3D) -> void:
	if StandMemory.familiarity(ally.scene_file_path) >= warn_familiarity:
		_show_message("Your enemies know your %s's tricks..." % ally.scene_file_path.get_file().get_basename().capitalize())
	var brain := enemy.get_node_or_null("Brain")
	if brain and brain.has_signal("read"):
		brain.read.connect(func(_predicted: StringName, _response: String) -> void: _pop_read(enemy))


# A gold "!!" pops over the wild stand's head: it saw the player's next move coming.
func _pop_read(enemy: Node3D) -> void:
	var visuals := enemy.get_node_or_null("Visuals") if is_instance_valid(enemy) else null
	if visuals == null:
		return
	var label := Label3D.new()
	label.text = "!!"
	label.font_size = 110
	label.outline_size = 26
	label.modulate = READ
	label.outline_modulate = INK
	label.pixel_size = 0.01
	label.billboard = BaseMaterial3D.BILLBOARD_ENABLED
	label.no_depth_test = true
	label.render_priority = 10
	label.outline_render_priority = 9
	get_tree().current_scene.add_child(label)
	label.global_position = visuals.head_top() + Vector3.UP * 0.5
	label.scale = Vector3.ONE * 0.3
	var tween := label.create_tween()
	tween.tween_property(label, "scale", Vector3.ONE, 0.12).set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_OUT)
	tween.tween_interval(0.35)
	tween.tween_property(label, "modulate:a", 0.0, 0.25)
	tween.tween_callback(label.queue_free)


# The boss's stand changed phase: it roars, and the phase is named.
func _on_boss_phase(phase: int) -> void:
	var enemy: Node3D = encounter.get_enemy()
	var visuals := enemy.get_node_or_null("Visuals") if enemy else null
	if visuals:
		visuals.play(MantisShrimpStandAnimations.make_roar())
	_bar.phase = phase
	_bar.hit_flash = 1.0
	_queue.clear()
	_show_message("PHASE %d: %s" % [phase + 1, String(BossBrain.PHASES[phase]["name"]).to_upper()])


func _on_xp_gained(_key: String, amount: int, multiplier: float, _points_gained: int) -> void:
	if not encounter.is_active():
		return # Not a wild stand's: possession_visuals.gd says it (a target dummy beaten).
	var text := "+%d XP" % amount
	if multiplier > 1.01:
		text += "  (x%.1f catch-up)" % multiplier
	_show_message(text)


# Beaten: once the finisher's over the screen goes dark while the player is put back, then clears...
func _on_respawning() -> void:
	var tween := create_tween()
	tween.tween_property(_dark, "color:a", 1.0, encounter.respawn_fade)
	tween.tween_interval(0.5)
	tween.tween_property(_dark, "color:a", 0.0, 0.7)


# ...and one message once they're back says what it cost (nothing about XP before then).
func _on_defeated(lost_xp: int) -> void:
	_show_message("Defeated...  -%d XP" % lost_xp if lost_xp > 0 else "Defeated...")


func _process(delta: float) -> void:
	var enemy: Node3D = encounter.get_enemy()
	var health: Node = enemy.get_node_or_null("Health") if enemy else null
	if health != _health:
		_health = health
		if health:
			health.damaged.connect(_on_damaged)
			_bar.stand_name = "WILD " + enemy.scene_file_path.get_file().get_basename().capitalize().to_upper()
			_bar.boss = encounter.is_boss()
			_bar.phase = 0
			if _bar.boss:
				_bar.stand_name = "LORD VERITY  ·  STILL WATER"
			elif encounter.is_rival():
				var rival: Node3D = encounter.get_rival()
				_bar.stand_name = ("%s  ·  %s" % [rival.display_name, rival.stand_name()]).to_upper()
			var width := 380.0 if _bar.boss else 260.0
			_bar.offset_left = -width
			_bar.offset_right = width
	_bar.visible = health != null
	if health == null:
		return
	_bar.health = health.health / health.max_health
	_bar.recent = health.recent_health / health.max_health
	_bar.shake = move_toward(_bar.shake, 0.0, delta * 3.0)
	_bar.hit_flash = move_toward(_bar.hit_flash, 0.0, delta * 3.0)
	_bar.time += delta
	_bar.queue_redraw()


func _on_damaged(amount: float, _hit: Dictionary, blocked: bool) -> void:
	if amount <= 0.0:
		return
	_bar.shake = 1.0 if not blocked else 0.4
	_bar.hit_flash = 1.0 if not blocked else 0.4


# Shows `text` once the messages before it have had their turn.
func _show_message(text: String) -> void:
	_queue.append(text)
	if _message_tween == null or not _message_tween.is_running():
		_next_message()


func _next_message() -> void:
	if _queue.is_empty():
		return
	var text: String = _queue.pop_front()
	_message_tween = HudStyle.flash(_message, text, message_time if _queue.is_empty() else message_time * 0.6, null, 0.3)
	_message_tween.tween_callback(_next_message)


## The bar itself.
class Bar extends Control:
	var health := 1.0 # Shares of full, 0 to 1.
	var recent := 1.0
	var boss := false # The final boss's: phase notches and colours.
	var phase := 0
	var stand_name := ""
	var shake := 0.0
	var hit_flash := 0.0
	var time := 0.0

	func _draw() -> void:
		var offset := Vector2(sin(time * 70.0), cos(time * 53.0)) * 5.0 * shake
		var frame := Rect2(Vector2(0.0, 30.0) + offset, Vector2(size.x, 30.0))
		var inside := frame.grow(-5.0)
		draw_rect(frame, INK)
		draw_rect(frame.grow(-3.0), PAPER.lerp(Color.WHITE, hit_flash))
		draw_rect(inside, TRACK)
		draw_rect(Rect2(inside.position, Vector2(inside.size.x * clampf(recent, 0.0, 1.0), inside.size.y)), CHUNK)
		var fill: Color = PHASE_COLORS[clampi(phase, 0, PHASE_COLORS.size() - 1)] if boss else HEALTH
		draw_rect(Rect2(inside.position, Vector2(inside.size.x * clampf(health, 0.0, 1.0), inside.size.y)), fill.lerp(Color.WHITE, hit_flash * 0.6))
		if boss:
			for entry: Dictionary in BossBrain.PHASES:
				var at := float(entry["until"])
				if at > 0.0:
					var x := inside.position.x + inside.size.x * at
					draw_line(Vector2(x, frame.position.y - 4.0), Vector2(x, frame.end.y + 4.0), INK, 4.0)
		draw_rect(inside, INK, false, 2.0)

		var font := ThemeDB.fallback_font
		var name_size := font.get_string_size(stand_name, HORIZONTAL_ALIGNMENT_CENTER, -1, 20)
		var name_at := Vector2(size.x * 0.5 - name_size.x * 0.5, 22.0) + offset
		draw_string_outline(font, name_at, stand_name, HORIZONTAL_ALIGNMENT_LEFT, -1, 20, 6, INK)
		draw_string(font, name_at, stand_name, HORIZONTAL_ALIGNMENT_LEFT, -1, 20, PAPER)
