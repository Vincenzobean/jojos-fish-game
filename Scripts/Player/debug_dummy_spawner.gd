# Debug tool for testing stand attacks: press F2 to float a target dummy (target_dummy.gd) a few meters
# in front of wherever the camera looks, facing it, at about a stand's height; Shift+F2 clears them all,
# and Ctrl+F2 switches whether they punch back.
# Only active in debug builds (running from the editor), never in an exported game. The key is fixed
# rather than in the rebindable controls, since it's a dev tool.
# Generated by Claude Code.
extends Node

@export var dummy_scene: PackedScene = preload("res://scenes/target_dummy.tscn")
@export var distance := 7.0 ## Meters in front of the camera, flat.
@export var height := 1.8 ## Meters above the player's feet.
@export var key := KEY_F2

var fights_back := true ## Whether dummies punch back (Ctrl+F2), for the ones spawned from now on too.

@onready var player: Node3D = get_parent()


func _ready() -> void:
	if not OS.is_debug_build():
		queue_free()


func _unhandled_input(event: InputEvent) -> void:
	if event is InputEventKey and event.pressed and not event.echo and event.keycode == key:
		get_viewport().set_input_as_handled()
		if event.ctrl_pressed:
			fights_back = not fights_back
			for dummy in get_tree().get_nodes_in_group("target_dummies"):
				dummy.fights_back = fights_back
			print("Debug: target dummies %s" % ("fight back" if fights_back else "stand still"))
		elif event.shift_pressed:
			for dummy in get_tree().get_nodes_in_group("target_dummies"):
				dummy.queue_free()
			print("Debug: cleared the target dummies")
		else:
			spawn()


## Floats a dummy in front of the camera, facing it.
func spawn() -> Node3D:
	var camera := get_viewport().get_camera_3d()
	var from: Vector3 = camera.global_position if camera else player.global_position
	var forward: Vector3 = -camera.global_basis.z if camera else -player.global_basis.z
	forward.y = 0.0
	forward = forward.normalized() if forward.length() > 0.01 else Vector3.FORWARD
	var at := from + forward * distance
	at.y = player.global_position.y + height
	var dummy: Node3D = dummy_scene.instantiate()
	get_tree().current_scene.add_child(dummy)
	dummy.fights_back = fights_back
	dummy.place(Transform3D(Basis.looking_at(-forward, Vector3.UP), at)) # Facing back toward the camera.
	print("Debug: floated a target dummy at %s" % at)
	return dummy
