# Player controller: first-person mouse look, WASD movement with acceleration/friction,
# sprint (hold Shift), gravity and jump. The player can't swim: water drags at them, slows them and
# lightens gravity so they sink slowly. Swimming is riding a stand (stand_ride.gd), which catches the
# player as they go in deep; submersion() and is_safe_ground() are for it.
# The water reacts to them (water.gd): falling in splashes, sized by how fast they hit it, and wading
# leaves a wake of ripples.
# Mouse sensitivity (a multiplier on mouse_sensitivity), invert Y and the field of view come from the
# Settings autoload. Escape is handled by the pause menu, which frees the mouse; clicking recaptures it.
# stun() (when their stand is beaten) stops them moving and jumping for a moment.
# The debug tools (DEBUG_TOOLS: F1 stands, F2 target dummies, F3/F4 skill points) are added as children
# here, only in debug builds. They're loaded by path, never preloaded, so the export preset's
# exclude_filter can leave them (and the target dummy) out of the exported game entirely.
# Generated by Claude Code.
extends CharacterBody3D

@export var speed := 5.0
@export var sprint_multiplier := 2.0
@export var acceleration := 20.0
@export var friction := 12.0
@export var jump_velocity := 5.0
@export var mouse_sensitivity := 0.002

@export_group("Water")
@export var body_height := 1.6 # The player's full height, used to work out how submerged they are.
@export var sink_gravity := 0.35 # Share of gravity left at full submersion: the player sinks, slowly.
@export var water_drag := 2.5 # How strongly water slows movement.
@export var water_speed_multiplier := 0.6 # Movement speed when fully submerged.
@export var splash_speed := 12.0 # m/s. Falling into the water this fast makes the biggest splash; slower than 2 just wades in.

## Debug-only tools added as children in debug builds (_add_debug_tools()). Not in the exported game.
const DEBUG_TOOLS: Array[String] = [
	"res://Scripts/Player/debug_stand_spawner.gd",
	"res://Scripts/Player/debug_dummy_spawner.gd",
	"res://Scripts/Player/debug_skill_points.gd",
]

@onready var camera: Camera3D = $Camera3D

var _water: Node
var _stun := 0.0 # Seconds left stunned: no moving or jumping.
var _was_wet := false


func _ready() -> void:
	add_to_group("player") # How the world finds them (villain_user.gd).
	Input.mouse_mode = Input.MOUSE_MODE_CAPTURED
	camera.fov = Settings.get_value("display", "fov")
	Settings.changed.connect(_on_setting_changed)
	_add_debug_tools()


# Adds DEBUG_TOOLS as children (named DebugStandSpawner etc.), wired to the inventory. Debug builds only.
func _add_debug_tools() -> void:
	if not OS.is_debug_build():
		return
	for path: String in DEBUG_TOOLS:
		var tool: Node = (load(path) as GDScript).new()
		tool.name = path.get_file().get_basename().to_pascal_case()
		if "inventory" in tool:
			tool.inventory = $Inventory
		add_child(tool)


func _unhandled_input(event: InputEvent) -> void:
	if event is InputEventMouseMotion and Input.mouse_mode == Input.MOUSE_MODE_CAPTURED:
		var look: Vector2 = event.relative * mouse_sensitivity * Settings.get_value("controls", "mouse_sensitivity")
		if Settings.get_value("controls", "invert_y"):
			look.y = -look.y
		rotate_y(-look.x)
		camera.rotate_x(-look.y)
		camera.rotation.x = clampf(camera.rotation.x, -PI / 2.0, PI / 2.0)
	elif event is InputEventMouseButton and event.pressed:
		Input.mouse_mode = Input.MOUSE_MODE_CAPTURED


## Stuns the player for `seconds` (their stand was beaten, possession.gd): they can look around but not
## move or jump.
func stun(seconds: float) -> void:
	_stun = maxf(_stun, seconds)


func is_stunned() -> bool:
	return _stun > 0.0


func _on_setting_changed(section: String, key: String) -> void:
	if section == "display" and key == "fov":
		camera.fov = Settings.get_value("display", "fov")


func _physics_process(delta: float) -> void:
	var submersion := submersion()
	_stun = maxf(_stun - delta, 0.0)

	# Water takes some of gravity's pull, in proportion to how submerged the player is: they sink, slowly.
	var gravity_scale := lerpf(1.0, sink_gravity, submersion)
	if not is_on_floor():
		velocity += get_gravity() * gravity_scale * delta
	elif Input.is_action_just_pressed("jump") and _stun <= 0.0:
		velocity.y = jump_velocity

	_react_water(submersion)
	if submersion > 0.0:
		velocity *= exp(-water_drag * submersion * delta)

	var input := Input.get_vector("move_left", "move_right", "move_up", "move_down") if _stun <= 0.0 else Vector2.ZERO
	var direction := transform.basis * Vector3(input.x, 0.0, input.y)
	var rate := acceleration if direction != Vector3.ZERO else friction
	var target_speed := speed * sprint_multiplier if Input.is_action_pressed("sprint") else speed
	target_speed *= lerpf(1.0, water_speed_multiplier, submersion)
	var horizontal := Vector3(velocity.x, 0.0, velocity.z).move_toward(direction * target_speed, rate * delta)
	velocity.x = horizontal.x
	velocity.z = horizontal.z
	move_and_slide()


# Splashes on falling in, and leaves a wake while moving through the water.
func _react_water(submersion: float) -> void:
	var wet := submersion > 0.0
	if wet and not _was_wet and velocity.y < -2.0:
		_water.splash(global_position, clampf(-velocity.y / splash_speed, 0.1, 1.0))
	elif wet:
		_water.wake(self, global_position, velocity)
	_was_wet = wet


## Whether the player stands on solid, dry ground (scenery, not water or something moving): somewhere
## safe to be put back after sinking (stand_ride.gd).
func is_safe_ground() -> bool:
	if not is_on_floor() or submersion() > 0.0:
		return false
	for i in get_slide_collision_count():
		if get_slide_collision(i).get_collider() is StaticBody3D and get_slide_collision(i).get_normal().y > 0.7:
			return true
	return false


## How much of the player's body is under the water surface, from 0 (dry) to 1 (fully under).
func submersion() -> float:
	if _water == null:
		_water = get_tree().get_first_node_in_group("water")
		if _water == null:
			return 0.0
	var feet := global_position.y - body_height * 0.5
	var surface: float = _water.surface_height_at(global_position)
	return clampf((surface - feet) / body_height, 0.0, 1.0)
