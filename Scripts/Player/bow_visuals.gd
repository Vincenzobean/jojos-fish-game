# Held bow animation: bends the string back as the bow is drawn (sliding the nocked arrow back with it),
# makes it vibrate after release, and hides or shows the nocked arrow while one is out. The pufferfish
# on the nocked arrow's tip is a separate sprite (the arrow model is scaled and rotated, which would
# distort it), kept following the arrow's pull and visibility, and hidden for good once the bow reports
# the fish lost (has_pufferfish()).
# Purely presentation. It only reads the gameplay bow (bow.gd, its parent): draw_amount, is_drawing()
# and its signals. Gameplay never reads anything this moves, so the animation can be retuned or
# replaced freely. Everything specific to the bow model (which mesh is the string, how long it is)
# lives here, so swapping the model only touches this node.
# The model has no skeleton, so the string is bent by a vertex shader (bow_string.gdshader).
# Generated by Claude Code.
extends Node

const STRING_SHADER := preload("res://assets/player/fantasy_bow/bow_string.gdshader")
const WaterSplash := preload("res://Scripts/Water/water_splash.gd")

@export var model: Node3D # The bow model; its scale converts meters to the shader's model units.
@export var held_arrow: Node3D # The arrow shown nocked on the string.
@export var held_pufferfish: Node3D # The fish on the nocked arrow's tip; moves and hides with held_arrow.

@export_group("Model")
@export var string_mesh_name := "Object_10" # The string's MeshInstance3D inside the model (the fantasy bow's "Cylinder_3").
@export var string_half_length := 15.46 # Model units from the string's middle to either limb tip.

@export_group("Draw")
@export var draw_distance := 0.2 # Meters the string's middle (and the arrow) is pulled back at full draw.

@export_group("String wobble")
@export var wobble_amplitude := 0.05 # Meters the string's middle swings either side of rest after a full-draw release.
@export var wobble_frequency := 38.0 # Radians per second of the swing (38 is about 6 swings a second).
@export var wobble_damping := 5.0 # How quickly the swing dies away; higher settles sooner.
@export var wobble_time := 0.9 # Seconds before the string is snapped still (by then the swing is ~1% of its start).
@export var wobble_sideways := 0.5 # Sideways swing, as a share of the front-to-back one, so the string doesn't move in one flat plane.

@onready var bow: Node3D = get_parent()

var _string_material: ShaderMaterial
var _held_arrow_rest_z := 0.0
var _held_pufferfish_rest_z := 0.0
var _wobble_size := 0.0 # Meters the wobble starts at: wobble_amplitude scaled by how far the string was drawn.
var _release_time := -1.0 # Seconds since the string was let go, while it's still wobbling; -1 otherwise.


func _ready() -> void:
	_held_arrow_rest_z = held_arrow.position.z
	if held_pufferfish:
		_held_pufferfish_rest_z = held_pufferfish.position.z
	_string_material = _make_string_material()
	# Arrows from this bow splash into the water; get that effect's shaders compiled during load. Deferred
	# because the bow (our parent) only picks up its camera once its own _ready has run, after ours.
	(func() -> void: WaterSplash.prewarm(bow.camera)).call_deferred()
	bow.draw_started.connect(_on_draw_started)
	bow.fired.connect(_on_fired)
	bow.draw_cancelled.connect(_let_go_of_string)
	bow.arrow_returned.connect(_on_arrow_returned)


func _process(delta: float) -> void:
	if bow.is_drawing():
		# Ease out: quick at first, slowing as the bow gets harder to pull.
		var amount: float = bow.draw_amount
		var pull := draw_distance * (1.0 - (1.0 - amount) * (1.0 - amount))
		_set_string_pull(pull)
		held_arrow.position.z = _held_arrow_rest_z + pull
	elif _release_time >= 0.0:
		_update_string_wobble(delta)

	if held_pufferfish:
		held_pufferfish.position.z = _held_pufferfish_rest_z + held_arrow.position.z - _held_arrow_rest_z
		held_pufferfish.visible = held_arrow.visible and bow.has_pufferfish()


func _on_draw_started() -> void:
	_release_time = -1.0


func _on_fired(draw_amount: float) -> void:
	held_arrow.visible = false
	_let_go_of_string(draw_amount)


func _on_arrow_returned() -> void:
	held_arrow.visible = true


# Lets the string go: it snaps straight at once, then starts vibrating. The further it was drawn, the
# harder it vibrates.
func _let_go_of_string(draw_amount: float) -> void:
	_wobble_size = wobble_amplitude * clampf(draw_amount, 0.0, 1.0)
	_release_time = 0.0
	_set_string_pull(0.0)
	held_arrow.position.z = _held_arrow_rest_z


# A dying vibration: the string's middle swings forward (it was just released from behind) then back,
# with a smaller, slightly faster sideways swing so it traces a loop rather than a flat line.
func _update_string_wobble(delta: float) -> void:
	_release_time += delta
	if _release_time >= wobble_time:
		_release_time = -1.0
		_set_string_pull(0.0)
		return
	var size := _wobble_size * exp(-_release_time * wobble_damping)
	var phase := _release_time * wobble_frequency
	_set_string_pull(-size * sin(phase), size * wobble_sideways * sin(phase * 1.3))


# Bends the string's middle back by `meters` (negative bows it forward) and sideways by `sideways_meters`.
func _set_string_pull(meters: float, sideways_meters := 0.0) -> void:
	# The shader works in the model's own units, and the model is scaled down in the scene.
	_string_material.set_shader_parameter("pull", meters / model.scale.z)
	_string_material.set_shader_parameter("sway", sideways_meters / model.scale.x)


# Swaps the string's imported material for the bending shader, keeping its texture.
func _make_string_material() -> ShaderMaterial:
	var material := ShaderMaterial.new()
	material.shader = STRING_SHADER
	material.set_shader_parameter("half_length", string_half_length)
	var string_mesh := model.find_child(string_mesh_name, true, false) as MeshInstance3D
	if string_mesh == null:
		push_warning("Bow string mesh '%s' not found; the string won't bend." % string_mesh_name)
		return material
	var original := string_mesh.mesh.surface_get_material(0) as BaseMaterial3D
	if original:
		material.set_shader_parameter("albedo_texture", original.albedo_texture)
		material.set_shader_parameter("roughness_value", original.roughness)
	string_mesh.material_override = material
	# The shader moves vertices past the mesh's bounds, so widen them or the string could be culled mid-draw.
	string_mesh.extra_cull_margin = draw_distance / model.scale.z
	return material
