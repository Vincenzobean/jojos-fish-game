# Held bow gameplay: hold fire to draw, release to fire the single rope-tethered arrow (a fuller draw
# shoots faster), shows the reel prompt, and reels in either the arrow or the physics body it is stuck
# in, then snaps it back. Reeling works any time after the arrow leaves the bow, even mid-flight.
# All presentation lives in companion scripts on child nodes: bow_visuals.gd (Visuals: string and nocked
# arrow) and rope_visuals.gd (RopeVisuals: the tether rope). This script only exposes its state
# (draw_amount, is_drawing(), is_reeling(), get_arrow()) and signals, and never reads anything they
# move. Arrows launch from the fixed ArrowSpawn marker, not from the animated arrow on the string.
# The player starts with the pufferfish on the arrow (it drives the tutorial). Each shot carries it, and
# once an arrow loses it in the water it is gone for good: reeled-in and later arrows come back bare.
# The player's skills (the Skills autoload) quicken the draw, the reel and haul, and the arrow.
# Generated by Claude Code.
extends Node3D

## Fire was pressed and the string starts being pulled back.
signal draw_started
## The arrow left the bow; `draw_amount` is how far the string was drawn (0-1) when it was let go.
signal fired(draw_amount: float)
## The draw was abandoned without shooting (the mouse was freed mid-draw).
signal draw_cancelled(draw_amount: float)
## The arrow was reeled back in and is ready to shoot again.
signal arrow_returned
## The pufferfish fell off the arrow into the water; it won't come back.
signal pufferfish_lost
## A physics body the arrow was stuck in has been hauled all the way in (the arrow is back in the bow).
signal body_reeled_in(body: RigidBody3D)

enum State { READY, DRAWING, FLYING, LANDED, REELING }

const ARROW_SCENE := preload("res://scenes/arrow_projectile.tscn")

@export var arrow_speed := 30.0 # At full draw.
@export var min_arrow_speed := 10.0 # Speed of a shot released the instant it's drawn.
@export var draw_time := 0.5 # Seconds to reach full draw (and full speed).
@export var aim_distance := 30.0
@export var reel_speed := 40.0 # Meters per second a loose arrow is reeled back in.
@export var body_reel_speed := 12.0 # Meters per second a body the arrow is stuck in is hauled in; slower than a loose arrow so heavy things aren't flung about.
@export var body_reel_acceleration := 40.0 # m/s^2 the haul brings a body's speed toward body_reel_speed; finite, so a thrashing stand can fight it.
@export var snap_distance := 0.6
@export var body_snap_distance := 1.5

@onready var arrow_spawn: Marker3D = $ArrowSpawn # Where the arrow is nocked; it launches from, is reeled back to, and the rope ties to, here.
@onready var camera: Camera3D = get_parent()

## How far the string is drawn: 0 at rest, 1 fully drawn. Read-only outside this script.
var draw_amount := 0.0
## Multiplies body_reel_speed. Other gameplay can slow the haul, e.g. a hooked stand pulling back (fishing.gd).
var body_reel_speed_scale := 1.0
## How much a hauled body is lifted toward the bow: 0 hauls it flat (along the water), 1 pulls straight at
## the bow (up a shore). Fishing (fishing.gd) switches it per tick; anything else is pulled straight.
var body_reel_lift := 1.0

var _state := State.READY
var _has_pufferfish := true
var _arrow: RigidBody3D
var _prompt: Label


func _ready() -> void:
	_prompt = _make_prompt()


# Put away (possession.gd disables the bow while a stand is out): the reel prompt goes too, since _process
# no longer runs to hide it.
func _notification(what: int) -> void:
	if what == NOTIFICATION_DISABLED and _prompt:
		_prompt.visible = false


func is_drawing() -> bool:
	return _state == State.DRAWING


## True while the reel button is held and the arrow (or what it is stuck in) is being pulled in.
func is_reeling() -> bool:
	return _state == State.REELING


## Whether the player still has the pufferfish (on the nocked arrow, or on the arrow that's out).
func has_pufferfish() -> bool:
	return _has_pufferfish


## The arrow while it is out of the bow (flying, landed or being reeled), otherwise null.
func get_arrow() -> RigidBody3D:
	return _arrow


## Snaps an arrow that's out straight back into the bow, letting go of anything it's stuck in (a
## hooked stand gets away): the player's stand catching them in the water (stand_ride.gd) needs it home.
func recall() -> void:
	if _arrow != null:
		_snap_back()


func _unhandled_input(event: InputEvent) -> void:
	if event.is_action_pressed("fire") and _state == State.READY and Input.mouse_mode == Input.MOUSE_MODE_CAPTURED:
		_state = State.DRAWING
		draw_amount = 0.0
		draw_started.emit()


# Reeling works any time the arrow is out: in flight, landed, or sinking.
func _physics_process(delta: float) -> void:
	if _state != State.FLYING and _state != State.LANDED and _state != State.REELING:
		return
	if not Input.is_action_pressed("reel"):
		if _state == State.REELING:
			# Stopped early: the arrow drops from wherever it was pulled to, and lands again.
			_arrow.let_go()
			_state = State.LANDED if _arrow.has_landed() else State.FLYING
		return
	if _state != State.REELING:
		# A flying or sinking arrow is still simulating; pause it so reeling can move it.
		_arrow.hold_still()
		_state = State.REELING
	var anchor := _rope_anchor()
	var hit: Node = _arrow.get("hit_body")
	if is_instance_valid(hit) and hit is RigidBody3D:
		_reel_body(hit, anchor, delta)
	else:
		_reel_arrow(anchor, delta)


# The arrow is stuck in a physics body, so haul the body toward the player instead of the arrow.
func _reel_body(body: RigidBody3D, anchor: Vector3, delta: float) -> void:
	# Toward the bow; how much of the climb is included is body_reel_lift, so a body can be lifted up a
	# shore rather than shoved into the slope. On a flat haul only the horizontal speed is steered: the
	# vertical is left to gravity, so a body that's thrown up falls back down instead of hanging there.
	var pull := _arrow.global_position.direction_to(anchor)
	pull.y *= body_reel_lift
	pull = pull.normalized() * Skills.scaled(Skills.PLAYER, "reel_speed", body_reel_speed) * body_reel_speed_scale
	body.sleeping = false
	var velocity := body.linear_velocity
	var horizontal := Vector2(velocity.x, velocity.z).move_toward(Vector2(pull.x, pull.z), body_reel_acceleration * delta)
	velocity.x = horizontal.x
	velocity.z = horizontal.y
	if body_reel_lift > 0.0:
		velocity.y = move_toward(velocity.y, pull.y, body_reel_acceleration * delta)
	body.linear_velocity = velocity
	if _arrow.global_position.distance_to(anchor) <= body_snap_distance:
		_snap_back()
		body_reeled_in.emit(body)


func _reel_arrow(anchor: Vector3, delta: float) -> void:
	_arrow.global_position = _arrow.global_position.move_toward(anchor, Skills.scaled(Skills.PLAYER, "reel_speed", reel_speed) * delta)
	# Drag the arrow tail-first: the tip trails away from the player.
	var away := _arrow.global_position - anchor
	if away.length() > 0.01:
		_arrow.global_basis = Basis.looking_at(away.normalized())
	if _arrow.global_position.distance_to(anchor) <= snap_distance:
		_snap_back()


func _process(delta: float) -> void:
	if _state == State.DRAWING:
		_update_draw(delta)

	_prompt.visible = _state == State.FLYING or _state == State.LANDED


# Builds up the draw while fire is held; fires when it's let go. Polling the button, rather than
# waiting for a release event, means a release that happens while the game isn't listening (e.g. over
# a menu) can't leave the bow stuck drawn.
func _update_draw(delta: float) -> void:
	if Input.mouse_mode != Input.MOUSE_MODE_CAPTURED:
		# Mouse freed mid-draw (a menu opened): stop without shooting.
		_state = State.READY
		draw_cancelled.emit(draw_amount)
		draw_amount = 0.0
		return
	if not Input.is_action_pressed("fire"):
		_fire()
		return
	draw_amount = minf(draw_amount + delta / maxf(Skills.scaled(Skills.PLAYER, "draw_time", draw_time), 0.001), 1.0)


func _fire() -> void:
	_state = State.FLYING

	_arrow = ARROW_SCENE.instantiate()
	_arrow.carries_pufferfish = _has_pufferfish # Before adding it, so its visuals start out right.
	_arrow.pufferfish_lost.connect(_on_pufferfish_lost)
	var scene := get_tree().current_scene if get_tree().current_scene else get_tree().root
	scene.add_child(_arrow)

	# Aim at the point the crosshair is looking at, since the bow is held off to the side.
	var start := arrow_spawn.global_position
	var target := camera.global_position - camera.global_basis.z * aim_distance
	var direction := (target - start).normalized()
	_arrow.global_transform = Transform3D(Basis.looking_at(direction), start)
	_arrow.linear_velocity = direction * Skills.scaled(Skills.PLAYER, "arrow_speed", lerpf(min_arrow_speed, arrow_speed, draw_amount))

	var player := camera.get_parent() as PhysicsBody3D
	if player:
		_arrow.add_collision_exception_with(player)
	_arrow.landed.connect(_on_arrow_landed)
	fired.emit(draw_amount)
	draw_amount = 0.0


func _on_arrow_landed() -> void:
	if _state == State.FLYING:
		_state = State.LANDED


func _on_pufferfish_lost() -> void:
	_has_pufferfish = false
	pufferfish_lost.emit()


func _snap_back() -> void:
	_arrow.queue_free()
	_arrow = null
	_state = State.READY
	arrow_returned.emit()


func _rope_anchor() -> Vector3:
	return arrow_spawn.global_position


func _make_prompt() -> Label:
	var layer := CanvasLayer.new()
	var label := HudStyle.label(28, "Hold E to reel in")
	label.visible = false
	layer.add_child(label)
	add_child(layer)
	label.set_anchors_and_offsets_preset(Control.PRESET_CENTER_BOTTOM, Control.PRESET_MODE_MINSIZE)
	label.offset_top = -120
	label.offset_bottom = -80
	return label
