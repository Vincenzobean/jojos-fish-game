# The inventory screen: the inventory action (Tab) opens a panel listing every kind of stand held
# (inventory.gd), with counts. Clicking a stand selects it and summons it (possession.gd); stands that
# can't be summoned are listed but can't be picked. While open the game is paused and the cursor is free;
# Tab or Escape closes it (Escape here never also opens the pause menu).
# It only opens when the player is in control: not while a stand is controlled, the game is paused, or
# the player is frozen (on the title screen).
# Generated by Claude Code.
extends CanvasLayer

const PANEL_SIZE := Vector2(620.0, 420.0)

@export var inventory: Node # inventory.gd
@export var possession: Node # possession.gd

var _grid: GridContainer
var _empty_label: Label
var _mouse_mode_before := Input.MOUSE_MODE_CAPTURED


func _ready() -> void:
	_build_ui()
	visible = false
	inventory.changed.connect(_refresh)


func is_open() -> bool:
	return visible


func open() -> void:
	if visible or possession.is_possessing() or get_tree().paused or not get_parent().can_process():
		return
	_refresh()
	visible = true
	get_tree().paused = true
	_mouse_mode_before = Input.mouse_mode
	Input.mouse_mode = Input.MOUSE_MODE_VISIBLE
	var first := _grid.get_child(0) as Button if _grid.get_child_count() > 0 else null
	if first and not first.disabled:
		first.grab_focus()


func close() -> void:
	if not visible:
		return
	visible = false
	get_tree().paused = false
	Input.mouse_mode = _mouse_mode_before


func _unhandled_input(event: InputEvent) -> void:
	if not visible and event.is_action_pressed("inventory"):
		get_viewport().set_input_as_handled()
		open()


# While open, Tab and Escape are taken here, before the pause menu can see Escape.
func _input(event: InputEvent) -> void:
	if visible and (event.is_action_pressed("inventory") or event.is_action_pressed("pause")):
		get_viewport().set_input_as_handled()
		close()


func _pick(path: String) -> void:
	inventory.select(path)
	close()
	possession.summon(path)


func _refresh() -> void:
	for child in _grid.get_children():
		_grid.remove_child(child)
		child.queue_free()
	for path: String in inventory.kinds():
		var button := Button.new()
		var summonable: bool = inventory.is_summonable(path)
		button.text = "%s  x%d%s" % [inventory.display_name(path), inventory.count(path), "" if summonable else "\n(can't be summoned)"]
		button.custom_minimum_size = Vector2(180.0, 64.0)
		button.disabled = not summonable
		if path == inventory.selected:
			button.add_theme_color_override("font_color", Color(1.0, 0.85, 0.35))
		button.pressed.connect(_pick.bind(path))
		_grid.add_child(button)
	_empty_label.visible = inventory.is_empty()


func _build_ui() -> void:
	layer = 40
	process_mode = Node.PROCESS_MODE_ALWAYS

	var shade := ColorRect.new()
	shade.color = Color(0.0, 0.03, 0.06, 0.55)
	shade.set_anchors_preset(Control.PRESET_FULL_RECT)
	add_child(shade)

	var center := CenterContainer.new()
	center.set_anchors_preset(Control.PRESET_FULL_RECT)
	add_child(center)

	var panel := PanelContainer.new()
	panel.custom_minimum_size = PANEL_SIZE
	center.add_child(panel)

	var column := VBoxContainer.new()
	column.add_theme_constant_override("separation", 14)
	panel.add_child(column)

	var title := Label.new()
	title.text = "Inventory"
	title.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	title.add_theme_font_size_override("font_size", 32)
	column.add_child(title)

	var scroll := ScrollContainer.new()
	scroll.size_flags_vertical = Control.SIZE_EXPAND_FILL
	scroll.horizontal_scroll_mode = ScrollContainer.SCROLL_MODE_DISABLED
	column.add_child(scroll)
	_grid = GridContainer.new()
	_grid.columns = 3
	_grid.add_theme_constant_override("h_separation", 12)
	_grid.add_theme_constant_override("v_separation", 12)
	_grid.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	scroll.add_child(_grid)

	_empty_label = Label.new()
	_empty_label.text = "Empty - go fishing!"
	_empty_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	_empty_label.modulate = Color(1, 1, 1, 0.6)
	column.add_child(_empty_label)

	var hint := Label.new()
	hint.text = "Click a stand to summon it   -   K for skill trees   -   Tab to close"
	hint.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	hint.add_theme_font_size_override("font_size", 16)
	hint.modulate = Color(1, 1, 1, 0.7)
	column.add_child(hint)
