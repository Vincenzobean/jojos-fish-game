# Animates the title screen (title_screen.gd, its parent): circles the orbit camera slowly around
# the starting island with a gentle rise and fall, fades the menu in, and on Play fades the blur
# and the menu away before reporting `transition_finished`. Purely presentation; the title screen
# only waits on that signal.
# Generated by Claude Code.
extends Node

## The blur and menu have faded out after Play; the title screen can hand over control.
signal transition_finished

@export var orbit_camera: Camera3D
@export var orbit_center := Vector3(0.0, 4.0, 0.0) # The tutorial island is always at the map's center.
@export var orbit_radius := 60.0
@export var orbit_height := 24.0 # Above the orbit center.
@export var orbit_speed := 0.04 # Radians per second.
@export var bob_height := 2.0 # How far the camera drifts up and down.
@export var bob_speed := 0.25 # Radians per second of the up-and-down drift.
@export var menu_fade_in_time := 1.0
@export var fade_out_time := 0.7

@onready var title: Node3D = get_parent()

var _angle := 0.0
var _time := 0.0


func _ready() -> void:
	if not title.is_node_ready():
		await title.ready
	title.play_started.connect(_on_play_started)
	_angle = randf() * TAU
	_place_camera()

	title.menu.modulate.a = 0.0
	create_tween().tween_property(title.menu, "modulate:a", 1.0, menu_fade_in_time)


func _process(delta: float) -> void:
	if not is_instance_valid(orbit_camera) or not orbit_camera.current:
		return
	_time += delta
	_angle += orbit_speed * delta
	_place_camera()


func _place_camera() -> void:
	if not orbit_camera:
		return
	var around := Vector3(cos(_angle), 0.0, sin(_angle)) * orbit_radius
	var height := orbit_height + sin(_time * bob_speed) * bob_height
	orbit_camera.look_at_from_position(orbit_center + around + Vector3.UP * height, orbit_center)


func _on_play_started() -> void:
	var blur_material: ShaderMaterial = title.blur.material
	var tween := create_tween().set_parallel()
	tween.tween_method(func(amount: float) -> void: blur_material.set_shader_parameter("blur_amount", amount), 1.0, 0.0, fade_out_time) \
		.set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_OUT)
	tween.tween_property(title.menu, "modulate:a", 0.0, fade_out_time * 0.5)
	tween.chain().tween_callback(transition_finished.emit)
