# Title screen: the real game world (an instance of world.tscn) runs behind a blurred overlay with
# the game's name and Play / Settings / Quit. While it's up, the player and the pause menu are frozen
# and hidden, and the OrbitCamera shows the world instead.
#
# Play hands over in place, so there's no second load: the player's camera becomes current at once,
# `play_started` lets the visuals fade the blur and menu away, and when they report
# `transition_finished` the player is unfrozen, the mouse captured and the title's own nodes freed.
# Going back to the title (from the pause menu) reloads this scene through SceneLoader.
#
# Camera motion, the blur fade and the menu fade-in live in title_screen_visuals.gd (the Visuals
# child), which reads `blur` and `menu`. Without it, Play hands over immediately.
# Generated by Claude Code.
extends Node3D

## Play was pressed; control passes to the player once the visuals finish their transition.
signal play_started

const SettingsMenuScene := preload("res://scenes/settings_menu.tscn")
const BlurShader := preload("res://assets/ui/blur.gdshader")
const GAME_TITLE := "JoJo's Fish Game"
const BUTTON_WIDTH := 300.0
const MENU_LAYER := 5

@onready var world: Node3D = $World
@onready var orbit_camera: Camera3D = $OrbitCamera
@onready var _visuals: Node = get_node_or_null("Visuals")

## The full-screen blur over the world and the title + button column, built in _ready.
var blur: ColorRect
var menu: Control

var _layer: CanvasLayer
var _play_button: Button
var _settings_button: Button
var _settings: Control
var _started := false


func _ready() -> void:
	_build_ui()
	_set_gameplay_active(false)
	orbit_camera.make_current()
	Input.mouse_mode = Input.MOUSE_MODE_VISIBLE
	_play_button.grab_focus()


func _unhandled_input(event: InputEvent) -> void:
	if event.is_action_pressed("pause") and _settings:
		get_viewport().set_input_as_handled()
		_close_settings()


## Hands control to the player. Does nothing if the game has already started.
func start_game() -> void:
	if _started:
		return
	_started = true
	_close_settings()
	for button in [_play_button, _settings_button]:
		button.disabled = true

	var player := world.get_node_or_null("Player") as Node3D
	if player:
		player.visible = true
		(player.get_node("Camera3D") as Camera3D).make_current()
	play_started.emit()
	if _visuals:
		await _visuals.transition_finished

	_set_gameplay_active(true)
	Input.mouse_mode = Input.MOUSE_MODE_CAPTURED
	_layer.queue_free()
	orbit_camera.queue_free()
	if _visuals:
		_visuals.queue_free()


# Freezes (or unfreezes) everything the player controls. Disabling a node's processing also
# disables its children, so the held bow stops with the player.
func _set_gameplay_active(active: bool) -> void:
	var mode := Node.PROCESS_MODE_INHERIT if active else Node.PROCESS_MODE_DISABLED
	var player := world.get_node_or_null("Player") as Node3D
	if player:
		player.process_mode = mode
		player.visible = active
		var hud := player.get_node_or_null("HUD") as CanvasLayer
		if hud:
			hud.visible = active
	# The pause menu normally runs even while paused, so it needs ALWAYS rather than INHERIT.
	var pause_menu := world.get_node_or_null("PauseMenu")
	if pause_menu:
		pause_menu.process_mode = Node.PROCESS_MODE_ALWAYS if active else Node.PROCESS_MODE_DISABLED


func _open_settings() -> void:
	if _settings:
		return
	_settings = SettingsMenuScene.instantiate()
	_settings.closed.connect(_close_settings)
	_layer.add_child(_settings)
	menu.visible = false


func _close_settings() -> void:
	if not _settings:
		return
	_settings.queue_free()
	_settings = null
	menu.visible = true
	_settings_button.grab_focus()


func _build_ui() -> void:
	_layer = CanvasLayer.new()
	_layer.layer = MENU_LAYER
	add_child(_layer)

	blur = ColorRect.new()
	blur.set_anchors_preset(Control.PRESET_FULL_RECT)
	blur.mouse_filter = Control.MOUSE_FILTER_IGNORE
	var blur_material := ShaderMaterial.new()
	blur_material.shader = BlurShader
	blur.material = blur_material
	_layer.add_child(blur)

	menu = CenterContainer.new()
	menu.set_anchors_preset(Control.PRESET_FULL_RECT)
	_layer.add_child(menu)

	var column := VBoxContainer.new()
	column.add_theme_constant_override("separation", 16)
	menu.add_child(column)

	var title := Label.new()
	title.text = GAME_TITLE
	title.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	title.add_theme_font_size_override("font_size", 72)
	title.add_theme_constant_override("outline_size", 12)
	title.add_theme_color_override("font_outline_color", Color(0.02, 0.08, 0.12, 0.8))
	column.add_child(title)

	var spacer := Control.new()
	spacer.custom_minimum_size.y = 40.0
	column.add_child(spacer)

	_play_button = _add_button(column, "Play", start_game)
	_settings_button = _add_button(column, "Settings", _open_settings)
	_add_button(column, "Quit", get_tree().quit)


func _add_button(parent: Control, text: String, on_pressed: Callable) -> Button:
	var button := Button.new()
	button.text = text
	button.custom_minimum_size.x = BUTTON_WIDTH
	button.size_flags_horizontal = Control.SIZE_SHRINK_CENTER
	button.pressed.connect(on_pressed)
	parent.add_child(button)
	return button
