# How the ending (ending_screen.gd, its parent) looks: black fades in over the frozen game, "THE END"
# slams in with an ink outline, then the credits (its CREDITS) roll up from the bottom of the screen and
# stop under it; then the two choices (Keep fishing, Main menu) fade in. Any key or click while the
# credits roll hurries them along.
# Purely presentation (the buttons call the ending's keep_fishing() and main_menu()).
# Generated by Claude Code.
extends Control

@export var fade_time := 1.2
@export var roll_speed := 70.0 ## Pixels per second the credits rise...
@export var credits_stop := 200.0 ## ...until their top is this far down the screen (under the title).

@onready var ending: CanvasLayer = get_parent()

var _black: ColorRect
var _title: Label
var _credits: VBoxContainer
var _choices: HBoxContainer
var _rolling := false
var _hurry := 1.0


func _ready() -> void:
	set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	mouse_filter = Control.MOUSE_FILTER_STOP
	_black = ColorRect.new()
	_black.color = Color(0, 0, 0, 0)
	add_child(_black)
	_black.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	_title = HudStyle.label(96, "THE END", 18)
	_title.add_theme_color_override("font_color", Color(0.55, 1.0, 0.8))
	add_child(_title)
	_title.set_anchors_and_offsets_preset(Control.PRESET_CENTER_TOP)
	_title.grow_horizontal = Control.GROW_DIRECTION_BOTH
	_title.offset_top = 60.0
	_title.modulate.a = 0.0
	_credits = VBoxContainer.new()
	_credits.alignment = BoxContainer.ALIGNMENT_CENTER
	add_child(_credits)
	for entry: Array in ending.CREDITS:
		_credits.add_child(HudStyle.label(int(entry[1]), entry[0], 4))
	_choices = HBoxContainer.new()
	_choices.alignment = BoxContainer.ALIGNMENT_CENTER
	_choices.add_theme_constant_override("separation", 40)
	add_child(_choices)
	_choices.set_anchors_and_offsets_preset(Control.PRESET_CENTER_BOTTOM)
	_choices.grow_horizontal = Control.GROW_DIRECTION_BOTH
	_choices.offset_top = -110.0
	_choices.offset_bottom = -54.0
	for choice: Array in [["Keep fishing", ending.keep_fishing], ["Main menu", ending.main_menu]]:
		var button := Button.new()
		button.text = choice[0]
		button.custom_minimum_size = Vector2(240, 56)
		button.pressed.connect(choice[1])
		_choices.add_child(button)
	_choices.modulate.a = 0.0
	_choices.visible = false
	ending.opened.connect(_on_opened)


func _on_opened() -> void:
	var screen := get_viewport_rect().size
	_credits.reset_size()
	_credits.position = Vector2((screen.x - _credits.size.x) * 0.5, screen.y)
	_choices.visible = false
	_choices.modulate.a = 0.0
	_hurry = 1.0
	var tween := create_tween()
	tween.tween_property(_black, "color:a", 0.92, fade_time)
	tween.tween_callback(func() -> void: _title.scale = Vector2.ONE * 1.6)
	tween.tween_property(_title, "modulate:a", 1.0, 0.15)
	tween.parallel().tween_property(_title, "scale", Vector2.ONE, 0.25).set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_OUT)
	tween.tween_interval(0.8)
	tween.tween_callback(func() -> void: _rolling = true)


func _process(delta: float) -> void:
	_title.pivot_offset = _title.size * 0.5
	if not _rolling:
		return
	var screen := get_viewport_rect().size
	var stop_at := credits_stop
	_credits.position.y = maxf(_credits.position.y - roll_speed * _hurry * delta, stop_at)
	if _credits.position.y <= stop_at:
		_rolling = false
		_show_choices()


func _gui_input(event: InputEvent) -> void:
	if _rolling and (event is InputEventMouseButton and event.pressed):
		_hurry = 6.0


func _unhandled_input(event: InputEvent) -> void:
	if _rolling and event is InputEventKey and event.pressed:
		_hurry = 6.0


func _show_choices() -> void:
	_choices.visible = true
	create_tween().tween_property(_choices, "modulate:a", 1.0, 0.4)
	(_choices.get_child(0) as Button).grab_focus()
	ending.show_choices()
