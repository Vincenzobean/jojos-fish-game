# The look the in-game HUD shares: the manga ink and paper colours, the outlined label every prompt and
# message uses, and the fade a message plays. Used by the HUD (stand_hud.gd) and the *_visuals.gd
# companions that put text on screen (fishing, possession, riding, encounters) and the bow's prompt.
# Static helpers only.
# Generated by Claude Code.
class_name HudStyle
extends RefCounted

const INK := Color(0.06, 0.06, 0.08)
const PAPER := Color(0.97, 0.96, 0.92)


## A centred label that ignores the mouse, `font_size` high with a black outline `outline` wide.
static func label(font_size: int, text := "", outline := 6) -> Label:
	var made := Label.new()
	made.text = text
	made.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	made.mouse_filter = Control.MOUSE_FILTER_IGNORE
	made.add_theme_font_size_override("font_size", font_size)
	made.add_theme_color_override("font_outline_color", Color.BLACK)
	made.add_theme_constant_override("outline_size", outline)
	return made


## Shows `text` on `message` for `hold` seconds, then fades it out over `fade`; stops `previous` (the
## last message's fade) first. Returns the new fade, to pass as `previous` next time.
static func flash(message: Label, text: String, hold: float, previous: Tween = null, fade := 0.5) -> Tween:
	if previous:
		previous.kill()
	message.text = text
	message.modulate.a = 1.0
	var tween := message.create_tween()
	tween.tween_interval(hold)
	tween.tween_property(message, "modulate:a", 0.0, fade)
	return tween
