# The player's level on screen (Skills level(), the shared XP pool: skills.gd), drawn like the rest of the
# HUD, ink-edged paper:
#   * the XP bar, bottom centre: "Lv 7" on the left, the bar filling toward the next level, "340 / 220 XP"
#     on the right. It fills smoothly; reaching a level it fills to the end, flashes, and starts again from
#     empty. It's there while the player is on foot (the player's HUD is), not while a stand is controlled
#     or a cutscene plays.
#   * the level-up banner, mid-screen: "LEVEL 8" slamming in, and under it what it gave ("+1 skill point ·
#     Stands +3% health, +2% damage"). Several levels at once queue up, and none shows during a finisher or
#     a cutscene: they wait for it to end.
#   * the zone line, top centre, whenever the player crosses into another zone: "Zone 3 · Recommended Lv 8",
#     amber when they're below it (island_field.gd RECOMMENDED_LEVEL).
# Purely presentation: it reads Skills, the player's position and whether their HUD and stand are busy.
# Generated by Claude Code.
extends Node

const IslandField := preload("res://Scripts/World/island_field.gd")
const INK := HudStyle.INK
const PAPER := HudStyle.PAPER
const TRACK := Color(0.78, 0.76, 0.72)
const FILL := Color(0.35, 0.72, 0.95)
const GOLD := Color(1.0, 0.85, 0.3)
const UNDERLEVEL := Color(1.0, 0.68, 0.3)

@export var fill_speed := 1.5 ## Shares of the bar per second it fills toward the XP.
@export var banner_time := 2.2 ## Seconds a level-up banner stays.

@onready var player: Node3D = get_parent()
@onready var possession: Node = player.get_node_or_null("Possession")
@onready var encounter: Node = player.get_node_or_null("StandEncounter")

var _layer: CanvasLayer
var _bar: Bar
var _banner: Label
var _banner_sub: Label
var _zone_label: Label
var _zone_tween: Tween
var _queue: Array[int] = [] # Levels waiting for their banner.
var _showing := false
var _zone := -1


func _ready() -> void:
	_layer = CanvasLayer.new()
	_layer.layer = 15
	add_child(_layer)
	_bar = Bar.new()
	_bar.mouse_filter = Control.MOUSE_FILTER_IGNORE
	_layer.add_child(_bar)
	_bar.set_anchors_and_offsets_preset(Control.PRESET_CENTER_BOTTOM, Control.PRESET_MODE_MINSIZE)
	_bar.offset_left = -250.0
	_bar.offset_right = 250.0
	_bar.offset_top = -58.0
	_bar.offset_bottom = -22.0
	_bar.shown = _share()
	_bar.level = Skills.level()

	_banner = HudStyle.label(72, "", 14)
	_banner.add_theme_color_override("font_color", GOLD)
	_banner_sub = HudStyle.label(26, "", 6)
	for label: Label in [_banner, _banner_sub]:
		_layer.add_child(label)
		label.set_anchors_and_offsets_preset(Control.PRESET_CENTER)
		label.grow_horizontal = Control.GROW_DIRECTION_BOTH
		label.grow_vertical = Control.GROW_DIRECTION_BOTH
		label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
		label.modulate.a = 0.0
	# Under the crosshair, clear of the fight messages above it and the prompts below.
	_banner.offset_top = 36.0
	_banner.offset_bottom = 126.0
	_banner_sub.offset_top = 124.0
	_banner_sub.offset_bottom = 160.0

	_zone_label = HudStyle.label(28, "", 6)
	_layer.add_child(_zone_label)
	_zone_label.set_anchors_and_offsets_preset(Control.PRESET_CENTER_TOP)
	_zone_label.grow_horizontal = Control.GROW_DIRECTION_BOTH
	_zone_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	_zone_label.offset_top = 110.0
	_zone_label.offset_bottom = 150.0
	_zone_label.modulate.a = 0.0

	Skills.leveled_up.connect(func(level: int) -> void: _queue.append(level))


func _process(delta: float) -> void:
	var hud := player.get_node_or_null("HUD") as CanvasLayer
	var on_foot := hud == null or hud.visible
	_bar.visible = on_foot
	# The bar runs up to the XP; a level reached fills it to the end, flashes, and it starts again.
	var target := _share()
	if _bar.level < Skills.level():
		_bar.shown = move_toward(_bar.shown, 1.0, fill_speed * delta)
		if _bar.shown >= 1.0:
			_bar.level += 1
			_bar.shown = 0.0
			_bar.flash = 1.0
	else:
		_bar.level = Skills.level() # (Never shown dropping: XP lost on a defeat drains the bar instead.)
		_bar.shown = move_toward(_bar.shown, target, fill_speed * delta)
	_bar.flash = move_toward(_bar.flash, 0.0, delta * 2.0)
	_bar.xp_text = "%d / %d XP" % [Skills.xp(), Skills.xp_to_next()]
	_bar.queue_redraw()

	if not _showing and not _queue.is_empty() and not _busy():
		_show_banner(_queue.pop_front())

	var zone := IslandField.zone_at(player.global_position)
	if zone != _zone:
		if _zone != -1:
			_show_zone(zone)
		_zone = zone


## Whether a banner should wait: a finisher or another cutscene is playing.
func _busy() -> bool:
	if possession and possession.is_in_finisher():
		return true
	return encounter != null and encounter.is_busy()


func _share() -> float:
	return clampf(float(Skills.xp()) / maxf(Skills.xp_to_next(), 1.0), 0.0, 1.0)


func _show_banner(level: int) -> void:
	_showing = true
	_banner.text = "LEVEL %d" % level
	_banner_sub.text = "+1 skill point  ·  Stands +%d%% health, +%d%% damage" % [
		roundi(Skills.LEVEL_STATS["max_health"] * 100.0), roundi(Skills.LEVEL_STATS["damage"] * 100.0)]
	_banner.pivot_offset = _banner.size * 0.5
	_banner.scale = Vector2.ONE * 1.8
	var tween := create_tween()
	tween.tween_property(_banner, "modulate:a", 1.0, 0.12)
	tween.parallel().tween_property(_banner, "scale", Vector2.ONE, 0.3).set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_OUT)
	tween.tween_property(_banner_sub, "modulate:a", 1.0, 0.25)
	tween.tween_interval(banner_time)
	tween.tween_property(_banner, "modulate:a", 0.0, 0.4)
	tween.parallel().tween_property(_banner_sub, "modulate:a", 0.0, 0.4)
	tween.tween_callback(func() -> void: _showing = false)


func _show_zone(zone: int) -> void:
	var wanted := IslandField.recommended_level(zone)
	_zone_label.text = "Zone %d  ·  Recommended Lv %d" % [zone, wanted]
	_zone_label.add_theme_color_override("font_color", UNDERLEVEL if Skills.level() < wanted else Color.WHITE)
	_zone_tween = HudStyle.flash(_zone_label, _zone_label.text, 2.5, _zone_tween)


# The XP bar: a paper strip edged in ink, a blue fill, the level in a tab on its left and the XP on its
# right; it glows gold when a level is reached.
class Bar extends Control:
	var shown := 0.0 ## Share of the bar filled, as drawn.
	var level := 1 ## The level drawn in its tab.
	var flash := 0.0
	var xp_text := ""

	func _draw() -> void:
		var font := get_theme_default_font()
		var tab := Rect2(0.0, 0.0, 74.0, size.y)
		var track := Rect2(tab.size.x + 6.0, size.y * 0.22, size.x - tab.size.x - 6.0, size.y * 0.56)
		draw_rect(tab.grow(3.0), INK)
		draw_rect(tab, PAPER.lerp(GOLD, flash))
		var level_text := "Lv %d" % level
		var level_size := font.get_string_size(level_text, HORIZONTAL_ALIGNMENT_LEFT, -1, 22)
		draw_string(font, Vector2((tab.size.x - level_size.x) * 0.5, size.y * 0.5 + 8.0), level_text,
			HORIZONTAL_ALIGNMENT_LEFT, -1, 22, INK)
		draw_rect(track.grow(3.0), INK)
		draw_rect(track, TRACK)
		var fill := Rect2(track.position, Vector2(track.size.x * shown, track.size.y))
		draw_rect(fill, FILL.lerp(GOLD, flash))
		var xp_size := font.get_string_size(xp_text, HORIZONTAL_ALIGNMENT_LEFT, -1, 15)
		var at := Vector2(track.end.x - xp_size.x - 8.0, track.position.y + track.size.y * 0.5 + 5.0)
		draw_string_outline(font, at, xp_text, HORIZONTAL_ALIGNMENT_LEFT, -1, 15, 4, INK)
		draw_string(font, at, xp_text, HORIZONTAL_ALIGNMENT_LEFT, -1, 15, PAPER)
