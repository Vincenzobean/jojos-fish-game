# The ending, once Lord Verity is beaten (stand_encounter.gd `boss_beaten`; stand_encounter_visuals.gd
# brings it up with open()). The screen fades to black over the frozen game, "THE END" comes up, the
# credits roll (with the credit the Lord Verity model's licence asks for), then two choices: Keep fishing
# (back to the game, where he waits for a rematch) or Main menu. The game is paused meanwhile.
# Gameplay only: ending_screen_visuals.gd (its Visuals child) does the fading and rolling.
# Generated by Claude Code.
extends CanvasLayer

## It opened...
signal opened
## ...the credits finished rolling and the choices are up...
signal choices_shown
## ...and it closed, back to the game.
signal closed

const TITLE_SCENE := "res://scenes/title_screen.tscn"

## The credits, top to bottom: [text, size] ("" for a gap).
const CREDITS := [
	["Lord Verity has fallen. Still Water is still.", 26],
	["", 14],
	["JoJo's Fish Game", 38],
	["Thanks for playing.", 24],
	["", 18],
	["Lord Verity's model:", 18],
	["This work is based on \"Lord Verity RIG\"", 15],
	["(https://sketchfab.com/3d-models/lord-verity-rig-1116a6c0018c4d0c9623a43fa4045cd8)", 14],
	["by CheaterPMCPL (https://sketchfab.com/kamilborowiec066)", 15],
	["licensed under CC-BY-4.0 (http://creativecommons.org/licenses/by/4.0/)", 15],
]

var _open := false
var _pause_menu: Node
var _menu_mode := Node.PROCESS_MODE_INHERIT


func _ready() -> void:
	layer = 70
	process_mode = Node.PROCESS_MODE_ALWAYS
	visible = false


func is_open() -> bool:
	return _open


## Brings it up: the game pauses (the pause menu with it) and the cursor shows.
func open() -> void:
	if _open:
		return
	_open = true
	visible = true
	_pause_menu = get_tree().root.find_child("PauseMenu", true, false)
	if _pause_menu:
		_menu_mode = _pause_menu.process_mode
		_pause_menu.process_mode = Node.PROCESS_MODE_DISABLED
	get_tree().paused = true
	Input.mouse_mode = Input.MOUSE_MODE_VISIBLE
	opened.emit()


## The credits are done (the visuals say so): the choices come up.
func show_choices() -> void:
	choices_shown.emit()


## Back to the game.
func keep_fishing() -> void:
	if not _open:
		return
	_open = false
	visible = false
	get_tree().paused = false
	if _pause_menu:
		_pause_menu.process_mode = _menu_mode
	Input.mouse_mode = Input.MOUSE_MODE_CAPTURED
	closed.emit()


## To the title screen.
func main_menu() -> void:
	if _pause_menu:
		_pause_menu.process_mode = _menu_mode
	get_tree().paused = false
	SceneLoader.change_scene(TITLE_SCENE)
