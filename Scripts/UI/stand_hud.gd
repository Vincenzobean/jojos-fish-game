# The stand's health and stamina wheel, in the bottom-left corner while a stand is controlled
# (possession.gd, this node's parent). Drawn like a manga panel: a paper disc edged in ink with two rings
# round it, health outside in red and stamina inside in yellow, filling clockwise from the top; the
# stand's health in the middle and its name underneath.
#
# A hit shakes the wheel and flashes it, and the health it took stays as a pale chunk on the ring for a
# moment before draining away (the health node's recent_health). Stamina flashes red when something
# needed more than was left, and the whole wheel throbs while health is low.
#
# Beside it, a dial pops in for each attack while it's cooling down (stand_combat.gd cooldown_status()):
# the attack's icon on a paper disc under an ink shadow that sweeps away clockwise as it recovers, with
# the seconds left; ready, it flashes and goes. Trying an attack too soon shakes its dial.
# A stand with an ultimate it has learned (the Jellyfish's Return to Zero, on stand_ultimate) also gets a
# thin gold ring outside the wheel: its meter (stand_health.gd `ultimate`), glowing and pulsing once full,
# with the key to press; spent, it goes grey.
# Purely presentation: it only reads the controlled stand's health node (stand_health.gd) and combat.
# Generated by Claude Code.
extends Node

const INK := HudStyle.INK
const PAPER := HudStyle.PAPER
const TRACK := Color(0.78, 0.76, 0.72)
const HEALTH := Color(0.86, 0.14, 0.12)
const CHUNK := Color(1.0, 0.93, 0.72)
const STAMINA := Color(0.98, 0.78, 0.16)
const SHORT := Color(0.9, 0.2, 0.15)

@onready var possession: Node = get_parent()

var _wheel: Wheel
var _health: Node
var _dials: Dials
var _combat: Node


func _ready() -> void:
	var layer := CanvasLayer.new()
	add_child(layer)
	_dials = Dials.new()
	_dials.mouse_filter = Control.MOUSE_FILTER_IGNORE
	layer.add_child(_dials)
	_dials.set_anchors_and_offsets_preset(Control.PRESET_BOTTOM_LEFT, Control.PRESET_MODE_MINSIZE)
	_dials.offset_left = 24.0 + 190.0 + 8.0
	_dials.offset_right = _dials.offset_left + 420.0
	_dials.offset_top = -24.0 - 150.0
	_dials.offset_bottom = -24.0 - 80.0
	_wheel = Wheel.new()
	_wheel.mouse_filter = Control.MOUSE_FILTER_IGNORE
	layer.add_child(_wheel)
	_wheel.set_anchors_and_offsets_preset(Control.PRESET_BOTTOM_LEFT, Control.PRESET_MODE_MINSIZE)
	_wheel.offset_left = 24.0
	_wheel.offset_right = 24.0 + 190.0
	_wheel.offset_top = -24.0 - 210.0
	_wheel.offset_bottom = -24.0
	_wheel.visible = false


func _process(delta: float) -> void:
	var stand: Node3D = possession.get_possessed()
	var health: Node = stand.get_node_or_null("Health") if stand else null
	if health != _health:
		_health = health
		if health:
			health.damaged.connect(_on_damaged)
			health.stamina_short.connect(_on_stamina_short)
			_wheel.stand_name = stand.scene_file_path.get_file().get_basename().capitalize()
	_wheel.visible = health != null and not possession.is_in_finisher() # The finisher's a cutscene: no HUD.
	_update_dials(stand, delta)
	if health == null:
		return
	_wheel.health = health.health / health.max_health
	_wheel.recent = health.recent_health / health.max_health
	_wheel.stamina = health.stamina / health.max_stamina
	_wheel.health_number = ceili(health.health)
	_wheel.shake = move_toward(_wheel.shake, 0.0, delta * 3.0)
	_wheel.hit_flash = move_toward(_wheel.hit_flash, 0.0, delta * 3.0)
	_wheel.short_flash = move_toward(_wheel.short_flash, 0.0, delta * 2.5)
	_wheel.time += delta
	_wheel.ultimate = health.ultimate if "ultimate" in health and _has_ultimate(stand) else -1.0
	_wheel.ultimate_spent = "ultimate_used" in health and health.ultimate_used
	_wheel.queue_redraw()


# Whether `stand` has an ultimate move (on stand_ultimate) its kind has learned.
func _has_ultimate(stand: Node3D) -> bool:
	var moves: StandMoveSet = stand.get_moves() if stand.has_method("get_moves") else null
	if moves == null:
		return false
	for special in moves.specials:
		if special.input == &"stand_ultimate":
			return special.unlock == &"" or Skills.allows(stand.scene_file_path, special.unlock)
	return false


func _on_damaged(amount: float, _hit: Dictionary, blocked: bool) -> void:
	if amount <= 0.0:
		return
	_wheel.shake = 1.0 if not blocked else 0.4
	_wheel.hit_flash = 1.0 if not blocked else 0.4


func _on_stamina_short(_amount: float) -> void:
	_wheel.short_flash = 1.0


# The dials follow the controlled stand's cooldowns: in while cooling, a flash and out once ready.
func _update_dials(stand: Node3D, delta: float) -> void:
	var combat: Node = stand.get_node_or_null("Combat") if stand else null
	if combat != _combat:
		_combat = combat
		_dials.entries.clear()
		if combat and combat.has_signal("cooling_down"):
			combat.cooling_down.connect(_on_cooling_down)
	_dials.visible = combat != null and not possession.is_in_finisher()
	var cooling := {}
	if combat and combat.has_method("cooldown_status"):
		for status: Dictionary in combat.cooldown_status():
			cooling[status["key"]] = status
	for key: StringName in cooling:
		var status: Dictionary = cooling[key]
		if not _dials.entries.has(key) or _dials.entries[key]["done"]:
			_dials.entries[key] = {"icon": status["icon"], "appear": 0.0, "flash": 0.0, "shake": 0.0, "done": false}
		var entry: Dictionary = _dials.entries[key]
		entry["share"] = float(status["left"]) / maxf(float(status["total"]), 0.01)
		entry["left"] = float(status["left"])
	for key: StringName in _dials.entries.keys():
		var entry: Dictionary = _dials.entries[key]
		if not cooling.has(key) and not entry["done"]:
			entry["done"] = true # Ready: a flash, then it goes.
			entry["flash"] = 1.0
			entry["share"] = 0.0
		entry["appear"] = move_toward(entry["appear"], 0.0 if entry["done"] and entry["flash"] <= 0.0 else 1.0, delta * 6.0)
		entry["flash"] = move_toward(entry["flash"], 0.0, delta * 3.0)
		entry["shake"] = move_toward(entry["shake"], 0.0, delta * 4.0)
		if entry["done"] and entry["flash"] <= 0.0 and entry["appear"] <= 0.0:
			_dials.entries.erase(key)
	_dials.time += delta
	_dials.queue_redraw()


func _on_cooling_down(move: StandMove, _seconds_left: float) -> void:
	var entry: Dictionary = _dials.entries.get(move.cooldown_key(), {})
	if not entry.is_empty():
		entry["shake"] = 1.0


## The cooldown dials, in a row.
class Dials extends Control:
	var entries := {} # Cooldown key -> {"icon", "share" (left, 0..1), "left" (seconds), "appear", "flash", "shake", "done"}.
	var time := 0.0

	func _draw() -> void:
		var font := ThemeDB.fallback_font
		var x := 34.0
		for key: StringName in entries:
			var entry: Dictionary = entries[key]
			var appear: float = entry["appear"]
			if appear <= 0.01:
				continue
			var size := 26.0 * (0.6 + 0.4 * appear)
			var center := Vector2(x, 36.0) + Vector2(sin(time * 70.0), cos(time * 53.0)) * 5.0 * float(entry["shake"])
			var flash: float = entry["flash"]
			# The paper disc edged in ink, the icon on it...
			draw_circle(center, size + 3.0, INK)
			draw_circle(center, size, PAPER.lerp(Color(1.0, 0.95, 0.6), flash))
			SkillScreen.draw_icon(self, entry["icon"], center, size * 0.55, INK)
			# ...under the ink shadow of what's left, sweeping away clockwise from the top.
			var share := clampf(float(entry.get("share", 0.0)), 0.0, 1.0)
			if share > 0.001:
				var shade := PackedVector2Array([center])
				var steps := maxi(3, int(40 * share))
				for i in steps + 1:
					var angle := -PI * 0.5 + TAU * (1.0 - share) + TAU * share * i / steps
					shade.append(center + Vector2(cos(angle), sin(angle)) * size)
				draw_colored_polygon(shade, Color(INK, 0.62))
				var seconds := str(ceili(float(entry.get("left", 0.0))))
				var text_size := font.get_string_size(seconds, HORIZONTAL_ALIGNMENT_CENTER, -1, 20)
				var at := center + Vector2(-text_size.x * 0.5, 7.0)
				draw_string_outline(font, at, seconds, HORIZONTAL_ALIGNMENT_LEFT, -1, 20, 6, INK)
				draw_string(font, at, seconds, HORIZONTAL_ALIGNMENT_LEFT, -1, 20, PAPER)
			if flash > 0.0: # Ready: a ring bursting out.
				draw_arc(center, size + 4.0 + 14.0 * (1.0 - flash), 0.0, TAU, 32, Color(1.0, 0.92, 0.4, flash), 3.0, true)
			x += 64.0 * appear


## The wheel itself.
class Wheel extends Control:
	var health := 1.0 # Shares of full, 0 to 1.
	var recent := 1.0
	var stamina := 1.0
	var health_number := 0
	var stand_name := ""
	var shake := 0.0
	var hit_flash := 0.0
	var short_flash := 0.0
	var time := 0.0
	var ultimate := -1.0 ## Its ultimate meter, 0 to 1, or below 0 for none.
	var ultimate_spent := false

	func _draw() -> void:
		var center := Vector2(95.0, 95.0)
		center += Vector2(sin(time * 70.0), cos(time * 53.0)) * 6.0 * shake
		var size := 1.0
		if health < 0.25:
			size += 0.04 * (0.5 + 0.5 * sin(time * 9.0)) # Throbbing while low.
		var outer := 70.0 * size
		var inner := 50.0 * size

		# The paper disc, edged in ink.
		draw_circle(center, 84.0 * size, INK)
		draw_circle(center, 80.0 * size, PAPER.lerp(Color.WHITE, hit_flash))
		# Health: the track, the chunk just lost, and what's left.
		_ring(center, outer, 14.0 * size, 1.0, TRACK)
		_ring(center, outer, 14.0 * size, recent, CHUNK)
		_ring(center, outer, 14.0 * size, health, HEALTH.lerp(Color.WHITE, hit_flash * 0.6))
		# Stamina.
		_ring(center, inner, 10.0 * size, 1.0, TRACK)
		_ring(center, inner, 10.0 * size, stamina, STAMINA.lerp(SHORT, short_flash))
		# Ink lines either side of each ring.
		for edge in [outer + 7.0 * size, outer - 7.0 * size, inner + 5.0 * size, inner - 5.0 * size]:
			draw_arc(center, edge, 0.0, TAU, 64, INK, 2.0, true)

		var font := ThemeDB.fallback_font
		if ultimate >= 0.0:
			var gold := Color(1.0, 0.86, 0.45)
			var full := ultimate >= 1.0 and not ultimate_spent
			var ring := 88.0 * size
			draw_arc(center, ring, 0.0, TAU, 64, INK, 8.0, true)
			_ring(center, ring, 4.0, 1.0 if ultimate_spent else ultimate, (TRACK if ultimate_spent else gold).lerp(Color.WHITE, 0.5 * (0.5 + 0.5 * sin(time * 8.0)) if full else 0.0))
			if full:
				var hint := "T"
				draw_string_outline(font, center + Vector2(64.0, -64.0), hint, HORIZONTAL_ALIGNMENT_LEFT, -1, 22, 6, INK)
				draw_string(font, center + Vector2(64.0, -64.0), hint, HORIZONTAL_ALIGNMENT_LEFT, -1, 22, gold)
		var number := str(health_number)
		var number_size := font.get_string_size(number, HORIZONTAL_ALIGNMENT_CENTER, -1, 30)
		draw_string_outline(font, center + Vector2(-number_size.x * 0.5, 10.0), number, HORIZONTAL_ALIGNMENT_LEFT, -1, 30, 6, PAPER)
		draw_string(font, center + Vector2(-number_size.x * 0.5, 10.0), number, HORIZONTAL_ALIGNMENT_LEFT, -1, 30, INK)
		var name_size := font.get_string_size(stand_name, HORIZONTAL_ALIGNMENT_CENTER, -1, 16)
		var name_at := Vector2(95.0 - name_size.x * 0.5, 202.0)
		draw_string_outline(font, name_at, stand_name, HORIZONTAL_ALIGNMENT_LEFT, -1, 16, 6, INK)
		draw_string(font, name_at, stand_name, HORIZONTAL_ALIGNMENT_LEFT, -1, 16, PAPER)

	# A ring `share` of the way round, clockwise from the top.
	func _ring(center: Vector2, radius: float, width: float, share: float, color: Color) -> void:
		if share <= 0.001:
			return
		var start := -PI * 0.5
		draw_arc(center, radius, start, start + TAU * clampf(share, 0.0, 1.0), maxi(4, int(64 * share)), color, width, true)
