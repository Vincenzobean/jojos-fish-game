# Draws a simple outlined crosshair at the center of the screen.
# Generated by Claude Code.
extends Control

@export var color := Color.WHITE
@export var outline_color := Color(0, 0, 0, 0.8)
@export var gap := 6.0
@export var length := 10.0
@export var thickness := 2.0


func _ready() -> void:
	resized.connect(queue_redraw)


func _draw() -> void:
	var center := size / 2.0
	var arms := [Vector2.LEFT, Vector2.RIGHT, Vector2.UP, Vector2.DOWN]
	# Draw the outline first so the crosshair stays readable on light and dark backgrounds.
	for pass_width in [thickness + 2.0, thickness]:
		var arm_color := outline_color if pass_width > thickness else color
		var pad := 1.0 if pass_width > thickness else 0.0
		for dir: Vector2 in arms:
			draw_line(center + dir * (gap - pad), center + dir * (gap + length + pad), arm_color, pass_width)
	draw_circle(center, thickness + 1.0, outline_color)
	draw_circle(center, thickness * 0.5, color)
