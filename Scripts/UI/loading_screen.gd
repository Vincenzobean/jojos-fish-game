# The loading screen SceneLoader shows during scene changes: an opaque backdrop, a "Loading" title,
# a status line and a progress bar, plus a spinner so it's clear the game hasn't hung.
# It only holds state (`progress`, `status`) and is opened and closed by SceneLoader. The fades,
# spinner and the bar easing toward `progress` live in loading_screen_visuals.gd (the Visuals
# child), which reads the nodes exposed below. Without that node the screen just appears and
# disappears.
# Generated by Claude Code.
extends CanvasLayer

## The screen was asked to appear; `instant` skips the fade in.
signal opening(instant: bool)
## The screen was asked to go away.
signal closing

const BACKGROUND_COLOR := Color(0.03, 0.08, 0.11)
const BAR_WIDTH := 480.0
const SPINNER_SIZE := 48.0
const SPINNER_MARGIN := 32.0

## How far the current load has got, from 0 to 1.
var progress := 0.0
## A short line describing what is being loaded.
var status := "":
	set(value):
		status = value
		if _status_label:
			_status_label.text = value

## The nodes the visuals animate, built in _ready.
var root: Control
var bar: ProgressBar
var spinner: Control

var _status_label: Label

@onready var _visuals: Node = get_node_or_null("Visuals")


func _ready() -> void:
	_build_ui()
	visible = false


## Shows the screen; returns once it fully covers the game.
func open(instant := false) -> void:
	progress = 0.0
	visible = true
	opening.emit(instant)
	if _visuals:
		await _visuals.faded_in


## Hides the screen; returns once it is fully gone.
func close() -> void:
	closing.emit()
	if _visuals:
		await _visuals.faded_out
	visible = false


func _build_ui() -> void:
	root = Control.new()
	root.set_anchors_preset(Control.PRESET_FULL_RECT)
	root.mouse_filter = Control.MOUSE_FILTER_STOP # Swallow clicks so nothing behind reacts mid-load.
	add_child(root)

	var background := ColorRect.new()
	background.color = BACKGROUND_COLOR
	background.set_anchors_preset(Control.PRESET_FULL_RECT)
	background.mouse_filter = Control.MOUSE_FILTER_IGNORE
	root.add_child(background)

	var center := CenterContainer.new()
	center.set_anchors_preset(Control.PRESET_FULL_RECT)
	center.mouse_filter = Control.MOUSE_FILTER_IGNORE
	root.add_child(center)

	var column := VBoxContainer.new()
	column.add_theme_constant_override("separation", 14)
	center.add_child(column)

	var title := Label.new()
	title.text = "Loading"
	title.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	title.add_theme_font_size_override("font_size", 44)
	column.add_child(title)

	bar = ProgressBar.new()
	bar.custom_minimum_size = Vector2(BAR_WIDTH, 14.0)
	bar.show_percentage = false
	column.add_child(bar)

	_status_label = Label.new()
	_status_label.text = status
	_status_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	_status_label.modulate = Color(1, 1, 1, 0.7)
	column.add_child(_status_label)

	spinner = Control.new()
	spinner.mouse_filter = Control.MOUSE_FILTER_IGNORE
	spinner.set_anchors_preset(Control.PRESET_BOTTOM_RIGHT)
	spinner.offset_left = -(SPINNER_SIZE + SPINNER_MARGIN)
	spinner.offset_top = -(SPINNER_SIZE + SPINNER_MARGIN)
	spinner.offset_right = -SPINNER_MARGIN
	spinner.offset_bottom = -SPINNER_MARGIN
	spinner.pivot_offset = Vector2.ONE * SPINNER_SIZE / 2.0
	root.add_child(spinner)
