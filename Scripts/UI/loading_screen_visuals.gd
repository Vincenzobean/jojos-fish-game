# Animates the loading screen (loading_screen.gd, its parent): fades it in and out, spins the
# spinner, and eases the progress bar toward the screen's `progress` so jumps between load steps
# read as smooth movement. Purely presentation; the loading screen only waits on the signals below.
# Generated by Claude Code.
extends Node

## The screen now fully covers the game.
signal faded_in
## The screen is fully transparent.
signal faded_out

@export var fade_in_time := 0.25
@export var fade_out_time := 0.4
@export var spin_speed := 5.0 # Radians per second.
@export var bar_smoothing := 8.0 # Higher catches up to the real progress faster.
@export var spinner_color := Color(0.6, 0.9, 1.0)
@export var spinner_width := 4.0

@onready var screen: CanvasLayer = get_parent()

var _tween: Tween


func _ready() -> void:
	if not screen.is_node_ready():
		await screen.ready
	screen.opening.connect(_on_opening)
	screen.closing.connect(_on_closing)
	screen.spinner.draw.connect(_draw_spinner)
	screen.root.modulate.a = 0.0


func _process(delta: float) -> void:
	if not screen.visible:
		return
	screen.spinner.rotation += spin_speed * delta
	var target: float = screen.progress * screen.bar.max_value
	screen.bar.value = lerpf(screen.bar.value, target, 1.0 - exp(-bar_smoothing * delta))


func _on_opening(instant: bool) -> void:
	screen.bar.value = 0.0
	_fade_to(1.0, 0.0 if instant else fade_in_time, faded_in)


func _on_closing() -> void:
	screen.bar.value = screen.bar.max_value
	_fade_to(0.0, fade_out_time, faded_out)


# The loading screen awaits `done` right after emitting, so it is always emitted from a later frame.
func _fade_to(alpha: float, duration: float, done: Signal) -> void:
	if _tween:
		_tween.kill()
	_tween = create_tween()
	_tween.tween_property(screen.root, "modulate:a", alpha, duration)
	_tween.tween_callback(done.emit)


func _draw_spinner() -> void:
	var spinner: Control = screen.spinner
	var radius := spinner.size.x * 0.5 - spinner_width
	spinner.draw_arc(spinner.size / 2.0, radius, 0.0, TAU * 0.7, 32, spinner_color, spinner_width, true)
