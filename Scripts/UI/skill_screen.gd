# The skill screen: the skills action (K) opens the skill trees (skill_tree.gd), with progress from the
# Skills autoload. A tab for the player's own tree and one per kind of stand held (inventory.gd); it
# opens on the stand being controlled, if any.
#
# Drawn over a starry night sky. Each branch of the tree grows upward from a large hexagon at its foot,
# with the branch's name under it, in the branch's colour. Its skills are hexagons with an icon (drawn
# in code, draw_icon()) joined by lines to what they need: learned skills are filled with the branch's
# colour and their lines lit, skills that can be learned now pulse with a glowing rim, and the rest are
# dark and dim. Pips under a skill show its ranks. Hovering a skill lifts it and shows what it does in
# the card on the right (and why it can't be learned yet); clicking learns its next rank. A bar along
# the bottom lists the keys. Skill points come from one shared pool (Skills), spendable in any tree; the
# header shows it and its XP toward the next point, and a stand's tab also its catch-up XP bonus and how
# well opponents know it (StandMemory).
# While open the game is paused and the cursor is free; K or Escape closes it. It doesn't open during a
# finisher or while the game is paused or the player is frozen (the title screen).
# Generated by Claude Code.
class_name SkillScreen
extends CanvasLayer

const SKY_TOP := Color(0.02, 0.04, 0.09)
const SKY_BOTTOM := Color(0.05, 0.1, 0.17)
const TEXT := Color(0.9, 0.92, 0.95)
const DIM := Color(0.45, 0.5, 0.58)
const LOCKED_FILL := Color(0.09, 0.11, 0.15)
const LOCKED_EDGE := Color(0.3, 0.34, 0.4)
const GOLD := Color(0.98, 0.8, 0.35)
const COLUMN := 112.0 # Pixels between branch columns...
const ROW := 96.0 # ...and between rows of skills.
const HEX := 30.0 # A skill's radius...
const ROOT_HEX := 42.0 # ...and a branch root's.

@export var inventory: Node # inventory.gd
@export var possession: Node # possession.gd

var _key := Skills.PLAYER # The tree shown.
var _tabs: HBoxContainer
var _points: Label
var _progress: Label # A stand's XP, catch-up bonus and familiarity, under the points.
var _board: Control # The tree: lines and roots drawn on it, skills on top.
var _cards := {} # Node id -> SkillHex.
var _card: PanelContainer
var _info_branch: Label
var _info_title: Label
var _info_pips: Control
var _info_text: Label
var _info_status: Label
var _hovered: StringName = &""
var _time := 0.0
var _mouse_mode_before := Input.MOUSE_MODE_CAPTURED


func _ready() -> void:
	_build_ui()
	visible = false
	Skills.changed.connect(func(_key_changed: String) -> void:
		if visible:
			_refresh())


func is_open() -> bool:
	return visible


## Opens on the controlled stand's tree, or the player's.
func open() -> void:
	if visible or get_tree().paused or not get_parent().can_process() or possession.is_in_finisher():
		return
	var stand: Node3D = possession.get_possessed()
	_key = stand.scene_file_path if stand else Skills.PLAYER
	_hovered = &""
	_refresh()
	visible = true
	get_tree().paused = true
	_mouse_mode_before = Input.mouse_mode
	Input.mouse_mode = Input.MOUSE_MODE_VISIBLE


func close() -> void:
	if not visible:
		return
	visible = false
	get_tree().paused = false
	Input.mouse_mode = _mouse_mode_before


## Shows the tree `key` ("player", or a stand kind's scene path).
func show_tree(key: String) -> void:
	_key = key
	_hovered = &""
	_refresh()


func _unhandled_input(event: InputEvent) -> void:
	if not visible and event.is_action_pressed("skills"):
		get_viewport().set_input_as_handled()
		open()


# While open, K and Escape are taken here, before the pause menu can see Escape.
func _input(event: InputEvent) -> void:
	if visible and (event.is_action_pressed("skills") or event.is_action_pressed("pause")):
		get_viewport().set_input_as_handled()
		close()


func _process(delta: float) -> void:
	if not visible:
		return
	_time += delta
	for hex: SkillHex in _cards.values():
		hex.time = _time
		hex.queue_redraw()


func _learn(id: StringName) -> void:
	Skills.buy(_key, id) # Refreshes through Skills.changed.
	_hovered = id
	_show_info()


func _hover(id: StringName) -> void:
	_hovered = id
	_show_info()


# The trees there are tabs for: the player's, then each summonable kind of stand held.
func _tree_keys() -> Array[String]:
	var keys: Array[String] = [Skills.PLAYER]
	for path: String in inventory.kinds():
		if inventory.is_summonable(path) and Skills.tree_for(path) != null:
			keys.append(path)
	return keys


func _refresh() -> void:
	var keys := _tree_keys()
	if _key not in keys:
		_key = Skills.PLAYER
	for child in _tabs.get_children():
		_tabs.remove_child(child)
		child.queue_free()
	for key in keys:
		_tabs.add_child(_make_tab("Player" if key == Skills.PLAYER else inventory.display_name(key), key))
	var points := Skills.points()
	_points.text = "%d  SKILL POINT%s" % [points, "" if points == 1 else "S"]
	# The shared pool's XP toward its next point; on a stand's tab, its catch-up bonus and how well
	# opponents know it.
	var text := "LV %d    XP %d / %d    STANDS +%d%% HEALTH, +%d%% DAMAGE" % [Skills.level(), Skills.xp(), Skills.xp_to_next(),
		roundi(Skills.level_bonus("max_health") * 100.0), roundi(Skills.level_bonus("damage") * 100.0)]
	if _key != Skills.PLAYER:
		text += "    KNOWN TO ENEMIES %d%%" % roundi(StandMemory.familiarity(_key) * 100.0)
		var catch_up := Skills.catch_up_multiplier(_key)
		if catch_up > 1.01:
			text += "    CATCH-UP x%.1f XP" % catch_up
	_progress.text = text

	for child in _board.get_children():
		_board.remove_child(child)
		child.queue_free()
	_cards.clear()
	var tree := Skills.tree_for(_key)
	var columns := 1.0
	var rows := 1.0
	for node in tree.nodes:
		columns = maxf(columns, node.cell.x + 1.0)
		rows = maxf(rows, node.cell.y + 1.0)
	_board.custom_minimum_size = Vector2(columns * COLUMN, ROOT_HEX * 2.0 + 60.0 + rows * ROW + 20.0)
	for node in tree.nodes:
		var hex := SkillHex.new()
		var branch := tree.branch_at(node.cell.x)
		hex.color = branch.get("color", GOLD)
		hex.icon = node.icon
		hex.rank = Skills.rank(_key, node.id)
		hex.max_rank = node.max_rank
		hex.buyable = Skills.can_buy(_key, node.id)
		hex.size = Vector2.ONE * HEX * 2.6
		hex.position = _node_center(node) - hex.size * 0.5
		hex.pressed.connect(_learn.bind(node.id))
		hex.hovered.connect(_hover.bind(node.id))
		_board.add_child(hex)
		_cards[node.id] = hex
	_board.queue_redraw()
	_show_info()


func _make_tab(text: String, key: String) -> Button:
	var tab := Button.new()
	tab.text = text.to_upper()
	tab.flat = true
	tab.focus_mode = Control.FOCUS_NONE
	tab.add_theme_font_size_override("font_size", 20 if key == _key else 17)
	var color := GOLD if key == _key else DIM
	for state in ["font_color", "font_pressed_color", "font_focus_color"]:
		tab.add_theme_color_override(state, color)
	tab.add_theme_color_override("font_hover_color", TEXT)
	tab.pressed.connect(show_tree.bind(key))
	if key == _key: # Underlined.
		tab.draw.connect(func() -> void:
			tab.draw_line(Vector2(6.0, tab.size.y - 2.0), Vector2(tab.size.x - 6.0, tab.size.y - 2.0), GOLD, 2.0))
	return tab


# Where a skill sits on the board: its column across, its row up from its branch's root.
func _node_center(node: SkillNode) -> Vector2:
	return Vector2((node.cell.x + 0.5) * COLUMN, _root_y() - ROOT_HEX - 56.0 - node.cell.y * ROW)


func _root_y() -> float:
	return _board.custom_minimum_size.y - ROOT_HEX - 30.0


func _branch_center(branch: Dictionary) -> Vector2:
	return Vector2((float(branch["from"]) + float(branch["to"])) * 0.5 * COLUMN + COLUMN * 0.5, _root_y())


# The lines (lit once what they lead from is learned), then each branch's root and name.
func _draw_board() -> void:
	var tree := Skills.tree_for(_key)
	if tree == null:
		return
	for node in tree.nodes:
		var to := _node_center(node) + Vector2(0.0, HEX)
		var branch := tree.branch_at(node.cell.x)
		var color: Color = branch.get("color", GOLD)
		if node.requires.is_empty():
			var root := _branch_center(branch) - Vector2(0.0, ROOT_HEX)
			_draw_link(root, to, color, true)
		for need in node.requires:
			var from := tree.get_node_by_id(need)
			if from:
				_draw_link(_node_center(from) - Vector2(0.0, HEX), to, color, Skills.rank(_key, need) > 0)
	var font := ThemeDB.fallback_font
	for branch in tree.branches:
		var center := _branch_center(branch)
		var color: Color = branch["color"]
		_draw_hex(_board, center, ROOT_HEX + 8.0, Color(color, 0.12), Color.TRANSPARENT, 0.0)
		_draw_hex(_board, center, ROOT_HEX, color.darkened(0.45), color.lightened(0.25), 3.0)
		_draw_hex(_board, center, ROOT_HEX - 7.0, Color.TRANSPARENT, Color(color.lightened(0.4), 0.5), 1.5)
		draw_icon(_board, branch["icon"], center, ROOT_HEX * 0.5, TEXT)
		var label := String(branch["name"]).to_upper()
		var width := font.get_string_size(label, HORIZONTAL_ALIGNMENT_LEFT, -1, 18).x
		_board.draw_string(font, center + Vector2(-width * 0.5, ROOT_HEX + 26.0), label, HORIZONTAL_ALIGNMENT_LEFT, -1, 18, color.lightened(0.3))


# A line from `from` up to `to`: straight, or up, across and up again. Lit (with a glow) or dim.
func _draw_link(from: Vector2, to: Vector2, color: Color, lit: bool) -> void:
	var points := PackedVector2Array([from, to])
	if absf(from.x - to.x) > 1.0:
		var middle := (from.y + to.y) * 0.5
		points = PackedVector2Array([from, Vector2(from.x, middle), Vector2(to.x, middle), to])
	if lit:
		_board.draw_polyline(points, Color(color, 0.25), 9.0)
		_board.draw_polyline(points, color.lightened(0.2), 3.0)
	else:
		_board.draw_polyline(points, Color(LOCKED_EDGE, 0.8), 2.0)


# What the hovered skill does, its ranks and cost, and why it can't be learned yet.
func _show_info() -> void:
	var tree := Skills.tree_for(_key)
	var node := tree.get_node_by_id(_hovered) if tree and _hovered != &"" else null
	var color: Color = tree.branch_at(node.cell.x).get("color", GOLD) if node else GOLD
	var bar := _card.get_theme_stylebox("panel") as StyleBoxFlat
	bar.border_color = color
	_info_branch.add_theme_color_override("font_color", color.lightened(0.2))
	if node == null:
		_info_branch.text = (tree.title if tree else "").to_upper()
		_info_title.text = "Skills"
		_info_pips.set_meta("ranks", Vector2i.ZERO)
		_info_text.text = "Hover a skill to see what it does. Click one to learn it.\n\nLearned skills glow in their branch's colour; ones you can learn now pulse."
		_info_status.text = ""
		_info_pips.queue_redraw()
		return
	var rank := Skills.rank(_key, node.id)
	_info_branch.text = String(tree.branch_at(node.cell.x).get("name", "")).to_upper()
	_info_title.text = node.title
	_info_pips.set_meta("ranks", Vector2i(rank, node.max_rank))
	_info_pips.set_meta("color", color)
	_info_pips.queue_redraw()
	_info_text.text = node.description
	var why := Skills.why_not(_key, node.id)
	if why == "":
		_info_status.text = "Learn: %d point%s" % [node.cost, "" if node.cost == 1 else "s"]
		_info_status.add_theme_color_override("font_color", GOLD)
	else:
		_info_status.text = why
		_info_status.add_theme_color_override("font_color", DIM if why != "Maxed" else color.lightened(0.3))


func _build_ui() -> void:
	layer = 41
	process_mode = Node.PROCESS_MODE_ALWAYS

	var sky := Control.new()
	sky.set_anchors_preset(Control.PRESET_FULL_RECT)
	sky.mouse_filter = Control.MOUSE_FILTER_STOP # Nothing behind it is clickable.
	sky.draw.connect(_draw_sky.bind(sky))
	sky.resized.connect(sky.queue_redraw)
	add_child(sky)

	var frame := MarginContainer.new()
	frame.set_anchors_preset(Control.PRESET_FULL_RECT)
	for side in ["left", "right", "top", "bottom"]:
		frame.add_theme_constant_override("margin_" + side, 32 if side in ["left", "right"] else 18)
	add_child(frame)
	var column := VBoxContainer.new()
	column.add_theme_constant_override("separation", 10)
	frame.add_child(column)

	# Header: title, tabs, points.
	var top := HBoxContainer.new()
	top.add_theme_constant_override("separation", 22)
	column.add_child(top)
	top.add_child(_label("SKILL TREES", 30, TEXT))
	_tabs = HBoxContainer.new()
	_tabs.add_theme_constant_override("separation", 6)
	_tabs.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	top.add_child(_tabs)
	_points = _label("", 20, GOLD)
	top.add_child(_points)
	_progress = _label("", 15, GOLD)
	_progress.horizontal_alignment = HORIZONTAL_ALIGNMENT_RIGHT
	column.add_child(_progress)
	var rule := ColorRect.new()
	rule.color = Color(TEXT, 0.18)
	rule.custom_minimum_size = Vector2(0.0, 1.0)
	column.add_child(rule)

	# The tree, centred, with the card on the right.
	var body := HBoxContainer.new()
	body.add_theme_constant_override("separation", 20)
	body.size_flags_vertical = Control.SIZE_EXPAND_FILL
	column.add_child(body)
	var scroll := ScrollContainer.new()
	scroll.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	scroll.size_flags_vertical = Control.SIZE_EXPAND_FILL
	body.add_child(scroll)
	var center := CenterContainer.new()
	center.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	center.size_flags_vertical = Control.SIZE_EXPAND_FILL
	scroll.add_child(center)
	_board = Control.new()
	_board.draw.connect(_draw_board)
	center.add_child(_board)

	_card = PanelContainer.new()
	_card.custom_minimum_size = Vector2(250.0, 0.0)
	_card.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	var card_style := StyleBoxFlat.new()
	card_style.bg_color = Color(0.04, 0.06, 0.1, 0.92)
	card_style.border_color = GOLD
	card_style.border_width_top = 5
	card_style.border_width_left = 1
	card_style.border_width_right = 1
	card_style.border_width_bottom = 1
	card_style.set_corner_radius_all(4)
	card_style.set_content_margin_all(16.0)
	_card.add_theme_stylebox_override("panel", card_style)
	body.add_child(_card)
	var info := VBoxContainer.new()
	info.add_theme_constant_override("separation", 8)
	_card.add_child(info)
	_info_branch = _label("", 13, GOLD)
	info.add_child(_info_branch)
	_info_title = _label("", 24, TEXT)
	_info_title.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	info.add_child(_info_title)
	_info_pips = Control.new()
	_info_pips.custom_minimum_size = Vector2(0.0, 16.0)
	_info_pips.draw.connect(_draw_pips)
	info.add_child(_info_pips)
	_info_text = _label("", 16, Color(TEXT, 0.85))
	_info_text.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	_info_text.custom_minimum_size = Vector2(218.0, 0.0)
	info.add_child(_info_text)
	_info_status = _label("", 17, GOLD)
	info.add_child(_info_status)

	# Key hints.
	var hints := HBoxContainer.new()
	hints.add_theme_constant_override("separation", 26)
	hints.alignment = BoxContainer.ALIGNMENT_CENTER
	column.add_child(hints)
	for pair in [["LMB", "Learn skill"], ["K", "Close"], ["Esc", "Back"]]:
		var hint := HBoxContainer.new()
		hint.add_theme_constant_override("separation", 8)
		var key := PanelContainer.new()
		var key_style := StyleBoxFlat.new()
		key_style.bg_color = Color(TEXT, 0.12)
		key_style.border_color = Color(TEXT, 0.5)
		key_style.set_border_width_all(1)
		key_style.set_corner_radius_all(4)
		key_style.content_margin_left = 7.0
		key_style.content_margin_right = 7.0
		key.add_theme_stylebox_override("panel", key_style)
		key.add_child(_label(pair[0], 13, TEXT))
		hint.add_child(key)
		hint.add_child(_label(pair[1], 15, DIM.lightened(0.2)))
		hints.add_child(hint)


# The night sky behind it all: a deep gradient, faint coloured haze and a field of stars.
func _draw_sky(sky: Control) -> void:
	var size := sky.size
	sky.draw_polygon(PackedVector2Array([Vector2.ZERO, Vector2(size.x, 0.0), size, Vector2(0.0, size.y)]),
		PackedColorArray([SKY_TOP, SKY_TOP, SKY_BOTTOM, SKY_BOTTOM]))
	var random := RandomNumberGenerator.new()
	random.seed = 7
	for haze in [[Vector2(0.25, 0.55), Color(0.2, 0.35, 0.6)], [Vector2(0.62, 0.4), Color(0.35, 0.2, 0.5)], [Vector2(0.45, 0.8), Color(0.15, 0.45, 0.5)]]:
		var middle: Vector2 = haze[0] * size
		for i in 6:
			sky.draw_circle(middle + Vector2(random.randf_range(-80, 80), random.randf_range(-50, 50)), random.randf_range(90.0, 200.0), Color(haze[1], 0.035))
	for i in 220:
		var at := Vector2(random.randf() * size.x, random.randf() * size.y)
		var bright := random.randf_range(0.25, 1.0)
		sky.draw_circle(at, 0.6 + bright * 0.9, Color(1.0, 1.0, 1.0, bright * 0.7))


# The hovered skill's ranks as little hexagons, filled for each one learned.
func _draw_pips() -> void:
	var ranks: Vector2i = _info_pips.get_meta("ranks", Vector2i.ZERO)
	var color: Color = _info_pips.get_meta("color", GOLD)
	for i in ranks.y:
		var center := Vector2(8.0 + i * 20.0, 8.0)
		_draw_hex(_info_pips, center, 7.0, color if i < ranks.x else Color(LOCKED_FILL, 0.8), color.lightened(0.3) if i < ranks.x else LOCKED_EDGE, 1.5)


func _label(text: String, font_size: int, color: Color) -> Label:
	var label := Label.new()
	label.text = text
	label.add_theme_font_size_override("font_size", font_size)
	label.add_theme_color_override("font_color", color)
	return label


## Draws a hexagon (point up) on `canvas`: filled with `fill`, edged with `edge` `width` wide (0 for none).
static func _draw_hex(canvas: CanvasItem, center: Vector2, radius: float, fill: Color, edge: Color, width: float) -> void:
	var points := PackedVector2Array()
	for i in 6:
		var angle := TAU * i / 6.0 - PI * 0.5
		points.append(center + Vector2(cos(angle), sin(angle)) * radius)
	if fill.a > 0.0:
		canvas.draw_colored_polygon(points, fill)
	if width > 0.0 and edge.a > 0.0:
		points.append(points[0])
		canvas.draw_polyline(points, edge, width, true)


## Draws the icon called `icon` on `canvas`, centred on `c`, about `s` from the centre to its edge.
static func draw_icon(canvas: CanvasItem, icon: StringName, c: Vector2, s: float, color: Color) -> void:
	var w := maxf(s * 0.16, 1.5)
	match icon:
		&"heart":
			var heart := PackedVector2Array()
			for i in 32:
				var t := TAU * i / 32.0
				heart.append(c + Vector2(16.0 * pow(sin(t), 3.0), -(13.0 * cos(t) - 5.0 * cos(2.0 * t) - 2.0 * cos(3.0 * t) - cos(4.0 * t))) * s / 17.0)
			canvas.draw_colored_polygon(heart, color)
		&"bolt":
			canvas.draw_colored_polygon(_shape(c, s, [[0.2, -1.0], [-0.5, 0.1], [-0.05, 0.1], [-0.25, 1.0], [0.5, -0.2], [0.05, -0.2]]), color)
		&"fist":
			canvas.draw_rect(Rect2(c + Vector2(-0.7, -0.55) * s, Vector2(1.4, 1.1) * s), color)
			for i in 3:
				canvas.draw_line(c + Vector2(-0.7 + 0.45 * (i + 1), -0.55) * s, c + Vector2(-0.7 + 0.45 * (i + 1), -0.1) * s, Color(0, 0, 0, 0.5), w)
			canvas.draw_rect(Rect2(c + Vector2(-0.55, 0.55) * s, Vector2(1.1, 0.35) * s), color)
		&"burst":
			var star := PackedVector2Array()
			for i in 16:
				var angle := TAU * i / 16.0
				star.append(c + Vector2(cos(angle), sin(angle)) * s * (1.0 if i % 2 == 0 else 0.45))
			canvas.draw_colored_polygon(star, color)
		&"speed":
			for i in 3:
				var x := -0.8 + i * 0.6
				canvas.draw_polyline(PackedVector2Array([c + Vector2(x, -0.6) * s, c + Vector2(x + 0.5, 0.0) * s, c + Vector2(x, 0.6) * s]), color, w * 1.3)
		&"dash":
			canvas.draw_colored_polygon(_shape(c, s, [[0.2, -0.6], [0.9, 0.0], [0.2, 0.6]]), color)
			for i in 3:
				canvas.draw_line(c + Vector2(-0.9, -0.45 + 0.45 * i) * s, c + Vector2(0.1, -0.45 + 0.45 * i) * s, color, w)
		&"rush":
			canvas.draw_rect(Rect2(c + Vector2(0.05, -0.45) * s, Vector2(0.85, 0.9) * s), color)
			for i in 3:
				canvas.draw_line(c + Vector2(-0.95 + 0.15 * i, -0.4 + 0.4 * i) * s, c + Vector2(-0.1, -0.4 + 0.4 * i) * s, color, w)
		&"range":
			canvas.draw_arc(c, s * 0.9, 0.0, TAU, 28, color, w)
			canvas.draw_arc(c, s * 0.5, 0.0, TAU, 20, color, w)
			canvas.draw_circle(c, s * 0.15, color)
		&"shield":
			canvas.draw_colored_polygon(_shape(c, s, [[0.0, -0.95], [0.8, -0.6], [0.7, 0.2], [0.0, 0.95], [-0.7, 0.2], [-0.8, -0.6]]), color)
		&"counter":
			canvas.draw_polyline(_shape(c, s, [[0.0, -0.95], [0.8, -0.6], [0.7, 0.2], [0.0, 0.95], [-0.7, 0.2], [-0.8, -0.6], [0.0, -0.95]]), color, w)
			canvas.draw_arc(c + Vector2(0.0, 0.05) * s, s * 0.4, PI * 0.9, PI * 2.4, 14, color, w)
			canvas.draw_colored_polygon(_shape(c, s, [[0.38, -0.45], [0.62, -0.05], [0.15, -0.05]]), color)
		&"wave":
			for row in 2:
				var line := PackedVector2Array()
				for i in 13:
					var x := -1.0 + i / 6.0
					line.append(c + Vector2(x, -0.25 + row * 0.55 + 0.22 * sin(x * PI * 1.5)) * s)
				canvas.draw_polyline(line, color, w * 1.3)
		&"up":
			canvas.draw_colored_polygon(_shape(c, s, [[0.0, -0.95], [0.75, -0.15], [0.25, -0.15], [0.25, 0.9], [-0.25, 0.9], [-0.25, -0.15], [-0.75, -0.15]]), color)
		&"bow":
			canvas.draw_arc(c + Vector2(-0.35, 0.0) * s, s * 0.95, -PI * 0.42, PI * 0.42, 16, color, w * 1.3)
			canvas.draw_line(c + Vector2(-0.06, -0.87) * s, c + Vector2(-0.06, 0.87) * s, color, w * 0.7)
			canvas.draw_line(c + Vector2(-0.9, 0.0) * s, c + Vector2(0.9, 0.0) * s, color, w)
			canvas.draw_colored_polygon(_shape(c, s, [[0.95, 0.0], [0.6, -0.22], [0.6, 0.22]]), color)
		&"reel":
			canvas.draw_arc(c, s * 0.75, 0.0, TAU, 24, color, w * 1.3)
			for i in 3:
				var angle := TAU * i / 3.0
				canvas.draw_line(c, c + Vector2(cos(angle), sin(angle)) * s * 0.75, color, w)
			canvas.draw_line(c + Vector2(0.75, 0.0) * s, c + Vector2(1.0, 0.5) * s, color, w * 1.3)
		&"arrow":
			canvas.draw_line(c + Vector2(-0.8, 0.8) * s, c + Vector2(0.6, -0.6) * s, color, w * 1.2)
			canvas.draw_colored_polygon(_shape(c, s, [[0.9, -0.9], [0.25, -0.65], [0.65, -0.25]]), color)
			canvas.draw_line(c + Vector2(-0.8, 0.8) * s, c + Vector2(-0.8, 0.4) * s, color, w)
			canvas.draw_line(c + Vector2(-0.8, 0.8) * s, c + Vector2(-0.4, 0.8) * s, color, w)
		&"bond":
			canvas.draw_arc(c + Vector2(-0.3, 0.0) * s, s * 0.55, 0.0, TAU, 20, color, w * 1.3)
			canvas.draw_arc(c + Vector2(0.3, 0.0) * s, s * 0.55, 0.0, TAU, 20, color, w * 1.3)
		&"spark":
			canvas.draw_colored_polygon(_shape(c, s, [[0.0, -1.0], [0.22, -0.22], [1.0, 0.0], [0.22, 0.22], [0.0, 1.0], [-0.22, 0.22], [-1.0, 0.0], [-0.22, -0.22]]), color)
		&"clock":
			canvas.draw_arc(c, s * 0.85, 0.0, TAU, 28, color, w * 1.2)
			canvas.draw_line(c, c + Vector2(0.0, -0.6) * s, color, w)
			canvas.draw_line(c, c + Vector2(0.45, 0.2) * s, color, w)
		&"puffer":
			for i in 12:
				var angle := TAU * i / 12.0
				canvas.draw_line(c + Vector2(cos(angle), sin(angle)) * s * 0.55, c + Vector2(cos(angle), sin(angle)) * s * 0.95, color, w)
			canvas.draw_circle(c, s * 0.6, color)
			canvas.draw_circle(c + Vector2(0.22, -0.12) * s, s * 0.12, Color(0, 0, 0, 0.6))
		&"blowhole":
			canvas.draw_arc(c + Vector2(0.0, 0.9) * s, s * 0.75, PI, TAU, 18, color, w * 1.3)
			for i in 3:
				var x := -0.45 + i * 0.45
				canvas.draw_line(c + Vector2(x * 0.3, 0.1) * s, c + Vector2(x, -0.55) * s, color, w)
			canvas.draw_circle(c + Vector2(0.0, -0.8) * s, s * 0.15, color)
		&"school": # Three little fish, swimming together.
			for fish: Vector2 in [Vector2(-0.35, -0.45), Vector2(0.3, -0.05), Vector2(-0.25, 0.5)]:
				var at := c + fish * s
				canvas.draw_colored_polygon(_shape(at, s, [[-0.45, 0.0], [0.0, -0.17], [0.3, 0.0], [0.0, 0.17]]), color)
				canvas.draw_colored_polygon(_shape(at, s, [[0.25, 0.0], [0.5, -0.18], [0.5, 0.18]]), color)
		&"ink": # A droplet.
			var drop := PackedVector2Array()
			for i in 20:
				var t := TAU * i / 20.0
				drop.append(c + Vector2(0.62 * sin(t) * (1.0 - cos(t)) * 0.75, -cos(t) * 0.95) * s)
			canvas.draw_colored_polygon(drop, color)
		_: # A star.
			var star := PackedVector2Array()
			for i in 10:
				var angle := TAU * i / 10.0 - PI * 0.5
				star.append(c + Vector2(cos(angle), sin(angle)) * s * (1.0 if i % 2 == 0 else 0.42))
			canvas.draw_colored_polygon(star, color)


# `points` (in units of `s`, about `c`) as a polygon.
static func _shape(c: Vector2, s: float, points: Array) -> PackedVector2Array:
	var shape := PackedVector2Array()
	for p: Array in points:
		shape.append(c + Vector2(p[0], p[1]) * s)
	return shape


## One skill on the board: a hexagon with its icon and rank pips, in its branch's colour. Learned, it's
## filled; learnable now, its rim pulses with a glow; otherwise it's dark. It lifts while hovered.
class SkillHex:
	extends Control

	signal pressed
	signal hovered

	var color := GOLD
	var icon: StringName = &"star"
	var rank := 0
	var max_rank := 1
	var buyable := false
	var time := 0.0
	var _hover := false

	func _init() -> void:
		mouse_filter = Control.MOUSE_FILTER_STOP
		mouse_default_cursor_shape = Control.CURSOR_POINTING_HAND
		mouse_entered.connect(func() -> void:
			_hover = true
			hovered.emit()
			queue_redraw())
		mouse_exited.connect(func() -> void:
			_hover = false
			queue_redraw())

	func _gui_input(event: InputEvent) -> void:
		if event is InputEventMouseButton and event.pressed and event.button_index == MOUSE_BUTTON_LEFT:
			accept_event()
			pressed.emit()

	func _draw() -> void:
		var center := size * 0.5
		var radius := HEX * (1.1 if _hover else 1.0)
		var learned := rank > 0
		if buyable: # A pulsing glow round the rim.
			var pulse := 0.5 + 0.5 * sin(time * 4.0)
			SkillScreen._draw_hex(self, center, radius + 6.0 + 3.0 * pulse, Color(color, 0.15 + 0.2 * pulse), Color.TRANSPARENT, 0.0)
		if learned:
			SkillScreen._draw_hex(self, center, radius + 5.0, Color(color, 0.18), Color.TRANSPARENT, 0.0)
		var fill := color.darkened(0.25) if learned else (Color(0.07, 0.09, 0.13) if buyable else LOCKED_FILL)
		var edge := color.lightened(0.35) if learned or buyable else LOCKED_EDGE
		SkillScreen._draw_hex(self, center, radius, fill, edge, 3.0 if learned or buyable else 2.0)
		SkillScreen._draw_hex(self, center, radius - 5.0, Color.TRANSPARENT, Color(edge, 0.35), 1.0)
		var icon_color := TEXT if learned else (color.lightened(0.3) if buyable else LOCKED_EDGE.lightened(0.15))
		SkillScreen.draw_icon(self, icon, center, radius * 0.48, icon_color)
		if max_rank > 1: # Rank pips under it.
			for i in max_rank:
				var at := center + Vector2((i - (max_rank - 1) * 0.5) * 11.0, radius + 9.0)
				draw_circle(at, 3.5, color.lightened(0.3) if i < rank else Color(LOCKED_EDGE, 0.9))
