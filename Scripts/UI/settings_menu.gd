# The settings menu, shared by the title screen and the pause menu: tabs for Audio, Controls,
# Display and Graphics, built in code from one-line row helpers. Every control writes straight
# through Settings.set_value() and re-reads its value whenever Settings reports a change, so a
# quality preset updating the graphics options (or a keybind reset) shows up immediately.
#
# Rebinding: click an action's button, then press a key or mouse button for it; Escape cancels.
# Escape (the pause action) is never bindable, since it opens and closes the menus.
# Whoever opens the menu listens for `closed` (Back or Escape) and frees it.
# Generated by Claude Code.
extends Control

## Back or Escape was pressed; the menu should be closed.
signal closed

const PANEL_SIZE := Vector2(780.0, 560.0)
const CONTROL_WIDTH := 260.0
const VALUE_WIDTH := 64.0

const WINDOW_MODE_NAMES := ["Windowed", "Borderless Fullscreen", "Exclusive Fullscreen"]
const MAX_FPS_NAMES := ["30", "60", "120", "144", "Unlimited"] # Matches Settings.MAX_FPS_CHOICES.
const QUALITY_NAMES := ["Low", "Medium", "High", "Custom"] # Matches Settings.Quality.
const UPSCALER_NAMES := ["Bilinear", "AMD FSR 1.0", "AMD FSR 2.2"] # Matches Settings.UPSCALERS.
const ANTI_ALIASING_NAMES := ["Off", "FXAA", "MSAA 2x", "MSAA 4x", "TAA"] # Matches Settings.AntiAliasing.
const SHADOW_NAMES := ["Off", "Low", "High"] # Matches Settings.Shadows.
const ACTION_NAMES := {
	&"move_up": "Move Forward",
	&"move_down": "Move Back",
	&"move_left": "Move Left",
	&"move_right": "Move Right",
	&"jump": "Jump / Swim Up / Stand Rise",
	&"sprint": "Sprint / Stand Dash",
	&"fire": "Draw / Fire Bow",
	&"reel": "Reel In",
	&"summon": "Summon / Return Stand",
	&"descend": "Stand Descend",
	&"light_attack": "Stand Light Punch",
	&"heavy_attack": "Stand Heavy Punch",
	&"block": "Stand Block",
	&"stand_special": "Stand Special",
	&"stand_ultimate": "Stand Ultimate",
	&"challenge": "Challenge Stand User",
	&"inventory": "Inventory",
	&"skills": "Skill Trees",
}

var _refreshers := {} # "section/key" -> Callable that shows the setting's current value on its control.
var _keybind_buttons := {} # Action -> its rebind Button.
var _listening_action := &"" # The action waiting for a new key, or empty.
var _tabs: TabContainer


func _ready() -> void:
	set_anchors_preset(Control.PRESET_FULL_RECT)
	_build()
	Settings.changed.connect(_on_setting_changed)
	_tabs.get_tab_bar().grab_focus()


# Escape closes the menu (or cancels a rebind, which _input handles first).
func _unhandled_input(event: InputEvent) -> void:
	if event.is_action_pressed("pause"):
		get_viewport().set_input_as_handled()
		closed.emit()


# While waiting for a rebind, the next key or mouse button press is taken here, before any button
# or gameplay can react to it.
func _input(event: InputEvent) -> void:
	if _listening_action == &"":
		return
	var binding: InputEvent = null
	if event is InputEventKey and event.pressed and not event.echo:
		if event.keycode != KEY_ESCAPE:
			var key := InputEventKey.new()
			if event.physical_keycode != KEY_NONE:
				key.physical_keycode = event.physical_keycode
			else:
				key.keycode = event.keycode
			binding = key
	elif event is InputEventMouseButton and event.pressed and event.button_index not in [
			MOUSE_BUTTON_WHEEL_UP, MOUSE_BUTTON_WHEEL_DOWN, MOUSE_BUTTON_WHEEL_LEFT, MOUSE_BUTTON_WHEEL_RIGHT]:
		var button := InputEventMouseButton.new()
		button.button_index = event.button_index
		binding = button
	else:
		return

	get_viewport().set_input_as_handled()
	var action := _listening_action
	_listening_action = &""
	if binding:
		Settings.rebind(action, binding)
	_refresh_keybind(action)


func _build() -> void:
	var center := CenterContainer.new()
	center.set_anchors_preset(Control.PRESET_FULL_RECT)
	add_child(center)

	var panel := PanelContainer.new()
	panel.custom_minimum_size = PANEL_SIZE
	center.add_child(panel)

	var column := VBoxContainer.new()
	column.add_theme_constant_override("separation", 14)
	panel.add_child(column)

	var heading := Label.new()
	heading.text = "Settings"
	heading.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	heading.add_theme_font_size_override("font_size", 32)
	column.add_child(heading)

	_tabs = TabContainer.new()
	_tabs.size_flags_vertical = Control.SIZE_EXPAND_FILL
	column.add_child(_tabs)

	var audio := _add_tab("Audio")
	_add_slider(audio, "Master Volume", "audio", "master_volume", 0.0, 1.0, 0.01, _percent)
	_add_slider(audio, "Music Volume", "audio", "music_volume", 0.0, 1.0, 0.01, _percent)
	_add_slider(audio, "Sound Effects Volume", "audio", "sfx_volume", 0.0, 1.0, 0.01, _percent)
	_add_check(audio, "Mute Voices", "audio", "mute_voices")

	var controls := _add_tab("Controls")
	_add_slider(controls, "Mouse Sensitivity", "controls", "mouse_sensitivity", 0.1, 3.0, 0.05, _multiplier)
	_add_check(controls, "Invert Mouse Y", "controls", "invert_y")
	_add_heading(controls, "Key Bindings")
	for action in Settings.REBINDABLE_ACTIONS:
		_add_keybind(controls, action)
	var reset := Button.new()
	reset.text = "Reset Key Bindings"
	reset.size_flags_horizontal = Control.SIZE_SHRINK_END
	reset.pressed.connect(Settings.reset_keybinds)
	controls.add_child(reset)

	var display := _add_tab("Display")
	_add_option(display, "Window Mode", "display", "window_mode", WINDOW_MODE_NAMES)
	_add_check(display, "VSync", "display", "vsync")
	_add_option(display, "Max FPS", "display", "max_fps", MAX_FPS_NAMES)
	_add_slider(display, "Field of View", "display", "fov", 60.0, 110.0, 1.0, _degrees)

	var graphics := _add_tab("Graphics")
	_add_option(graphics, "Quality Preset", "graphics", "quality", QUALITY_NAMES)
	_add_slider(graphics, "Render Scale", "graphics", "render_scale", 0.5, 1.0, 0.05, _percent)
	_add_option(graphics, "Upscaler", "graphics", "upscaler", UPSCALER_NAMES)
	_add_option(graphics, "Anti-Aliasing", "graphics", "anti_aliasing", ANTI_ALIASING_NAMES)
	_add_option(graphics, "Shadows", "graphics", "shadows", SHADOW_NAMES)
	_add_check(graphics, "Ambient Occlusion (SSAO)", "graphics", "ssao")
	_add_check(graphics, "Glow", "graphics", "glow")

	var back := Button.new()
	back.text = "Back"
	back.custom_minimum_size.x = 160.0
	back.size_flags_horizontal = Control.SIZE_SHRINK_END
	back.pressed.connect(closed.emit)
	column.add_child(back)


# --- Row helpers ------------------------------------------------------------------------------

# A tab page: a scrolling column the rows go into. TabContainer names the tab after the child.
func _add_tab(title: String) -> VBoxContainer:
	var scroll := ScrollContainer.new()
	scroll.name = title
	scroll.horizontal_scroll_mode = ScrollContainer.SCROLL_MODE_DISABLED
	_tabs.add_child(scroll)
	var rows := VBoxContainer.new()
	rows.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	rows.add_theme_constant_override("separation", 10)
	scroll.add_child(rows)
	return rows


func _add_heading(parent: Control, text: String) -> void:
	var label := Label.new()
	label.text = text
	label.add_theme_font_size_override("font_size", 24)
	parent.add_child(label)


# A row with the setting's name on the left; the caller adds its controls to the returned box.
func _add_row(parent: Control, text: String) -> HBoxContainer:
	var row := HBoxContainer.new()
	row.add_theme_constant_override("separation", 12)
	parent.add_child(row)
	var label := Label.new()
	label.text = text
	label.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	row.add_child(label)
	return row


func _add_slider(parent: Control, text: String, section: String, key: String, min_value: float, max_value: float, step: float, format: Callable) -> void:
	var row := _add_row(parent, text)
	var slider := HSlider.new()
	slider.min_value = min_value
	slider.max_value = max_value
	slider.step = step
	slider.custom_minimum_size.x = CONTROL_WIDTH - VALUE_WIDTH
	slider.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	row.add_child(slider)
	var value_label := Label.new()
	value_label.custom_minimum_size.x = VALUE_WIDTH
	value_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_RIGHT
	row.add_child(value_label)

	slider.value_changed.connect(func(value: float) -> void:
		value_label.text = format.call(value)
		Settings.set_value(section, key, value))
	_register(section, key, func() -> void:
		var value: float = Settings.get_value(section, key)
		slider.set_value_no_signal(value)
		value_label.text = format.call(value))


func _add_option(parent: Control, text: String, section: String, key: String, choices: Array) -> void:
	var row := _add_row(parent, text)
	var option := OptionButton.new()
	option.custom_minimum_size.x = CONTROL_WIDTH
	for choice: String in choices:
		option.add_item(choice)
	row.add_child(option)

	option.item_selected.connect(func(index: int) -> void: Settings.set_value(section, key, index))
	_register(section, key, func() -> void: option.select(Settings.get_value(section, key)))


func _add_check(parent: Control, text: String, section: String, key: String) -> void:
	var row := _add_row(parent, text)
	var check := CheckButton.new()
	row.add_child(check)

	check.toggled.connect(func(on: bool) -> void: Settings.set_value(section, key, on))
	_register(section, key, func() -> void: check.set_pressed_no_signal(Settings.get_value(section, key)))


func _add_keybind(parent: Control, action: StringName) -> void:
	var row := _add_row(parent, ACTION_NAMES.get(action, String(action)))
	var button := Button.new()
	button.custom_minimum_size.x = CONTROL_WIDTH
	button.pressed.connect(_start_listening.bind(action))
	row.add_child(button)
	_keybind_buttons[action] = button
	_refresh_keybind(action)


func _register(section: String, key: String, refresh: Callable) -> void:
	_refreshers[section + "/" + key] = refresh
	refresh.call()


func _on_setting_changed(section: String, key: String) -> void:
	if section == Settings.KEYBINDS:
		if _keybind_buttons.has(StringName(key)):
			_refresh_keybind(StringName(key))
	elif _refreshers.has(section + "/" + key):
		_refreshers[section + "/" + key].call()


# --- Rebinding --------------------------------------------------------------------------------

func _start_listening(action: StringName) -> void:
	if _listening_action != &"":
		_refresh_keybind(_listening_action)
	_listening_action = action
	_keybind_buttons[action].text = "Press a key...  (Esc cancels)"


func _refresh_keybind(action: StringName) -> void:
	_keybind_buttons[action].text = _binding_name(Settings.get_binding(action))


static func _binding_name(event: InputEvent) -> String:
	if event is InputEventKey:
		var keycode: Key = event.keycode
		if event.physical_keycode != KEY_NONE:
			# Show the key that's printed on this keyboard layout at that position (the headless
			# display server can't tell, so it gets the US layout name).
			keycode = event.physical_keycode
			if DisplayServer.get_name() != "headless":
				keycode = DisplayServer.keyboard_get_keycode_from_physical(event.physical_keycode)
		return OS.get_keycode_string(keycode)
	if event is InputEventMouseButton:
		match event.button_index:
			MOUSE_BUTTON_LEFT:
				return "Left Mouse"
			MOUSE_BUTTON_RIGHT:
				return "Right Mouse"
			MOUSE_BUTTON_MIDDLE:
				return "Middle Mouse"
			_:
				return "Mouse Button %d" % event.button_index
	return "Unbound"


# --- Value formats ----------------------------------------------------------------------------

static func _percent(value: float) -> String:
	return "%d%%" % roundi(value * 100.0)


static func _multiplier(value: float) -> String:
	return "%.2fx" % value


static func _degrees(value: float) -> String:
	return "%d°" % roundi(value)
