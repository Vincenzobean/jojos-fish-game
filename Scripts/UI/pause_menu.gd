# In-game pause menu: the pause action (Escape) pauses the scene tree and shows Resume / Settings /
# Main Menu / Quit over a blurred view of the game. It also pauses by itself when the game window
# loses focus.
# It runs with process_mode ALWAYS so it keeps working while the tree is paused. The title screen
# switches it to DISABLED while the title is up, which also stops the focus-loss pause there.
# Resuming restores whatever mouse mode was active before pausing.
# Generated by Claude Code.
extends CanvasLayer

## The game was paused (true) or resumed (false) from this menu.
signal pause_changed(paused: bool)

const SettingsMenuScene := preload("res://scenes/settings_menu.tscn")
const BlurShader := preload("res://assets/ui/blur.gdshader")
const TITLE_SCENE := "res://scenes/title_screen.tscn"
const BUTTON_WIDTH := 280.0

var _menu: Control
var _resume_button: Button
var _settings_button: Button
var _settings: Control
var _mouse_mode_before := Input.MOUSE_MODE_CAPTURED


func _ready() -> void:
	_build_ui()
	visible = false


func is_paused() -> bool:
	return visible


func set_paused(paused: bool) -> void:
	if paused == visible:
		return
	visible = paused
	get_tree().paused = paused
	if paused:
		_mouse_mode_before = Input.mouse_mode
		Input.mouse_mode = Input.MOUSE_MODE_VISIBLE
		_resume_button.grab_focus()
	else:
		_close_settings()
		Input.mouse_mode = _mouse_mode_before
	pause_changed.emit(paused)


func _unhandled_input(event: InputEvent) -> void:
	if event.is_action_pressed("pause"):
		get_viewport().set_input_as_handled()
		if _settings:
			_close_settings()
		else:
			set_paused(not visible)


func _notification(what: int) -> void:
	if what == NOTIFICATION_APPLICATION_FOCUS_OUT and can_process() and not SceneLoader.is_loading():
		set_paused(true)


func _go_to_main_menu() -> void:
	for button: Button in _menu.find_children("*", "Button", true, false):
		button.disabled = true
	SceneLoader.change_scene(TITLE_SCENE)


func _open_settings() -> void:
	if _settings:
		return
	_settings = SettingsMenuScene.instantiate()
	_settings.closed.connect(_close_settings)
	add_child(_settings)
	_menu.visible = false


func _close_settings() -> void:
	if not _settings:
		return
	_settings.queue_free()
	_settings = null
	_menu.visible = true
	_settings_button.grab_focus()


func _build_ui() -> void:
	var blur := ColorRect.new()
	blur.set_anchors_preset(Control.PRESET_FULL_RECT)
	var blur_material := ShaderMaterial.new()
	blur_material.shader = BlurShader
	blur.material = blur_material
	add_child(blur)

	_menu = CenterContainer.new()
	_menu.set_anchors_preset(Control.PRESET_FULL_RECT)
	add_child(_menu)

	var panel := PanelContainer.new()
	_menu.add_child(panel)
	var column := VBoxContainer.new()
	column.add_theme_constant_override("separation", 14)
	panel.add_child(column)

	var heading := Label.new()
	heading.text = "Paused"
	heading.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	heading.add_theme_font_size_override("font_size", 40)
	column.add_child(heading)

	_resume_button = _add_button(column, "Resume", set_paused.bind(false))
	_settings_button = _add_button(column, "Settings", _open_settings)
	_add_button(column, "Main Menu", _go_to_main_menu)
	_add_button(column, "Quit", get_tree().quit)


func _add_button(parent: Control, text: String, on_pressed: Callable) -> Button:
	var button := Button.new()
	button.text = text
	button.custom_minimum_size.x = BUTTON_WIDTH
	button.pressed.connect(on_pressed)
	parent.add_child(button)
	return button
