# One node of a skill tree (skill_tree.gd): something to spend skill points on. It has ranks (1 for a
# plain unlock), each costing `cost` points, and can need other nodes bought first (`requires`). What
# it does is data the game reads through the Skills autoload (Scripts/Core/skills.gd):
#   * `stats`: stat name -> how much each rank adds. Most are shares of the base (0.15 is +15%); see the
#     trees for what each stat means and which scripts read it;
#   * `unlocks`: abilities it turns on (a move, swimming), checked with Skills.has().
# `cell` is where it sits on its tree's grid in the skill screen (skill_screen.gd), and `icon` what
# it shows there.
# Generated by Claude Code.
class_name SkillNode
extends Resource

@export var id: StringName
@export var title := ""
@export_multiline var description := ""
@export var cost := 1 ## Points per rank.
@export var max_rank := 1
@export var requires: Array[StringName] = [] ## Nodes that need at least one rank first.
@export var cell := Vector2.ZERO ## Column (halves allowed) and row on the tree's grid; row 0 is nearest its branch's root.
@export var icon: StringName = &"star" ## Which icon the skill screen draws on it (skill_screen.gd draw_icon()).
@export var stats := {} ## Stat name -> amount added per rank.
@export var unlocks: Array[StringName] = [] ## Abilities it turns on.
