# The skill tree every stand gets unless it brings its own (stand_body.gd skill_tree), one branch per
# column (Speed spreads over two). Every move a stand had before skill trees (the light chain, the
# charged heavy, the uppercut, the barrage, block, the finisher) is always there; the tree adds to them:
#   * Body: more health, more stamina and faster stamina regen (stand_health.gd);
#   * Power: more damage, then ORA Finale (a long barrage, let go or held to its limit, ends in one
#     huge blow);
#   * Speed: faster flight, then quicker and cheaper dashes and Rush Punch (light during a dash), or a
#     longer range (stand_controller.gd);
#   * Guard: a block that lets less through, then Counter (light just after blocking a hit).
# The new moves are the stand's StandMoveSet's dash_strike, barrage_finisher and counter
# (default_stand_moves.gd), played by stand_combat.gd once learned. Stats: "max_health", "max_stamina",
# "stamina_regen", "damage", "fly_speed", "dash_cooldown", "dash_stamina", "range" (meters, added),
# "blocked_share". Unlocks: "barrage_finisher", "dash_strike", "counter". A stand with something of its
# own adds a branch in a subclass, like DolphinStandSkillTree.
# Generated by Claude Code.
class_name DefaultStandSkillTree
extends SkillTree


func _init() -> void:
	title = "Stand"
	add_branch("Body", Color(0.85, 0.35, 0.3), &"heart", 0, 0)
	add_branch("Power", Color(0.82, 0.2, 0.32), &"fist", 1, 1)
	add_branch("Speed", Color(0.2, 0.72, 0.62), &"speed", 2, 3)
	add_branch("Guard", Color(0.4, 0.55, 0.85), &"shield", 4, 4)

	add(&"toughness", "Toughness", Vector2(0, 0), &"heart", "+15% health per rank.", {"max_health": 0.15}, [], 3, 1)
	add(&"endurance", "Endurance", Vector2(0, 1), &"bolt", "+15% stamina and +10% stamina regen per rank.",
		{"max_stamina": 0.15, "stamina_regen": 0.1}, [], 3, 1, [&"toughness"])

	add(&"power", "Power", Vector2(1, 0), &"fist", "+10% damage per rank.", {"damage": 0.1}, [], 3, 1)
	add(&"barrage_finisher", "ORA Finale", Vector2(1, 1), &"burst",
		"New move: a barrage held for a moment ends in one huge, launching blow, let go or held to its limit.",
		{}, [&"barrage_finisher"], 1, 2, [&"power"])

	add(&"swiftness", "Swiftness", Vector2(2.5, 0), &"speed", "+10% flying speed per rank.", {"fly_speed": 0.1}, [], 3, 1)
	add(&"quick_dash", "Quick Dash", Vector2(2, 1), &"dash", "Dashes come back 20% sooner and cost 20% less stamina per rank.",
		{"dash_cooldown": -0.2, "dash_stamina": -0.2}, [], 2, 1, [&"swiftness"])
	add(&"dash_strike", "Rush Punch", Vector2(2, 2), &"rush",
		"New move: press light during a dash to fly fist-first into a punch carried by the dash.",
		{}, [&"dash_strike"], 1, 2, [&"quick_dash"])
	add(&"reach", "Reach", Vector2(3, 1), &"range", "The stand can go 20 m further from you per rank.",
		{"range": 20.0}, [], 2, 1, [&"swiftness"])

	add(&"iron_guard", "Iron Guard", Vector2(4, 0), &"shield", "Blocked hits only do 10% of their damage.",
		{"blocked_share": -0.5}, [], 1, 2)
	add(&"counter", "Counter", Vector2(4, 1), &"counter",
		"New move: press light just after blocking a hit to slip it and strike back hard.",
		{}, [&"counter"], 1, 2, [&"iron_guard"])
