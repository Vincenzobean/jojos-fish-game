	add(&"molt", "Molt", Vector2(6, 0), &"burst",
		"Once a fight, badly hurt (25% health), it sheds its shell: heals 25% of its health and flies 30% faster for 8 s, but takes 20% more damage while soft.",
		{}, [&"molt"], 1, 2)
