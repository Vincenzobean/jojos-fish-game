# The player's own skill tree, one branch per column:
#   * Swimming: swimming itself (until it's learned, deep water sinks you: stand_ride.gd), then faster
#     swimming and a higher toss onto the stand's back;
#   * Bow: a quicker draw, stronger reeling and hauling, faster arrows (bow.gd);
#   * Bond: a beaten stand recovers sooner, and its user shakes off the shock sooner (possession.gd).
# Stats, by who reads them: "swim_speed", "toss" (stand_ride.gd, stand_swimmer.gd); "draw_time",
# "reel_speed", "arrow_speed" (bow.gd); "recover_time", "death_stun" (possession.gd). Unlocks: "swim".
# Generated by Claude Code.
class_name PlayerSkillTree
extends SkillTree


func _init() -> void:
	title = "Player"
	add_branch("Swimming", Color(0.2, 0.7, 0.85), &"wave", 0, 0)
	add_branch("Bow", Color(0.88, 0.62, 0.22), &"bow", 1, 1)
	add_branch("Bond", Color(0.85, 0.32, 0.55), &"bond", 2, 2)

	add(&"swim", "Stand Swimming", Vector2(0, 0), &"wave",
		"Your stand comes for you in deep water: it throws you up and carries you on its back. Without it, you sink.",
		{}, [&"swim"], 1, 1)
	add(&"swim_speed", "Strong Swimmer", Vector2(0, 1), &"speed", "Your stand swims 25% faster per rank.",
		{"swim_speed": 0.25}, [], 3, 1, [&"swim"])
	add(&"high_toss", "High Toss", Vector2(0, 2), &"up", "Your stand throws you 25% higher.",
		{"toss": 0.25}, [], 1, 1, [&"swim_speed"])

	add(&"quick_draw", "Quick Draw", Vector2(1, 0), &"bow", "The bow draws 12% faster per rank.",
		{"draw_time": -0.12}, [], 3, 1)
	add(&"strong_reel", "Strong Reel", Vector2(1, 1), &"reel", "Reel and haul 15% faster per rank.",
		{"reel_speed": 0.15}, [], 3, 1, [&"quick_draw"])
	add(&"long_shot", "Long Shot", Vector2(1, 2), &"arrow", "Arrows fly 15% faster.",
		{"arrow_speed": 0.15}, [], 1, 2, [&"strong_reel"])

	add(&"steady_bond", "Steady Bond", Vector2(2, 0), &"bond", "A beaten stand recovers 15% sooner per rank.",
		{"recover_time": -0.15}, [], 3, 1)
	add(&"shake_it_off", "Shake It Off", Vector2(2, 1), &"spark", "You're stunned 30% less when your stand is beaten.",
		{"death_stun": -0.3}, [], 1, 1, [&"steady_bond"])
