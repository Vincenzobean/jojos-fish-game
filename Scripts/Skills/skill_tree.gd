# A skill tree: the nodes (skill_node.gd) one thing can spend skill points on. The player has one
# (player_skill_tree.gd) and every stand kind has one (stand_body.gd get_skill_tree()): most share
# DefaultStandSkillTree, and a stand with something of its own extends it with a branch, like the
# Dolphin's pufferfish (dolphin_stand_skill_tree.gd). Trees are built in code in _init with
# add_branch() and add(); the Skills autoload (Scripts/Core/skills.gd) keeps what's been bought from each.
#
# Branches are what the skill screen (skill_screen.gd) grows the nodes from: each has a name, a colour,
# an icon and the grid columns its nodes sit in, and is drawn as a root at the foot of those columns.
# Generated by Claude Code.
class_name SkillTree
extends Resource

@export var title := ""
@export var nodes: Array[SkillNode] = []
## Each: {"name": String, "color": Color, "icon": StringName, "from": first column, "to": last column}.
@export var branches: Array[Dictionary] = []


## The node called `id`, or null.
func get_node_by_id(id: StringName) -> SkillNode:
	for node in nodes:
		if node.id == id:
			return node
	return null


## The branch whose columns hold `column`, or an empty dictionary.
func branch_at(column: float) -> Dictionary:
	for branch in branches:
		if column >= float(branch["from"]) - 0.01 and column <= float(branch["to"]) + 0.01:
			return branch
	return {}


## Adds a branch called `name`, drawn in `color` with `icon` at its root, over columns `from`..`to`.
func add_branch(name: String, color: Color, icon: StringName, from: float, to: float) -> void:
	branches.append({"name": name, "color": color, "icon": icon, "from": from, "to": to})


## Adds a node: `id` and `title`, at `cell` on the grid with `icon`, `description`, then per-rank `stats`,
## `unlocks`, how many ranks, their cost, and what it needs first. Returns it.
func add(id: StringName, title: String, cell: Vector2, icon: StringName, description: String, stats := {},
		unlocks: Array[StringName] = [], max_rank := 1, cost := 1, requires: Array[StringName] = []) -> SkillNode:
	var node := SkillNode.new()
	node.id = id
	node.title = title
	node.cell = cell
	node.icon = icon
	node.description = description
	node.stats = stats
	node.unlocks = unlocks
	node.max_rank = max_rank
	node.cost = cost
	node.requires = requires
	nodes.append(node)
	return node
