# Arrow projectile: a rigid body that flies under gravity, sticks into whatever it hits
# (riding along on physics bodies), and reports back to the bow via the landed signal.
# If it hits the water instead, it splashes (water.gd splash(): rings and droplets, sized by its speed) to a crawl and sinks, tipping nose-down as its Buoyancy child
# (buoyancy.gd, set to less than its weight) and the water's drag slow it, then comes to rest a little
# under the surface. It counts as landed the moment it hits the water, so it can be reeled straight away.
# The bow can reel it in at any time: it calls hold_still() to pause the arrow's physics while reeling,
# and let_go() if the player stops early, which drops the arrow from wherever it was to land again.
# If the bow set carries_pufferfish, the pufferfish rides on the arrowhead and is lost the moment the
# head (the fixed Head marker) goes under water, even when the arrow is stuck or being reeled; the arrow
# then reports pufferfish_lost and carries no fish from then on.
# Whatever the arrow sticks into is told through an on_arrow_hit(body, velocity) method on the body's
# owner, if it has one (the stand body uses this to fall over). For fishing (fishing.gd), a stand is
# fastened on with hook_into().
# Generated by Claude Code.
extends RigidBody3D

## Emitted once per shot, the first time the arrow sticks into something or hits the water.
signal landed
## Emitted every time the arrow goes into the water (again, if it was dropped back in after reeling),
## with how fast it was going and where it broke the surface. For effects like the splash (arrow_visuals.gd).
signal entered_water(speed: float, surface_point: Vector3)
## The pufferfish on the arrowhead went into the water and is gone.
signal pufferfish_lost

const KILL_Y := -20.0 # Last-resort safety net, in case the arrow somehow misses the water too.
const TURN_SPEED := 0.2 # m/s. Below this, the arrow stops turning to face where it's going.

@export var water_entry_speed_kept := 0.25 # Share of its speed the arrow keeps as it splashes into the water.
@export var max_sink_depth := 1.5 # Meters below the surface where a sinking arrow comes to rest.
@export var settle_speed := 0.05 # m/s. A sinking arrow slower than this has settled, and rests where it is.
@export var full_splash_speed := 30.0 # m/s. Hitting the water this fast (a full-draw shot) makes the biggest splash (water.gd splash())...
@export var min_splash_strength := 0.15 # ...and even the gentlest entry makes at least this much of one.

@onready var head: Marker3D = $Head # Middle of the arrowhead, where the pufferfish sits.

# The body the arrow stuck into, if any. Lets the bow reel in physics bodies instead of the arrow.
var hit_body: Node
## Whether the pufferfish is on the arrowhead. Set by the bow before the arrow is added to the scene.
var carries_pufferfish := false

var _frozen := false # Physics paused: stuck, settled, or held still by the bow for reeling.
var _has_landed := false
var _sinking := false
var _water: Node
var _last_velocity := Vector3.ZERO # Velocity before this tick's collisions changed it.


func _ready() -> void:
	contact_monitor = true
	max_contacts_reported = 1
	lock_rotation = true
	body_entered.connect(_on_body_entered)
	_water = get_tree().get_first_node_in_group("water")


func _physics_process(_delta: float) -> void:
	_last_velocity = linear_velocity
	# Before the frozen check: an arrow stuck nose-first in the shallow seabed, or being reeled through
	# the water, still loses its fish.
	if carries_pufferfish and _water and head.global_position.y < _water.surface_height_at(head.global_position):
		carries_pufferfish = false
		pufferfish_lost.emit()
	if _frozen:
		return
	# Point the arrow along its path: it arcs nose-down in flight, and tips nose-down as it sinks.
	if linear_velocity.length() > TURN_SPEED:
		var direction := linear_velocity.normalized()
		# Falling (almost) straight down, e.g. dropped after an early stop to reeling: world up can't
		# orient it, so use whichever of the arrow's own axes is furthest from the fall direction.
		var up := Vector3.UP
		if absf(direction.y) > 0.99:
			var own_up := global_basis.y
			var own_back := global_basis.z
			up = own_up if absf(own_up.dot(direction)) < absf(own_back.dot(direction)) else own_back
		global_basis = Basis.looking_at(direction, up)

	if _water:
		var surface: float = _water.surface_height_at(global_position)
		if not _sinking and global_position.y < surface:
			_enter_water(surface)
		elif _sinking and (global_position.y <= surface - max_sink_depth or linear_velocity.length() < settle_speed):
			hold_still()
	# Safety net so the bow can't stay empty if the arrow misses everything.
	if global_position.y < KILL_Y:
		_land()


## Whether the arrow has stuck into something or hit the water at least once this shot.
func has_landed() -> bool:
	return _has_landed


## Whether the arrowhead is under water and the arrow isn't embedded in a physics body: sunk, or stuck
## in the seabed. Where a fish could bite.
func is_in_water() -> bool:
	if _water == null or hit_body is RigidBody3D:
		return false
	return head.global_position.y < _water.surface_height_at(head.global_position)


## Fastens the arrow into `body` (a stand biting), as if it had stuck there.
func hook_into(body: RigidBody3D) -> void:
	hold_still()
	_sinking = false
	_embed_in(body)
	_mark_landed()


## Pauses the arrow where it is, e.g. before the bow reels it in (the reel moves it directly, which
## would fight its physics).
func hold_still() -> void:
	if _frozen:
		return
	_frozen = true
	set_deferred("freeze", true)


## Hands the arrow back to physics after the bow stops reeling early, so it drops from wherever it
## was left instead of hanging there, and sticks, lands or sinks again. An arrow embedded in a physics
## body stays put (reeling hauls the body, not the arrow).
func let_go() -> void:
	if not _frozen or hit_body is RigidBody3D:
		return
	_frozen = false
	_sinking = false
	hit_body = null
	linear_velocity = Vector3.ZERO
	set_deferred("freeze", false)


func _on_body_entered(body: Node) -> void:
	_land(body)


# The splash: most of the speed is lost at once, and the arrow is down, so the bow can reel it.
func _enter_water(surface: float) -> void:
	_sinking = true
	var point := Vector3(global_position.x, surface, global_position.z)
	entered_water.emit(linear_velocity.length(), point)
	_water.splash(point, clampf(linear_velocity.length() / full_splash_speed, min_splash_strength, 1.0))
	linear_velocity *= water_entry_speed_kept
	_mark_landed()


func _land(body: Node = null) -> void:
	if _frozen:
		return
	hold_still()
	_sinking = false
	if body is RigidBody3D:
		_embed_in(body)
	else:
		hit_body = body
	_mark_landed()
	var target := body.owner if body else null
	if target and target.has_method("on_arrow_hit"):
		target.on_arrow_hit(body, _last_velocity)


# Ride along with the body; stop colliding so the embedded arrow doesn't shove it around.
func _embed_in(body: RigidBody3D) -> void:
	hit_body = body
	set_deferred("collision_layer", 0)
	set_deferred("collision_mask", 0)
	reparent.call_deferred(body)


func _mark_landed() -> void:
	if _has_landed:
		return
	_has_landed = true
	landed.emit()
