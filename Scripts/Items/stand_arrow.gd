# Applies the gold-head shader to the Stand Arrow model's material at load time.
# Generated by Claude Code.
extends Node3D

const GOLD_SHADER := preload("res://assets/player/stand_arrow/gold_head.gdshader")


func _ready() -> void:
	for mesh_instance: MeshInstance3D in find_children("*", "MeshInstance3D", true, false):
		for surface in mesh_instance.mesh.get_surface_count():
			var source := mesh_instance.mesh.surface_get_material(surface) as BaseMaterial3D
			if source == null:
				continue
			var material := ShaderMaterial.new()
			material.shader = GOLD_SHADER
			material.set_shader_parameter("albedo_tex", source.albedo_texture)
			material.set_shader_parameter("orm_tex", source.metallic_texture)
			material.set_shader_parameter("normal_tex", source.normal_texture)
			mesh_instance.set_surface_override_material(surface, material)
