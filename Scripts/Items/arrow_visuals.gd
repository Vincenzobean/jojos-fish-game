# Arrow presentation (its splash is the water's: arrow_projectile.gd calls water.gd splash()).
# The pufferfish sitting on the arrowhead (a flat sprite fixed to the arrow) is shown only if the arrow
# carries it, and shrinks away when the arrow reports pufferfish_lost.
# Purely presentation. It only reads the gameplay arrow (arrow_projectile.gd, its parent): its
# carries_pufferfish flag and its pufferfish_lost signal. The arrow never reads
# anything here.
# Generated by Claude Code.
extends Node

@export var pufferfish: Sprite3D # The fish on the arrow tip.
@export var pufferfish_vanish_time := 0.15 # Seconds for the fish to shrink away on hitting the water.

@onready var arrow: RigidBody3D = get_parent()


func _ready() -> void:
	arrow.pufferfish_lost.connect(_vanish_pufferfish)
	if pufferfish:
		pufferfish.visible = arrow.carries_pufferfish


func _vanish_pufferfish() -> void:
	if not pufferfish:
		return
	var tween := create_tween().set_parallel()
	tween.tween_property(pufferfish, "scale", Vector3.ZERO, pufferfish_vanish_time).set_ease(Tween.EASE_IN)
	tween.tween_property(pufferfish, "modulate:a", 0.0, pufferfish_vanish_time)
	tween.chain().tween_callback(pufferfish.hide)
