# Where a fighting stand has been over the last `keep` seconds: added as "History" beside its health
# (stand_health.gd setup()). The Jellyfish's Return to Zero (return_to_zero_move.gd, stand_health.gd) sends
# whoever hits it back to where they were `seconds` ago with rewind(): every body of the stand is moved by
# the same offset, and their motion is stopped, as if those seconds never happened.
# Gameplay only.
# Generated by Claude Code.
extends Node

const StandShape := preload("res://Scripts/Stands/stand_shape.gd")

@export var keep := 2.5 ## Seconds of positions kept.
@export var interval := 0.05 ## Seconds between samples.

## Sent back in time by rewind(): `from` where it was, `to` where it went.
signal rewound(from: Vector3, to: Vector3)

var _stand: Node3D
var _samples: Array[Vector3] = [] # Oldest first.
var _wait := 0.0


func _ready() -> void:
	_stand = get_parent() as Node3D


func _physics_process(delta: float) -> void:
	_wait -= delta
	if _wait > 0.0:
		return
	_wait = interval
	var at := _core()
	if at == Vector3.INF:
		return
	_samples.append(at)
	var most := ceili(keep / interval) + 1
	while _samples.size() > most:
		_samples.pop_front()


## Where it was `seconds` ago (the oldest kept, if it hasn't been watched that long), or INF.
func position_ago(seconds: float) -> Vector3:
	if _samples.is_empty():
		return Vector3.INF
	var back := clampi(roundi(seconds / interval), 0, _samples.size() - 1)
	return _samples[_samples.size() - 1 - back]


## Sends it back to where it was `seconds` ago: every body moved by the same offset, their motion stopped.
## Returns how far it went.
func rewind(seconds: float) -> float:
	var then := position_ago(seconds)
	var now := _core()
	if then == Vector3.INF or now == Vector3.INF:
		return 0.0
	var offset := then - now
	for body in StandShape.bodies(_stand):
		body.global_position += offset
		body.linear_velocity = Vector3.ZERO
		body.angular_velocity = Vector3.ZERO
	# What it remembers after that is from the new spot on.
	_samples.clear()
	_samples.append(then)
	rewound.emit(now, then)
	return offset.length()


func _core() -> Vector3:
	if _stand == null:
		return Vector3.INF
	var torso: Node3D = _stand.get("torso")
	if torso == null or not is_instance_valid(torso):
		return Vector3.INF
	return torso.global_position
