# Animation player for a summoned stand body (stand_body.gd, its parent). Purely presentation: it only
# reads the body and its controller (stand_controller.gd) and moves meshes; the physics body and its
# collision shapes are never touched. What it plays is the body's `animations`, a StandAnimationSet
# (Scripts/Stands/Animation/), so every stand can have its own moves on the same body.
#
# When the body poses upright (its `posed` signal), the part meshes are rearranged into a small rig of
# pivots at the neck, shoulders, elbows, hips and knees, all under one "Rig" node on the torso, and the
# summon animation starts. Then, each frame:
#   * the locomotion animation (continuous) is sampled from how the stand is moving (a StandMotion)
#     and eased toward, so changes of speed and direction blend smoothly;
#   * a one-shot animation (the summon, a dash picked by its direction relative to the stand's facing,
#     or the unsummon) plays over that at its weight, following the shortest way round for each angle,
#     so a spin or flip that ends a whole turn round blends out cleanly;
#   * the frame's channels are applied: "lift" moves the rig, "scale" sizes it, "shake" trembles the
#     head and shoulders, "fade" dissolves the meshes (a dithered fade in the stand shaders; a cutscene
#     can fade single parts on top of it, set_part_fade()), and
#     "travel" flies the rig from where the frozen body is toward its unsummon target, facing it;
#   * the one-shot's effect events fire (stand_effects.gd) as their times pass, and its sound events
#     play from the stand (on the SFX bus).
# A fighting move's one-shot plays at its combat's time_scale() (slowed by ink, or slower formed), so it
# keeps time with the hits. The rig eases to the body's grown size (stand_body.gd grow()). A stand with
# tentacles gets four more pivots on its upper back. Each tentacle is a chain of segments ending in its
# club (stand_body_model.gd tentacle_segment_mesh()); at rest they stand straight up from its back, fanned
# out to the sides and tipped back clear of its head and body, and a
# wave runs down every chain so they curl and writhe, calming as a pose takes them (an attack swinging
# them up over its shoulders). Each segment also lags behind on a spring: swung, a tentacle trails behind
# the swing and whips past its end, so it moves like a limp, heavy rope rather than a rod.
# "tentacle_reach" stretches the upper two's arms (not their clubs) and "tentacle_curl" bends every
# segment of all four (coiling them to strike, curling down round what they grab).
# Frozen in a time stop (stand_status.gd), it holds its pose. Slowed, ink drips off it; evading a hit mid-dash leaves a puff.
# The unsummon (the body's `unsummoning` signal) holds its last frame, so the stand stays gone until
# it's stored. Dashes also leave fading afterimages along their path while the burst lasts.
# Fighting (stand_combat.gd): moves play as one-shots, with impacts where they land, charge effects on
# a charging heavy, and for a rally a white flash of the companion as its perfect window opens, a flash on a
# perfect hit, and on a miss the companion let go to snap home (get_companion_hold()).
# Swimming with its user on its back (the body's is_swimming(), stand_swimmer.gd), it plays the set's
# `swim` instead of locomotion.
# Hits on the stand (stand_health.gd) make it flinch (hit_react) and flash white, or shove its guard back
# if it blocked (only flash, during a super-armored move); beaten (the body's `dying`), it plays its death and holds the end.
# Kinds with their own health tricks (stand_health.gd): coming back from death (Immortal) it plays its set's
# `revive`, shedding its shell (Molt) its `molt`, and a shell-guard reflection bursts at the claws; in Return
# to Zero gold-white rings ripple off it, and every hit it undoes snaps the attacker away in a puff.
# Generated by Claude Code.
extends Node

@export var pose_sharpness := 8.0 ## How quickly the locomotion pose is eased toward (per second).

@export var full_charge_shake := 2.0 ## Degrees the stand trembles while holding a fully charged heavy.

@export_group("Afterimages")
@export var afterimage_interval := 0.05 ## Seconds between afterimages while dashing...
@export var afterimage_fade := 0.35 ## ...and how long each takes to fade.
@export var afterimage_color := Color(0.85, 0.87, 0.95, 0.45)

const PIVOTS := StandAnimation.PIVOTS
const TENTACLES := {"TentacleFL": Vector3(-0.08, 0.55, 0.14), "TentacleFR": Vector3(0.08, 0.55, 0.14),
	"TentacleBL": Vector3(-0.14, 0.44, 0.15), "TentacleBR": Vector3(0.14, 0.44, 0.15)} # Where each grows from on the upper back, at scale 1 (body space): F the upper (attacking) pair, B the lower.
const TENTACLE_REST := {"TentacleFL": Vector3(200, 0, -18), "TentacleFR": Vector3(200, 0, 18),
	"TentacleBL": Vector3(200, 0, -35), "TentacleBR": Vector3(200, 0, 35)} # How each stands at rest (180 X is straight up; past it tips back), faded out while a pose holds them.
const StandBodyModel := preload("res://Scripts/Stands/stand_body_model.gd")
const TENTACLE_SPRING_STEP := 1.0 / 120.0 # Seconds per step of the tentacles' springy lag.
const MAX_STEP := 1.0 / 30.0 # Longest step a one-shot advances per frame, so a hitch (shaders compiling on the first summon) can't skip it.

@onready var body: Node3D = get_parent()

var _pivots := {} # Pivot name -> Node3D.
var _angles := {} # Pivot name -> the locomotion pose's current Vector3 of degrees, eased.
var _meshes: Array[MeshInstance3D] = []
var _controller: Node
var _motion := StandMotion.new()
var _one_shot: StandAnimation # The summon, dash or unsummon playing over locomotion, or null.
var _one_shot_time := 0.0
var _held := false # The one-shot is being held (see StandAnimation loop_start and loop_end).
var _companion := {"weight": 0.0, "anchor": 0.0, "out": 0.0, "lift": 0.0, "scale": 1.0} # The one-shot's companion channels.
var _companion_dropped := false # A missed rally let go of the companion for the rest of the one-shot...
var _companion_snaps := 0 # ...and how many times it has been sent snapping home.
var _companion_pop := 0.0 # A quick puff of the companion (the rally cue), dying away.
var _companion_flash := 0.0 # How white the companion is flashing (the rally cue, a perfect hit, hitting something), dying away.
var _skip_from := {} # The pose when the one-shot skipped ahead (its companion came straight back)...
var _skip_blend := 0.0 # ...and how much of it still shows, blending into the new one.
var _last_pose := {} # The pose drawn last frame.
var _contact_point := Vector3.ZERO # Where the flying companion ran into something...
var _contact_time := 0.0 # ...and how much longer it's held there, touching it, before it comes back.
var _companion_override := {} # Set by companion_to() (a finisher placing it): {"point", "weight", "scale"}.
var _charge_move: StandMove # The heavy being charged, or null...
var _charge_level := 0 # ...and how far: 0 charging, 1 ready, 2 full.
var _gather_wait := 0.0
var _crackle_wait := 0.0
var _glow: MeshInstance3D # The glow on the charging fist.
var _combat: Node
var _events_fired := 0 # How many of the one-shot's events have fired.
var _unsummoning := false
var _dying := false # Playing the death, which holds its end like the unsummon.
var _health: Node
var _recoil := 0.0 # A blocked hit shoving the guard back, dying away.
var _body_flash := 0.0 # How white the whole stand is flashing from a hit, dying away.
var _drawn_flash := -1.0
var _travel_start := Vector3.ZERO # Where the rig was (world) when the unsummon began...
var _travel_yaw := 0.0 # ...and the turn (degrees) that faces it toward the target.
var _fade := -1.0
var _part_fades := {} # Part name -> how solid it's drawn on top of the fade (set_part_fade()).
var _part_fades_changed := false
var _afterimage_wait := 0.0
var _scaled := false # The one-shot is a fighting move, playing at its combat's time_scale().
var _drawn_size := 1.0 # The grown size shown, easing toward the body's.
var _drip_wait := 0.0
var _zero_wait := 0.0
var _status: Node
var _tentacle_chains := {} # Tentacle name -> its segments (Node3D), root first.
var _tentacle_posed := 0.0 # How much the playing one-shot holds the tentacles in a pose...
var _tentacle_reach := 0.0 # ...stretches them...
var _tentacle_curl := 0.0 # ...and curls them (degrees per segment).
var _glass: Array[MeshInstance3D] = [] # The jellyfish's bell and fringe (stand_body.gd), faded by hand: they're not the stand shader.
var _tentacle_lag := {} # Tentacle name -> {"last": its root's angles (degrees), "bend": per segment Vector2, "speed": per segment Vector2}.


func _ready() -> void:
	body.posed.connect(_build_rig)
	body.unsummoning.connect(_on_unsummoning)
	body.dying.connect(_on_dying)
	set_process(false)


## Plays `animation` once over locomotion, replacing any one-shot already playing. `held` keeps it in
## its hold or loop (StandAnimation loop_start..loop_end) until release().
func play(animation: StandAnimation, held := false) -> void:
	_one_shot = animation
	_held = held and animation != null and animation.can_hold()
	_one_shot_time = 0.0
	_events_fired = 0
	_companion_dropped = false
	_scaled = false


## Lets go of a held one-shot: it plays on from the end of its hold or loop to its end.
func release() -> void:
	if _one_shot == null or not _held:
		return
	_held = false
	_one_shot_time = maxf(_one_shot.held_time(_one_shot_time), _one_shot.loop_end)


# A punch connected: an impact where it landed.
func _on_hit_landed(_move: StandMove, _target: Node, point: Vector3) -> void:
	StandEffects.spawn("impact", get_tree().current_scene, point, 1.9 * body.body_scale)


## The one-shot animation playing, or null.
func get_playing() -> StandAnimation:
	return _one_shot


## How solid the stand is drawn right now (0 dissolved away, 1 solid), for things that fade with it
## like a floating companion (floating_companion.gd).
func get_fade() -> float:
	return (_fade if _fade >= 0.0 else 1.0) * float(_part_fades.get("Companion", 1.0))


func _process(delta: float) -> void:
	if not is_instance_valid(body.torso):
		return
	if not is_instance_valid(_controller):
		# Whatever is moving it: its controller, or its swimmer while it carries its user (stand_swimmer.gd).
		_controller = body.get_node_or_null("Controller")
		if _controller == null:
			_controller = body.get_node_or_null("Swimmer")
		if _controller:
			_controller.dashed.connect(_on_dashed)
			if _controller.has_signal("heaving"):
				_controller.heaving.connect(func() -> void: play(body.get_animations().swim_toss))
	if not is_instance_valid(_combat):
		_combat = body.get_node_or_null("Combat")
		if _combat:
			_combat.move_started.connect(func(move: StandMove) -> void:
				play(move.animation, move.animation.can_hold())
				_scaled = true)
			_combat.move_released.connect(func(_move: StandMove) -> void: release())
			_combat.move_cancelled.connect(func(_move: StandMove) -> void: cancel())
			_combat.hit_landed.connect(_on_hit_landed)
			_combat.charge_started.connect(_on_charge_started)
			_combat.charge_ready.connect(_on_charge_level.bind(1))
			_combat.charge_full.connect(_on_charge_level.bind(2))
			_combat.charge_ended.connect(_on_charge_ended)
			_combat.rally_window.connect(_on_rally_window)
			_combat.rally_graded.connect(_on_rally_graded)
			_combat.companion_struck.connect(_on_companion_struck)
			_combat.move_skipped.connect(_on_move_skipped)
			_combat.formation_changed.connect(_on_formation_changed)
	if not is_instance_valid(_health):
		_health = body.get_node_or_null("Health")
		if _health:
			_health.damaged.connect(_on_damaged)
			if _health.has_signal("evaded"):
				_health.evaded.connect(func(_hit: Dictionary) -> void:
					StandEffects.spawn("poof", get_tree().current_scene, body.torso.global_position, 1.9 * body.body_scale * 0.6))
			if _health.has_signal("revived"):
				_health.revived.connect(func(_left: float) -> void: _play_extra("revive"))
				_health.molted.connect(func() -> void: _play_extra("molt"))
				_health.reflected.connect(func(_amount: float, _attacker: Node3D) -> void:
					StandEffects.spawn("perfect", get_tree().current_scene, _limb_point("FistR"), 1.9 * body.body_scale * 0.7))
				_health.undone.connect(_on_undone)
	if not is_instance_valid(_status):
		_status = body.get_node_or_null("Status")
	if is_instance_valid(_status) and _status.has_method("is_frozen") and _status.is_frozen():
		return # Stopped in time: it holds its pose exactly as it was.
	_update_motion(delta)
	var animations: StandAnimationSet = body.get_animations()

	# Locomotion (or its swim, while it swims), eased toward the shortest way round, so a swim stroke's
	# arm going all the way round carries on round.
	var continuous: StandAnimation = animations.swim if body.is_swimming() and animations.swim else animations.locomotion
	var base := continuous.evaluate(_motion.time, _motion) if continuous else {}
	var blend := 1.0 - exp(-pose_sharpness * delta)
	for name: String in PIVOTS:
		_angles[name] = _lerp_degrees(_angles[name], base.get(name, Vector3.ZERO), blend)
	var pose := _angles.duplicate()
	var lift: Vector3 = base.get("lift", Vector3.ZERO)
	var size := 1.0
	var fade := 1.0
	var shake := 0.0
	var travel := -1.0 # Not travelling.

	# A one-shot over it.
	if _one_shot:
		var rate: float = _combat.time_scale() if _scaled and is_instance_valid(_combat) and _combat.has_method("time_scale") else 1.0
		_one_shot_time += minf(delta, MAX_STEP) * rate
		var time := _one_shot_time
		if _held:
			time = _one_shot.held_time(time)
		elif _unsummoning or _dying:
			time = minf(time, _one_shot.duration)
		var weight := _one_shot.weight_at(time)
		var frame := _one_shot.evaluate(time, _motion)
		_tentacle_posed = weight if frame.has("TentacleFL") or frame.has("TentacleBL") else 0.0
		_tentacle_reach = float(frame.get("tentacle_reach", 0.0)) * weight
		_tentacle_curl = float(frame.get("tentacle_curl", 0.0)) * weight
		for name: String in PIVOTS:
			pose[name] = _lerp_degrees(pose[name], frame.get(name, Vector3.ZERO), weight)
		lift = lift.lerp(frame.get("lift", Vector3.ZERO), weight)
		size = lerpf(1.0, frame.get("scale", 1.0), weight)
		fade = clampf(frame.get("fade", 1.0), 0.0, 1.0)
		shake = float(frame.get("shake", 0.0)) * weight
		if frame.has("travel"):
			travel = frame["travel"]
		_companion = {"weight": clampf(frame.get("companion_weight", 0.0), 0.0, 1.0),
			"anchor": float(frame.get("companion_anchor", 0.0)), "out": float(frame.get("companion_out", 0.0)), "lift": float(frame.get("companion_lift", 0.0)),
			"scale": float(frame.get("companion_scale", 1.0)), "head": clampf(frame.get("companion_head", 0.0), 0.0, 1.0)}
		if _one_shot.is_finished(_one_shot_time) and not _unsummoning and not _dying and not _held:
			_one_shot = null # The unsummon and death hold their last frame until the stand is stored.
	else:
		_companion = {"weight": 0.0, "anchor": 0.0, "out": 0.0, "lift": 0.0, "scale": 1.0, "head": 0.0}
		_tentacle_posed = 0.0
		_tentacle_reach = 0.0
		_tentacle_curl = 0.0
	if _companion_dropped:
		_companion["weight"] = 0.0
	_companion_pop = move_toward(_companion_pop, 0.0, delta * 2.5)
	_companion_flash = move_toward(_companion_flash, 0.0, delta * 3.0)
	_contact_time = maxf(_contact_time - delta, 0.0)
	if _charge_level == 2:
		shake = maxf(shake, full_charge_shake)

	# A blocked hit shoves the guard back a moment.
	if _recoil > 0.0:
		pose["Rig"] += Vector3(10.0, 0.0, 0.0) * _recoil
		lift += Vector3(0.0, 0.0, 0.18) * _recoil
		_recoil = move_toward(_recoil, 0.0, delta * 5.0)
	_body_flash = move_toward(_body_flash, 0.0, delta * 4.0)
	_set_flash(_body_flash)

	# Just after a skip ahead, the old pose blends into the new one.
	if _skip_blend > 0.0:
		for name: String in PIVOTS:
			pose[name] = _lerp_degrees(pose[name], _skip_from[name], _skip_blend)
		_skip_blend = move_toward(_skip_blend, 0.0, delta / 0.12)
	_last_pose = pose

	var rig: Node3D = _pivots["Rig"]
	var tremble := shake * sin(_motion.time * 55.0)
	for name: String in PIVOTS:
		if not _pivots.has(name):
			continue # Tentacles, on a stand without them.
		var degrees: Vector3 = pose[name]
		if TENTACLES.has(name): # Swaying idly on top of the pose.
			var phase := float(TENTACLES.keys().find(name)) * 1.7
			degrees += TENTACLE_REST[name] * (1.0 - _tentacle_posed)
			degrees += Vector3(8.0 * sin(_motion.time * 2.1 + phase), 0.0, 6.0 * sin(_motion.time * 1.6 + phase * 0.6))
		if name == "Neck" or name.begins_with("Shoulder"):
			degrees += Vector3(tremble, 0.0, tremble * 0.5)
		if name == "Rig" and travel >= 0.0:
			degrees.y += _travel_yaw
		(_pivots[name] as Node3D).rotation = Vector3(deg_to_rad(degrees.x), deg_to_rad(degrees.y), deg_to_rad(degrees.z))
	_drawn_size = move_toward(_drawn_size, body.get_size() if body.has_method("get_size") else 1.0, delta * 0.8)
	rig.scale = Vector3.ONE * maxf(size * _drawn_size, 0.01)
	_animate_tentacles(delta)
	_drip_ink(delta)
	_ripple_zero(delta)
	if travel >= 0.0:
		var point := _travel_start.lerp(_travel_end(), travel) + Vector3.UP * lift.y
		rig.position = body.torso.global_transform.affine_inverse() * point
	else:
		rig.position = lift
	_set_fade(fade)
	_fire_events()

	_afterimage_wait -= delta
	var flurry := _one_shot != null and _one_shot.afterimages
	if (flurry or (is_instance_valid(_controller) and _controller.is_dashing())) and _afterimage_wait <= 0.0:
		_afterimage_wait = afterimage_interval
		_leave_afterimage()
	_show_charge(delta)


## Where the floating companion (floating_companion.gd) should be right now: "weight" (0 floating as
## usual, 1 held by the playing animation), "point" (world, where it's held), "scale" and "snaps" (goes
## up each time a missed rally sends it snapping straight home) and "flash" (0 to 1, how white it flashes).
func get_companion_hold() -> Dictionary:
	var weight: float = _companion["weight"]
	var scale: float = float(_companion["scale"]) * (1.0 + 0.35 * sin(_companion_pop * PI))
	if not _companion_override.is_empty(): # Placed by hand (a finisher).
		var over: Dictionary = _companion_override
		return {"weight": over["weight"], "point": over["point"], "scale": over["scale"], "snaps": _companion_snaps, "flash": _companion_flash}
	if _contact_time > 0.0: # Touching what it ran into.
		return {"weight": 1.0, "point": _contact_point, "scale": scale, "snaps": _companion_snaps, "flash": _companion_flash}
	if weight <= 0.0 or _pivots.is_empty():
		return {"weight": 0.0, "point": Vector3.ZERO, "scale": scale, "snaps": _companion_snaps, "flash": _companion_flash}
	return {"weight": weight, "point": _companion_point(), "scale": scale, "snaps": _companion_snaps, "flash": _companion_flash}


## Holds the companion at `point` (world) with `weight` (1 there, 0 floating as usual), puffed to `scale`,
## until companion_free(): for scripted scenes like a finisher (Scripts/Stands/Finisher/).
func companion_to(point: Vector3, weight := 1.0, scale := 1.0) -> void:
	_companion_override = {"point": point, "weight": weight, "scale": scale}


func companion_free() -> void:
	_companion_override = {}


## Flashes the companion white.
func companion_flash(amount := 1.0) -> void:
	_companion_flash = maxf(_companion_flash, amount)


## Flashes the whole stand white.
func flash(amount := 1.0) -> void:
	_body_flash = maxf(_body_flash, amount)


## Where the top of its head is (world), e.g. a dolphin's blowhole.
func head_top() -> Vector3:
	var head := (_pivots["Neck"] as Node3D).get_node_or_null("HeadMesh") as MeshInstance3D
	if head == null:
		return body.torso.global_position + Vector3.UP * body.body_scale
	var box := head.get_aabb()
	return head.global_transform * Vector3(box.get_center().x, box.end.y, box.get_center().z)


## Where the tip of a tentacle's club is (world): "TentacleFL" and so on; the head's top if it has none.
func tentacle_tip(tentacle: String) -> Vector3:
	var chain: Array = _tentacle_chains.get(tentacle, [])
	if chain.is_empty():
		return head_top()
	return (chain.back() as Node3D).global_transform * (Vector3.DOWN * StandBodyModel.CLUB_LENGTH * body.body_scale)


# Each tentacle's segments: a wave running down the chain (curling and writhing), quieter while a pose
# holds them; tentacle_curl bending them all; and each lagging behind its root's swings on a spring
# (_tentacle_follow()). The upper pair's arms are stretched by tentacle_reach, each segment hanging from
# the end of the one before.
func _animate_tentacles(delta: float) -> void:
	var calm := 1.0 - 0.45 * _tentacle_posed
	for name: String in _tentacle_chains:
		var chain: Array = _tentacle_chains[name]
		var stretch := 1.0 + 3.0 * _tentacle_reach if name.begins_with("TentacleF") else 1.0
		var phase := float(TENTACLES.keys().find(name)) * 1.3
		var bends := _tentacle_follow(name, chain.size(), delta)
		for i in chain.size():
			var segment: Node3D = chain[i]
			var club := i == chain.size() - 1
			if i > 0:
				segment.position = Vector3.DOWN * StandBodyModel.TENTACLE_SEGMENT_LENGTH * body.body_scale * stretch
				var wave := sin(_motion.time * 2.8 - i * 0.9 + phase)
				var sway := sin(_motion.time * 1.9 - i * 0.7 + phase * 1.6)
				var bend: Vector2 = bends[i]
				segment.rotation = Vector3(deg_to_rad(16.0 * wave * calm / stretch + _tentacle_curl + bend.x), 0.0,
					deg_to_rad(4.0 * sway * calm / stretch + bend.y))
			(segment.get_child(0) as Node3D).scale = Vector3(1.0, 1.0 if club else stretch, 1.0)


# How far each segment of the tentacle `name` lags behind its root's swings (degrees, x about X, y about
# Z): every segment is pulled toward bending against the way the root is turning, more toward the tip,
# on an under-damped spring, so a swing drags the tentacle behind it and it whips past when it stops.
func _tentacle_follow(name: String, count: int, delta: float) -> Array:
	var root_angles := (_pivots[name] as Node3D).rotation_degrees
	if not _tentacle_lag.has(name):
		var still: Array[Vector2] = []
		still.resize(count)
		still.fill(Vector2.ZERO)
		_tentacle_lag[name] = {"last": root_angles, "bend": still.duplicate(), "speed": still.duplicate()}
	var lag: Dictionary = _tentacle_lag[name]
	var turning := Vector2.ZERO # The root's swing, degrees per second.
	if delta > 0.0:
		var change: Vector3 = root_angles - (lag["last"] as Vector3)
		turning = (Vector2(wrapf(change.x, -180.0, 180.0), wrapf(change.z, -180.0, 180.0)) / delta).limit_length(1500.0)
	lag["last"] = root_angles
	var bends: Array = lag["bend"]
	var speeds: Array = lag["speed"]
	# The spring is stepped in small fixed steps, so a long frame (a hitch) can't make it blow up.
	var steps := clampi(ceili(minf(delta, MAX_STEP) / TENTACLE_SPRING_STEP), 1, 8)
	var step := minf(delta, MAX_STEP) / steps
	for i in range(1, count):
		var share := float(i) / (count - 1) # The tip lags most.
		var wanted := (-turning * 0.035 * share).limit_length(45.0)
		var speed: Vector2 = speeds[i]
		var bend: Vector2 = bends[i]
		for k in steps:
			speed += ((wanted - bend) * 160.0 - speed * 11.0) * step
			bend += speed * step
		speeds[i] = speed
		bends[i] = bend.limit_length(60.0)
	return bends


## Where a fist is (world): "L" or "R".
func fist(side: String) -> Vector3:
	return _limb_point("Fist" + side)


# Where the playing animation holds the companion: at its anchor (gliding between them), moved onto
# the top of the head as far as "head" says, sent `out` toward the spot in front, lifted.
func _companion_point() -> Vector3:
	var anchors := [_limb_point("FistL"), _limb_point("FistR"), _limb_point("FootR"), _limb_point("Out")]
	var anchor := clampf(_companion["anchor"], 0.0, 3.0)
	var from := mini(int(anchor), 2)
	var point: Vector3 = (anchors[from] as Vector3).lerp(anchors[from + 1], anchor - from)
	if _companion["head"] > 0.0: # Sat on top of the head (the blowhole).
		point = point.lerp(head_top(), float(_companion["head"]))
	point = point.lerp(anchors[3], float(_companion["out"]))
	return point + Vector3.UP * float(_companion["lift"])


# A rallying move's perfect window opened: the companion flashes white and puffs.
func _on_rally_window(_move: StandMove) -> void:
	_companion_pop = 1.0
	_companion_flash = 1.0


# The flying companion ran into something: it's held there a moment, touching it, with an impact, and
# it flashes.
func _on_companion_struck(_move: StandMove, point: Vector3) -> void:
	_contact_point = point
	_contact_time = 0.1
	_companion_flash = maxf(_companion_flash, 0.7)
	StandEffects.spawn("impact", get_tree().current_scene, point, 1.9 * body.body_scale)


# The move skipped ahead (its companion coming straight back from what it hit): so does its animation,
# the pose blending across.
func _on_move_skipped(_move: StandMove, time: float) -> void:
	if _one_shot == null:
		return
	_one_shot_time = time
	while _events_fired < _one_shot.events.size() and float(_one_shot.events[_events_fired]["time"]) <= time:
		_events_fired += 1 # Effects of the stretch skipped are left out.
	if not _last_pose.is_empty():
		_skip_from = _last_pose.duplicate()
		_skip_blend = 1.0


# Breaking out of a formation (the Anchovy's School Formation): the school scatters off it with a puff,
# as it eases back down to size.
func _on_formation_changed(formed: bool) -> void:
	if formed:
		return
	var at: Vector3 = body.torso.global_position
	StandEffects.spawn("poof", get_tree().current_scene, at, 1.9 * body.body_scale)
	AnchovySchool.make(get_tree().current_scene, at, body.body_scale * 0.4, 30, body.body_scale).scatter(body.body_scale * 3.0, 0.8)


# A rally press was timed: a perfect one flashes on the companion; a miss lets go of it, snapping home.
func _on_rally_graded(_move: StandMove, grade: StringName) -> void:
	if grade == &"perfect":
		_companion_flash = 1.0
	if grade == &"perfect" and _companion["weight"] > 0.0:
		StandEffects.spawn("perfect", get_tree().current_scene, _companion_point(), 1.9 * body.body_scale)
	elif grade == &"miss":
		_companion_dropped = true
		_companion_snaps += 1


## Drops a playing one-shot (a heavy let go too early): it blends straight back out.
func cancel() -> void:
	if _one_shot == null:
		return
	_held = false
	_companion_dropped = true # Its companion floats home rather than following the rest of the move.
	_one_shot_time = maxf(_one_shot_time, _one_shot.duration - _one_shot.blend_out)


# Where a fist, the kicking foot or the spot out in front is, in the world, as the rig is posed now.
func _limb_point(limb: String) -> Vector3:
	var scale: float = body.body_scale
	match limb:
		"FistL", "FistR":
			var side := limb.substr(4)
			var forearm: Node3D = (_pivots["Elbow" + side] as Node3D).get_node("Forearm%sMesh" % side)
			return forearm.global_transform * Vector3(0.0, -0.16 * scale, 0.0)
		"FootR":
			var shin: Node3D = (_pivots["KneeR"] as Node3D).get_node("ShinRMesh")
			return shin.global_transform * Vector3(0.0, -0.215 * scale, -0.12 * scale)
		"Out": # Out in front of the stand, about a body length off: where a kicked companion flies to.
			var front: Vector3 = -body.torso.global_basis.z
			front.y = 0.0
			return body.torso.global_position + front.normalized() * 1.9 * scale * 1.1 + Vector3.UP * 0.1 * scale
	return body.torso.global_position


# A heavy began charging: ink lines start gathering into its fist.
func _on_charge_started(move: StandMove) -> void:
	_charge_move = move
	_charge_level = 0
	_gather_wait = 0.0


# The charge reached ready (1) or full (2): a flash and ring burst from the fist, and it glows.
func _on_charge_level(_move: StandMove, level: int) -> void:
	_charge_level = level
	var fist := _charge_fist()
	var scene := get_tree().current_scene
	StandEffects.spawn("ready" if level == 1 else "burst", scene, fist, 1.9 * body.body_scale * (1.0 if level == 1 else 0.6))
	if level == 2:
		StandEffects.spawn("shockwave", scene, body.torso.global_position, 1.9 * body.body_scale * 0.8)
	if _glow == null:
		_glow = MeshInstance3D.new()
		var sphere := SphereMesh.new()
		sphere.radial_segments = 12
		sphere.rings = 6
		_glow.mesh = sphere
		var material := StandardMaterial3D.new()
		material.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
		material.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA
		material.albedo_color = Color(1.0, 1.0, 0.95, 0.55)
		_glow.material_override = material
		_glow.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
		_glow.top_level = true
		add_child(_glow)


# The heavy was thrown or dropped: the charge effects stop.
func _on_charge_ended(_move: StandMove) -> void:
	_charge_move = null
	_charge_level = 0
	if _glow:
		_glow.queue_free()
		_glow = null


# While a heavy charges: ink lines gather into the fist; once ready the fist glows (pulsing, bigger
# and brighter once full), and at full charge ink sparks crackle all round the stand (it also shakes).
func _show_charge(delta: float) -> void:
	if _charge_move == null:
		return
	var fist := _charge_fist()
	var scene := get_tree().current_scene
	var size: float = 1.9 * body.body_scale
	_gather_wait -= delta
	if _gather_wait <= 0.0:
		_gather_wait = 0.12 if _charge_level < 2 else 0.07
		StandEffects.spawn("gather", scene, fist, size * (0.5 if _charge_level == 0 else 0.7))
	if _glow:
		var pulse := 1.0 + 0.15 * sin(_motion.time * (10.0 if _charge_level == 2 else 6.0))
		_glow.global_position = fist
		_glow.scale = Vector3.ONE * size * (0.12 if _charge_level == 1 else 0.2) * pulse
		(_glow.material_override as StandardMaterial3D).albedo_color.a = 0.45 if _charge_level == 1 else 0.7
	if _charge_level == 2:
		_crackle_wait -= delta
		if _crackle_wait <= 0.0:
			_crackle_wait = 0.06
			var around := Vector3(randf_range(-1.0, 1.0), randf_range(-0.6, 1.0), randf_range(-1.0, 1.0)).normalized()
			StandEffects.spawn("crackle", scene, body.torso.global_position + around * size * 0.35, size)


# The fist the charging heavy punches with.
func _charge_fist() -> Vector3:
	var side := "R"
	if _charge_move and not _charge_move.hits.is_empty() and _charge_move.hits[0].get("fist", "R") == "L":
		side = "L"
	return _limb_point("Fist" + side)


# The body is being sent back: play its unsummon, turned to face where it may fly to.
func _on_unsummoning() -> void:
	if _pivots.is_empty():
		return
	_unsummoning = true
	_travel_start = (_pivots["Rig"] as Node3D).global_position
	var to_target: Vector3 = body.torso.global_basis.inverse() * (_travel_end() - _travel_start)
	_travel_yaw = rad_to_deg(atan2(-to_target.x, -to_target.z)) if Vector2(to_target.x, to_target.z).length() > 0.01 else 0.0
	play(body.get_animations().unsummon)


# Where the rig ends a "travel" of 1: high enough over the target that a head-first stand's head just
# touches it ("lift" below 0 then sinks it in).
func _travel_end() -> Vector3:
	var head_reach: float = body.part_rest_position("Head").y + 0.12 * body.body_scale
	return body.unsummon_target_position() + Vector3.UP * head_reach


# Fires the playing one-shot's effect events whose time has come.
func _fire_events() -> void:
	if _one_shot == null:
		return
	var events := _one_shot.events
	while _events_fired < events.size() and _one_shot_time >= float(events[_events_fired]["time"]):
		var event: Dictionary = events[_events_fired]
		_events_fired += 1
		if event.has("sound"):
			_play_sound(event["sound"], float(event["from"]))
			continue
		var at: Vector3 = (_pivots["Rig"] as Node3D).global_position
		match event.get("at", "stand"):
			"target":
				at = body.unsummon_target_position()
			"companion":
				at = _companion_point()
			"head":
				at = head_top()
			"out":
				at = _limb_point("Out")
			"L", "R":
				at = _limb_point("Fist" + String(event["at"]))
		# Aimed along the stand's facing: "toward" is in its own space, in lengths of the body at scale 1.
		var toward: Vector3 = body.torso.global_basis * (event["toward"] as Vector3) * body.body_scale if event.has("toward") else Vector3.ZERO
		StandEffects.spawn(event["effect"], get_tree().current_scene, at, 1.9 * body.body_scale, toward)


# Plays `stream` from `from` seconds in, from the stand's rig so it follows the stand; it frees itself
# when done.
func _play_sound(stream: AudioStream, from: float) -> void:
	var player := AudioStreamPlayer3D.new()
	player.stream = stream
	player.bus = &"SFX"
	player.finished.connect(player.queue_free)
	(_pivots["Rig"] as Node3D).add_child(player)
	player.play(from)


func _update_motion(delta: float) -> void:
	var flying_speed: float = _controller.flying_speed() if is_instance_valid(_controller) else 10.0
	var velocity: Vector3 = body.torso.global_basis.inverse() * body.torso.linear_velocity
	_motion.time += delta
	_motion.forward = clampf(-velocity.z / flying_speed, -1.0, 1.0)
	_motion.side = clampf(velocity.x / flying_speed, -1.0, 1.0)
	_motion.falling = clampf(-velocity.y / flying_speed, 0.0, 1.0)
	_motion.moving = clampf(Vector2(velocity.x, velocity.z).length() / flying_speed, 0.0, 1.0)
	_motion.body_scale = body.body_scale
	if body.is_swimming():
		_motion.stroke += delta * (0.45 + 0.75 * _motion.moving)


# Plays the set's dash for the direction of this dash relative to the way the stand faces.
func _on_dashed(direction: Vector3) -> void:
	var dash: StandAnimation = body.get_animations().dash_for(body.torso.global_basis.inverse() * direction)
	if dash:
		play(dash)


# Each angle of `from` turned `weight` of the shortest way toward `to`, in degrees.
static func _lerp_degrees(from: Vector3, to: Vector3, weight: float) -> Vector3:
	return from + Vector3(wrapf(to.x - from.x, -180.0, 180.0), wrapf(to.y - from.y, -180.0, 180.0),
		wrapf(to.z - from.z, -180.0, 180.0)) * weight


# A hit landed on the stand: it flinches (or its guard is shoved back, if it blocked), flashes white,
# and an impact bursts where it was hit.
func _on_damaged(_amount: float, hit: Dictionary, blocked: bool) -> void:
	if _dying:
		return
	if blocked:
		_recoil = 1.0
		_body_flash = maxf(_body_flash, 0.35)
	elif hit.get("armored", false):
		_body_flash = 1.0 # Super armor: it doesn't flinch, the move plays on.
	else:
		var react: StandAnimation = body.get_animations().hit_react
		if react:
			play(react)
		_body_flash = 1.0
	var at: Vector3 = hit.get("point", body.torso.global_position)
	StandEffects.spawn("impact", get_tree().current_scene, at, 1.9 * body.body_scale * (0.7 if blocked else 1.0))


# The stand was beaten: its death plays, holding its end until the stand is stored.
func _on_dying() -> void:
	if _pivots.is_empty():
		return
	_dying = true
	_on_charge_ended(null) # Any charge effects go.
	play(body.get_animations().death)


func _set_flash(amount: float) -> void:
	if is_equal_approx(amount, _drawn_flash):
		return
	_drawn_flash = amount
	for mesh in _meshes:
		mesh.set_instance_shader_parameter(&"flash", amount)


func _set_fade(amount: float) -> void:
	if is_equal_approx(amount, _fade) and not _part_fades_changed:
		return
	_fade = amount
	_part_fades_changed = false
	for mesh in _meshes:
		var part := String(mesh.name).trim_suffix("Mesh")
		mesh.set_instance_shader_parameter(&"fade", amount * float(_part_fades.get(part, 1.0)))
	for glass in _glass:
		if is_instance_valid(glass):
			var material := glass.material_override as StandardMaterial3D
			material.albedo_color.a = float(glass.get_meta("alpha", 1.0)) * amount * float(_part_fades.get("Head", 1.0))
			glass.visible = material.albedo_color.a > 0.01


## Fades just the part called `part_name` (a stand_body.gd PARTS name, e.g. "ForearmL") to `amount`, on top
## of the animation's fade, so a cutscene can show only an arm (clash_director.gd). "Companion" fades the
## floating companion (get_fade()).
func set_part_fade(part_name: String, amount: float) -> void:
	_part_fades[part_name] = clampf(amount, 0.0, 1.0)
	_part_fades_changed = true


## Every part as solid as the animation says again.
func clear_part_fades() -> void:
	_part_fades.clear()
	_part_fades_changed = true


# Rearranges the posed body's part meshes into pivots at its joints, so limbs can swing.
func _build_rig() -> void:
	var rig := Node3D.new()
	rig.name = "Rig"
	body.torso.add_child(rig)
	_pivots["Rig"] = rig
	_attach("Torso", rig, Vector3.ZERO)
	_attach("Head", _pivot("Neck", rig, Vector3.ZERO, "Head"), body.joint_rest_position("Head"))
	for glass_name in ["BellMesh", "FringeMesh"]: # The jellyfish's clear bell and fine tentacles ride with its head.
		var glass := body.torso.get_node_or_null(glass_name) as MeshInstance3D
		if glass:
			glass.reparent(_pivots["Neck"], false)
			glass.transform = Transform3D(Basis(), body.part_rest_position("Head") - body.joint_rest_position("Head"))
			_glass.append(glass)
	for s in ["L", "R"]:
		var shoulder := _pivot("Shoulder" + s, rig, Vector3.ZERO, "UpperArm" + s)
		_attach("UpperArm" + s, shoulder, body.joint_rest_position("UpperArm" + s))
		var elbow := _pivot("Elbow" + s, shoulder, body.joint_rest_position("UpperArm" + s), "Forearm" + s)
		_attach("Forearm" + s, elbow, body.joint_rest_position("Forearm" + s))
		var hip := _pivot("Hip" + s, rig, Vector3.ZERO, "Thigh" + s)
		_attach("Thigh" + s, hip, body.joint_rest_position("Thigh" + s))
		var knee := _pivot("Knee" + s, hip, body.joint_rest_position("Thigh" + s), "Shin" + s)
		_attach("Shin" + s, knee, body.joint_rest_position("Shin" + s))
	if body.get("tentacles"):
		_build_tentacles()
	for name: String in PIVOTS:
		_angles[name] = Vector3.ZERO
	play(body.get_animations().summon)
	set_process(true)


# Four tentacles growing from the upper back, each on its own pivot on the rig: a chain of segments, each
# hanging from the end of the one before, the last its club. Every segment's mesh is named after its
# tentacle, so set_part_fade() fades the whole tentacle.
func _build_tentacles() -> void:
	var rig: Node3D = _pivots["Rig"]
	var center: Vector3 = body.PARTS[0][1]
	var look: Dictionary = body.get_look()
	for name: String in TENTACLES:
		var pivot := Node3D.new()
		pivot.name = name
		rig.add_child(pivot)
		pivot.position = (TENTACLES[name] - center) * body.body_scale
		_pivots[name] = pivot
		var chain: Array[Node3D] = []
		var parent: Node3D = pivot
		for i in StandBodyModel.TENTACLE_SEGMENTS:
			var segment := Node3D.new()
			parent.add_child(segment)
			var mesh := MeshInstance3D.new()
			mesh.name = name + "Mesh"
			mesh.mesh = StandBodyModel.tentacle_segment_mesh(look, i)
			segment.add_child(mesh)
			_meshes.append(mesh)
			chain.append(segment)
			parent = segment
		_tentacle_chains[name] = chain


# Plays the animation set's one-shot called `name` (revive, molt), if the set has one.
func _play_extra(name: String) -> void:
	var animations: StandAnimationSet = body.get_animations()
	var extra: StandAnimation = animations.get(name) if name in animations else null
	if extra:
		play(extra)


# Return to Zero undid a hit: the hit point flashes away, and the attacker is gone in a puff to where it was.
func _on_undone(hit: Dictionary) -> void:
	var world := get_tree().current_scene
	StandEffects.spawn("perfect", world, hit.get("point", body.torso.global_position), 1.9 * body.body_scale * 0.6)
	var attacker: Node3D = hit.get("stand")
	if attacker and is_instance_valid(attacker) and attacker.get("torso"):
		StandEffects.spawn("poof", world, attacker.torso.global_position, 1.9 * body.body_scale * 0.8)


# While in Return to Zero (stand_health.gd), gold-white rings ripple off it.
func _ripple_zero(delta: float) -> void:
	_zero_wait -= delta
	if _zero_wait > 0.0 or not is_instance_valid(_health) or not _health.has_method("is_zeroed") or not _health.is_zeroed():
		return
	_zero_wait = 0.45
	StandEffects.spawn("shockwave", get_tree().current_scene, body.torso.global_position, 1.9 * body.body_scale * 0.7)


# While slowed (stand_status.gd), ink drips off it now and then.
func _drip_ink(delta: float) -> void:
	_drip_wait -= delta
	if _drip_wait > 0.0 or not is_instance_valid(_status) or not _status.is_slowed():
		return
	_drip_wait = 0.3
	StandEffects.spawn("ink_drip", get_tree().current_scene, body.torso.global_position + Vector3.UP * 0.3 * body.body_scale, 1.9 * body.body_scale)


# A pivot named `pivot_name` under `parent` (which sits at `parent_at`, relative to the torso's center),
# placed at the joint that `part_name` hangs from.
func _pivot(pivot_name: String, parent: Node3D, parent_at: Vector3, part_name: String) -> Node3D:
	var pivot := Node3D.new()
	pivot.name = pivot_name
	parent.add_child(pivot)
	pivot.position = body.joint_rest_position(part_name) - parent_at
	_pivots[pivot_name] = pivot
	return pivot


# Moves the mesh of `part_name` under `pivot` (which sits at `pivot_at`, relative to the torso's center)
# without changing where it's drawn in the standing pose.
func _attach(part_name: String, pivot: Node3D, pivot_at: Vector3) -> void:
	var mesh: MeshInstance3D = body.get_part_mesh(part_name)
	if mesh == null:
		return
	mesh.reparent(pivot, false)
	mesh.transform = Transform3D(Basis(), body.part_rest_position(part_name) - pivot_at)
	_meshes.append(mesh)


# Leaves a fading, see-through copy of the body where it is now.
func _leave_afterimage() -> void:
	var world := get_tree().current_scene
	if world == null:
		return
	var material := StandardMaterial3D.new()
	material.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
	material.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA
	material.albedo_color = afterimage_color
	material.cull_mode = BaseMaterial3D.CULL_BACK
	var ghost := Node3D.new()
	world.add_child(ghost)
	for mesh in _meshes:
		var copy := MeshInstance3D.new()
		copy.mesh = mesh.mesh
		copy.material_override = material
		copy.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
		ghost.add_child(copy)
		copy.global_transform = mesh.global_transform
	var tween := ghost.create_tween()
	tween.tween_property(material, "albedo_color:a", 0.0, afterimage_fade)
	tween.tween_callback(ghost.queue_free)
