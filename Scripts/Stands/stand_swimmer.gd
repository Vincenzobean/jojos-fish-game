# Swims a stand along the water surface while it carries its user (stand_ride.gd), whatever the stand: like
# the stand controller (stand_controller.gd) it only knows it through stand_shape.gd. The ride adds it as
# the stand's "Swimmer" child and says what it's doing through `mode`:
#   * HOLD: treads water where it is, turned to face `facing`;
#   * FOLLOW: swims to stay under `target` (keeping under its user while they're in the air);
#   * STEER: WASD swims it relative to the ride camera's facing (its `yaw`), and it turns, boat-like, to
#     face the way it's going. Sprint (Shift) is a hard stroke, a burst of speed on a cooldown (`stroked`).
# It holds its middle `depth` meters under the surface, rocking with the swells, gravity off, and the
# water reacts (water.gd): it leaves a wake, and a hard stroke splashes. It doesn't collide with the ground
# (its standing collision shapes would drag along the seabed while it lies flat); instead it looks ahead
# as it steers: shallows or a shore it can climb onto say `reached_shore` with where its user can hop off
# to, and a cliff or rock just stops it.
#
# rush_to() flies it somewhere fast, like a dash (`dashed`), e.g. back to its user from wherever it was.
# heave() is for the visuals: it comes up under its user and throws them into the air (`heaving`).
# Gameplay only: the stand's visuals (stand_body_visuals.gd) play its swim and react to the signals.
# Generated by Claude Code.
extends Node

## A rush (rush_to()) began, heading along `direction`; the visuals play a dash.
signal dashed(direction: Vector3)
## A hard stroke: a burst of speed.
signal stroked
## It heaves its user up out of the water (heave()); the visuals play its swim toss.
signal heaving
## Steering in, it found shallows or a shore; `spot` is ground its user can hop off onto.
signal reached_shore(spot: Vector3)

const StandShape := preload("res://Scripts/Stands/stand_shape.gd")

enum Mode { HOLD, FOLLOW, STEER }

@export_group("Speed")
@export var swim_speed := 3.8 ## Lengths of the stand per second...
@export var min_speed := 8.0 ## ...but never slower than this (m/s)...
@export var max_speed := 14.0 ## ...or faster than this (m/s).
@export var acceleration := 16.0 ## m/s^2 the speed is steered toward the wanted speed.
@export var height_gain := 6.0 ## How firmly it's held at its depth (per second).

@export_group("Stroke")
@export var stroke_speed := 22.0 ## m/s of a hard stroke...
@export var stroke_time := 0.35 ## ...for this long...
@export var stroke_cooldown := 0.9 ## ...and possible again this many seconds after it began.

@export_group("Turning")
@export var turn_gain := 5.0
@export var max_turn_speed := 3.0 ## Radians per second.
@export var spin_damping := 6.0
@export var upright_gain := 10.0
@export var swell_lean := 0.35 ## How much it leans with the slope of the water (0 none, 1 lying along it).

@export_group("Shore")
@export var shallow_depth := 0.6 ## Meters of water ahead below which it's the shallows: its user hops off.
@export var climb_height := 3.0 ## Meters above the water its user can be thrown up onto a shore.

var mode := Mode.HOLD
var depth := 0.15 ## Meters its middle is held under the water surface.
var facing := Vector3.FORWARD ## The way it faces while holding.
var target := Vector3.ZERO ## Where it swims under while following.

var _bodies: Array[RigidBody3D] = []
var _core: RigidBody3D
var _size := 1.0
var _camera: Node3D
var _water: Node
var _excluded: Array[RID] = []
var _masks := {} # Body -> its collision mask, put back when this goes.
var _stroke_left := 0.0
var _stroke_wait := 0.0
var _rushing := false
var _ashore := false


## Takes over `stand_root` (in the scene tree), steering relative to `camera` (which has a `yaw`).
## `rider` is left out of its looking ahead.
func setup(stand_root: Node3D, camera: Node3D, rider: CollisionObject3D = null) -> void:
	_bodies = StandShape.bodies(stand_root)
	_core = StandShape.core(_bodies)
	_size = StandShape.size(stand_root)
	_camera = camera
	_water = get_tree().get_first_node_in_group("water")
	for body in _bodies:
		body.gravity_scale = 0.0
		_masks[body] = body.collision_mask
		body.collision_mask = 0
		_excluded.append(body.get_rid())
	if rider:
		_excluded.append(rider.get_rid())
	facing = -_core.global_basis.z


func _exit_tree() -> void:
	for body: RigidBody3D in _masks:
		if is_instance_valid(body):
			body.collision_mask = _masks[body]


## Its normal swimming speed in m/s.
func flying_speed() -> float:
	return clampf(swim_speed * _size, min_speed, max_speed)


## Heaves its user up out of the water: the throw itself is the ride's (stand_ride.gd), this is for show.
func heave() -> void:
	heaving.emit()


## True while rushing somewhere (rush_to()).
func is_dashing() -> bool:
	return _rushing


## Where its user sits on its back while it swims (world).
func seat() -> Vector3:
	return _core.global_position + Vector3.UP * _size * 0.065


## Flies it to `point` (its middle) in `seconds`, fast and straight like a dash, then it holds there.
func rush_to(point: Vector3, seconds: float) -> void:
	var from := StandShape.center_of_mass(_bodies)
	var toward := point - from
	_rushing = true
	if Vector2(toward.x, toward.z).length() > 0.01:
		facing = Vector3(toward.x, 0.0, toward.z).normalized()
		_core.global_basis = Basis.looking_at(facing)
	dashed.emit(toward.normalized() if toward.length() > 0.01 else facing)
	for body in _bodies:
		body.freeze = true
	var tween := create_tween()
	tween.tween_method(_place.bind(from), Vector3.ZERO, toward, seconds).set_ease(Tween.EASE_IN_OUT).set_trans(Tween.TRANS_SINE)
	await tween.finished
	for body in _bodies:
		if is_instance_valid(body):
			body.freeze = false
			body.linear_velocity = Vector3.ZERO
	_rushing = false


func _place(offset: Vector3, from: Vector3) -> void:
	var shift := from + offset - StandShape.center_of_mass(_bodies)
	for body in _bodies:
		body.global_position += shift


func _physics_process(delta: float) -> void:
	if _rushing or _core == null or not is_instance_valid(_core):
		return
	var center := StandShape.center_of_mass(_bodies)
	var surface: float = _water.surface_height_at(center) if _water else center.y
	var vertical := clampf((surface - depth - center.y) * height_gain, -4.0, 4.0)

	var direction := Vector3.ZERO
	var speed := flying_speed()
	match mode:
		Mode.FOLLOW:
			var to := Vector3(target.x - center.x, 0.0, target.z - center.z)
			direction = to.normalized() if to.length() > 0.05 else Vector3.ZERO
			speed = minf(to.length() * 4.0, max_speed * 1.5) # Arrives rather than overshooting.
		Mode.STEER:
			var input := Input.get_vector("move_left", "move_right", "move_up", "move_down")
			direction = Basis(Vector3.UP, _camera.yaw) * Vector3(input.x, 0.0, input.y) if is_instance_valid(_camera) else Vector3.ZERO
			_stroke_wait -= delta
			_stroke_left -= delta
			if Input.is_action_just_pressed("sprint") and _stroke_wait <= 0.0 and direction.length() > 0.1:
				_stroke_left = stroke_time
				_stroke_wait = stroke_cooldown
				stroked.emit()
				if _water:
					_water.splash(center + direction.normalized() * _size * 0.3, 0.45)
			if _stroke_left > 0.0:
				speed = stroke_speed
			if direction.length() > 0.1:
				direction = _look_ahead(direction.normalized(), center, surface)
	if direction.length() > 0.1:
		facing = direction.normalized()

	var wanted := direction * speed + Vector3.UP * vertical
	for body in _bodies:
		if not is_instance_valid(body) or body.freeze:
			continue
		body.sleeping = false
		body.linear_velocity = body.linear_velocity.move_toward(wanted, (INF if _stroke_left > 0.0 else acceleration) * delta)
	_steer_facing(facing, delta)
	if _water:
		_water.wake(self, center, _core.linear_velocity)


# Looks ahead along `direction` for land. Shallows, or a shore low enough to climb onto: `reached_shore`
# (once) and it stops. A cliff or a rock: it stops. Otherwise it swims on: returns the direction to go.
func _look_ahead(direction: Vector3, center: Vector3, surface: float) -> Vector3:
	var reach := _size * 0.55 + 0.5
	var flat_center := Vector3(center.x, surface, center.z)
	var space := _core.get_world_3d().direct_space_state
	var shore := Vector3.INF
	# Something standing out of the water just ahead (a beach, a cliff, a rock)?
	var wall := _ray(space, flat_center + Vector3.UP * 0.3, flat_center + Vector3.UP * 0.3 + direction * reach)
	if not wall.is_empty():
		shore = _landing(space, wall["position"] + direction * 0.8, surface)
		if shore == Vector3.INF:
			return Vector3.ZERO # Too high to climb onto: it can't go that way.
	else:
		# Or the seabed rising into shallows?
		var probe := flat_center + direction * reach
		var bed := _ray(space, probe + Vector3.UP * 0.5, probe + Vector3.DOWN * 8.0)
		if not bed.is_empty() and bed["position"].y > surface - shallow_depth:
			shore = _landing(space, probe + direction * 1.5, surface)
			if shore == Vector3.INF:
				shore = bed["position"]
	if shore == Vector3.INF:
		return direction
	if not _ashore:
		_ashore = true
		reached_shore.emit(shore)
	return Vector3.ZERO


# Ground to hop onto at `around`, above the water (and no higher than climb_height above it), or INF.
func _landing(space: PhysicsDirectSpaceState3D, around: Vector3, surface: float) -> Vector3:
	var top := Vector3(around.x, surface + climb_height + 1.0, around.z)
	var hit := _ray(space, top, top + Vector3.DOWN * (climb_height + 3.0))
	if hit.is_empty():
		return Vector3.INF
	var ground: Vector3 = hit["position"]
	if ground.y <= surface or ground.y > surface + climb_height or hit["normal"].y < 0.6:
		return Vector3.INF
	return ground


func _ray(space: PhysicsDirectSpaceState3D, from: Vector3, to: Vector3) -> Dictionary:
	var query := PhysicsRayQueryParameters3D.create(from, to)
	query.exclude = _excluded
	var hit := space.intersect_ray(query)
	if hit.is_empty() or not hit["collider"] is StaticBody3D:
		return {}
	return hit


# Like the stand controller: turns the core about the vertical toward `direction`, stands it straight
# and damps all other spinning.
func _steer_facing(direction: Vector3, delta: float) -> void:
	var keep := exp(-spin_damping * delta)
	var spin := _core.angular_velocity * keep
	# Upright, but leaning a little with the water's surface, so it rocks on the swells.
	var up := Vector3.UP
	if _water:
		up = Vector3.UP.lerp(_water.surface_normal_at(_core.global_position), swell_lean).normalized()
	var upright := _core.global_basis.y.normalized().cross(up) * upright_gain
	spin.x = upright.x
	spin.z = upright.z
	var front := -_core.global_basis.z
	front.y = 0.0
	if front.length() > 0.01 and direction.length() > 0.1:
		var angle := front.normalized().signed_angle_to(Vector3(direction.x, 0.0, direction.z).normalized(), Vector3.UP)
		spin.y = clampf(angle * turn_gain, -max_turn_speed, max_turn_speed)
	else:
		spin.y = 0.0
	_core.angular_velocity = spin
