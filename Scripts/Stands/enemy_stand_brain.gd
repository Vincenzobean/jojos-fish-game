# The fighting mind of a wild stand (one fished up while the player has a stand of their own:
# stand_encounter.gd). It drives the same controller (stand_controller.gd) and combat (stand_combat.gd)
# the player's stand uses, by pressing their buttons through a StandAIInput (stand_ai_input.gd), and is
# the controller's "camera" too: its `yaw` is the way it wants to face.
#
# It always faces its `target` (the player's stand), matches its height and dashes in when it's far off,
# and it learns, through what every opponent knows about the player's kind of stand (StandMemory,
# stand_memory.gd, keyed by `memory_key`):
#   * Tactics: it fights in rounds of round_time seconds, each with a tactic StandMemory picks (the one
#     that has done best against this stand so far, or another to try), and scores the round on damage
#     dealt minus damage taken:
#       - rush: up close, attacking often, seldom blocking;
#       - bait: hanging back until the target throws something, then dashing in to punish it;
#       - turtle: blocking a lot, answering a blocked hit straight away (a counter);
#       - zone: keeping its distance, then dashing in with charged heavies.
#   * Reads: whenever the player makes a choice (stand_combat.gd `action_taken`, or a dash), StandMemory
#     says what they usually choose next from there; with a chance that grows with how familiar the
#     stand is, after a reaction delay, it answers that in advance with one of the RESPONSES that make
#     sense for it (block, interrupt, sidestep, back off, hold off, punish), picked by how well each has
#     worked against this stand before, and scores the answer a second later (`read`).
#   * Familiarity also makes it block a little more and attack a little sooner.
#   * Its kind's special (stand_special, one its tree doesn't lock: the Lobster's Claw Grab, the
#     Jellyfish's Polyp Reset) now and then: Claw Grab when it's close, Polyp Reset when it's hurt or slowed.
#   * While its target is in Return to Zero (the Jellyfish's, stand_health.gd is_zeroed()) it doesn't
#     attack at all: it keeps its distance until that's over.
#   * Its `skill` (0 to 1, set by whoever arms it: an island rival's zone, rival_user.gd) does the same
#     across the board: a low one waits longer between attacks, blocks less and reads the player less
#     often and more slowly; a high one the reverse. At 0.5 (a wild stand's) none of that changes.
# Outside the tactics its plans are: hold its distance (NEUTRAL), close in to attack (APPROACH), the
# attack (light presses, or a heavy held for its charge), BACK_OFF after it, BLOCK, SIDESTEP (a sideways
# dash) and HOLD_OFF (waiting out a guard before a heavy).
# It must be added to the stand before the Controller and Combat, so its presses are seen the same frame.
# Gameplay only.
# Generated by Claude Code.
extends Node3D # Only for its `yaw`: the controller takes it as its camera.

## It read the player's next choice (`predicted`, a stand_combat.gd action) and is answering it with
## `response`.
signal read(predicted: StringName, response: String)
## It started a round with `tactic`.
signal tactic_changed(tactic: String)

const StandShape := preload("res://Scripts/Stands/stand_shape.gd")

enum Plan { NEUTRAL, APPROACH, ATTACK, BACK_OFF, BLOCK, SIDESTEP, HOLD_OFF }

## The ways it can answer each choice it reads the player is about to make.
const RESPONSES := {
	&"open": ["block", "interrupt", "sidestep"],
	&"chain": ["block", "interrupt", "sidestep"],
	&"rush": ["block", "interrupt", "sidestep"],
	&"dash": ["block", "interrupt", "sidestep"],
	&"heavy": ["back_off", "sidestep", "interrupt"],
	&"finisher": ["back_off", "sidestep", "interrupt"],
	&"barrage": ["back_off", "sidestep"],
	&"special": ["back_off", "sidestep"],
	&"block": ["hold_off"],
	&"stop": ["punish"],
}

## Each tactic: the distance it holds (lengths of the stand), seconds between attacks, the chance an
## attack is a heavy, and the chance it blocks a move the target starts up close.
const TACTICS := {
	"rush": {"hold": 0.6, "wait_min": 0.3, "wait_max": 0.8, "heavy": 0.1, "block": 0.15},
	"bait": {"hold": 1.2, "wait_min": 2.0, "wait_max": 3.0, "heavy": 0.2, "block": 0.2},
	"turtle": {"hold": 0.7, "wait_min": 1.2, "wait_max": 2.0, "heavy": 0.2, "block": 0.7},
	"zone": {"hold": 1.5, "wait_min": 0.8, "wait_max": 1.4, "heavy": 0.8, "block": 0.3},
}

@export var attack_distance := 0.65 ## Lengths of the stand from the target it attacks from.
@export var back_off_time := 0.5 ## Seconds it backs away after an attack.
@export var dash_distance := 4.0 ## Lengths of the stand away beyond which it dashes in.
@export var round_time := 2.5 ## Seconds each tactic is tried for before it's scored.
@export var response_window := 1.0 ## Seconds after answering a read before the answer is scored.
@export_range(0.0, 1.0) var skill := 0.5 ## How sharp it fights: 0 sluggish, 1 sharp; 0.5 is a wild stand's.

## The way it faces (radians about the vertical, like the stand camera's), for the controller.
var yaw := 0.0
## Its buttons, read by the controller and combat.
var input := StandAIInput.new()
## What it fights: the player's stand (stand_body.gd).
var target: Node3D
## The player's kind of stand (its scene path): what StandMemory knows it by.
var memory_key := ""

var _stand: Node3D
var _bodies: Array[RigidBody3D] = []
var _size := 1.0
var _plan := Plan.NEUTRAL
var _plan_time := 0.0 # Seconds into the current plan.
var _attack_wait := 1.0
var _presses_left := 0 # Light presses still to make in this attack...
var _press_wait := 0.0 # ...and seconds until the next.
var _heavy_hold := 0.0 # Seconds to keep holding heavy (a charged heavy), or 0.
var _heavy_next := false # The attack being closed in for is a heavy.
var _target_move: StandMove # The target's move last frame, to notice a new one.
var _dash_wait := 0.0
var _tactic := "rush"
var _round_left := 0.0
var _dealt := 0.0 # Damage dealt and taken this round, for its score.
var _taken := 0.0
var _hooked := false # Listening to both stands' health and the player's choices yet.
var _reaction := {} # A read waiting out its delay: {"left": seconds, "predicted", "response"}.
var _judging := {} # An answered read being scored: {"left", "predicted", "response", "hurt", "landed"}.
var _side := 1.0 # Which way a sidestep goes (+1 right, -1 left).
var _special_wait := 4.0 # Seconds before it thinks about its special again.


## Takes charge of `stand`, fighting `fight` (the player's stand), whose kind is `key` (for StandMemory).
func setup(stand: Node3D, fight: Node3D, key := "") -> void:
	_stand = stand
	target = fight
	memory_key = key
	_bodies = StandShape.bodies(stand)
	_size = StandShape.size(stand)
	var front := -StandShape.core(_bodies).global_basis.z
	yaw = atan2(-front.x, -front.z)
	_start_round()
	_attack_wait *= 0.5 # The first attack comes a little sooner.


## Lets go of every button (it's beaten, or the fight is over).
func stop() -> void:
	input.release_all()
	set_physics_process(false)


func _physics_process(delta: float) -> void:
	if not is_instance_valid(target) or _bodies.is_empty() or not is_instance_valid(_bodies[0]):
		input.release_all()
		return
	var torso: Node3D = target.get("torso")
	if torso == null or not is_instance_valid(torso):
		input.release_all()
		return
	if not _hooked:
		_hook_health()
	var here := StandShape.center_of_mass(_bodies)
	var to := torso.global_position - here
	var flat := Vector3(to.x, 0.0, to.z)
	var distance := flat.length() / maxf(_size, 0.01) # In lengths of the stand.
	if flat.length() > 0.05:
		yaw = atan2(-flat.x, -flat.z)
	input.set_climb(clampf(to.y / maxf(_size * 0.3, 0.1), -1.0, 1.0))

	if _target_zeroed():
		input.release_all()
		_steer_to(distance, dash_distance * 0.6) # Hits would only be undone: wait it out.
		return
	_think_special(delta, distance)
	_plan_time += delta
	_attack_wait -= delta
	_dash_wait -= delta
	_round_left -= delta
	if _round_left <= 0.0 and _plan != Plan.ATTACK:
		_end_round()
		_start_round()
	_watch_target(distance)
	_react(delta)
	match _plan:
		Plan.NEUTRAL:
			_neutral(distance)
		Plan.APPROACH:
			_approach(distance)
		Plan.ATTACK:
			_attack(distance, delta)
		Plan.BACK_OFF:
			input.set_move(Vector2(randf_range(-0.3, 0.3), 1.0)) # Backward, drifting a little.
			if _plan_time >= back_off_time:
				_set_plan(Plan.NEUTRAL)
		Plan.BLOCK:
			input.set_move(Vector2.ZERO)
			if _plan_time >= 0.55:
				input.hold(&"block", false)
				_set_plan(Plan.NEUTRAL)
		Plan.SIDESTEP:
			input.set_move(Vector2(_side, 0.0))
			if _plan_time >= 0.35:
				_set_plan(Plan.NEUTRAL)
		Plan.HOLD_OFF:
			_steer_to(distance, attack_distance + 0.5) # Just out of reach while their guard is up...
			if _plan_time >= 0.8:
				_heavy_next = true # ...then a heavy for when it drops.
				_set_plan(Plan.APPROACH)
	_judge(delta)


# Whether its target is in Return to Zero (every hit on it would be undone).
func _target_zeroed() -> bool:
	var health: Node = target.get_node_or_null("Health")
	return health != null and health.has_method("is_zeroed") and health.is_zeroed()


# Now and then, its kind's special: a grab when close, a reset when hurt or slowed.
func _think_special(delta: float, distance: float) -> void:
	_special_wait -= delta
	if _special_wait > 0.0 or _plan == Plan.ATTACK:
		return
	_special_wait = randf_range(2.5, 4.5) * _slowness()
	if not _stand.has_method("get_moves"):
		return
	for special: StandMove in _stand.get_moves().specials:
		if special.input != &"stand_special":
			continue
		var name := special.display_name
		var health: Node = _stand.get_node_or_null("Health")
		var status: Node = _stand.get_node_or_null("Status")
		var hurt: bool = health != null and health.health < health.max_health * 0.6
		var stuck: bool = status != null and (status.is_slowed() or status.is_rooted())
		if (name == "Claw Grab" and distance < attack_distance + 0.6) or (name == "Polyp Reset" and (hurt or stuck)) \
				or (name != "Claw Grab" and name != "Polyp Reset" and randf() < 0.3):
			input.tap(&"stand_special")
		return


# --- Plans ---------------------------------------------------------------------------------------------

# Holding the tactic's distance; once its attack is ready, closing in.
func _neutral(distance: float) -> void:
	_steer_to(distance, _setting("hold"))
	if distance > dash_distance and _dash_wait <= 0.0:
		_dash()
	if _attack_wait <= 0.0:
		_heavy_next = randf() < _setting("heavy")
		_set_plan(Plan.APPROACH)


# Closing to attack range (dashing in from further off), then attacking.
func _approach(distance: float) -> void:
	_steer_to(distance, attack_distance)
	if distance > attack_distance + 0.9 and _dash_wait <= 0.0:
		_dash()
	if absf(distance - attack_distance) < 0.35 or _plan_time > 2.0:
		_begin_attack(_heavy_next)


func _begin_attack(heavy: bool) -> void:
	_set_plan(Plan.ATTACK)
	if heavy:
		_heavy_hold = randf_range(0.5, 0.9)
		_presses_left = 0
		input.hold(&"heavy_attack", true)
	else:
		_heavy_hold = 0.0
		_presses_left = randi_range(1, 3)
		_press_wait = 0.0


# Throws the attack it picked: light presses spaced out, or a heavy held for its charge then let go.
func _attack(distance: float, delta: float) -> void:
	_steer_to(distance, attack_distance)
	if _heavy_hold > 0.0:
		_heavy_hold -= delta
		if _heavy_hold <= 0.0:
			input.hold(&"heavy_attack", false)
			_end_attack()
		return
	_press_wait -= delta
	if _presses_left > 0 and _press_wait <= 0.0:
		input.tap(&"light_attack")
		_presses_left -= 1
		_press_wait = randf_range(0.22, 0.32)
	elif _presses_left <= 0 and _press_wait <= 0.0:
		_end_attack()


func _end_attack() -> void:
	var known := StandMemory.familiarity(memory_key)
	_attack_wait = randf_range(_setting("wait_min"), _setting("wait_max")) * (1.0 - 0.3 * known) * _slowness()
	_set_plan(Plan.BACK_OFF)


# Forward when too far from `wanted`, back when too close.
func _steer_to(distance: float, wanted: float) -> void:
	input.set_move(Vector2(0.0, -clampf((distance - wanted) * 2.0, -1.0, 1.0)))


func _dash() -> void:
	input.tap(&"sprint")
	_dash_wait = 1.5


func _set_plan(plan: Plan) -> void:
	_plan = plan
	_plan_time = 0.0


# --- Watching the target ---------------------------------------------------------------------------------

# A move the target starts: a bait punishes it, and it may simply block.
func _watch_target(distance: float) -> void:
	var combat: Node = target.get_node_or_null("Combat")
	var move: StandMove = combat.get_move() if combat and combat.has_method("get_move") else null
	var started := move != null and move != _target_move
	_target_move = move
	if not started or _plan == Plan.ATTACK:
		return
	if _tactic == "bait" and distance < _setting("hold") + 0.8:
		_dash() # It took the bait: in, and punish it.
		_heavy_next = false
		_set_plan(Plan.APPROACH)
		return
	var block_chance := _setting("block") * (1.0 + 0.5 * StandMemory.familiarity(memory_key)) * _sharpness()
	if _plan != Plan.BLOCK and distance < attack_distance + 0.8 and randf() < block_chance:
		_block()


# The player made a choice: what do they usually do next, from here? Answered after a reaction delay if
# StandMemory is sure enough (and familiar enough with this stand).
func _on_player_action(action: StringName) -> void:
	if memory_key == "" or not _reaction.is_empty() or not is_physics_processing():
		return
	var guess := StandMemory.read(memory_key, action, _band())
	var predicted: StringName = guess["action"]
	if predicted == &"" or not RESPONSES.has(predicted) or randf() >= float(guess["chance"]) * _sharpness():
		return
	var response := StandMemory.pick_response(memory_key, predicted, RESPONSES[predicted])
	_reaction = {"left": float(guess["delay"]) * _slowness(), "predicted": predicted, "response": response}


func _react(delta: float) -> void:
	if _reaction.is_empty():
		return
	_reaction["left"] = float(_reaction["left"]) - delta
	if float(_reaction["left"]) > 0.0:
		return
	var reaction := _reaction
	_reaction = {}
	if _plan == Plan.ATTACK:
		return
	var response: String = reaction["response"]
	read.emit(reaction["predicted"], response)
	_judging = {"left": response_window, "predicted": reaction["predicted"], "response": response, "hurt": false, "landed": false}
	match response:
		"block":
			_block()
		"interrupt":
			_begin_attack(false)
			_presses_left = 1 # A quick jab to catch them starting it.
		"sidestep":
			_side = 1.0 if randf() < 0.5 else -1.0
			input.set_move(Vector2(_side, 0.0))
			_dash()
			_set_plan(Plan.SIDESTEP)
		"back_off":
			_set_plan(Plan.BACK_OFF)
		"hold_off":
			_set_plan(Plan.HOLD_OFF)
		"punish":
			if _dash_wait <= 0.0:
				_dash()
			_begin_attack(false)
			_presses_left = randi_range(2, 3)


# Scores an answered read once its window is over: it worked if it landed a hit or wasn't hurt.
func _judge(delta: float) -> void:
	if _judging.is_empty():
		return
	_judging["left"] = float(_judging["left"]) - delta
	if float(_judging["left"]) > 0.0:
		return
	var score := 1.0 if _judging["landed"] else (-1.0 if _judging["hurt"] else 0.5)
	StandMemory.reward_response(memory_key, _judging["predicted"], _judging["response"], score)
	_judging = {}


func _block() -> void:
	input.hold(&"block", true)
	_set_plan(Plan.BLOCK)


# How far the target is, sorted the way StandMemory.band() sorts the player's choices.
func _band() -> String:
	var torso: Node3D = target.get("torso")
	if torso == null or _bodies.is_empty():
		return "mid"
	return StandMemory.band(torso.global_position.distance_to(StandShape.center_of_mass(_bodies)), StandShape.size(target))


# --- Rounds and their scores ---------------------------------------------------------------------------

func _start_round() -> void:
	_tactic = StandMemory.pick_tactic(memory_key) if memory_key != "" else TACTICS.keys().pick_random()
	_round_left = round_time
	_dealt = 0.0
	_taken = 0.0
	_attack_wait = randf_range(_setting("wait_min"), _setting("wait_max")) * _slowness()
	tactic_changed.emit(_tactic)


# Scores the round: damage dealt minus taken, as a share of its own health, about -1 to 1.
func _end_round() -> void:
	if memory_key == "":
		return
	var health: Node = _stand.get_node_or_null("Health")
	var scale: float = health.max_health * 0.3 if health else 30.0
	StandMemory.reward(memory_key, _tactic, clampf((_dealt - _taken) / maxf(scale, 1.0), -1.0, 1.0))


func _hook_health() -> void:
	var own: Node = _stand.get_node_or_null("Health")
	var theirs: Node = target.get_node_or_null("Health")
	if own == null or theirs == null:
		return
	_hooked = true
	own.damaged.connect(_on_hurt)
	theirs.damaged.connect(_on_hit_landed)
	var combat: Node = target.get_node_or_null("Combat")
	if combat and combat.has_signal("action_taken"):
		combat.action_taken.connect(_on_player_action)
	var controller: Node = target.get_node_or_null("Controller")
	if controller and controller.has_signal("dashed"):
		controller.dashed.connect(func(_direction: Vector3) -> void: _on_player_action(&"dash"))


func _on_hurt(amount: float, _hit: Dictionary, blocked: bool) -> void:
	_taken += amount
	if not _judging.is_empty() and not blocked:
		_judging["hurt"] = true
	if blocked and _tactic == "turtle" and _plan == Plan.BLOCK:
		input.hold(&"block", false)
		_begin_attack(false) # Straight back at them (a counter, if its combat allows).


func _on_hit_landed(amount: float, hit: Dictionary, _blocked: bool) -> void:
	if hit.get("stand") == _stand:
		_dealt += amount
		if not _judging.is_empty():
			_judging["landed"] = true


func _setting(name: String) -> float:
	return float(TACTICS[_tactic][name])


# What `skill` does to its chances (blocking, reading the player): 0.4x at 0, 1x at 0.5, 1.6x at 1...
func _sharpness() -> float:
	return lerpf(0.4, 1.6, skill)


# ...and to its waits (between attacks, before answering a read): 1.5x at 0, 1x at 0.5, 0.5x at 1.
func _slowness() -> float:
	return lerpf(1.5, 0.5, skill)
