# The body every stand shares: a muscular humanoid 1.9 m tall times `body_scale`, facing -Z, built in code from
# PARTS and JOINTS. Ten rigid body parts (torso, head, upper arms, forearms, thighs, shins) are joined at
# the neck, shoulders, elbows, hips and knees by cone-twist joints, and each has its own Buoyancy so the
# whole body floats. Its look comes from stand_body_model.gd: the Palette colors, the head style (a
# human, dolphin, anchovy, squid or mantis shrimp face; the mantis shrimp also armors the whole body), an optional dorsal fin and optional tentacles. A new stand is an
# inherited scene of stand_body.tscn with its own look (see scenes/stands/), and its own Fighting stats
# (speed, damage dealt and taken, evading while dashing) on top of its moves.
# Once standing, grow() can make it bigger (the Anchovy's School Formation).
#
# On the line it's a ragdoll: fishing (fishing.gd) sets start_limp so it's floppy from the start, and
# the generic thrasher (thrasher.gd) makes it fight. Otherwise it stands frozen until an arrow stuck into
# any part calls on_arrow_hit() (arrow_projectile.gd looks the method up on the part's owner, this root),
# which lets every part go and shoves the hit one.
#
# When summoned, possession (possession.gd) calls pose_upright(): every limb's shape and mesh moves onto
# the torso in the standing pose and the limb bodies and joints are removed, so the stand is one rigid
# body standing straight, ready for the stand controller (stand_controller.gd) to fly about.
#
# How it moves on screen is its `animations` (a StandAnimationSet, see Scripts/Stands/Animation/), played
# by the Visuals child (stand_body_visuals.gd), which only moves the meshes. Sending it back is
# begin_unsummon(): the body freezes where it is, `unsummoning` tells the visuals to play the unsummon
# (which may fly the stand into its user), and the caller (possession.gd) stores it once that is done.
# Beaten (its health, stand_health.gd, reaching 0), begin_death() does the same with its death animation.
# Hits reach its health through take_stand_hit().
# Carrying its user across the water (stand_ride.gd), it swims: set_swimming() tells the visuals to lie it
# face down and play its swim instead of hovering.
# Generated by Claude Code.
extends Node3D

## The body stopped standing and became a floppy ragdoll.
signal went_limp
## The body stiffened into its standing pose (pose_upright()): every part's mesh now hangs off the torso,
## named "<part>Mesh" (see get_part_mesh()).
signal posed
## The stand is being sent back: its unsummon animation should play now (see begin_unsummon()).
signal unsummoning
## The stand was beaten: its death animation should play now (see begin_death()).
signal dying
## It started or stopped swimming (see set_swimming()).
signal swimming_changed(swimming: bool)
## Its standing body was grown or shrunk (see grow()); `size` is the new size, 1 as built.
signal resized(size: float)

const StandBodyModel := preload("res://Scripts/Stands/stand_body_model.gd")
const Buoyancy := preload("res://Scripts/Water/buoyancy.gd")

enum HeadStyle { HUMAN, DOLPHIN, ANCHOVY, SQUID, MANTIS, LOBSTER, JELLYFISH }
const BELL_ALPHA := 0.3 ## How solid the jellyfish's clear bell is drawn...
const FRINGE_ALPHA := 0.9 ## ...and its fine white tentacles.

# [name, center in this node's space at scale 1 (origin at the hips, feet at y -0.95), capsule radius, capsule
# height, mass in kg]. The torso is the heaviest, so it's the stand's "core" (stand_shape.gd).
const PARTS := [
	["Torso", Vector3(0.0, 0.27, 0.0), 0.2, 0.74, 12.0],
	["Head", Vector3(0.0, 0.8, 0.0), 0.12, 0.28, 3.0],
	["UpperArmL", Vector3(-0.31, 0.4, 0.0), 0.075, 0.38, 1.5],
	["UpperArmR", Vector3(0.31, 0.4, 0.0), 0.075, 0.38, 1.5],
	["ForearmL", Vector3(-0.32, 0.12, 0.0), 0.065, 0.4, 1.2],
	["ForearmR", Vector3(0.32, 0.12, 0.0), 0.065, 0.4, 1.2],
	["ThighL", Vector3(-0.105, -0.25, 0.0), 0.1, 0.5, 3.0],
	["ThighR", Vector3(0.105, -0.25, 0.0), 0.1, 0.5, 3.0],
	["ShinL", Vector3(-0.105, -0.7, 0.0), 0.075, 0.5, 2.0],
	["ShinR", Vector3(0.105, -0.7, 0.0), 0.075, 0.5, 2.0],
]

# [part, the part it hangs from, pivot in this node's space at scale 1, twist axis (along the limb, away from its
# parent), swing limit in degrees, twist limit in degrees].
const JOINTS := [
	["Head", "Torso", Vector3(0.0, 0.64, 0.0), Vector3.UP, 35.0, 40.0],
	["UpperArmL", "Torso", Vector3(-0.3, 0.56, 0.0), Vector3.DOWN, 100.0, 40.0],
	["UpperArmR", "Torso", Vector3(0.3, 0.56, 0.0), Vector3.DOWN, 100.0, 40.0],
	["ForearmL", "UpperArmL", Vector3(-0.315, 0.24, 0.0), Vector3.DOWN, 70.0, 10.0],
	["ForearmR", "UpperArmR", Vector3(0.315, 0.24, 0.0), Vector3.DOWN, 70.0, 10.0],
	["ThighL", "Torso", Vector3(-0.105, -0.03, 0.0), Vector3.DOWN, 55.0, 15.0],
	["ThighR", "Torso", Vector3(0.105, -0.03, 0.0), Vector3.DOWN, 55.0, 15.0],
	["ShinL", "ThighL", Vector3(-0.105, -0.48, 0.0), Vector3.DOWN, 60.0, 10.0],
	["ShinR", "ThighR", Vector3(0.105, -0.48, 0.0), Vector3.DOWN, 60.0, 10.0],
]

@export var start_limp := false # Floppy from the start instead of standing frozen until hit.
@export var hit_impulse_scale := 0.3 # Share of a hitting arrow's velocity (per kg of arrow) passed on as a shove.
@export var body_scale := 1.5 # Size of the whole body: PARTS and JOINTS are laid out for 1.9 m tall at 1.
@export var animations: StandAnimationSet ## How this stand moves on screen; DefaultStandAnimations if empty.
@export var moves: StandMoveSet ## How this stand fights (stand_combat.gd); DefaultStandMoves if empty.
@export var max_health := 100.0 ## How much it can take before it dies (stand_health.gd).
@export var finisher: StandFinisher ## How it finishes a beaten stand's user (Scripts/Stands/Finisher/); StandFinisher if empty.
@export var skill_tree: SkillTree ## What its kind can learn (the Skills autoload); DefaultStandSkillTree if empty.
@export var clash: StandClash ## How it saves its user from a wild stand's charge (clash_director.gd); StandClash if empty.

@export_group("Fighting")
@export var fly_speed_scale := 1.0 ## Its flying speed, times (stand_controller.gd).
@export var dash_cooldown_scale := 1.0 ## Its dash cooldown, times.
@export var damage_scale := 1.0 ## The damage its hits do, times (stand_combat.gd).
@export var damage_taken_scale := 1.0 ## The damage hits on it do, times (stand_health.gd).
@export var dash_evades := false ## Hits miss it while it air-dashes (stand_health.gd).
@export var revives := 0 ## Times a fight it comes back instead of dying (the Jellyfish's Immortal, stand_health.gd)...
@export var revive_health := 0.3 ## ...at this share of its health.
@export var block_reflect := 0.0 ## Share of a blocked hit's damage sent back at the attacker (the Lobster's Shell Guard).
@export var molt_at := 0.0 ## Share of health at which it molts once a fight, if it can (the Lobster's Molt); 0 never.
@export var time_resist := false ## Its kind can move through a time stop, once learned (the Jellyfish's Timeless Drift, stand_status.gd).

@export_group("Look")
@export var head_style := HeadStyle.HUMAN ## The head and face the body wears.
@export var dorsal_fin := false ## A dolphin's fin standing out of the upper back.
@export var tentacles := false ## Four tentacles growing from the upper back (a squid's).

@export_group("Palette")
@export var skin := Color(0.66, 0.66, 0.68) # The whole body.
@export var definition := Color(0.3, 0.3, 0.33) # Grooves between muscles.
@export var eyes := Color(0.97, 0.97, 0.97)
@export var underside := Color(0.85, 0.88, 0.92) # Pale jaw and throat (dolphin head).

var torso: RigidBody3D

var _parts: Array[RigidBody3D] = []
var _joints: Array[Joint3D] = []
var _limp := false
var _unsummon_target: Node3D
var _unsummon_offset := Vector3.ZERO
var _dying := false
var _swimming := false
var _size := 1.0 # How much grow() has grown the standing body.


func _ready() -> void:
	var material := PhysicsMaterial.new()
	material.friction = 0.8
	for spec: Array in PARTS:
		_parts.append(_make_part(spec, material))
	torso = get_node("Torso")
	_make_joints()
	_limp = start_limp
	for part in _parts:
		part.freeze = not start_limp


func is_limp() -> bool:
	return _limp


## Every body part.
func get_parts() -> Array[RigidBody3D]:
	return _parts


## Lets every part go, so the body collapses under physics. Safe to call from physics callbacks.
func go_limp() -> void:
	if _limp:
		return
	_limp = true
	for part in _parts:
		part.set_deferred("freeze", false)
	went_limp.emit()


## Called by an arrow that stuck into `part` while moving at `velocity`.
func on_arrow_hit(part: RigidBody3D, velocity: Vector3) -> void:
	go_limp()
	# Unfreezing is deferred, so push once it has happened.
	part.apply_central_impulse.call_deferred(velocity * hit_impulse_scale)


## Stiffens the body into its standing pose as a single rigid body: the limbs' shapes and meshes move
## onto the torso and the limb bodies and joints go. Call it outside physics callbacks.
func pose_upright() -> void:
	if _parts.size() <= 1:
		return
	for joint in _joints:
		joint.free()
	_joints.clear()
	torso.global_basis = global_basis # Upright, facing the way the whole stand faces.
	var torso_center: Vector3 = PARTS[0][1]
	torso.get_node("Mesh").name = "TorsoMesh"
	for i in range(1, PARTS.size()):
		var part := _parts[i]
		var offset: Vector3 = (PARTS[i][1] - torso_center) * body_scale
		for child in part.get_children():
			if child is CollisionShape3D or child is MeshInstance3D:
				if child is MeshInstance3D and child.name == "Mesh":
					child.name = "%sMesh" % part.name
				child.reparent(torso, false)
				child.transform = Transform3D(Basis(), offset)
		torso.mass += part.mass
		part.free()
	_parts = [torso]
	_limp = true
	torso.freeze = false
	posed.emit()


func _make_part(spec: Array, material: PhysicsMaterial) -> RigidBody3D:
	var part := RigidBody3D.new()
	part.name = spec[0]
	part.position = spec[1] * body_scale
	part.mass = spec[4]
	part.physics_material_override = material
	part.linear_damp = 0.5
	part.angular_damp = 1.0

	var capsule := CapsuleShape3D.new()
	capsule.radius = spec[2] * body_scale
	capsule.height = spec[3] * body_scale
	var shape := CollisionShape3D.new()
	shape.name = "CollisionShape3D"
	shape.shape = capsule
	part.add_child(shape)

	var mesh := MeshInstance3D.new()
	mesh.name = "Mesh"
	mesh.mesh = StandBodyModel.part_mesh(spec[0], spec[1], get_look())
	part.add_child(mesh)
	if spec[0] == "Head" and head_style == HeadStyle.JELLYFISH:
		part.add_child(_make_bell(spec[1]))
		part.add_child(_make_fringe(spec[1]))

	var buoyancy := Buoyancy.new()
	buoyancy.name = "Buoyancy"
	buoyancy.body_height = spec[3] * body_scale
	part.add_child(buoyancy)

	add_child(part)
	part.owner = self # So an arrow stuck in it finds on_arrow_hit() on this root.
	return part


# The jellyfish's clear bell over its head (stand_body_model.gd jelly_bell_mesh()): its own see-through,
# glassy material, so the red-orange stomach and the head inside show through it. It goes where the head's
# mesh goes ("BellMesh"); stand_body_visuals.gd moves it onto the neck with the head and fades it with the
# stand.
func _make_bell(center: Vector3) -> MeshInstance3D:
	var bell := MeshInstance3D.new()
	bell.name = "BellMesh"
	bell.mesh = StandBodyModel.jelly_bell_mesh(get_look(), center)
	var glass := StandardMaterial3D.new()
	glass.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA
	glass.vertex_color_use_as_albedo = true
	glass.albedo_color = Color(1.0, 1.0, 1.0, BELL_ALPHA)
	glass.roughness = 0.15
	glass.rim_enabled = true
	glass.rim = 0.6
	glass.cull_mode = BaseMaterial3D.CULL_DISABLED
	glass.depth_draw_mode = BaseMaterial3D.DEPTH_DRAW_DISABLED
	bell.material_override = glass
	bell.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	bell.set_meta("alpha", BELL_ALPHA)
	return bell


# The jellyfish's fine white tentacles round its bell (stand_body_model.gd jelly_fringe_mesh()): soft white,
# unshaded and without the ink outline, so strands that fine read as threads. Handled like the bell.
func _make_fringe(center: Vector3) -> MeshInstance3D:
	var fringe := MeshInstance3D.new()
	fringe.name = "FringeMesh"
	fringe.mesh = StandBodyModel.jelly_fringe_mesh(get_look(), center)
	var soft := StandardMaterial3D.new()
	soft.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
	soft.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA
	soft.vertex_color_use_as_albedo = true
	soft.albedo_color = Color(1.0, 1.0, 1.0, FRINGE_ALPHA)
	fringe.material_override = soft
	fringe.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	fringe.set_meta("alpha", FRINGE_ALPHA)
	return fringe


func _make_joints() -> void:
	for spec: Array in JOINTS:
		var joint := ConeTwistJoint3D.new()
		joint.name = "%sJoint" % spec[0]
		# A cone-twist joint twists about its local X axis, so turn X to point along the limb.
		joint.transform = Transform3D(Basis(Quaternion(Vector3.RIGHT, spec[3])), spec[2] * body_scale)
		add_child(joint)
		joint.node_a = joint.get_path_to(get_node(spec[1]))
		joint.node_b = joint.get_path_to(get_node(spec[0]))
		joint.set_param(ConeTwistJoint3D.PARAM_SWING_SPAN, deg_to_rad(spec[4]))
		joint.set_param(ConeTwistJoint3D.PARAM_TWIST_SPAN, deg_to_rad(spec[5]))
		_joints.append(joint)


## After pose_upright(), the mesh of the part called `part_name` (a name from PARTS), on the torso.
func get_part_mesh(part_name: String) -> MeshInstance3D:
	return torso.get_node_or_null("%sMesh" % part_name) as MeshInstance3D


## Where the part called `part_name` sits in the standing pose, relative to the torso's center.
func part_rest_position(part_name: String) -> Vector3:
	for spec: Array in PARTS:
		if spec[0] == part_name:
			return (spec[1] - PARTS[0][1]) * body_scale
	return Vector3.ZERO


## Where the joint that `part_name` hangs from sits in the standing pose, relative to the torso's center.
func joint_rest_position(part_name: String) -> Vector3:
	for spec: Array in JOINTS:
		if spec[0] == part_name:
			return (spec[2] - PARTS[0][1]) * body_scale
	return Vector3.ZERO


## This stand's animations (DefaultStandAnimations if none were given).
func get_animations() -> StandAnimationSet:
	if animations == null:
		animations = DefaultStandAnimations.new()
	return animations


## Starts sending the stand back to `target` (its user): the body freezes where it is and the unsummon
## animation plays, ending at `target` plus `offset` (e.g. the top of the user's head) if it flies there.
## Returns how many seconds that takes; the caller stores the stand afterward.
func begin_unsummon(target: Node3D, offset := Vector3.ZERO) -> float:
	_unsummon_target = target
	_unsummon_offset = offset
	torso.freeze = true
	torso.linear_velocity = Vector3.ZERO
	unsummoning.emit()
	var unsummon := get_animations().unsummon
	return unsummon.duration if unsummon else 0.0


## Starts the stand's death: the body freezes where it is and `dying` tells the visuals to play the
## death animation (which holds its end). Returns how many seconds that takes; the caller (possession.gd)
## stores the stand afterward.
func begin_death() -> float:
	_dying = true
	torso.freeze = true
	torso.linear_velocity = Vector3.ZERO
	dying.emit()
	var death := get_animations().death
	return death.duration if death else 0.0


## Whether begin_death() has been called.
func is_dying() -> bool:
	return _dying


## Starts or stops it swimming at the surface, carrying its user (stand_ride.gd); the visuals play its swim.
func set_swimming(swimming: bool) -> void:
	if swimming == _swimming:
		return
	_swimming = swimming
	swimming_changed.emit(swimming)


func is_swimming() -> bool:
	return _swimming


## Something hit the stand (the same dictionary stand_combat.gd hits with): its health takes it.
func take_stand_hit(hit: Dictionary) -> void:
	var health := get_node_or_null("Health")
	if health:
		health.take_hit(hit)


## After pose_upright(), makes the standing body `size` times as big as it was built (1 puts it back):
## its collision grows about the torso's center, and `resized` tells the visuals and anything that
## measured it (stand_shape.gd size()) to catch up.
func grow(size: float) -> void:
	if is_equal_approx(size, _size) or torso == null:
		return
	var factor := size / _size
	_size = size
	for child in torso.get_children():
		if child is CollisionShape3D and child.shape is CapsuleShape3D:
			var capsule := (child.shape as CapsuleShape3D).duplicate() as CapsuleShape3D
			capsule.radius *= factor
			capsule.height *= factor
			child.shape = capsule
			child.position *= factor
	resized.emit(size)


## How much grow() has grown it (1 as built).
func get_size() -> float:
	return _size


## Whether begin_unsummon() has been called.
func is_unsummoning() -> bool:
	return _unsummon_target != null


## Where an unsummon that flies home ends: the target's position plus its offset.
func unsummon_target_position() -> Vector3:
	if _unsummon_target == null or not is_instance_valid(_unsummon_target):
		return torso.global_position
	return _unsummon_target.global_position + _unsummon_offset


## How this stand looks, for the model (stand_body_model.gd part_mesh(), tentacle_segment_mesh()).
func get_look() -> Dictionary:
	return {
		"scale": body_scale,
		"skin": skin,
		"definition": definition,
		"eyes": eyes,
		"underside": underside,
		"head": (["human", "dolphin", "anchovy", "squid", "mantis", "lobster", "jellyfish"] as Array[String])[head_style],
		"dorsal_fin": dorsal_fin,
		"tentacles": tentacles,
	}


## Its kind's skill tree: `skill_tree`, or the default if it has none.
func get_skill_tree() -> SkillTree:
	if skill_tree == null:
		skill_tree = DefaultStandSkillTree.new()
	return skill_tree


## Its finisher: `finisher`, or the default (a barrage) if it has none.
func get_finisher() -> StandFinisher:
	if finisher == null:
		finisher = StandFinisher.new()
	return finisher


## How it saves its user in a clash: `clash`, or the default (catching the fist, a right hook) if it has none.
func get_clash() -> StandClash:
	if clash == null:
		clash = StandClash.new()
	return clash


## This stand's moves (DefaultStandMoves if none were given).
func get_moves() -> StandMoveSet:
	if moves == null:
		moves = DefaultStandMoves.new()
	return moves
