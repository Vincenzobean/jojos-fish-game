# The final boss's fighting mind (Lord Verity's Still Water, the Mantis Shrimp Stand: stand_encounter.gd
# challenge()). It's a wild stand's brain (enemy_stand_brain.gd), reads, tactics and all, fighting in three
# phases that change as its health drops past PHASES' thresholds:
#
#   1. Patience (full health to 66%): baits and turtles, keeping the player out with Bubble Burst, and now
#      and then stops time (Stasis) for a short while, using it to land whatever it can reach.
#   2. Pressure (66% to 33%): rushes and zones, and stops time more often and for longer. Once time stops
#      it runs a routine: round behind the frozen player's stand, then a string of club blows into its
#      back, every one held until time moves (stand_health.gd), when they all land at once.
#   3. Desperation (below 33%): all-out rushing, its Club Strike super-armored, time stopped longest and
#      most often, the routine ending in a Cavitation Rush.
#
# Crossing a threshold it roars: it can't be hurt for roar_time (stand_health.gd invulnerable), stops
# fighting, and the player's stand is shoved back from it; `phase_changed` tells the visuals.
# The tells are honest: Stasis always plays its tell first (mantis_shrimp_stand_moves.gd), so dashing away
# from it puts the player out of the routine's reach, and blocking with its back covered stops what lands
# from the front.
# Gameplay only.
# Generated by Claude Code.
extends "res://Scripts/Stands/enemy_stand_brain.gd"

## It entered phase `phase` (0, 1 or 2): the roar.
signal phase_changed(phase: int)

## Per phase: the health share it ends at, the tactics it fights with, seconds time stays stopped, seconds
## between time stops and between Bubble Bursts, and club blows in the routine run while time is stopped
## (0: no routine, it just fights on).
const PHASES := [
	{"name": "Patience", "until": 0.66, "tactics": ["bait", "turtle"], "stasis_time": 1.5, "stasis_every": 15.0,
		"bubble_every": 6.0, "strikes": 0},
	{"name": "Pressure", "until": 0.33, "tactics": ["rush", "zone"], "stasis_time": 2.5, "stasis_every": 10.0,
		"bubble_every": 9.0, "strikes": 3},
	{"name": "Desperation", "until": 0.0, "tactics": ["rush"], "stasis_time": 3.5, "stasis_every": 7.0,
		"bubble_every": 12.0, "strikes": 4},
]

@export var roar_time := 1.4 ## Seconds it roars (and can't be hurt) on entering a phase.
@export var roar_push := 16.0 ## m/s the roar shoves the player's stand back.
@export var first_stasis := 8.0 ## Seconds into the fight before its first time stop.

## Its phase: 0, 1 or 2.
var phase := 0
## Seconds its next time stop lasts (time_stop_move.gd reads it).
var stasis_time := 1.5

var _stasis_wait := 0.0
var _bubble_wait := 0.0
var _roar_left := 0.0
var _routine := {} # While time is stopped: {"stage": "behind" or "strike", "left": blows, "wait": seconds, "side": 1 or -1}.
var _routined: TimeStop # The time stop the routine was run for (once each).


func setup(stand: Node3D, fight: Node3D, key := "") -> void:
	super(stand, fight, key)
	phase = 0
	stasis_time = PHASES[0]["stasis_time"]
	_stasis_wait = first_stasis
	_bubble_wait = PHASES[0]["bubble_every"] * 0.5
	var moves: StandMoveSet = stand.get_moves() if stand.has_method("get_moves") else null
	if moves and moves.heavy:
		moves.heavy.super_armor = false # Only from Desperation on.


## The phase's name ("Patience", "Pressure", "Desperation").
func phase_name() -> String:
	return PHASES[phase]["name"]


## Whether it's roaring (between phases).
func is_roaring() -> bool:
	return _roar_left > 0.0


func stop() -> void:
	_routine = {}
	_roar_left = 0.0
	var health: Node = _stand.get_node_or_null("Health") if _stand else null
	if health:
		health.invulnerable = false
	super()


func _physics_process(delta: float) -> void:
	if _stand == null or not is_instance_valid(target):
		super(delta)
		return
	if _roar_left > 0.0:
		_roar_left -= delta
		input.set_move(Vector2.ZERO)
		if _roar_left <= 0.0:
			var health: Node = _stand.get_node_or_null("Health")
			if health:
				health.invulnerable = false
		return
	_check_phase()
	if _roar_left > 0.0:
		return
	var stop_now := TimeStop.current()
	if stop_now and stop_now.user == _stand and stop_now != _routined and int(PHASES[phase]["strikes"]) > 0 \
			and target not in stop_now.resisting: # A target moving through the stop (Timeless Drift) isn't there to be got behind.
		_routined = stop_now
		_routine = {"stage": "behind", "left": int(PHASES[phase]["strikes"]), "wait": 0.0, "side": 1.0 if randf() < 0.5 else -1.0}
	if not _routine.is_empty():
		if stop_now == null or stop_now.user != _stand:
			_end_routine()
		else:
			_run_routine(delta)
			return
	super(delta)
	_stasis_wait -= delta
	_bubble_wait -= delta
	var combat: Node = _stand.get_node_or_null("Combat")
	var idle: bool = combat != null and combat.get_move() == null and _plan != Plan.ATTACK
	if not idle or TimeStop.is_active():
		return
	if _stasis_wait <= 0.0:
		input.tap(&"boss_time_stop")
		_stasis_wait = float(PHASES[phase]["stasis_every"]) * randf_range(0.85, 1.15)
	elif _bubble_wait <= 0.0 and _distance() > 1.3:
		input.tap(&"boss_bubble")
		_bubble_wait = float(PHASES[phase]["bubble_every"]) * randf_range(0.8, 1.2)


# --- Phases ----------------------------------------------------------------------------------------------

func _check_phase() -> void:
	var health: Node = _stand.get_node_or_null("Health")
	if health == null or health.is_dead():
		return
	var share: float = health.health / maxf(health.max_health, 1.0)
	if phase < PHASES.size() - 1 and share <= float(PHASES[phase]["until"]):
		_enter_phase(phase + 1)


# A new phase: its time stops, its tactics (from the next round, which starts now), and the roar.
func _enter_phase(next: int) -> void:
	phase = next
	stasis_time = PHASES[phase]["stasis_time"]
	_stasis_wait = minf(_stasis_wait, 3.0) # It shows off its new power soon after.
	_bubble_wait = float(PHASES[phase]["bubble_every"]) * 0.5
	if phase == PHASES.size() - 1:
		var moves: StandMoveSet = _stand.get_moves() if _stand.has_method("get_moves") else null
		if moves and moves.heavy:
			moves.heavy.super_armor = true
	_routine = {}
	input.release_all()
	_heavy_hold = 0.0
	_presses_left = 0
	_set_plan(Plan.NEUTRAL)
	_start_round()
	_roar_left = roar_time
	var health: Node = _stand.get_node_or_null("Health")
	if health:
		health.invulnerable = true
	# The roar shoves the player's stand away.
	var torso: Node3D = target.get("torso")
	var controller: Node = target.get_node_or_null("Controller")
	if torso and controller and controller.has_method("lunge"):
		var away := StandShape.flat(torso.global_position - StandShape.center_of_mass(_bodies))
		controller.lunge(away, roar_push, 0.25)
	phase_changed.emit(phase)


# Each round's tactic, from the ones its phase fights with: the one StandMemory likes best if it's one
# of them, otherwise any of them.
func _start_round() -> void:
	var allowed: Array = PHASES[phase]["tactics"]
	var picked := StandMemory.pick_tactic(memory_key) if memory_key != "" else ""
	_tactic = picked if picked in allowed else allowed.pick_random()
	_round_left = round_time
	_dealt = 0.0
	_taken = 0.0
	_attack_wait = randf_range(_setting("wait_min"), _setting("wait_max"))
	tactic_changed.emit(_tactic)


# --- The routine while time is stopped -----------------------------------------------------------------

# Round behind the frozen stand (behind it and a little to one side), then the blows into its back.
func _run_routine(delta: float) -> void:
	var torso: Node3D = target.get("torso")
	if torso == null or not is_instance_valid(torso):
		_end_routine()
		return
	var here := StandShape.center_of_mass(_bodies)
	var back := -StandShape.facing(torso)
	var right := back.cross(Vector3.UP)
	var spot: Vector3 = torso.global_position + (back * attack_distance + right * 0.15 * float(_routine["side"])) * _size
	input.set_climb(clampf((torso.global_position.y - here.y) / maxf(_size * 0.3, 0.1), -1.0, 1.0))
	var to_target := torso.global_position - here
	if Vector3(to_target.x, 0.0, to_target.z).length() > 0.05:
		yaw = atan2(-to_target.x, -to_target.z)
	match _routine["stage"]:
		"behind":
			var to_spot := spot - here
			to_spot.y = 0.0
			if to_spot.length() < 0.35 * _size:
				_routine["stage"] = "strike"
				input.set_move(Vector2.ZERO)
				return
			var local := Basis(Vector3.UP, yaw).inverse() * to_spot.normalized()
			input.set_move(Vector2(local.x, local.z))
			if to_spot.length() > 1.5 * _size and _dash_wait <= 0.0:
				_dash()
		"strike":
			input.set_move(Vector2.ZERO)
			_routine["wait"] = float(_routine["wait"]) - delta
			if float(_routine["wait"]) > 0.0:
				return
			if int(_routine["left"]) > 0:
				input.tap(&"light_attack")
				_routine["left"] = int(_routine["left"]) - 1
				_routine["wait"] = 0.3
			elif phase == PHASES.size() - 1:
				input.hold(&"light_attack", true) # Into the Cavitation Rush until time moves.
				_routine["stage"] = "rush"
			else:
				input.tap(&"heavy_attack")
				_routine["stage"] = "done"
		"rush", "done":
			input.set_move(Vector2.ZERO)


func _end_routine() -> void:
	_routine = {}
	input.release_all()
	_set_plan(Plan.BACK_OFF)


# How far the target is, in lengths of the stand.
func _distance() -> float:
	var torso: Node3D = target.get("torso")
	if torso == null:
		return 0.0
	var to := torso.global_position - StandShape.center_of_mass(_bodies)
	return Vector2(to.x, to.z).length() / maxf(_size, 0.01)
