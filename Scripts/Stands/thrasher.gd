# Makes a hooked stand thrash, whatever it is: one rigid body or many joined ones, any shape, any size.
# Fishing (fishing.gd) adds one to every stand it spawns and calls setup(); the thrasher finds every
# RigidBody3D in the stand and measures how big it is (stand_shape.gd), and that's all it needs to know
# about the model.
#
# Thrashing comes in bursts (thrash_time_*) with calm spells between them (calm_time_*), at the same
# strength for the whole fight. `intensity` rises quickly into a burst and falls off in the calm, and
# fishing reads it to slow the reel.
#
# During a burst, every short beat picks a new main direction (mostly horizontal but leaning upward so
# stands leap out of the water, and leaning away from whatever the stand is pulling against) and kicks
# every body:
#   * a shared kick along that direction plus a random kick of its own (so jointed stands flail at
#     the joints), both in body lengths per second of the stand's size, so a small stand and a big crate
#     look just as violent for their size;
#   * a random spin in radians per second (independent of size), so single-body stands twist and roll.
# Kicks change velocity directly rather than applying impulses, so mass doesn't matter either. Each
# beat keeps only part of the previous motion (beat_carry), so the thrashing stays bounded, and water
# drag from each body's Buoyancy calms it between bursts.
#
# Stands can only kick off the water: a body in mid-air gets no kicks, so a leap arcs and falls back.
# And they're kept near the surface, so a leap doesn't end in a deep plunge that can trap them under an
# island: kicks never point downward, a body falling back into the water is braked hard
# (plunge_braking), and no body may go deeper than max_depth (in lengths of the stand) below the surface.
# Generated by Claude Code.
extends Node

## A burst of thrashing began.
signal thrash_started
## The stand went calm.
signal thrash_ended

const StandShape := preload("res://Scripts/Stands/stand_shape.gd")

@export_group("Rhythm")
@export var thrash_time_min := 1.0 # Seconds a burst lasts, at the least...
@export var thrash_time_max := 2.0 # ...and at the most.
@export var calm_time_min := 1.5 # Seconds of calm between bursts, at the least...
@export var calm_time_max := 3.0 # ...and at the most.
@export var attack := 6.0 # Intensity gained per second going into a burst (from calm to full in 1/attack s).
@export var release := 2.5 # Intensity lost per second going calm.

@export_group("Motion")
@export var beat_time_min := 0.1 # Seconds between kicks during a burst, at the least...
@export var beat_time_max := 0.25 # ...and at the most.
@export var thrash_speed := 9.0 # Body lengths per second of the shared kick at full intensity.
@export var flail_speed := 6.0 # Body lengths per second of each body's own random kick.
@export var thrash_spin := 35.0 # Radians per second of random spin per kick.
@export var away_bias := 0.6 # How strongly kicks lean away from what the stand pulls against (0 = any way).
@export var vertical_kick := 1.2 # How much the kick direction leans upward (never down), so stands leap; 0 keeps kicks flat.
@export var beat_carry := 0.55 # Share of a body's motion kept at each kick (the rest is replaced by the kick).

@export_group("Water")
@export var water_reach := 0.25 # A body can only kick while no higher than this above the surface, in lengths of the stand.
@export var max_depth := 0.5 # Deepest any body may go below the surface, in lengths of the stand.
@export var plunge_braking := 10.0 # How fast a body falling into the water loses its downward speed (per second).
@export var resurface_speed := 4.0 # Upward speed per meter a body is below max_depth, pushing it back up.

## How hard the stand is thrashing right now, 0 (calm) to 1 (full burst). Read-only outside this script.
var intensity := 0.0
## The stand's size in meters: the longest side of the box around all its collision shapes.
var size := 1.0

var _root: Node3D
var _bodies: Array[RigidBody3D] = []
var _pull_from: Node3D
var _thrashing := false
var _phase_left := 0.0
var _beat_left := 0.0
var _water: Node


## Takes charge of `stand_root`. `pull_from` is what the stand fights against (the bow); kicks lean away
## from it. The stand must already be in the scene tree, so its size can be measured.
func setup(stand_root: Node3D, pull_from: Node3D = null) -> void:
	_root = stand_root
	_pull_from = pull_from
	_bodies = StandShape.bodies(stand_root)
	size = StandShape.size(stand_root)
	_water = get_tree().get_first_node_in_group("water")
	# A bite starts with a burst.
	_thrashing = true
	_phase_left = randf_range(thrash_time_min, thrash_time_max)
	thrash_started.emit()


func is_thrashing() -> bool:
	return _thrashing


func get_bodies() -> Array[RigidBody3D]:
	return _bodies


## The mass-weighted middle of all the stand's bodies, in world space.
func center_of_mass() -> Vector3:
	return StandShape.center_of_mass(_bodies, _root.global_position)


## The stand's body closest to `point`, e.g. the one to hook the arrow into.
func nearest_body(point: Vector3) -> RigidBody3D:
	return StandShape.nearest(_bodies, point)


func _physics_process(delta: float) -> void:
	if _root == null:
		return
	_phase_left -= delta
	if _phase_left <= 0.0:
		_thrashing = not _thrashing
		if _thrashing:
			_phase_left = randf_range(thrash_time_min, thrash_time_max)
			thrash_started.emit()
		else:
			_phase_left = randf_range(calm_time_min, calm_time_max)
			thrash_ended.emit()
	intensity = move_toward(intensity, 1.0 if _thrashing else 0.0, (attack if _thrashing else release) * delta)
	StandShape.keep_near_surface(_bodies, size, _water, delta, max_depth, plunge_braking, resurface_speed)

	if intensity <= 0.0:
		return
	_beat_left -= delta
	if _beat_left > 0.0:
		return
	_beat_left = randf_range(beat_time_min, beat_time_max)
	_kick()


func _kick() -> void:
	var direction := _beat_direction()
	for body in _bodies:
		if not is_instance_valid(body) or not _touches_water(body):
			continue
		body.sleeping = false
		var kick := (direction * thrash_speed + _random_unit() * flail_speed) * size * intensity
		body.linear_velocity = body.linear_velocity * beat_carry + kick
		body.angular_velocity = body.angular_velocity * beat_carry + _random_unit() * thrash_spin * intensity


# A stand can only push off the water: bodies in mid-air (more than water_reach of the stand's length
# above the surface) get no kicks, so leaps arc and fall instead of climbing on every beat.
func _touches_water(body: RigidBody3D) -> bool:
	if _water == null:
		return true
	return body.global_position.y < _water.surface_height_at(body.global_position) + water_reach * size


# Mostly horizontal (never downward), leaning away from what the stand pulls against.
func _beat_direction() -> Vector3:
	var flat := Vector2.from_angle(randf() * TAU)
	var direction := Vector3(flat.x, 0.0, flat.y)
	if _pull_from:
		var away := center_of_mass() - _pull_from.global_position
		away.y = 0.0
		if away.length() > 0.01:
			direction = (direction + away.normalized() * away_bias).normalized()
	direction.y = randf() * vertical_kick
	return direction.normalized()


func _random_unit() -> Vector3:
	return Vector3(randf_range(-1.0, 1.0), randf_range(-1.0, 1.0), randf_range(-1.0, 1.0)).normalized()
