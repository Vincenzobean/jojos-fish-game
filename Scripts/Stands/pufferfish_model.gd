# The tutorial pufferfish as a 3D model, for the Dolphin Stand to keep floating beside it
# (floating_companion.gd). Built in code like the stand bodies (stand_body_model.gd's Builder) and drawn
# with the same manga shading and ink outline, colored after the pufferfish on the arrow: a round body,
# orange on top with white spots and pale underneath with brown spots, big eyes, a small puckered mouth,
# orange fins and tail. It faces -Z. The mesh is built once and shared.
# Purely presentation.
# Generated by Claude Code.
extends MeshInstance3D

const StandBodyModel := preload("res://Scripts/Stands/stand_body_model.gd")

const ORANGE := Color(0.95, 0.52, 0.16)
const FIN := Color(0.98, 0.66, 0.25)
const FIN_EDGE := Color(0.8, 0.35, 0.1)
const BELLY := Color(0.93, 0.89, 0.74)
const SPOT := Color(0.99, 0.97, 0.9)
const FRECKLE := Color(0.52, 0.32, 0.22)
const EYE := Color(0.98, 0.95, 0.75)
const PUPIL := Color(0.08, 0.06, 0.06)

@export var size := 0.55 ## Meters across.

static var _mesh: ArrayMesh


func _ready() -> void:
	if _mesh == null:
		_mesh = _build()
	mesh = _mesh
	scale = Vector3.ONE * size
	cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_ON


# Laid out 1 unit across, facing -Z.
static func _build() -> ArrayMesh:
	var b := StandBodyModel.Builder.new()
	# The body: a pale ball with an orange cap over its top two thirds, so the belly shows below.
	b.ellipsoid(Vector3.ZERO, Vector3(0.5, 0.46, 0.5), BELLY, 5, 10)
	b.ellipsoid(Vector3(0.0, 0.07, 0.0), Vector3(0.515, 0.41, 0.515), ORANGE, 5, 10)
	# White spots scattered over the orange, brown freckles over the belly.
	var golden := PI * (3.0 - sqrt(5.0)) # Spreads points evenly round a sphere.
	for i in 40:
		var y := 1.0 - 2.0 * (i + 0.5) / 40.0
		var ring := sqrt(1.0 - y * y)
		var direction := Vector3(cos(golden * i) * ring, y, sin(golden * i) * ring)
		if direction.z < -0.55 and absf(direction.y) < 0.5:
			continue # Keep the face clear.
		var on_top := direction.y > -0.25
		var point := Vector3(direction.x * 0.5, direction.y * (0.4 if on_top else 0.45) + (0.07 if on_top else 0.0), direction.z * 0.5) # Sunk into the skin.
		b.ellipsoid(point, Vector3.ONE * (0.04 if on_top else 0.028), SPOT if on_top else FRECKLE, 3, 6)
	# Big eyes on the front of the face.
	for s in [-1.0, 1.0]:
		b.ellipsoid(Vector3(s * 0.24, 0.17, -0.38), Vector3(0.13, 0.13, 0.1), EYE, 3, 8)
		b.ellipsoid(Vector3(s * 0.27, 0.17, -0.47), Vector3(0.06, 0.07, 0.03), PUPIL, 2, 6)
	# A small puckered mouth.
	b.ellipsoid(Vector3(0.0, -0.05, -0.5), Vector3(0.085, 0.07, 0.06), ORANGE, 3, 8)
	b.ellipsoid(Vector3(0.0, -0.05, -0.55), Vector3(0.035, 0.03, 0.02), PUPIL, 2, 6)
	# Fins: a fan-shaped tail, a little dorsal fin, and a side fin either side.
	b.fin([Vector3(0.0, 0.05, 0.42), Vector3(0.0, 0.3, 0.72), Vector3(0.0, 0.08, 0.66), Vector3(0.0, -0.18, 0.72)], 0.06, FIN, FIN_EDGE, 1)
	b.fin([Vector3(0.0, 0.42, -0.05), Vector3(0.0, 0.6, 0.12), Vector3(0.0, 0.43, 0.22)], 0.05, FIN, FIN_EDGE, 1)
	for s in [-1.0, 1.0]:
		b.ellipsoid(Vector3(s * 0.5, 0.0, 0.05), Vector3(0.05, 0.13, 0.16), FIN, 3, 6)
	return b.commit(StandBodyModel.material())
