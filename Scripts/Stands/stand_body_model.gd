# Inside the clear bell (jelly_bell_mesh()): a slim neck, the bright red-orange stomach (manubrium) hanging
# in the middle of the bell with its four lobes, the canals out to the rim, the rim ring, and a red bulb at
# the root of each tentacle (the tentacles themselves are jelly_fringe_mesh(), drawn soft and white).
static func _jelly_head(b: Builder, skin: Color, accent: Color) -> void:
	b.loft([[0.61, 0.07, 0.065, 0.01], [0.74, 0.06, 0.055, 0.0]], skin) # Neck.
	b.ellipsoid(Vector3(0.0, 0.86, 0.0), Vector3(0.065, 0.085, 0.065), accent, 4, 8) # Stomach...
	for i in 4:
		var angle := TAU * i / 4.0 + PI * 0.25
		b.ellipsoid(Vector3(cos(angle) * 0.045, 0.79, sin(angle) * 0.045), Vector3(0.028, 0.04, 0.028), accent.darkened(0.15), 2, 6) # ...its lobes...
		_rod(b, Vector3(0.0, 0.92, 0.0), Vector3(cos(angle) * JELLY_RIM_RADIUS * 0.92, JELLY_RIM_Y + 0.02, sin(angle) * JELLY_RIM_RADIUS * 0.92),
			0.006, accent, 6) # ...and the canals out to the rim.
	b.loft([[JELLY_RIM_Y - 0.008, JELLY_RIM_RADIUS, JELLY_RIM_RADIUS, 0.0], [JELLY_RIM_Y + 0.008, JELLY_RIM_RADIUS, JELLY_RIM_RADIUS, 0.0]], skin) # Rim.
	for i in JELLY_TENTACLES:
		var angle := TAU * i / JELLY_TENTACLES
		var root := Vector3(cos(angle) * JELLY_RIM_RADIUS, JELLY_RIM_Y, sin(angle) * JELLY_RIM_RADIUS)
		b.ellipsoid(root + Vector3.DOWN * 0.006, Vector3(0.009, 0.009, 0.009), accent, 2, 4) # Each tentacle's red bulb at the rim.


## The jellyfish's fringe of fine white tentacles hanging all round its bell's rim, uneven like hair and
## flaring out a little: thin strands drawn soft white with no ink outline by stand_body.gd (outlined, strands
## this fine would turn to a black ruff). Centered on the head part like its other meshes.
static func jelly_fringe_mesh(look: Dictionary, center: Vector3) -> ArrayMesh:
	var key := "JellyFringe|%s" % [look]
	if _cache.has(key):
		return _cache[key]
	var b := Builder.new()
	b.offset = center
	b.scale = look["scale"]
	var white := Color(0.98, 0.97, 0.95)
	for i in JELLY_TENTACLES:
		var angle := TAU * i / JELLY_TENTACLES
		var out := Vector3(cos(angle), 0.0, sin(angle))
		var root := out * JELLY_RIM_RADIUS + Vector3.UP * (JELLY_RIM_Y - 0.01)
		var length := 0.22 + 0.14 * float((i * 7) % 5) / 4.0 # Uneven, like hair.
		var bend := root + out * 0.03 + Vector3.DOWN * length * 0.5
		var tip := root + out * 0.05 + Vector3.DOWN * length + Vector3(0.0, 0.0, 0.02 * sin(i * 1.7))
		_rod(b, root, bend, 0.0035, white, 3)
		_rod(b, bend, tip, 0.0028, white, 3)
	var mesh := b.commit(_shared_material())
	_cache[key] = mesh
	return mesh


## The jellyfish's clear bell (for `look`'s "scale"), centered on the head part like its other meshes: drawn
## see-through by stand_body_visuals.gd over the opaque head (_jelly_head()), so the stomach shows inside.
static func jelly_bell_mesh(look: Dictionary, center: Vector3) -> ArrayMesh:
	var key := "JellyBell|%s" % [look]
