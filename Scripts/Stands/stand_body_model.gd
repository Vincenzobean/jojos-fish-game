			b.box(Vector3(side * 0.105, -0.915, -0.06), Vector3(0.1, 0.07, 0.26), accent) # Orange feet.


# A lobster's head: a long armored head plate reaching forward into a spiked rostrum, small black eyes on
# short stalks either side of it, two very long antennae sweeping out and back, a pair of short forked
# antennules in front, and orange mouthparts.
static func _lobster_head(b: Builder, skin: Color, definition: Color, accent: Color, eyes: Color) -> void:
	b.loft([[0.61, 0.095, 0.09, 0.01], [0.7, 0.09, 0.085, 0.0]], skin) # Neck.
