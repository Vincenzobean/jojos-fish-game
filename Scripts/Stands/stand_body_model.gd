	b.offset = center
	b.scale = look["scale"]
	var r := JELLY_RIM_RADIUS
	b.loft([
		[JELLY_RIM_Y, r, r, 0.0],
		[JELLY_RIM_Y + 0.07, r * 1.04, r * 1.04, 0.0],
		[JELLY_RIM_Y + 0.17, r * 0.95, r * 0.95, 0.0],
		[JELLY_RIM_Y + 0.25, r * 0.72, r * 0.72, 0.0],
		[JELLY_RIM_Y + 0.3, r * 0.38, r * 0.38, 0.0],
		[JELLY_RIM_Y + 0.315, 0.0, 0.0, 0.0],
	], Color(0.94, 0.95, 1.0))
	var mesh := b.commit(_shared_material())
	_cache[key] = mesh
	return mesh


# A thin rod from `from` to `to`, `radius` thick, as a row of `count` small beads.
static func _rod(b: Builder, from: Vector3, to: Vector3, radius: float, color: Color, count: int) -> void:
	for i in count:
		var t := (float(i) + 0.5) / count
		var length := from.distance_to(to) / count
		var along := (to - from).normalized()
		var radii := Vector3(radius, radius, radius) + along.abs() * length * 0.55
		b.ellipsoid(from.lerp(to, t), radii, color, 2, 5)


## One segment of a tentacle for `look` (its "scale", "skin" and "definition"): the `index`th of
## TENTACLE_SEGMENTS from the root, hanging straight down from its top at the origin. The arm tapers
## down its first segments, a sucker on the outer (+Z) face of each; the last is the club, the hand at the
## end of a squid's tentacle: widened and flattened, its outer face lined with suckers, coming to a point.
static func tentacle_segment_mesh(look: Dictionary, index: int) -> ArrayMesh:
	var key := "Tentacle%d|%s" % [index, look]
	if _cache.has(key):
		return _cache[key]
	var skin: Color = look["skin"]
	var definition: Color = look["definition"]
	var b := Builder.new()
	b.scale = look["scale"]
	var arm := TENTACLE_SEGMENTS - 1
	var length := TENTACLE_SEGMENT_LENGTH
	var w := TENTACLE_THICKNESS
	if index < arm:
		var top := lerpf(0.032, 0.013, float(index) / arm) * w
		var bottom := lerpf(0.032, 0.013, float(index + 1) / arm) * w
		b.loft([[0.0, top, top, 0.0], [-length * 0.5, (top + bottom) * 0.5, (top + bottom) * 0.48, 0.0], [-length, bottom, bottom, 0.0]], skin)
		for y in [0.3, 0.7]:
			var r := (top + bottom) * 0.22
			b.ellipsoid(Vector3(0.0, -length * y, (top + bottom) * 0.45), Vector3(r, r, r * 0.5), definition, 2, 5) # Sucker.
	else:
		var c := CLUB_LENGTH / 0.13 # The club's outline, laid out for 0.13 long.
		b.loft([
			[0.0, 0.013 * w, 0.013 * w, 0.0],
			[-0.03 * c, 0.03 * w, 0.015 * w, 0.0],
			[-0.07 * c, 0.032 * w, 0.014 * w, 0.0],
			[-0.1 * c, 0.02 * w, 0.01 * w, 0.0],
			[-CLUB_LENGTH, 0.003 * w, 0.003 * w, 0.0],
		], skin) # The club, flat across X.
		for row in 4:
			for x in [-0.012, 0.012]:
				b.ellipsoid(Vector3(x * w, (-0.025 - 0.02 * row) * c, 0.014 * w), Vector3(0.008, 0.008, 0.004) * w, definition, 2, 5) # Suckers.
	var mesh := b.commit(_shared_material())
	_cache[key] = mesh
	return mesh


