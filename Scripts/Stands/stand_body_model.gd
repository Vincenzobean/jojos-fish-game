## The stands' manga material (with its ink outline pass), for other things drawn in the same style,
## like a stand's floating pufferfish (pufferfish_model.gd), built with this script's Builder.
static func material() -> ShaderMaterial:
	return _shared_material()


static func _shared_material() -> ShaderMaterial:
	if _material == null:
		var outline := ShaderMaterial.new()
		outline.shader = OutlineShader
		_material = ShaderMaterial.new()
		_material.shader = MangaShader
		_material.next_pass = outline
	return _material


# Collects flat-shaded, vertex-colored triangles. Each primitive knows a point inside itself, so every
# face's normal (and winding) is turned to face away from it.
class Builder:
	var offset := Vector3.ZERO # Subtracted from every vertex: the part's center in the body's space.
	var scale := 1.0 # Then every vertex is grown by this.
	var _vertices := PackedVector3Array()
	var _normals := PackedVector3Array()
	var _colors := PackedColorArray()

	## A tapered tube through `rings` of [height, half width, half depth, z shift], closed at both ends,
	## around the vertical line at x = `x`.
	func loft(rings: Array, color: Color, x := 0.0) -> void:
		var points: Array[PackedVector3Array] = []
		for ring: Array in rings:
			var circle := PackedVector3Array()
			for i in SEGMENTS:
				var angle := TAU * (i + 0.5) / SEGMENTS
				circle.append(Vector3(x + cos(angle) * ring[1], ring[0], ring[3] + sin(angle) * ring[2]))
			points.append(circle)
		for r in points.size() - 1:
			var inside := Vector3(x, (rings[r][0] + rings[r + 1][0]) * 0.5, (rings[r][3] + rings[r + 1][3]) * 0.5)
			for i in SEGMENTS:
				var j := (i + 1) % SEGMENTS
				quad(points[r][i], points[r][j], points[r + 1][j], points[r + 1][i], inside, color)
		for end in [0, points.size() - 1]:
			var middle := Vector3(x, rings[end][0], rings[end][3])
			var inside := middle + (Vector3.UP if end == 0 else Vector3.DOWN) * 0.01 # Just inside the end cap.
			for i in SEGMENTS:
				triangle(middle, points[end][i], points[end][(i + 1) % SEGMENTS], inside, color)

	## A low-poly ellipsoid: `rings` bands from pole to pole, `segments` around.
	func ellipsoid(center: Vector3, radii: Vector3, color: Color, rings := 4, segments := 8) -> void:
		var grid: Array[PackedVector3Array] = []
		for r in rings + 1:
			var polar := PI * r / rings
			var band := PackedVector3Array()
			for s in segments:
				var angle := TAU * (s + 0.5 * (r % 2)) / segments
				band.append(center + Vector3(sin(polar) * cos(angle), cos(polar), sin(polar) * sin(angle)) * radii)
			grid.append(band)
		for r in rings:
			for s in segments:
				var t := (s + 1) % segments
				quad(grid[r][s], grid[r][t], grid[r + 1][t], grid[r + 1][s], center, color)

	func box(center: Vector3, size: Vector3, color: Color) -> void:
		var h := size * 0.5
		var c: Array[Vector3] = []
		for i in 8:
			c.append(center + Vector3(h.x if i & 1 else -h.x, h.y if i & 2 else -h.y, h.z if i & 4 else -h.z))
		for face in [[0, 1, 3, 2], [4, 5, 7, 6], [0, 1, 5, 4], [2, 3, 7, 6], [0, 2, 6, 4], [1, 3, 7, 5]]:
			quad(c[face[0]], c[face[1]], c[face[2]], c[face[3]], center, color)

	## A thin flat fin: the outline `points` (in order round its edge, all at x = their own x) made
	## `thickness` thick across x, thinning to a third of that at the outermost point. Edges from point
	## `edge_from` on round to the last point are `edge_color`, for a darker trailing edge.
	func fin(points: Array, thickness: float, color: Color, edge_color: Color, edge_from: int) -> void:
		var middle := Vector3.ZERO
		for p: Vector3 in points:
			middle += p
		middle /= points.size()
		var farthest := 0.0
		for p: Vector3 in points:
			farthest = maxf(farthest, p.distance_to(middle))
		var left: Array[Vector3] = []
		var right: Array[Vector3] = []
		for p: Vector3 in points:
			var half := thickness * 0.5 * lerpf(1.0, 0.33, p.distance_to(middle) / farthest)
			left.append(p + Vector3.LEFT * half)
			right.append(p + Vector3.RIGHT * half)
		var count := points.size()
		for i in count:
			var j := (i + 1) % count
			triangle(middle + Vector3.LEFT * thickness * 0.5, left[i], left[j], middle, color)
			triangle(middle + Vector3.RIGHT * thickness * 0.5, right[i], right[j], middle, color)
			quad(left[i], left[j], right[j], right[i], middle, edge_color if i >= edge_from and j != 0 else color)

	func quad(a: Vector3, b: Vector3, c: Vector3, d: Vector3, inside: Vector3, color: Color) -> void:
		triangle(a, b, c, inside, color)
		triangle(a, c, d, inside, color)

	func triangle(a: Vector3, b: Vector3, c: Vector3, inside: Vector3, color: Color) -> void:
		var normal := (b - a).cross(c - a)
		if normal.length_squared() < 1e-12:
			return # Collapsed (at an ellipsoid's pole).
		normal = normal.normalized()
		# Godot's front faces wind clockwise, i.e. their cross product points inward.
		if normal.dot((a + b + c) / 3.0 - inside) > 0.0:
			var swap := b
			b = c
			c = swap
		else:
			normal = -normal
		for v in [a, b, c]:
			_vertices.append((v - offset) * scale)
			_normals.append(normal)
			_colors.append(color)

	func commit(material: Material) -> ArrayMesh:
		# Smoothed normals (each corner's faces averaged, area-weighted) go in CUSTOM0, for the shaders'
		# lighting and outline. The flat face normals stay as the regular normals.
		var sums := {}
		for i in _vertices.size():
			var key := Vector3i((_vertices[i] * 10000.0).round())
			var face := (_vertices[i - i % 3 + 1] - _vertices[i - i % 3]).cross(_vertices[i - i % 3 + 2] - _vertices[i - i % 3])
			sums[key] = sums.get(key, Vector3.ZERO) + face.length() * _normals[i]
		var smooth := PackedFloat32Array()
		for i in _vertices.size():
			var n: Vector3 = sums[Vector3i((_vertices[i] * 10000.0).round())]
			n = n.normalized() if n.length_squared() > 0.0 else _normals[i]
			smooth.append_array([n.x, n.y, n.z, 0.0])
		var arrays := []
		arrays.resize(Mesh.ARRAY_MAX)
		arrays[Mesh.ARRAY_VERTEX] = _vertices
		arrays[Mesh.ARRAY_NORMAL] = _normals
		arrays[Mesh.ARRAY_COLOR] = _colors
		arrays[Mesh.ARRAY_CUSTOM0] = smooth
		var mesh := ArrayMesh.new()
		mesh.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, arrays, [], {},
			Mesh.ARRAY_CUSTOM_RGBA_FLOAT << Mesh.ARRAY_FORMAT_CUSTOM0_SHIFT)
		mesh.surface_set_material(0, material)
		return mesh
