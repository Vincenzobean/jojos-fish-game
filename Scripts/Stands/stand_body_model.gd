# The look of the shared stand body (stand_body.gd): one low-poly mesh per body part, built in code like
# the islands (island_generator.gd): vertex colors, no textures. It's drawn like a manga panel: hard
# cel-shaded light and shadow with ink hatching in the shadows (assets/stands/stand_manga.gdshader) and a
# dark ink outline (stand_outline.gdshader). Both shaders read smoothed normals that the builder stores
# in each mesh's CUSTOM0.
#
# The body is a bare, heavily muscled figure: a broad V-taper torso with pecs, a six-pack, traps and
# glutes; deltoids, biceps and triceps; thick forearms and fists; quads, kneecaps and calves. Each part
# is a tapered "loft" (a stack of 8-sided rings) whose profile swells where the big muscles bulge, with
# low-poly ellipsoids and blocks laid on for the pecs, abs, deltoids and the like, so everything reads
# as chunky facets. Grooves between muscles show a darker `definition` color.
#
# Stands vary the body through their `look`: the palette, the size, the head (a human face; a dolphin's,
# with a beak, melon forehead and pale underside; an anchovy's, slim and pointed with big eyes and a
# silver belly; a squid's, a tall mantle with side fins over big eyes; or a mantis shrimp's, an armored
# head with big banded eyes on stalks and long antennae, which also plates the whole body in a segmented
# carapace, swaps its fists for smashing clubs and fans a tail out behind its hips; a lobster's, a long
# armored head with a spiked rostrum, small black eyes on stalks and two very long antennae swept back,
# which plates the body in a heavy segmented shell, swaps its fists for a huge crusher claw (right) and a
# slim pincer (left) and fans a broad tail out behind; or the immortal jellyfish's (Turritopsis dohrnii),
# a clear bell for a head with its bright red-orange stomach showing inside, a fringe of fine white
# tentacles hanging all round the bell's rim, over a pale, slim body traced with red-orange canals, the
# bell itself drawn see-through by stand_body_visuals.gd from jelly_bell_mesh()), an optional dorsal fin on the
# back, and optional tentacles (tentacle_segment_mesh(), chained into curling tentacles ending in a club,
# grown from the upper back by stand_body_visuals.gd).
#
# Everything is authored in the body's own space at scale 1 (origin at the hips, facing -Z, feet at
# y -0.95), shifted so each part's mesh is centered on that part's rigid body, then grown by the body's
# scale. A part's mesh depends only on the part and the look, so meshes are cached and repeated stands
# share them.
# Generated by Claude Code.
extends RefCounted

const SEGMENTS := 8 # Sides of every loft ring.
const TENTACLE_SEGMENTS := 5 ## Pieces a tentacle is built from (tentacle_segment_mesh()): the arm's, then the club.
const TENTACLE_SEGMENT_LENGTH := 0.14 ## Length of each arm piece at scale 1...
const CLUB_LENGTH := 0.2 ## ...and of the club.
const TENTACLE_THICKNESS := 1.8 ## How much thicker than a slim tentacle they're built.
const MangaShader := preload("res://assets/stands/stand_manga.gdshader")
const OutlineShader := preload("res://assets/stands/stand_outline.gdshader")

static var _cache := {} # "part|look" -> ArrayMesh
static var _material: ShaderMaterial


## The mesh for the part called `part` (a name from stand_body.gd's PARTS), centered on `center` (the
## part's position in the body's space). `look` says how the stand looks: "scale" (float), the colors
## "skin", "definition", "eyes" and "underside", "head" ("human", "dolphin", "anchovy", "squid", "mantis",
## "lobster" or "jellyfish"),
## "dorsal_fin" and "tentacles" (bool).
static func part_mesh(part: String, center: Vector3, look: Dictionary) -> ArrayMesh:
	var key := "%s|%s" % [part, look]
	if _cache.has(key):
		return _cache[key]
	var skin: Color = look["skin"]
	var definition: Color = look["definition"]
	var b := Builder.new()
	b.offset = center
	b.scale = look["scale"]
	var side := -1.0 if part.ends_with("L") else 1.0
	var special := true
	match look["head"]:
		"mantis":
			_mantis_part(b, part.trim_suffix("L").trim_suffix("R"), side, skin, definition, look["underside"], look["eyes"])
		"lobster":
			_lobster_part(b, part.trim_suffix("L").trim_suffix("R"), side, skin, definition, look["underside"], look["eyes"])
		"jellyfish":
			_jelly_part(b, part.trim_suffix("L").trim_suffix("R"), side, skin, definition, look["underside"])
		_:
			special = false
	if special:
		var built := b.commit(_shared_material())
		_cache[key] = built
		return built
	match part.trim_suffix("L").trim_suffix("R"):
		"Torso":
			_torso(b, skin, definition)
			if look["dorsal_fin"]:
				_dorsal_fin(b, skin, definition)
		"Head":
			match look["head"]:
				"dolphin":
					_dolphin_head(b, skin, definition, look["underside"], look["eyes"])
				"anchovy":
					_anchovy_head(b, skin, definition, look["underside"], look["eyes"])
				"squid":
					_squid_head(b, skin, definition, look["underside"], look["eyes"])
				_:
					_head(b, skin, definition, look["eyes"])
		"UpperArm":
			_upper_arm(b, side, skin, definition)
		"Forearm":
			_forearm(b, side, skin, definition)
		"Thigh":
			_thigh(b, side, skin, definition)
		"Shin":
			_shin(b, side, skin, definition)
	var mesh := b.commit(_shared_material())
	_cache[key] = mesh
	return mesh


static func _torso(b: Builder, skin: Color, definition: Color) -> void:
	# Core: [height, half width, half depth, forward/back shift]. Wide shoulders and lats tapering to a
	# narrow waist.
	b.loft([
		[-0.09, 0.11, 0.08, 0.01],
		[-0.02, 0.155, 0.1, 0.01],
		[0.1, 0.13, 0.095, 0.0],
		[0.22, 0.165, 0.1, 0.0],
		[0.36, 0.215, 0.13, 0.0],
		[0.48, 0.245, 0.135, 0.0],
		[0.56, 0.25, 0.1, 0.01],
		[0.63, 0.13, 0.075, 0.015],
	], skin)
	# Chest: two pec slabs, with a dark backing just under them for the line between and below them.
	b.box(Vector3(0.0, 0.452, -0.13), Vector3(0.23, 0.125, 0.02), definition)
	for x in [-0.088, 0.088]:
		b.ellipsoid(Vector3(x, 0.46, -0.13), Vector3(0.12, 0.068, 0.032), skin, 3, 7)
	# Six-pack: a 2 x 3 grid of blocks, each on a slightly bigger dark block that shows as the lines
	# between them. [height, depth of the stomach's front there] keeps each row on the surface.
	for row in [[0.335, 0.125], [0.245, 0.106], [0.155, 0.098]]:
		for x in [-0.038, 0.038]:
			b.box(Vector3(x, row[0], -row[1]), Vector3(0.08, 0.09, 0.02), definition)
			b.box(Vector3(x, row[0], -row[1] - 0.008), Vector3(0.066, 0.078, 0.02), skin)
	for s in [-1.0, 1.0]:
		b.ellipsoid(Vector3(s * 0.1, 0.6, 0.02), Vector3(0.1, 0.05, 0.065), skin, 3, 7) # Trapezius.
		b.ellipsoid(Vector3(s * 0.075, -0.04, 0.065), Vector3(0.075, 0.075, 0.05), skin, 3, 7) # Glute.


# A dolphin's dorsal fin standing out of the upper back between the shoulder blades, swept down toward
# the waist like a dolphin's is swept toward its tail, with a curved leading edge and a hooked (concave)
# trailing edge in the darker `definition` color.
static func _dorsal_fin(b: Builder, skin: Color, definition: Color) -> void:
	b.fin([
		Vector3(0.0, 0.56, 0.1), # Top of the base, between the shoulder blades...
		Vector3(0.0, 0.47, 0.25), # ...the leading edge curving out...
		Vector3(0.0, 0.3, 0.38), # ...to the tip, swept down...
		Vector3(0.0, 0.31, 0.22), # ...back along the hooked trailing edge...
		Vector3(0.0, 0.27, 0.12), # ...to the bottom of the base.
	], 0.035, skin, definition, 2)


static func _head(b: Builder, skin: Color, definition: Color, eyes: Color) -> void:
	b.loft([[0.61, 0.085, 0.075, 0.01], [0.72, 0.07, 0.065, 0.0]], skin) # Neck.
	b.ellipsoid(Vector3(0.0, 0.84, 0.0), Vector3(0.1, 0.115, 0.11), skin, 4, 7) # Skull.
	b.ellipsoid(Vector3(0.0, 0.75, -0.025), Vector3(0.08, 0.055, 0.085), skin, 3, 6) # Jaw.
	b.box(Vector3(0.0, 0.855, -0.098), Vector3(0.15, 0.02, 0.022), skin) # Brow.
	b.box(Vector3(0.0, 0.795, -0.11), Vector3(0.02, 0.05, 0.03), skin) # Nose.
	for x in [-0.042, 0.042]:
		b.box(Vector3(x, 0.828, -0.1), Vector3(0.04, 0.014, 0.02), eyes)
	b.box(Vector3(0.0, 0.745, -0.108), Vector3(0.05, 0.008, 0.01), definition) # Mouth.


# A bottlenose dolphin's head on the same neck: a rounded skull with the bulging "melon" forehead, a
# long beak (rostrum) pointing forward, a pale lower jaw and throat in `underside` (where the dark upper
# jaw meets the pale lower one is its smile), small dark eyes set back on the sides, and a blowhole.
static func _dolphin_head(b: Builder, skin: Color, definition: Color, underside: Color, eyes: Color) -> void:
	b.loft([[0.61, 0.09, 0.08, 0.01], [0.72, 0.085, 0.08, 0.0]], skin) # Neck.
	b.ellipsoid(Vector3(0.0, 0.82, 0.02), Vector3(0.112, 0.112, 0.13), skin, 4, 8) # Skull.
	b.ellipsoid(Vector3(0.0, 0.86, -0.07), Vector3(0.095, 0.085, 0.095), skin) # Melon.
	b.ellipsoid(Vector3(0.0, 0.79, -0.19), Vector3(0.046, 0.034, 0.125), skin, 4, 8) # Beak, upper jaw...
	b.ellipsoid(Vector3(0.0, 0.765, -0.18), Vector3(0.044, 0.027, 0.13), underside, 4, 8) # ...lower jaw...
	b.ellipsoid(Vector3(0.0, 0.76, -0.04), Vector3(0.08, 0.045, 0.09), underside) # ...and throat.
	for s in [-1.0, 1.0]:
		b.ellipsoid(Vector3(s * 0.096, 0.815, -0.05), Vector3(0.017, 0.015, 0.019), eyes, 2, 6) # Eye.
	b.box(Vector3(0.0, 0.935, 0.04), Vector3(0.04, 0.01, 0.015), definition) # Blowhole.


# An anchovy's head on the same neck: long, slim and pointed, the snout overhanging a long lower jaw,
# a silver belly and throat in `underside`, a dark stripe along the top of the head, gill slits, and
# big round eyes near the front.
static func _anchovy_head(b: Builder, skin: Color, definition: Color, underside: Color, eyes: Color) -> void:
	b.loft([[0.61, 0.08, 0.08, 0.01], [0.72, 0.075, 0.08, 0.0]], skin) # Neck.
	b.ellipsoid(Vector3(0.0, 0.82, -0.03), Vector3(0.085, 0.095, 0.16), skin, 4, 8) # Head.
	b.ellipsoid(Vector3(0.0, 0.83, -0.17), Vector3(0.05, 0.05, 0.09), skin, 4, 8) # Snout, overhanging...
	b.ellipsoid(Vector3(0.0, 0.77, -0.13), Vector3(0.045, 0.02, 0.12), underside, 3, 8) # ...the long lower jaw.
	b.ellipsoid(Vector3(0.0, 0.765, -0.01), Vector3(0.075, 0.045, 0.12), underside) # Silver throat.
	b.box(Vector3(0.0, 0.912, -0.04), Vector3(0.035, 0.012, 0.2), definition) # Dark stripe along the top.
	for s in [-1.0, 1.0]:
		b.ellipsoid(Vector3(s * 0.07, 0.835, -0.11), Vector3(0.03, 0.03, 0.03), underside, 3, 7) # Eye...
		b.ellipsoid(Vector3(s * 0.088, 0.835, -0.112), Vector3(0.016, 0.018, 0.018), eyes, 2, 6) # ...and its pupil.
		b.box(Vector3(s * 0.082, 0.8, 0.04), Vector3(0.012, 0.07, 0.01), definition) # Gill slit.


# A squid's head on the same neck: a tall pointed mantle rising up and slightly back, with a flat fin on
# each side near its tip, over a rounded head with big eyes ringed in `definition` and a pale beak
# below. Its tentacles (tentacle_segment_mesh()) grow from its back.
static func _squid_head(b: Builder, skin: Color, definition: Color, underside: Color, eyes: Color) -> void:
	b.loft([[0.61, 0.085, 0.08, 0.01], [0.7, 0.08, 0.08, 0.0]], skin) # Neck.
	b.ellipsoid(Vector3(0.0, 0.79, -0.01), Vector3(0.11, 0.095, 0.11), skin, 4, 8) # Head.
	b.loft([
		[0.84, 0.1, 0.1, 0.0],
		[0.96, 0.11, 0.105, 0.02],
		[1.08, 0.09, 0.09, 0.04],
		[1.18, 0.055, 0.055, 0.06],
		[1.25, 0.012, 0.012, 0.07],
	], skin) # Mantle.
	for s in [-1.0, 1.0]:
		b.ellipsoid(Vector3(s * 0.11, 1.13, 0.05), Vector3(0.08, 0.075, 0.014), definition, 3, 6) # Fin.
		b.ellipsoid(Vector3(s * 0.085, 0.8, -0.07), Vector3(0.038, 0.04, 0.03), definition, 3, 7) # Eye ring...
		b.ellipsoid(Vector3(s * 0.095, 0.8, -0.085), Vector3(0.026, 0.028, 0.02), eyes, 2, 6) # ...and eye.
	b.ellipsoid(Vector3(0.0, 0.725, -0.06), Vector3(0.045, 0.035, 0.04), underside, 3, 6) # Beak.


# --- The mantis shrimp ------------------------------------------------------------------------------------

# A mantis shrimp's version of each part: the same muscled body under a segmented shell, `skin` the shell,
# `definition` the seams between its plates, `underside` its clubs, tail and leg tips (bright), `eyes` its eyes.
static func _mantis_part(b: Builder, part: String, side: float, skin: Color, definition: Color, accent: Color, eyes: Color) -> void:
	match part:
		"Torso":
			_torso(b, skin, definition)
			# Shell plates across the belly, each seam a dark ring standing just proud of it...
			for band: Array in [[0.04, 0.14, 0.1], [0.13, 0.14, 0.098], [0.22, 0.168, 0.104]]:
				b.loft([[band[0] - 0.012, band[1] + 0.012, band[2] + 0.012, 0.0], [band[0] + 0.012, band[1] + 0.012, band[2] + 0.012, 0.0]], definition)
			# ...a carapace shield over the back and shoulders...
			b.ellipsoid(Vector3(0.0, 0.44, 0.075), Vector3(0.25, 0.2, 0.09), skin, 3, 8)
			b.box(Vector3(0.0, 0.44, 0.16), Vector3(0.03, 0.3, 0.02), definition) # Its ridge.
			# ...and the tail fan spread behind the hips: the middle spine (telson) and a paddle each side.
			b.ellipsoid(Vector3(0.0, -0.12, 0.2), Vector3(0.06, 0.02, 0.15), accent, 2, 7)
			for s: float in [-1.0, 1.0]:
				b.ellipsoid(Vector3(s * 0.1, -0.11, 0.17), Vector3(0.07, 0.018, 0.13), accent, 2, 7)
				b.ellipsoid(Vector3(s * 0.15, -0.105, 0.11), Vector3(0.05, 0.016, 0.09), skin, 2, 6)
			b.ellipsoid(Vector3(0.0, -0.1, 0.1), Vector3(0.09, 0.03, 0.06), skin, 2, 6) # Where the fan meets the body.
		"Head":
			_mantis_head(b, skin, definition, accent, eyes)
		"UpperArm":
			_upper_arm(b, side, skin, definition)
			b.loft([[0.3, 0.06, 0.07, -0.005], [0.27, 0.06, 0.07, -0.005]], definition, side * 0.31) # Joint seam.
			b.ellipsoid(Vector3(side * 0.335, 0.53, 0.0), Vector3(0.1, 0.07, 0.095), skin, 3, 7) # Shoulder plate.
		"Forearm":
			_mantis_club(b, side, skin, definition, accent)
		"Thigh":
			_thigh(b, side, skin, definition)
			b.loft([[-0.2, 0.112, 0.118, -0.01], [-0.18, 0.112, 0.118, -0.01]], definition, side * 0.105)
		"Shin":
			_shin(b, side, skin, definition)
			b.loft([[-0.6, 0.074, 0.084, 0.012], [-0.58, 0.074, 0.084, 0.012]], definition, side * 0.105)
			b.box(Vector3(side * 0.105, -0.915, -0.05), Vector3(0.1, 0.075, 0.25), accent) # Bright feet.


# A mantis shrimp's head: a short armored neck under a flat-topped head plate with a pointed rostrum,
# two big eyes up on stalks, each with the dark band across its middle mantis shrimp eyes have, a pair
# of long antennae sweeping forward and up, and a flat antennal scale beside each.
static func _mantis_head(b: Builder, skin: Color, definition: Color, accent: Color, eyes: Color) -> void:
	b.loft([[0.61, 0.09, 0.085, 0.01], [0.7, 0.085, 0.08, 0.0]], skin) # Neck.
	b.loft([[0.69, 0.095, 0.09, 0.0], [0.71, 0.095, 0.09, 0.0]], definition) # Its seam.
	b.ellipsoid(Vector3(0.0, 0.79, -0.01), Vector3(0.11, 0.08, 0.12), skin, 4, 8) # Head.
	b.box(Vector3(0.0, 0.85, -0.02), Vector3(0.16, 0.025, 0.2), skin) # Head plate...
	b.box(Vector3(0.0, 0.85, -0.02), Vector3(0.02, 0.03, 0.21), definition) # ...its ridge...
	b.ellipsoid(Vector3(0.0, 0.83, -0.15), Vector3(0.03, 0.02, 0.06), definition, 2, 6) # ...and rostrum.
	b.ellipsoid(Vector3(0.0, 0.73, -0.08), Vector3(0.06, 0.03, 0.05), accent, 2, 6) # Mouthparts.
	for s: float in [-1.0, 1.0]:
		_rod(b, Vector3(s * 0.04, 0.86, -0.08), Vector3(s * 0.07, 0.95, -0.1), 0.022, skin, 3) # Eye stalk...
		b.ellipsoid(Vector3(s * 0.075, 0.985, -0.105), Vector3(0.045, 0.05, 0.045), eyes, 3, 8) # ...the eye...
		b.box(Vector3(s * 0.075, 0.985, -0.105), Vector3(0.095, 0.014, 0.095), definition) # ...its band.
		_rod(b, Vector3(s * 0.03, 0.82, -0.14), Vector3(s * 0.2, 1.2, -0.38), 0.009, definition, 9) # Antenna.
		_rod(b, Vector3(s * 0.05, 0.8, -0.13), Vector3(s * 0.12, 0.84, -0.3), 0.007, definition, 5) # Its shorter twin.
		b.ellipsoid(Vector3(s * 0.1, 0.8, -0.17), Vector3(0.03, 0.012, 0.06), accent, 2, 6) # Antennal scale.


# A mantis shrimp's raptorial claw in place of a forearm and fist: a plated forearm ending in the heavy
# club (dactyl heel) it smashes with, bright `accent`, the folded dactyl blade lying back along it.
static func _mantis_club(b: Builder, side: float, skin: Color, definition: Color, accent: Color) -> void:
	var x := side * 0.32
	b.loft([
		[0.26, 0.05, 0.05, 0.0],
		[0.2, 0.072, 0.066, -0.006],
		[0.12, 0.064, 0.058, 0.0],
		[0.04, 0.056, 0.05, 0.0],
	], skin, x)
	b.loft([[0.13, 0.068, 0.062, 0.0], [0.11, 0.068, 0.062, 0.0]], definition, x) # Seam.
	b.ellipsoid(Vector3(x, -0.05, -0.01), Vector3(0.085, 0.1, 0.105), accent, 3, 8) # The club...
	b.ellipsoid(Vector3(x, -0.09, -0.05), Vector3(0.06, 0.05, 0.06), accent.lightened(0.25), 2, 6) # ...its striking face...
	b.ellipsoid(Vector3(x, 0.05, -0.085), Vector3(0.022, 0.12, 0.022), definition, 2, 6) # ...and the dactyl blade folded up its front.


# --- The lobster -----------------------------------------------------------------------------------------

# A lobster's version of each part: the muscled body under a heavy segmented shell, `skin` the shell (dark
# blue-green, a live lobster's), `definition` the seams, `accent` its joints, spines and tail edge (orange),
# `eyes` its eyes (black).
static func _lobster_part(b: Builder, part: String, side: float, skin: Color, definition: Color, accent: Color, eyes: Color) -> void:
	match part:
		"Torso":
			_torso(b, skin, definition)
			# Belly plates, each seam a dark ring...
			for band: Array in [[0.0, 0.135, 0.1], [0.08, 0.13, 0.097], [0.16, 0.15, 0.1], [0.24, 0.17, 0.105]]:
				b.loft([[band[0] - 0.012, band[1] + 0.014, band[2] + 0.014, 0.0], [band[0] + 0.012, band[1] + 0.014, band[2] + 0.014, 0.0]], definition)
			# ...a domed carapace over the back and shoulders, with a row of spines down its ridge...
			b.ellipsoid(Vector3(0.0, 0.43, 0.07), Vector3(0.27, 0.22, 0.1), skin, 3, 8)
			for i in 4:
				b.ellipsoid(Vector3(0.0, 0.56 - 0.07 * i, 0.165), Vector3(0.018, 0.03, 0.03), accent, 2, 5)
			# ...and the broad tail fan spread behind the hips: the telson and two paddles each side.
			b.ellipsoid(Vector3(0.0, -0.1, 0.13), Vector3(0.1, 0.035, 0.08), skin, 2, 7) # Tail root.
			b.ellipsoid(Vector3(0.0, -0.14, 0.24), Vector3(0.07, 0.02, 0.13), skin, 2, 7)
			b.ellipsoid(Vector3(0.0, -0.145, 0.33), Vector3(0.05, 0.016, 0.05), accent, 2, 6) # Its orange edge.
			for s: float in [-1.0, 1.0]:
				for k in 2:
					var spread := 0.08 + 0.06 * k
					b.ellipsoid(Vector3(s * spread, -0.135 + 0.01 * k, 0.22 - 0.03 * k), Vector3(0.06, 0.017, 0.12), skin, 2, 7)
					b.ellipsoid(Vector3(s * spread * 1.15, -0.14 + 0.01 * k, 0.31 - 0.04 * k), Vector3(0.035, 0.014, 0.04), accent, 2, 5)
		"Head":
			_lobster_head(b, skin, definition, accent, eyes)
		"UpperArm":
			_upper_arm(b, side, skin, definition)
			b.loft([[0.3, 0.062, 0.072, -0.005], [0.27, 0.062, 0.072, -0.005]], accent, side * 0.31) # Orange joint.
			b.ellipsoid(Vector3(side * 0.34, 0.53, 0.0), Vector3(0.11, 0.075, 0.1), skin, 3, 7) # Shoulder plate.
		"Forearm":
			if side > 0.0:
				_crusher_claw(b, side, skin, definition, accent)
			else:
				_pincer_claw(b, side, skin, definition, accent)
		"Thigh":
			_thigh(b, side, skin, definition)
			b.loft([[-0.2, 0.114, 0.12, -0.01], [-0.18, 0.114, 0.12, -0.01]], definition, side * 0.105)
			b.loft([[-0.47, 0.066, 0.07, 0.0], [-0.44, 0.066, 0.07, 0.0]], accent, side * 0.105) # Knee joint.
		"Shin":
