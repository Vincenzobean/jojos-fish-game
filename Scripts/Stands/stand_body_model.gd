	b.ellipsoid(Vector3(0.0, 0.79, -0.03), Vector3(0.11, 0.085, 0.15), skin, 4, 8) # Head.
	b.box(Vector3(0.0, 0.855, -0.03), Vector3(0.02, 0.025, 0.24), definition) # Ridge.
	_rod(b, Vector3(0.0, 0.83, -0.15), Vector3(0.0, 0.84, -0.27), 0.016, skin, 4) # Rostrum...
	for i in 3:
		b.ellipsoid(Vector3(0.0, 0.85, -0.17 - 0.035 * i), Vector3(0.008, 0.016, 0.008), accent, 2, 4) # ...its spines.
	b.ellipsoid(Vector3(0.0, 0.72, -0.12), Vector3(0.065, 0.03, 0.05), accent, 2, 6) # Mouthparts.
	for s: float in [-1.0, 1.0]:
		_rod(b, Vector3(s * 0.045, 0.84, -0.14), Vector3(s * 0.07, 0.87, -0.17), 0.016, skin, 2) # Eye stalk...
		b.ellipsoid(Vector3(s * 0.075, 0.875, -0.175), Vector3(0.028, 0.028, 0.028), eyes, 3, 7) # ...the eye.
		# The long antennae: out from under the rostrum, sweeping forward, up, then back over the body.
		_rod(b, Vector3(s * 0.05, 0.8, -0.18), Vector3(s * 0.2, 0.95, -0.42), 0.012, accent, 6)
		_rod(b, Vector3(s * 0.2, 0.95, -0.42), Vector3(s * 0.42, 1.25, -0.2), 0.009, accent, 6)
		_rod(b, Vector3(s * 0.42, 1.25, -0.2), Vector3(s * 0.55, 1.35, 0.25), 0.007, accent, 6)
		# The short forked antennules.
		_rod(b, Vector3(s * 0.025, 0.79, -0.19), Vector3(s * 0.05, 0.83, -0.32), 0.006, definition, 4)
		_rod(b, Vector3(s * 0.05, 0.83, -0.32), Vector3(s * 0.04, 0.88, -0.38), 0.005, definition, 2)


