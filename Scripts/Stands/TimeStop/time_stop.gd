# A time stop: for `seconds`, every fighting stand but its `user` (the Mantis Shrimp Stand's Stasis,
# time_stop_move.gd) is stopped dead in time (stand_status.gd freeze()): held where it is, its moves and
# flying stopped, and every hit on it kept until time moves again, when they all land at once
# (stand_health.gd). The user goes on as normal meanwhile. Only one can run at a time (is_active()).
#
# Start one with TimeStop.begin(); it frees itself a moment after it's over. Stands it freezes are those
# in the "summoned_stands" (the player's) and "stand_opponents" (wild stands, the boss) groups that have a
# Status. A cutscene can start one with nothing to freeze, just for the look (the boss's finisher).
#
# Two things beat it (the immortal Jellyfish's): a stand whose Status resists time (stand_status.gd
# resists_time_stop(), Timeless Drift) isn't frozen but moves on through it (`resisting`); and a time stop
# begun against a stand in Return to Zero (stand_health.gd is_zeroed()) never happens at all: begin()
# refuses it (`refused`, static, for the visuals).
#
# Gameplay only: its Visuals child (time_stop_visuals.gd) drains the world of colour and shows the time left.
# Generated by Claude Code.
class_name TimeStop
extends Node

## Time stopped, for `seconds`.
signal stopped(seconds: float)
## It's about to move again (`warning` seconds before the end).
signal resuming
## Time moves again: every held hit lands.
signal resumed
## (Static) A time stop by `user_stand` was refused: a stand in Return to Zero was there to see it.
static var refused_by: Node3D

const VisualsScript := preload("res://Scripts/Stands/TimeStop/time_stop_visuals.gd")

@export var warning := 0.5 ## Seconds before the end that `resuming` warns it's coming.
@export var linger := 0.8 ## Seconds it stays after time moves again (for its visuals to finish).

var user: Node3D ## The stand that stopped time (it isn't frozen).
var seconds := 0.0 ## How long time stays stopped.
var frozen: Array[Node3D] = [] ## The stands it froze.
var resisting: Array[Node3D] = [] ## The stands that moved on through it (resisted time).

static var _active: TimeStop

var _left := 0.0
var _warned := false
var _over := false


## Whether a time stop is running (time is stopped right now).
static func is_active() -> bool:
	return is_instance_valid(_active) and not _active._over


## The time stop running, or null.
static func current() -> TimeStop:
	return _active if is_active() else null


## Stops time around `user_stand` for `duration` seconds, freezing every other fighting stand if
## `freeze_others`. Returns the time stop, or null if one is already running.
static func begin(user_stand: Node3D, duration: float, freeze_others := true) -> TimeStop:
	if is_active() or user_stand == null or not user_stand.is_inside_tree():
		return null
	if freeze_others and _zeroed_near(user_stand) != null:
		refused_by = _zeroed_near(user_stand)
		StandEffects.spawn("poof", user_stand.get_tree().current_scene, user_stand.get("torso").global_position, 3.0)
		return null # It never happened.
	var stop := TimeStop.new()
	stop.name = "TimeStop"
	stop.user = user_stand
	stop.seconds = duration
	if freeze_others:
		for stand in stop._targets():
			var status := stand.get_node_or_null("Status")
			if status and status.has_method("resists_time_stop") and status.resists_time_stop():
				stop.resisting.append(stand)
			else:
				stop.frozen.append(stand)
	var visuals := Node.new()
	visuals.name = "Visuals"
	visuals.set_script(VisualsScript)
	stop.add_child(visuals)
	var tree := user_stand.get_tree()
	(tree.current_scene if tree.current_scene else tree.root).add_child(stop)
	return stop


## Seconds until time moves again.
func time_left() -> float:
	return maxf(_left, 0.0)


## Lets time move again now (the user was beaten, the fight ended).
func cancel() -> void:
	if not _over:
		_end()


func _ready() -> void:
	_active = self
	_left = seconds
	for stand in frozen:
		var status := stand.get_node_or_null("Status")
		if status:
			status.freeze(seconds + 0.2) # A touch longer: thawed by _end() exactly on time.
	stopped.emit(seconds)


func _physics_process(delta: float) -> void:
	if _over:
		return
	if not is_instance_valid(user):
		_end()
		return
	_left -= delta
	if not _warned and _left <= warning:
		_warned = true
		resuming.emit()
	if _left <= 0.0:
		_end()


func _end() -> void:
	_over = true
	_left = 0.0
	for stand in frozen:
		if is_instance_valid(stand):
			var status := stand.get_node_or_null("Status")
			if status:
				status.thaw()
	resumed.emit()
	await get_tree().create_timer(linger, false).timeout
	if _active == self:
		_active = null
	queue_free()


# A fighting stand other than `user_stand` in Return to Zero, or null.
static func _zeroed_near(user_stand: Node3D) -> Node3D:
	for group: StringName in [&"summoned_stands", &"stand_opponents"]:
		for node in user_stand.get_tree().get_nodes_in_group(group):
			var health: Node = node.get_node_or_null("Health") if node != user_stand else null
			if health and health.has_method("is_zeroed") and health.is_zeroed():
				return node
	return null


# Every fighting stand with a Status, but the user.
func _targets() -> Array[Node3D]:
	var found: Array[Node3D] = []
	for group: StringName in [&"summoned_stands", &"stand_opponents"]:
		for node in user.get_tree().get_nodes_in_group(group):
			if node != user and node is Node3D and node not in found and node.get_node_or_null("Status"):
				found.append(node)
	return found
