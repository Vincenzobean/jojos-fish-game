# How a time stop (time_stop.gd, its parent) looks: as time stops, a ring of inverted colour sweeps out
# across the screen from the stand that stopped it while a shockwave rolls out from it, and the world
# drains to a cold green-grey (time_stop.gdshader). While it lasts a clock face at the top of the screen
# runs down the time left, its hand ticking; every hit a frozen stand takes hangs in the air where it
# struck as a glowing star, and they all burst as impacts the moment time moves; just before time moves again the clock glows; and as it
# moves again the colour floods back with a second, faster ring. A stand moving on through the stopped time
# (the Jellyfish's Timeless Drift, time_stop.gd `resisting`) wears a pulsing red-orange halo, its stomach's
# colour, drawn over the grey (so it keeps its colour) where the stand is on screen.
# Purely presentation.
# Generated by Claude Code.
extends Node

const TimeStopShader := preload("res://assets/fx/time_stop.gdshader")
const StandShape := preload("res://Scripts/Stands/stand_shape.gd")
const INK := Color(0.06, 0.06, 0.08)
const PAPER := Color(0.97, 0.97, 1.0)
const GLOW := Color(0.55, 1.0, 0.8)
const RESIST := Color(1.0, 0.42, 0.18) ## The halo on a stand moving through stopped time.

@onready var stop: Node = get_parent()

var _layer: CanvasLayer # The grey world, under the HUD...
var _top: CanvasLayer # ...and the clock, over it.
var _screen: ColorRect
var _clock: Control
var _warn := 0.0
var _marks: Array[MeshInstance3D] = [] # A star where each held hit struck.
var _halos: Control # Draws the halos round resisting stands, over the grey.
static var _mark_mesh: SphereMesh
static var _mark_material: StandardMaterial3D


func _ready() -> void:
	_layer = CanvasLayer.new()
	_layer.layer = -1 # Over the world but under the HUD, which keeps its colour.
	add_child(_layer)
	_top = CanvasLayer.new()
	_top.layer = 45 # Under a cutscene's bars (50).
	add_child(_top)
	_screen = ColorRect.new()
	_screen.mouse_filter = Control.MOUSE_FILTER_IGNORE
	var material := ShaderMaterial.new()
	material.shader = TimeStopShader
	_screen.material = material
	_layer.add_child(_screen)
	_screen.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	_clock = Clock.new()
	_clock.visuals = self
	_clock.mouse_filter = Control.MOUSE_FILTER_IGNORE
	_top.add_child(_clock)
	_clock.set_anchors_preset(Control.PRESET_CENTER_TOP)
	_clock.size = Vector2(96.0, 96.0)
	_clock.position = Vector2(get_viewport().get_visible_rect().size.x * 0.5 - 48.0, 100.0) # Under the boss's bar.
	_clock.modulate.a = 0.0
	stop.stopped.connect(_on_stopped)
	stop.resuming.connect(func() -> void: _warn = 1.0)
	stop.resumed.connect(_on_resumed)
	for stand: Node3D in stop.frozen:
		var health := stand.get_node_or_null("Health")
		if health and health.has_signal("hit_held"):
			health.hit_held.connect(_on_hit_held)
	_halos = Halos.new()
	_halos.visuals = self
	_halos.mouse_filter = Control.MOUSE_FILTER_IGNORE
	_top.add_child(_halos)
	_halos.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)


func _process(delta: float) -> void:
	_warn = move_toward(_warn, 0.0, delta * 1.5)
	_clock.queue_redraw()
	_halos.queue_redraw()


func _on_stopped(_seconds: float) -> void:
	_set_param(_focus(), "focus")
	_set_param(0.0, "wave")
	var at := _user_point()
	if at != Vector3.INF:
		StandEffects.spawn("shockwave", get_tree().current_scene, at, 6.0)
	var tween := create_tween().set_parallel()
	tween.tween_method(_set_param.bind("wave"), 0.0, 1.6, 0.55).set_ease(Tween.EASE_OUT)
	tween.tween_method(_set_param.bind("amount"), 0.0, 1.0, 0.4)
	tween.tween_property(_clock, "modulate:a", 1.0, 0.3)
	tween.chain().tween_callback(_set_param.bind(-1.0, "wave"))


# A frozen stand was hit: a star hangs where it struck until time moves.
func _on_hit_held(hit: Dictionary) -> void:
	mark(hit.get("point", Vector3.ZERO))


## Hangs a glowing star at `point` (world) that bursts as an impact when time moves again (a finisher's
## frozen blows land this way, mantis_shrimp_stand_finisher.gd).
func mark(point: Vector3) -> void:
	if _mark_mesh == null:
		_mark_mesh = SphereMesh.new()
		_mark_mesh.radius = 0.22
		_mark_mesh.height = 0.44
		_mark_mesh.radial_segments = 6
		_mark_mesh.rings = 3
		_mark_material = StandardMaterial3D.new()
		_mark_material.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
		_mark_material.albedo_color = GLOW
	var star := MeshInstance3D.new()
	star.mesh = _mark_mesh
	star.material_override = _mark_material
	get_tree().current_scene.add_child(star)
	star.global_position = point + Vector3(randf_range(-0.2, 0.2), randf_range(-0.2, 0.2), randf_range(-0.2, 0.2))
	star.scale = Vector3.ONE * randf_range(0.7, 1.3)
	_marks.append(star)


func _exit_tree() -> void:
	for star in _marks:
		if is_instance_valid(star):
			star.queue_free()



func _on_resumed() -> void:
	for star in _marks:
		if is_instance_valid(star):
			StandEffects.spawn("impact", get_tree().current_scene, star.global_position, 3.0)
			star.queue_free()
	_marks.clear()
	_set_param(_focus(), "focus")
	var tween := create_tween().set_parallel()
	tween.tween_method(_set_param.bind("wave"), 0.0, 1.6, 0.3).set_ease(Tween.EASE_OUT)
	tween.tween_method(_set_param.bind("amount"), 1.0, 0.0, 0.3)
	tween.tween_property(_clock, "modulate:a", 0.0, 0.2)
	tween.chain().tween_callback(_set_param.bind(-1.0, "wave"))


func _set_param(value: Variant, param: String) -> void:
	(_screen.material as ShaderMaterial).set_shader_parameter(param, value)


# Where the stand that stopped time is (its torso), or INF.
func _user_point() -> Vector3:
	if not is_instance_valid(stop.user):
		return Vector3.INF
	var torso: Node3D = stop.user.get("torso")
	return torso.global_position if torso else stop.user.global_position


# Where the stand that stopped time is on screen (UV), or the middle.
func _focus() -> Vector2:
	var camera := get_viewport().get_camera_3d()
	var at := _user_point()
	if camera == null or at == Vector3.INF or camera.is_position_behind(at):
		return Vector2(0.5, 0.5)
	return camera.unproject_position(at) / Vector2(get_viewport().get_visible_rect().size)


# The halos: a pulsing red-orange ring, inked, round each stand moving through the stopped time, sized to
# how big it looks on screen.
class Halos extends Control:
	var visuals: Node

	func _draw() -> void:
		var stop: Node = visuals.stop
		var camera := get_viewport().get_camera_3d()
		if camera == null or stop._over:
			return
		var pulse := 1.0 + 0.1 * sin(Time.get_ticks_msec() * 0.012)
		for stand: Node3D in stop.resisting:
			if not is_instance_valid(stand) or stand.get("torso") == null:
				continue
			var at: Vector3 = stand.torso.global_position
			if camera.is_position_behind(at):
				continue
			var middle := camera.unproject_position(at)
			var top := camera.unproject_position(at + camera.global_basis.y * StandShape.size(stand) * 0.6)
			var radius := middle.distance_to(top) * pulse
			draw_arc(middle, radius, 0.0, TAU, 48, INK, 9.0, true)
			draw_arc(middle, radius, 0.0, TAU, 48, RESIST, 5.0, true)


# The clock face: a dial whose glowing wedge runs down the time left, and a ticking hand.
class Clock extends Control:
	var visuals: Node

	func _draw() -> void:
		var stop: Node = visuals.stop
		var center := size * 0.5
		var radius := size.x * 0.42
		var share: float = stop.time_left() / maxf(stop.seconds, 0.01)
		var warn: float = visuals._warn
		draw_circle(center, radius + 6.0, INK)
		draw_circle(center, radius, PAPER.lerp(GLOW, warn))
		if share > 0.0:
			var points := PackedVector2Array([center])
			var steps := maxi(int(48 * share), 2)
			for i in steps + 1:
				var angle := -PI * 0.5 + TAU * share * float(i) / steps
				points.append(center + Vector2.from_angle(angle) * (radius - 4.0))
			draw_colored_polygon(points, GLOW.darkened(0.15 + 0.3 * warn))
		for i in 12:
			var angle := TAU * i / 12.0
			draw_line(center + Vector2.from_angle(angle) * (radius - 10.0), center + Vector2.from_angle(angle) * radius, INK, 3.0)
		# The hand ticks round in quarter seconds with the wedge.
		var ticks := floorf(stop.time_left() * 4.0) / 4.0
		var hand := -PI * 0.5 + TAU * ticks / maxf(stop.seconds, 0.01)
		draw_line(center, center + Vector2.from_angle(hand) * (radius - 8.0), INK, 5.0)
		draw_circle(center, 6.0, INK)
