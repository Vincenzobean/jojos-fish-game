# Timed effects other stands' hits leave on a fighting stand: added as "Status" beside its health
# (stand_health.gd) by possession (possession.gd) and for wild stands (stand_encounter.gd).
#   * Slowed (the Squid's Ink Spray): it flies at move_scale() of its speed (stand_controller.gd) and its
#     moves play at attack_scale() of their speed (stand_combat.gd time_scale()), for a few seconds.
#   * Rooted (the Squid's Tentacle Bind): it can't fly sideways, dash or be lunged anywhere until it ends.
#   * Frozen (a time stop, time_stop.gd): stopped dead in time. Its bodies are held still where they are
#     (their motion is given back when it ends), its controller and combat do nothing, its visuals hold
#     their pose, and hits on it wait (stand_health.gd) until time moves again, then all land at once.
#   * Hasted (the Lobster's Molt, stand_health.gd): faster for a few seconds (move_scale() above 1).
#   * Time resist (the Jellyfish's Timeless Drift): a stand that can_resist_time moves through a time stop
#     instead of being frozen (time_stop.gd asks resists_time_stop()), then can't again for
#     time_resist_cooldown seconds.
# A hit carries them as its "status" (see apply()); the strongest of each wins and a fresh one restarts
# its timer. Blocked hits don't leave any (stand_health.gd).
# Gameplay only: the stand's visuals (stand_body_visuals.gd) read is_slowed() and listen to `changed`.
# Generated by Claude Code.
extends Node

## A slow, root or freeze started or ran out.
signal changed
## A freeze began (true) or time started moving for it again (false).
signal frozen_changed(frozen: bool)

const StandShape := preload("res://Scripts/Stands/stand_shape.gd")

var _slow_left := 0.0
var _slow_move := 1.0
var _slow_attack := 1.0
var _root_left := 0.0
var _freeze_left := 0.0
var _haste_left := 0.0
var _haste_move := 1.0
var can_resist_time := false ## It moves through time stops (stand_health.gd sets it: the Jellyfish, once learned)...
var time_resist_cooldown := 30.0 ## ...then can't again for this many seconds.
var _resist_wait := 0.0
var _held := {} # While frozen: each body held still -> {"freeze": was it frozen, "linear", "angular": its motion}.


## Puts on whatever `status` holds: "root_time" (seconds rooted), "freeze_time" (seconds frozen), and
## "slow_time" (seconds slowed) with "slow_move" and "slow_attack" (the shares of speed left).
func apply(status: Dictionary) -> void:
	if status.has("freeze_time"):
		freeze(float(status["freeze_time"]))
	if status.has("root_time"):
		root(float(status["root_time"]))
	if status.has("slow_time"):
		slow(float(status.get("slow_move", 1.0)), float(status.get("slow_attack", 1.0)), float(status["slow_time"]))


## Slows it to `move_share` of its flying speed and `attack_share` of its moves' speed for `seconds`.
func slow(move_share: float, attack_share: float, seconds: float) -> void:
	var fresh := not is_slowed()
	_slow_move = move_share if fresh else minf(_slow_move, move_share)
	_slow_attack = attack_share if fresh else minf(_slow_attack, attack_share)
	_slow_left = maxf(_slow_left, seconds)
	changed.emit()


## Roots it in place for `seconds`.
func root(seconds: float) -> void:
	_root_left = maxf(_root_left, seconds)
	changed.emit()


## Stops it in time for `seconds` (longer if it's already frozen for longer).
func freeze(seconds: float) -> void:
	var fresh := not is_frozen()
	_freeze_left = maxf(_freeze_left, seconds)
	if fresh and _freeze_left > 0.0:
		_hold_bodies()
		frozen_changed.emit(true)
		changed.emit()


## Lets time move for it again now.
func thaw() -> void:
	if is_frozen():
		_freeze_left = 0.0
		_end_freeze()


## Clears its slow and root (the Jellyfish's Polyp Reset); a freeze stays.
func cleanse() -> void:
	if is_slowed() or is_rooted():
		_slow_left = 0.0
		_root_left = 0.0
		changed.emit()


## Makes it fly at `move_share` (above 1) of its speed for `seconds`.
func haste(move_share: float, seconds: float) -> void:
	_haste_move = maxf(_haste_move if is_hasted() else 1.0, move_share)
	_haste_left = maxf(_haste_left, seconds)
	changed.emit()


func is_hasted() -> bool:
	return _haste_left > 0.0


## Whether it slips this time stop (time_stop.gd asks as one begins): yes if it can resist time and its
## cooldown is over, which then starts again. `spend` false only asks.
func resists_time_stop(spend := true) -> bool:
	if not can_resist_time or _resist_wait > 0.0:
		return false
	if spend:
		_resist_wait = time_resist_cooldown
		changed.emit()
	return true


## Seconds before it can resist time again (0 when it can, or never could).
func time_resist_wait() -> float:
	return _resist_wait


func is_frozen() -> bool:
	return _freeze_left > 0.0


## Seconds of its freeze left (0 if it isn't frozen).
func freeze_left() -> float:
	return _freeze_left


func is_slowed() -> bool:
	return _slow_left > 0.0


func is_rooted() -> bool:
	return _root_left > 0.0


## Share of its flying speed it has.
func move_scale() -> float:
	if is_frozen():
		return 0.0
	return (_slow_move if is_slowed() else 1.0) * (_haste_move if is_hasted() else 1.0)


## Share of its moves' speed it has.
func attack_scale() -> float:
	if is_frozen():
		return 0.0
	return _slow_attack if is_slowed() else 1.0


func _physics_process(delta: float) -> void:
	if is_frozen():
		_freeze_left = maxf(_freeze_left - delta, 0.0)
		if not is_frozen():
			_end_freeze()
		return # Its other effects wait out the freeze too.
	_resist_wait = maxf(_resist_wait - delta, 0.0)
	var was := [is_slowed(), is_rooted(), is_hasted()]
	_slow_left = maxf(_slow_left - delta, 0.0)
	_root_left = maxf(_root_left - delta, 0.0)
	_haste_left = maxf(_haste_left - delta, 0.0)
	if was != [is_slowed(), is_rooted(), is_hasted()]:
		changed.emit()


# Holds every body of the stand still where it is, remembering how it was moving.
func _hold_bodies() -> void:
	_held.clear()
	var stand := get_parent() as Node3D
	if stand == null:
		return
	for body in StandShape.bodies(stand):
		_held[body] = {"freeze": body.freeze, "linear": body.linear_velocity, "angular": body.angular_velocity}
		body.freeze = true


func _end_freeze() -> void:
	for body: RigidBody3D in _held:
		if is_instance_valid(body):
			body.freeze = _held[body]["freeze"]
			if not body.freeze:
				body.linear_velocity = _held[body]["linear"]
				body.angular_velocity = _held[body]["angular"]
	_held.clear()
	frozen_changed.emit(false)
	changed.emit()
