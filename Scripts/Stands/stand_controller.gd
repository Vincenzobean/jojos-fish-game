# Lets the player (or an AI, through `input`: stand_input.gd) drive a summoned stand (see possession.gd),
# whatever it is: one rigid body or several
# joined ones, any shape, any size. It only knows the stand through stand_shape.gd: its bodies, its size
# and its heaviest body (the "core").
#
# A summoned stand floats: gravity is switched off on all its bodies for as long as it's controlled, and
# it holds whatever height it's at. WASD flies it relative to the 3rd-person camera's facing
# (third_person_camera.gd); jump (Space) rises and descend (Ctrl) sinks. It never comes lower than
# `hover_height` above whatever is under it, ground or water, so it glides up over islands and can't
# touch the sea. Every body's whole velocity is steered toward the wanted velocity together, so jointed
# stands move as one. Speeds are in lengths of the stand per second (clamped to sensible meters per
# second), so small and big stands both feel controllable. The core turns to face where the camera looks
# (face_camera; it strafes and backs up relative to that) or else where it's going,
# taking its local -Z as its front, is turned back upright whenever it tilts, and all other spinning
# is damped away so it hangs steady.
#
# Sprint (Shift) air-dashes: a short burst at `dash_speed` the way WASD points, or straight ahead
# along the camera if no direction is held, on a cooldown. `dashed` fires as it starts, for visuals.
# Each dash costs dash_stamina from the stand's health node (stand_health.gd), if it has one.
#
# A stand has a range: it can't go more than max_range from its user (the player); at the edge it
# slides along it and is pulled back in.
#
# Flying low over the sea, it pushes the water down beneath it and leaves a wake (water.gd), and a dash
# that low throws up a wall of spray behind it.
#
# Its kind's skills (the Skills autoload) make it fly faster, dash more often and cheaper, and range further;
# the stand itself can fly faster or slower and dash more or less often (stand_body.gd fly_speed_scale,
# dash_cooldown_scale). Slowed (stand_status.gd) it flies at its move_scale(); rooted it can't fly
# sideways, dash or be lunged (knockback included) until the root ends. Grown or shrunk (stand_body.gd
# grow()), it measures itself again.
#
# The stand is freed when it goes back to the inventory, so its gravity never needs restoring.
# Generated by Claude Code.
extends Node

## An air dash just began, heading along `direction` (horizontal, unit length).
signal dashed(direction: Vector3)

const StandShape := preload("res://Scripts/Stands/stand_shape.gd")

@export_group("Speed")
@export var fly_speed := 7.0 # Lengths of the stand per second...
@export var min_speed := 6.0 # ...but never slower than this (m/s)...
@export var max_speed := 16.0 # ...or faster than this (m/s).
@export var acceleration := 50.0 # m/s^2 the stand's speed is steered toward the wanted speed.

@export_group("Height")
@export var climb_speed := 7.0 # m/s up or down while jump or descend is held.
@export var hover_height := 0.75 # Meters kept between the stand's underside and the ground or water below.
@export var height_gain := 6.0 # How firmly the stand is pulled to its held height (per second).

@export_group("Dash")
@export var dash_speed := 30.0 # m/s of the burst...
@export var dash_time := 0.25 # ...held for this many seconds...
@export var dash_cooldown := 0.8 # ...and possible again this many seconds after it began.
@export var dash_stamina := 20.0 # Stamina a dash costs (stand_health.gd); none left, no dash.

@export_group("Water")
@export var water_touch_height := 2.5 # Meters over the water its underside can be and still push it down.
@export var spray_interval := 0.08 # Seconds between splashes a dash that low throws up.

@export_group("Range")
@export var max_range := 50.0 # Meters the stand may go from its user (the anchor passed to setup)...
@export var range_pull := 4.0 # ...and how hard it's pulled back per meter past that (m/s per meter).

@export_group("Turning")
@export var face_camera := true # Always face where the camera looks (strafing); off: face the way it's moving.
@export var turn_gain := 8.0 # How strongly the stand turns toward the way it faces.
@export var max_turn_speed := 6.0 # Radians per second.
@export var spin_damping := 6.0 # How quickly any other spinning dies away (per second).
@export var upright_gain := 10.0 # How quickly the core is tipped back to standing straight (per second).

var _bodies: Array[RigidBody3D] = []
var _core: RigidBody3D
var _size := 1.0
var _camera: Node3D
var _stand: Node3D
var _anchor: Node3D # The stand's user; it can't stray more than max_range from them.
var _water: Node
var _height := 0.0 # The center-of-mass height the stand is holding.
var _dash_direction := Vector3.ZERO
var _dash_left := 0.0 # Seconds of the current dash still to go.
var _dash_wait := 0.0 # Seconds until the next dash is allowed.
var _burst_speed := 0.0 # m/s of the burst under way: a dash, or a lunge from an attack.
var _burst_is_dash := false
var _spray_wait := 0.0

## Share of flying speed allowed, set by the stand's combat (stand_combat.gd) while it punches or blocks.
var speed_scale := 1.0
## Where its controls come from: the player's (stand_input.gd), or an AI's (enemy_stand_brain.gd).
var input: StandInput = StandInput.new()


## Takes control of `stand_root`, moving relative to `camera` (anything with a `yaw`: the stand camera,
## or an AI) and kept within max_range of `anchor` (the player; null for no limit). The stand must be
## in the scene tree. A wild stand (`skilled` false) doesn't get its kind's skills.
func setup(stand_root: Node3D, camera: Node3D, anchor: Node3D = null, skilled := true) -> void:
	_stand = stand_root
	_bodies = StandShape.bodies(stand_root)
	_core = StandShape.core(_bodies)
	_size = StandShape.size(stand_root)
	_camera = camera
	_anchor = anchor
	_water = get_tree().get_first_node_in_group("water")
	for body in _bodies:
		body.gravity_scale = 0.0
	_height = maxf(StandShape.center_of_mass(_bodies).y, lowest_height())
	if stand_root.get("fly_speed_scale") != null:
		fly_speed *= stand_root.fly_speed_scale
		max_speed *= stand_root.fly_speed_scale
		dash_cooldown *= stand_root.dash_cooldown_scale
	if stand_root.has_signal("resized"):
		stand_root.resized.connect(func(_to: float) -> void: _size = StandShape.size(stand_root))
	if skilled:
		_apply_skills(stand_root.scene_file_path)


# Its kind's skills (the Skills autoload): faster flight, quicker and cheaper dashes, a longer range.
func _apply_skills(key: String) -> void:
	fly_speed = Skills.scaled(key, "fly_speed", fly_speed)
	max_speed = Skills.scaled(key, "fly_speed", max_speed)
	dash_cooldown = Skills.scaled(key, "dash_cooldown", dash_cooldown)
	dash_stamina = Skills.scaled(key, "dash_stamina", dash_stamina)
	max_range += Skills.bonus(key, "range")


## The lowest the stand's center of mass may be right now: hovering over the ground or water below it.
func lowest_height() -> float:
	return _floor_below(StandShape.center_of_mass(_bodies)) + _size * 0.5 + hover_height


func _physics_process(delta: float) -> void:
	if _core == null or not is_instance_valid(_core) or not is_instance_valid(_camera):
		return
	var frozen_status := _status()
	if frozen_status and frozen_status.has_method("is_frozen") and frozen_status.is_frozen():
		return # Stopped in time: held where it is (stand_status.gd).
	var center := StandShape.center_of_mass(_bodies)

	var climb := input.get_axis("descend", "jump")
	_height = maxf(_height + climb * climb_speed * delta, lowest_height())
	var vertical := clampf((_height - center.y) * height_gain, -climb_speed, climb_speed)

	var move := input.get_vector("move_left", "move_right", "move_up", "move_down")
	var direction := Basis(Vector3.UP, _camera.yaw) * Vector3(move.x, 0.0, move.y)
	var status := _status()
	var rooted: bool = status != null and status.is_rooted()
	if rooted:
		direction = Vector3.ZERO
		_dash_left = 0.0 # Held fast: no dash or lunge carries it off.
	var speed: float = flying_speed() * speed_scale * (status.move_scale() if status else 1.0)
	var wanted := direction * speed + Vector3.UP * vertical
	var steering := acceleration * delta

	_dash_wait -= delta
	_dash_left -= delta
	if input.just_pressed(&"sprint") and _dash_wait <= 0.0 and not rooted and _can_dash():
		_dash_direction = direction.normalized() if direction.length() > 0.1 else Basis(Vector3.UP, _camera.yaw) * Vector3.FORWARD
		_dash_left = dash_time
		_burst_speed = dash_speed
		_burst_is_dash = true
		_dash_wait = dash_cooldown
		dashed.emit(_dash_direction)
	if _dash_left > 0.0:
		wanted = _dash_direction * _burst_speed + Vector3.UP * vertical
		steering = INF # The burst is immediate; afterwards normal acceleration brings it back to flying speed.
	wanted = _keep_in_range(center, wanted)
	for body in _bodies:
		if not is_instance_valid(body) or body.freeze:
			continue
		body.sleeping = false
		body.linear_velocity = body.linear_velocity.move_toward(wanted, steering)

	# With face_camera the stand always faces where the camera looks and strafes or backs up relative to
	# that (so its sideways and backward flying and dashes show); otherwise it turns to face its travel.
	var facing := Basis(Vector3.UP, _camera.yaw) * Vector3.FORWARD if face_camera else direction
	_steer_facing(facing, delta)
	_touch_water(center, delta)


# Turns the core about the vertical toward `direction` (the way it should face), stands it back up
# straight, and damps all other spinning of every body.
func _steer_facing(direction: Vector3, delta: float) -> void:
	var keep := exp(-spin_damping * delta)
	for body in _bodies:
		if is_instance_valid(body) and body != _core:
			body.angular_velocity *= keep
	var spin := _core.angular_velocity * keep
	# Stand straight: tip the core's up toward world up (the cross product is the axis, scaled by the tilt).
	var upright := _core.global_basis.y.normalized().cross(Vector3.UP) * upright_gain
	spin.x = upright.x
	spin.z = upright.z
	if direction.length() > 0.1:
		var front := -_core.global_basis.z
		front.y = 0.0
		if front.length() > 0.01:
			var angle := front.normalized().signed_angle_to(direction.normalized(), Vector3.UP)
			spin.y = clampf(angle * turn_gain, -max_turn_speed, max_turn_speed)
	_core.angular_velocity = spin


# Low over open water it pushes the surface down beneath it (deeper the lower it is), trails a wake, and
# a dash that low sprays.
func _touch_water(center: Vector3, delta: float) -> void:
	_spray_wait -= delta
	if _water == null:
		return
	var surface: float = _water.surface_height_at(center, false)
	var gap := center.y - _size * 0.5 - surface
	if gap > water_touch_height or _ground_below(center) > surface:
		return
	var near := 1.0 - clampf(gap / water_touch_height, 0.0, 1.0)
	var velocity := _core.linear_velocity
	var speed := Vector2(velocity.x, velocity.z).length()
	_water.press(center, _size * 0.35 + speed * 0.03, (0.06 + 0.3 * near * near) * (1.5 if is_dashing() else 1.0))
	_water.wake(self, center, velocity)
	if is_dashing() and gap < 1.5 and _spray_wait <= 0.0:
		_spray_wait = spray_interval
		_water.splash(center - velocity.normalized() * _size * 0.3, 0.3 + 0.4 * near)


# Height of whatever is directly under `point`: the ground or the water surface, whichever is higher.
func _floor_below(point: Vector3) -> float:
	var surface: float = _water.surface_height_at(point, false) if _water else -INF
	return maxf(_ground_below(point), surface)


# Height of the ground (or anything solid) directly under `point`, or -INF.
func _ground_below(point: Vector3) -> float:
	var excluded: Array[RID] = []
	for body in _bodies:
		if is_instance_valid(body):
			excluded.append(body.get_rid())
	var query := PhysicsRayQueryParameters3D.create(point + Vector3.UP * _size, point + Vector3.DOWN * 200.0)
	query.exclude = excluded
	var hit := _core.get_world_3d().direct_space_state.intersect_ray(query)
	return hit.position.y if not hit.is_empty() else -INF


## How far the stand is from its user, or 0 with no user.
func distance_from_anchor() -> float:
	if _anchor == null or not is_instance_valid(_anchor):
		return 0.0
	return StandShape.center_of_mass(_bodies).distance_to(_anchor.global_position)


## Whether the stand is up against the edge of its range.
func at_range_limit() -> bool:
	return _anchor != null and distance_from_anchor() >= max_range - 0.5


# A stand can't stray more than max_range from its user: past it, any velocity heading further away is
# dropped (sliding along the edge still works), and it's pulled back in proportion to how far over it is.
func _keep_in_range(center: Vector3, wanted: Vector3) -> Vector3:
	if _anchor == null or not is_instance_valid(_anchor):
		return wanted
	var away := center - _anchor.global_position
	var over := away.length() - max_range
	if over <= 0.0:
		return wanted
	var outward := away.normalized()
	var outward_speed := wanted.dot(outward)
	if outward_speed > 0.0:
		wanted -= outward * outward_speed
	# Don't keep climbing (or sinking) toward a height the stand can't reach.
	_height = clampf(_height, _anchor.global_position.y - max_range, _anchor.global_position.y + max_range)
	return wanted - outward * over * range_pull


# Whether the stand is steady enough (not staggered by a hit) and has the stamina to dash, spending it.
func _can_dash() -> bool:
	var health := _stand.get_node_or_null("Health") if _stand else null
	if health == null:
		return true
	return not health.is_staggered() and health.spend(dash_stamina)


## After something else moved the stand (a finisher, finisher_director.gd): holds its height where it now is,
## and stops any dash.
func settle() -> void:
	_height = maxf(StandShape.center_of_mass(_bodies).y, lowest_height())
	_dash_left = 0.0


# The slows and roots on it (stand_status.gd), if it has them.
func _status() -> Node:
	return _stand.get_node_or_null("Status") if _stand else null


## True during an air dash's burst.
func is_dashing() -> bool:
	return _dash_left > 0.0 and _burst_is_dash


## The stand's normal flying speed in m/s (dashes go faster).
func flying_speed() -> float:
	return clampf(fly_speed * _size, min_speed, max_speed)


## A short burst along `direction` at `speed` m/s for `time` seconds, like a dash but without its
## cooldown or afterimages: an attack stepping into a punch (stand_combat.gd).
func lunge(direction: Vector3, speed: float, time: float) -> void:
	var flat := Vector3(direction.x, 0.0, direction.z)
	var status := _status()
	if flat.length() < 0.01 or (status and status.is_rooted()):
		return
	_dash_direction = flat.normalized()
	_dash_left = time
	_burst_speed = speed
	_burst_is_dash = false
