# Stasis, the Mantis Shrimp Stand's time stop (mantis_shrimp_stand_moves.gd): STASIS_AT seconds into the
# move (after its tell) it stops time (time_stop.gd) around the stand for `freeze_time` seconds, or for
# its brain's stasis_time when it has one (boss_stand_brain.gd sets it by phase). It can't start while
# time is already stopped. If the move is cut short before STASIS_AT, nothing happens.
# Generated by Claude Code.
extends StandMove

const STASIS_AT := 0.6 ## Seconds of tell before time stops.

@export var freeze_time := 2.0 ## Seconds time stays stopped, if the stand's brain doesn't say.


func can_start(_combat: Node) -> bool:
	return not TimeStop.is_active()


func on_start(combat: Node) -> void:
	await combat.get_tree().create_timer(STASIS_AT, false, true).timeout
	if not is_instance_valid(combat) or combat.get_move() != self:
		return # Cut short (it was beaten) before time stopped.
	var stand := combat.get_parent() as Node3D
	var brain := stand.get_node_or_null("Brain")
	var seconds: float = brain.stasis_time if brain and "stasis_time" in brain else freeze_time
	TimeStop.begin(stand, seconds)
