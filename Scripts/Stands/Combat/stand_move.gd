# One move a stand can make in a fight: its animation, when and where it hits, how it moves the stand,
# and what it combos into. A Resource, so stands share, swap and save moves; the combat node
# (stand_combat.gd) plays them and DefaultStandMoves (default_stand_moves.gd) builds the general ones.
#
# Hits: each entry of `hits` (build them with hit()) lands `time` seconds into the move, in front of
# the stand by `reach` lengths of the stand, toward the punching `fist`'s side ("L", "R" or "both"),
# `height` lengths above its middle, checking a sphere `radius` lengths across, with `damage` and
# `knockback` (m/s, along the punch; `lift` adds m/s upward, for launchers).
#
# Rallies (the "Rally" group): a move that sends the stand's floating companion out and back makes the
# next light press a timing test, perfect, good or a miss (stand_combat.gd).
#
# Special moves: extend this and override on_start(), on_hit_frame() and on_end() for anything a move
# does beyond its animation and hits; give it an `input` action and list it in the move set's specials.
# An `unlock` makes it wait until the stand's skill tree learns it, and `super_armor` lets it start (and
# keep going) while the stand is being hit (stand_health.gd).
# Generated by Claude Code.
class_name StandMove
extends Resource

@export var display_name := ""
@export var animation: StandAnimation ## Its one-shot animation (held, for the barrage and block).
@export var hits: Array[Dictionary] = [] ## When and where it hits, see above.
@export var cancel_from := 0.0 ## From this many seconds in, a buffered press moves on to the next move.
@export var move_speed_scale := 0.35 ## Share of the stand's flying speed it keeps during the move.
@export var lunge_speed := 0.0 ## m/s burst forward at lunge_at, for stepping into a punch...
@export var lunge_at := 0.0
@export var lunge_time := 0.0 ## ...lasting this long.
@export var input: StringName = &"" ## For special moves: the action that starts it...
@export var unlock: StringName = &"" ## ...once the stand's skill tree has this unlock (the Skills autoload); empty, always.
@export var super_armor := false ## Hits while it plays hurt but don't stagger, shove or stop it, and it can start mid-move or staggered.
@export var cooldown := 0.0 ## Seconds before it can be used again, counted from when it stops (finished or cut short).
## Moves sharing a group share one cooldown (the whole light chain, a barrage and its finale); empty, the
## move is its own group. Going on from one move to the next within a group isn't held up by it, and
## the cooldown only starts once the group's last move stops.
@export var cooldown_group: StringName = &""
@export var cooldown_icon: StringName = &"" ## The icon its cooldown dial shows (skill_screen.gd draw_icon()).


## The cooldown this move belongs to.
func cooldown_key() -> StringName:
	return cooldown_group if cooldown_group != &"" else StringName(display_name)
@export var stamina_cost := 0.0 ## Stamina it takes to start (stand_health.gd); without it, it doesn't start...
@export var stamina_drain := 0.0 ## ...and per second while it's held (a barrage) or charging; run out and it's let go.

@export_group("Charging")
## Above 0, the move charges: its animation holds its wind-up (loop_start..loop_end) while the button
## is held, and it's only thrown if held at least this many seconds (let go sooner, it's dropped)...
@export var charge_min := 0.0
@export var charge_full := 0.0 ## ...building to full power by this many.
@export var charge_damage_scale := 2.0 ## Damage at full charge, as a multiple of a just-ready one...
@export var charge_knockback_scale := 2.2 ## ...and knockback.

@export_group("Combos")
@export var next_light: StandMove ## Light pressed during this move leads into...
@export var next_heavy: StandMove ## ...and heavy into.

@export_group("Rally")
## Above -1, the move rallies: it sends the stand's floating companion out (the Dolphin's pufferfish)
## and it comes back into reach `rally_at` seconds in. The next light press is timed against that:
## within rally_perfect of it starts next_light's `perfect` variant, within rally_good next_light
## itself, and anything else (or no press by rally_at + rally_good) is a miss, which ends the chain
## and snaps the companion home. Presses before rally_from (while it's still being thrown) are ignored.
@export var rally_at := -1.0
@export var rally_from := 0.0
@export var rally_perfect := 0.07 ## Seconds either side of rally_at for a perfect hit...
@export var rally_good := 0.17 ## ...and for a good one.
@export var perfect: StandMove ## The version of this move played when the press into it was perfect; itself if empty.

@export_group("Companion flight")
## Above -1, the move sends its floating companion flying out and back (its animation's companion_out
## channel). From flight_from to flight_until (the end of its hang out there) it hits whatever it flies
## into, with companion_hit, and stops there: the move skips ahead to where the way back passes the same
## distance, so the companion comes straight back from what it hit (and a rally's sweet spot comes sooner).
@export var flight_from := -1.0
@export var flight_until := -1.0
@export var flight_near := 0.38 ## Lengths of the stand in front of it the companion is at companion_out 0...
@export var flight_reach := 1.12 ## ...and at 1.
@export var flight_height := 0.14 ## Lengths above the stand's middle it flies.
@export var flight_radius := 0.1 ## Its radius, in lengths of the stand, for what it flies into (the pufferfish is about 0.1).
@export var companion_hit := {"damage": 0.0, "knockback": 0.0} ## What it does to whatever it flies into.


## A hit for `hits`.
static func hit(time: float, fist: String, damage: float, knockback: float, reach := 0.45, radius := 0.22, lift := 0.0, height := 0.12) -> Dictionary:
	return {"time": time, "fist": fist, "damage": damage, "knockback": knockback, "reach": reach,
		"radius": radius, "lift": lift, "height": height}


## Whether the move rallies its companion (see rally_at).
func rallies() -> bool:
	return rally_at >= 0.0


## Whether the move sends its companion flying (see flight_from).
func companion_flies() -> bool:
	return flight_from >= 0.0 and flight_until > flight_from


## Sends the companion flying from `from` to `until` seconds in (see flight_from), doing `damage` and
## `knockback` to whatever it flies into.
func fly_companion(from: float, until: float, damage: float, knockback: float) -> void:
	flight_from = from
	flight_until = until
	companion_hit = {"damage": damage, "knockback": knockback}


## How long the move lasts: its animation's length.
func duration() -> float:
	return animation.duration if animation else 0.0


## Whether the move may start now (stand_combat.gd asks before starting a special). Override for special
## moves that only work sometimes.
func can_start(_combat: Node) -> bool:
	return true


## Called as the move starts. Override for special moves.
func on_start(_combat: Node) -> void:
	pass


## Called at each hit's moment, after it's been checked. Override for special moves.
func on_hit_frame(_combat: Node, _hit: Dictionary) -> void:
	pass


## Called as the move ends. Override for special moves.
func on_end(_combat: Node) -> void:
	pass
