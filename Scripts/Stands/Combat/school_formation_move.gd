# A formation: a special that brings a school of the stand's kind together into it (the Anchovy's School
# Formation, anchovy_stand_moves.gd). Starting it asks the combat node for the cutscene
# (stand_combat.gd begin_formation(); possession.gd plays formation_director.gd), and once that's over
# the stand is formed: `size` times as big, hitting `damage_scale` times as hard, its moves playing at
# `attack_speed` of their speed and hits on it doing `damage_taken` of their damage. It breaks apart once
# its health is down to `ends_at` of full, and can't be made again that summon, or at all below that.
# Generated by Claude Code.
class_name SchoolFormationMove
extends StandMove

@export var size := 1.5
@export var damage_scale := 1.5
@export var attack_speed := 0.75
@export var damage_taken := 0.8
@export var ends_at := 0.25


func can_start(combat: Node) -> bool:
	return combat.can_form(ends_at)


func on_start(combat: Node) -> void:
	combat.begin_formation(self)
