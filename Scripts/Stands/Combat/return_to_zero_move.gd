# Return to Zero, the Jellyfish Stand's final ability (its ultimate, on stand_ultimate: jellyfish_stand_moves.gd).
# Like the jellyfish that turns back into a polyp instead of dying, it turns everything done to it back to
# zero: ZERO_AT seconds in (arms opening, a gold-white ring going out), for `zero_time` seconds (longer with
# its kind's Long Echo, the "zero_time" stat) no hit on it ever happens: each one is undone and whoever threw
# it is sent back to where they were moments before (stand_health.gd start_zero(), position_history.gd); a
# time stop that's running ends, and none can start against it meanwhile (time_stop.gd).
#
# Its meter fills from damage taken (stand_health.gd `ultimate`), and it can be used once a fight: it
# can't start until the meter's full, or once it's been used.
# Generated by Claude Code.
extends StandMove

const ZERO_AT := 0.5 ## Seconds in that it takes hold.

@export var zero_time := 6.0 ## Seconds it lasts.


func can_start(combat: Node) -> bool:
	var health := combat.get_parent().get_node_or_null("Health")
	return health != null and not health.ultimate_used and health.ultimate >= 1.0


func on_start(combat: Node) -> void:
	await combat.get_tree().create_timer(ZERO_AT, false, true).timeout
	if not is_instance_valid(combat) or combat.get_move() != self:
		return
	var stand := combat.get_parent() as Node3D
	var health := stand.get_node_or_null("Health")
	if health == null:
		return
	var skills := stand.get_node_or_null("/root/Skills") # (Looked up: this resource can be compiled before autoloads exist.)
	var seconds: float = zero_time + (skills.bonus(stand.scene_file_path, "zero_time") if skills else 0.0)
	health.start_zero(seconds)
	var stop := TimeStop.current()
	if stop and stop.user != stand:
		stop.cancel() # Back to zero: it never happened.
