	var gathered := StandAnimation.over(DRIFT, {"Rig": Vector3(10, 0, 0), "Neck": Vector3(-20, 0, 0),
		"ShoulderL": Vector3(80, 0, 30), "ShoulderR": Vector3(80, 0, -30), "ElbowL": Vector3(120, 0, 0), "ElbowR": Vector3(120, 0, 0),
		"KneeL": Vector3(-80, 0, 0), "KneeR": Vector3(-80, 0, 0), "HipL": Vector3(50, 0, 0), "HipR": Vector3(50, 0, 0), "scale": 0.92})
	var pulsed := StandAnimation.over(DRIFT, {"Rig": Vector3(-14, 0, 0), "Neck": Vector3(14, 0, 0),
		"ShoulderL": Vector3(60, 0, -80), "ShoulderR": Vector3(60, 0, 80), "ElbowL": Vector3(10, 0, 0), "ElbowR": Vector3(10, 0, 0),
		"HipL": Vector3(-10, 0, -20), "HipR": Vector3(-10, 0, 20), "KneeL": Vector3(-5, 0, 0), "KneeR": Vector3(-5, 0, 0), "scale": 1.08})
	var move := _move("Bell Pulse", 0.75, 0.04, 0.2, [
		StandKeyframeAnimation.key(0.0, DRIFT),
		StandKeyframeAnimation.key(0.28, gathered),
		StandKeyframeAnimation.key(0.36, pulsed),
		StandKeyframeAnimation.key(0.55, pulsed),
		StandKeyframeAnimation.key(0.75, DRIFT),
	])
	move.hits = [StandMove.hit(0.36, "both", 9.0, 20.0, 0.3, 0.6)]
	move.animation.events = [StandAnimation.event(0.36, "shockwave"), StandAnimation.event(0.36, "burst", "out")]
	move.cancel_from = 0.55
	move.move_speed_scale = 0.3
	move.stamina_cost = 14.0
