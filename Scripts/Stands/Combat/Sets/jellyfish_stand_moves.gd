# The Jellyfish Stand's moves (the immortal jellyfish, Turritopsis dohrnii). It doesn't hit hard; it stings,
# drifts, and refuses to die (stand_health.gd Immortal), so its fights are won by outlasting:
#   * Light, Sting: quick, loose open-handed jabs, left, right, then both, each leaving a little venom
#     (VENOM: a short slow, stand_status.gd) on what it touches. The defaults' uppercut stays after the second.
#   * Heavy, Bell Pulse: it gathers in, then pulses outward like a jellyfish swimming, a burst of water
#     that shoves anything close far away. Not charged.
#   * Barrage, Nematocyst Rush: a blur of stinging slaps, every one venomous, ending in a pulse.
#   * Block, Drift Guard: drawn in, arms folded over its bell, drifting back with the hit.
#   * Special, Polyp Reset (stand_special, polyp_reset_move.gd): it shrinks back into its polyp, shrugging
#     off slows and roots and healing a little, and blooms out again. Wild and rival Jellyfish use it too.
#   * Ultimate, Return to Zero (stand_ultimate, once learned: return_to_zero_move.gd): arms opening wide, a
#     gold-white ring, and for a few seconds nothing done to it happens.
# Generated by Claude Code.
class_name JellyfishStandMoves
extends DefaultStandMoves

const PolypResetMove := preload("res://Scripts/Stands/Combat/polyp_reset_move.gd")
const ReturnToZeroMove := preload("res://Scripts/Stands/Combat/return_to_zero_move.gd")

const VENOM := {"slow_time": 1.5, "slow_move": 0.85, "slow_attack": 0.85} ## What a sting leaves.

## Loose and floating: arms hanging forward, hands open, head a little down, legs trailing.
const DRIFT := {
	"Rig": Vector3(-4, 0, 0), "Neck": Vector3(-8, 0, 0),
	"ShoulderL": Vector3(30, 0, -18), "ShoulderR": Vector3(30, 0, 18),
	"ElbowL": Vector3(50, 0, 0), "ElbowR": Vector3(50, 0, 0),
	"HipL": Vector3(8, 0, -4), "HipR": Vector3(2, 0, 4),
	"KneeL": Vector3(-30, 0, 0), "KneeR": Vector3(-40, 0, 0),
}


func _init() -> void:
	super()
	var sting_l := make_sting("L")
	var sting_r := make_sting("R")
	var both := make_double_sting()
	sting_l.next_light = sting_r
	sting_r.next_light = both
	sting_r.next_heavy = light.next_light.next_heavy # The default uppercut finisher, kept.
	light = sting_l
	heavy = make_bell_pulse()
	barrage = make_nematocyst_rush()
	block = make_drift_guard()
	specials.append(make_polyp_reset())
	specials.append(make_return_to_zero())
	light_cooldown = 0.4
	heavy_cooldown = 2.2


## A hit that leaves venom.
static func venom_hit(time: float, fist: String, damage: float, knockback: float, reach := 0.5, radius := 0.24) -> Dictionary:
	var hit := StandMove.hit(time, fist, damage, knockback, reach, radius)
	hit["status"] = VENOM.duplicate()
	return hit


## A loose open-handed sting with one hand (`side` "L" or "R"), whipping out and back.
static func make_sting(side: String) -> StandMove:
	var turn := -1.0 if side == "L" else 1.0
	var move := _move("Sting", 0.3, 0.03, 0.12, [
		StandKeyframeAnimation.key(0.0, DRIFT),
		StandKeyframeAnimation.key(0.07, StandAnimation.over(DRIFT, {"Rig": Vector3(-8, turn * 12, 0),
			"Shoulder" + side: Vector3(88, 0, turn * 6), "Elbow" + side: Vector3(8, 0, 0)})),
		StandKeyframeAnimation.key(0.16, DRIFT),
		StandKeyframeAnimation.key(0.3, DRIFT),
	])
	move.hits = [venom_hit(0.07, side, 3.0, 2.5)]
	move.cancel_from = 0.1
	move.move_speed_scale = 0.6
	move.stamina_cost = 5.0
	return move


## Both hands lashing out together.
static func make_double_sting() -> StandMove:
	var out := StandAnimation.over(DRIFT, {"Rig": Vector3(-12, 0, 0), "ShoulderL": Vector3(90, 0, 14), "ShoulderR": Vector3(90, 0, -14),
		"ElbowL": Vector3(6, 0, 0), "ElbowR": Vector3(6, 0, 0)})
	var move := _move("Double Sting", 0.45, 0.03, 0.15, [
		StandKeyframeAnimation.key(0.0, DRIFT),
		StandKeyframeAnimation.key(0.08, StandAnimation.over(DRIFT, {"Rig": Vector3(8, 0, 0), "ShoulderL": Vector3(10, 0, -40), "ShoulderR": Vector3(10, 0, 40)})),
		StandKeyframeAnimation.key(0.15, out),
		StandKeyframeAnimation.key(0.28, out),
		StandKeyframeAnimation.key(0.45, DRIFT),
	])
	move.hits = [venom_hit(0.15, "both", 5.0, 6.0, 0.55, 0.3)]
	move.cancel_from = 0.28
	move.move_speed_scale = 0.4
	move.stamina_cost = 8.0
	return move


## The heavy: drawn in tight, then flung open in one swimming pulse: a burst of water that shoves
## everything close far away.
