## Held light: a blur of stinging slaps, ending in a pulse.
static func make_nematocyst_rush() -> StandMove:
	var left_out := StandAnimation.over(DRIFT, {"Rig": Vector3(-8, -10, 0), "ShoulderL": Vector3(88, 0, -6), "ElbowL": Vector3(10, 0, 0)})
	var right_out := StandAnimation.over(DRIFT, {"Rig": Vector3(-8, 10, 0), "ShoulderR": Vector3(88, 0, 6), "ElbowR": Vector3(10, 0, 0)})
	var pulse := StandAnimation.over(DRIFT, {"Rig": Vector3(-14, 0, 0), "ShoulderL": Vector3(60, 0, -70), "ShoulderR": Vector3(60, 0, 70),
		"ElbowL": Vector3(10, 0, 0), "ElbowR": Vector3(10, 0, 0)})
	var move := _move("Nematocyst Rush", 0.6, 0.03, 0.2, [
		StandKeyframeAnimation.key(0.0, DRIFT),
		StandKeyframeAnimation.key(0.06, left_out),
		StandKeyframeAnimation.key(0.12, right_out),
		StandKeyframeAnimation.key(0.18, left_out),
		StandKeyframeAnimation.key(0.3, pulse),
		StandKeyframeAnimation.key(0.42, pulse),
		StandKeyframeAnimation.key(0.6, DRIFT),
	])
	move.animation.loop_start = 0.06
	move.animation.loop_end = 0.18
	move.animation.afterimages = true
	move.hits = [venom_hit(0.06, "L", 1.2, 1.5), venom_hit(0.12, "R", 1.2, 1.5),
		StandMove.hit(0.3, "both", 6.0, 14.0, 0.35, 0.55)]
	move.animation.events = [StandAnimation.event(0.3, "shockwave")]
	move.cancel_from = 0.42
	move.move_speed_scale = 0.4
	move.stamina_cost = 8.0
	move.stamina_drain = 24.0
	return move


