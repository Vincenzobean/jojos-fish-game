## The special: curled up small into its polyp (shrinking, a pale flash), then blooming back out.
static func make_polyp_reset() -> StandMove:
	var polyp := {"Rig": Vector3(-20, 0, 0), "Neck": Vector3(-30, 0, 0), "lift": Vector3(0, -0.3, 0), "scale": 0.45,
		"ShoulderL": Vector3(150, 0, 10), "ShoulderR": Vector3(150, 0, -10), "ElbowL": Vector3(20, 0, 0), "ElbowR": Vector3(20, 0, 0),
		"HipL": Vector3(80, 0, 0), "HipR": Vector3(80, 0, 0), "KneeL": Vector3(-130, 0, 0), "KneeR": Vector3(-130, 0, 0)}
	var bloom := StandAnimation.over(DRIFT, {"Rig": Vector3(6, 0, 0), "Neck": Vector3(18, 0, 0),
		"ShoulderL": Vector3(70, 0, -75), "ShoulderR": Vector3(70, 0, 75), "ElbowL": Vector3(10, 0, 0), "ElbowR": Vector3(10, 0, 0), "scale": 1.05})
	var move := PolypResetMove.new()
	move.display_name = "Polyp Reset"
	var anim := StandKeyframeAnimation.new()
	anim.duration = 1.2
	anim.blend_in = 0.05
	anim.blend_out = 0.25
	anim.keys.assign([
		StandKeyframeAnimation.key(0.0, DRIFT),
		StandKeyframeAnimation.key(0.3, polyp),
		StandKeyframeAnimation.key(PolypResetMove.RESET_AT + 0.1, StandAnimation.over(polyp, {"shake": 2.0})),
		StandKeyframeAnimation.key(0.85, bloom),
		StandKeyframeAnimation.key(1.2, DRIFT),
	])
	anim.events = [StandAnimation.event(PolypResetMove.RESET_AT, "perfect"), StandAnimation.event(0.8, "shockwave")]
	move.animation = anim
	move.input = &"stand_special"
	move.cooldown = 15.0
	move.cooldown_icon = &"heart"
	move.cancel_from = 0.9
	move.move_speed_scale = 0.2
	move.stamina_cost = 15.0
	return move


