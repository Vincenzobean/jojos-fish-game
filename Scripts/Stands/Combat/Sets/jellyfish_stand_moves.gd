	var opened := {"Rig": Vector3(12, 0, 0), "Neck": Vector3(28, 0, 0), "lift": Vector3(0, 0.25, 0),
		"ShoulderL": Vector3(40, 0, -100), "ShoulderR": Vector3(40, 0, 100), "ElbowL": Vector3(5, 0, 0), "ElbowR": Vector3(5, 0, 0),
		"HipL": Vector3(0, 0, -10), "HipR": Vector3(0, 0, 10), "KneeL": Vector3(-15, 0, 0), "KneeR": Vector3(-15, 0, 0)}
	var move := ReturnToZeroMove.new()
