# The Mantis Shrimp Stand's moves (Still Water, the final boss's stand: boss_stand_brain.gd). A mantis
# shrimp throws the fastest punch in nature: its clubs (stand_body_model.gd) strike so fast the water
# boils into a cavitation bubble that bursts on the target a moment after the blow, hitting it twice.
# So it strikes so fast the world seems to stop around it, and at its peak it really does stop:
#   * Light, Smasher Jab: very quick jabs with each club in turn, then a Double Tap (both clubs, each
#     followed by its bubble bursting). The uppercut finisher after the second jab is the defaults'.
#   * Heavy, Club Strike: the right club cocked back by the ear, then snapped out with a lunge; its
#     cavitation bubble bursts a beat later for a second, bigger hit that knocks the target flying.
#   * Barrage, Cavitation Rush: the defaults' barrage, but faster and harder, the bubbles bursting all
#     over the target.
#   * Block, Carapace Guard: clubs crossed over its head, the shell taking it.
#   * Specials, only ever used by its brain (their actions have no keys):
#       - Stasis (time_stop_move.gd): a tell (clubs crossed before its eyes, which flare), then it flings
#         its arms wide and stops time (time_stop.gd) for its brain's stasis_time.
#       - Bubble Burst: snaps both clubs at the water in front of it, sending three cavitation bubbles
#         out ahead that burst further and further away: zoning.
# Poses fold the forearms up tight against the upper arms like a mantis shrimp's raptorial claws (elbows
# bent past 130), snapping them straight to strike.
# Generated by Claude Code.
class_name MantisShrimpStandMoves
extends DefaultStandMoves

const TimeStopMove := preload("res://Scripts/Stands/Combat/time_stop_move.gd")

const BUBBLE_DELAY := 0.08 ## Seconds after a club lands that its cavitation bubble bursts.

## Clubs folded tight in front of the chest, ready to snap out; a wide, low stance.
const CLUB_GUARD := {
	"Rig": Vector3(-8, 0, 0), "Neck": Vector3(-6, 0, 0),
	"ShoulderL": Vector3(55, 0, -18), "ShoulderR": Vector3(55, 0, 18),
	"ElbowL": Vector3(140, 0, 0), "ElbowR": Vector3(140, 0, 0),
	"HipL": Vector3(16, 0, -10), "HipR": Vector3(-8, 0, 10),
	"KneeL": Vector3(-34, 0, 0), "KneeR": Vector3(-18, 0, 0),
}


func _init() -> void:
	super()
	var jab_l := make_smasher_jab("L")
	var jab_r := make_smasher_jab("R")
	var double := make_double_tap()
	jab_l.next_light = jab_r
	jab_r.next_light = double
	jab_r.next_heavy = light.next_light.next_heavy # The default uppercut finisher, kept.
	light = jab_l
	heavy = make_club_strike()
	barrage = make_cavitation_rush()
	block = make_carapace_guard()
	specials = [make_stasis(), make_bubble_burst()]
	light_cooldown = 0.35
	heavy_cooldown = 1.8
	barrage_cooldown = 5.0


## A club's strike landing, and its bubble bursting just after: the hit pair every club blow makes.
static func club_hits(time: float, fist: String, damage: float, knockback: float, reach := 0.45, radius := 0.24) -> Array[Dictionary]:
	return [StandMove.hit(time, fist, damage, knockback * 0.3, reach, radius),
		StandMove.hit(time + BUBBLE_DELAY, fist, damage * 0.6, knockback, reach + 0.05, radius + 0.06)]


## A snap of one club (`side` "L" or "R") straight out from the folded guard and straight back.
static func make_smasher_jab(side: String) -> StandMove:
	var turn := -1.0 if side == "L" else 1.0
	var shoulder := "Shoulder" + side
	var elbow := "Elbow" + side
	var move := _move("Smasher Jab", 0.26, 0.02, 0.1, [
		StandKeyframeAnimation.key(0.0, CLUB_GUARD),
		StandKeyframeAnimation.key(0.05, StandAnimation.over(CLUB_GUARD, {"Rig": Vector3(-10, turn * 14, 0),
			shoulder: Vector3(90, 0, turn * 4), elbow: Vector3(0, 0, 0)})),
		StandKeyframeAnimation.key(0.13, CLUB_GUARD),
		StandKeyframeAnimation.key(0.26, CLUB_GUARD),
	])
	var hits := club_hits(0.05, side, 3.5, 4.0)
	move.hits = hits
	move.animation.events = [StandAnimation.event(0.05 + BUBBLE_DELAY, "impact", "out")]
	move.cancel_from = 0.08
	move.move_speed_scale = 0.55
	move.stamina_cost = 5.0
	return move


## Both clubs together, straight out, then both bubbles at once.
static func make_double_tap() -> StandMove:
	var out := StandAnimation.over(CLUB_GUARD, {"Rig": Vector3(-14, 0, 0), "Neck": Vector3(6, 0, 0),
		"ShoulderL": Vector3(88, 0, 10), "ShoulderR": Vector3(88, 0, -10),
		"ElbowL": Vector3(0, 0, 0), "ElbowR": Vector3(0, 0, 0)})
	var move := _move("Double Tap", 0.42, 0.02, 0.15, [
		StandKeyframeAnimation.key(0.0, CLUB_GUARD),
		StandKeyframeAnimation.key(0.06, StandAnimation.over(CLUB_GUARD, {"Rig": Vector3(6, 0, 0), "ElbowL": Vector3(150, 0, 0), "ElbowR": Vector3(150, 0, 0)})),
		StandKeyframeAnimation.key(0.11, out),
		StandKeyframeAnimation.key(0.24, out),
		StandKeyframeAnimation.key(0.42, CLUB_GUARD),
	])
	move.hits = club_hits(0.11, "both", 6.0, 9.0, 0.45, 0.3)
	move.animation.events = [StandAnimation.event(0.11 + BUBBLE_DELAY, "burst", "out")]
	move.cancel_from = 0.26
	move.move_speed_scale = 0.4
	move.lunge_speed = 6.0
	move.lunge_at = 0.06
	move.lunge_time = 0.06
	move.stamina_cost = 8.0
	return move


## The heavy: the right club cocked back by the ear, the body coiled, then snapped out with a lunge;
## the bubble's burst is the bigger hit.
static func make_club_strike() -> StandMove:
	var cocked := StandAnimation.over(CLUB_GUARD, {"Rig": Vector3(4, -30, 0), "Neck": Vector3(-4, 10, 0),
		"ShoulderR": Vector3(-20, 0, 30), "ElbowR": Vector3(150, 0, 0),
		"KneeL": Vector3(-46, 0, 0), "KneeR": Vector3(-30, 0, 0), "shake": 1.5})
	var snapped := StandAnimation.over(CLUB_GUARD, {"Rig": Vector3(-20, 32, 0), "Neck": Vector3(12, 0, 0),
		"ShoulderR": Vector3(92, 0, 0), "ElbowR": Vector3(0, 0, 0),
		"HipL": Vector3(28, 0, -8), "HipR": Vector3(-22, 0, 8)})
	var move := _move("Club Strike", 0.7, 0.03, 0.2, [
		StandKeyframeAnimation.key(0.0, CLUB_GUARD),
		StandKeyframeAnimation.key(0.24, cocked),
		StandKeyframeAnimation.key(0.29, snapped),
		StandKeyframeAnimation.key(0.48, snapped),
		StandKeyframeAnimation.key(0.7, CLUB_GUARD),
	])
	move.hits = club_hits(0.29, "R", 9.0, 16.0, 0.5, 0.3)
	move.animation.events = [StandAnimation.event(0.29, "sonic_boom", "out", Vector3(0, 0, -1)),
		StandAnimation.event(0.29 + BUBBLE_DELAY, "burst", "out")]
	move.cancel_from = 0.48
	move.move_speed_scale = 0.2
	move.lunge_speed = 12.0
	move.lunge_at = 0.24
	move.lunge_time = 0.1
	move.stamina_cost = 14.0
	return move


## Held light: the clubs a blur, faster than the defaults', every blow's bubble bursting; then both clubs
## snapped out together to finish.
static func make_cavitation_rush() -> StandMove:
	var left_out := StandAnimation.over(CLUB_GUARD, {"Rig": Vector3(-10, -8, 0),
		"ShoulderL": Vector3(90, 0, -4), "ElbowL": Vector3(0, 0, 0),
		"ShoulderR": Vector3(55, 0, 14), "ElbowR": Vector3(135, 0, 0)})
	var right_out := StandAnimation.over(CLUB_GUARD, {"Rig": Vector3(-10, 8, 0),
		"ShoulderR": Vector3(90, 0, 4), "ElbowR": Vector3(0, 0, 0),
		"ShoulderL": Vector3(55, 0, -14), "ElbowL": Vector3(135, 0, 0)})
	var finish := StandAnimation.over(CLUB_GUARD, {"Rig": Vector3(-18, 0, 0), "Neck": Vector3(10, 0, 0),
		"ShoulderL": Vector3(92, 0, 8), "ShoulderR": Vector3(92, 0, -8),
		"ElbowL": Vector3(0, 0, 0), "ElbowR": Vector3(0, 0, 0)})
	var move := _move("Cavitation Rush", 0.5, 0.02, 0.18, [
		StandKeyframeAnimation.key(0.0, CLUB_GUARD),
		StandKeyframeAnimation.key(0.05, left_out),
		StandKeyframeAnimation.key(0.1, right_out),
		StandKeyframeAnimation.key(0.15, left_out),
		StandKeyframeAnimation.key(0.24, finish),
		StandKeyframeAnimation.key(0.32, finish),
		StandKeyframeAnimation.key(0.5, CLUB_GUARD),
	])
	move.animation.loop_start = 0.05
	move.animation.loop_end = 0.15
	move.animation.afterimages = true
	move.hits = [
		StandMove.hit(0.05, "L", 1.4, 2.5),
		StandMove.hit(0.1, "R", 1.4, 2.5),
		StandMove.hit(0.24, "both", 6.0, 14.0, 0.45, 0.32),
		StandMove.hit(0.24 + BUBBLE_DELAY, "both", 4.0, 6.0, 0.5, 0.36),
	]
	move.animation.events = [StandAnimation.event(0.24 + BUBBLE_DELAY, "burst", "out")]
	move.cancel_from = 0.32
	move.move_speed_scale = 0.35
	move.stamina_cost = 8.0
	move.stamina_drain = 26.0
	return move


## Held block: clubs crossed high over its head, the shell of its forearms turned out.
static func make_carapace_guard() -> StandMove:
	var guard_up := StandAnimation.over(CLUB_GUARD, {"Rig": Vector3(-14, 0, 0), "Neck": Vector3(-18, 0, 0),
		"ShoulderL": Vector3(120, 0, 28), "ShoulderR": Vector3(120, 0, -28),
		"ElbowL": Vector3(105, 0, 0), "ElbowR": Vector3(105, 0, 0),
		"KneeL": Vector3(-42, 0, 0), "KneeR": Vector3(-30, 0, 0)})
	var move := _move("Carapace Guard", 0.4, 0.03, 0.18, [
		StandKeyframeAnimation.key(0.0, CLUB_GUARD),
		StandKeyframeAnimation.key(0.07, guard_up),
		StandKeyframeAnimation.key(0.22, CLUB_GUARD),
		StandKeyframeAnimation.key(0.4, CLUB_GUARD),
	])
	move.animation.loop_start = 0.07
	move.animation.loop_end = 0.07
	move.move_speed_scale = 0.4
	return move


## The time stop. The tell: clubs crossed before its eyes, shaking, which flare (STASIS_AT is when time
## stops); then arms flung wide, chest out, as the world stops.
static func make_stasis() -> StandMove:
	var tell := StandAnimation.over(CLUB_GUARD, {"Rig": Vector3(6, 0, 0), "Neck": Vector3(-10, 0, 0),
		"ShoulderL": Vector3(100, 0, 30), "ShoulderR": Vector3(100, 0, -30),
		"ElbowL": Vector3(120, 0, 0), "ElbowR": Vector3(120, 0, 0), "shake": 2.5})
	var flung := {"Rig": Vector3(14, 0, 0), "Neck": Vector3(26, 0, 0), "lift": Vector3(0, 0.15, 0),
		"ShoulderL": Vector3(20, 0, -95), "ShoulderR": Vector3(20, 0, 95),
		"ElbowL": Vector3(25, 0, 0), "ElbowR": Vector3(25, 0, 0),
		"HipL": Vector3(0, 0, -14), "HipR": Vector3(0, 0, 14),
		"KneeL": Vector3(-10, 0, 0), "KneeR": Vector3(-10, 0, 0)}
	var move := TimeStopMove.new()
	move.display_name = "Stasis"
	var anim := StandKeyframeAnimation.new()
	anim.duration = 1.0
	anim.blend_in = 0.08
	anim.blend_out = 0.25
	anim.keys.assign([
		StandKeyframeAnimation.key(0.0, CLUB_GUARD),
		StandKeyframeAnimation.key(0.2, tell),
		StandKeyframeAnimation.key(TimeStopMove.STASIS_AT - 0.05, StandAnimation.over(tell, {"shake": 4.0})),
		StandKeyframeAnimation.key(TimeStopMove.STASIS_AT + 0.05, flung),
		StandKeyframeAnimation.key(0.85, flung),
		StandKeyframeAnimation.key(1.0, CLUB_GUARD),
	])
	anim.events = [StandAnimation.event(0.2, "gather", "head"), StandAnimation.event(0.4, "gather", "head"),
		StandAnimation.event(TimeStopMove.STASIS_AT, "burst")]
	move.animation = anim
	move.input = &"boss_time_stop"
	move.super_armor = true # Once it starts, it can't be knocked out of it: dodge, don't trade.
	move.cooldown = 4.0
	move.cooldown_icon = &"burst"
	move.cancel_from = 0.85
	move.move_speed_scale = 0.0
	return move


## Both clubs snapped down at the water in front of it, three cavitation bubbles bursting further and
## further out ahead.
static func make_bubble_burst() -> StandMove:
	var snap := StandAnimation.over(CLUB_GUARD, {"Rig": Vector3(-22, 0, 0), "Neck": Vector3(-8, 0, 0),
		"ShoulderL": Vector3(70, 0, 12), "ShoulderR": Vector3(70, 0, -12),
		"ElbowL": Vector3(0, 0, 0), "ElbowR": Vector3(0, 0, 0)})
	var move := _move("Bubble Burst", 1.0, 0.04, 0.2, [
		StandKeyframeAnimation.key(0.0, CLUB_GUARD),
		StandKeyframeAnimation.key(0.22, StandAnimation.over(CLUB_GUARD, {"Rig": Vector3(10, 0, 0), "ElbowL": Vector3(155, 0, 0), "ElbowR": Vector3(155, 0, 0), "shake": 1.5})),
		StandKeyframeAnimation.key(0.28, snap),
		StandKeyframeAnimation.key(0.7, snap),
		StandKeyframeAnimation.key(1.0, CLUB_GUARD),
	])
	move.hits = []
	move.animation.events = []
	for i in 3:
		var at := 0.36 + 0.14 * i
		move.hits.append(StandMove.hit(at, "both", 5.0, 8.0, 0.9 + 0.6 * i, 0.4, 2.0, -0.05))
		move.animation.events.append(StandAnimation.event(at, "burst", "out", Vector3(0, 0, -1.0 - 0.6 * i)))
	move.input = &"boss_bubble"
	move.cooldown = 6.0
	move.cooldown_icon = &"burst"
	move.cancel_from = 0.75
	move.move_speed_scale = 0.2
	move.stamina_cost = 12.0
	return move
