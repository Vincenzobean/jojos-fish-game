# The moves every stand fights with unless it brings its own: a light chain (jab, cross, hook), a
# charged, lunging haymaker for heavy, an uppercut finisher for heavy right after the second light
# punch, a held ORA-ORA barrage, and a held block; plus the moves learned from the skill tree: a rush
# punch out of a dash, a finale to a long barrage, and a counter after a block. Stands with their own style extend this and
# replace or add moves in _init(), the way violet_stand_animations.gd does for animations.
#
# Poses are angles of the stand rig's pivots (see stand_animation.gd): +X swings an arm forward (90 is
# straight out in front), elbows bend forward with +X, +Y on "Rig" turns the body to its left (so a
# right-handed punch turns it left), and Z swings arms out to the sides.
# Generated by Claude Code.
class_name DefaultStandMoves
extends StandMoveSet

## Fists up by the chin, leaning in a little, legs in a fighting stance. Every move starts and ends here.
const GUARD := {
	"Rig": Vector3(-5, 0, 0), "Neck": Vector3(-5, 0, 0),
	"ShoulderL": Vector3(40, 0, -8), "ShoulderR": Vector3(40, 0, 8),
	"ElbowL": Vector3(110, 0, 0), "ElbowR": Vector3(110, 0, 0),
	"HipL": Vector3(12, 0, -6), "HipR": Vector3(-6, 0, 6),
	"KneeL": Vector3(-28, 0, 0), "KneeR": Vector3(-14, 0, 0),
}


func _init() -> void:
	var jab := make_jab()
	var cross := make_cross()
	var hook := make_hook()
	var uppercut := make_uppercut()
	jab.next_light = cross
	cross.next_light = hook
	cross.next_heavy = uppercut # The finisher only after two light hits.
	light = jab
	heavy = make_haymaker()
	barrage = make_barrage()
	block = make_block()
	dash_strike = make_dash_strike()
	barrage_finisher = make_barrage_finisher()
	counter = make_counter()


## A quick left jab.
static func make_jab() -> StandMove:
	var move := _move("Jab", 0.32, 0.03, 0.12, [
		StandKeyframeAnimation.key(0.0, GUARD),
		StandKeyframeAnimation.key(0.07, StandAnimation.over(GUARD, {"Rig": Vector3(-8, -12, 0),
			"ShoulderL": Vector3(88, 0, -4), "ElbowL": Vector3(2, 0, 0)})),
		StandKeyframeAnimation.key(0.17, GUARD),
		StandKeyframeAnimation.key(0.32, GUARD),
	])
	move.hits = [StandMove.hit(0.07, "L", 4.0, 4.0)]
	move.cancel_from = 0.1
	move.move_speed_scale = 0.5
	move.stamina_cost = 6.0
	return move


