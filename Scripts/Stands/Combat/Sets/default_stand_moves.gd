## The heavy: winds the right fist back and holds it there charging while heavy is held, then lunges
## into a haymaker once let go (if it charged long enough).
static func make_haymaker() -> StandMove:
	var wind_up := haymaker_wind_up()
	var strike := haymaker_strike()
	var move := _move("Haymaker", 0.75, 0.04, 0.2, [
		StandKeyframeAnimation.key(0.0, GUARD),
		StandKeyframeAnimation.key(0.22, wind_up),
		StandKeyframeAnimation.key(0.32, strike),
		StandKeyframeAnimation.key(0.5, strike),
		StandKeyframeAnimation.key(0.75, GUARD),
	])
	move.hits = [StandMove.hit(0.32, "R", 14.0, 14.0, 0.5, 0.28)]
	# Charged: holds the wind-up while heavy is held; at least 1 s to throw it, full power at 2.5 s.
	move.animation.loop_start = 0.22
	move.animation.loop_end = 0.22
	move.charge_min = 1.0
	move.charge_full = 2.5
	move.cancel_from = 0.5
	move.move_speed_scale = 0.2
	move.lunge_speed = 10.0
	move.lunge_at = 0.24
	move.lunge_time = 0.12
	move.stamina_cost = 18.0
	move.stamina_drain = 10.0 # While charging.
	return move


## The haymaker's wind-up: turned away, the right fist cocked back by the ear, crouched to spring.
static func haymaker_wind_up() -> Dictionary:
	return StandAnimation.over(GUARD, {"Rig": Vector3(5, -35, 0),
		"ShoulderR": Vector3(-35, 0, 25), "ElbowR": Vector3(110, 0, 0),
		"KneeL": Vector3(-40, 0, 0), "KneeR": Vector3(-30, 0, 0)})


## The haymaker landing: turned hard into it, the right arm straight out.
static func haymaker_strike() -> Dictionary:
	return StandAnimation.over(GUARD, {"Rig": Vector3(-18, 30, 0), "Neck": Vector3(10, 0, 0),
		"ShoulderR": Vector3(92, 0, 0), "ElbowR": Vector3(0, 0, 0),
		"HipL": Vector3(25, 0, -6), "HipR": Vector3(-20, 0, 6)})


## The finisher (heavy right after the second light punch): drops into a crouch, then a rising right
## uppercut that launches whatever it hits.
static func make_uppercut() -> StandMove:
	var crouch := StandAnimation.over(GUARD, {"Rig": Vector3(-20, -15, 0), "lift": Vector3(0, -0.15, 0),
		"ShoulderR": Vector3(10, 0, 10), "ElbowR": Vector3(120, 0, 0),
		"HipL": Vector3(45, 0, -6), "HipR": Vector3(30, 0, 6),
		"KneeL": Vector3(-60, 0, 0), "KneeR": Vector3(-55, 0, 0)})
	# It connects with the fist rising in front of the chin...
	var connect := StandAnimation.over(GUARD, {"Rig": Vector3(0, 20, 0), "Neck": Vector3(10, 0, 0), "lift": Vector3(0, 0.15, 0),
		"ShoulderR": Vector3(110, 0, 5), "ElbowR": Vector3(70, 0, 0),
		"HipL": Vector3(20, 0, -5), "HipR": Vector3(10, 0, 5),
		"KneeL": Vector3(-30, 0, 0), "KneeR": Vector3(-25, 0, 0)})
	# ...and follows through overhead, rising off its feet.
	var rise := StandAnimation.over(GUARD, {"Rig": Vector3(10, 20, 0), "Neck": Vector3(25, 0, 0), "lift": Vector3(0, 0.35, 0),
		"ShoulderR": Vector3(165, 0, 5), "ElbowR": Vector3(25, 0, 0),
		"HipL": Vector3(0, 0, -4), "HipR": Vector3(-8, 0, 4),
		"KneeL": Vector3(-10, 0, 0), "KneeR": Vector3(-6, 0, 0)})
	var move := _move("Uppercut", 0.7, 0.04, 0.2, [
		StandKeyframeAnimation.key(0.0, GUARD),
		StandKeyframeAnimation.key(0.15, crouch),
		StandKeyframeAnimation.key(0.27, connect),
		StandKeyframeAnimation.key(0.38, rise),
		StandKeyframeAnimation.key(0.48, rise),
		StandKeyframeAnimation.key(0.7, GUARD),
	])
	move.hits = [StandMove.hit(0.27, "R", 12.0, 6.0, 0.25, 0.26, 12.0, 0.35)]
	move.cancel_from = 0.45
	move.move_speed_scale = 0.2
	move.stamina_cost = 15.0
	return move


## Held light: fists flying in turn, too fast to follow (afterimages), looping while held, then a
## two-fisted shove to finish once let go.
static func make_barrage() -> StandMove:
	var left_out := StandAnimation.over(GUARD, {"Rig": Vector3(-8, -10, 0),
		"ShoulderL": Vector3(88, 0, -6), "ElbowL": Vector3(2, 0, 0),
		"ShoulderR": Vector3(45, 0, 10), "ElbowR": Vector3(100, 0, 0)})
	var right_out := StandAnimation.over(GUARD, {"Rig": Vector3(-8, 10, 0),
		"ShoulderR": Vector3(88, 0, 6), "ElbowR": Vector3(2, 0, 0),
		"ShoulderL": Vector3(45, 0, -10), "ElbowL": Vector3(100, 0, 0)})
	var shove := StandAnimation.over(GUARD, {"Rig": Vector3(-15, 0, 0), "Neck": Vector3(10, 0, 0),
		"ShoulderL": Vector3(90, 0, 8), "ShoulderR": Vector3(90, 0, -8),
		"ElbowL": Vector3(0, 0, 0), "ElbowR": Vector3(0, 0, 0)})
	var move := _move("Barrage", 0.62, 0.03, 0.2, [
		StandKeyframeAnimation.key(0.0, GUARD),
		StandKeyframeAnimation.key(0.08, left_out),
		StandKeyframeAnimation.key(0.16, right_out),
		StandKeyframeAnimation.key(0.24, left_out),
		StandKeyframeAnimation.key(0.34, shove),
		StandKeyframeAnimation.key(0.42, shove),
		StandKeyframeAnimation.key(0.62, GUARD),
	])
	move.animation.loop_start = 0.08
	move.animation.loop_end = 0.24
	move.animation.afterimages = true
	move.hits = [
		StandMove.hit(0.08, "L", 1.2, 3.0),
		StandMove.hit(0.16, "R", 1.2, 3.0),
		StandMove.hit(0.34, "both", 5.0, 12.0, 0.45, 0.3),
	]
	move.cancel_from = 0.42
	move.move_speed_scale = 0.3
	move.stamina_cost = 8.0
	move.stamina_drain = 30.0 # While held.
	return move


