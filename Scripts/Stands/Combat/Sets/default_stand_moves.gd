# A move with a keyframed animation of `keys`, `duration` long, blending in and out as given.
static func _move(name: String, duration: float, blend_in: float, blend_out: float, keys: Array) -> StandMove:
	var anim := StandKeyframeAnimation.new()
	anim.duration = duration
	anim.blend_in = blend_in
	anim.blend_out = blend_out
	anim.keys.assign(keys)
	var move := StandMove.new()
	move.display_name = name
	move.animation = anim
	return move


## The guard with `extra` laid over it.
static func on_guard(extra: Dictionary) -> Dictionary:
	return StandAnimation.over(GUARD, extra)
