# The Squid Stand's moves: area denial with its tentacles (stand_body.gd tentacles), keeping foes at
# arm's length and pinning them where they stand. Its fists are the defaults' (barrage, block, counter,
# rush punch); its attacks are its two front tentacles, stretched out with "tentacle_reach":
#   * Light: a lash with the left tentacle, a lash with the right, then both at once: long reach, wide,
#     light hits that keep things off it.
#   * Heavy, Tentacle Bind: the tentacles draw back and shoot out further still, wrapping whatever they
#     reach and holding it fast (rooted for ROOT_TIME, stand_status.gd), pulling it in a little. Slow to
#     come again (heavy_cooldown).
#   * Its special, Ink Spray (stand_special, once learned from SquidStandSkillTree's Ink branch): it rears
#     back, its mantle swelling, and sprays a jet of ink ahead; whatever it hits is slowed for SLOW_TIME,
#     its flying and its moves, and a cloud of ink hangs where it landed. Wild Squids never use it.
# The tentacles grow from its back (stand_body_visuals.gd), so poses swing them past 90 degrees to bring them
# up over its shoulders and out ahead; "tentacle_curl" coils them back to load a strike and wraps them round
# what they catch, and the visuals' springy lag makes every swing whip.
# Generated by Claude Code.
class_name SquidStandMoves
extends DefaultStandMoves

const ROOT_TIME := 1.5 ## Seconds Tentacle Bind holds what it catches.
const SLOW_TIME := 4.0 ## Seconds Ink Spray slows what it hits...
const SLOW_MOVE := 0.5 ## ...to this share of its flying speed...
const SLOW_ATTACK := 0.6 ## ...and this share of its moves' speed.


func _init() -> void:
	super()
	var left := make_lash("Tentacle Lash", "L", 3.5)
	var right := make_lash("Tentacle Lash", "R", 4.0)
	var both := make_double_lash()
	left.next_light = right
	right.next_light = both
	right.next_heavy = light.next_light.next_heavy # The default uppercut finisher, kept.
	light = left
	heavy = make_tentacle_bind()
	heavy_cooldown = 4.0
	specials.append(make_ink_spray())


## A lash with one upper tentacle (`side` "L" or "R"): it swings back, then whips up over the shoulder and
## across in front at full stretch.
static func make_lash(name: String, side: String, damage: float) -> StandMove:
	var turn := -1.0 if side == "L" else 1.0
	var tentacle := "Tentacle" + "F" + side
	var move := _move(name, 0.42, 0.03, 0.12, [
		StandKeyframeAnimation.key(0.0, GUARD),
		StandKeyframeAnimation.key(0.08, on_guard({"Rig": Vector3(0, turn * 20, 0), tentacle: Vector3(-20, 0, turn * 40), "tentacle_reach": 0.2, "tentacle_curl": -25.0})),
		StandKeyframeAnimation.key(0.15, on_guard({"Rig": Vector3(-6, -turn * 15, 0), tentacle: Vector3(115, 0, -turn * 25), "tentacle_reach": 0.7, "tentacle_curl": 8.0})),
		StandKeyframeAnimation.key(0.26, on_guard({tentacle: Vector3(75, 0, -turn * 10), "tentacle_reach": 0.3, "tentacle_curl": 18.0})),
		StandKeyframeAnimation.key(0.42, GUARD),
	])
	move.hits = [StandMove.hit(0.15, side, damage, 5.0, 0.95, 0.32, 0.0, 0.0)]
	move.cancel_from = 0.18
	move.move_speed_scale = 0.55
	move.stamina_cost = 6.0
	return move


## Both upper tentacles raised high over the head and lashing down at once, the furthest and widest of the chain.
static func make_double_lash() -> StandMove:
	var raised := on_guard({"Rig": Vector3(10, 0, 0), "Neck": Vector3(10, 0, 0),
		"TentacleFL": Vector3(160, 0, 15), "TentacleFR": Vector3(160, 0, -15), "tentacle_reach": 0.4, "tentacle_curl": -30.0})
	var down := on_guard({"Rig": Vector3(-15, 0, 0), "Neck": Vector3(-15, 0, 0),
		"TentacleFL": Vector3(100, 0, 5), "TentacleFR": Vector3(100, 0, -5), "tentacle_reach": 0.8, "tentacle_curl": -12.0})
	var move := _move("Double Lash", 0.55, 0.03, 0.15, [
		StandKeyframeAnimation.key(0.0, GUARD),
		StandKeyframeAnimation.key(0.12, raised),
		StandKeyframeAnimation.key(0.2, down),
		StandKeyframeAnimation.key(0.34, StandAnimation.over(down, {"tentacle_reach": 0.4})),
		StandKeyframeAnimation.key(0.55, GUARD),
	])
	move.hits = [StandMove.hit(0.2, "both", 6.0, 8.0, 1.1, 0.4, 0.0, 0.0)]
	move.cancel_from = 0.3
	move.move_speed_scale = 0.4
	move.stamina_cost = 8.0
	return move


## The heavy: the upper tentacles coil back, then shoot out over the shoulders straight and long, wrapping whatever they
## reach and holding it (rooted) while they're held out, then let go and curl home.
static func make_tentacle_bind() -> StandMove:
	var coiled := on_guard({"Rig": Vector3(12, 0, 0), "Neck": Vector3(10, 0, 0),
		"TentacleFL": Vector3(-40, 0, 25), "TentacleFR": Vector3(-40, 0, -25), "tentacle_reach": 0.0, "tentacle_curl": -35.0})
	var out := on_guard({"Rig": Vector3(-12, 0, 0), "Neck": Vector3(-12, 0, 0),
		"TentacleFL": Vector3(107, 0, 4), "TentacleFR": Vector3(107, 0, -4), "tentacle_reach": 1.0})
	var holding := StandAnimation.over(out, {"TentacleFL": Vector3(103, 0, 10), "TentacleFR": Vector3(103, 0, -10), "tentacle_reach": 0.85, "tentacle_curl": -16.0, "shake": 1.5}) # Curled down round what they hold.
	var move := _move("Tentacle Bind", 1.6, 0.04, 0.25, [
		StandKeyframeAnimation.key(0.0, GUARD),
		StandKeyframeAnimation.key(0.3, coiled),
		StandKeyframeAnimation.key(0.4, out),
		StandKeyframeAnimation.key(0.55, holding),
		StandKeyframeAnimation.key(1.3, holding),
		StandKeyframeAnimation.key(1.6, GUARD),
	])
	var bind := StandMove.hit(0.4, "both", 5.0, -3.0, 1.3, 0.38, 0.0, 0.0) # Knockback back toward it: pulled in.
	bind["status"] = {"root_time": ROOT_TIME}
	move.hits = [bind]
	move.cancel_from = 1.25
	move.move_speed_scale = 0.15
	move.stamina_cost = 14.0
	return move


## The special: rearing back, the mantle swelling and trembling, then lunging the head forward to spray
## a jet of ink a long way ahead, three times along it, and a cloud of ink hanging out in front.
static func make_ink_spray() -> StandMove:
	var rear := on_guard({"Rig": Vector3(20, 0, 0), "Neck": Vector3(28, 0, 0),
		"ShoulderL": Vector3(10, 0, -45), "ShoulderR": Vector3(10, 0, 45),
		"TentacleFL": Vector3(30, 0, 30), "TentacleFR": Vector3(30, 0, -30),
		"TentacleBL": Vector3(20, 0, 35), "TentacleBR": Vector3(20, 0, -35), "tentacle_curl": -20.0, "scale": 1.08, "shake": 3.0})
	var spray := on_guard({"Rig": Vector3(-22, 0, 0), "Neck": Vector3(-30, 0, 0),
		"TentacleFL": Vector3(85, 0, 35), "TentacleFR": Vector3(85, 0, -35), "tentacle_reach": 0.3})
	var move := _move("Ink Spray", 1.3, 0.04, 0.25, [
		StandKeyframeAnimation.key(0.0, GUARD),
		StandKeyframeAnimation.key(0.35, rear),
		StandKeyframeAnimation.key(0.45, spray),
		StandKeyframeAnimation.key(0.85, StandAnimation.over(spray, {"shake": 1.0})),
		StandKeyframeAnimation.key(1.3, GUARD),
	])
	move.animation.events = [
		StandAnimation.event(0.45, "ink_spray", "head", Vector3(0, 0, -1.6)),
		StandAnimation.event(0.7, "ink_cloud", "out"),
	]
	move.hits = []
	for i in 3: # Along the jet: near, middle, far.
		var hit := StandMove.hit(0.48 + 0.1 * i, "both", 2.0, 2.0, 0.6 + 0.45 * i, 0.4, 0.0, 0.2)
		hit["status"] = {"slow_time": SLOW_TIME, "slow_move": SLOW_MOVE, "slow_attack": SLOW_ATTACK}
		move.hits.append(hit)
	move.input = &"stand_special"
	move.unlock = &"ink_spray"
	move.cooldown = 12.0
	move.cooldown_icon = &"ink"
	move.cancel_from = 1.0
	move.move_speed_scale = 0.3
	move.stamina_cost = 18.0
	return move
