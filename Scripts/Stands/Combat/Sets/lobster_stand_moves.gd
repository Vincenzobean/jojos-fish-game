# The Lobster Stand's moves: a slow, heavily armored crusher (stand_body_model.gd: a huge crusher claw on
# the right, a slim pincer on the left). It wins by taking hits and giving back one enormous one:
#   * Light, Pincer Snips: two quick snips of the left pincer, then a short crusher jab; the defaults'
#     uppercut finisher is kept after the second snip.
#   * Heavy, Crusher Smash: the crusher claw raised high over its head and held while heavy is held
#     (charged: at least CHARGE_MIN seconds, full at CHARGE_FULL), then brought down in an overhead slam.
#     Super armor: once it starts, hits hurt it but can't stop it.
#   * Barrage, Claw Flurry: both claws battering in turn, ending in a double clamp.
#   * Block, Shell Guard: hunched behind both claws crossed in front of its face; a hit blocked this way
#     is partly sent back at whoever threw it (stand_body.gd block_reflect, stand_health.gd).
#   * Special, Claw Grab (stand_special): it lunges, clamps the crusher round whatever's in front and
#     squeezes three times; the first clamp roots it (stand_status.gd) so it can't pull free. Wild and
#     rival Lobsters use it too.
# Its Molt (stand_health.gd, once learned) isn't a move: it happens by itself when it's badly hurt.
# Generated by Claude Code.
class_name LobsterStandMoves
extends DefaultStandMoves

const CHARGE_MIN := 0.6 ## Seconds Crusher Smash must charge to be thrown...
const CHARGE_FULL := 2.0 ## ...and to reach full power.
const GRAB_HOLD := 1.6 ## Seconds Claw Grab roots what it catches.

## Hunched forward behind its claws: the crusher low and out in front, the pincer up by its face, knees bent.
const SHELL_GUARD_POSE := {
	"Rig": Vector3(-12, 0, 0), "Neck": Vector3(-14, 0, 0),
	"ShoulderL": Vector3(60, 0, -12), "ShoulderR": Vector3(45, 0, 22),
	"ElbowL": Vector3(110, 0, 0), "ElbowR": Vector3(70, 0, 0),
	"HipL": Vector3(18, 0, -12), "HipR": Vector3(-10, 0, 12),
	"KneeL": Vector3(-40, 0, 0), "KneeR": Vector3(-24, 0, 0),
}


func _init() -> void:
	super()
	var snip_a := make_snip("Pincer Snip", 0.0)
	var snip_b := make_snip("Pincer Snip", 18.0)
	var jab := make_crusher_jab()
	snip_a.next_light = snip_b
	snip_b.next_light = jab
	snip_b.next_heavy = light.next_light.next_heavy # The default uppercut finisher, kept.
	light = snip_a
	heavy = make_crusher_smash()
	barrage = make_claw_flurry()
	block = make_shell_guard()
	specials.append(make_claw_grab())
	light_cooldown = 0.55
	heavy_cooldown = 3.0


## A quick snip of the left pincer, straight out; `turn` degrees of body twist.
static func make_snip(name: String, turn: float) -> StandMove:
	var move := _move(name, 0.34, 0.03, 0.12, [
		StandKeyframeAnimation.key(0.0, SHELL_GUARD_POSE),
		StandKeyframeAnimation.key(0.08, StandAnimation.over(SHELL_GUARD_POSE, {"Rig": Vector3(-10, -12 - turn, 0),
			"ShoulderL": Vector3(92, 0, -2), "ElbowL": Vector3(4, 0, 0)})),
		StandKeyframeAnimation.key(0.18, SHELL_GUARD_POSE),
		StandKeyframeAnimation.key(0.34, SHELL_GUARD_POSE),
	])
	move.hits = [StandMove.hit(0.08, "L", 3.5, 3.0, 0.55, 0.22)]
	move.cancel_from = 0.12
	move.move_speed_scale = 0.4
	move.stamina_cost = 6.0
	return move


## The crusher thrust straight out, heavy and short.
static func make_crusher_jab() -> StandMove:
	var out := StandAnimation.over(SHELL_GUARD_POSE, {"Rig": Vector3(-16, 26, 0), "Neck": Vector3(6, 0, 0),
		"ShoulderR": Vector3(90, 0, 0), "ElbowR": Vector3(4, 0, 0)})
	var move := _move("Crusher Jab", 0.5, 0.03, 0.15, [
		StandKeyframeAnimation.key(0.0, SHELL_GUARD_POSE),
		StandKeyframeAnimation.key(0.08, StandAnimation.over(SHELL_GUARD_POSE, {"Rig": Vector3(0, -14, 0), "ShoulderR": Vector3(20, 0, 30)})),
		StandKeyframeAnimation.key(0.16, out),
		StandKeyframeAnimation.key(0.3, out),
		StandKeyframeAnimation.key(0.5, SHELL_GUARD_POSE),
	])
	move.hits = [StandMove.hit(0.16, "R", 8.0, 10.0, 0.5, 0.3)]
	move.animation.events = [StandAnimation.event(0.16, "impact", "R")]
	move.cancel_from = 0.3
	move.move_speed_scale = 0.3
	move.lunge_speed = 6.0
	move.lunge_at = 0.1
	move.lunge_time = 0.08
	move.stamina_cost = 9.0
	return move


## The heavy: the crusher raised high behind its head and held (charging), then slammed down overhead.
static func make_crusher_smash() -> StandMove:
	var raised := StandAnimation.over(SHELL_GUARD_POSE, {"Rig": Vector3(14, -10, 0), "Neck": Vector3(8, 0, 0),
		"ShoulderR": Vector3(170, 0, 10), "ElbowR": Vector3(60, 0, 0),
		"ShoulderL": Vector3(70, 0, -30), "KneeL": Vector3(-30, 0, 0), "KneeR": Vector3(-20, 0, 0)})
	var slammed := StandAnimation.over(SHELL_GUARD_POSE, {"Rig": Vector3(-30, 8, 0), "Neck": Vector3(-10, 0, 0),
		"ShoulderR": Vector3(70, 0, 0), "ElbowR": Vector3(0, 0, 0),
		"HipL": Vector3(30, 0, -10), "HipR": Vector3(-14, 0, 10), "KneeL": Vector3(-55, 0, 0), "lift": Vector3(0, -0.1, 0)})
	var move := _move("Crusher Smash", 0.95, 0.05, 0.25, [
		StandKeyframeAnimation.key(0.0, SHELL_GUARD_POSE),
		StandKeyframeAnimation.key(0.3, raised),
		StandKeyframeAnimation.key(0.42, slammed),
		StandKeyframeAnimation.key(0.7, slammed),
		StandKeyframeAnimation.key(0.95, SHELL_GUARD_POSE),
	])
	move.hits = [StandMove.hit(0.42, "R", 18.0, 16.0, 0.6, 0.38, -2.0)]
	move.animation.events = [StandAnimation.event(0.42, "shockwave", "R"), StandAnimation.event(0.42, "burst", "R")]
	move.animation.loop_start = 0.3 # Held raised while charging.
	move.animation.loop_end = 0.3
	move.charge_min = CHARGE_MIN
	move.charge_full = CHARGE_FULL
	move.super_armor = true
	move.cancel_from = 0.7
	move.move_speed_scale = 0.15
	move.lunge_speed = 7.0
	move.lunge_at = 0.32
	move.lunge_time = 0.1
	move.stamina_cost = 20.0
	move.stamina_drain = 8.0
	return move


## Held light: claws battering in turn, then a double clamp to finish.
static func make_claw_flurry() -> StandMove:
	var left_out := StandAnimation.over(SHELL_GUARD_POSE, {"Rig": Vector3(-12, -10, 0),
		"ShoulderL": Vector3(90, 0, -2), "ElbowL": Vector3(4, 0, 0), "ShoulderR": Vector3(45, 0, 22), "ElbowR": Vector3(80, 0, 0)})
	var right_out := StandAnimation.over(SHELL_GUARD_POSE, {"Rig": Vector3(-12, 12, 0),
		"ShoulderR": Vector3(90, 0, 2), "ElbowR": Vector3(4, 0, 0), "ShoulderL": Vector3(55, 0, -14), "ElbowL": Vector3(110, 0, 0)})
	var clamp := StandAnimation.over(SHELL_GUARD_POSE, {"Rig": Vector3(-18, 0, 0), "Neck": Vector3(10, 0, 0),
		"ShoulderL": Vector3(90, 0, 12), "ShoulderR": Vector3(90, 0, -12), "ElbowL": Vector3(10, 0, 0), "ElbowR": Vector3(10, 0, 0)})
	var move := _move("Claw Flurry", 0.66, 0.03, 0.2, [
		StandKeyframeAnimation.key(0.0, SHELL_GUARD_POSE),
		StandKeyframeAnimation.key(0.09, left_out),
		StandKeyframeAnimation.key(0.18, right_out),
		StandKeyframeAnimation.key(0.27, left_out),
		StandKeyframeAnimation.key(0.38, clamp),
		StandKeyframeAnimation.key(0.5, clamp),
		StandKeyframeAnimation.key(0.66, SHELL_GUARD_POSE),
	])
	move.animation.loop_start = 0.09
	move.animation.loop_end = 0.27
	move.hits = [StandMove.hit(0.09, "L", 2.0, 2.5), StandMove.hit(0.18, "R", 2.6, 3.0),
		StandMove.hit(0.38, "both", 8.0, 12.0, 0.5, 0.34)]
	move.animation.events = [StandAnimation.event(0.38, "impact", "out")]
	move.cancel_from = 0.5
	move.move_speed_scale = 0.3
	move.stamina_cost = 8.0
	move.stamina_drain = 22.0
	return move


## Held block: hunched right down, both claws crossed in front of its face, shell turned out.
static func make_shell_guard() -> StandMove:
	var shut := StandAnimation.over(SHELL_GUARD_POSE, {"Rig": Vector3(-18, 0, 0), "Neck": Vector3(-22, 0, 0),
		"ShoulderL": Vector3(100, 0, 25), "ShoulderR": Vector3(100, 0, -25),
		"ElbowL": Vector3(105, 0, 0), "ElbowR": Vector3(100, 0, 0),
		"KneeL": Vector3(-50, 0, 0), "KneeR": Vector3(-40, 0, 0), "lift": Vector3(0, -0.08, 0)})
	var move := _move("Shell Guard", 0.45, 0.04, 0.2, [
		StandKeyframeAnimation.key(0.0, SHELL_GUARD_POSE),
		StandKeyframeAnimation.key(0.08, shut),
		StandKeyframeAnimation.key(0.25, SHELL_GUARD_POSE),
		StandKeyframeAnimation.key(0.45, SHELL_GUARD_POSE),
	])
	move.animation.loop_start = 0.08
	move.animation.loop_end = 0.08
	move.move_speed_scale = 0.3
	return move


## The special: it lunges, the crusher clamps round whatever's in front (rooting it), and squeezes three
## times, shaking with the effort, before it lets go.
static func make_claw_grab() -> StandMove:
	var reach := StandAnimation.over(SHELL_GUARD_POSE, {"Rig": Vector3(-20, 20, 0), "Neck": Vector3(4, 0, 0),
		"ShoulderR": Vector3(95, 0, -4), "ElbowR": Vector3(0, 0, 0)})
	var squeeze := StandAnimation.over(reach, {"Rig": Vector3(-14, 16, 0), "ElbowR": Vector3(25, 0, 0), "shake": 2.5})
	var move := _move("Claw Grab", 1.6, 0.04, 0.25, [
		StandKeyframeAnimation.key(0.0, SHELL_GUARD_POSE),
		StandKeyframeAnimation.key(0.18, StandAnimation.over(SHELL_GUARD_POSE, {"Rig": Vector3(6, -16, 0), "ShoulderR": Vector3(30, 0, 40)})),
		StandKeyframeAnimation.key(0.3, reach),
		StandKeyframeAnimation.key(0.5, squeeze),
		StandKeyframeAnimation.key(1.3, squeeze),
		StandKeyframeAnimation.key(1.6, SHELL_GUARD_POSE),
	])
	var clamp := StandMove.hit(0.3, "R", 4.0, -2.0, 0.85, 0.4) # Pulled in, not knocked away.
	clamp["status"] = {"root_time": GRAB_HOLD}
	move.hits = [clamp]
	for i in 3:
		move.hits.append(StandMove.hit(0.6 + 0.25 * i, "R", 4.0, 0.0, 0.9, 0.45))
	move.animation.events = [StandAnimation.event(0.3, "impact", "R")]
	for i in 3:
		move.animation.events.append(StandAnimation.event(0.6 + 0.25 * i, "impact", "R"))
	move.input = &"stand_special"
	move.cooldown = 10.0
	move.cooldown_icon = &"fist"
	move.cancel_from = 1.3
	move.move_speed_scale = 0.1
	move.lunge_speed = 9.0
	move.lunge_at = 0.18
	move.lunge_time = 0.12
	move.stamina_cost = 16.0
	return move
