# The Dolphin Stand's moves: the defaults (default_stand_moves.gd), except it fights with its
# pufferfish (floating_companion.gd).
#
# Its light chain is a rally (stand_move.gd's "Rally" group, timed by stand_combat.gd): it grabs the
# pufferfish and throws it with its right hand, and the pufferfish flies out a body length and
# boomerangs back. Pressing light just as it comes back into reach left hooks it straight back out the
# same way, and again as it comes back, a side kick it sticks to for a moment before shooting off.
#   * Perfect timing plays the perfect version (the hook harder; the kick holding the pufferfish on
#     the foot, puffing and straining, then blasting it far off), with a flash.
#   * Good timing still hits it back out, at normal damage (the kick just knocks it away).
#   * A bad press, or none, snaps the pufferfish home and ends the chain.
# Each link has its punch sound, smacking as it lands: the throw the single punch, the hook just the
# second punch of the double, the kick just the third of the triple (each clip has the ones before it).
# Whenever the pufferfish is sent flying (stand_move.gd's "Companion flight" group) it only does damage
# by running into something, and then it stops there and comes straight back: fighting from the right
# distance brings it back sooner, so the next hit of the rally comes sooner too.
# Heavy right after the hook is still the uppercut finisher. The heavy on its own is a haymaker the
# pufferfish hops in front of while it charges, and gets punched out by.
# Its special, Blowhole Blast (stand_special, once learned from DolphinStandSkillTree's Blowhole
# branch), sits the pufferfish on its blowhole to puff up huge and blasts it out, the blast knocking anything
# close in front far further than anything else (on a cooldown); it has super armor, so hits can't stop
# it (or stop it starting).
#
# The pufferfish is moved by the animations' companion channels (see stand_animation.gd):
# companion_weight 1 holds it, companion_anchor says which limb (0 left fist, 1 right fist, 2 right
# foot), companion_head moves it onto the blowhole, companion_out sends it from there toward a body length out in front (switching the anchor
# while it's out brings it back to another limb), companion_lift arcs it and companion_scale puffs it.
# Generated by Claude Code.
class_name DolphinStandMoves
extends DefaultStandMoves

const RALLY_AT := 0.72 ## When a thrown (after its grab) or hooked pufferfish is back in reach.
const GRAB_TIME := 0.24 ## How long the throw spends grabbing the pufferfish before winding back.

const PUNCH_DIR := "res://assets/audio/sound effects/stands/dolphin/"
const SINGLE_PUNCH := preload(PUNCH_DIR + "single basic punch.wav")
const DOUBLE_PUNCH := preload(PUNCH_DIR + "double basic punch.wav")
const TRIPLE_PUNCH := preload(PUNCH_DIR + "triple basic punch.wav")
const PUNCH_LEAD := 0.17 ## Seconds from where each punch starts in its clip to its smack.
const SECOND_PUNCH_AT := 0.64 ## Where the double's second punch starts (its first is the single).
const THIRD_PUNCH_AT := 1.31 ## Where the triple's third punch starts.


func _init() -> void:
	super()
	var uppercut := light.next_light.next_heavy # The default finisher, kept.
	var throw := make_puffer_throw()
	var hook := make_puffer_hook()
	var kick := make_puffer_kick()
	hook.perfect = _perfect_of(hook, 1.6)
	kick.perfect = make_perfect_puffer_kick()
	_add_punch(throw, 0.26 + GRAB_TIME, SINGLE_PUNCH, 0.0) # As the pufferfish leaves the hand.
	_add_punch(hook, 0.1, DOUBLE_PUNCH, SECOND_PUNCH_AT) # Its perfect shares the animation.
	_add_punch(kick, 0.22, TRIPLE_PUNCH, THIRD_PUNCH_AT)
	_add_punch(kick.perfect, 0.22, TRIPLE_PUNCH, THIRD_PUNCH_AT)
	throw.next_light = hook
	hook.next_light = kick
	hook.next_heavy = uppercut # Only after two light hits.
	hook.perfect.next_light = kick
	hook.perfect.next_heavy = uppercut
	light = throw
	heavy = make_puffer_haymaker()
	specials.append(make_blowhole_blast())


## Grabs the pufferfish: looks round at it and reaches out to where it floats by the right shoulder,
## closes its hand round it (squeezing it a little) and pulls it in to the chest. Then it winds back and
## throws it out a body length; it hangs there a moment and boomerangs back toward the left fist, in
## reach at RALLY_AT after the grab.
static func make_puffer_throw() -> StandMove:
	var held := {"companion_weight": 1.0, "companion_anchor": 1.0}
	var returning := {"companion_weight": 1.0, "companion_anchor": 0.0}
	var g := GRAB_TIME # Everything after the grab is that much later.
	var reach := StandAnimation.over(GUARD, {"Rig": Vector3(0, -15, 0), "Neck": Vector3(0, -35, 0),
		"ShoulderR": Vector3(15, 0, 80), "ElbowR": Vector3(15, 0, 0)})
	var move := _move("Puffer Throw", 1.0 + g, 0.03, 0.12, [
		StandKeyframeAnimation.key(0.0, GUARD),
		# Looking round and reaching out to it, still floating...
		StandKeyframeAnimation.key(0.1, reach),
		# ...the hand closing on it, squeezing it...
		StandKeyframeAnimation.key(0.15, StandAnimation.over(reach, StandAnimation.over(held, {"ElbowR": Vector3(25, 0, 0), "companion_scale": 0.75}))),
		# ...and pulling it in to the chest, the head turning back.
		StandKeyframeAnimation.key(g, StandAnimation.over(GUARD, StandAnimation.over(held, {"Rig": Vector3(0, -12, 0), "Neck": Vector3(0, -10, 0),
			"ShoulderR": Vector3(30, 0, 30), "ElbowR": Vector3(125, 0, 0), "companion_scale": 1.1}))),
		# Winding back...
		StandKeyframeAnimation.key(0.18 + g, StandAnimation.over(GUARD, StandAnimation.over(held, {"Rig": Vector3(5, -30, 0),
			"ShoulderR": Vector3(-30, 0, 40), "ElbowR": Vector3(100, 0, 0), "KneeL": Vector3(-35, 0, 0)}))),
		# ...and throwing it, the arm whipping through.
		StandKeyframeAnimation.key(0.26 + g, StandAnimation.over(GUARD, StandAnimation.over(held, {"Rig": Vector3(-12, 25, 0),
			"ShoulderR": Vector3(95, 0, 0), "ElbowR": Vector3(5, 0, 0), "companion_out": 0.15}))),
		# It flies out a body length...
		StandKeyframeAnimation.key(0.42 + g, StandAnimation.over(GUARD, StandAnimation.over(held, {"Rig": Vector3(-8, 15, 0),
			"ShoulderR": Vector3(70, 0, 5), "ElbowR": Vector3(30, 0, 0),
			"companion_out": 1.0, "companion_lift": 0.35}))),
		StandKeyframeAnimation.key(0.5 + g, StandAnimation.over(GUARD, StandAnimation.over(returning, {"companion_out": 1.0, "companion_lift": 0.25}))),
		# ...and comes back round toward the left fist, which cocks for the hook.
		StandKeyframeAnimation.key(0.62 + g, StandAnimation.over(GUARD, StandAnimation.over(returning, {"companion_out": 0.6, "companion_lift": 0.12}))),
		StandKeyframeAnimation.key(RALLY_AT + g, StandAnimation.over(GUARD, StandAnimation.over(returning, {"Rig": Vector3(-4, 10, 0),
			"ShoulderL": Vector3(25, 0, -50), "ElbowL": Vector3(100, 0, 0),
			"companion_out": 0.25, "companion_lift": 0.04}))),
		StandKeyframeAnimation.key(0.88 + g, StandAnimation.over(GUARD, StandAnimation.over(returning, {"companion_out": 0.12}))),
		StandKeyframeAnimation.key(1.0 + g, GUARD),
	])
	move.fly_companion(0.26 + g, 0.5 + g, 5.0, 6.0) # The pufferfish, from when it leaves the hand.
	move.cancel_from = 0.9 + g
	move.move_speed_scale = 0.5
	move.rally_from = 0.26 + g
	move.rally_at = RALLY_AT + g
	move.stamina_cost = 7.0
	return move


## A left hook into the pufferfish as it comes back, sending it out a body length again; it hangs and
## boomerangs back toward the right foot, in reach at RALLY_AT, for the kick.
static func make_puffer_hook() -> StandMove:
	var to_fist := {"companion_weight": 1.0, "companion_anchor": 0.0}
	var to_foot := {"companion_weight": 1.0, "companion_anchor": 2.0}
	var move := _move("Puffer Hook", 1.0, 0.03, 0.12, [
		# The fist cocked out to the side as the pufferfish arrives...
		StandKeyframeAnimation.key(0.0, StandAnimation.over(GUARD, StandAnimation.over(to_fist, {"Rig": Vector3(-4, 15, 0),
			"ShoulderL": Vector3(20, 0, -80), "ElbowL": Vector3(95, 0, 0),
			"companion_out": 0.25, "companion_lift": 0.04}))),
		# ...whips round into it...
		StandKeyframeAnimation.key(0.1, StandAnimation.over(GUARD, StandAnimation.over(to_fist, {"Rig": Vector3(-10, -35, 0),
			"ShoulderL": Vector3(15, 0, -75), "ElbowL": Vector3(95, 0, 0), "companion_scale": 1.3}))),
		# ...and sends it flying out again...
		StandKeyframeAnimation.key(0.28, StandAnimation.over(GUARD, StandAnimation.over(to_fist, {"Rig": Vector3(-8, -40, 0),
			"ShoulderL": Vector3(20, 0, -60), "ElbowL": Vector3(80, 0, 0),
			"companion_out": 1.0, "companion_lift": 0.3, "companion_scale": 1.1}))),
		StandKeyframeAnimation.key(0.38, StandAnimation.over(GUARD, StandAnimation.over(to_foot, {"companion_out": 1.0, "companion_lift": 0.25}))),
		# ...to come back toward the right foot, the knee lifting for the kick.
		StandKeyframeAnimation.key(0.55, StandAnimation.over(GUARD, StandAnimation.over(to_foot, {"companion_out": 0.65, "companion_lift": 0.1}))),
		StandKeyframeAnimation.key(RALLY_AT, StandAnimation.over(GUARD, StandAnimation.over(to_foot, {"Rig": Vector3(0, 20, 4),
			"HipR": Vector3(20, 0, 20), "KneeR": Vector3(-50, 0, 0), "companion_out": 0.3}))),
		StandKeyframeAnimation.key(0.88, StandAnimation.over(GUARD, StandAnimation.over(to_foot, {"companion_out": 0.18}))),
		StandKeyframeAnimation.key(1.0, GUARD),
	])
	move.hits = [StandMove.hit(0.1, "L", 6.0, 6.0, 0.4)]
	move.fly_companion(0.14, 0.38, 5.0, 7.0) # The pufferfish, hooked away.
	move.cancel_from = 0.2 # Heavy from here is the finisher.
	move.move_speed_scale = 0.4
	move.lunge_speed = 5.0
	move.lunge_at = 0.02
	move.lunge_time = 0.08
	move.rally_from = 0.12
	move.rally_at = RALLY_AT
	move.stamina_cost = 7.0
	return move


## The side kick, timed well: the knee chambers as the pufferfish comes back, and the kick meets it and
## knocks it out a body length, tumbling, before it flies home to the shoulder.
static func make_puffer_kick() -> StandMove:
	var on_foot := {"companion_weight": 1.0, "companion_anchor": 2.0}
	var move := _move("Puffer Kick", 0.75, 0.04, 0.2, _kick_wind_up() + [
		StandKeyframeAnimation.key(0.22, StandAnimation.over(_side_kick(), StandAnimation.over(on_foot, {"companion_scale": 1.5}))),
		# Knocked away...
		StandKeyframeAnimation.key(0.36, StandAnimation.over(_side_kick(), StandAnimation.over(on_foot, {"companion_out": 1.0,
			"companion_lift": 0.3, "companion_scale": 1.4}))),
		StandKeyframeAnimation.key(0.46, StandAnimation.over(_kick_chamber(), StandAnimation.over(on_foot, {"Rig": Vector3(0, 60, 14),
			"companion_out": 1.0, "companion_lift": 0.25, "companion_scale": 1.2}))),
		# ...and home it flies.
		StandKeyframeAnimation.key(0.56, StandAnimation.over(GUARD, {"Rig": Vector3(0, 20, 4)})),
		StandKeyframeAnimation.key(0.75, GUARD),
	])
	move.hits = [StandMove.hit(0.22, "both", 9.0, 11.0, 0.5, 0.25, 0.0, -0.12)]
	move.fly_companion(0.26, 0.46, 6.0, 8.0) # The pufferfish, knocked away.
	_kick_settings(move)
	move.stamina_cost = 10.0
	return move


## The side kick, timed perfectly: the pufferfish sticks to the foot as it lands, squashing and puffing
## up while the leg strains into it, then shoots off far out in front with a blast, before flying home.
static func make_perfect_puffer_kick() -> StandMove:
	var on_foot := {"companion_weight": 1.0, "companion_anchor": 2.0}
	var straining := StandAnimation.over(_side_kick(), {"Rig": Vector3(0, 88, 28), "HipR": Vector3(8, 0, 92), "KneeR": Vector3(-8, 0, 0)})
	var move := _move("Perfect Puffer Kick", 1.15, 0.04, 0.22, _kick_wind_up() + [
		StandKeyframeAnimation.key(0.22, StandAnimation.over(_side_kick(), StandAnimation.over(on_foot, {"companion_scale": 1.5}))),
		# Stuck on the foot, the leg straining into it...
		StandKeyframeAnimation.key(0.32, StandAnimation.over(straining, StandAnimation.over(on_foot, {"companion_out": -0.03,
			"companion_scale": 1.75, "shake": 3.0}))),
		StandKeyframeAnimation.key(0.46, StandAnimation.over(straining, StandAnimation.over(on_foot, {"companion_out": -0.05,
			"companion_scale": 1.9, "shake": 4.0}))),
		# ...until it shoots off...
		StandKeyframeAnimation.key(0.52, StandAnimation.over(_side_kick(), StandAnimation.over(on_foot, {"Rig": Vector3(0, 82, 20),
			"companion_out": 0.35, "companion_scale": 1.6}))),
		StandKeyframeAnimation.key(0.64, StandAnimation.over(_side_kick(), StandAnimation.over(on_foot, {"companion_out": 1.6,
			"companion_lift": 0.2, "companion_scale": 1.5}))),
		# ...hangs far out there...
		StandKeyframeAnimation.key(0.8, StandAnimation.over(_kick_chamber(), StandAnimation.over(on_foot, {"Rig": Vector3(0, 55, 12),
			"companion_out": 1.6, "companion_lift": 0.15, "companion_scale": 1.3}))),
		# ...and flies home.
		StandKeyframeAnimation.key(0.92, StandAnimation.over(GUARD, {"Rig": Vector3(0, 20, 4)})),
		StandKeyframeAnimation.key(1.15, GUARD),
	])
	move.animation.events = [
		StandAnimation.event(0.22, "impact", "companion"),
		StandAnimation.event(0.5, "burst", "companion"),
	]
	move.hits = [
		StandMove.hit(0.22, "both", 6.0, 2.0, 0.5, 0.25, 0.0, -0.12), # Catching it.
	]
	move.fly_companion(0.52, 0.8, 22.0, 20.0) # The pufferfish shooting off.
	_kick_settings(move)
	move.cancel_from = 0.75
	move.stamina_cost = 10.0
	return move


## The heavy: the pufferfish hops off the shoulder to float in front of the cocked fist while it
## charges (see the default haymaker), and the haymaker punches it out far in front before it flies home.
static func make_puffer_haymaker() -> StandMove:
	var in_front := {"companion_weight": 1.0, "companion_anchor": 1.0}
	var move := make_haymaker()
	move.display_name = "Puffer Haymaker"
	var anim := move.animation as StandKeyframeAnimation
	anim.keys.assign([
		StandKeyframeAnimation.key(0.0, GUARD),
		# Hopping off the shoulder in an arc...
		StandKeyframeAnimation.key(0.11, StandAnimation.over(GUARD, StandAnimation.over(in_front, {"Rig": Vector3(2, -18, 0),
			"companion_out": 0.2, "companion_lift": 0.45}))),
		# ...to wait in front of the cocked fist, puffing.
		StandKeyframeAnimation.key(0.22, StandAnimation.over(haymaker_wind_up(), StandAnimation.over(in_front, {"companion_out": 0.32,
			"companion_lift": 0.05, "companion_scale": 1.2}))),
		# The fist meets it...
		StandKeyframeAnimation.key(0.32, StandAnimation.over(haymaker_strike(), StandAnimation.over(in_front, {"companion_out": 0.04, "companion_scale": 1.5}))),
		# ...and punches it out.
		StandKeyframeAnimation.key(0.42, StandAnimation.over(haymaker_strike(), StandAnimation.over(in_front, {"companion_out": 1.4,
			"companion_lift": 0.2, "companion_scale": 1.4}))),
		StandKeyframeAnimation.key(0.5, StandAnimation.over(haymaker_strike(), StandAnimation.over(in_front, {"companion_out": 1.4,
			"companion_lift": 0.15, "companion_scale": 1.2}))),
		StandKeyframeAnimation.key(0.6, GUARD),
		StandKeyframeAnimation.key(0.75, GUARD),
	])
	anim.events = [StandAnimation.event(0.32, "impact", "companion")]
	move.fly_companion(0.34, 0.5, 10.0, 14.0) # The pufferfish, punched away.
	return move


## The special (super armor): the right hand lifts the pufferfish up onto the blowhole, where it puffs
## up huge, shaking, while the stand braces and ducks its head; then the blowhole blasts it out far in
## front, the stand rocking back, the blast knocking anything close in front away with a huge, lifting
## knockback. Once every `cooldown` seconds.
static func make_blowhole_blast() -> StandMove:
	var on_head := {"companion_weight": 1.0, "companion_anchor": 1.0}
	var lifting := StandAnimation.over(GUARD, {"Rig": Vector3(0, -10, 0), "ShoulderR": Vector3(150, 0, 10), "ElbowR": Vector3(60, 0, 0)})
	var bracing := StandAnimation.over(GUARD, {"Rig": Vector3(-22, 0, 0), "Neck": Vector3(-30, 0, 0),
		"ShoulderL": Vector3(10, 0, -45), "ElbowL": Vector3(70, 0, 0),
		"ShoulderR": Vector3(10, 0, 45), "ElbowR": Vector3(70, 0, 0),
		"KneeL": Vector3(-45, 0, 0), "KneeR": Vector3(-35, 0, 0)})
	var recoil := StandAnimation.over(GUARD, {"Rig": Vector3(18, 0, 0), "Neck": Vector3(20, 0, 0),
		"ShoulderL": Vector3(-10, 0, -60), "ShoulderR": Vector3(-10, 0, 60),
		"ElbowL": Vector3(30, 0, 0), "ElbowR": Vector3(30, 0, 0)})
	# companion_lift keeps it resting on the head as it puffs (it's about 0.55 m across, puffed by its scale).
	var move := _move("Blowhole Blast", 1.25, 0.03, 0.2, [
		StandKeyframeAnimation.key(0.0, GUARD),
		# Lifting it up over the head in the right hand...
		StandKeyframeAnimation.key(0.12, StandAnimation.over(lifting, StandAnimation.over(on_head, {"companion_head": 0.4, "companion_lift": 0.35}))),
		# ...setting it on the blowhole as the head ducks, bracing...
		StandKeyframeAnimation.key(0.22, StandAnimation.over(bracing, StandAnimation.over(on_head, {"companion_head": 1.0,
			"companion_lift": 0.3, "companion_scale": 1.2}))),
		# ...while it puffs up huge there, shaking...
		StandKeyframeAnimation.key(0.36, StandAnimation.over(bracing, StandAnimation.over(on_head, {"companion_head": 1.0,
			"companion_lift": 0.45, "companion_scale": 1.7, "shake": 3.0}))),
		StandKeyframeAnimation.key(0.48, StandAnimation.over(bracing, StandAnimation.over(on_head, {"companion_head": 1.0,
			"companion_lift": 0.55, "companion_scale": 2.1, "shake": 5.0}))),
		# ...until the blowhole blasts it out, rocking the stand back...
		StandKeyframeAnimation.key(0.54, StandAnimation.over(recoil, StandAnimation.over(on_head, {"companion_head": 1.0, "companion_out": 0.4,
			"companion_lift": 0.4, "companion_scale": 1.7}))),
		StandKeyframeAnimation.key(0.66, StandAnimation.over(recoil, StandAnimation.over(on_head, {"companion_head": 1.0, "companion_out": 1.8,
			"companion_lift": 0.15, "companion_scale": 1.5}))),
		# ...and it hangs far out there...
		StandKeyframeAnimation.key(0.86, StandAnimation.over(GUARD, StandAnimation.over(on_head, {"companion_head": 1.0, "companion_out": 1.8,
			"companion_lift": 0.1, "companion_scale": 1.25}))),
		# ...before flying home.
		StandKeyframeAnimation.key(1.0, StandAnimation.over(GUARD, {"Rig": Vector3(-8, 0, 0)})),
		StandKeyframeAnimation.key(1.25, GUARD),
	])
	move.animation.events = [StandAnimation.event(0.52, "burst", "companion")]
	# The blast itself, not the pufferfish, does the hitting: one big burst around the head and out in
	# front, low enough to catch a foe below it and wide enough to catch one right up against it, so it
	# lands however close the foe is. (The pufferfish only flies out for show.) Hits harder with Puffer Power.
	var blast := StandMove.hit(0.52, "both", 14.0, 40.0, 0.35, 0.6, 4.0, 0.0)
	blast["puffer"] = true
	move.hits = [blast]
	move.input = &"stand_special"
	move.unlock = &"blowhole_blast"
	move.super_armor = true
	move.cooldown = 10.0 # It can't be spammed.
	move.cooldown_icon = &"blowhole"
	move.cancel_from = 1.0
	move.move_speed_scale = 0.15
	move.stamina_cost = 20.0
	return move


# The knee coming up as the pufferfish comes in, the start of both kicks.
static func _kick_wind_up() -> Array:
	var on_foot := {"companion_weight": 1.0, "companion_anchor": 2.0}
	return [
		StandKeyframeAnimation.key(0.0, StandAnimation.over(GUARD, StandAnimation.over(on_foot, {"Rig": Vector3(0, 30, 6),
			"HipR": Vector3(30, 0, 30), "KneeR": Vector3(-70, 0, 0), "companion_out": 0.3, "companion_lift": 0.08}))),
		StandKeyframeAnimation.key(0.12, StandAnimation.over(_kick_chamber(), StandAnimation.over(on_foot, {"companion_out": 0.12}))),
	]


# The kick chambered: turned side-on, the right knee drawn up high.
static func _kick_chamber() -> Dictionary:
	return StandAnimation.over(GUARD, {"Rig": Vector3(0, 70, 18),
		"HipR": Vector3(50, 0, 70), "KneeR": Vector3(-115, 0, 0), "KneeL": Vector3(-20, 0, 0)})


# The side kick landing: side-on, leaning away, the right leg straight out in front.
static func _side_kick() -> Dictionary:
	return StandAnimation.over(GUARD, {"Rig": Vector3(0, 85, 25),
		"HipR": Vector3(5, 0, 88), "KneeR": Vector3(-4, 0, 0),
		"HipL": Vector3(0, 0, -8), "KneeL": Vector3(-12, 0, 0)})


static func _kick_settings(move: StandMove) -> void:
	move.cancel_from = 0.45
	move.move_speed_scale = 0.35
	move.lunge_speed = 4.0
	move.lunge_at = 0.1
	move.lunge_time = 0.08


# Plays the punch starting `from` seconds into `stream` so that it smacks at `strike` seconds into the
# move. A strike sooner than PUNCH_LEAD starts with the move and skips that much of the lead-in.
static func _add_punch(move: StandMove, strike: float, stream: AudioStream, from: float) -> void:
	var start := maxf(strike - PUNCH_LEAD, 0.0)
	move.animation.add_event(StandAnimation.sound(start, stream, from + start - (strike - PUNCH_LEAD)))


# A perfect version of `move`: the same move (sharing its animation) hitting `scale` times as hard, its
# pufferfish too.
static func _perfect_of(move: StandMove, scale: float) -> StandMove:
	var perfect := move.duplicate() as StandMove
	perfect.display_name = "Perfect " + move.display_name
	var hits: Array[Dictionary] = []
	for hit in move.hits:
		var harder := hit.duplicate()
		harder["damage"] = float(hit["damage"]) * scale
		harder["knockback"] = float(hit["knockback"]) * scale
		hits.append(harder)
	perfect.hits = hits
	perfect.companion_hit = {"damage": float(move.companion_hit["damage"]) * scale, "knockback": float(move.companion_hit["knockback"]) * scale}
	return perfect
