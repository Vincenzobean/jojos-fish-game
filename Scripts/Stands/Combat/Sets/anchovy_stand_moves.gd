# The Anchovy Stand's moves: a small, quick fighter. The defaults (default_stand_moves.gd) played at
# QUICK of their length (the jab, cross and hook chain, its uppercut finisher, the barrage and its finale,
# the counter and the rush punch), hitting for little (the stand's own damage_scale, anchovy_stand.tscn),
# and for its heavy a darting stab that lunges a long way in rather than a slow haymaker.
#
# Its special, School Formation (stand_special, once learned from AnchovyStandSkillTree's School branch),
# calls a school of anchovies together into it (school_formation_move.gd; its cutscene is
# formation_director.gd): bigger, harder-hitting, slower-punching and taking a little less damage until
# it's down to a quarter of its health. Once per summon; wild Anchovies never use it (stand_combat.gd).
# Generated by Claude Code.
class_name AnchovyStandMoves
extends DefaultStandMoves

const QUICK := 0.7 ## Share of the default moves' length the Anchovy's take.


func _init() -> void:
	super()
	var quickened: Array[StandMove] = []
	for move: StandMove in _chain(light) + [barrage, barrage_finisher, counter, dash_strike]:
		if move not in quickened:
			_quicken(move, QUICK)
			quickened.append(move)
	heavy = make_dart_stab()
	specials.append(make_school_formation())


## The heavy: crouching low for a beat, then darting a long way in with the right hand thrust out
## straight like a spear.
static func make_dart_stab() -> StandMove:
	var coiled := on_guard({"Rig": Vector3(-25, 0, 0), "Neck": Vector3(-10, 0, 0),
		"ShoulderR": Vector3(10, 0, 15), "ElbowR": Vector3(120, 0, 0),
		"KneeL": Vector3(-55, 0, 0), "KneeR": Vector3(-45, 0, 0)})
	var thrust := on_guard({"Rig": Vector3(-40, -15, 0), "Neck": Vector3(-20, 10, 0),
		"ShoulderR": Vector3(95, 0, 2), "ElbowR": Vector3(0, 0, 0),
		"ShoulderL": Vector3(-30, 0, -20), "ElbowL": Vector3(20, 0, 0),
		"HipL": Vector3(30, 0, -5), "HipR": Vector3(-40, 0, 5), "KneeL": Vector3(-20, 0, 0), "KneeR": Vector3(-10, 0, 0)})
	var move := _move("Dart Stab", 0.5, 0.03, 0.15, [
		StandKeyframeAnimation.key(0.0, GUARD),
		StandKeyframeAnimation.key(0.1, coiled),
		StandKeyframeAnimation.key(0.17, thrust),
		StandKeyframeAnimation.key(0.3, thrust),
		StandKeyframeAnimation.key(0.5, GUARD),
	])
	move.animation.afterimages = true
	move.hits = [StandMove.hit(0.18, "R", 9.0, 8.0, 0.6, 0.25)]
	move.cancel_from = 0.32
	move.move_speed_scale = 0.6
	move.lunge_speed = 14.0
	move.lunge_at = 0.1
	move.lunge_time = 0.12
	move.stamina_cost = 10.0
	return move


## The special: arms flung wide as the school swirls in (formation_director.gd plays the rest), then
## pulled in tight as they merge into it, and a burst as it squares up, bigger.
static func make_school_formation() -> SchoolFormationMove:
	var wide := on_guard({"Rig": Vector3(10, 0, 0), "Neck": Vector3(20, 0, 0),
		"ShoulderL": Vector3(10, 0, -95), "ShoulderR": Vector3(10, 0, 95),
		"ElbowL": Vector3(10, 0, 0), "ElbowR": Vector3(10, 0, 0), "KneeL": Vector3(-10, 0, 0), "KneeR": Vector3(-10, 0, 0)})
	var tight := on_guard({"Rig": Vector3(-20, 0, 0), "Neck": Vector3(-15, 0, 0),
		"ShoulderL": Vector3(60, 0, 30), "ShoulderR": Vector3(60, 0, -30),
		"ElbowL": Vector3(130, 0, 0), "ElbowR": Vector3(130, 0, 0),
		"KneeL": Vector3(-50, 0, 0), "KneeR": Vector3(-50, 0, 0), "shake": 3.0})
	var template := _move("School Formation", 2.2, 0.1, 0.25, [
		StandKeyframeAnimation.key(0.0, GUARD),
		StandKeyframeAnimation.key(0.3, wide),
		StandKeyframeAnimation.key(1.2, StandAnimation.over(wide, {"shake": 1.5})),
		StandKeyframeAnimation.key(1.6, tight),
		StandKeyframeAnimation.key(1.75, on_guard({"Rig": Vector3(8, 0, 0), "ShoulderL": Vector3(20, 0, -50), "ShoulderR": Vector3(20, 0, 50)})),
		StandKeyframeAnimation.key(2.2, GUARD),
	])
	template.animation.events = [StandAnimation.event(1.7, "burst")]
	var move := SchoolFormationMove.new()
	move.size = 2.0 # Small as it is, formed it stands as tall as the Dolphin.
	move.display_name = template.display_name
	move.animation = template.animation
	move.input = &"stand_special"
	move.unlock = &"school_formation"
	move.super_armor = true
	move.cooldown = 1.0
	move.cooldown_icon = &"school"
	move.cancel_from = 2.0
	move.move_speed_scale = 0.0
	return move


# Plays `move` at `share` of its length: every key, event and hit sooner, its lunge and loop too.
static func _quicken(move: StandMove, share: float) -> void:
	if move == null or move.animation == null:
		return
	var anim := move.animation
	anim.duration *= share
	anim.blend_in *= share
	anim.blend_out *= share
	if anim.loop_start >= 0.0:
		anim.loop_start *= share
		anim.loop_end *= share
	if anim is StandKeyframeAnimation:
		for key: Dictionary in (anim as StandKeyframeAnimation).keys:
			key["time"] = float(key["time"]) * share
	for event: Dictionary in anim.events:
		event["time"] = float(event["time"]) * share
	var hits: Array[Dictionary] = []
	for hit: Dictionary in move.hits:
		var sooner := hit.duplicate()
		sooner["time"] = float(hit["time"]) * share
		hits.append(sooner)
	move.hits = hits
	move.cancel_from *= share
	move.lunge_at *= share
	move.lunge_time *= share
