# Which moves one stand fights with: a slot per thing the attack buttons do. A stand body
# (stand_body.gd) has one as its `moves`; the combat node (stand_combat.gd) reads it. Most stands start
# from DefaultStandMoves (default_stand_moves.gd) and replace or add what makes them different,
# like an animation set (stand_animation_set.gd).
# Generated by Claude Code.
class_name StandMoveSet
extends Resource

@export var light: StandMove ## The first punch of the light chain (each links on through next_light).
@export var heavy: StandMove ## The heavy on its own (during a light chain, the light's next_heavy instead).
@export var barrage: StandMove ## Held light: its animation loops (loop_start..loop_end) while held.
@export var block: StandMove ## Held block: its animation holds its guard pose while held.
@export var barrage_hold_time := 0.3 ## Seconds light must be held to break into the barrage...
@export var barrage_max_time := 2.5 ## ...and the longest it can then be held before it ends by itself.
@export var specials: Array[StandMove] = [] ## Special moves, each started by its own `input` action.
@export_group("Learned")
## Moves a stand learns from its skill tree (the Skills autoload); each only plays once learned.
@export var dash_strike: StandMove ## Light during a dash: a flying punch carried by the dash ("dash_strike").
@export var barrage_finisher: StandMove ## Letting go of a long barrage ends it with one big blow ("barrage_finisher")...
@export var barrage_finisher_after := 0.8 ## ...if it was held at least this many seconds.
@export var counter: StandMove ## Light just after blocking a hit: a counterattack ("counter")...
@export var counter_window := 0.45 ## ...within this many seconds of the block.

@export_group("Cooldowns")
## Every attack has a cooldown, set on its moves by apply_cooldowns(), counting down once the move has
## stopped (finished or cut short). The light chain (every link, its perfect variants and its heavy
## finisher) counts as one attack, cooling down once the chain ends...
@export var light_cooldown := 0.5
@export var heavy_cooldown := 2.5 ## ...the heavy...
@export var barrage_cooldown := 6.0 ## ...the barrage (and its finale)...
@export var counter_cooldown := 3.0
@export var dash_strike_cooldown := 3.0 ## Specials keep their own (stand_move.gd cooldown).


## Gives every attack its cooldown (see the Cooldowns group); blocking has none. Safe to call again.
func apply_cooldowns() -> void:
	for move in _chain(light):
		_cool(move, &"light", light_cooldown, &"fist")
	_cool(heavy, &"heavy", heavy_cooldown, &"bolt")
	_cool(barrage, &"barrage", barrage_cooldown, &"burst")
	_cool(barrage_finisher, &"barrage", barrage_cooldown, &"burst")
	_cool(counter, &"counter", counter_cooldown, &"counter")
	_cool(dash_strike, &"dash_strike", dash_strike_cooldown, &"rush")


# Every move of the chain starting at `first`: its links, their perfect variants and heavy finishers.
static func _chain(first: StandMove) -> Array[StandMove]:
	var found: Array[StandMove] = []
	var waiting: Array[StandMove] = [first]
	while not waiting.is_empty():
		var move: StandMove = waiting.pop_back()
		if move == null or move in found:
			continue
		found.append(move)
		waiting.append_array([move.next_light, move.next_heavy, move.perfect])
	return found


static func _cool(move: StandMove, group: StringName, seconds: float, icon: StringName) -> void:
	if move == null:
		return
	move.cooldown_group = group
	move.cooldown = seconds
	move.cooldown_icon = icon
