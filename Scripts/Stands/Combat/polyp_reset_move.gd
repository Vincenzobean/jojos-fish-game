# Polyp Reset, the Jellyfish Stand's special (jellyfish_stand_moves.gd): what the immortal jellyfish does
# to cheat death, on purpose. RESET_AT seconds in (it has shrunk back into its polyp), whatever slowed or
# rooted it falls away (stand_status.gd cleanse()) and it heals HEAL of its health (stand_health.gd heal());
# then it blooms back out. Cut short before then, nothing happens.
# Generated by Claude Code.
extends StandMove

const RESET_AT := 0.45 ## Seconds in that it resets...
const HEAL := 0.15 ## ...healing this share of its health.


func on_start(combat: Node) -> void:
	await combat.get_tree().create_timer(RESET_AT, false, true).timeout
	if not is_instance_valid(combat) or combat.get_move() != self:
		return
	var stand := combat.get_parent()
	var status := stand.get_node_or_null("Status")
	if status and status.has_method("cleanse"):
		status.cleanse()
	var health := stand.get_node_or_null("Health")
	if health and health.has_method("heal"):
		health.heal(HEAL)
