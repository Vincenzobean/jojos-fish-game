# A controlled stand's fighting: added by possession (possession.gd) beside its controller
# (stand_controller.gd), playing the moves of the stand's StandMoveSet (stand_body.gd get_moves()).
# Its buttons come through `input` (stand_input.gd): the player's, or a wild stand's AI
# (enemy_stand_brain.gd, stand_encounter.gd).
#
#   * Light (light_attack) starts the light chain; pressed again during a move it's remembered, and
#     once the move reaches its cancel_from it moves on to that move's next_light (jab, cross, hook).
#   * Heavy (heavy_attack) on its own is the set's heavy; during a light chain it's the move's
#     next_heavy instead (the finisher). A heavy with a charge_min charges while held, holding its
#     wind-up: let go before charge_min and it's dropped; after, it's thrown, hitting harder the closer
#     it got to charge_full (charge_started, charge_ready, charge_full and charge_ended let the visuals
#     show it).
#   * Holding light for barrage_hold_time breaks into the barrage (a press still held waits to see, so no
#     jab is thrown first; let go sooner it's an ordinary press), which loops while light is held and
#     finishes once it's let go or after barrage_max_time. Holding block (from rest, or once a move can be cancelled) holds the
#     block until it's let go.
#   * A rallying move (stand_move.gd rally_at; the Dolphin throwing its pufferfish) times the next light
#     press against the moment its companion comes back: perfect starts next_light's perfect variant
#     straight away, good next_light, and a miss (or no press in time) ends the chain (rally_window and
#     rally_graded let the visuals cue and show it).
#   * A move that sends the stand's companion flying (stand_move.gd flight_from) has it hit whatever it
#     flies into and come straight back from there, the move skipping ahead (companion_struck,
#     move_skipped), so a rally's sweet spot comes sooner at the right distance.
#   * Each special move starts on its own input action, once its unlock is learned, and if its
#     can_start() lets it. A wild stand never uses a special its kind's skill tree locks. One with super
#     armor (the Dolphin's Blowhole Blast) takes over any move, even while staggered.
#   * A formation (the Anchovy's School Formation, school_formation_move.gd) asks for its cutscene
#     (`formation_requested`; possession.gd plays it and calls set_formed()). Formed, the stand is bigger
#     (stand_body.gd grow()), hits harder, moves slower and takes less damage, until its health drops to
#     the formation's ends_at share; once per summon.
#   * Moves play at time_scale() of their speed: slower while formed, or slowed by a hit's status
#     (stand_status.gd). Hits pass their "status" on to whatever they hit. Frozen in a time stop, nothing
#     goes on at all.
#   * Every attack has a cooldown (stand_move_set.gd apply_cooldowns(), and the specials' own), counting
#     down only once the move has stopped, finished or cut short (_finish()). The light chain counts as one
#     attack, so its links still flow; a barrage and its finale likewise. Trying one too soon does nothing
#     (`cooling_down`); cooldown_status() is for the HUD.
#   * Each choice the player makes is announced (`action_taken`) for opponents to learn from.
#
# A move's hits land at their times, in front of the stand, worked out from the stand's own body (never
# its drawn pose): a sphere there shoves every rigid body it touches along the punch, and anything with
# a take_stand_hit(hit) method (future enemies) is told about it. Held moves time their hits by their
# animation's loop, so a barrage hits on every punch it throws. A blow that hits nothing
# but reaches the water splashes it (water.gd).
#
# Moves cost stamina (stand_move.gd stamina_cost, and stamina_drain while held or charging) from the
# stand's health node (stand_health.gd): what it can't pay for doesn't start, and a held move that runs
# dry is let go. A hit that staggers the stand drops its move (interrupt()), unless the move has super
# armor (has_armor()), and it takes no input while staggered (but super-armored specials) or once beaten.
#
# Its kind's skill tree (the Skills autoload) adds learned moves on top of these: a rush punch (light
# during a dash), a finale to a long barrage (let go after barrage_finisher_after), and a counter (light
# just after blocking a hit); and its hits and rally windows grow with it.
#
# While a move plays the stand flies slower (the move's move_speed_scale, through the controller's
# speed_scale), and a move can lunge it forward. Gameplay only: the visuals (stand_body_visuals.gd) play
# the animations and impact effects from the signals below.
# Generated by Claude Code.
extends Node

## A move began (its animation should play; held for the barrage and block).
signal move_started(move: StandMove)
## A held move was let go and plays its ending.
signal move_released(move: StandMove)
## A move finished.
signal move_ended(move: StandMove)
## A hit's moment came, whether or not it touched anything, at `point` (world).
signal hit_frame(move: StandMove, hit: Dictionary, point: Vector3)
## A hit touched `target` (a rigid body, or something with take_stand_hit()).
signal hit_landed(move: StandMove, target: Node, point: Vector3)
## A move was dropped before it was thrown (a heavy let go before its charge was ready).
signal move_cancelled(move: StandMove)
## A charging move (the heavy) began charging...
signal charge_started(move: StandMove)
## ...reached its minimum charge and can be thrown...
signal charge_ready(move: StandMove)
## ...reached full charge...
signal charge_full(move: StandMove)
## ...or was thrown or dropped.
signal charge_ended(move: StandMove)
## A rallying move's perfect window opened: its companion is nearly back in reach.
signal rally_window(move: StandMove)
## The next light press of a rallying move was timed: `grade` is &"perfect", &"good" or &"miss" (also
## when nothing was pressed in time).
signal rally_graded(move: StandMove, grade: StringName)
## The companion of a move that sends it flying (stand_move.gd flight_from) ran into something at `point`...
signal companion_struck(move: StandMove, point: Vector3)
## ...and the move skipped ahead to `time`, the companion on its way back.
signal move_skipped(move: StandMove, time: float)
## A hit beat `target` (its is_defeated() turned true) and it has a stand user to finish, `user`
## (its get_stand_user()): possession.gd plays the stand's finisher (Scripts/Stands/Finisher/).
signal target_defeated(target: Node, user: Node3D)
## An attack was tried while it's still cooling down (stand_move.gd cooldown): `seconds_left`.
signal cooling_down(move: StandMove, seconds_left: float)
## A formation move started: its cutscene should play, then set_formed() (possession.gd).
signal formation_requested(move: SchoolFormationMove)
## The stand formed up (set_formed()) or broke apart.
signal formation_changed(formed: bool)
## The player chose to do something (what opponents learn from: stand_memory.gd): `open` (start a light
## chain), `chain` (carry it on), `finisher` (its heavy finisher), `heavy`, `barrage`, `block`, `counter`,
## `rush` (the punch out of a dash), `special`, or `stop` (let a chain run out).
signal action_taken(action: StringName)

const StandShape := preload("res://Scripts/Stands/stand_shape.gd")

@export var input_buffer_time := 0.45 ## Seconds a press during a move is remembered.
@export var fist_spread := 0.12 ## How far to the punching fist's side a hit lands, in lengths of the stand.
@export var hit_height := 0.12 ## How far above the stand's middle a hit lands, in lengths of the stand, unless the hit says.

var _stand: Node3D
var _controller: Node
var _user: Node3D
var _bodies: Array[RigidBody3D] = []
var _size := 1.0
var _moves: StandMoveSet

var _move: StandMove
var _time := 0.0 # Seconds since the move began.
var _shown := 0.0 # Where in its animation the move is (held moves loop or stop).
var _held := false
var _buffered := &"" # "light" or "heavy" pressed during a move, or empty.
var _buffer_age := 0.0
var _light_held := 0.0 # Seconds light has been held down.
var _light_pending := false # A light press still held: a press when let go, the barrage if held on.
var _lunged := false
var _charging := false
var _charge := 0.0 # Seconds the charging move has been held.
var _charge_power := -1.0 # How charged the thrown move is, 0 (just ready) to 1 (full); -1 if it doesn't charge.
var _rally_done := false # The rallying move's press has been timed (or given up on with heavy).
var _rally_cued := false # Its perfect window has been announced.
var _chain_broken := false # A missed rally: the move plays out but leads into nothing.
var _rally_grade := &"" # How the press into the current move was timed, if a rally led into it.
var _flight_done := false # The flying companion has hit something, or its flight is over.
var _flight_clear_out := -1.0 # How far out the flying companion was at its last check that touched nothing.
var _key := "" # The stand kind's skill tree (the Skills autoload).
var _damage_scale := 1.0
var _puffer_scale := 1.0
var _window_scale := 1.0 # The rally's timing windows are this much wider.
var _counter_left := 0.0 # Seconds left to counter a blocked hit.
var _cooldowns := {} # Cooldown key (stand_move.gd cooldown_key()) -> {"left", "total", "icon"}.
var _skilled := true # False for a wild stand: no skills, and every move known but its locked specials.
var _formation: SchoolFormationMove # The formation it's in (school_formation_move.gd), or null.
var _formation_used := false # A formation can be made once per summon.

## Where its buttons come from: the player's (stand_input.gd), or an AI's (enemy_stand_brain.gd).
var input: StandInput = StandInput.new()


## Takes over `stand`'s fighting: `controller` is its stand_controller.gd and `user` the player (never hit;
## null for none). A wild stand (`skilled` false) knows all its moves but has none of its kind's skills.
func setup(stand: Node3D, controller: Node, user: Node3D, skilled := true) -> void:
	_stand = stand
	_controller = controller
	_user = user
	_skilled = skilled
	_bodies = StandShape.bodies(stand)
	_size = StandShape.size(stand)
	_moves = stand.get_moves() if stand.has_method("get_moves") else DefaultStandMoves.new()
	_moves.apply_cooldowns()
	_key = stand.scene_file_path
	if stand.has_signal("resized"):
		stand.resized.connect(func(_to: float) -> void: _size = StandShape.size(stand))
	var base_damage: float = stand.get("damage_scale") if stand.get("damage_scale") != null else 1.0
	_damage_scale = base_damage
	if skilled:
		_damage_scale = Skills.scaled(_key, "damage", base_damage)
		_puffer_scale = Skills.scaled(_key, "puffer_damage", 1.0)
		_window_scale = Skills.scaled(_key, "rally_window", 1.0)


## The move playing, or null.
func get_move() -> StandMove:
	return _move


## Whether the heavy is charging, and how far: seconds held.
func is_charging() -> bool:
	return _charging


func get_charge() -> float:
	return _charge if _charging else 0.0


## How the press into the current move was timed (&"perfect" or &"good"), or empty if no rally led into it.
func get_rally_grade() -> StringName:
	return _rally_grade


## Whether the move playing has super armor: hits don't stagger, shove or stop it (stand_health.gd).
func has_armor() -> bool:
	return _move != null and _move.super_armor


## Seconds until `move` can be used again (the cooldown of its attack, stand_move.gd), 0 if it can.
func cooldown_left(move: StandMove) -> float:
	var entry: Dictionary = _cooldowns.get(move.cooldown_key(), {})
	return maxf(float(entry.get("left", 0.0)), 0.0)


## Every attack cooling down now, for the HUD (stand_hud.gd): each {"key", "icon", "total", "left"}.
func cooldown_status() -> Array[Dictionary]:
	var status: Array[Dictionary] = []
	for key: StringName in _cooldowns:
		var entry: Dictionary = _cooldowns[key]
		status.append({"key": key, "icon": entry["icon"], "total": entry["total"], "left": entry["left"]})
	return status


## How fast its moves play: slower formed (its formation's attack_speed) or slowed (stand_status.gd).
func time_scale() -> float:
	var status := _status()
	var scale: float = status.attack_scale() if status else 1.0
	return scale * (_formation.attack_speed if _formation else 1.0)


## Share of a hit's damage it takes (stand_health.gd): less while formed.
func taken_scale() -> float:
	return _formation.damage_taken if _formation else 1.0


## Whether it can make a formation now: not yet made this summon, and its health above `ends_at` of full.
func can_form(ends_at: float) -> bool:
	var health := _health()
	return _formation == null and not _formation_used and (health == null or health.health > health.max_health * ends_at)


## Called by a formation move as it starts: asks for its cutscene (possession.gd), or with nothing to
## play it, forms at once.
func begin_formation(move: SchoolFormationMove) -> void:
	_formation_used = true
	if formation_requested.get_connections().is_empty():
		set_formed(move)
	else:
		formation_requested.emit(move)


## Forms up with `move` (a formation move: its size, damage, attack_speed and damage_taken), or breaks
## apart with null.
func set_formed(move: SchoolFormationMove) -> void:
	if move == _formation:
		return
	_formation = move
	if _stand.has_method("grow"):
		_stand.grow(move.size if move else 1.0)
	formation_changed.emit(move != null)


func is_formed() -> bool:
	return _formation != null


## Whether the stand is holding its block.
func is_blocking() -> bool:
	return _move != null and _move == _moves.block and _held


func _physics_process(delta: float) -> void:
	if _moves == null or _bodies.is_empty() or not is_instance_valid(_bodies[0]):
		return
	var health := _health()
	if health and health.is_dead():
		return
	var status := _status()
	if status and status.has_method("is_frozen") and status.is_frozen():
		return # Stopped in time (stand_status.gd): no moves go on, none start.
	# Breaking apart once hurt enough.
	if _formation and health and health.health <= health.max_health * _formation.ends_at:
		set_formed(null)
	for key: StringName in _cooldowns.keys():
		_cooldowns[key]["left"] -= delta * time_scale()
		if _cooldowns[key]["left"] <= 0.0:
			_cooldowns.erase(key)
	var staggered: bool = health != null and health.is_staggered()
	if not staggered:
		_read_input(delta)
	_read_specials(staggered)
	if _move:
		_advance(delta * time_scale())
	if _controller:
		_controller.speed_scale = _move.move_speed_scale if _move else 1.0


func _read_input(delta: float) -> void:
	_light_held = _light_held + delta if input.pressed("light_attack") else 0.0
	_buffer_age += delta
	_counter_left = maxf(_counter_left - delta, 0.0)
	if _buffer_age > input_buffer_time:
		_buffered = &""
	# A light press still held might become the barrage, so it waits: let go in time it's an ordinary
	# press, held on it's the barrage (no jab first). Presses whose timing matters go at once.
	if input.just_pressed("light_attack"):
		if input.pressed("light_attack") and not _instant_light():
			_light_pending = true
		else:
			_press(&"light")
	if _light_pending and not input.pressed("light_attack"):
		_light_pending = false
		_press(&"light")
	if input.just_pressed("heavy_attack"):
		_press(&"heavy")

	# Held light breaks into the barrage; held block raises the guard.
	if _moves.barrage and _light_held >= _moves.barrage_hold_time and _move != _moves.barrage and _can_cancel(true):
		if _start(_moves.barrage, true):
			_light_pending = false
		else:
			_light_held = -INF # Too tired: not again until light is pressed afresh.
	if _moves.block and input.pressed("block") and _move != _moves.block and _can_cancel():
		_start(_moves.block, true)

	# Letting go of a held move plays its ending; a barrage also ends by itself once held barrage_max_time.
	if _held and _move == _moves.barrage and (not input.pressed("light_attack") or _time >= _moves.barrage_max_time):
		_end_barrage()
	elif _held and _move == _moves.block and not input.pressed("block"):
		_release()

	# A charging heavy builds while held: ready at its charge_min, full at its charge_full. Let go, it's
	# thrown if ready and dropped if not.
	if _charging:
		var before := _charge
		_charge += delta
		if before < _move.charge_min and _charge >= _move.charge_min:
			charge_ready.emit(_move)
		if _move.charge_full > _move.charge_min and before < _move.charge_full and _charge >= _move.charge_full:
			charge_full.emit(_move)
		if not input.pressed("heavy_attack"):
			_end_charge()


# Whether a light press must act the moment it's pressed: a rally's timed press, a counter just after a
# block, or a rush punch out of a dash.
func _instant_light() -> bool:
	if _rally_pending():
		return true
	if _counter_left > 0.0 and _moves.counter and _allows(&"counter"):
		return true
	return _move == null and _moves.dash_strike != null and _allows(&"dash_strike") and _controller != null and _controller.is_dashing()


# The barrage ends: in its finale, once learned and held long enough, otherwise its closing shove.
func _end_barrage() -> void:
	if _moves.barrage_finisher and _allows(&"barrage_finisher") and _time >= _moves.barrage_finisher_after:
		if _start(_moves.barrage_finisher):
			return
	_release()


# Each special starts on its own action once learned: at rest or once the move can be cancelled, or any
# time (even `staggered`) if it has super armor.
func _read_specials(staggered: bool) -> void:
	for special in _moves.specials:
		if special.input == &"" or not InputMap.has_action(special.input) or not input.just_pressed(special.input):
			continue
		if special.unlock != &"" and not (_skilled and Skills.allows(_key, special.unlock)):
			continue # Not learned, or a wild stand: they never use their kind's locked specials.
		if not special.can_start(self):
			continue
		if (special.super_armor and _move != special) or (not staggered and _can_cancel()):
			_start(special)
			return


func _press(kind: StringName) -> void:
	if kind == &"light" and _learned_press():
		return
	if _move == null:
		_start_kind(kind)
	elif _held:
		return
	elif _rally_pending():
		if kind == &"light":
			_rally_press()
			return
		_rally_done = true # Heavy gives up on the rally (into the finisher, or the heavy once it ends).
		_buffered = kind
		_buffer_age = 0.0
	else:
		_buffered = kind
		_buffer_age = 0.0


## Drops whatever move is playing (and anything pressed meanwhile): a hit knocked the stand off it
## (stand_health.gd).
func interrupt() -> void:
	_buffered = &""
	_light_pending = false
	if _move:
		_finish()


# The stand's health and stamina (stand_health.gd), if it has them.
func _health() -> Node:
	return _stand.get_node_or_null("Health") if _stand else null


# The slows and roots on it (stand_status.gd), if it has them.
func _status() -> Node:
	return _stand.get_node_or_null("Status") if _stand else null


# Light pressed when a learned move answers it: a counter just after blocking a hit, or a rush punch out
# of a dash. Returns whether one started.
func _learned_press() -> bool:
	if _counter_left > 0.0 and _moves.counter and _allows(&"counter"):
		_counter_left = 0.0
		return _start(_moves.counter)
	if _move == null and _moves.dash_strike and _allows(&"dash_strike") and _controller and _controller.is_dashing():
		return _start(_moves.dash_strike)
	return false


## A hit was blocked (stand_health.gd): for a moment, light answers it with a counter, once learned.
func on_blocked() -> void:
	_counter_left = _moves.counter_window


# Whether the stand's kind has learned `unlock` (the Skills autoload); a move its tree doesn't lock is free.
func _allows(unlock: StringName) -> bool:
	return not _skilled or Skills.allows(_key, unlock)


# Whether the move is waiting for its rally press (stand_move.gd rally_at).
func _rally_pending() -> bool:
	return _move != null and _move.rallies() and not _rally_done and _move.next_light != null


# Light pressed while the companion comes back: timed against the move's rally_at. Too early while it's
# still being thrown doesn't count; otherwise perfect and good hit it on, anything else misses.
func _rally_press() -> void:
	if _time < _move.rally_from:
		return
	var off := absf(_time - _move.rally_at)
	if off > _move.rally_good * _window_scale:
		_rally_miss()
		return
	var grade := &"perfect" if off <= _move.rally_perfect * _window_scale else &"good"
	var next := _move.next_light
	if grade == &"perfect" and next.perfect:
		next = next.perfect
	var from := _move
	if not _start(next):
		_rally_miss() # Too tired to hit it.
		return
	rally_graded.emit(from, grade)
	_rally_grade = grade


# The rally was missed: the companion snaps home and the chain ends here.
func _rally_miss() -> void:
	_rally_done = true
	_chain_broken = true
	_buffered = &""
	rally_graded.emit(_move, &"miss")


# Whether a new move may take over now: at rest, or once the current one can be cancelled (any time
# during a light punch, for the barrage).
func _can_cancel(from_light := false) -> bool:
	if _move == null:
		return true
	if _held:
		return false
	if from_light and _is_light(_move):
		return true
	return _time >= _move.cancel_from


func _is_light(move: StandMove) -> bool:
	var link := _moves.light
	while link:
		if link == move:
			return true
		link = link.next_light
	return false


# Starts the light chain or the heavy (charging, if it charges).
func _start_kind(kind: StringName) -> void:
	if kind == &"light":
		_start(_moves.light)
	elif _moves.heavy:
		_start(_moves.heavy, _moves.heavy.charge_min > 0.0)


# The charging heavy was let go: thrown with power for how long it charged, or dropped if too soon.
func _end_charge() -> void:
	var move := _move
	_charging = false
	if _charge >= move.charge_min:
		var span := move.charge_full - move.charge_min
		_charge_power = clampf((_charge - move.charge_min) / span, 0.0, 1.0) if span > 0.0 else 1.0
		charge_ended.emit(move)
		_release()
	else:
		charge_ended.emit(move)
		move_cancelled.emit(move)
		_finish()


func _start(move: StandMove, held := false) -> bool:
	if move == null or move.animation == null:
		return false
	var from := _move
	# Going on within one attack (a chain's next link, a barrage's finale) isn't held up by its cooldown.
	var continuing := from != null and move.cooldown > 0.0 and from.cooldown_key() == move.cooldown_key()
	if not continuing and cooldown_left(move) > 0.0:
		cooling_down.emit(move, cooldown_left(move))
		return false
	var health := _health()
	if health and not health.spend(move.stamina_cost):
		return false # Too tired.
	var action := _action_of(move, from)
	if _move:
		_finish(move)
	_move = move
	_time = 0.0
	_shown = -0.0001
	_held = held and move.animation.can_hold()
	_buffered = &""
	_lunged = false
	_charge_power = -1.0
	_charging = _held and move.charge_min > 0.0
	_charge = 0.0
	_rally_done = false
	_rally_cued = false
	_chain_broken = false
	_rally_grade = &""
	_flight_done = false
	_flight_clear_out = -1.0
	move_started.emit(move)
	if action != &"":
		action_taken.emit(action)
	if _charging:
		charge_started.emit(move)
	move.on_start(self)
	return true


# The choice starting `move` (after `from`, if one was playing) shows: see `action_taken`.
func _action_of(move: StandMove, from: StandMove) -> StringName:
	if move == _moves.block:
		return &"block"
	if move == _moves.barrage:
		return &"barrage"
	if move == _moves.barrage_finisher:
		return &"" # Part of the barrage it ends, not a choice of its own.
	if move == _moves.counter:
		return &"counter"
	if move == _moves.dash_strike:
		return &"rush"
	if move in _moves.specials:
		return &"special"
	if from:
		if _is_or_perfect(move, from.next_heavy):
			return &"finisher"
		if _is_or_perfect(move, from.next_light):
			return &"chain"
	if move == _moves.light:
		return &"open"
	if move == _moves.heavy:
		return &"heavy"
	return &""


static func _is_or_perfect(move: StandMove, link: StandMove) -> bool:
	return link != null and (move == link or move == link.perfect)


# Starts the cooldown of the attack `move` belongs to.
func _cool(move: StandMove) -> void:
	_cooldowns[move.cooldown_key()] = {"left": move.cooldown, "total": move.cooldown,
		"icon": move.cooldown_icon if move.cooldown_icon != &"" else &"fist"}


func _release() -> void:
	_held = false
	var anim := _move.animation
	_time = maxf(_shown, anim.loop_end) if anim.can_hold() else _time
	_shown = _time
	move_released.emit(_move)


func _advance(delta: float) -> void:
	var anim := _move.animation
	var previous := _shown
	_time += delta
	_shown = anim.held_time(_time) if _held else _time
	# Held moves and charges use up stamina as they go; run out and they're let go.
	if _held and _move.stamina_drain > 0.0 and _health() and not _health().drain(_move.stamina_drain, delta):
		if _charging:
			_end_charge()
		else:
			_release()
		if _move == null:
			return
	_check_hits(previous, _shown, anim)
	if _move.companion_flies() and not _flight_done and not _held and _shown >= _move.flight_from:
		if _shown > _move.flight_until:
			_flight_done = true
		else:
			_fly_companion()

	if not _lunged and _move.lunge_speed > 0.0 and _shown >= _move.lunge_at:
		_lunged = true
		if _controller and _controller.has_method("lunge"):
			_controller.lunge(_facing(), _move.lunge_speed, _move.lunge_time)

	# A rallying move cues its perfect window, and misses if nothing was pressed in time.
	if _rally_pending():
		if not _rally_cued and _time >= _move.rally_at - _move.rally_perfect * _window_scale:
			_rally_cued = true
			rally_window.emit(_move)
		if _time > _move.rally_at + _move.rally_good * _window_scale:
			_rally_miss()

	# A remembered press moves on to the next move once this one can be cancelled.
	if _buffered != &"" and not _held and _time >= _move.cancel_from:
		var next := _move.next_light if _buffered == &"light" else _move.next_heavy
		if next and not _chain_broken:
			if _start(next):
				return
			_buffered = &"" # Too tired for it.
	if not _held and _time >= _move.duration():
		var kind := _buffered
		var ended := _move
		_finish()
		if kind != &"":
			_start_kind(kind)
		elif ended.cooldown_key() == &"light":
			action_taken.emit(&"stop") # The chain ran out with nothing pressed after it.


# Ends the move playing, however it stopped (finished, let go, a hit, a dropped charge, something cutting
# in); `next` is what takes over (null if nothing does). Its attack's cooldown starts now, unless `next`
# carries on the same attack.
func _finish(next: StandMove = null) -> void:
	var ended := _move
	if _charging:
		_charging = false
		charge_ended.emit(ended)
	_move = null
	_held = false
	if ended.cooldown > 0.0 and (next == null or next.cooldown_key() != ended.cooldown_key()):
		_cool(ended)
	move_ended.emit(ended)
	ended.on_end(self)


# Lands every hit whose time falls in (from, to], minding a held loop wrapping round.
func _check_hits(from: float, to: float, anim: StandAnimation) -> void:
	var spans: Array[Vector2] = []
	if to >= from:
		spans.append(Vector2(from, to))
	else: # Wrapped round the loop.
		spans.append(Vector2(from, anim.loop_end))
		spans.append(Vector2(anim.loop_start - 0.0001, to))
	for hit: Dictionary in _move.hits:
		var at: float = hit["time"]
		for span in spans:
			if at > span.x and at <= span.y:
				_land(hit)


func _land(hit: Dictionary) -> void:
	var facing := _facing()
	var right := facing.cross(Vector3.UP)
	var side: float = {"L": -1.0, "R": 1.0}.get(hit.get("fist", "both"), 0.0)
	var center := StandShape.center_of_mass(_bodies)
	var point := center + (facing * float(hit["reach"]) + right * side * fist_spread + Vector3.UP * float(hit.get("height", hit_height))) * _size
	var touched := _touching(point, float(hit["radius"]) * _size)
	for target in touched:
		_strike(target, hit, point, facing)
	if touched.is_empty():
		_punch_water(hit, point)
	hit_frame.emit(_move, hit, point)
	_move.on_hit_frame(self, hit)


# A blow that hit nothing but reaches down into the water splashes it (water.gd), harder the harder the
# blow.
func _punch_water(hit: Dictionary, point: Vector3) -> void:
	var water := get_tree().get_first_node_in_group("water")
	if water == null:
		return
	if point.y - water.surface_height_at(point) < float(hit["radius"]) * _size + 0.2:
		water.splash(point, clampf(float(hit.get("damage", 5.0)) / 20.0, 0.2, 0.9))


# The companion flying out: if where it is now (by the move's animation) runs into anything, it hits
# it with the move's companion_hit and stops there, the move skipping ahead to where it's on its way
# back at the same distance.
func _fly_companion() -> void:
	var out := _companion_out(_shown)
	var touched := _touching(_flight_point(out), _move.flight_radius * _size)
	if touched.is_empty():
		_flight_clear_out = out
		return
	# It went in between this check and the last: home in on where it first touched, so it stops at the
	# surface rather than inside.
	if _flight_clear_out >= 0.0:
		var clear := _flight_clear_out
		for i in 6:
			var mid := (clear + out) * 0.5
			var found := _touching(_flight_point(mid), _move.flight_radius * _size)
			if found.is_empty():
				clear = mid
			else:
				out = mid
				touched = found
	var point := _flight_point(out)
	_flight_done = true
	for target in touched:
		_strike(target, _move.companion_hit, point, _facing())
	companion_struck.emit(_move, point)
	var back := _return_time(out)
	if back > _time:
		_time = back
		_shown = back
		move_skipped.emit(_move, back)


# Where the flying companion is (by the move's flight settings) at `out` (its animation's companion_out).
func _flight_point(out: float) -> Vector3:
	var center := StandShape.center_of_mass(_bodies)
	return center + (_facing() * lerpf(_move.flight_near, _move.flight_reach, out) + Vector3.UP * _move.flight_height) * _size


# How far out the move's animation has its companion `time` seconds in (its companion_out).
func _companion_out(time: float) -> float:
	return float(_move.animation.evaluate(time, null).get("companion_out", 0.0))


# The first moment after the companion's flight when it's on its way back no further out than `out`.
func _return_time(out: float) -> float:
	var end := _move.rally_at if _move.rallies() else _move.duration()
	var time := _move.flight_until
	while time < end and _companion_out(time) > out:
		time += 1.0 / 120.0
	return minf(time, end)


# Everything (but the stand and its user) touching a sphere `radius` across at `point`.
func _touching(point: Vector3, radius: float) -> Array[Node]:
	var sphere := SphereShape3D.new()
	sphere.radius = radius
	var query := PhysicsShapeQueryParameters3D.new()
	query.shape = sphere
	query.transform = Transform3D(Basis(), point)
	var excluded: Array[RID] = []
	for body in _bodies:
		excluded.append(body.get_rid())
	if _user is CollisionObject3D:
		excluded.append((_user as CollisionObject3D).get_rid())
	query.exclude = excluded
	var touched: Array[Node] = []
	for result in _stand.get_world_3d().direct_space_state.intersect_shape(query, 16):
		var target: Node = result["collider"]
		if target and target not in touched:
			touched.append(target)
	return touched


# `hit` (damage, knockback, lift) lands on `target` at `point`: rigid bodies are shoved along `facing`,
# and anything with take_stand_hit() is told. Scenery is left alone.
func _strike(target: Node, hit: Dictionary, point: Vector3, facing: Vector3) -> void:
	var damage := float(hit.get("damage", 0.0))
	var puffer: bool = (_move and hit == _move.companion_hit) or hit.get("puffer", false) # The pufferfish's own blows.
	damage *= _damage_scale * (_puffer_scale if puffer else 1.0) * (_formation.damage_scale if _formation else 1.0)
	var knockback := float(hit.get("knockback", 0.0))
	if _charge_power >= 0.0: # A charged move hits harder the longer it charged.
		damage *= lerpf(1.0, _move.charge_damage_scale, _charge_power)
		knockback *= lerpf(1.0, _move.charge_knockback_scale, _charge_power)
	var push := facing * knockback + Vector3.UP * float(hit.get("lift", 0.0))
	var receiver: Node = target if target.has_method("take_stand_hit") else (target.owner if target.owner and target.owner.has_method("take_stand_hit") else null)
	if target is RigidBody3D:
		var body := target as RigidBody3D
		if not body.freeze:
			body.sleeping = false
			body.apply_central_impulse(push * body.mass)
	if receiver:
		var was_beaten: bool = receiver.has_method("is_defeated") and receiver.is_defeated()
		var sent := {"damage": damage, "knockback": push, "direction": facing,
			"point": point, "move": _move, "stand": _stand}
		if hit.has("status"):
			sent["status"] = hit["status"] # Slows and roots (stand_status.gd).
		receiver.take_stand_hit(sent)
		if not was_beaten and receiver.has_method("is_defeated") and receiver.is_defeated() and receiver.has_method("get_stand_user"):
			var user: Node3D = receiver.get_stand_user()
			if user:
				target_defeated.emit(receiver, user)
	if target is RigidBody3D or receiver:
		hit_landed.emit(_move, receiver if receiver else target, point)


# The way the stand faces, flat.
func _facing() -> Vector3:
	return StandShape.facing(StandShape.core(_bodies))
