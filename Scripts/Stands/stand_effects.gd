# One-shot effects for stands appearing and going, drawn like manga panels to match the stand shaders:
# paper-white flashes and rings edged in ink, radiating ink speed lines and white sparks. Stand
# animations fire them by name from their `events` (stand_animation.gd), and punches that land fire
# "impact"; the animation player (stand_body_visuals.gd) calls spawn(). Each effect adds itself to the
# world, plays and frees itself.
#   * "shockwave": a flat ring of light with an ink edge sweeping out along the ground plane.
#   * "burst": a flash, ink speed lines shooting outward in every direction, and a spray of sparks;
#     an impact, like a stand arriving with a roar or diving into its user.
#   * "impact": a small burst where a punch lands (stand_combat.gd hit_landed).
#   * "ready", "gather", "crackle": a charging heavy (stand_body_visuals.gd): ink lines gathering into
#     the fist, a flash and ring when it's ready, and ink sparks crackling round a full charge.
#   * "perfect", "poof": a rally (stand_combat.gd): a bright flash and ring on a perfect hit, and a puff
#     of ink rings where a missed companion snaps away from.
#   * "shatter": a beaten stand crumbling (its death animation): paper and ink shards breaking away,
#     spinning and falling as they fade.
#   * "sonic_boom", "water_jet", "splash", "dust": finishers (Scripts/Stands/Finisher/): a stand breaking
#     the sound barrier (rings blown back along `toward`), a jet of water shooting along `toward`, a
#     body slammed into water, and dust kicked up by one slammed into the ground.
#   * "ash": a beaten user crumbling to dust where they lie, grains drifting up and away on the wind.
#   * "ink_spray", "ink_cloud", "ink_drip": the Squid's ink (squid_stand_moves.gd): a jet of ink shooting
#     along `toward` with a spray of ink droplets, a dark cloud lingering where it lands, and a few drops
#     falling off a stand slowed by it (stand_body_visuals.gd).
# `size` scales everything; pass the stand's height.
# The forceful ones also hit the water when they go off just over it (or in it): "impact", "burst",
# "shockwave", "sonic_boom" and "splash" within WATER_REACH meters of the surface send rings across it
# (water.gd disturb()), and splash it if they're right on it. That's the only thing here that touches
# anything else: the ripples are water state nothing makes decisions on, they're for show.
# Otherwise purely presentation.
# Generated by Claude Code.
class_name StandEffects
extends RefCounted

const INK := Color(0.06, 0.06, 0.08)
const PAPER := Color(0.97, 0.97, 1.0)
const WATER_REACH := 3.0 # Meters above the water an effect still hits it from.
# How hard each forceful effect hits the water (for a stand-sized one right on the surface), 0..1.
const WATER_FORCE := {"impact": 0.35, "burst": 0.7, "shockwave": 0.6, "sonic_boom": 0.9, "splash": 0.8}


## Plays the effect called `effect` at `position` in `world`. Effects that go somewhere (a sonic boom's
## travel, a water jet) take `toward`: the way and distance, from `position`.
static func spawn(effect: String, world: Node, position: Vector3, size: float, toward := Vector3.ZERO) -> void:
	if world == null:
		return
	var root := Node3D.new()
	root.name = "StandEffect_" + effect
	world.add_child(root)
	root.global_position = position
	if toward.length() > 0.001: # Its -Z along `toward`.
		var up := Vector3.UP if absf(toward.normalized().y) < 0.99 else Vector3.RIGHT
		root.global_basis = Basis.looking_at(toward.normalized(), up)
	match effect:
		"shockwave":
			_shockwave(root, size)
		"impact":
			_burst(root, size * 0.35)
		"burst":
			_burst(root, size)
		"ready":
			_ready_flash(root, size)
		"gather":
			_gather(root, size)
		"crackle":
			_crackle(root, size)
		"perfect":
			_burst(root, size * 0.6)
			_ready_flash(root, size * 1.6)
		"poof":
			_poof(root, size)
		"shatter":
			_shatter(root, size)
		"sonic_boom":
			_sonic_boom(root, size)
		"water_jet":
			_water_jet(root, size, maxf(toward.length(), 0.1))
		"splash":
			_splash(root, size)
		"dust":
			_dust(root, size)
		"ash":
			_ash(root, size)
		"ink_spray":
			_ink_spray(root, size, maxf(toward.length(), 0.1))
		"ink_cloud":
			_ink_cloud(root, size)
		"ink_drip":
			_ink_drip(root, size)
		_:
			push_warning("StandEffects: no effect called '%s'" % effect)
	_hit_water(effect, root, size)
	var cleanup := root.create_tween()
	cleanup.tween_interval(3.4 if effect in ["ash", "ink_cloud"] else 1.2) # Ash and ink clouds linger a while.
	cleanup.tween_callback(root.queue_free)


# A forceful effect going off just over the water (or in it) sends rings across it, and splashes it if
# it's right on it: harder the bigger and closer it is.
static func _hit_water(effect: String, root: Node3D, size: float) -> void:
	if not WATER_FORCE.has(effect) or not root.is_inside_tree():
		return
	var water := root.get_tree().get_first_node_in_group("water")
	if water == null:
		return
	var position := root.global_position
	var surface: float = water.surface_height_at(position)
	var above := position.y - surface
	if above > WATER_REACH or above < -1.5:
		return
	# Only over open water: not on a beach that happens to be low.
	var ground := root.get_world_3d().direct_space_state.intersect_ray(PhysicsRayQueryParameters3D.create(
		Vector3(position.x, surface + WATER_REACH + 1.0, position.z), Vector3(position.x, surface - 0.3, position.z), 1))
	if not ground.is_empty() and ground["collider"] is StaticBody3D:
		return
	var force: float = WATER_FORCE[effect] * clampf(size / 2.85, 0.3, 1.5) * (1.0 - clampf(above / WATER_REACH, 0.0, 1.0) * 0.7)
	if above < 1.0:
		water.splash(position, clampf(force, 0.0, 1.0))
	else:
		water.disturb(position, 0.12 * force, lerpf(2.0, 5.0, clampf(force, 0.0, 1.0)))


static func _shockwave(root: Node3D, size: float) -> void:
	for ring: Array in [[PAPER, 1.0, 0.18], [INK, 1.16, 0.05]]: # [color, radius, thickness]
		var mesh := TorusMesh.new()
		mesh.inner_radius = ring[1] - ring[2]
		mesh.outer_radius = ring[1]
		mesh.rings = 48
		var material := _material(ring[0])
		var instance := _instance(root, mesh, material)
		instance.scale = Vector3.ONE * size * 0.15
		var tween := instance.create_tween().set_parallel()
		tween.tween_property(instance, "scale", Vector3(1.0, 0.4, 1.0) * size * 1.6, 0.5) \
			.set_trans(Tween.TRANS_CUBIC).set_ease(Tween.EASE_OUT)
		tween.tween_property(material, "albedo_color:a", 0.0, 0.5).set_ease(Tween.EASE_IN)


static func _burst(root: Node3D, size: float) -> void:
	# The flash.
	var flash_mesh := SphereMesh.new()
	flash_mesh.radial_segments = 16
	flash_mesh.rings = 8
	var flash_material := _material(Color(PAPER, 0.9))
	var flash := _instance(root, flash_mesh, flash_material)
	flash.scale = Vector3.ONE * size * 0.1
	var tween := flash.create_tween().set_parallel()
	tween.tween_property(flash, "scale", Vector3.ONE * size * 0.6, 0.25).set_ease(Tween.EASE_OUT)
	tween.tween_property(flash_material, "albedo_color:a", 0.0, 0.25)

	# Ink speed lines shooting out.
	for i in 18:
		var direction := Vector3(randf_range(-1.0, 1.0), randf_range(-0.6, 1.0), randf_range(-1.0, 1.0))
		if direction.length() < 0.1:
			direction = Vector3.UP
		direction = direction.normalized()
		var line_mesh := BoxMesh.new()
		line_mesh.size = Vector3(0.025, 0.025, 1.0) * size
		var line_material := _material(INK)
		var line := _instance(root, line_mesh, line_material)
		line.basis = Basis.looking_at(direction, Vector3.UP if absf(direction.y) < 0.99 else Vector3.RIGHT)
		line.position = direction * size * 0.25
		line.scale = Vector3(1.0, 1.0, 0.2)
		var line_tween := line.create_tween().set_parallel()
		line_tween.tween_property(line, "position", direction * size * randf_range(0.9, 1.3), 0.35) \
			.set_trans(Tween.TRANS_CUBIC).set_ease(Tween.EASE_OUT)
		line_tween.tween_property(line, "scale", Vector3(1.0, 1.0, randf_range(0.5, 0.9)), 0.2)
		line_tween.tween_property(line_material, "albedo_color:a", 0.0, 0.35).set_delay(0.1)

	# Sparks.
	var sparks := CPUParticles3D.new()
	sparks.one_shot = true
	sparks.amount = 28
	sparks.explosiveness = 1.0
	sparks.lifetime = 0.7
	sparks.direction = Vector3.UP
	sparks.spread = 180.0
	sparks.initial_velocity_min = size * 2.0
	sparks.initial_velocity_max = size * 4.0
	sparks.gravity = Vector3.DOWN * size * 3.0
	sparks.damping_min = size * 2.0
	sparks.damping_max = size * 3.0
	var fade_out := Gradient.new()
	fade_out.set_color(0, PAPER)
	fade_out.set_color(1, Color(PAPER, 0.0))
	sparks.color_ramp = fade_out
	var quad := QuadMesh.new()
	quad.size = Vector2.ONE * size * 0.045
	var spark_material := _material(Color.WHITE)
	spark_material.vertex_color_use_as_albedo = true
	spark_material.billboard_mode = BaseMaterial3D.BILLBOARD_PARTICLES
	quad.material = spark_material
	sparks.mesh = quad
	root.add_child(sparks)
	sparks.emitting = true


# A charged punch is ready: a quick white flash with an ink-edged ring snapping out around it.
static func _ready_flash(root: Node3D, size: float) -> void:
	var flash_material := _material(Color(PAPER, 0.95))
	var flash := _instance(root, SphereMesh.new(), flash_material)
	flash.scale = Vector3.ONE * size * 0.05
	var tween := flash.create_tween().set_parallel()
	tween.tween_property(flash, "scale", Vector3.ONE * size * 0.2, 0.15).set_ease(Tween.EASE_OUT)
	tween.tween_property(flash_material, "albedo_color:a", 0.0, 0.2)
	for ring: Array in [[PAPER, 1.0, 0.16], [INK, 1.14, 0.05]]: # [color, radius, thickness]
		var mesh := TorusMesh.new()
		mesh.inner_radius = ring[1] - ring[2]
		mesh.outer_radius = ring[1]
		mesh.rings = 32
		var material := _material(ring[0])
		var instance := _instance(root, mesh, material)
		instance.rotation = Vector3(PI * 0.5, 0.0, 0.0) # Standing up, facing forward.
		instance.scale = Vector3.ONE * size * 0.03
		var ring_tween := instance.create_tween().set_parallel()
		ring_tween.tween_property(instance, "scale", Vector3.ONE * size * 0.18, 0.3).set_trans(Tween.TRANS_CUBIC).set_ease(Tween.EASE_OUT)
		ring_tween.tween_property(material, "albedo_color:a", 0.0, 0.3).set_ease(Tween.EASE_IN)


# Power gathering: short ink lines streaking in toward the point from all round and vanishing there.
static func _gather(root: Node3D, size: float) -> void:
	for i in 6:
		var direction := Vector3(randf_range(-1.0, 1.0), randf_range(-1.0, 1.0), randf_range(-1.0, 1.0))
		if direction.length() < 0.1:
			direction = Vector3.UP
		direction = direction.normalized()
		var line_mesh := BoxMesh.new()
		line_mesh.size = Vector3(0.012, 0.012, 0.35) * size
		var material := _material(Color(INK, 0.0))
		var line := _instance(root, line_mesh, material)
		line.basis = Basis.looking_at(direction, Vector3.UP if absf(direction.y) < 0.99 else Vector3.RIGHT)
		line.position = direction * size * 0.6
		var tween := line.create_tween().set_parallel()
		tween.tween_property(line, "position", direction * size * 0.08, 0.25).set_ease(Tween.EASE_IN)
		tween.tween_property(material, "albedo_color:a", 0.9, 0.08)
		tween.tween_property(material, "albedo_color:a", 0.0, 0.08).set_delay(0.18)


# A fully charged stand crackling: a couple of tiny ink sparks jumping out and fading.
static func _crackle(root: Node3D, size: float) -> void:
	for i in 2:
		var direction := Vector3(randf_range(-1.0, 1.0), randf_range(-1.0, 1.0), randf_range(-1.0, 1.0)).normalized()
		var spark_mesh := BoxMesh.new()
		spark_mesh.size = Vector3(0.012, 0.012, 0.12) * size
		var material := _material(INK if i == 0 else PAPER)
		var spark := _instance(root, spark_mesh, material)
		spark.basis = Basis.looking_at(direction, Vector3.UP if absf(direction.y) < 0.99 else Vector3.RIGHT)
		var tween := spark.create_tween().set_parallel()
		tween.tween_property(spark, "position", direction * size * 0.12, 0.15)
		tween.tween_property(material, "albedo_color:a", 0.0, 0.15)


static func _material(color: Color) -> StandardMaterial3D:
	var material := StandardMaterial3D.new()
	material.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
	material.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA
	material.cull_mode = BaseMaterial3D.CULL_DISABLED
	material.albedo_color = color
	return material


static func _instance(root: Node3D, mesh: Mesh, material: Material) -> MeshInstance3D:
	var instance := MeshInstance3D.new()
	instance.mesh = mesh
	instance.material_override = material
	instance.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	root.add_child(instance)
	return instance


# A companion snapping away: a small puff of ink-edged rings spreading and fading.
static func _poof(root: Node3D, size: float) -> void:
	for i in 3:
		var direction := Vector3(randf_range(-1.0, 1.0), randf_range(-1.0, 1.0), randf_range(-1.0, 1.0)).normalized()
		var mesh := TorusMesh.new()
		mesh.inner_radius = 0.8
		mesh.outer_radius = 1.0
		mesh.rings = 24
		var material := _material(INK if i == 0 else PAPER)
		var ring := _instance(root, mesh, material)
		ring.basis = Basis.looking_at(direction, Vector3.UP if absf(direction.y) < 0.99 else Vector3.RIGHT) \
			* Basis(Vector3.RIGHT, PI * 0.5)
		ring.scale = Vector3.ONE * size * 0.02
		var tween := ring.create_tween().set_parallel()
		tween.tween_property(ring, "scale", Vector3.ONE * size * 0.12, 0.25).set_trans(Tween.TRANS_CUBIC).set_ease(Tween.EASE_OUT)
		tween.tween_property(material, "albedo_color:a", 0.0, 0.25).set_ease(Tween.EASE_IN)


# A stand crumbling: flat shards of paper and ink break away from all over it, tumbling outward and
# falling as they fade.
static func _shatter(root: Node3D, size: float) -> void:
	for i in 22:
		var direction := Vector3(randf_range(-1.0, 1.0), randf_range(-0.3, 1.0), randf_range(-1.0, 1.0)).normalized()
		var mesh := BoxMesh.new()
		mesh.size = Vector3(randf_range(0.04, 0.09), randf_range(0.03, 0.07), 0.006) * size
		var material := _material(INK if i % 3 == 0 else PAPER)
		var shard := _instance(root, mesh, material)
		shard.position = Vector3(randf_range(-0.12, 0.12), randf_range(-0.3, 0.3), randf_range(-0.08, 0.08)) * size
		shard.rotation = Vector3(randf() * TAU, randf() * TAU, randf() * TAU)
		var drift := shard.position + direction * size * randf_range(0.15, 0.35)
		var fall := drift + Vector3.DOWN * size * randf_range(0.3, 0.6)
		var time := randf_range(0.7, 1.0)
		var tween := shard.create_tween().set_parallel()
		tween.tween_property(shard, "position", drift, time * 0.35).set_ease(Tween.EASE_OUT)
		tween.tween_property(shard, "position", fall, time * 0.65).set_delay(time * 0.35).set_ease(Tween.EASE_IN)
		tween.tween_property(shard, "rotation", shard.rotation + Vector3(randf_range(-6.0, 6.0), randf_range(-6.0, 6.0), randf_range(-6.0, 6.0)), time)
		tween.tween_property(material, "albedo_color:a", 0.0, time * 0.5).set_delay(time * 0.5)


# Breaking the sound barrier, heading along -Z: a white flash, cones of ink-edged rings left behind and
# spreading, and speed lines streaking back.
static func _sonic_boom(root: Node3D, size: float) -> void:
	var flash_material := _material(Color(PAPER, 0.95))
	var flash := _instance(root, SphereMesh.new(), flash_material)
	flash.scale = Vector3.ONE * size * 0.1
	var flash_tween := flash.create_tween().set_parallel()
	flash_tween.tween_property(flash, "scale", Vector3.ONE * size * 0.5, 0.18).set_ease(Tween.EASE_OUT)
	flash_tween.tween_property(flash_material, "albedo_color:a", 0.0, 0.22)
	for i in 3:
		for ring: Array in [[PAPER, 1.0, 0.14], [INK, 1.12, 0.04]]: # [color, radius, thickness]
			var mesh := TorusMesh.new()
			mesh.inner_radius = ring[1] - ring[2]
			mesh.outer_radius = ring[1]
			mesh.rings = 40
			var material := _material(ring[0])
			var instance := _instance(root, mesh, material)
			instance.rotation = Vector3(PI * 0.5, 0.0, 0.0) # Facing along the travel.
			instance.position = Vector3(0.0, 0.0, size * 0.12 * i)
			instance.scale = Vector3.ONE * size * (0.1 + 0.05 * i)
			var tween := instance.create_tween().set_parallel()
			tween.tween_property(instance, "scale", Vector3(1.0, 0.25, 1.0) * size * (0.55 + 0.25 * i), 0.4 + 0.08 * i) \
				.set_trans(Tween.TRANS_CUBIC).set_ease(Tween.EASE_OUT)
			tween.tween_property(instance, "position", Vector3(0.0, 0.0, size * (0.3 + 0.35 * i)), 0.4 + 0.08 * i).set_ease(Tween.EASE_OUT)
			tween.tween_property(material, "albedo_color:a", 0.0, 0.45 + 0.08 * i).set_ease(Tween.EASE_IN)
	for i in 14:
		var spread := Vector3(randf_range(-1.0, 1.0), randf_range(-1.0, 1.0), 0.0).normalized() * size * randf_range(0.15, 0.4)
		var line_mesh := BoxMesh.new()
		line_mesh.size = Vector3(0.02, 0.02, 1.0) * size
		var line_material := _material(INK)
		var line := _instance(root, line_mesh, line_material)
		line.position = spread
		line.scale = Vector3(1.0, 1.0, 0.2)
		var tween := line.create_tween().set_parallel()
		tween.tween_property(line, "position", spread * 1.6 + Vector3(0.0, 0.0, size * randf_range(0.8, 1.4)), 0.35).set_ease(Tween.EASE_OUT)
		tween.tween_property(line, "scale", Vector3(1.0, 1.0, randf_range(0.6, 1.0)), 0.15)
		tween.tween_property(line_material, "albedo_color:a", 0.0, 0.3).set_delay(0.08)


# A jet of water `length` long along -Z: a blue-white column shooting out to full length, rings rippling
# along it and spray thrown off, all draining away.
static func _water_jet(root: Node3D, size: float, length: float) -> void:
	var water := Color(0.55, 0.8, 1.0, 0.85)
	for layer: Array in [[water, 0.12], [Color(PAPER, 0.9), 0.06]]: # [color, radius]
		var mesh := CylinderMesh.new()
		mesh.top_radius = layer[1] * size * 0.6
		mesh.bottom_radius = layer[1] * size
		mesh.height = 1.0
		mesh.radial_segments = 12
		var material := _material(layer[0])
		var column := _instance(root, mesh, material)
		column.rotation = Vector3(-PI * 0.5, 0.0, 0.0) # Along -Z.
		column.scale = Vector3(1.0, 0.01, 1.0)
		var tween := column.create_tween()
		tween.set_parallel()
		tween.tween_property(column, "scale", Vector3(1.0, length, 1.0), 0.12).set_ease(Tween.EASE_OUT)
		tween.tween_property(column, "position", Vector3(0.0, 0.0, -length * 0.5), 0.12).set_ease(Tween.EASE_OUT)
		tween.chain().tween_property(column, "scale", Vector3(0.2, length, 0.2), 0.5).set_ease(Tween.EASE_IN)
		tween.parallel().tween_property(material, "albedo_color:a", 0.0, 0.5).set_ease(Tween.EASE_IN)
	for i in 5:
		var mesh := TorusMesh.new()
		mesh.inner_radius = 0.8
		mesh.outer_radius = 1.0
		var material := _material(Color(PAPER, 0.8))
		var ring := _instance(root, mesh, material)
		ring.rotation = Vector3(PI * 0.5, 0.0, 0.0)
		ring.position = Vector3(0.0, 0.0, -length * (i + 0.5) / 5.0)
		ring.scale = Vector3.ONE * size * 0.1
		var tween := ring.create_tween().set_parallel()
		tween.tween_property(ring, "scale", Vector3.ONE * size * 0.3, 0.4).set_delay(0.03 * i).set_ease(Tween.EASE_OUT)
		tween.tween_property(material, "albedo_color:a", 0.0, 0.4).set_delay(0.03 * i)
	var spray := _droplets(root, size, 40, Color(0.75, 0.9, 1.0))
	spray.emission_shape = CPUParticles3D.EMISSION_SHAPE_BOX
	spray.emission_box_extents = Vector3(0.05 * size, 0.05 * size, length * 0.5)
	spray.position = Vector3(0.0, 0.0, -length * 0.5)


# A jet of ink `length` long along -Z: a dark column shooting out, ink droplets spattering along it.
static func _ink_spray(root: Node3D, size: float, length: float) -> void:
	for layer: Array in [[Color(INK, 0.9), 0.14], [Color(0.2, 0.12, 0.28, 0.85), 0.07]]: # [color, radius]
		var mesh := CylinderMesh.new()
		mesh.top_radius = layer[1] * size * 1.4 # Widening as it goes.
		mesh.bottom_radius = layer[1] * size * 0.5
		mesh.height = 1.0
		mesh.radial_segments = 10
		var material := _material(layer[0])
		var column := _instance(root, mesh, material)
		column.rotation = Vector3(-PI * 0.5, 0.0, 0.0) # Along -Z.
		column.scale = Vector3(1.0, 0.01, 1.0)
		var tween := column.create_tween()
		tween.set_parallel()
		tween.tween_property(column, "scale", Vector3(1.0, length, 1.0), 0.15).set_ease(Tween.EASE_OUT)
		tween.tween_property(column, "position", Vector3(0.0, 0.0, -length * 0.5), 0.15).set_ease(Tween.EASE_OUT)
		tween.chain().tween_property(column, "scale", Vector3(1.6, length, 1.6), 0.6).set_ease(Tween.EASE_IN)
		tween.parallel().tween_property(material, "albedo_color:a", 0.0, 0.6).set_ease(Tween.EASE_IN)
	var spray := _droplets(root, size, 60, Color(INK, 0.95))
	spray.emission_shape = CPUParticles3D.EMISSION_SHAPE_BOX
	spray.emission_box_extents = Vector3(0.08 * size, 0.08 * size, length * 0.5)
	spray.position = Vector3(0.0, 0.0, -length * 0.5)


# A dark cloud of ink lingering and spreading where a spray landed, slowly fading.
static func _ink_cloud(root: Node3D, size: float) -> void:
	for i in 10:
		var out := Vector3(randf_range(-1.0, 1.0), randf_range(-0.3, 0.6), randf_range(-1.0, 1.0)).normalized()
		var material := _material(Color(INK.lerp(Color(0.22, 0.14, 0.3), randf() * 0.6), 0.75))
		var puff := _instance(root, SphereMesh.new(), material)
		puff.position = out * size * 0.1
		puff.scale = Vector3.ONE * size * 0.15
		var tween := puff.create_tween().set_parallel()
		tween.tween_property(puff, "position", out * size * randf_range(0.35, 0.6), 2.5).set_ease(Tween.EASE_OUT)
		tween.tween_property(puff, "scale", Vector3.ONE * size * randf_range(0.35, 0.55), 2.5).set_ease(Tween.EASE_OUT)
		tween.tween_property(material, "albedo_color:a", 0.0, 1.4).set_delay(1.6)


# A few drops of ink falling off something slowed by it.
static func _ink_drip(root: Node3D, size: float) -> void:
	var drops := _droplets(root, size, 6, Color(INK, 0.9))
	drops.explosiveness = 0.4
	drops.spread = 40.0
	drops.direction = Vector3.DOWN
	drops.initial_velocity_min = 0.0
	drops.initial_velocity_max = size * 0.3
	drops.emission_shape = CPUParticles3D.EMISSION_SHAPE_SPHERE
	drops.emission_sphere_radius = size * 0.2


# Something slammed into water: a white column bursting up, rings spreading on the surface, spray.
static func _splash(root: Node3D, size: float) -> void:
	var mesh := CylinderMesh.new()
	mesh.top_radius = 0.1 * size
	mesh.bottom_radius = 0.35 * size
	mesh.height = 1.0
	var material := _material(Color(0.8, 0.93, 1.0, 0.9))
	var column := _instance(root, mesh, material)
	column.scale = Vector3(1.0, 0.01, 1.0)
	var tween := column.create_tween().set_parallel()
	tween.tween_property(column, "scale", Vector3(1.0, size * 1.6, 1.0), 0.3).set_ease(Tween.EASE_OUT)
	tween.tween_property(column, "position", Vector3(0.0, size * 0.8, 0.0), 0.3).set_ease(Tween.EASE_OUT)
	tween.tween_property(material, "albedo_color:a", 0.0, 0.7).set_delay(0.25)
	for i in 3:
		var ring_mesh := TorusMesh.new()
		ring_mesh.inner_radius = 0.9
		ring_mesh.outer_radius = 1.0
		ring_mesh.rings = 40
		var ring_material := _material(Color(PAPER, 0.85))
		var ring := _instance(root, ring_mesh, ring_material)
		ring.scale = Vector3.ONE * size * 0.1
		var ring_tween := ring.create_tween().set_parallel()
		ring_tween.tween_property(ring, "scale", Vector3(1.0, 0.3, 1.0) * size * (0.8 + 0.5 * i), 0.8).set_delay(0.1 * i).set_ease(Tween.EASE_OUT)
		ring_tween.tween_property(ring_material, "albedo_color:a", 0.0, 0.8).set_delay(0.1 * i)
	var spray := _droplets(root, size, 60, Color(0.85, 0.95, 1.0))
	spray.spread = 35.0
	spray.initial_velocity_min = size * 3.0
	spray.initial_velocity_max = size * 6.0


# Something slammed into the ground: grey-brown dust puffs rolling outward and a flat ring of dust.
static func _dust(root: Node3D, size: float) -> void:
	var dust := Color(0.62, 0.56, 0.47, 0.85)
	for i in 12:
		var angle := TAU * i / 12.0 + randf_range(-0.2, 0.2)
		var out := Vector3(cos(angle), 0.0, sin(angle))
		var material := _material(dust.lerp(Color(PAPER, 0.85), randf() * 0.3))
		var puff := _instance(root, SphereMesh.new(), material)
		puff.position = out * size * 0.15 + Vector3.UP * size * 0.05
		puff.scale = Vector3.ONE * size * 0.12
		var tween := puff.create_tween().set_parallel()
		tween.tween_property(puff, "position", out * size * randf_range(0.6, 0.9) + Vector3.UP * size * randf_range(0.05, 0.25), 0.9).set_ease(Tween.EASE_OUT)
		tween.tween_property(puff, "scale", Vector3.ONE * size * randf_range(0.25, 0.4), 0.9).set_ease(Tween.EASE_OUT)
		tween.tween_property(material, "albedo_color:a", 0.0, 0.6).set_delay(0.45)
	var ring_mesh := TorusMesh.new()
	ring_mesh.inner_radius = 0.85
	ring_mesh.outer_radius = 1.0
	ring_mesh.rings = 40
	var ring_material := _material(dust)
	var ring := _instance(root, ring_mesh, ring_material)
	ring.scale = Vector3(1.0, 0.2, 1.0) * size * 0.1
	var ring_tween := ring.create_tween().set_parallel()
	ring_tween.tween_property(ring, "scale", Vector3(1.0, 0.2, 1.0) * size * 1.2, 0.6).set_trans(Tween.TRANS_CUBIC).set_ease(Tween.EASE_OUT)
	ring_tween.tween_property(ring_material, "albedo_color:a", 0.0, 0.6).set_ease(Tween.EASE_IN)


# A burst of water droplets (billboarded specks) thrown up from the root.
static func _droplets(root: Node3D, size: float, amount: int, color: Color) -> CPUParticles3D:
	var particles := CPUParticles3D.new()
	particles.one_shot = true
	particles.amount = amount
	particles.explosiveness = 0.9
	particles.lifetime = 0.8
	particles.direction = Vector3.UP
	particles.spread = 180.0
	particles.initial_velocity_min = size * 1.0
	particles.initial_velocity_max = size * 2.5
	particles.gravity = Vector3.DOWN * size * 4.0
	var fade_out := Gradient.new()
	fade_out.set_color(0, color)
	fade_out.set_color(1, Color(color, 0.0))
	particles.color_ramp = fade_out
	var quad := QuadMesh.new()
	quad.size = Vector2.ONE * size * 0.04
	var material := _material(Color.WHITE)
	material.vertex_color_use_as_albedo = true
	material.billboard_mode = BaseMaterial3D.BILLBOARD_PARTICLES
	quad.material = material
	particles.mesh = quad
	root.add_child(particles)
	particles.emitting = true
	return particles


# Crumbling to dust: grey-brown grains lifting off a body lying here and drifting away on the wind, with
# soft puffs rolling off it.
static func _ash(root: Node3D, size: float) -> void:
	var grains := CPUParticles3D.new()
	grains.amount = 90
	grains.lifetime = 1.6
	grains.explosiveness = 0.0
	grains.one_shot = true
	grains.emission_shape = CPUParticles3D.EMISSION_SHAPE_BOX
	grains.emission_box_extents = Vector3(0.35, 0.1, 0.8) * size
	grains.direction = Vector3(0.6, 1.0, 0.2)
	grains.spread = 25.0
	grains.initial_velocity_min = size * 0.3
	grains.initial_velocity_max = size * 0.8
	grains.gravity = Vector3(size * 0.6, size * 0.25, 0.0) # Carried off on the wind.
	var fade_out := Gradient.new()
	fade_out.set_color(0, Color(0.6, 0.54, 0.45))
	fade_out.set_color(1, Color(0.6, 0.54, 0.45, 0.0))
	grains.color_ramp = fade_out
	var quad := QuadMesh.new()
	quad.size = Vector2.ONE * size * 0.035
	var material := _material(Color.WHITE)
	material.vertex_color_use_as_albedo = true
	material.billboard_mode = BaseMaterial3D.BILLBOARD_PARTICLES
	quad.material = material
	grains.mesh = quad
	root.add_child(grains)
	grains.emitting = true
	for i in 6:
		var puff_material := _material(Color(0.66, 0.6, 0.52, 0.6))
		var puff := _instance(root, SphereMesh.new(), puff_material)
		puff.position = Vector3(randf_range(-0.3, 0.3), 0.0, randf_range(-0.7, 0.7)) * size
		puff.scale = Vector3.ONE * size * 0.1
		var tween := puff.create_tween().set_parallel()
		tween.tween_property(puff, "position", puff.position + Vector3(size * 0.6, size * 0.4, 0.0), 1.1).set_delay(0.12 * i).set_ease(Tween.EASE_OUT)
		tween.tween_property(puff, "scale", Vector3.ONE * size * 0.3, 1.1).set_delay(0.12 * i)
		tween.tween_property(puff_material, "albedo_color:a", 0.0, 1.1).set_delay(0.12 * i)
