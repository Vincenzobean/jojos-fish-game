# Shape-agnostic helpers for stands: anything made of one or more RigidBody3Ds, any shape, any size.
# The thrasher (thrasher.gd), the possession controller (stand_controller.gd) and fishing (fishing.gd)
# use these instead of knowing anything about a particular model. Static functions only; preload this
# script and call them on it.
# Generated by Claude Code.
extends RefCounted


## `direction` laid flat (no up or down) and normalized; straight ahead (-Z) if it has no flat part.
static func flat(direction: Vector3) -> Vector3:
	var flat_direction := Vector3(direction.x, 0.0, direction.z)
	return flat_direction.normalized() if flat_direction.length() > 0.01 else Vector3.FORWARD


## The way `node` faces (its -Z), flat.
static func facing(node: Node3D) -> Vector3:
	return flat(-node.global_basis.z)


## Every RigidBody3D in the stand, the root included if it is one.
static func bodies(root: Node) -> Array[RigidBody3D]:
	var found: Array[RigidBody3D] = []
	if root is RigidBody3D:
		found.append(root)
	for body in root.find_children("*", "RigidBody3D", true, false):
		found.append(body)
	return found


## The stand's size in meters: the longest side of the world-space box around all its collision shapes.
## The stand must be in the scene tree.
static func size(root: Node) -> float:
	var box := AABB()
	var first := true
	for node in root.find_children("*", "CollisionShape3D", true, false):
		var shape_node := node as CollisionShape3D
		if shape_node.shape == null:
			continue
		var bounds := shape_node.global_transform * shape_node.shape.get_debug_mesh().get_aabb()
		box = bounds if first else box.merge(bounds)
		first = false
	return maxf(box.get_longest_axis_size(), 0.05)


## The mass-weighted middle of `parts`, in world space (`fallback` if there are none).
static func center_of_mass(parts: Array[RigidBody3D], fallback := Vector3.ZERO) -> Vector3:
	var total := 0.0
	var sum := Vector3.ZERO
	for body in parts:
		if is_instance_valid(body):
			sum += body.global_position * body.mass
			total += body.mass
	return sum / total if total > 0.0 else fallback


## The heaviest body: the one movement and facing are steered through.
static func core(parts: Array[RigidBody3D]) -> RigidBody3D:
	var best: RigidBody3D = null
	for body in parts:
		if best == null or body.mass > best.mass:
			best = body
	return best


## The body closest to `point`.
static func nearest(parts: Array[RigidBody3D], point: Vector3) -> RigidBody3D:
	var best: RigidBody3D = null
	for body in parts:
		if best == null or body.global_position.distance_squared_to(point) < best.global_position.distance_squared_to(point):
			best = body
	return best


## Turns on contact reporting for every body, so touching_ground() can work.
static func report_contacts(parts: Array[RigidBody3D]) -> void:
	for body in parts:
		body.contact_monitor = true
		body.max_contacts_reported = maxi(body.max_contacts_reported, 4)


## Whether any body touches something solid that isn't part of the stand (an island, say). Needs
## report_contacts() first.
static func touching_ground(parts: Array[RigidBody3D]) -> bool:
	for body in parts:
		if not is_instance_valid(body):
			continue
		var state := PhysicsServer3D.body_get_direct_state(body.get_rid())
		if state == null:
			continue
		for i in state.get_contact_count():
			var other := state.get_contact_collider_object(i)
			if not (other is RigidBody3D and other in parts):
				return true
	return false


## Keeps the stand near the surface, so it can't sink under an island: a body falling into the water
## loses its downward speed at `plunge_braking` per second, and one deeper than `max_depth` (in lengths
## of the stand) is pushed back up at `resurface_speed` per meter too deep.
static func keep_near_surface(parts: Array[RigidBody3D], stand_size: float, water: Node, delta: float,
		max_depth: float, plunge_braking: float, resurface_speed: float) -> void:
	if water == null:
		return
	var deepest := max_depth * stand_size
	for body in parts:
		if not is_instance_valid(body):
			continue
		var depth: float = water.surface_height_at(body.global_position) - body.global_position.y
		if depth <= 0.0:
			continue
		var velocity := body.linear_velocity
		if velocity.y < 0.0:
			velocity.y *= exp(-plunge_braking * delta)
		if depth > deepest:
			velocity.y = maxf(velocity.y, (depth - deepest) * resurface_speed)
		body.linear_velocity = velocity
