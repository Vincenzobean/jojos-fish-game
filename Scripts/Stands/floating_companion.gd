# Something a stand keeps floating beside it, like the Dolphin Stand's pufferfish (the one from the
# tutorial arrow, as a 3D model: pufferfish_model.gd, a child of this node). A Node3D child of a stand
# body (stand_body.gd): it hovers at `hover_offset` from the stand, by its right shoulder, easing after
# it so it trails a little, with a gentle bob and a slow wobble of its own. It turns to face the way
# the stand faces, rocking and swaying a little as it bobs.
#
# It follows where the stand is drawn: the rig its visuals pose (stand_body_visuals.gd) once summoned,
# so it keeps up through dashes, flips and the dive home, or the torso while it's a ragdoll on the line.
# The hover offset turns only with the stand's facing, never its flips. Its meshes dissolve in and out
# with the stand (the visuals' fade, through the stand shaders' "fade").
#
# The stand's animations can take hold of it through their companion channels (stand_animation.gd;
# the Dolphin's punches and kick, dolphin_stand_moves.gd): it's pulled to the fist or foot they name
# (stand_body_visuals.gd get_companion_hold()), sticking tight while held and flying back to its spot
# once let go, and puffed up when they say. Flying fast (tossed, kicked, coming home) it tumbles over
# and over like something thrown, then rights itself (_tumble_with()).
# A missed rally (stand_combat.gd) snaps it straight home in a puff (_snap_home()).
# It flashes white when the visuals say (a rally's cue, a perfect hit, flying into something).
#
# Purely presentation; attacks find it as the stand's "Pufferfish" node.
# Generated by Claude Code.
extends Node3D

@export var hover_offset := Vector3(1.1, 0.35, 0.1) ## Where it floats from the stand's middle, in meters before the body's scale (+X right, +Y up, -Z forward).
@export var follow_sharpness := 14.0 ## How quickly it catches up (per second); it trails further the faster the stand goes.
@export var turn_sharpness := 6.0 ## How quickly it turns to face the stand's way (per second).
@export var held_sharpness := 35.0 ## How tightly it sticks to where the stand's animation holds it (per second).
@export var bob_height := 0.08 ## Meters it bobs, before the body's scale...
@export var bob_speed := 2.3 ## ...at this many radians per second.
@export var wobble := 0.06 ## Meters it drifts around its spot, before the body's scale.
@export var sway := 10.0 ## Degrees it rocks and turns as it bobs.
@export_group("Tumbling")
@export var tumble_speed := 3.0 ## m/s (relative to the stand) above which flying makes it tumble...
@export var tumble_rate := 1.1 ## ...spinning this many radians per second per m/s...
@export var tumble_damping := 3.5 ## ...and the spin dies away at this rate once it slows (per second).

@onready var body: Node3D = get_parent()

var _time := 0.0
var _placed := false
var _fade := -1.0
var _base := Basis() # Its calm orientation: the stand's facing, rocking as it bobs...
var _tumble := Basis() # ...turned by however it's tumbling...
var _spin := Vector3.ZERO # ...at this angular velocity (radians per second, world).
var _snaps := 0 # The hold's snap count last seen (a missed rally sending it straight home).
var _squash := 0.0 # A pop as it lands home after a snap, dying away.
var _puff := 1.0 # How puffed up it is, easing toward what the hold says.
var _flash := -1.0 # How white it's flashing (the stand shaders' "flash").


func _ready() -> void:
	top_level = true # Moves on its own rather than being carried rigidly by the stand.


func _process(delta: float) -> void:
	var torso: Node3D = body.torso if "torso" in body else null
	if torso == null or not is_instance_valid(torso):
		return
	_time += delta
	var scale_factor: float = body.body_scale if "body_scale" in body else 1.0
	var anchor: Node3D = torso.get_node_or_null("Rig")
	if anchor == null:
		anchor = torso
	# The stand's facing about the vertical only.
	var front := -torso.global_basis.z
	front.y = 0.0
	var facing := Basis.looking_at(front.normalized(), Vector3.UP) if front.length() > 0.01 else Basis()
	var drift := Vector3(sin(_time * 0.7) * wobble, sin(_time * bob_speed) * bob_height, cos(_time * 0.9) * wobble)
	var wanted := anchor.global_position + facing * ((hover_offset + drift) * scale_factor)
	var rock := Basis.from_euler(Vector3(
		deg_to_rad(sway * 0.6 * cos(_time * bob_speed)), deg_to_rad(sway * sin(_time * 0.8)), deg_to_rad(sway * 0.4 * sin(_time * 1.3))))
	# The stand's animation may be holding it: in a fist, tossed between them, on the kicking foot.
	var visuals := body.get_node_or_null("Visuals")
	var hold: Dictionary = visuals.get_companion_hold() if visuals and visuals.has_method("get_companion_hold") else {}
	if int(hold.get("snaps", 0)) != _snaps:
		_snaps = int(hold.get("snaps", 0))
		if _placed:
			_snap_home(wanted, scale_factor)
	var held: float = hold.get("weight", 0.0)
	if held > 0.0:
		wanted = wanted.lerp(hold["point"], held)
	var sharpness := lerpf(follow_sharpness, held_sharpness, held)
	if _placed:
		var previous := global_position
		global_position = global_position.lerp(wanted, 1.0 - exp(-sharpness * delta))
		_base = _base.slerp(facing * rock, 1.0 - exp(-turn_sharpness * delta)).orthonormalized()
		# How fast it's flying relative to the stand (so it doesn't spin just because the stand flies).
		var stand_velocity: Vector3 = (torso as RigidBody3D).linear_velocity if torso is RigidBody3D else Vector3.ZERO
		_tumble_with(((global_position - previous) / maxf(delta, 0.0001)) - stand_velocity, facing, delta)
	else:
		global_position = wanted
		_base = facing * rock
		_placed = true
	global_basis = (_tumble * _base).orthonormalized()
	var puff: float = hold.get("scale", 1.0)
	_puff = lerpf(_puff, puff, 1.0 - exp(-20.0 * delta))
	_squash = move_toward(_squash, 0.0, delta * 4.0)
	scale = Vector3(1.0 + 0.3 * _squash, 1.0 - 0.3 * _squash, 1.0 + 0.3 * _squash) * _puff

	_set_fade(visuals.get_fade() if visuals and visuals.has_method("get_fade") else 1.0)
	_set_flash(hold.get("flash", 0.0))


# A missed rally: it vanishes in a puff where it was and pops back in at its spot beside the stand,
# no longer tumbling.
func _snap_home(home: Vector3, scale_factor: float) -> void:
	StandEffects.spawn("poof", get_tree().current_scene, global_position, 1.9 * scale_factor)
	global_position = home
	_spin = Vector3.ZERO
	_tumble = Basis()
	_squash = 1.0
	StandEffects.spawn("poof", get_tree().current_scene, home, 1.4 * scale_factor)


# Tumbles like something thrown: flying fast (relative to the stand) spins it over in the direction
# it travels, as a kicked ball rolls forward, and rising or falling pitches it over too. Once it slows
# the spin carries on and dies away, and it rights itself back to its calm orientation.
func _tumble_with(velocity: Vector3, facing: Basis, delta: float) -> void:
	var speed := velocity.length()
	if speed > tumble_speed:
		var axis := Vector3.UP.cross(velocity) - facing.x * velocity.y * 0.6
		_spin = _spin.lerp(axis * tumble_rate, 1.0 - exp(-8.0 * delta))
	else:
		_spin *= exp(-tumble_damping * delta)
	var turning := _spin.length()
	if turning > 0.01:
		_tumble = (Basis(_spin / turning, turning * delta) * _tumble).orthonormalized()
	if turning < 4.0:
		_tumble = _tumble.slerp(Basis(), 1.0 - exp(-6.0 * delta)).orthonormalized() # Righting itself.


func _set_flash(amount: float) -> void:
	if is_equal_approx(amount, _flash):
		return
	_flash = amount
	for child in find_children("*", "GeometryInstance3D", true, false):
		(child as GeometryInstance3D).set_instance_shader_parameter(&"flash", amount)


func _set_fade(amount: float) -> void:
	if is_equal_approx(amount, _fade):
		return
	_fade = amount
	for child in find_children("*", "GeometryInstance3D", true, false):
		(child as GeometryInstance3D).set_instance_shader_parameter(&"fade", amount)
