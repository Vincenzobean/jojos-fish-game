# A controlled stand's health and stamina: added by possession (possession.gd) beside its controller
# (stand_controller.gd) and combat (stand_combat.gd). The stand's own, not its user's: hits on it hurt
# only it.
#
#   * Health: max_health comes from the stand (stand_body.gd max_health). Hits arrive through the
#     stand's take_stand_hit() (the same hook stands hit their targets with, so anything that hits
#     sends the same dictionary: damage, knockback, direction, point...). Holding block (combat
#     is_blocking()) against a hit from the front takes only blocked_share of it and stands firm;
#     otherwise it staggers the stand (its move dropped, a moment without control) and shoves it along
#     the knockback. During a super-armored move (combat has_armor()) a hit still hurts, but doesn't
#     stagger, shove or stop it (the hit is marked "armored"). At 0 it dies (`died`, once); possession
#     takes it from there. Damage is scaled by the stand's damage_taken_scale and its combat's
#     taken_scale() (less while formed). A stand that dash_evades isn't touched while it air-dashes
#     (`evaded`). An unblocked hit's "status" (slows, roots) goes on its Status (stand_status.gd).
#     Frozen in a time stop (stand_status.gd is_frozen()), hits don't land yet: each is kept (`hit_held`)
#     and they all land, in order, the moment time moves again. While `invulnerable` (a boss changing
#     phase, boss_stand_brain.gd) hits miss it (`evaded`).
#   * Stamina: attacks (stand_move.gd stamina_cost and stamina_drain) and dashes
#     (stand_controller.gd dash_stamina) spend it; anything it can't pay for doesn't happen
#     (`stamina_short`). It refills once nothing has spent it for a moment.
#
#   * Kinds with something of their own (stand_body.gd):
#       - Immortal (`revives`, the Jellyfish): the first time(s) it would die in a fight it comes back at
#         revive_health of its health instead (`revived`; its kind's Second Bloom raises that), a moment
#         untouchable while it blooms back.
#       - Shell Guard (`block_reflect`, the Lobster): a blocked hit sends that share of its damage back at
#         whoever threw it (`reflected`; never a reflected hit, so two can't bounce one forever).
#       - Molt (`molt_at`, the Lobster, once learned): the first time its health falls to that share in a
#         fight it sheds its shell: heals MOLT_HEAL, flies MOLT_HASTE faster but takes MOLT_EXPOSED more
#         damage for MOLT_TIME seconds (`molted`).
#       - Time resist (`time_resist`, the Jellyfish, once Timeless Drift is learned): its Status may slip a
#         time stop (stand_status.gd).
#   * Return to Zero (the Jellyfish's ultimate, return_to_zero_move.gd, start_zero()): while it lasts, no
#     hit on it happens at all (`undone`): the attacker is sent back to where it was ZERO_REWIND seconds
#     before (position_history.gd, the "History" every fighting stand gets here). Its meter, `ultimate`
#     (0 to 1), fills from damage taken: full at ULTIMATE_FILL of its health.
#
# Its kind's skills (the Skills autoload, keyed by the stand's scene) grow its health, stamina and
# regen, and make blocks let less through.
#
# Gameplay only: the HUD (stand_hud.gd) and the stand's visuals (stand_body_visuals.gd) show it.
# Generated by Claude Code.
extends Node

## A hit landed: `amount` taken, `hit` the hit dictionary, `blocked` whether the guard caught it.
signal damaged(amount: float, hit: Dictionary, blocked: bool)
## Health reached 0.
signal died
## A hit missed it: it was air-dashing and its kind evades while dashing (stand_body.gd dash_evades).
signal evaded(hit: Dictionary)
## A hit reached it while it was frozen in time: it lands once time moves again.
signal hit_held(hit: Dictionary)
## It would have died but came back (Immortal), at `health`.
signal revived(health: float)
## It shed its shell (Molt).
signal molted
## A blocked hit's `amount` was sent back at `attacker` (Shell Guard).
signal reflected(amount: float, attacker: Node3D)
## A hit never happened: Return to Zero undid it, and sent its attacker back.
signal undone(hit: Dictionary)
## Return to Zero began (true) or ended (false).
signal zero_changed(active: bool)
## Stamina was spent...
signal stamina_spent(amount: float)
## ...or something needed more than was left, so it didn't happen.
signal stamina_short(amount: float)

const StandShape := preload("res://Scripts/Stands/stand_shape.gd")
const PositionHistory := preload("res://Scripts/Stands/position_history.gd")

const MOLT_HEAL := 0.25 ## Share of max health the molt heals...
const MOLT_TIME := 8.0 ## ...and for how long after it the stand is...
const MOLT_HASTE := 1.3 ## ...this much faster...
const MOLT_EXPOSED := 1.2 ## ...and takes this much more damage.
const REVIVE_GRACE := 1.2 ## Seconds it can't be touched while it blooms back.
const ZERO_REWIND := 2.0 ## Seconds back in time Return to Zero sends an attacker.
const ULTIMATE_FILL := 0.4 ## Share of its health it must lose to fill its ultimate meter.

@export var max_stamina := 100.0
@export var stamina_regen := 30.0 ## Stamina per second refilled...
@export var regen_delay := 0.8 ## ...once nothing has spent any for this many seconds.
@export var blocked_share := 0.2 ## Share of a hit's damage a block lets through.
@export var stagger_time := 0.35 ## Seconds a hit that isn't blocked leaves the stand without control.
@export var knockback_time := 0.12 ## Seconds a hit shoves the stand along its knockback...
@export var blocked_knockback := 0.3 ## ...at this share of it when blocked.

var max_health := 100.0
var health := 100.0
var stamina := 100.0
var recent_health := 100.0 ## Health a moment ago, trailing behind after a hit (for the HUD's damage chunk).
var invulnerable := false ## Hits miss it while set.
var revives_left := 0 ## Comebacks left this fight (Immortal).
var revive_share := 0.3 ## Share of max health it comes back at.
var reflect_share := 0.0 ## Share of a blocked hit sent back (Shell Guard).
var molt_at := 0.0 ## Share of health it molts at (0: it can't).
var ultimate := 0.0 ## Its ultimate meter, 0 to 1 (filled by damage taken).
var ultimate_used := false ## Its ultimate has been used this fight.

var _stand: Node3D
var _controller: Node
var _combat: Node
var _since_spent := 0.0
var _stagger := 0.0
var _dead := false
var _taken_scale := 1.0 # The stand's damage_taken_scale.
var _evades := false # The stand's dash_evades.
var _held_hits: Array[Dictionary] = [] # Hits that reached it while frozen, waiting for time to move.
var _status: Node # Its Status (stand_status.gd), once found.
var _molted := false
var _exposed_left := 0.0 # Seconds left taking more damage after a molt.
var _grace_left := 0.0 # Seconds left untouchable after a revive.
var _zero_left := 0.0 # Seconds of Return to Zero left.
var _time_resist := false # Its kind can slip time stops (set on its Status once found).


## Takes on `stand`'s health: `controller` and `combat` are its stand_controller.gd and stand_combat.gd.
## A wild stand (`skilled` false) doesn't get its kind's skills.
func setup(stand: Node3D, controller: Node, combat: Node, skilled := true) -> void:
	_stand = stand
	_controller = controller
	_combat = combat
	var key := stand.scene_file_path
	_taken_scale = float(stand.get("damage_taken_scale")) if stand.get("damage_taken_scale") != null else 1.0
	_evades = stand.get("dash_evades") == true
	var base_health := float(stand.get("max_health")) if stand.get("max_health") != null else 100.0
	max_health = base_health
	if skilled:
		max_health = Skills.scaled(key, "max_health", base_health)
		max_stamina = Skills.scaled(key, "max_stamina", max_stamina)
		stamina_regen = Skills.scaled(key, "stamina_regen", stamina_regen)
		blocked_share = Skills.scaled(key, "blocked_share", blocked_share)
	health = max_health
	recent_health = max_health
	stamina = max_stamina
	# Its kind's own: Immortal, Shell Guard, Molt, time resist (learned ones only for the player's).
	revives_left = int(stand.get("revives")) if stand.get("revives") != null else 0
	revive_share = float(stand.get("revive_health")) if stand.get("revive_health") != null else 0.3
	reflect_share = float(stand.get("block_reflect")) if stand.get("block_reflect") != null else 0.0
	var molts := float(stand.get("molt_at")) if stand.get("molt_at") != null else 0.0
	if skilled:
		revive_share += Skills.bonus(key, "revive_health")
		if reflect_share > 0.0:
			reflect_share += Skills.bonus(key, "block_reflect")
		molts = molts if Skills.allows(key, &"molt") else 0.0
	molt_at = molts
	_time_resist = stand.get("time_resist") == true and (not skilled or Skills.allows(key, &"timeless_drift"))
	if stand.get_node_or_null("History") == null:
		var history := PositionHistory.new()
		history.name = "History"
		stand.add_child(history)
	_watch_status()


func is_dead() -> bool:
	return _dead


## Whether a hit has just knocked the stand off balance (no moves or dashes until it recovers).
func is_staggered() -> bool:
	return _stagger > 0.0


## Takes `hit` (see the top). Does nothing once dead.
func take_hit(hit: Dictionary) -> void:
	if _dead:
		return
	if is_zeroed():
		_undo(hit)
		return
	if invulnerable or _grace_left > 0.0:
		evaded.emit(hit)
		return
	_watch_status()
	if _status and _status.is_frozen():
		_held_hits.append(hit)
		hit_held.emit(hit)
		return
	if _evades and _controller and _controller.has_method("is_dashing") and _controller.is_dashing():
		evaded.emit(hit)
		return
	var direction: Vector3 = hit.get("direction", Vector3.ZERO)
	var blocked: bool = _combat != null and _combat.is_blocking() and _facing().dot(direction) < 0.0
	var amount := float(hit.get("damage", 0.0)) * (blocked_share if blocked else 1.0) * _taken_scale
	if _combat and _combat.has_method("taken_scale"):
		amount *= _combat.taken_scale()
	if _exposed_left > 0.0:
		amount *= MOLT_EXPOSED
	if blocked and reflect_share > 0.0 and not hit.get("reflected", false):
		_reflect(hit)
	health = maxf(health - amount, 0.0)
	if not ultimate_used:
		ultimate = minf(ultimate + amount / maxf(max_health * ULTIMATE_FILL, 1.0), 1.0)
	var armored: bool = not blocked and _combat != null and _combat.has_method("has_armor") and _combat.has_armor()
	if armored:
		hit["armored"] = true
	var push: Vector3 = hit.get("knockback", Vector3.ZERO) * (blocked_knockback if blocked else 1.0)
	if not armored and _controller and _controller.has_method("lunge") and push.length() > 0.1:
		_controller.lunge(push, push.length(), knockback_time)
	if armored:
		pass # Shrugged off: the super-armored move plays on.
	elif not blocked:
		_stagger = stagger_time
		if _combat and _combat.has_method("interrupt"):
			_combat.interrupt()
	elif _combat and _combat.has_method("on_blocked"):
		_combat.on_blocked() # A chance to counter.
	var status: Node = _stand.get_node_or_null("Status") if _stand else null
	if status and not blocked and hit.has("status"):
		status.apply(hit["status"])
	damaged.emit(amount, hit, blocked)
	if health <= 0.0 and revives_left > 0:
		_revive()
	elif health <= 0.0:
		_dead = true
		died.emit()
	elif molt_at > 0.0 and not _molted and health <= max_health * molt_at:
		_molt()


## Heals `share` of its max health (not past full).
func heal(share: float) -> void:
	if _dead:
		return
	health = minf(health + max_health * share, max_health)


## Whether Return to Zero is undoing every hit on it.
func is_zeroed() -> bool:
	return _zero_left > 0.0


## Return to Zero begins: for `seconds`, no hit on it happens.
func start_zero(seconds: float) -> void:
	var fresh := not is_zeroed()
	_zero_left = maxf(_zero_left, seconds)
	ultimate = 0.0
	ultimate_used = true
	if fresh:
		zero_changed.emit(true)


# Immortal: it reverts instead of dying, and blooms back at revive_share.
func _revive() -> void:
	revives_left -= 1
	health = max_health * revive_share
	recent_health = health
	_grace_left = REVIVE_GRACE
	_stagger = 0.0
	revived.emit(health)


# Molt: sheds its shell once a fight.
func _molt() -> void:
	_molted = true
	heal(MOLT_HEAL)
	_exposed_left = MOLT_TIME
	if _status and _status.has_method("haste"):
		_status.haste(MOLT_HASTE, MOLT_TIME)
	molted.emit()


# Shell Guard: part of a blocked hit goes straight back into whoever threw it.
func _reflect(hit: Dictionary) -> void:
	var attacker: Node3D = hit.get("stand")
	if attacker == null or not is_instance_valid(attacker) or attacker == _stand:
		return
	var their_health := attacker.get_node_or_null("Health")
	if their_health == null:
		return
	var amount := float(hit.get("damage", 0.0)) * reflect_share
	var direction: Vector3 = hit.get("direction", Vector3.ZERO)
	their_health.take_hit({"damage": amount, "direction": -direction, "knockback": -direction * 3.0,
		"point": hit.get("point", attacker.global_position), "stand": _stand, "reflected": true})
	reflected.emit(amount, attacker)


# Return to Zero: the hit never happens, and whoever threw it is back where they were before they did.
func _undo(hit: Dictionary) -> void:
	var attacker: Node3D = hit.get("stand")
	if attacker and is_instance_valid(attacker) and attacker != _stand:
		var history := attacker.get_node_or_null("History")
		if history:
			history.rewind(ZERO_REWIND)
		var their_combat := attacker.get_node_or_null("Combat")
		if their_combat and their_combat.has_method("interrupt"):
			their_combat.interrupt()
	undone.emit(hit)


## How many hits are waiting for time to move again.
func held_hits() -> int:
	return _held_hits.size()


# Finds its Status (added beside it) and listens for its freezes ending.
func _watch_status() -> void:
	if is_instance_valid(_status) or _stand == null:
		return
	_status = _stand.get_node_or_null("Status")
	if _status and "can_resist_time" in _status:
		_status.can_resist_time = _time_resist
	if _status and _status.has_signal("frozen_changed"):
		_status.frozen_changed.connect(_on_frozen_changed)
	elif _status and not _status.has_method("is_frozen"):
		_status = null


# Time moves again: every hit held meanwhile lands now, in order.
func _on_frozen_changed(frozen: bool) -> void:
	if frozen:
		return
	var hits := _held_hits
	_held_hits = []
	for hit in hits:
		take_hit(hit)


## Spends `amount` stamina if there's that much (true), or says it's short (false).
func spend(amount: float) -> bool:
	if amount <= 0.0:
		return true
	if stamina < amount:
		stamina_short.emit(amount)
		return false
	stamina -= amount
	_since_spent = 0.0
	stamina_spent.emit(amount)
	return true


## Spends stamina at `per_second` over `delta`: false once it has run out.
func drain(per_second: float, delta: float) -> bool:
	if per_second <= 0.0:
		return true
	stamina = maxf(stamina - per_second * delta, 0.0)
	_since_spent = 0.0
	return stamina > 0.0


func _physics_process(delta: float) -> void:
	_stagger = maxf(_stagger - delta, 0.0)
	_grace_left = maxf(_grace_left - delta, 0.0)
	_exposed_left = maxf(_exposed_left - delta, 0.0)
	if _zero_left > 0.0:
		_zero_left = maxf(_zero_left - delta, 0.0)
		if _zero_left <= 0.0:
			zero_changed.emit(false)
	_since_spent += delta
	if _since_spent >= regen_delay and not _dead:
		stamina = minf(stamina + stamina_regen * delta, max_stamina)
	# The damage chunk catches up after a beat.
	if recent_health > health:
		recent_health = maxf(recent_health - max_health * 0.6 * delta, health) if _stagger <= 0.0 else recent_health
	else:
		recent_health = health


# The way the stand faces, flat.
func _facing() -> Vector3:
	var torso: Node3D = _stand.get("torso") if _stand else null
	if torso == null:
		return Vector3.FORWARD
	return StandShape.facing(torso)
