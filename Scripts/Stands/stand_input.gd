# Where a stand's controls come from: the stand controller (stand_controller.gd) and combat
# (stand_combat.gd) read their buttons through one of these instead of Input directly, so something
# other than the player can drive a stand. This base class just reads the player's Input; an AI
# (enemy_stand_brain.gd) uses StandAIInput (stand_ai_input.gd) and presses the buttons itself.
# Generated by Claude Code.
class_name StandInput
extends RefCounted


## Whether `action` is held.
func pressed(action: StringName) -> bool:
	return Input.is_action_pressed(action)


## Whether `action` went down this frame.
func just_pressed(action: StringName) -> bool:
	return Input.is_action_just_pressed(action)


## Like Input.get_vector().
func get_vector(negative_x: StringName, positive_x: StringName, negative_y: StringName, positive_y: StringName) -> Vector2:
	return Input.get_vector(negative_x, positive_x, negative_y, positive_y)


## Like Input.get_axis().
func get_axis(negative: StringName, positive: StringName) -> float:
	return Input.get_axis(negative, positive)
