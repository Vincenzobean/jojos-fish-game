# A stand animation made of keyframes: poses at given times, with smooth (Catmull-Rom) curves through
# them, so a spin or flip keeps its speed through each key instead of stopping at it. Each key is a
# Dictionary with a "time" (seconds) plus any pivots and channels of a frame (see stand_animation.gd).
# A key that leaves something out has it at its default there (pivots 0, "fade" and "scale" 1,
# "shake" and "travel" 0, "lift" zero), so write every key as a whole pose. Keys must be in time order.
#
# One key makes a held pose. key() builds keys tidily in code, e.g.
#   key(0.2, {"Rig": Vector3(180, 0, 0), "KneeL": Vector3(-110, 0, 0)})
# Generated by Claude Code.
class_name StandKeyframeAnimation
extends StandAnimation

@export var keys: Array[Dictionary] = []

var _channels: Array[String] = [] # Every pivot and channel any key uses.


## A key at `time` seconds with the given pivots and channels.
static func key(time: float, values: Dictionary) -> Dictionary:
	var made := values.duplicate()
	made["time"] = time
	return made


func _sample(time: float, _motion: StandMotion) -> Dictionary:
	if keys.is_empty():
		return {}
	if _channels.is_empty():
		for k in keys:
			for name: String in k:
				if name != "time" and name not in _channels:
					_channels.append(name)
	# The segment `time` falls in, and how far along it.
	var last := keys.size() - 1
	var i := 0
	while i < last and time >= float(keys[i + 1]["time"]):
		i += 1
	var next := mini(i + 1, last)
	var start: float = keys[i]["time"]
	var span: float = float(keys[next]["time"]) - start
	var t := clampf((time - start) / span, 0.0, 1.0) if span > 0.0 else 0.0
	var before := keys[maxi(i - 1, 0)]
	var after := keys[mini(next + 1, last)]
	var frame := {}
	for name in _channels:
		var a: Variant = _value(keys[i], name)
		var b: Variant = _value(keys[next], name)
		frame[name] = a.cubic_interpolate(b, _value(before, name), _value(after, name), t) if a is Vector3 \
			else cubic_interpolate(a, b, _value(before, name), _value(after, name), t)
	return frame


static func _value(k: Dictionary, name: String) -> Variant:
	if k.has(name):
		return k[name]
	match name:
		"fade", "scale", "companion_scale":
			return 1.0
		"shake", "travel", "tentacle_reach", "tentacle_curl", "companion_weight", "companion_anchor", "companion_lift", "companion_out", "companion_head":
			return 0.0
	return Vector3.ZERO
