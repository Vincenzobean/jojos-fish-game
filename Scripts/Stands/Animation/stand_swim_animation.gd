# Continuous stand swimming, for carrying its user across the water (stand_ride.gd): the body lies face
# down along the surface ("Rig" tipped -90 degrees X), head forward, and strokes. Worked out from how the
# stand moves rather than keyframed, like StandHoverFlyAnimation. Two styles:
#   * CRAWL: the front crawl. The arms windmill in turn (each reaching overhead, pulling down through the
#     water to the hip, then swinging back over the top with the elbow bent), the head turning to breathe
#     on every other stroke, the legs flutter-kicking and the body wiggling a little with each pull;
#   * DOLPHIN_KICK: the arms swept back along the sides, the legs held together and kicking as one while
#     a wave runs down the body from the chest to the feet.
# The strokes keep time with motion.stroke (cycles so far, quickening as the stand speeds up), so they
# never jump when its speed changes. All the amounts are exports.
# Generated by Claude Code.
class_name StandSwimAnimation
extends StandAnimation

enum Style { CRAWL, DOLPHIN_KICK }

@export var style := Style.CRAWL
@export var kick := 22.0 ## Degrees the legs kick.
@export var wiggle := 6.0 ## Degrees the body sways (crawl) or waves (dolphin kick) with the strokes.
@export var bob_height := 0.05 ## Meters it bobs on the water, before the body's scale.


func _sample(_time: float, motion: StandMotion) -> Dictionary:
	var phase := motion.stroke * TAU
	var bob := Vector3.UP * sin(phase * 2.0) * bob_height * motion.body_scale
	if style == Style.DOLPHIN_KICK:
		return _dolphin_kick(phase, bob)
	return _crawl(phase, bob, motion.moving)


func _crawl(phase: float, bob: Vector3, moving: float) -> Dictionary:
	# Each arm goes all the way round, the other half a turn behind: 180 is reaching overhead, 90 pulling
	# straight down into the water, 0 at the hip and -90 swinging back over the top out of the water.
	var left := 180.0 - rad_to_deg(wrapf(phase, 0.0, TAU))
	var right := 180.0 - rad_to_deg(wrapf(phase + PI, 0.0, TAU))
	var breathe := maxf(sin(phase * 0.5), 0.0) # Every other stroke, to one side.
	var flutter := sin(phase * 3.0) * kick
	return {
		"Rig": Vector3(-90.0, 0.0, wiggle * sin(phase)),
		"Neck": Vector3(20.0 + 10.0 * moving, 55.0 * breathe, 0.0),
		"ShoulderL": Vector3(left, 0.0, -12.0),
		"ShoulderR": Vector3(right, 0.0, 12.0),
		"ElbowL": Vector3(_recovery_bend(left), 0.0, 0.0),
		"ElbowR": Vector3(_recovery_bend(right), 0.0, 0.0),
		"HipL": Vector3(flutter, 0.0, -4.0),
		"HipR": Vector3(-flutter, 0.0, 4.0),
		"KneeL": Vector3(-10.0 - 12.0 * maxf(sin(phase * 3.0 + 0.8), 0.0), 0.0, 0.0),
		"KneeR": Vector3(-10.0 - 12.0 * maxf(-sin(phase * 3.0 + 0.8), 0.0), 0.0, 0.0),
		"lift": bob,
	}


# The elbow bends while the arm swings back over the top (between -180 and 0), straight while it pulls.
static func _recovery_bend(shoulder: float) -> float:
	return 70.0 * maxf(-sin(deg_to_rad(shoulder)), 0.0)


func _dolphin_kick(phase: float, bob: Vector3) -> Dictionary:
	var wave := sin(phase)
	var follow := sin(phase - 1.1) # The wave reaching the feet a beat later.
	return {
		"Rig": Vector3(-90.0 + wiggle * wave, 0.0, 0.0),
		"Neck": Vector3(25.0 - 0.6 * wiggle * wave, 0.0, 0.0),
		"ShoulderL": Vector3(-8.0, 0.0, -10.0),
		"ShoulderR": Vector3(-8.0, 0.0, 10.0),
		"ElbowL": Vector3(10.0, 0.0, 0.0),
		"ElbowR": Vector3(10.0, 0.0, 0.0),
		"HipL": Vector3(kick * follow, 0.0, -2.0),
		"HipR": Vector3(kick * follow, 0.0, 2.0),
		"KneeL": Vector3(-15.0 - 25.0 * maxf(sin(phase - 2.2), 0.0), 0.0, 0.0),
		"KneeR": Vector3(-15.0 - 25.0 * maxf(sin(phase - 2.2), 0.0), 0.0, 0.0),
		"lift": bob,
	}
