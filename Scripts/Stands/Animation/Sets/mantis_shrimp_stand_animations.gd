# The Mantis Shrimp Stand's animations (Still Water, the final boss's): the defaults'
# (default_stand_animations.gd) dashes and swim, but held like a mantis shrimp:
#   * Idle and flying (MantisHover): the defaults' hover, but with its clubs folded up tight in front of its
#     chest the whole time, a twitch now and then flicking one forward like a shrimp testing the water,
#     its head bobbing in quick little nods (its eyes on their stalks).
#   * Summon: no spin: it's simply there, between one frame and the next, as if time had stopped while
#     it arrived; a burst and shockwave, then it settles into its guard, shaking with menace.
#   * Hit react: its shell takes it: a short hard jolt rather than a stagger, clubs snapping up.
#   * Death: its shell cracks (impacts), it rears up clutching its head, then drops to its knees and
#     topples forward, crumbling into shards.
#   * Roar (make_roar(), for its brain's phase changes, played by its visuals on `phase_changed`): reared
#     up, clubs flung wide and back, shaking, a burst and shockwave.
# Its moves' animations (attacks, block, Stasis' tell) are in mantis_shrimp_stand_moves.gd.
# Generated by Claude Code.
class_name MantisShrimpStandAnimations
extends DefaultStandAnimations

const CLUB_GUARD := MantisShrimpStandMoves.CLUB_GUARD


func _init() -> void:
	super()
	locomotion = MantisHover.new()
	summon = make_summon_flash()
	hit_react = make_shell_jolt()
	death = make_crack_and_fall()


## The hover with its clubs folded: see the top.
class MantisHover extends StandHoverFlyAnimation:
	func _sample(time: float, motion: StandMotion) -> Dictionary:
		var frame := super._sample(time, motion)
		var t := motion.time
		var idle := 1.0 - motion.moving
		# Every few seconds one club flicks out and back.
		var flick := maxf(sin(t * 1.3), 0.0)
		flick = pow(flick, 12.0) * idle
		var right := sin(t * 0.65) > 0.0
		for side: String in ["L", "R"]:
			var turn := -1.0 if side == "L" else 1.0
			var out := flick if (side == "R") == right else 0.0
			frame["Shoulder" + side] = Vector3(lerpf(55.0, 85.0, out) - 20.0 * motion.moving, 0.0, turn * (18.0 - 6.0 * motion.moving))
			frame["Elbow" + side] = Vector3(lerpf(140.0, 20.0, out), 0.0, 0.0)
		frame["Neck"] = frame.get("Neck", Vector3.ZERO) + Vector3(4.0 * sin(t * 7.0) * idle, 6.0 * sin(t * 2.3) * idle, 0.0)
		return frame


## There in an instant: fading in over two frames with a burst and a shockwave, flung wide, then
## settling into its guard, shaking.
static func make_summon_flash() -> StandKeyframeAnimation:
	var flung := {"Rig": Vector3(12, 0, 0), "Neck": Vector3(24, 0, 0),
		"ShoulderL": Vector3(20, 0, -90), "ShoulderR": Vector3(20, 0, 90),
		"ElbowL": Vector3(30, 0, 0), "ElbowR": Vector3(30, 0, 0),
		"HipL": Vector3(0, 0, -14), "HipR": Vector3(0, 0, 14), "KneeL": Vector3(-10, 0, 0), "KneeR": Vector3(-10, 0, 0)}
	var anim := StandKeyframeAnimation.new()
	anim.duration = 1.3
	anim.blend_in = 0.0
	anim.blend_out = 0.35
	anim.events = [StandAnimation.event(0.0, "shockwave"), StandAnimation.event(0.03, "burst")]
	anim.keys = [
		StandKeyframeAnimation.key(0.0, StandAnimation.over(flung, {"fade": 0.0})),
		StandKeyframeAnimation.key(0.04, flung),
		StandKeyframeAnimation.key(0.5, StandAnimation.over(flung, {"shake": 2.0})),
		StandKeyframeAnimation.key(0.85, StandAnimation.over(CLUB_GUARD, {"shake": 2.5})),
		StandKeyframeAnimation.key(1.3, CLUB_GUARD),
	]
	return anim


## A short hard jolt: tipped back a little, head down behind its shell, clubs snapping up over its face.
static func make_shell_jolt() -> StandKeyframeAnimation:
	var jolted := StandAnimation.over(CLUB_GUARD, {"Rig": Vector3(12, 0, 0), "Neck": Vector3(-14, 0, 0),
		"ShoulderL": Vector3(100, 0, 22), "ShoulderR": Vector3(100, 0, -22),
		"ElbowL": Vector3(120, 0, 0), "ElbowR": Vector3(120, 0, 0), "lift": Vector3(0, 0, 0.08)})
	var anim := StandKeyframeAnimation.new()
	anim.duration = 0.3
	anim.blend_in = 0.02
	anim.blend_out = 0.14
	anim.keys = [
		StandKeyframeAnimation.key(0.0, {}),
		StandKeyframeAnimation.key(0.04, jolted),
		StandKeyframeAnimation.key(0.14, StandAnimation.over(jolted, {"Rig": Vector3(6, 0, 0)})),
		StandKeyframeAnimation.key(0.3, CLUB_GUARD),
	]
	return anim


## Beaten: its shell cracks, it rears up clutching its head, drops to its knees and topples forward,
## crumbling into shards. Holds its end, gone.
static func make_crack_and_fall() -> StandKeyframeAnimation:
	var rear := {"Rig": Vector3(26, 0, 0), "Neck": Vector3(35, 0, 0), "lift": Vector3(0, 0.12, 0),
		"ShoulderL": Vector3(150, 0, 30), "ShoulderR": Vector3(150, 0, -30),
		"ElbowL": Vector3(130, 0, 0), "ElbowR": Vector3(130, 0, 0),
		"HipL": Vector3(-6, 0, -6), "HipR": Vector3(-6, 0, 6), "KneeL": Vector3(-8, 0, 0), "KneeR": Vector3(-8, 0, 0), "shake": 3.0}
	var kneel := {"Rig": Vector3(-6, 0, 0), "Neck": Vector3(-25, 0, 0), "lift": Vector3(0, -0.3, 0),
		"ShoulderL": Vector3(10, 0, -25), "ShoulderR": Vector3(10, 0, 25),
		"ElbowL": Vector3(60, 0, 0), "ElbowR": Vector3(60, 0, 0),
		"HipL": Vector3(70, 0, -8), "HipR": Vector3(70, 0, 8),
		"KneeL": Vector3(-110, 0, 0), "KneeR": Vector3(-110, 0, 0)}
	var toppled := StandAnimation.over(kneel, {"Rig": Vector3(-70, 0, 0), "Neck": Vector3(-30, 0, 0), "lift": Vector3(0, -0.7, -0.25),
		"ShoulderL": Vector3(150, 0, -20), "ShoulderR": Vector3(150, 0, 20), "ElbowL": Vector3(10, 0, 0), "ElbowR": Vector3(10, 0, 0)})
	var anim := StandKeyframeAnimation.new()
	anim.duration = 2.8
	anim.blend_in = 0.04
	anim.blend_out = 0.0 # Holds its end.
	anim.events = [StandAnimation.event(0.0, "impact"), StandAnimation.event(0.25, "impact", "head"),
		StandAnimation.event(0.5, "impact"), StandAnimation.event(0.9, "burst"),
		StandAnimation.event(1.9, "shatter"), StandAnimation.event(2.3, "shatter")]
	anim.keys = [
		StandKeyframeAnimation.key(0.0, {}),
		StandKeyframeAnimation.key(0.2, rear),
		StandKeyframeAnimation.key(0.75, StandAnimation.over(rear, {"shake": 4.5})),
		StandKeyframeAnimation.key(1.1, kneel),
		StandKeyframeAnimation.key(1.6, toppled),
		StandKeyframeAnimation.key(2.0, StandAnimation.over(toppled, {"shake": 2.0})),
		StandKeyframeAnimation.key(2.8, StandAnimation.over(toppled, {"lift": Vector3(0, -0.85, -0.3), "fade": 0.0})),
	]
	return anim


## The roar as it changes phase (boss_stand_brain.gd): reared up, clubs flung wide and back, shaking.
static func make_roar() -> StandKeyframeAnimation:
	var roar := {"Rig": Vector3(18, 0, 0), "Neck": Vector3(32, 0, 0), "lift": Vector3(0, 0.2, 0),
		"ShoulderL": Vector3(-30, 0, -70), "ShoulderR": Vector3(-30, 0, 70),
		"ElbowL": Vector3(60, 0, 0), "ElbowR": Vector3(60, 0, 0),
		"HipL": Vector3(0, 0, -16), "HipR": Vector3(0, 0, 16), "KneeL": Vector3(-12, 0, 0), "KneeR": Vector3(-12, 0, 0), "shake": 4.0}
	var anim := StandKeyframeAnimation.new()
	anim.duration = 1.4
	anim.blend_in = 0.08
	anim.blend_out = 0.3
	anim.events = [StandAnimation.event(0.25, "shockwave"), StandAnimation.event(0.3, "burst")]
	anim.keys = [
		StandKeyframeAnimation.key(0.0, CLUB_GUARD),
		StandKeyframeAnimation.key(0.25, roar),
		StandKeyframeAnimation.key(1.0, roar),
		StandKeyframeAnimation.key(1.4, CLUB_GUARD),
	]
	return anim
