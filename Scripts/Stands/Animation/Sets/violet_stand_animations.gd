# Violet Stand's animations: the defaults (default_stand_animations.gd), except its backdash is a
# backflip, and it goes back with a back dive: springing off backward and arcing over head first into
# the top of its user's head from wherever it is.
# Generated by Claude Code.
class_name VioletStandAnimations
extends DefaultStandAnimations


func _init() -> void:
	super()
	dash_back = make_backflip()
	unsummon = make_dive_home()
	unsummon_returns_to_user = true


## A full backflip: a quick crouch, a tight tuck (knees to chest) through the rotation with a little
## hop, then opening out into a leaning-back landing pose. "Rig" X 0 -> 360 is one turn backward.
static func make_backflip() -> StandKeyframeAnimation:
	var tuck := {
		"Neck": Vector3(-30, 0, 0),
		"ShoulderL": Vector3(60, 0, -15), "ShoulderR": Vector3(60, 0, 15),
		"ElbowL": Vector3(90, 0, 0), "ElbowR": Vector3(90, 0, 0),
		"HipL": Vector3(95, 0, -6), "HipR": Vector3(95, 0, 6),
		"KneeL": Vector3(-130, 0, 0), "KneeR": Vector3(-130, 0, 0),
	}
	var anim := StandKeyframeAnimation.new()
	anim.duration = 0.65
	anim.blend_in = 0.04
	anim.blend_out = 0.15
	anim.keys = [
		StandKeyframeAnimation.key(0.0, {
			"Rig": Vector3(10, 0, 0), "Neck": Vector3(-10, 0, 0),
			"ShoulderL": Vector3(30, 0, -20), "ShoulderR": Vector3(30, 0, 20),
			"ElbowL": Vector3(50, 0, 0), "ElbowR": Vector3(50, 0, 0),
			"HipL": Vector3(40, 0, -5), "HipR": Vector3(40, 0, 5),
			"KneeL": Vector3(-70, 0, 0), "KneeR": Vector3(-70, 0, 0),
		}),
		StandKeyframeAnimation.key(0.12, StandAnimation.over(tuck, {"Rig": Vector3(90, 0, 0), "lift": Vector3(0, 0.3, 0)})),
		StandKeyframeAnimation.key(0.3, StandAnimation.over(tuck, {"Rig": Vector3(230, 0, 0), "lift": Vector3(0, 0.5, 0)})),
		StandKeyframeAnimation.key(0.45, {
			"Rig": Vector3(330, 0, 0), "lift": Vector3(0, 0.3, 0),
			"ShoulderL": Vector3(10, 0, -35), "ShoulderR": Vector3(10, 0, 35),
			"ElbowL": Vector3(30, 0, 0), "ElbowR": Vector3(30, 0, 0),
			"HipL": Vector3(30, 0, -5), "HipR": Vector3(30, 0, 5),
			"KneeL": Vector3(-50, 0, 0), "KneeR": Vector3(-50, 0, 0),
		}),
		StandKeyframeAnimation.key(0.65, {
			"Rig": Vector3(378, 0, 0),
			"ShoulderL": Vector3(20, 0, -30), "ShoulderR": Vector3(20, 0, 30),
			"ElbowL": Vector3(25, 0, 0), "ElbowR": Vector3(25, 0, 0),
			"HipL": Vector3(15, 0, -5), "HipR": Vector3(15, 0, 5),
			"KneeL": Vector3(-35, 0, 0), "KneeR": Vector3(-35, 0, 0),
		}),
	]
	return anim


## Goes home into its user with a back dive: it turns its back to its user and crouches, springs off
## backward arching with its head thrown back, rotates backward over the top of the arc so it comes
## down head first onto the top of the user's head, and sinks into it as it dissolves, with a burst on
## the head. "travel" carries it from its spot (0) to just above the head (1); "lift" is the arc's
## height and, below 0, how far it has sunk in. "Rig" Y 180 turns its back to the user, so tipping
## back (+X) carries it head first toward them; X 180 is straight down.
static func make_dive_home() -> StandKeyframeAnimation:
	# Arms straight out past the head and legs together, like a diver.
	var dive := {
		"ShoulderL": Vector3(170, 0, -8), "ShoulderR": Vector3(170, 0, 8),
		"ElbowL": Vector3(0, 0, 0), "ElbowR": Vector3(0, 0, 0),
		"HipL": Vector3(-4, 0, -2), "HipR": Vector3(-4, 0, 2),
		"KneeL": Vector3(-6, 0, 0), "KneeR": Vector3(-6, 0, 0),
	}
	var anim := StandKeyframeAnimation.new()
	anim.duration = 1.05
	anim.blend_in = 0.08
	anim.blend_out = 0.0 # It ends inside its user.
	anim.keys = [
		# Back to its user, crouched, arms swung forward ready to throw them back.
		StandKeyframeAnimation.key(0.0, {
			"Rig": Vector3(-10, 180, 0), "travel": 0.0, "Neck": Vector3(-10, 0, 0),
			"ShoulderL": Vector3(50, 0, -15), "ShoulderR": Vector3(50, 0, 15),
			"ElbowL": Vector3(30, 0, 0), "ElbowR": Vector3(30, 0, 0),
			"HipL": Vector3(45, 0, -5), "HipR": Vector3(45, 0, 5),
			"KneeL": Vector3(-80, 0, 0), "KneeR": Vector3(-80, 0, 0),
		}),
		# Springs off backward, arching, head thrown back and arms swinging overhead...
		StandKeyframeAnimation.key(0.15, StandAnimation.over(dive, {"Rig": Vector3(35, 180, 0), "travel": 0.05, "lift": Vector3(0, 1.0, 0),
			"Neck": Vector3(45, 0, 0), "ShoulderL": Vector3(140, 0, -15), "ShoulderR": Vector3(140, 0, 15)})),
		# ...laid out on its back at the top of the arc...
		StandKeyframeAnimation.key(0.4, StandAnimation.over(dive, {"Rig": Vector3(100, 180, 0), "travel": 0.45, "lift": Vector3(0, 3.4, 0),
			"Neck": Vector3(35, 0, 0)})),
		# ...rotating over until it points straight down over its user's head...
		StandKeyframeAnimation.key(0.6, StandAnimation.over(dive, {"Rig": Vector3(155, 180, 0), "travel": 0.85, "lift": Vector3(0, 2.8, 0),
			"Neck": Vector3(15, 0, 0)})),
		StandKeyframeAnimation.key(0.72, StandAnimation.over(dive, {"Rig": Vector3(178, 180, 0), "travel": 1.0, "lift": Vector3(0, 1.6, 0)})),
		StandKeyframeAnimation.key(0.85, StandAnimation.over(dive, {"Rig": Vector3(180, 180, 0), "travel": 1.0, "lift": Vector3(0, 0.0, 0)})),
		# ...and into it, vanishing.
		StandKeyframeAnimation.key(1.05, StandAnimation.over(dive, {"Rig": Vector3(180, 180, 0), "travel": 1.0, "lift": Vector3(0, -2.0, 0),
			"fade": 0.0, "scale": 0.7})),
	]
	anim.events = [StandAnimation.event(0.0, "shockwave"), StandAnimation.event(0.85, "burst", "target")]
	return anim
