# The animations every stand gets unless it brings its own: hovering and flying, the summon (spinning
# in while dissolving into view with a shockwave, then a roar with the fists cocked back at its sides
# and a burst), the unsummon (curling up and spinning away to nothing where it is), a dash pose per
# direction, a flinch from a hit, the death (buckling, slumping and crumbling away), and swimming with its user on
# its back: the front crawl, and the heave that throws them up out of the water. Stands with their own style extend this and replace slots in _init (see
# violet_stand_animations.gd).
# Generated by Claude Code.
class_name DefaultStandAnimations
extends StandAnimationSet

const TOSS_TIME := 0.3 ## Seconds into the swim toss (make_swim_toss()) that its user is thrown.


func _init() -> void:
	locomotion = StandHoverFlyAnimation.new()
	summon = make_summon()
	unsummon = make_unsummon()
	dash_forward = make_dash_forward()
	dash_back = make_dash_back()
	dash_left = make_dash_left()
	dash_right = make_dash_left()
	dash_right.mirrored = true
	hit_react = make_hit_react()
	death = make_death()
	swim = StandSwimAnimation.new()
	swim_toss = make_swim_toss()


## Comes up under its user in the water: crouched low with its arms scooped under them, then a heave,
## straightening up and thrusting both arms straight overhead to throw them high (the throw is at
## TOSS_TIME), holding there a beat before rolling forward into its swim.
static func make_swim_toss() -> StandKeyframeAnimation:
	var scoop := {"Rig": Vector3(14, 0, 0), "Neck": Vector3(20, 0, 0), "lift": Vector3(0, -0.35, 0),
		"ShoulderL": Vector3(45, 0, -20), "ShoulderR": Vector3(45, 0, 20),
		"ElbowL": Vector3(70, 0, 0), "ElbowR": Vector3(70, 0, 0),
		"HipL": Vector3(50, 0, -8), "HipR": Vector3(50, 0, 8),
		"KneeL": Vector3(-80, 0, 0), "KneeR": Vector3(-80, 0, 0)}
	var heave := {"Rig": Vector3(-6, 0, 0), "Neck": Vector3(30, 0, 0), "lift": Vector3(0, 0.3, 0),
		"ShoulderL": Vector3(172, 0, -12), "ShoulderR": Vector3(172, 0, 12),
		"ElbowL": Vector3(4, 0, 0), "ElbowR": Vector3(4, 0, 0),
		"HipL": Vector3(-5, 0, -4), "HipR": Vector3(-5, 0, 4),
		"KneeL": Vector3(-5, 0, 0), "KneeR": Vector3(-5, 0, 0)}
	var anim := StandKeyframeAnimation.new()
	anim.duration = 0.95
	anim.blend_in = 0.05
	anim.blend_out = 0.35
	anim.events = [StandAnimation.event(0.0, "splash"), StandAnimation.event(TOSS_TIME, "splash")]
	anim.keys = [
		StandKeyframeAnimation.key(0.0, scoop),
		StandKeyframeAnimation.key(0.18, StandAnimation.over(scoop, {"lift": Vector3(0, -0.45, 0), "Rig": Vector3(18, 0, 0)})),
		StandKeyframeAnimation.key(TOSS_TIME, heave),
		StandKeyframeAnimation.key(0.6, StandAnimation.over(heave, {"lift": Vector3(0, 0.2, 0), "Neck": Vector3(40, 0, 0)})),
		StandKeyframeAnimation.key(0.95, heave),
	]
	return anim


## Spins two turns (slowing to a stop) with arms flung out while dissolving in, then snaps into a
## shaking roar: chest out, head thrown back, elbows driven back and fists cocked at the waist.
static func make_summon() -> StandKeyframeAnimation:
	var spin := {
		"ShoulderL": Vector3(0, 0, -40), "ShoulderR": Vector3(0, 0, 40),
		"ElbowL": Vector3(15, 0, 0), "ElbowR": Vector3(15, 0, 0),
		"HipL": Vector3(0, 0, -4), "HipR": Vector3(0, 0, 4),
		"KneeL": Vector3(-10, 0, 0), "KneeR": Vector3(-10, 0, 0),
	}
	var roar := {
		"Rig": Vector3(12, 720, 0), "Neck": Vector3(28, 0, 0),
		"ShoulderL": Vector3(-45, 0, -15), "ShoulderR": Vector3(-45, 0, 15),
		"ElbowL": Vector3(100, 0, 0), "ElbowR": Vector3(100, 0, 0),
		"HipL": Vector3(0, 0, -14), "HipR": Vector3(0, 0, 14),
		"KneeL": Vector3(-12, 0, 0), "KneeR": Vector3(-12, 0, 0),
		"shake": 2.5,
	}
	var anim := StandKeyframeAnimation.new()
	anim.duration = 1.95
	anim.blend_in = 0.0
	anim.blend_out = 0.45
	anim.events = [StandAnimation.event(0.0, "shockwave"), StandAnimation.event(0.72, "burst")]
	anim.keys = [
		StandKeyframeAnimation.key(0.0, StandAnimation.over(spin, {"Rig": Vector3(0, 0, 0), "fade": 0.0})),
		StandKeyframeAnimation.key(0.15, StandAnimation.over(spin, {"Rig": Vector3(0, 300, 0), "fade": 0.25})),
		StandKeyframeAnimation.key(0.3, StandAnimation.over(spin, {"Rig": Vector3(0, 540, 0), "fade": 0.5})),
		StandKeyframeAnimation.key(0.5, StandAnimation.over(spin, {"Rig": Vector3(0, 690, 0), "fade": 0.85})),
		StandKeyframeAnimation.key(0.62, StandAnimation.over(spin, {"Rig": Vector3(0, 716, 0)})),
		StandKeyframeAnimation.key(0.72, roar),
		StandKeyframeAnimation.key(1.95, roar),
	]
	return anim


## Gathers itself (knees up, arms wrapped in), then spins faster and faster, rising, shrinking and
## dissolving away where it is, with a shockwave as it starts and a burst as it vanishes.
static func make_unsummon() -> StandKeyframeAnimation:
	var curl := {
		"Neck": Vector3(-20, 0, 0),
		"ShoulderL": Vector3(60, 0, 10), "ShoulderR": Vector3(60, 0, -10),
		"ElbowL": Vector3(110, 0, 0), "ElbowR": Vector3(110, 0, 0),
		"HipL": Vector3(35, 0, -4), "HipR": Vector3(35, 0, 4),
		"KneeL": Vector3(-50, 0, 0), "KneeR": Vector3(-50, 0, 0),
	}
	var anim := StandKeyframeAnimation.new()
	anim.duration = 0.85
	anim.blend_in = 0.12
	anim.blend_out = 0.0 # It ends gone; nothing to blend back to.
	anim.keys = [
		StandKeyframeAnimation.key(0.0, StandAnimation.over(curl, {"Rig": Vector3(0, 0, 0)})),
		StandKeyframeAnimation.key(0.25, StandAnimation.over(curl, {"Rig": Vector3(0, 40, 0)})),
		StandKeyframeAnimation.key(0.45, StandAnimation.over(curl, {"Rig": Vector3(0, 160, 0), "lift": Vector3(0, 0.2, 0)})),
		StandKeyframeAnimation.key(0.65, StandAnimation.over(curl, {"Rig": Vector3(0, 360, 0), "lift": Vector3(0, 0.45, 0),
			"fade": 0.6, "scale": 0.8})),
		StandKeyframeAnimation.key(0.85, StandAnimation.over(curl, {"Rig": Vector3(0, 620, 0), "lift": Vector3(0, 0.7, 0),
			"fade": 0.0, "scale": 0.5})),
	]
	anim.events = [StandAnimation.event(0.0, "shockwave"), StandAnimation.event(0.7, "burst")]
	return anim


## A hard dive: body pitched 65 degrees forward, head up, arms along the body, legs straight behind.
static func make_dash_forward() -> StandKeyframeAnimation:
	return _held_dash({
		"Rig": Vector3(-65, 0, 0), "Neck": Vector3(45, 0, 0),
		"ShoulderL": Vector3(-15, 0, -12), "ShoulderR": Vector3(-15, 0, 12),
		"ElbowL": Vector3(5, 0, 0), "ElbowR": Vector3(5, 0, 0),
		"HipL": Vector3(-10, 0, -2), "HipR": Vector3(-14, 0, 2),
		"KneeL": Vector3(-12, 0, 0), "KneeR": Vector3(-20, 0, 0),
	})


## Blown backward: leaning back, chin tucked, arms flung forward and legs swept up in front.
static func make_dash_back() -> StandKeyframeAnimation:
	return _held_dash({
		"Rig": Vector3(35, 0, 0), "Neck": Vector3(-25, 0, 0),
		"ShoulderL": Vector3(55, 0, -25), "ShoulderR": Vector3(55, 0, 25),
		"ElbowL": Vector3(35, 0, 0), "ElbowR": Vector3(35, 0, 0),
		"HipL": Vector3(50, 0, -6), "HipR": Vector3(35, 0, 6),
		"KneeL": Vector3(-75, 0, 0), "KneeR": Vector3(-55, 0, 0),
	})


## Leaning 40 degrees into the dash, head up and turned toward it, the leading (left) arm and leg
## tucked and the trailing ones flung out. Mirrored, it's the right dash.
static func make_dash_left() -> StandKeyframeAnimation:
	return _held_dash({
		"Rig": Vector3(0, 0, 40), "Neck": Vector3(0, 15, -25),
		"ShoulderL": Vector3(10, 0, -5), "ShoulderR": Vector3(0, 0, 70),
		"ElbowL": Vector3(70, 0, 0), "ElbowR": Vector3(15, 0, 0),
		"HipL": Vector3(15, 0, -5), "HipR": Vector3(-5, 0, 30),
		"KneeL": Vector3(-50, 0, 0), "KneeR": Vector3(-10, 0, 0),
	})


## Knocked back by a hit it didn't block: the body tips back and the head snaps back with the arms flung
## out and the knees giving a little, then it gathers itself back into its guard.
static func make_hit_react() -> StandKeyframeAnimation:
	var rocked := {"Rig": Vector3(18, 0, 0), "Neck": Vector3(28, 0, 0),
		"ShoulderL": Vector3(25, 0, -40), "ShoulderR": Vector3(25, 0, 40),
		"ElbowL": Vector3(35, 0, 0), "ElbowR": Vector3(35, 0, 0),
		"HipL": Vector3(15, 0, -5), "HipR": Vector3(10, 0, 5),
		"KneeL": Vector3(-25, 0, 0), "KneeR": Vector3(-18, 0, 0), "lift": Vector3(0, 0, 0.12)}
	var anim := StandKeyframeAnimation.new()
	anim.duration = 0.42
	anim.blend_in = 0.02
	anim.blend_out = 0.18
	anim.keys = [
		StandKeyframeAnimation.key(0.0, {}),
		StandKeyframeAnimation.key(0.06, rocked),
		StandKeyframeAnimation.key(0.2, StandAnimation.over(rocked, {"Rig": Vector3(8, 0, 0), "Neck": Vector3(10, 0, 0), "lift": Vector3(0, 0, 0.06)})),
		StandKeyframeAnimation.key(0.42, DefaultStandMoves.GUARD),
	]
	return anim


## Beaten: recoils from the last blow, the knees buckle and it drops to kneel, slumps forward with its
## head and arms hanging, trembles, then crumbles away (dissolving, shedding ink and paper shards).
## Holds its end, gone, until the stand is stored.
static func make_death() -> StandKeyframeAnimation:
	var kneel := {"Rig": Vector3(-10, 0, 0), "Neck": Vector3(-20, 0, 0), "lift": Vector3(0, -0.3, 0),
		"ShoulderL": Vector3(-5, 0, -15), "ShoulderR": Vector3(-5, 0, 15),
		"ElbowL": Vector3(15, 0, 0), "ElbowR": Vector3(15, 0, 0),
		"HipL": Vector3(70, 0, -8), "HipR": Vector3(70, 0, 8),
		"KneeL": Vector3(-110, 0, 0), "KneeR": Vector3(-110, 0, 0)}
	var slump := StandAnimation.over(kneel, {"Rig": Vector3(-30, 0, 0), "Neck": Vector3(-45, 0, 0), "lift": Vector3(0, -0.45, 0),
		"ShoulderL": Vector3(-25, 0, -8), "ShoulderR": Vector3(-25, 0, 8),
		"ElbowL": Vector3(5, 0, 0), "ElbowR": Vector3(5, 0, 0),
		"HipL": Vector3(85, 0, -8), "HipR": Vector3(85, 0, 8),
		"KneeL": Vector3(-125, 0, 0), "KneeR": Vector3(-125, 0, 0)})
	var anim := StandKeyframeAnimation.new()
	anim.duration = 2.4
	anim.blend_in = 0.04
	anim.blend_out = 0.0 # Holds its end.
	anim.events = [StandAnimation.event(0.0, "impact"), StandAnimation.event(1.6, "shatter"), StandAnimation.event(2.0, "shatter")]
	anim.keys = [
		StandKeyframeAnimation.key(0.0, {}),
		StandKeyframeAnimation.key(0.12, {"Rig": Vector3(22, 0, 0), "Neck": Vector3(30, 0, 0),
			"ShoulderL": Vector3(30, 0, -50), "ShoulderR": Vector3(30, 0, 50),
			"ElbowL": Vector3(20, 0, 0), "ElbowR": Vector3(20, 0, 0), "KneeL": Vector3(-15, 0, 0),
			"lift": Vector3(0, 0.05, 0.15)}),
		StandKeyframeAnimation.key(0.45, kneel),
		StandKeyframeAnimation.key(0.9, slump),
		StandKeyframeAnimation.key(1.25, StandAnimation.over(slump, {"shake": 3.0})),
		StandKeyframeAnimation.key(1.6, StandAnimation.over(slump, {"shake": 3.5})),
		StandKeyframeAnimation.key(2.4, StandAnimation.over(slump, {"Rig": Vector3(-38, 0, 0), "lift": Vector3(0, -0.6, 0), "shake": 1.0, "fade": 0.0})),
	]
	return anim


# A dash that snaps into `pose`, holds it through the burst and eases back out.
static func _held_dash(pose: Dictionary) -> StandKeyframeAnimation:
	var anim := StandKeyframeAnimation.new()
	anim.duration = 0.5
	anim.blend_in = 0.05
	anim.blend_out = 0.25
	anim.keys = [StandKeyframeAnimation.key(0.0, pose)]
	return anim
