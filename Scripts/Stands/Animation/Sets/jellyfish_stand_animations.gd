# The Jellyfish Stand's animations (the immortal jellyfish): the defaults' (default_stand_animations.gd)
# dashes and swim, but floating like a jellyfish:
#   * Idle and flying (JellyDrift): it hangs loose in the air, body pulsing in a slow rhythm like a bell
#     swimming (a slight squeeze and swell), arms drifting and trailing like oral arms, legs hanging and
#     sweeping behind, rising a little with every pulse.
#   * Summon: blooming out of a tiny polyp: it grows from almost nothing, curled up, and unfurls.
#   * Hit react: no flinch, it just drifts back with the hit, arms trailing forward.
#   * Revive (revive, played by its visuals on its health's `revived`: Immortal): it shrinks back down
#     into its polyp in a pale flash, trembles there, then blooms back out to full size.
#   * Death: its pulse stops; it goes slack and sinks, arms floating up, fading away into drifting light.
# Its moves' animations (Polyp Reset, Return to Zero) are in jellyfish_stand_moves.gd.
# Generated by Claude Code.
class_name JellyfishStandAnimations
extends DefaultStandAnimations

const DRIFT := JellyfishStandMoves.DRIFT

@export var revive: StandAnimation ## One-shot as it comes back from death (stand_health.gd `revived`).


func _init() -> void:
	super()
	locomotion = JellyDrift.new()
	summon = make_bloom()
	hit_react = make_drift_back()
	death = make_dissolve()
	revive = make_revive()


## The drift: see the top.
class JellyDrift extends StandHoverFlyAnimation:
	func _sample(time: float, motion: StandMotion) -> Dictionary:
		var frame := super._sample(time, motion)
		var t := motion.time
		var pulse := pow(maxf(sin(t * 2.2), 0.0), 3.0) # The bell's squeeze, a beat at a time.
		var still := 1.0 - motion.moving
		for side: String in ["L", "R"]:
			var turn := -1.0 if side == "L" else 1.0
			var sway := sin(t * 1.3 + (0.0 if side == "L" else 1.6))
			frame["Shoulder" + side] = Vector3(25.0 + 12.0 * sway - 25.0 * pulse - 30.0 * motion.moving, 0.0, turn * (18.0 + 20.0 * pulse))
			frame["Elbow" + side] = Vector3(45.0 + 15.0 * sway, 0.0, 0.0)
			frame["Hip" + side] = Vector3(10.0 - 25.0 * motion.moving + 8.0 * sin(t * 1.1 + turn), 0.0, turn * 4.0)
			frame["Knee" + side] = Vector3(-35.0 - 10.0 * pulse - 20.0 * motion.moving, 0.0, 0.0)
		frame["Neck"] = frame.get("Neck", Vector3.ZERO) + Vector3(-6.0 + 6.0 * pulse, 0.0, 0.0)
		frame["scale"] = 1.0 + 0.03 * pulse * still
		frame["lift"] = frame.get("lift", Vector3.ZERO) + Vector3(0.0, 0.06 * pulse, 0.0)
		return frame


## Blooming out of a tiny polyp: grown from almost nothing, curled up, then unfurled.
static func make_bloom() -> StandKeyframeAnimation:
	var polyp := {"Rig": Vector3(-20, 0, 0), "Neck": Vector3(-30, 0, 0), "scale": 0.1,
		"ShoulderL": Vector3(150, 0, 10), "ShoulderR": Vector3(150, 0, -10),
		"HipL": Vector3(80, 0, 0), "HipR": Vector3(80, 0, 0), "KneeL": Vector3(-130, 0, 0), "KneeR": Vector3(-130, 0, 0)}
	var open := StandAnimation.over(DRIFT, {"Neck": Vector3(20, 0, 0), "ShoulderL": Vector3(70, 0, -80), "ShoulderR": Vector3(70, 0, 80), "scale": 1.05})
	var anim := StandKeyframeAnimation.new()
	anim.duration = 1.4
	anim.blend_in = 0.0
	anim.blend_out = 0.35
	anim.events = [StandAnimation.event(0.05, "perfect"), StandAnimation.event(0.75, "shockwave")]
	anim.keys = [
		StandKeyframeAnimation.key(0.0, StandAnimation.over(polyp, {"fade": 0.0})),
		StandKeyframeAnimation.key(0.08, polyp),
		StandKeyframeAnimation.key(0.5, StandAnimation.over(polyp, {"scale": 0.5, "shake": 1.5})),
		StandKeyframeAnimation.key(0.85, open),
		StandKeyframeAnimation.key(1.4, DRIFT),
	]
	return anim


## Drifting back with a hit, arms trailing forward.
static func make_drift_back() -> StandKeyframeAnimation:
	var drifted := StandAnimation.over(DRIFT, {"Rig": Vector3(12, 0, 0), "Neck": Vector3(-14, 0, 0),
		"ShoulderL": Vector3(70, 0, -10), "ShoulderR": Vector3(70, 0, 10), "ElbowL": Vector3(10, 0, 0), "ElbowR": Vector3(10, 0, 0),
		"lift": Vector3(0, 0.05, 0.14)})
	var anim := StandKeyframeAnimation.new()
	anim.duration = 0.4
	anim.blend_in = 0.03
	anim.blend_out = 0.18
	anim.keys = [
		StandKeyframeAnimation.key(0.0, {}),
		StandKeyframeAnimation.key(0.08, drifted),
		StandKeyframeAnimation.key(0.4, DRIFT),
	]
	return anim


## Immortal: shrunk back into its polyp in a pale flash, trembling, then blooming back out.
static func make_revive() -> StandKeyframeAnimation:
	var polyp := {"Rig": Vector3(-20, 0, 0), "Neck": Vector3(-30, 0, 0), "scale": 0.3, "lift": Vector3(0, -0.3, 0),
		"ShoulderL": Vector3(150, 0, 10), "ShoulderR": Vector3(150, 0, -10),
		"HipL": Vector3(80, 0, 0), "HipR": Vector3(80, 0, 0), "KneeL": Vector3(-130, 0, 0), "KneeR": Vector3(-130, 0, 0)}
	var open := StandAnimation.over(DRIFT, {"Neck": Vector3(22, 0, 0), "ShoulderL": Vector3(70, 0, -85), "ShoulderR": Vector3(70, 0, 85), "scale": 1.08})
	var anim := StandKeyframeAnimation.new()
	anim.duration = 1.2
	anim.blend_in = 0.05
	anim.blend_out = 0.3
	anim.events = [StandAnimation.event(0.15, "perfect"), StandAnimation.event(0.75, "burst"), StandAnimation.event(0.75, "shockwave")]
	anim.keys = [
		StandKeyframeAnimation.key(0.0, {}),
		StandKeyframeAnimation.key(0.2, polyp),
		StandKeyframeAnimation.key(0.6, StandAnimation.over(polyp, {"shake": 3.0})),
		StandKeyframeAnimation.key(0.85, open),
		StandKeyframeAnimation.key(1.2, DRIFT),
	]
	return anim


## Beaten for good: its pulse stops, it goes slack and sinks, arms floating up, fading into drifting light.
## Holds its end.
static func make_dissolve() -> StandKeyframeAnimation:
	var slack := {"Rig": Vector3(14, 0, 0), "Neck": Vector3(30, 0, 0),
		"ShoulderL": Vector3(150, 0, -30), "ShoulderR": Vector3(150, 0, 30), "ElbowL": Vector3(20, 0, 0), "ElbowR": Vector3(20, 0, 0),
		"HipL": Vector3(-10, 0, -10), "HipR": Vector3(-10, 0, 10), "KneeL": Vector3(-20, 0, 0), "KneeR": Vector3(-20, 0, 0)}
	var anim := StandKeyframeAnimation.new()
	anim.duration = 2.6
	anim.blend_in = 0.06
	anim.blend_out = 0.0
	anim.events = [StandAnimation.event(0.0, "impact"), StandAnimation.event(1.0, "perfect"),
		StandAnimation.event(1.6, "perfect", "head"), StandAnimation.event(2.1, "ash")]
	anim.keys = [
		StandKeyframeAnimation.key(0.0, {}),
		StandKeyframeAnimation.key(0.4, StandAnimation.over(slack, {"shake": 1.5})),
		StandKeyframeAnimation.key(1.4, StandAnimation.over(slack, {"lift": Vector3(0, -0.5, 0)})),
		StandKeyframeAnimation.key(2.6, StandAnimation.over(slack, {"lift": Vector3(0, -0.9, 0), "fade": 0.0, "scale": 0.8})),
	]
	return anim
