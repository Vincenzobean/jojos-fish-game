# The Lobster Stand's animations: the defaults' (default_stand_animations.gd) dashes and swim, held like a
# heavy armored crusher:
#   * Idle and flying (LobsterHover): a low, heavy hover, hunched behind its claws (the crusher low and
#     forward, the pincer up), bobbing slowly like something too heavy to float, the pincer snipping at
#     the air now and then, its antennae (on its head) swaying with its head's slow sweep.
#   * Summon: it drops in from above and lands hard, a shockwave and dust, claws spread, then hunches.
#   * Hit react: its shell takes it: a short, stiff rock back, no flinch.
#   * Molt (molt, played by its visuals on its health's `molted`): it curls up, shakes, its shell bursting
#     apart (shatter), then straightens up lighter.
#   * Death: its shell cracks across in a string of impacts, it sags to its knees, claws dropping, and
#     breaks apart into shards.
# Its moves' animations are in lobster_stand_moves.gd.
# Generated by Claude Code.
class_name LobsterStandAnimations
extends DefaultStandAnimations

const GUARD_POSE := LobsterStandMoves.SHELL_GUARD_POSE

@export var molt: StandAnimation ## One-shot as it sheds its shell (stand_health.gd `molted`).


func _init() -> void:
	super()
	locomotion = LobsterHover.new()
	summon = make_heavy_landing()
	hit_react = make_shell_rock()
	death = make_crack_apart()
	molt = make_molt()


## The heavy hover: see the top.
class LobsterHover extends StandHoverFlyAnimation:
	func _sample(time: float, motion: StandMotion) -> Dictionary:
		var frame := super._sample(time, motion)
		var t := motion.time
		var idle := 1.0 - motion.moving
		var snip := pow(maxf(sin(t * 1.1), 0.0), 16.0) * idle # Now and then.
		frame["ShoulderL"] = Vector3(60.0 - 15.0 * motion.moving + 20.0 * snip, 0.0, -12.0)
		frame["ElbowL"] = Vector3(lerpf(110.0, 30.0, snip), 0.0, 0.0)
		frame["ShoulderR"] = Vector3(45.0 - 15.0 * motion.moving, 0.0, 22.0)
		frame["ElbowR"] = Vector3(70.0, 0.0, 0.0)
		frame["Rig"] = frame.get("Rig", Vector3.ZERO) + Vector3(-10.0 * idle, 0.0, 0.0)
		frame["Neck"] = frame.get("Neck", Vector3.ZERO) + Vector3(-8.0, 10.0 * sin(t * 0.7) * idle, 0.0)
		frame["lift"] = frame.get("lift", Vector3.ZERO) + Vector3(0.0, -0.06 + 0.04 * sin(t * 1.4) * idle, 0.0)
		return frame


## Dropped in from above, landing hard: claws spread wide on the landing, then hunched behind them.
static func make_heavy_landing() -> StandKeyframeAnimation:
	var landed := {"Rig": Vector3(-18, 0, 0), "Neck": Vector3(-10, 0, 0), "lift": Vector3(0, -0.2, 0),
		"ShoulderL": Vector3(30, 0, -70), "ShoulderR": Vector3(30, 0, 70),
		"ElbowL": Vector3(40, 0, 0), "ElbowR": Vector3(40, 0, 0),
		"HipL": Vector3(40, 0, -18), "HipR": Vector3(40, 0, 18), "KneeL": Vector3(-80, 0, 0), "KneeR": Vector3(-80, 0, 0)}
	var anim := StandKeyframeAnimation.new()
	anim.duration = 1.2
	anim.blend_in = 0.0
	anim.blend_out = 0.3
	anim.events = [StandAnimation.event(0.25, "shockwave"), StandAnimation.event(0.25, "dust")]
	anim.keys = [
		StandKeyframeAnimation.key(0.0, StandAnimation.over(GUARD_POSE, {"lift": Vector3(0, 2.5, 0), "fade": 0.0})),
		StandKeyframeAnimation.key(0.05, StandAnimation.over(GUARD_POSE, {"lift": Vector3(0, 2.2, 0)})),
		StandKeyframeAnimation.key(0.25, landed),
		StandKeyframeAnimation.key(0.6, StandAnimation.over(landed, {"shake": 1.5})),
		StandKeyframeAnimation.key(1.2, GUARD_POSE),
	]
	return anim


## A short, stiff rock back behind the claws.
static func make_shell_rock() -> StandKeyframeAnimation:
	var rocked := StandAnimation.over(GUARD_POSE, {"Rig": Vector3(8, 0, 0), "Neck": Vector3(-18, 0, 0),
		"ShoulderL": Vector3(95, 0, 20), "ShoulderR": Vector3(95, 0, -20), "lift": Vector3(0, 0, 0.06)})
	var anim := StandKeyframeAnimation.new()
	anim.duration = 0.28
	anim.blend_in = 0.02
	anim.blend_out = 0.12
	anim.keys = [
		StandKeyframeAnimation.key(0.0, {}),
		StandKeyframeAnimation.key(0.05, rocked),
		StandKeyframeAnimation.key(0.28, GUARD_POSE),
	]
	return anim


## The molt: curled up tight, shaking harder and harder, the old shell bursting off, then straightened up.
static func make_molt() -> StandKeyframeAnimation:
	var curled := {"Rig": Vector3(-35, 0, 0), "Neck": Vector3(-30, 0, 0), "lift": Vector3(0, -0.25, 0),
		"ShoulderL": Vector3(100, 0, 30), "ShoulderR": Vector3(100, 0, -30),
		"ElbowL": Vector3(130, 0, 0), "ElbowR": Vector3(120, 0, 0),
		"HipL": Vector3(70, 0, -8), "HipR": Vector3(70, 0, 8), "KneeL": Vector3(-110, 0, 0), "KneeR": Vector3(-110, 0, 0)}
	var burst := {"Rig": Vector3(16, 0, 0), "Neck": Vector3(24, 0, 0), "lift": Vector3(0, 0.15, 0),
		"ShoulderL": Vector3(20, 0, -85), "ShoulderR": Vector3(20, 0, 85),
		"ElbowL": Vector3(20, 0, 0), "ElbowR": Vector3(20, 0, 0)}
	var anim := StandKeyframeAnimation.new()
	anim.duration = 1.3
	anim.blend_in = 0.06
	anim.blend_out = 0.3
	anim.events = [StandAnimation.event(0.55, "shatter"), StandAnimation.event(0.6, "burst"), StandAnimation.event(0.6, "shockwave")]
	anim.keys = [
		StandKeyframeAnimation.key(0.0, GUARD_POSE),
		StandKeyframeAnimation.key(0.2, curled),
		StandKeyframeAnimation.key(0.55, StandAnimation.over(curled, {"shake": 5.0})),
		StandKeyframeAnimation.key(0.65, burst),
		StandKeyframeAnimation.key(0.95, burst),
		StandKeyframeAnimation.key(1.3, GUARD_POSE),
	]
	return anim


## Beaten: its shell cracks across, it sags to its knees, claws dropping, and breaks apart. Holds its end.
static func make_crack_apart() -> StandKeyframeAnimation:
	var stiff := StandAnimation.over(GUARD_POSE, {"Rig": Vector3(10, 0, 0), "Neck": Vector3(20, 0, 0), "shake": 3.0})
	var kneel := {"Rig": Vector3(-10, 0, 0), "Neck": Vector3(-35, 0, 0), "lift": Vector3(0, -0.35, 0),
		"ShoulderL": Vector3(0, 0, -10), "ShoulderR": Vector3(0, 0, 10),
		"ElbowL": Vector3(10, 0, 0), "ElbowR": Vector3(10, 0, 0),
		"HipL": Vector3(75, 0, -8), "HipR": Vector3(75, 0, 8), "KneeL": Vector3(-115, 0, 0), "KneeR": Vector3(-115, 0, 0)}
	var anim := StandKeyframeAnimation.new()
	anim.duration = 2.5
	anim.blend_in = 0.04
	anim.blend_out = 0.0
	anim.events = [StandAnimation.event(0.0, "impact"), StandAnimation.event(0.2, "impact", "head"),
		StandAnimation.event(0.4, "impact", "R"), StandAnimation.event(0.6, "impact", "L"),
		StandAnimation.event(1.5, "shatter"), StandAnimation.event(1.9, "shatter")]
	anim.keys = [
		StandKeyframeAnimation.key(0.0, {}),
		StandKeyframeAnimation.key(0.15, stiff),
		StandKeyframeAnimation.key(0.7, StandAnimation.over(stiff, {"shake": 4.5})),
		StandKeyframeAnimation.key(1.2, kneel),
		StandKeyframeAnimation.key(1.8, StandAnimation.over(kneel, {"shake": 2.0})),
		StandKeyframeAnimation.key(2.5, StandAnimation.over(kneel, {"lift": Vector3(0, -0.5, 0), "fade": 0.0})),
	]
	return anim
