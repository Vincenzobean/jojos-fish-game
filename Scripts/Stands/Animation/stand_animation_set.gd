# Which animations one stand uses: a slot per thing a stand does. The animation player
# (stand_body_visuals.gd) has one of these as its `animations`, so each stand scene can bring its own
# set while sharing the same body. Any StandAnimation fits any slot.
#
# Most stands will start from DefaultStandAnimations (default_stand_animations.gd) and replace only
# what makes them different, like VioletStandAnimations (violet_stand_animations.gd) does with its
# backflip. A set can also be made in the editor as a resource and filled in slot by slot.
# Generated by Claude Code.
class_name StandAnimationSet
extends Resource

@export var locomotion: StandAnimation ## Continuous: hovering and flying.
@export var summon: StandAnimation ## One-shot, as the stand appears.
@export var unsummon: StandAnimation ## One-shot, as the stand goes back; it's stored when this ends.
## The unsummon flies the stand back into its user ("travel"), so the camera turns to watch the user.
@export var unsummon_returns_to_user := false
@export var hit_react: StandAnimation ## One-shot, flinching from a hit it didn't block (stand_health.gd).
@export var death: StandAnimation ## One-shot, as it's beaten; holds its end until the stand is stored.
@export_group("Swimming")
@export var swim: StandAnimation ## Continuous, instead of locomotion while it swims carrying its user (stand_ride.gd).
@export var swim_toss: StandAnimation ## One-shot: coming up under its user in the water and heaving them into the air.
@export_group("Dashes")
@export var dash_forward: StandAnimation
@export var dash_back: StandAnimation
@export var dash_left: StandAnimation
@export var dash_right: StandAnimation


## The dash animation for a dash heading along `local_direction`, in the stand's own frame (-Z
## forward): whichever of the four directions it's closest to.
func dash_for(local_direction: Vector3) -> StandAnimation:
	if absf(local_direction.x) > absf(local_direction.z):
		return dash_right if local_direction.x > 0.0 else dash_left
	return dash_back if local_direction.z > 0.0 else dash_forward
