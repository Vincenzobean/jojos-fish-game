# How a stand is moving this frame, handed to every stand animation (stand_animation.gd) so animations
# never have to read the stand themselves. Filled in by the animation player (stand_body_visuals.gd).
# Directions are in the stand's own frame and scaled to its normal flying speed, so they read the same
# for any stand.
# Generated by Claude Code.
class_name StandMotion
extends RefCounted

var time := 0.0 ## Seconds since the stand appeared; for looping motion like bobbing.
var forward := 0.0 ## Forward speed, -1 (full speed backward) to 1 (full speed forward).
var side := 0.0 ## Sideways speed, -1 (full speed left) to 1 (full speed right).
var falling := 0.0 ## Downward speed, 0 to 1.
var moving := 0.0 ## Horizontal speed in any direction, 0 to 1.
var body_scale := 1.0 ## The stand body's size (stand_body.gd), for animating distances.
var stroke := 0.0 ## Swimming strokes so far (in cycles), quickening the faster it swims; for keeping swim strokes in time.
