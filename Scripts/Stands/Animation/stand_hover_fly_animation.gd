# Continuous stand locomotion, worked out from how the stand moves rather than keyframed:
#   * hovering: a deep, slow bob with the body rocking and turning a little, and arms and legs that
#     float up and settle a beat behind the bob (one knee bent more than the other);
#   * flying: the body leans into its travel and banks when strafing, arms sweep back and legs trail
#     behind with the knees bent; falling bends the knees a little more.
# Hovering fades out as the stand picks up speed. All the amounts are exports, so a stand can float
# lazily or hold itself stiffly just by tuning them.
# Generated by Claude Code.
class_name StandHoverFlyAnimation
extends StandAnimation

@export_group("Hover")
@export var bob_height := 0.12 ## Meters the body bobs up and down, before the body's scale...
@export var bob_speed := 1.6 ## ...at this many radians per second.
@export var rock := 6.0 ## Degrees the body rocks back and forth and side to side...
@export var turn := 8.0 ## ...and slowly turns from side to side.
@export var swing := 10.0 ## Degrees the arms and legs float and swing.

@export_group("Flying")
@export var lean := 25.0 ## Degrees forward at full flying speed...
@export var bank := 15.0 ## ...and sideways when strafing.


func _sample(_time: float, motion: StandMotion) -> Dictionary:
	var t := motion.time
	var moving := motion.moving
	var forward := motion.forward
	var falling := motion.falling
	# The limbs follow the bob a beat late (`lag`), so they float up as the body sinks and hang as it
	# rises, and a slower `drift` rocks and turns the whole body.
	var idle := 1.0 - moving
	var wave := sin(t * bob_speed)
	var lag := sin(t * bob_speed - 0.9) * idle
	var drift := sin(t * bob_speed * 0.45) * idle
	var twist := turn * sin(t * bob_speed * 0.3) * idle
	return {
		"Rig": Vector3(-lean * forward + rock * drift, twist, -bank * motion.side + rock * 0.6 * lag),
		"Neck": Vector3(12.0 * forward - 5.0 * lag, -0.5 * twist, 0.0),
		"ShoulderL": Vector3(-25.0 * moving + 0.5 * swing * drift, 0.0, -12.0 - 6.0 * moving - swing * lag),
		"ShoulderR": Vector3(-25.0 * moving - 0.5 * swing * drift, 0.0, 12.0 + 6.0 * moving + swing * lag),
		"ElbowL": Vector3(22.0 + 5.0 * moving + swing * lag, 0.0, 0.0),
		"ElbowR": Vector3(22.0 + 5.0 * moving + swing * lag, 0.0, 0.0),
		"HipL": Vector3(8.0 - 23.0 * moving + swing * lag, 0.0, -3.0),
		"HipR": Vector3(-5.0 - 15.0 * moving - 0.7 * swing * lag, 0.0, 3.0),
		"KneeL": Vector3(-30.0 - 15.0 * moving - 15.0 * falling - 1.4 * swing * lag, 0.0, 0.0),
		"KneeR": Vector3(-12.0 - 28.0 * moving - 15.0 * falling + 0.8 * swing * lag, 0.0, 0.0),
		"lift": Vector3.UP * wave * bob_height * motion.body_scale * (1.0 - 0.6 * moving),
	}
