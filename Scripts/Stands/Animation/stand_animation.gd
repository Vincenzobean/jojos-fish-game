# Base class for every stand animation: the interface the animation player (stand_body_visuals.gd)
# drives. An animation is a Resource, so stands can share, swap and save them (see
# stand_animation_set.gd for how a stand picks its animations).
#
# Each frame the player asks evaluate(time, motion) for a frame: a Dictionary of
#   * pivot name -> Vector3 of joint angles in degrees, for any of PIVOTS (missing ones are 0);
#   * optional channels: "fade" (float, 0 invisible to 1 solid; 1 if missing), "scale" (float, the
#     whole body's size; 1 if missing), "shake" (float, degrees
#     the head and shoulders tremble), "lift" (Vector3, meters the whole body is moved, e.g. a bob) and
#     "travel" (float): when present the body leaves its spot and flies toward the stand's target (the
#     player it returns to), 0 where it started and 1 at the target, facing the target, with "lift"
#     then measured straight up in the world. Used by unsummons that fly back into the user.
#   * the stand's floating companion (floating_companion.gd, like the Dolphin's pufferfish), all 0 if
#     missing: "companion_weight" (0 floating at its shoulder as usual, 1 held where the animation
#     says), "companion_anchor" (where it's held: 0 the left fist, 1 the right fist, 2 the right foot,
#     3 a body length out in front; in between, gliding from one to the next), "companion_head" (0 to
#     1 moves that spot onto the top of the head, the Dolphin's blowhole), "companion_out" (how
#     far it's sent from there toward the spot a body length out in front: 0 at the anchor, 1 out
#     there, above 1 further; switch the anchor while it's out to bring it back to another limb),
#     "companion_lift" (meters above that, for tossing it in an arc) and "companion_scale" (1 if
#     missing; above 1 puffs it up).
#   * tentacles (stand_body.gd tentacles, the Squid's, growing from its upper back): the Tentacle pivots
#     swing them like limbs (standing up from the back at rest, which a pose that sets them replaces; about 105
#     X brings them up over the shoulders to point ahead), "tentacle_reach" (0 if missing) stretches
#     the upper (F) pair, 1 about two body lengths long, and "tentacle_curl" (0 if missing; degrees per
#     segment) bends every segment of all four on along their swing (a tentacle pointing ahead curls up)
#     or, negative, back against it (curling down round something grabbed from above).
# Angles are about the stand rig's axes: +X swings a hanging limb forward (the body faces -Z), so a
# negative X trails it back, and +X on "Rig" tips the whole body back (a backflip is "Rig" X going
# 0 -> 360); Z swings arms and legs out to the sides; Y twists. Rig angles may go past 360 for spins.
#
# Two kinds of animation:
#   * continuous (duration 0): locomotion, sampled every frame forever, reacting to `motion`;
#   * one-shot (duration > 0): summons, dashes, flips. They blend in over blend_in, play for
#     `duration` seconds in all (blend_out included) and blend back out over the last blend_out.
#
# `events` fire effects (stand_effects.gd) at set times: each is {"time": seconds, "effect": a name from
# StandEffects, "at": "stand" (where the body is drawn), "target" (the stand's target) or "companion" (where the animation
# holds its floating companion)}. A sound event ({"time", "sound": an AudioStream, "from": seconds into
# it to start}, see sound()) plays a sound from the stand instead. Keep `events` in time order.
#
# To make a new kind, extend this and override _sample(). With `mirrored` on, the frame is flipped left
# to right, so for example a right dash can just be the left dash mirrored.
# Generated by Claude Code.
class_name StandAnimation
extends Resource

const PIVOTS: Array[String] = ["Rig", "Neck", "ShoulderL", "ShoulderR", "ElbowL", "ElbowR", "HipL", "HipR", "KneeL", "KneeR",
	"TentacleFL", "TentacleFR", "TentacleBL", "TentacleBR"] # The tentacles only exist on stands that have them.

@export var duration := 0.0 ## Seconds a one-shot plays, blend out included; 0 for continuous.
@export var blend_in := 0.05 ## Seconds to blend in from whatever was playing.
@export var blend_out := 0.25 ## Seconds to blend back out at the end.
@export var mirrored := false ## Play flipped left to right.
@export var events: Array[Dictionary] = [] ## Effects fired at set times, see above.
@export_group("Holding")
## While the animation is played held (the block, a barrage), its time stays between these: equal
## holds that pose, apart loops the stretch between them. Once released it plays on from loop_end to
## the end. -1 for animations that are never held.
@export var loop_start := -1.0
@export var loop_end := -1.0
@export var afterimages := false ## Leave fading afterimages while it plays, like a dash (a barrage's flurry of arms).


## The frame at `time` seconds in, given how the stand is moving.
func evaluate(time: float, motion: StandMotion) -> Dictionary:
	var frame := _sample(time, motion)
	return mirror(frame) if mirrored else frame


## How strongly this animation shows at `time` seconds in: ramps up over blend_in and, for one-shots,
## back down over the last blend_out.
func weight_at(time: float) -> float:
	var weight := clampf(time / blend_in, 0.0, 1.0) if blend_in > 0.0 else 1.0
	if duration > 0.0 and blend_out > 0.0:
		weight = minf(weight, clampf((duration - time) / blend_out, 0.0, 1.0))
	return weight


## Whether it can be held (see loop_start and loop_end).
func can_hold() -> bool:
	return loop_start >= 0.0 and loop_end >= loop_start


## The time to show `time` seconds into a held play: wrapped round the loop, or stopped at its pose.
func held_time(time: float) -> float:
	if not can_hold() or time < loop_end:
		return time
	var span := loop_end - loop_start
	return loop_start + fmod(time - loop_end, span) if span > 0.0 else loop_end


## Whether a one-shot has finished.
func is_finished(time: float) -> bool:
	return duration > 0.0 and time >= duration


## Override: the frame at `time` seconds in.
func _sample(_time: float, _motion: StandMotion) -> Dictionary:
	return {}


## A frame flipped left to right: left and right pivots swap, and sideways swings and twists change sign.
static func mirror(frame: Dictionary) -> Dictionary:
	var flipped := {}
	for key: String in frame:
		var value: Variant = frame[key]
		var other := key
		if key in PIVOTS and key.ends_with("L"):
			other = key.trim_suffix("L") + "R"
		elif key in PIVOTS and key.ends_with("R"):
			other = key.trim_suffix("R") + "L"
		if key in PIVOTS:
			value = Vector3(value.x, -value.y, -value.z)
		elif key == "lift":
			value = Vector3(-value.x, value.y, value.z)
		flipped[other] = value
	return flipped


## An effect event for `events`: `effect` (a StandEffects name) at `time` seconds, placed at "stand",
## "target", "companion", "head" (its top) or "out" (a body length in front); `toward` aims effects that
## go somewhere (a jet), in the stand's own space (-Z ahead), in body lengths at scale 1.
static func event(time: float, effect: String, at := "stand", toward := Vector3.ZERO) -> Dictionary:
	var made := {"time": time, "effect": effect, "at": at}
	if toward != Vector3.ZERO:
		made["toward"] = toward
	return made


## A sound event for `events`: `stream` played from the stand at `time` seconds, starting `from` seconds
## into it.
static func sound(time: float, stream: AudioStream, from := 0.0) -> Dictionary:
	return {"time": time, "sound": stream, "from": from}


## Adds `event` to `events`, keeping them in time order.
func add_event(event: Dictionary) -> void:
	var i := 0
	while i < events.size() and float(events[i]["time"]) <= float(event["time"]):
		i += 1
	events.insert(i, event)


## `pose` with `extra` laid over it (extra's pivots and channels win).
static func over(pose: Dictionary, extra: Dictionary) -> Dictionary:
	var merged := pose.duplicate()
	merged.merge(extra, true)
	return merged
