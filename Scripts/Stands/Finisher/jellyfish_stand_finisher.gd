# The Jellyfish Stand's finisher, Never Reach the Truth: the shared opening, slam and pose
# (stand_finisher.gd), but where others throw a barrage it sends its user back to zero, again and again:
#
#   A sting and a pulse blast the user away ("ZAP"), but before they're gone the world snaps back
#   (impact frame, "...?"): they're right where they started, unhurt, the blow still coming. It happens
#   again, and again, each loop a little faster, the user never getting past that moment. On the last
#   loop it lets them go on ("You will never reach the truth."), and they fall into the slam.
# Generated by Claude Code.
class_name JellyfishStandFinisher
extends StandFinisher

@export var loops := 3 ## Times the user is sent back.
@export var gold := Color(1.0, 0.86, 0.45) ## Lettering colour: Return to Zero's gold-white.


func _init() -> void:
	barrage_cries = ["ZAP", "...?", "ZAP!", "...again?!"]
	hammer_cry = "You will never reach the truth."


func _finish(d: FinisherDirector) -> void:
	d.step("finish")
	var forward := d.stand_facing()
	var side := forward.cross(Vector3.UP).normalized()
	var start := d.user_at()
	var moves := JellyfishStandMoves.new()
	d.user_state(UserState.FLYING, false)
	d.cut(d.user_mid() + side * 6.0 + Vector3.UP * 0.5, (d.stand_at() + d.user_mid()) * 0.5, 50.0)

	for i in loops:
		var pace := 1.0 - 0.2 * i
		# The blow.
		d.step("loop %d" % (i + 1))
		d.pose(moves.heavy.animation, false)
		await d.wait(0.36 * pace)
		d.user.hit()
		d.effect("burst", d.user_mid(), 0.8)
		d.effect("shockwave", d.user_mid(), 0.6)
		d.shake(0.6)
		d.sfx(barrage_cries[0 if i < loops - 1 else 2], d.user_mid() + Vector3.UP * 1.2 + side * 0.8, gold, 0.85)
		d.user_state(UserState.FLYING, true)
		await d.move_user(start + forward * 3.5 + Vector3.UP * 1.0, 0.3 * pace, Tween.TRANS_CUBIC, Tween.EASE_OUT)
		# ...and back to zero.
		d.impact_frame(d.user_mid(), 2, true)
		d.effect("perfect", d.user_mid(), 1.0)
		d.user.global_position = start
		d.user_state(UserState.FLYING, false)
		d.effect("poof", d.user_mid(), 0.8)
		d.sfx(barrage_cries[1 if i < loops - 1 else 3], d.user_mid() + Vector3.UP * 1.4 - side * 0.9, Color(0.95, 0.95, 1.0), 0.7)
		d.cut(d.user_mid() + side * (5.0 - i) - forward * 1.0 + Vector3.UP * 0.4, d.user_mid(), 50.0 - 4.0 * i)
		await d.wait(0.45 * pace)

	# Let go at last: the truth they'll never reach.
	d.step("truth")
	d.cut(d.stand_at() + side * 7.5 - forward * 1.0 + Vector3.UP * 1.2, (d.stand_at() + d.user_mid()) * 0.5, 55.0)
	d.pose(moves.specials[moves.specials.size() - 1].animation, false) # Return to Zero's open arms.
	await d.wait(0.5)
	d.user.hit()
	d.user_state(UserState.FLYING, true)
	d.effect("shockwave", d.stand_at(), 1.2)
	d.effect("burst", d.user_mid(), 1.0)
	d.impact_frame(d.user_mid(), 4)
	d.slowmo(0.25, 1.0)
	d.shake(1.2)
	d.sfx(hammer_cry, d.user_mid() + Vector3.UP * 1.8, gold, 0.6)
	await d.move_user(d.user_at() + forward * 2.0 + Vector3.UP * 2.0, 0.4, Tween.TRANS_CUBIC, Tween.EASE_OUT)
