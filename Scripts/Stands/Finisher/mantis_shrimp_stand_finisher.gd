# The Mantis Shrimp Stand's finisher, Final Second: the shared opening, slam and pose (stand_finisher.gd),
# but where others throw a barrage, it stops time (time_stop.gd, just for the look: there's nothing left to
# freeze) with its user hanging in the air in front of it:
#
#   Its arms fly wide and the world goes grey. It hangs there, in no hurry, then lets loose: its clubs a
#   blur round the frozen user, every blow leaving a glowing star hanging in the air where it struck and
#   the user not moving an inch ("CRACK CRACK..."). It drifts back, folds its clubs and gives the moment a
#   last look ("...and time moves again."), then time moves: every star bursts at once (impact frame,
#   "KRAKOOOM!"), and the user is blasted up and away, falling into the slam.
# Generated by Claude Code.
class_name MantisShrimpStandFinisher
extends StandFinisher

@export var frozen_time := 3.4 ## Seconds time stays stopped.
@export var blows := 28 ## Frozen blows thrown.


func _init() -> void:
	barrage_cries = ["CRACK", "CRACK", "CRACK!", "KRAK"]
	hammer_cry = "KRAKOOOM!"


func _finish(d: FinisherDirector) -> void:
	d.step("finish")
	var forward := d.stand_facing()
	var side := forward.cross(Vector3.UP).normalized()
	d.user_state(UserState.FLYING, false)

	# Time stops.
	d.step("stasis")
	d.pose(MantisShrimpStandMoves.make_stasis().animation)
	d.cut(d.stand_at() - forward * 3.0 + side * 2.6 + Vector3.UP * 0.8, (d.stand_at() + d.user_mid()) * 0.5, 55.0)
	await d.wait(MantisShrimpStandMoves.TimeStopMove.STASIS_AT)
	var stop := TimeStop.begin(d.stand, frozen_time, false)
	var marks: Node = stop.get_node("Visuals") if stop else null
	d.impact_frame(d.stand_at(), 2, false)
	d.sfx("STASIS", d.stand_at() + Vector3.UP * 1.5 + side * 1.0, Color(0.55, 1.0, 0.8), 1.0)
	await d.wait(0.5)

	# The frozen barrage: the user doesn't move; every blow hangs in the air.
	var moves: StandMoveSet = d.stand.get_moves() if d.stand.has_method("get_moves") else MantisShrimpStandMoves.new()
	d.pose(moves.barrage.animation, true)
	var center := (d.stand_at() + d.user_mid()) * 0.5
	var orbit := [0.0]
	var around := func() -> Vector3:
		var angle: float = orbit[0]
		return center + (side * cos(angle) + forward * sin(angle)) * 6.0 + Vector3.UP * 0.9
	d.shot(around, func() -> Vector3: return (d.stand_at() + d.user_mid()) * 0.5, 0.3, 55.0)
	var swing_time := blows * 0.06
	var tween := d.create_tween()
	tween.tween_method(func(angle: float) -> void: orbit[0] = angle, -0.5, PI * 0.5, swing_time)
	for i in blows:
		var at := d.user_mid() + Vector3(randf_range(-0.35, 0.35), randf_range(-0.5, 0.5), randf_range(-0.3, 0.3))
		if marks:
			marks.mark(at)
		if i % 4 == 0:
			d.sfx(barrage_cries[(i / 4) % barrage_cries.size()], at + side * randf_range(-1.6, 1.6) + Vector3.UP * randf_range(0.6, 1.6),
				Color(0.55, 1.0, 0.8), randf_range(0.6, 0.85))
		await d.wait(0.06)

	# Stepping back, clubs folded, a last look.
	d.step("resume")
	d.pose(make_pose(MantisShrimpStandMoves.CLUB_GUARD, 0.15), true)
	await d.move_stand(d.stand_at() - forward * d.stand_size * 0.4, 0.35)
	d.cut(d.stand_at() + forward * 2.5 + side * 1.8 + Vector3.UP * 0.6, d.stand_at() + Vector3.UP * 0.4, 40.0)
	await d.wait(0.6)

	# Time moves: every blow lands at once.
	if stop:
		stop.cancel()
	d.cut(d.user_mid() + side * 6.5 + Vector3.UP * 0.4, d.user_mid, 60.0)
	for i in 5:
		d.user.hit()
	d.user_state(UserState.FLYING, true)
	d.effect("burst", d.user_mid(), 0.9)
	d.effect("shockwave", d.user_mid(), 0.8)
	d.impact_frame(d.user_mid(), 4)
	d.slowmo(0.25, 0.8)
	d.shake(1.4)
	d.sfx(hammer_cry, d.user_mid() + Vector3.UP * 1.6, Color(0.55, 1.0, 0.8), 1.2)
	await d.move_user(d.user_at() + Vector3.UP * 4.0 + forward * 3.0, 0.5, Tween.TRANS_CUBIC, Tween.EASE_OUT)
