# The Dolphin Stand's finisher: the shared opening, slam and pose (stand_finisher.gd), but instead of a
# barrage it spouts its pufferfish (floating_companion.gd) into the user like a whale's spray:
#
#   It drops beneath the user and reaches up to take the pufferfish from beside its shoulder, sets it on its
#   blowhole on top of its head, where it puffs up, and gathers itself, trembling, the air going heavy
#   ("GOGOGO"). Then it throws its head back and arms wide and the blowhole blasts a jet of water straight up
#   into the user, the pufferfish riding it at speed into them (impact frame, "SPLASH!"), blasting them
#   higher still. It leaps after them in a dolphin's spinning jump, arcs over the top and dives
#   head-first, ramming them down into the slam.
# Generated by Claude Code.
class_name DolphinStandFinisher
extends StandFinisher


func _init() -> void:
	hammer_cry = "SPLAAASH!"


func _finish(d: FinisherDirector) -> void:
	d.step("finish")
	var forward := d.stand_facing()
	var side := forward.cross(Vector3.UP).normalized()

	# Beneath the user, reaching up for the pufferfish.
	var below := d.user_mid() - Vector3.UP * d.stand_size * 0.95 - forward * 0.25
	d.pose(make_reach_up(), true)
	d.move_stand(below, 0.45)
	d.cut(below + side * 4.5 + forward * 1.5 + Vector3.UP * 0.9, func() -> Vector3: return d.visuals.head_top(), 45.0)
	await d.wait(0.4)
	d.companion_to(func() -> Vector3: return d.visuals.fist("R"))
	await d.wait(0.45)

	# Set on the blowhole, puffing up; the stand gathers itself.
	d.step("blowhole")
	d.pose(make_set_on_head(), true)
	await d.wait(0.35)
	d.companion_to(func() -> Vector3: return d.visuals.head_top() + Vector3.UP * 0.22, 1.4)
	d.visuals.companion_flash(0.8)
	d.shot(d.stand_at() + side * 2.4 + forward * 1.6 + Vector3.UP * 1.6, func() -> Vector3: return d.visuals.head_top(), 0.45, 40.0)
	await d.wait(0.6)
	d.pose(make_spout(), true)
	d.sfx("GOGOGO", d.stand_at() + side * 1.4 + Vector3.UP * 0.6, Color(0.75, 0.55, 1.0), 0.7)
	for i in 7:
		d.effect("gather", d.visuals.head_top(), 0.6)
		d.shake(0.2)
		await d.wait(0.1)

	# The jet: the pufferfish rides it up into the user.
	d.step("jet")
	var from: Vector3 = d.visuals.head_top()
	var hit_at := d.user_mid()
	d.effect("water_jet", from, 1.0, hit_at - from + Vector3.UP * 1.5)
	d.effect("sonic_boom", from, 0.4, Vector3.UP)
	d.cut(from + side * 6.0 - forward * 1.0 + Vector3.UP * 1.0, (from + hit_at) * 0.5, 60.0)
	var ride := [0.0]
	d.companion_to(func() -> Vector3: return from.lerp(d.user_mid(), ride[0]), 1.6)
	var tween := d.create_tween()
	tween.tween_method(func(t: float) -> void: ride[0] = t, 0.0, 1.0, 0.2).set_ease(Tween.EASE_IN)
	await tween.finished
	d.user.hit()
	d.visuals.companion_flash(1.0)
	d.effect("splash", d.user_mid(), 0.5)
	d.effect("burst", d.user_mid(), 0.6)
	d.impact_frame(d.user_mid(), 4)
	d.slowmo(0.2, 0.9)
	d.shake(1.0)
	d.sfx("SPLASH!", d.user_mid() + Vector3.UP * 1.4 + side * 0.6, Color(0.55, 0.85, 1.0), 1.0)
	# Blasted higher, the pufferfish carried up with them a moment before it heads home.
	d.user_state(UserState.FLYING, true)
	d.cut(d.user_mid() + side * 7.0 + Vector3.UP * 0.5, d.user_mid, 55.0)
	d.companion_to(func() -> Vector3: return d.user_mid() - Vector3.UP * 0.4, 1.4)
	await d.move_user(d.user_at() + Vector3.UP * 5.0, 0.7, Tween.TRANS_CUBIC, Tween.EASE_OUT)
	d.companion_free()
	d.face_stand(forward)
	await _dive(d)


## Reaching up and across for the pufferfish by its right shoulder, looking up at the user.
static func make_reach_up() -> StandKeyframeAnimation:
	return make_pose(DefaultStandMoves.on_guard({"Rig": Vector3(5, -10, 0), "Neck": Vector3(30, 0, 0),
		"ShoulderR": Vector3(80, 0, 55), "ElbowR": Vector3(60, 0, 0)}), 0.08)


## The right hand up over its head, setting the pufferfish on the blowhole.
static func make_set_on_head() -> StandKeyframeAnimation:
	return make_pose(DefaultStandMoves.on_guard({"Rig": Vector3(5, 0, 0), "Neck": Vector3(-10, 0, 0),
		"ShoulderR": Vector3(165, 0, 15), "ElbowR": Vector3(100, 0, 0)}), 0.08)


## Spouting: head thrown back, chest up, arms flung wide and knees bent, braced like a whale breaching.
static func make_spout() -> StandKeyframeAnimation:
	return make_pose({"Rig": Vector3(12, 0, 0), "Neck": Vector3(-25, 0, 0), "shake": 2.0,
		"ShoulderL": Vector3(20, 0, -75), "ShoulderR": Vector3(20, 0, 75),
		"ElbowL": Vector3(25, 0, 0), "ElbowR": Vector3(25, 0, 0),
		"HipL": Vector3(25, 0, -10), "HipR": Vector3(25, 0, 10), "KneeL": Vector3(-45, 0, 0), "KneeR": Vector3(-45, 0, 0)}, 0.06)


# The last blow: leaping past the user in a dolphin's spinning jump, arcing over the top to hang upside
# down above them, then diving head-first and ramming them with the top of its head, down into the slam.
func _dive(d: FinisherDirector) -> void:
	d.step("dive")
	var forward := d.stand_facing()
	var side := forward.cross(Vector3.UP).normalized()
	d.pose(make_dolphin_rise(), true)
	d.effect("sonic_boom", d.stand_at(), 0.6, Vector3.UP)
	d.shot(func() -> Vector3: return d.stand_at() + side * 7.0 + Vector3.UP * 0.5, d.stand_at, 0.3, 55.0)
	var above := d.user_mid() + Vector3.UP * d.stand_size * 0.9 - forward * d.stand_size * 0.15
	await d.move_stand(above, 0.5, Tween.TRANS_CUBIC, Tween.EASE_OUT)
	# Over the top, head down, hanging there a moment.
	d.pose(make_dive(), true)
	d.shot(d.user_mid() + side * 6.0 + Vector3.UP * 2.0, (d.stand_at() + d.user_mid()) * 0.5, 0.4, 50.0)
	await d.wait(0.45)
	d.effect("sonic_boom", d.stand_at(), 0.5, Vector3.DOWN)
	await land_on_user(d, d.visuals.head_top, 0.14)
	d.user.hit()
	d.user_state(UserState.FLYING, true)
	d.effect("burst", d.user_mid() + Vector3.UP * 0.4, 0.7)
	d.effect("splash", d.user_mid() + Vector3.UP * 0.4, 0.4)
	d.impact_frame(d.user_mid(), 4)
	d.slowmo(0.2, 0.9)
	d.shake(1.0)
	d.sfx(hammer_cry, d.user_mid() + Vector3.UP * 1.6, Color(0.55, 0.85, 1.0), 1.1)
	await d.wait(0.25)


## The Dolphin's way up after the user: a dolphin's spinning leap, arms tight to its sides, legs together
## like a tail, chin up, twisting round twice as it rises.
func rise_pose() -> StandAnimation:
	return make_dolphin_rise()


static func make_dolphin_rise() -> StandKeyframeAnimation:
	var streamlined := {"Neck": Vector3(20, 0, 0),
		"ShoulderL": Vector3(-5, 0, -4), "ShoulderR": Vector3(-5, 0, 4),
		"ElbowL": Vector3(0, 0, 0), "ElbowR": Vector3(0, 0, 0),
		"HipL": Vector3(-8, 0, -2), "HipR": Vector3(-8, 0, 2), "KneeL": Vector3(-6, 0, 0), "KneeR": Vector3(-6, 0, 0)}
	var anim := StandKeyframeAnimation.new()
	anim.duration = 60.0
	anim.blend_in = 0.06
	anim.blend_out = 0.2
	anim.afterimages = true
	anim.keys = [
		StandKeyframeAnimation.key(0.0, StandAnimation.over(streamlined, {"Rig": Vector3(8, 0, 0)})),
		StandKeyframeAnimation.key(0.15, StandAnimation.over(streamlined, {"Rig": Vector3(8, 240, 0)})),
		StandKeyframeAnimation.key(0.32, StandAnimation.over(streamlined, {"Rig": Vector3(8, 520, 0)})),
		StandKeyframeAnimation.key(0.45, StandAnimation.over(streamlined, {"Rig": Vector3(8, 720, 0)})),
	]
	return anim


## Diving head-first: upside down, body straight, arms swept back along its sides and legs together
## behind it like a tail.
static func make_dive() -> StandKeyframeAnimation:
	return make_pose({"Rig": Vector3(180, 0, 0), "Neck": Vector3(-15, 0, 0),
		"ShoulderL": Vector3(-20, 0, -10), "ShoulderR": Vector3(-20, 0, 10),
		"ElbowL": Vector3(5, 0, 0), "ElbowR": Vector3(5, 0, 0),
		"HipL": Vector3(-5, 0, -2), "HipR": Vector3(-5, 0, 2), "KneeL": Vector3(-5, 0, 0), "KneeR": Vector3(-5, 0, 0)}, 0.3)
