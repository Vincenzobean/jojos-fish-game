# How a stand finishes a beaten enemy's stand user, played as a cutscene by a FinisherDirector
# (finisher_director.gd). Every stand gets this one unless it brings its own (stand_body.gd `finisher`):
#
#   1. Defeat: the world slows as the enemy's stand crumbles; the camera looks past the winner to its user.
#   2. Rush: a sonic boom, and the stand is in front of the user before they can blink...
#   3. Grab: ...hauling them up by the collar, kicking (impact frame).
#   4. Throw: it crouches and flings them straight up into the sky...
#   5. Pursuit: ...and breaks the sound barrier again going after them.
#   6. Finish: _finish(), the part a stand makes its own. Here, a barrage ("DORA DORA DORA..."), the
#      user jolted higher with every punch, then a double-fisted hammer from above.
#   7. Slam: the user plummets and hits the ground, leaving a crater (a splash, on water).
#   8. Pose: the stand floats down beside the crater and folds its arms; the user lies there a while,
#      then crumbles to dust.
#
# A stand with its own style extends this and overrides _finish() (see dolphin_stand_finisher.gd), and
# can change any of the shared steps too. Poses are keyframed angles of the stand rig's pivots, like the
# moves' (default_stand_moves.gd).
# Generated by Claude Code.
class_name StandFinisher
extends Resource

const UserState := preload("res://Scripts/World/dummy_user.gd").State

@export var throw_height := 14.0 ## Meters the user is flung up.
@export var barrage_time := 2.2 ## Seconds of barrage (of game time; slow-motion stretches it).
@export var barrage_cries: Array[String] = ["DORA", "DORA", "DORA!", "DORARA"] ## Lettering the barrage throws up.
@export var hammer_cry := "DORAAA!" ## Lettering as the hammer from above lands.


## The whole finisher. Await it.
func perform(d: FinisherDirector) -> void:
	await _opening(d)
	await _finish(d)
	await _slam(d)
	await _pose(d)


# 1-5: the defeat, rush, grab, throw and pursuit every stand shares.
func _opening(d: FinisherDirector) -> void:
	var to_user := d.user_at() - d.stand_at()
	to_user.y = 0.0
	var forward := to_user.normalized() if to_user.length() > 0.1 else d.stand_facing()
	var side := forward.cross(Vector3.UP).normalized()
	d.face_stand(forward)

	# Defeat: everything slows; looking past the winner to the user, who realises what's coming.
	d.step("defeat")
	d.slowmo(0.35, 1.4)
	d.cut(d.stand_at() - forward * 4.5 + side * 1.4 + Vector3.UP * 1.0, d.user_mid(), 50.0)
	d.shot(d.stand_at() - forward * 3.6 + side * 1.1 + Vector3.UP * 0.9, d.user_mid(), 0.5, 42.0) # Pushing in.
	d.pose(make_pose(DefaultStandMoves.on_guard({"Rig": Vector3(-8, 0, 0), "Neck": Vector3(-10, 0, 0)}), 0.15), true)
	await d.wait(0.55)

	# Rush: a sonic boom, and it's in front of the user.
	d.step("rush")
	var grab_at := d.user_at() + Vector3.UP * (FinisherDirector.NECK + 0.15) - forward * d.stand_size * 0.32 - Vector3.UP * d.stand_size * 0.18
	d.effect("sonic_boom", d.stand_at(), 0.8, forward)
	d.effect("shockwave", d.stand_at(), 0.6)
	d.cut((d.stand_at() + grab_at) * 0.5 + side * 7.5 + Vector3.UP * 0.6, (d.stand_at() + grab_at) * 0.5, 60.0)
	d.pose(make_dash(), true)
	await d.move_stand(grab_at, 0.32, Tween.TRANS_EXPO, Tween.EASE_OUT)

	# Grab: hauled up by the collar.
	d.step("grab")
	d.pose(make_grab(), true)
	await d.wait(0.1)
	d.hold_user("R")
	d.user_state(UserState.CAUGHT)
	d.user.hit()
	d.impact_frame(d.user_mid(), 3)
	d.slowmo(0.3, 0.9)
	d.sfx("GRAB!", d.user_mid() + Vector3.UP * 1.2 + side * 0.8, Color(1.0, 0.95, 0.85), 0.8)
	d.cut(d.user_at() - side * 2.6 - forward * 1.8 + Vector3.UP * 0.3, func() -> Vector3: return d.user_mid() + Vector3.UP * 0.4, 45.0)
	await d.wait(0.7)

	# Throw: a crouch, then flung straight up.
	d.step("throw")
	d.pose(make_throw_windup(), true)
	d.shot(d.user_at() - side * 4.0 - forward * 2.5 + Vector3.UP * 0.6, d.user_mid, 0.3, 50.0)
	await d.wait(0.4)
	d.pose(make_fling(), true)
	await d.wait(0.08)
	var ground := d.user_at()
	var apex := ground + Vector3.UP * throw_height
	d.user_state(UserState.FLYING, true)
	d.effect("burst", d.user_mid(), 0.5)
	d.cut(ground + side * 3.0 - forward * 2.0 + Vector3.UP * 0.4, d.user_mid, 70.0)
	await d.move_user(apex, 0.85, Tween.TRANS_CUBIC, Tween.EASE_OUT)

	# Pursuit: another sonic boom, straight up after them.
	d.step("pursuit")
	d.effect("sonic_boom", d.stand_at(), 0.8, Vector3.UP)
	d.effect("shockwave", d.stand_at(), 0.8)
	d.pose(rise_pose(), true)
	var beside := apex + Vector3.UP * (FinisherDirector.MIDDLE - 0.2) - forward * d.stand_size * 0.55
	d.shot(apex + side * 7.0 - forward * 3.0 + Vector3.UP * 0.5, func() -> Vector3: return (d.stand_at() + d.user_mid()) * 0.5, 0.45, 55.0)
	await d.move_stand(beside, 0.4, Tween.TRANS_EXPO, Tween.EASE_OUT)
	d.face_stand(forward)
	d.pose(make_pose(DefaultStandMoves.on_guard({"Rig": Vector3(-5, 0, 0)}), 0.15), true) # Squaring up, a beat before it starts.
	await d.wait(0.35)


# 6: the barrage, then a hammer from above.
func _finish(d: FinisherDirector) -> void:
	d.step("finish")
	var forward := d.stand_facing()
	var side := forward.cross(Vector3.UP).normalized()
	var center := (d.stand_at() + d.user_mid()) * 0.5
	var moves: StandMoveSet = d.stand.get_moves() if d.stand.has_method("get_moves") else DefaultStandMoves.new()
	d.pose(moves.barrage.animation, true)
	d.user_state(UserState.FLYING, false)
	# The camera swings half round them while the fists fly.
	var orbit := [0.0]
	var around := func() -> Vector3:
		var angle: float = orbit[0]
		return center + (side * cos(angle) + forward * sin(angle)) * 6.5 + Vector3.UP * 0.8
	d.shot(around, func() -> Vector3: return (d.stand_at() + d.user_mid()) * 0.5, 0.35, 55.0)
	var tween := d.create_tween()
	tween.tween_method(func(angle: float) -> void: orbit[0] = angle, -0.4, PI * 0.6, barrage_time)
	var words := barrage_cries
	var time := 0.0
	var count := 0
	while time < barrage_time:
		d.user.hit()
		d.effect("impact", d.user_mid() + Vector3(randf_range(-0.3, 0.3), randf_range(-0.4, 0.4), randf_range(-0.3, 0.3)), 0.8)
		d.user.global_position += Vector3.UP * 0.06
		center += Vector3.UP * 0.06
		d.shake(0.25)
		if count % 3 == 0:
			d.sfx(words[(count / 3) % words.size()], d.user_mid() + side * randf_range(-1.6, 1.6) + Vector3.UP * randf_range(0.6, 1.8),
				Color(1.0, 0.92, 0.3), randf_range(0.6, 0.9))
		count += 1
		await d.wait(0.11)
		time += 0.11
		# Keep the stand alongside as the user rises.
		d.torso.global_position += Vector3.UP * 0.06
	await _hammer(d)


# The double-fisted hammer from above that sends the user down; ends with them falling.
func _hammer(d: FinisherDirector) -> void:
	var forward := d.stand_facing()
	var side := forward.cross(Vector3.UP).normalized()
	d.pose(make_hammer_windup(), true)
	d.effect("sonic_boom", d.stand_at(), 0.5, Vector3.UP)
	d.shot(d.user_mid() + side * 6.0 + Vector3.UP * 1.0, d.user_mid() + Vector3.UP * 1.0, 0.3, 50.0)
	await d.move_stand(d.user_mid() + Vector3.UP * d.stand_size * 0.55 - forward * d.stand_size * 0.25, 0.3, Tween.TRANS_EXPO, Tween.EASE_OUT)
	await d.wait(0.3) # Fists raised, hanging there a moment...
	d.pose(make_hammer(), true)
	await land_on_user(d, func() -> Vector3: return (d.visuals.fist("L") + d.visuals.fist("R")) * 0.5, 0.12)
	d.user.hit()
	d.user_state(UserState.FLYING, true)
	d.effect("burst", d.user_mid() + Vector3.UP * 0.4, 0.7)
	d.impact_frame(d.user_mid(), 4)
	d.slowmo(0.2, 0.9)
	d.shake(1.0)
	d.sfx(hammer_cry, d.user_mid() + Vector3.UP * 1.6, Color(1.0, 0.45, 0.3), 1.1)
	await d.wait(0.25)


## Brings `contact` (a point on the stand, like its fists, as a Callable) down onto the user's head over
## `seconds`, the stand following it, so the blow lands on them rather than the air beside them.
func land_on_user(d: FinisherDirector, contact: Callable, seconds: float) -> void:
	var left := seconds
	while left > 0.0:
		await d.get_tree().process_frame
		var step_time := d.get_process_delta_time()
		var target := d.user_mid() + Vector3.UP * 0.55
		var miss: Vector3 = target - contact.call()
		d.torso.global_position += miss * clampf(step_time / maxf(left, 0.001), 0.0, 1.0)
		left -= step_time


# 7: the user plummets into the ground: a crater (or a splash).
func _slam(d: FinisherDirector) -> void:
	d.step("slam")
	var forward := d.stand_facing()
	var side := forward.cross(Vector3.UP).normalized()
	var below := d.ground_below(d.user_at())
	var hit_at: Vector3 = below["position"]
	# Following them down, from the side and a little below, the ground rushing up.
	d.cut(func() -> Vector3: return d.user_mid() + side * 7.0 - forward * 1.5 - Vector3.UP * 1.0, d.user_mid, 60.0)
	d.effect("sonic_boom", d.user_mid(), 0.6, Vector3.DOWN)
	await d.move_user(hit_at, 0.5, Tween.TRANS_QUAD, Tween.EASE_IN)
	d.user_state(UserState.DOWN)
	d.user.hit()
	if below["water"]:
		d.effect("splash", hit_at, 1.0)
	else:
		var depth := d.crater(hit_at)
		d.user.global_position = hit_at - Vector3.UP * depth * 0.8 # Laid out in the bottom of it.
		d.effect("dust", hit_at, 1.0)
	d.effect("shockwave", hit_at + Vector3.UP * 0.1, 1.2)
	d.effect("burst", hit_at + Vector3.UP * 0.3, 0.8)
	d.impact_frame(hit_at, 3, false)
	d.shake(1.6)
	d.sfx("BOOM", hit_at + Vector3.UP * 2.0, Color(1.0, 0.95, 0.85), 1.4)
	d.cut(hit_at + side * 6.0 - forward * 1.0 + Vector3.UP * 2.5, hit_at, 55.0)
	await d.wait(1.0)
	# The dust settles on them, lying in the crater.
	d.shot(hit_at + side * 3.5 - forward * 1.5 + Vector3.UP * 2.2, hit_at, 1.2, 45.0)
	await d.wait(1.3)


# 8: the stand floats down beside the crater and folds its arms; the user lies there a while longer,
# then crumbles to dust.
func _pose(d: FinisherDirector) -> void:
	d.step("pose")
	var forward := d.stand_facing()
	var side := forward.cross(Vector3.UP).normalized()
	var crater := d.user_at()
	var spot := crater - side * d.stand_size * 0.9 + Vector3.UP * d.stand_size * 0.75
	d.face_stand(side)
	d.pose(make_victory(), true)
	d.move_stand(spot, 1.0)
	d.cut(spot + forward * 7.5 + side * 2.0 + Vector3.UP * 0.3, (spot + crater) * 0.5, 50.0)
	d.shot(spot + forward * 5.5 + side * 1.2 + Vector3.UP * 0.4, (spot + crater) * 0.5 + Vector3.UP * 0.3, 2.4, 44.0)
	await d.wait(1.6)
	d.step("dust")
	d.effect("ash", crater + Vector3.UP * 0.3, 0.7)
	d.user.dissolve(1.6)
	await d.wait(2.0)
	d.step("done")


# --- Poses ---------------------------------------------------------------------------------------------

## A held pose: `pose` (pivots and channels), blended into over `blend` seconds.
static func make_pose(pose: Dictionary, blend := 0.06) -> StandKeyframeAnimation:
	var anim := StandKeyframeAnimation.new()
	anim.duration = 60.0
	anim.blend_in = blend
	anim.blend_out = 0.2
	anim.keys = [StandKeyframeAnimation.key(0.0, pose)]
	return anim


## Flying flat out: leaning hard into it, arms swept back, legs trailing (leaving afterimages).
static func make_dash() -> StandKeyframeAnimation:
	var anim := make_pose({"Rig": Vector3(-35, 0, 0), "Neck": Vector3(-20, 0, 0),
		"ShoulderL": Vector3(-35, 0, -15), "ShoulderR": Vector3(-35, 0, 15),
		"ElbowL": Vector3(20, 0, 0), "ElbowR": Vector3(20, 0, 0),
		"HipL": Vector3(-15, 0, -4), "HipR": Vector3(-25, 0, 4), "KneeL": Vector3(-30, 0, 0), "KneeR": Vector3(-20, 0, 0)}, 0.04)
	anim.afterimages = true
	return anim


## How the stand flies up after the user it threw (the pursuit). Override for a stand's own.
func rise_pose() -> StandAnimation:
	return make_rise()


## Rocketing straight up: a crouch to spring, then stretched out tall with the right fist thrust
## overhead and the legs together, corkscrewing twice round as it climbs (leaving afterimages), coming out
## of the spin with the fist still raised.
static func make_rise() -> StandKeyframeAnimation:
	var spring := DefaultStandMoves.on_guard({"Rig": Vector3(-10, 0, 0), "lift": Vector3(0, -0.2, 0),
		"ShoulderR": Vector3(60, 0, 10), "ElbowR": Vector3(90, 0, 0),
		"HipL": Vector3(45, 0, -6), "HipR": Vector3(45, 0, 6), "KneeL": Vector3(-80, 0, 0), "KneeR": Vector3(-80, 0, 0)})
	var rocket := {"Neck": Vector3(25, 0, 0),
		"ShoulderR": Vector3(178, 0, 4), "ElbowR": Vector3(0, 0, 0),
		"ShoulderL": Vector3(-8, 0, -6), "ElbowL": Vector3(10, 0, 0),
		"HipL": Vector3(0, 0, -2), "HipR": Vector3(0, 0, 2), "KneeL": Vector3(-4, 0, 0), "KneeR": Vector3(-4, 0, 0)}
	var anim := StandKeyframeAnimation.new()
	anim.duration = 60.0
	anim.blend_in = 0.05
	anim.blend_out = 0.2
	anim.afterimages = true
	anim.keys = [
		StandKeyframeAnimation.key(0.0, spring),
		StandKeyframeAnimation.key(0.08, spring),
		StandKeyframeAnimation.key(0.16, StandAnimation.over(rocket, {"Rig": Vector3(0, 120, 0)})),
		StandKeyframeAnimation.key(0.3, StandAnimation.over(rocket, {"Rig": Vector3(0, 420, 0)})),
		StandKeyframeAnimation.key(0.44, StandAnimation.over(rocket, {"Rig": Vector3(0, 660, 0)})),
		StandKeyframeAnimation.key(0.55, StandAnimation.over(rocket, {"Rig": Vector3(0, 720, 0)})),
	]
	return anim


## The right hand up and forward, fist closed on the user's collar.
static func make_grab() -> StandKeyframeAnimation:
	return make_pose(DefaultStandMoves.on_guard({"Rig": Vector3(-6, 15, 0), "Neck": Vector3(10, 0, 0),
		"ShoulderR": Vector3(120, 0, 8), "ElbowR": Vector3(20, 0, 0)}), 0.04)


## Crouched to fling, the user swung down low.
static func make_throw_windup() -> StandKeyframeAnimation:
	return make_pose(DefaultStandMoves.on_guard({"Rig": Vector3(-18, 10, 0), "Neck": Vector3(-5, 0, 0), "lift": Vector3(0, -0.25, 0),
		"ShoulderR": Vector3(70, 0, 10), "ElbowR": Vector3(30, 0, 0),
		"HipL": Vector3(50, 0, -8), "HipR": Vector3(40, 0, 8), "KneeL": Vector3(-70, 0, 0), "KneeR": Vector3(-60, 0, 0)}), 0.06)


## Flinging straight up: stretched tall, the throwing arm high overhead.
static func make_fling() -> StandKeyframeAnimation:
	return make_pose(DefaultStandMoves.on_guard({"Rig": Vector3(8, 0, 0), "Neck": Vector3(25, 0, 0), "lift": Vector3(0, 0.15, 0),
		"ShoulderR": Vector3(175, 0, 5), "ElbowR": Vector3(0, 0, 0),
		"ShoulderL": Vector3(-20, 0, -25), "ElbowL": Vector3(20, 0, 0),
		"HipL": Vector3(0, 0, -6), "HipR": Vector3(0, 0, 6), "KneeL": Vector3(-5, 0, 0), "KneeR": Vector3(-5, 0, 0)}), 0.04)


## Both fists raised high together, leaning back to bring them down.
static func make_hammer_windup() -> StandKeyframeAnimation:
	return make_pose(DefaultStandMoves.on_guard({"Rig": Vector3(18, 0, 0), "Neck": Vector3(15, 0, 0),
		"ShoulderL": Vector3(170, 0, 12), "ShoulderR": Vector3(170, 0, -12),
		"ElbowL": Vector3(40, 0, 0), "ElbowR": Vector3(40, 0, 0), "KneeL": Vector3(-40, 0, 0), "KneeR": Vector3(-40, 0, 0)}), 0.05)


## The hammer coming down: folded forward over it, both fists driven down together.
static func make_hammer() -> StandKeyframeAnimation:
	return make_pose(DefaultStandMoves.on_guard({"Rig": Vector3(-40, 0, 0), "Neck": Vector3(-25, 0, 0),
		"ShoulderL": Vector3(45, 0, 10), "ShoulderR": Vector3(45, 0, -10),
		"ElbowL": Vector3(5, 0, 0), "ElbowR": Vector3(5, 0, 0),
		"HipL": Vector3(-20, 0, -6), "HipR": Vector3(-20, 0, 6), "KneeL": Vector3(-30, 0, 0), "KneeR": Vector3(-30, 0, 0)}), 0.03)


## Victory: side-on, arms folded, chin up, looking down its nose at the crater.
static func make_victory() -> StandKeyframeAnimation:
	return make_pose({"Rig": Vector3(0, -25, 0), "Neck": Vector3(15, 35, 0),
		"ShoulderL": Vector3(65, 0, 35), "ShoulderR": Vector3(65, 0, -35),
		"ElbowL": Vector3(125, 0, 0), "ElbowR": Vector3(125, 0, 0),
		"HipL": Vector3(0, 0, -12), "HipR": Vector3(0, 0, 12), "KneeL": Vector3(-6, 0, 0)}, 0.2)
