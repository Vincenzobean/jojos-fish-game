# Runs one stand finisher as a cutscene: after a stand beats a target that has a stand user (stand_combat.gd
# target_defeated), possession.gd makes one of these and awaits run(). It takes the stand out of the
# player's hands, frames everything with its own camera between letterbox bars, plays the stand's
# finisher (stand_body.gd get_finisher(), a StandFinisher) and hands everything back afterward.
#
# The finisher builds its sequence from the small API below and the shared cutscene one (stand_cutscene.gd:
# camera shots, slow-motion, impact frames, effects, sound-effect lettering). Everything runs on game time.
#   * Moving: move_stand(), face_stand(), move_user(), hold_user() (hanging from a fist), user states.
#   * The stand's look: pose() (any StandAnimation, through its visuals), and its floating companion
#     placed by hand (companion_to()).
#   * crater().
# `phase` names each step as the finisher reaches it (for tests and anything that wants to follow along).
# Generated by Claude Code.
class_name FinisherDirector
extends StandCutscene

const StandShape := preload("res://Scripts/Stands/stand_shape.gd")
const UserState := preload("res://Scripts/World/dummy_user.gd").State

const NECK := 1.38 # How far above a user's feet its collar is.
const MIDDLE := 0.9 # ...and its middle.

var stand: Node3D # stand_body.gd
var visuals: Node # Its stand_body_visuals.gd.
var torso: RigidBody3D
var user: Node3D # dummy_user.gd (or any stand user with the same API).

var _stand_camera: Camera3D
var _held_by := "" # The fist ("L" or "R") the user hangs from, or empty.
var _disabled: Array[Node] = []


## Takes over `stand` to finish `user`; `stand_camera` is the camera that was following the stand.
func setup(stand_body: Node3D, stand_user: Node3D, stand_camera: Camera3D) -> void:
	stand = stand_body
	visuals = stand.get_node("Visuals")
	torso = stand.torso
	user = stand_user
	stand_size = StandShape.size(stand)
	_stand_camera = stand_camera


## Plays the stand's finisher from start to end. Await it.
func run() -> void:
	_begin()
	var finisher: StandFinisher = stand.get_finisher() if stand.has_method("get_finisher") else StandFinisher.new()
	await finisher.perform(self)
	await _end()
	finished.emit()


# --- Building blocks for finishers ---------------------------------------------------------------------

## The stand's middle, the user's feet and middle (world).
func stand_at() -> Vector3:
	return torso.global_position


func user_at() -> Vector3:
	return user.global_position


func user_mid() -> Vector3:
	return user.global_position + Vector3.UP * MIDDLE


## The way the stand faces, flat.
func stand_facing() -> Vector3:
	return StandShape.facing(torso)


## Flies the stand's middle to `to` over `seconds` (the body stays frozen; this just places it).
func move_stand(to: Vector3, seconds: float, trans := Tween.TRANS_QUAD, easing := Tween.EASE_IN_OUT) -> Signal:
	var tween := create_tween()
	tween.tween_method(func(at: Vector3) -> void: torso.global_position = at, torso.global_position, to, maxf(seconds, 0.001)) \
		.set_trans(trans).set_ease(easing)
	return tween.finished


## Turns the stand to face along `direction` (flattened).
func face_stand(direction: Vector3) -> void:
	var flat := Vector3(direction.x, 0.0, direction.z)
	if flat.length() > 0.01:
		torso.global_basis = Basis.looking_at(flat.normalized(), Vector3.UP)


## Moves the user (feet) to `to` over `seconds`, letting go of it if it was held.
func move_user(to: Vector3, seconds: float, trans := Tween.TRANS_QUAD, easing := Tween.EASE_OUT) -> Signal:
	_held_by = ""
	var tween := create_tween()
	tween.tween_method(func(at: Vector3) -> void: user.global_position = at, user.global_position, to, maxf(seconds, 0.001)) \
		.set_trans(trans).set_ease(easing)
	return tween.finished


## Hangs the user by the collar from the stand's fist ("L" or "R") until moved or let go.
func hold_user(side := "R") -> void:
	_held_by = side


func user_state(state: int, tumbling := false) -> void:
	user.tumbling = tumbling
	user.set_state(state)


## Plays `animation` on the stand (held: stays in its hold until another plays).
func pose(animation: StandAnimation, held := false) -> void:
	visuals.play(animation, held)


## Holds the stand's floating companion at `point` (Vector3 or Callable, followed while it lasts) until
## companion_free().
func companion_to(point: Variant, scale := 1.0) -> void:
	_companion_point = _fn(point)
	_companion_scale = scale


func companion_free() -> void:
	_companion_point = Callable()
	visuals.companion_free()


## Leaves a crater at `at`, shaped to the ground there. Returns how deep its middle is.
func crater(at: Vector3) -> float:
	var made: Node3D = Crater.make(get_tree().current_scene, at, stand_size * 0.55)
	return made.depth


# --- Inside --------------------------------------------------------------------------------------------

var _companion_point: Callable
var _companion_scale := 1.0


func _begin() -> void:
	for node_name in ["Controller", "Combat", "Health", "Status"]:
		var node := stand.get_node_or_null(node_name)
		if node:
			node.set_physics_process(false)
			_disabled.append(node)
	torso.freeze = true
	torso.linear_velocity = Vector3.ZERO
	torso.angular_velocity = Vector3.ZERO
	open_cutscene(_stand_camera, torso.global_position, torso.global_transform)


func _end() -> void:
	_held_by = ""
	companion_free()
	visuals.cancel() # Out of its last pose (the finisher's poses are held) and back to flying.
	await close_cutscene()
	torso.freeze = false
	for node in _disabled:
		if is_instance_valid(node):
			node.set_physics_process(true)
			if node.has_method("settle"):
				node.settle()
	if is_instance_valid(_stand_camera):
		_stand_camera.make_current()
	free_cutscene()


func _process(delta: float) -> void:
	if camera == null or not is_instance_valid(user):
		return
	if _held_by != "":
		# Hanging by the collar from the fist, facing the stand.
		user.global_position = visuals.fist(_held_by) - Vector3.UP * NECK
		var to_stand := torso.global_position - user.global_position
		to_stand.y = 0.0
		if to_stand.length() > 0.1:
			user.global_basis = Basis.looking_at(to_stand.normalized(), Vector3.UP)
	if _companion_point.is_valid():
		visuals.companion_to(_companion_point.call(), 1.0, _companion_scale)
	_tick_camera(delta)
