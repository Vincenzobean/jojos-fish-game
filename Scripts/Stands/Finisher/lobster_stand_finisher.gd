# The Lobster Stand's finisher, Boiling Point: the shared opening, slam and pose (stand_finisher.gd), but
# where others throw a barrage it catches its user in mid-air:
#
#   The crusher claw clamps shut round them ("CLAMP!"). It squeezes, three times, each harder than the
#   last ("CRUNCH", the user jolting with each), shaking with the effort, as steam starts hissing off its
#   shell. Then the heat boils over: a burst of steam (impact frame, "BOILING POINT!") blasts the user
#   out of its grip and down into the slam.
# Generated by Claude Code.
class_name LobsterStandFinisher
extends StandFinisher

@export var squeezes := 3 ## Times it squeezes before the steam blows.


func _init() -> void:
	barrage_cries = ["CRUNCH", "CRUNCH!", "CRRUNCH!!"]
	hammer_cry = "BOILING POINT!"


func _finish(d: FinisherDirector) -> void:
	d.step("finish")
	var forward := d.stand_facing()
	var side := forward.cross(Vector3.UP).normalized()
	var moves := LobsterStandMoves.new()
	var grab: StandMove = moves.specials[moves.specials.size() - 1] # Claw Grab.

	# The clamp: the crusher shoots out and snaps shut round them.
	d.step("clamp")
	d.pose(grab.animation, false)
	await d.wait(0.3)
	d.hold_user("R")
	d.user_state(UserState.CAUGHT)
	d.user.hit()
	d.effect("impact", d.user_mid(), 0.9)
	d.impact_frame(d.user_mid(), 3)
	d.sfx("CLAMP!", d.user_mid() + Vector3.UP * 1.2 + side * 0.9, Color(1.0, 0.55, 0.25), 0.9)
	d.cut(d.user_mid() + side * 3.2 + forward * 0.6 + Vector3.UP * 0.4, (d.stand_at() + d.user_mid()) * 0.5, 45.0)
	await d.wait(0.35)

	# The squeezes, each harder, steam starting to hiss off it.
	d.step("squeeze")
	d.pose(make_pose(StandAnimation.over(LobsterStandMoves.SHELL_GUARD_POSE, {"Rig": Vector3(-14, 16, 0),
		"ShoulderR": Vector3(95, 0, -4), "ElbowR": Vector3(25, 0, 0), "shake": 3.5}), 0.08), true)
	for i in squeezes:
		d.user.hit()
		d.effect("impact", d.user_mid() + Vector3(randf_range(-0.2, 0.2), randf_range(-0.2, 0.2), 0.0), 0.7 + 0.2 * i)
		d.effect("gather", d.stand_at() + Vector3.UP * 0.6, 0.6 + 0.2 * i) # Steam gathering.
		d.shake(0.4 + 0.3 * i)
		d.sfx(barrage_cries[i % barrage_cries.size()], d.user_mid() + side * randf_range(-1.4, 1.4) + Vector3.UP * (0.8 + 0.3 * i),
			Color(1.0, 0.55, 0.25), 0.7 + 0.12 * i)
		d.shot(d.user_mid() + side * (3.0 - 0.4 * i) + forward * 0.4 + Vector3.UP * 0.3, d.user_mid(), 0.3, 45.0 - 3.0 * i)
		await d.wait(0.45)

	# Boiling point: the steam blasts them out of its grip and down.
	d.step("boil")
	d.cut(d.user_mid() + side * 7.0 - forward * 1.5 + Vector3.UP * 1.0, (d.stand_at() + d.user_mid()) * 0.5, 55.0)
	d.effect("burst", d.stand_at() + Vector3.UP * 0.5, 1.2)
	d.effect("shockwave", d.user_mid(), 1.0)
	d.effect("sonic_boom", d.user_mid(), 0.7, Vector3.DOWN)
	d.user.hit()
	d.user_state(UserState.FLYING, true)
	d.impact_frame(d.user_mid(), 4)
	d.slowmo(0.2, 0.9)
	d.shake(1.4)
	d.sfx(hammer_cry, d.user_mid() + Vector3.UP * 1.6, Color(1.0, 0.45, 0.25), 1.2)
	d.pose(make_pose(LobsterStandMoves.SHELL_GUARD_POSE, 0.2), true)
	await d.wait(0.3)
