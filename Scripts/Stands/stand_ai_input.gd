# Controls pressed by code rather than the player (see stand_input.gd): an AI (enemy_stand_brain.gd)
# holds and taps actions and sets the movement it wants, and the stand's controller and combat read
# them like buttons. A tap counts as just pressed for the physics frame it was made in, so the AI must
# run before them each frame (it's added to the stand first).
# Generated by Claude Code.
class_name StandAIInput
extends StandInput

var _held := {} # Action -> true while held.
var _tapped := {} # Action -> the physics frame it was pressed in.
var _move := Vector2.ZERO # x right, y back (like Input.get_vector with up/down as forward/back).
var _climb := 0.0 # -1 descending to 1 rising.


## Holds `action` down, or lets it go. Pressing it counts as a tap too.
func hold(action: StringName, on: bool) -> void:
	if on and not _held.get(action, false):
		_tapped[action] = Engine.get_physics_frames()
	_held[action] = on


## Presses `action` for this frame.
func tap(action: StringName) -> void:
	_tapped[action] = Engine.get_physics_frames()


## Lets go of everything and stops.
func release_all() -> void:
	_held.clear()
	_tapped.clear()
	_move = Vector2.ZERO
	_climb = 0.0


## The movement wanted: x to the right, y backward (-1 forward), relative to the way it faces.
func set_move(move: Vector2) -> void:
	_move = move.limit_length(1.0)


## Rising (1) or sinking (-1).
func set_climb(climb: float) -> void:
	_climb = clampf(climb, -1.0, 1.0)


func pressed(action: StringName) -> bool:
	return _held.get(action, false)


func just_pressed(action: StringName) -> bool:
	return _tapped.get(action, -1) == Engine.get_physics_frames()


func get_vector(_negative_x: StringName, _positive_x: StringName, _negative_y: StringName, _positive_y: StringName) -> Vector2:
	return _move


func get_axis(_negative: StringName, _positive: StringName) -> float:
	return _climb
