# A school of small anchovies for the Anchovy Stand's cutscenes (its clash, anchovy_stand_clash.gd, and its
# School Formation, formation_director.gd): `count` little silver fish, drawn in the stands' manga style,
# circling `center` in a loose ring `radius` wide, each at its own height and pace, facing the way it
# swims. Tween `radius`, `fish_scale` and `spin` (radians per second) to move it all; `center` can follow
# something by being a Callable that returns a world point.
#   * make(): a school in `world`, its ring `radius` wide round `center`.
#   * gather(): it swirls in tight and shrinks into the center, then frees itself (into the stand).
#   * scatter(): it bursts outward and fades, then frees itself (the formation breaking apart).
# Purely presentation.
# Generated by Claude Code.
class_name AnchovySchool
extends Node3D

const StandBodyModel := preload("res://Scripts/Stands/stand_body_model.gd")

static var _mesh: ArrayMesh

var center: Variant = Vector3.ZERO ## A world point, or a Callable returning one.
var radius := 1.0
var fish_scale := 1.0
var spin := 4.0 ## Radians per second round the ring.

var _fish: Array[Node3D] = []
var _angles := PackedFloat32Array()
var _heights := PackedFloat32Array()
var _paces := PackedFloat32Array()
var _ring_spread := PackedFloat32Array()


## A school of `count` fish, `size` times life size (a stand's height, 1.9 m at 1), circling `at` in a ring
## `ring` wide, added to `world`.
static func make(world: Node, at: Variant, ring: float, count := 30, size := 1.0) -> AnchovySchool:
	var school := AnchovySchool.new()
	school.center = at
	school.radius = ring
	world.add_child(school)
	for i in count:
		var fish := MeshInstance3D.new()
		fish.mesh = _fish_mesh()
		fish.scale = Vector3.ONE * size
		school.add_child(fish)
		school._fish.append(fish)
		school._angles.append(randf() * TAU)
		school._heights.append(randf_range(-0.5, 0.5)) # Times the ring, so it closes up as it tightens.
		school._paces.append(randf_range(0.8, 1.25))
		school._ring_spread.append(randf_range(0.75, 1.15))
	school._process(0.0)
	return school


## Swirls in tight and shrinks into the center over `seconds`, then frees itself. Await the signal.
func gather(seconds: float) -> Signal:
	var tween := create_tween().set_parallel()
	tween.tween_property(self, "radius", 0.0, seconds).set_trans(Tween.TRANS_CUBIC).set_ease(Tween.EASE_IN)
	tween.tween_property(self, "spin", spin * 3.0, seconds)
	tween.tween_property(self, "fish_scale", 0.2, seconds).set_ease(Tween.EASE_IN)
	tween.chain().tween_callback(queue_free)
	return tween.finished


## Bursts outward to `to_radius` and fades over `seconds`, then frees itself.
func scatter(to_radius: float, seconds: float) -> Signal:
	var tween := create_tween().set_parallel()
	tween.tween_property(self, "radius", to_radius, seconds).set_ease(Tween.EASE_OUT)
	tween.tween_property(self, "fish_scale", 0.0, seconds).set_ease(Tween.EASE_IN)
	tween.chain().tween_callback(queue_free)
	return tween.finished


func _process(delta: float) -> void:
	var at: Vector3 = center.call() if center is Callable else center
	for i in _fish.size():
		_angles[i] += spin * _paces[i] * delta
		var r := radius * _ring_spread[i]
		var offset := Vector3(cos(_angles[i]) * r, _heights[i] * radius, sin(_angles[i]) * r)
		var fish := _fish[i]
		fish.global_position = at + offset
		var along := Vector3(-sin(_angles[i]), 0.0, cos(_angles[i])) * signf(spin) # The way round the ring.
		if along.length() > 0.01:
			fish.global_basis = Basis.looking_at(along, Vector3.UP).scaled(Vector3.ONE * maxf(fish_scale, 0.001))


# One small anchovy facing -Z: a slim silver body with a dark back, big eye and a forked tail.
static func _fish_mesh() -> ArrayMesh:
	if _mesh:
		return _mesh
	var silver := Color(0.78, 0.84, 0.9)
	var back := Color(0.2, 0.3, 0.42)
	var b := StandBodyModel.Builder.new()
	b.ellipsoid(Vector3.ZERO, Vector3(0.022, 0.028, 0.09), silver, 3, 6) # Body.
	b.box(Vector3(0.0, 0.022, 0.0), Vector3(0.012, 0.008, 0.13), back) # Dark back.
	for s in [-1.0, 1.0]:
		b.ellipsoid(Vector3(s * 0.016, 0.006, -0.06), Vector3(0.008, 0.009, 0.009), Color(0.05, 0.06, 0.09), 2, 5) # Eye.
	b.fin([Vector3(0.0, 0.0, 0.075), Vector3(0.0, 0.04, 0.13), Vector3(0.0, 0.0, 0.11), Vector3(0.0, -0.04, 0.13)],
		0.008, silver, back, 1) # Forked tail.
	_mesh = b.commit(StandBodyModel.material())
	return _mesh
