# Lord Verity's intro, when the player challenges him in the final arena (stand_encounter.gd challenge()
# makes one of these and awaits run()). Played with the shared cutscene blocks (stand_cutscene.gd):
#
#   1. Arena: the camera sweeps high round the arena and its spire, coming down to him at the far side.
#   2. Words: close on him as he speaks, his lines as subtitles under his name.
#   3. Taunt: he thrusts out an arm, pointing at the player, and says the last line.
#   4. Stasis: time stops (time_stop.gd, just for the look), and in that instant his stand, Still Water,
#      is simply there beside him ("spawn_boss"), flung wide; then time moves again.
#   5. Answer: back behind the player, whose own stand comes out in front of them ("spawn_ally"), and
#      "FIGHT!" as the camera settles behind it.
#
# Both stands are frozen in place while it plays, and let go at the end. Once he has been met (Story
# "boss_met"), skip_cutscene jumps straight to the end.
# Purely presentation.
# Generated by Claude Code.
extends StandCutscene

const StandShape := preload("res://Scripts/Stands/stand_shape.gd")
const VillainState := preload("res://Scripts/World/villain_user.gd").State

## His lines: before the taunt, then as he points (the last).
const LINES := [
	"So. You crossed the whole sea to stand on my island.",
	"I've watched every stand you dragged out of the water. Every one.",
	"A mantis shrimp strikes faster than the eye can follow...",
	"...and mine strikes faster than time itself. Come, then!",
]
const REMATCH_LINES := [
	"Back again? Time has taught you nothing.",
	"Then let me teach you once more!",
]

var villain: Node3D # villain_user.gd
var arena: Node3D # final_arena.gd
var boss: Node3D
var ally: Node3D

var _spawn_boss: Callable
var _spawn_ally: Callable
var _player_camera: Camera3D
var _skipping := false
var _subtitle: Label
var _speaker: Label


## Plays the intro for `villain` in `arena`, from `user_camera`'s view. `spawn_boss` and `spawn_ally` bring
## out his stand and the player's (each returns it) when the cutscene reaches them.
func setup(the_villain: Node3D, the_arena: Node3D, user_camera: Camera3D, spawn_boss: Callable, spawn_ally: Callable) -> void:
	villain = the_villain
	arena = the_arena
	_player_camera = user_camera
	_spawn_boss = spawn_boss
	_spawn_ally = spawn_ally
	stand_size = 3.2


## Plays it from start to end. Await it.
func run() -> void:
	var front: Vector3 = arena.front
	var side := front.cross(Vector3.UP)
	var center: Vector3 = arena.center
	var head: Vector3 = villain.head()
	var rematch: bool = Story.has_flag(&"boss_defeated")
	open_cutscene(_player_camera, head)
	_build_subtitles()

	# 1: the arena from high up, coming down to him.
	step("arena")
	cut(center + front * arena.radius * 1.3 + side * arena.radius * 0.6 + Vector3.UP * 22.0, center, 60.0)
	shot(center - side * arena.radius * 0.9 + Vector3.UP * 9.0, arena.villain_spot + Vector3.UP * 1.0, 2.6, 50.0)
	await _beat(2.4)

	# 2: close on him, speaking.
	step("words")
	cut(head + front * 3.2 + side * 1.2 + Vector3.DOWN * 0.2, head, 45.0)
	shot(head + front * 2.4 + side * 0.8, head, 3.0, 40.0)
	var lines: Array = REMATCH_LINES if rematch else LINES
	for i in lines.size() - 1:
		await _say(lines[i])

	# 3: the taunt.
	step("taunt")
	villain.set_state(VillainState.TAUNT)
	cut(head + front * 1.6 - side * 2.6 + Vector3.UP * 0.1, head - side * 0.5, 50.0)
	await _say(lines[lines.size() - 1])

	# 4: time stops, and his stand is there.
	step("stasis")
	var stop := TimeStop.begin(villain, 1.6, false)
	impact_frame(head, 2, false)
	if _spawn_boss.is_valid():
		boss = _spawn_boss.call()
	if boss:
		_hold(boss, front)
	cut(arena.boss_spot + front * 7.0 + side * 3.0 + Vector3.UP * 1.5, arena.boss_spot + Vector3.UP * 1.8, 50.0)
	sfx("STASIS", arena.boss_spot + Vector3.UP * 4.0, Color(0.55, 1.0, 0.8), 1.2)
	await _beat(1.0)
	_say_now("Still Water.")
	await _beat(1.2)
	if stop:
		stop.cancel()
	shake(0.6)

	# 5: the player's stand answers.
	step("answer")
	if _spawn_ally.is_valid():
		ally = _spawn_ally.call()
	if ally:
		_hold(ally, -front)
	var player_at: Vector3 = arena.player_spot
	cut(player_at + front * 3.5 + side * 1.5 + Vector3.UP * 2.0, player_at - front * 4.0 + Vector3.UP * 1.5, 55.0)
	shot(player_at + front * 2.5 + Vector3.UP * 2.4, arena.boss_spot + Vector3.UP * 1.8, 1.2, 55.0)
	_say_now("")
	await _beat(0.8)
	sfx("FIGHT!", arena.boss_spot + Vector3.UP * 2.0, Color(1.0, 0.92, 0.3), 1.4)
	await _beat(0.8)

	Story.set_flag(&"boss_met")
	_subtitle.visible = false
	_speaker.visible = false
	await close_cutscene()
	for stand: Node3D in [boss, ally]:
		if is_instance_valid(stand):
			stand.torso.freeze = false
	finished.emit()


func _unhandled_input(event: InputEvent) -> void:
	if event.is_action_pressed("skip_cutscene") and Story.has_flag(&"boss_met") and not _skipping:
		_skipping = true
		get_viewport().set_input_as_handled()


# Waits `seconds`, or less once it's being skipped.
func _beat(seconds: float) -> void:
	var left := seconds
	while left > 0.0 and not _skipping:
		await get_tree().process_frame
		left -= get_process_delta_time()


# Shows `line` as his subtitle and gives it time to be read.
func _say(line: String) -> void:
	_say_now(line)
	await _beat(clampf(0.9 + line.length() * 0.045, 1.6, 3.6))


func _say_now(line: String) -> void:
	_subtitle.text = line
	_speaker.visible = line != ""
	_subtitle.visible = line != ""


# Freezes `stand` where it is (it's posed by hand), facing `facing`.
func _hold(stand: Node3D, facing: Vector3) -> void:
	var torso: RigidBody3D = stand.torso
	torso.freeze = true
	torso.linear_velocity = Vector3.ZERO
	torso.angular_velocity = Vector3.ZERO
	var flat := StandShape.flat(facing)
	torso.global_basis = Basis.looking_at(flat, Vector3.UP)


# His name and a line of subtitle above the bottom bar.
func _build_subtitles() -> void:
	_speaker = HudStyle.label(24, villain.DISPLAY_NAME.to_upper())
	_speaker.add_theme_color_override("font_color", Color(0.55, 1.0, 0.8))
	_subtitle = HudStyle.label(30, "")
	for label: Label in [_speaker, _subtitle]:
		_layer.add_child(label)
		label.set_anchors_and_offsets_preset(Control.PRESET_CENTER_BOTTOM)
		label.grow_horizontal = Control.GROW_DIRECTION_BOTH
		label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
		label.visible = false
	var bar := get_viewport().get_visible_rect().size.y * letterbox
	_speaker.offset_top = -bar - 92.0
	_speaker.offset_bottom = -bar - 62.0
	_subtitle.offset_top = -bar - 60.0
	_subtitle.offset_bottom = -bar - 16.0
