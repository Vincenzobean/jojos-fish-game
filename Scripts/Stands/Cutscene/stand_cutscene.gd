# The building blocks every stand cutscene shares: its own camera between letterbox bars, moved by
# shots, and the drama on top. The finisher (finisher_director.gd) and the clash when a fished stand
# charges the player (clash_director.gd) extend this and script their sequences with it.
#
# Everything runs on game time, so slow-motion (slowmo()) stretches it all: waits, moves, camera moves,
# animations and effects.
#   * Camera: cut(), shot() (blending over time), shake(). Points may be a Vector3 or a Callable that
#     returns one, so the camera can follow things that move. It never goes into the ground or water.
#   * Drama: slowmo(), impact_frame() (a few frames of stark, inverted screen with speed lines),
#     effect() (StandEffects, sized by stand_size), sfx() (manga sound-effect lettering).
#   * open_cutscene() and close_cutscene() bring the camera and bars in and take them away.
# `phase` names each step as the cutscene reaches it (for tests and anything that wants to follow along).
# Purely presentation.
# Generated by Claude Code.
class_name StandCutscene
extends Node

## The cutscene reached a new step (e.g. "rush", "grab").
signal phase(step: String)
## It's over and everything's been handed back.
signal finished

const ImpactShader := preload("res://assets/fx/impact_frame.gdshader")
const Crater := preload("res://Scripts/World/crater.gd")

@export var letterbox := 0.11 ## Share of the screen height each bar covers.

var camera: Camera3D
var stand_size := 2.8 ## What effects are sized by: the stand's height.

var _cam_from: Callable # Where the camera is...
var _cam_look: Callable # ...and what it looks at.
var _cam_from_before := Vector3.ZERO # Where it was when the current shot began...
var _cam_look_before := Vector3.ZERO
var _cam_blend := 1.0 # ...and how far into that shot (1: there).
var _shake := 0.0
var _slowmo_token := 0
var _layer: CanvasLayer
var _bars: Array[ColorRect] = []
var _impact: ColorRect


## Waits `seconds` of game time (stretched by slow-motion).
func wait(seconds: float) -> Signal:
	return get_tree().create_timer(seconds, false).timeout


## Names the step the cutscene has reached.
func step(step_name: String) -> void:
	phase.emit(step_name)


## Cuts the camera straight to `from`, looking at `look` (each a Vector3 or a Callable to follow).
func cut(from: Variant, look: Variant, fov := 55.0) -> void:
	_cam_from = _fn(from)
	_cam_look = _fn(look)
	_cam_blend = 1.0
	camera.fov = fov
	_place_camera()


## Moves the camera over `seconds` from wherever it is to `from`, looking at `look`.
func shot(from: Variant, look: Variant, seconds: float, fov := 55.0) -> void:
	_cam_from_before = camera.global_position
	_cam_look_before = camera.global_position - camera.global_basis.z * 5.0
	_cam_from = _fn(from)
	_cam_look = _fn(look)
	_cam_blend = 0.0
	var tween := create_tween().set_parallel()
	tween.tween_property(self, "_cam_blend", 1.0, maxf(seconds, 0.001)).set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_IN_OUT)
	tween.tween_property(camera, "fov", fov, maxf(seconds, 0.001))


func shake(strength: float) -> void:
	_shake = maxf(_shake, strength)


## Slows the game to `scale` for `seconds` of real time.
func slowmo(scale: float, seconds: float) -> void:
	_slowmo_token += 1
	var token := _slowmo_token
	Engine.time_scale = scale
	await get_tree().create_timer(seconds, true, false, true).timeout
	if token == _slowmo_token:
		Engine.time_scale = 1.0


## A manga impact frame: `frames` rendered frames of stark black-and-white (inverted unless told not to),
## speed lines bursting from `focus` (world).
func impact_frame(focus: Vector3, frames := 3, inverted := true) -> void:
	var material := _impact.material as ShaderMaterial
	var screen := camera.unproject_position(focus) / Vector2(get_viewport().get_visible_rect().size)
	material.set_shader_parameter("focus", screen)
	material.set_shader_parameter("invert", 1.0 if inverted else 0.0)
	_impact.visible = true
	for i in frames:
		material.set_shader_parameter("seed", randf() * 100.0)
		await get_tree().process_frame
	_impact.visible = false


## A StandEffects effect at `at` (`toward` for ones that go somewhere), sized to the stand.
func effect(effect_name: String, at: Vector3, size_scale := 1.0, toward := Vector3.ZERO) -> void:
	StandEffects.spawn(effect_name, get_tree().current_scene, at, stand_size * size_scale, toward)


## Manga sound-effect lettering where `at` (world) is on screen: big, tilted, ink-edged, popping in and
## fading. Drawn flat on the screen, so it's the same size however near the camera is.
func sfx(text: String, at: Vector3, color := Color(1.0, 0.92, 0.3), size := 1.0) -> void:
	var label := Label.new()
	label.text = text
	label.add_theme_font_size_override("font_size", int(84 * size))
	label.add_theme_color_override("font_color", color)
	label.add_theme_color_override("font_outline_color", Color(0.06, 0.06, 0.08))
	label.add_theme_constant_override("outline_size", int(22 * size))
	label.mouse_filter = Control.MOUSE_FILTER_IGNORE
	_layer.add_child(label)
	label.size = label.get_minimum_size()
	label.pivot_offset = label.size * 0.5
	var screen := get_viewport().get_visible_rect().size
	var spot := camera.unproject_position(at) if not camera.is_position_behind(at) else screen * 0.5
	spot = spot.clamp(label.size * 0.5 + Vector2(20.0, screen.y * letterbox + 10.0), screen - label.size * 0.5 - Vector2(20.0, screen.y * letterbox + 10.0))
	label.position = spot - label.size * 0.5
	label.rotation = randf_range(-0.25, 0.25)
	label.scale = Vector2.ONE * 0.3
	var tween := label.create_tween()
	tween.tween_property(label, "scale", Vector2.ONE * 1.15, 0.08).set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_OUT)
	tween.tween_property(label, "scale", Vector2.ONE, 0.06)
	tween.tween_interval(0.35)
	tween.tween_property(label, "modulate:a", 0.0, 0.25)
	tween.tween_callback(label.queue_free)


## The ground (or water surface) straight below `point`: {"position": Vector3, "water": bool}.
func ground_below(point: Vector3) -> Dictionary:
	var ground := point.y - 20.0
	var from := point + Vector3.UP * 60.0
	var space := get_viewport().get_world_3d().direct_space_state
	for attempt in 8: # The terrain itself: past anything standing on it (trees, rocks, stands).
		var hit := space.intersect_ray(PhysicsRayQueryParameters3D.create(from, point + Vector3.DOWN * 200.0))
		if hit.is_empty():
			break
		if hit["collider"] is StaticBody3D and Crater._is_terrain(hit["collider"], hit["shape"]):
			ground = hit["position"].y
			break
		from = hit["position"] + Vector3.DOWN * 0.05
	var water := get_tree().get_first_node_in_group("water")
	var surface: float = water.surface_height_at(point) if water else -INF
	return {"position": Vector3(point.x, maxf(ground, surface), point.z), "water": surface > ground}


# --- Opening and closing --------------------------------------------------------------------------------

## Brings in the cutscene's camera (starting where `from` is, or at `start`) looking at `look`, and the bars.
func open_cutscene(from: Camera3D, look: Vector3, start := Transform3D()) -> void:
	camera = Camera3D.new()
	get_tree().current_scene.add_child(camera)
	camera.global_transform = from.global_transform if from else start
	camera.make_current()
	_cam_from = _fn(camera.global_position)
	_cam_look = _fn(look)
	_build_overlay()
	var height := get_viewport().get_visible_rect().size.y * letterbox
	var tween := create_tween().set_parallel()
	tween.tween_property(_bars[0], "offset_bottom", height, 0.35).set_ease(Tween.EASE_OUT)
	tween.tween_property(_bars[1], "offset_top", -height, 0.35).set_ease(Tween.EASE_OUT)


## Takes the bars away (await it) and ends any slow-motion; free_cutscene() then drops the camera.
func close_cutscene() -> void:
	_slowmo_token += 1
	Engine.time_scale = 1.0
	var tween := create_tween().set_parallel()
	tween.tween_property(_bars[0], "offset_bottom", 0.0, 0.35).set_ease(Tween.EASE_IN)
	tween.tween_property(_bars[1], "offset_top", 0.0, 0.35).set_ease(Tween.EASE_IN)
	await tween.finished


func free_cutscene() -> void:
	if is_instance_valid(camera):
		camera.queue_free()
	if is_instance_valid(_layer):
		_layer.queue_free()


func _process(delta: float) -> void:
	if camera:
		_tick_camera(delta)


# The shake dying away, and the camera placed for the shot.
func _tick_camera(delta: float) -> void:
	_shake = move_toward(_shake, 0.0, delta * 2.5)
	_place_camera()


func _place_camera() -> void:
	if not _cam_from.is_valid():
		return
	var weight := ease(clampf(_cam_blend, 0.0, 1.0), -1.6)
	var from: Vector3 = _cam_from_before.lerp(_cam_from.call(), weight)
	var look: Vector3 = _cam_look_before.lerp(_cam_look.call(), weight)
	# Never inside the hill or under the water.
	var floor_at: float = ground_below(from)["position"].y + 0.6
	from.y = maxf(from.y, floor_at)
	from += Vector3(randf_range(-1.0, 1.0), randf_range(-1.0, 1.0), randf_range(-1.0, 1.0)) * _shake * 0.35
	camera.global_position = from
	if from.distance_to(look) > 0.01:
		var up := Vector3.UP if absf((look - from).normalized().y) < 0.98 else Vector3.FORWARD
		camera.look_at(look, up)


# The letterbox bars and the impact frame, on top of everything.
func _build_overlay() -> void:
	_layer = CanvasLayer.new()
	_layer.layer = 50
	add_child(_layer)
	for preset in [Control.PRESET_TOP_WIDE, Control.PRESET_BOTTOM_WIDE]:
		var bar := ColorRect.new()
		bar.color = Color.BLACK
		bar.mouse_filter = Control.MOUSE_FILTER_IGNORE
		_layer.add_child(bar)
		bar.set_anchors_and_offsets_preset(preset)
		bar.offset_top = 0.0
		bar.offset_bottom = 0.0
		_bars.append(bar)
	_impact = ColorRect.new()
	_impact.mouse_filter = Control.MOUSE_FILTER_IGNORE
	var material := ShaderMaterial.new()
	material.shader = ImpactShader
	_impact.material = material
	_impact.visible = false
	_layer.add_child(_impact)
	_impact.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)


# `point` as a Callable returning it.
static func _fn(point: Variant) -> Callable:
	if point is Callable:
		return point
	var fixed: Vector3 = point
	return func() -> Vector3: return fixed
