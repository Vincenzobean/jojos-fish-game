# The Anchovy Stand's School Formation as a cutscene (possession.gd plays it when the move asks,
# stand_combat.gd formation_requested). Played with the shared building blocks (stand_cutscene.gd):
#
#   1. Gather: the fight freezes and the camera swings round in front of the stand as a school of
#      anchovies (anchovy_school.gd) swirls in round it, the stand's arms flung wide (its move's animation).
#   2. Merge: the school pours into it and it bursts out bigger (stand_combat.gd set_formed(); the visuals
#      ease it up to its new size), the camera pulling back to show it.
#
# While it plays the opponents (the "stand_opponents" group) are frozen where they are and the stand
# can't be flown. Afterward everything is handed back and the player's camera is current again.
# Purely presentation, but for set_formed() at the end, which is what the move asked for.
# Generated by Claude Code.
class_name FormationDirector
extends StandCutscene

const StandShape := preload("res://Scripts/Stands/stand_shape.gd")

var stand: Node3D # The Anchovy (stand_body.gd).
var combat: Node # Its stand_combat.gd.
var move: SchoolFormationMove

var _user_camera: Camera3D
var _frozen: Array[Node] = []


## Plays `formation` (a SchoolFormationMove) for `own`, whose fighting is `fighting` (stand_combat.gd),
## starting from the view of `user_camera` (the stand camera), which is made current again after.
func setup(own: Node3D, fighting: Node, formation: SchoolFormationMove, user_camera: Camera3D) -> void:
	stand = own
	combat = fighting
	move = formation
	_user_camera = user_camera
	stand_size = StandShape.size(stand)


## Plays it from start to end. Await it.
func run() -> void:
	_freeze(true)
	var center := func() -> Vector3: return stand.torso.global_position if is_instance_valid(stand) else Vector3.ZERO
	var facing := StandShape.facing(stand.torso)
	var side := facing.cross(Vector3.UP).normalized()
	open_cutscene(_user_camera, center.call())

	# 1: the school swirls in.
	step("gather")
	var school := AnchovySchool.make(get_tree().current_scene, center, stand_size * 0.9, 44, stand_size / 1.9 * 1.5)
	school.radius = stand_size * 2.2
	var tighten := school.create_tween()
	tighten.tween_property(school, "radius", stand_size * 0.6, 1.1).set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_OUT)
	cut(center.call() + facing * stand_size * 2.0 + side * stand_size * 0.6 + Vector3.UP * stand_size * 0.1, center, 50.0)
	shot(center.call() + facing * stand_size * 1.4 - side * stand_size * 0.9 + Vector3.UP * stand_size * 0.3, center, 1.2, 46.0)
	sfx("ZAWA ZAWA", center.call() + Vector3.UP * stand_size * 0.6 + side * stand_size * 0.5, Color(0.75, 0.88, 1.0), 0.8)
	await wait(1.25)

	# 2: it pours in, and the stand bursts out bigger.
	step("merge")
	await school.gather(0.35)
	if is_instance_valid(combat):
		combat.set_formed(move)
	effect("burst", center.call(), 0.9)
	effect("shockwave", center.call(), 0.8)
	impact_frame(center.call(), 3)
	shake(1.0)
	sfx("GOGOGOGO!", center.call() + Vector3.UP * stand_size * 0.8 - side * stand_size * 0.5, Color(1.0, 0.85, 0.3), 1.1)
	shot(center.call() + facing * stand_size * 3.0 + Vector3.UP * stand_size * 0.6, center, 0.5, 55.0)
	await wait(0.6)

	await close_cutscene()
	_freeze(false)
	if is_instance_valid(_user_camera):
		_user_camera.make_current()
	free_cutscene()
	finished.emit()


# Freezes (or unfreezes) the opponents and the stand's own flying.
func _freeze(frozen: bool) -> void:
	if frozen:
		for opponent in get_tree().get_nodes_in_group("stand_opponents"):
			if opponent.process_mode != Node.PROCESS_MODE_DISABLED:
				opponent.process_mode = Node.PROCESS_MODE_DISABLED
				_frozen.append(opponent)
		var controller := stand.get_node_or_null("Controller")
		if controller:
			controller.set_physics_process(false)
			_frozen.append(controller)
		stand.torso.freeze = true
		stand.torso.linear_velocity = Vector3.ZERO
		return
	for node in _frozen:
		if not is_instance_valid(node):
			continue
		if node.process_mode == Node.PROCESS_MODE_DISABLED:
			node.process_mode = Node.PROCESS_MODE_INHERIT
		else:
			node.set_physics_process(true)
	_frozen.clear()
	if is_instance_valid(stand):
		stand.torso.freeze = false
