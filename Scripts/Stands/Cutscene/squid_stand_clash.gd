# The Squid Stand's clash (stand_clash.gd): only its two upper tentacles appear, shooting out over its
# shoulders to wrap the fist mid-punch and hold it. The Squid appears holding on, swings the wild stand up
# and slams it down, puffing a cloud of ink, then flings it away and squares up.
# Purely presentation.
# Generated by Claude Code.
class_name SquidStandClash
extends StandClash


func perform(d: ClashDirector, forward: Vector3, side: Vector3) -> void:
	var visuals: Node = d._ally_visuals
	# The tentacles seize the fist.
	d.step("seize")
	d._fade_in(["TentacleFL", "TentacleFR"], 0.08)
	visuals.play(make_seize(1.0), true)
	d.lock_point = func() -> Vector3: return (visuals.tentacle_tip("TentacleFL") + visuals.tentacle_tip("TentacleFR")) * 0.5
	d.lock()
	var fist: Vector3 = d._enemy_visuals.fist("R")
	d.effect("impact", fist, 0.6)
	d.effect("shockwave", fist, 0.35)
	d.impact_frame(fist, 3)
	d.shake(0.6)
	d.sfx("GRAB!", fist + Vector3.UP * 0.6 + side * 0.4, Color(1.0, 0.75, 0.8), 0.85)
	d.cut(fist + side * 2.6 + forward * 0.2 + Vector3.UP * 0.35, func() -> Vector3: return (d.enemy.torso.global_position + d.ally.torso.global_position) * 0.5, 42.0)
	d._enemy_visuals.play(StandFinisher.make_pose(StandAnimation.over(DefaultStandMoves.haymaker_strike(), {"shake": 3.0}), 0.05), true)
	await d.wait(0.22) # (In slow motion.)

	# The Squid appears, holding on, and hauls it up...
	d.step("haul")
	Engine.time_scale = 1.0
	d._fade_in(ClashDirector.PARTS + ClashDirector.TENTACLES + ["Companion"], 0.25)
	d.shot(d.ally.torso.global_position + side * 2.4 - forward * 1.6 + Vector3.UP * 0.8, d._enemy_at, 0.3, 52.0)
	visuals.play(make_seize(0.6, 140.0), true)
	await d.wait(0.3)

	# ...and slams it down.
	d.step("slam")
	d.unlock()
	visuals.play(make_seize(0.7, 55.0, 20.0), true)
	var below := d.ground_below(d._enemy_at())
	var floor_at: Vector3 = below["position"]
	await d._move(d.enemy, Vector3(d._enemy_at().x, floor_at.y + d.stand_size * 0.3, d._enemy_at().z), 0.16, Tween.TRANS_QUAD, Tween.EASE_IN)
	d.effect("splash" if below["water"] else "dust", floor_at, 0.7)
	d.effect("impact", d._enemy_at(), 0.9)
	d.effect("ink_cloud", d.ally.torso.global_position + Vector3.UP * d.stand_size * 0.3, 0.4)
	d.impact_frame(d._enemy_at(), 4)
	d.shake(1.2)
	d.sfx("SLAM!", d._enemy_at() + Vector3.UP * 0.8 - side * 0.6, Color(1.0, 0.85, 0.3), 1.1)
	await d.wait(0.2)
	visuals.play(StandFinisher.make_pose(StandAnimation.over(DefaultStandMoves.GUARD, {"TentacleFL": Vector3(75, 0, 20), "TentacleFR": Vector3(75, 0, -20), "tentacle_reach": 0.4}), 0.06), true)
	await d.send_flying(forward, forward, side)
	await d._manifest(forward, side)


## Its upper tentacles shot out ahead over its shoulders (`reach` of their full stretch), swung `lift`
## degrees up from hanging (about 105 is out ahead over the shoulders), leaning in by `lean` degrees.
static func make_seize(reach: float, lift := 105.0, lean := -10.0) -> StandKeyframeAnimation:
	return StandFinisher.make_pose(DefaultStandMoves.on_guard({"Rig": Vector3(lean, 0, 0), "Neck": Vector3(-10, 0, 0),
		"TentacleFL": Vector3(lift, 0, 8), "TentacleFR": Vector3(lift, 0, -8),
		"TentacleBL": Vector3(25, 0, 20), "TentacleBR": Vector3(25, 0, -20),
		"tentacle_reach": reach, "tentacle_curl": -18.0}), 0.04) # Curled down round what they hold.
