# The Anchovy Stand's clash (stand_clash.gd): instead of a hand catching the punch, a school of anchovies
# bursts up into its path as a living shield, the fist driving into the swirl. Then the school pours
# together into the Anchovy (only it appearing where the fish were), which answers with a blur of jabs
# that sends the wild stand flying, and squares up.
# Purely presentation.
# Generated by Claude Code.
class_name AnchovyStandClash
extends StandClash


func perform(d: ClashDirector, forward: Vector3, side: Vector3) -> void:
	# The shield: fish everywhere round the fist, swirling.
	d.step("shield")
	var fist: Vector3 = d._enemy_visuals.fist("R")
	var school := AnchovySchool.make(d.get_tree().current_scene, fist, d.stand_size * 0.3, 40, d.stand_size / 1.9 * 1.6)
	school.spin = 7.0
	d.effect("burst", fist, 0.5)
	d.impact_frame(fist, 2)
	d.shake(0.5)
	d.sfx("SHWAAA!", fist + Vector3.UP * 0.6 + side * 0.4, Color(0.8, 0.9, 1.0), 0.85)
	d.cut(fist + side * 2.4 + forward * 0.2 + Vector3.UP * 0.35, fist, 44.0)
	d._enemy_visuals.play(StandFinisher.make_pose(StandAnimation.over(DefaultStandMoves.haymaker_strike(), {"shake": 3.0}), 0.05), true) # Stuck in the swirl.
	await d.wait(0.24) # (In slow motion.)

	# The school pours into the Anchovy.
	d.step("form")
	Engine.time_scale = 1.0
	var middle := func() -> Vector3: return d.ally.torso.global_position
	school.center = middle
	school.radius = maxf(school.radius, d.stand_size * 0.5)
	d.shot(d.ally.torso.global_position + side * 2.6 - forward * 1.2 + Vector3.UP * 0.6, middle, 0.35, 50.0)
	d._fade_in(ClashDirector.PARTS + ["Companion"], 0.35)
	await school.gather(0.35)
	d.effect("burst", d.ally.torso.global_position, 0.5)

	# A blur of jabs.
	d.step("flurry")
	d._ally_visuals.play(DefaultStandMoves.make_barrage().animation, true)
	d.sfx("DADADADA!", d._enemy_visuals.head_top() + Vector3.UP * 0.5 - side * 0.5, Color(0.8, 0.9, 1.0), 1.0)
	for i in 8:
		var at: Vector3 = d.enemy.torso.global_position + Vector3(randf_range(-0.2, 0.2), randf_range(-0.1, 0.4), randf_range(-0.2, 0.2)) * d.stand_size
		d.effect("impact", at, 0.5)
		d.shake(0.25)
		await d.wait(0.06)
	d._ally_visuals.play(StandFinisher.make_pose(DefaultStandMoves.on_guard({"Rig": Vector3(-8, 30, 0),
		"ShoulderR": Vector3(90, 0, 0), "ElbowR": Vector3(0, 0, 0)}), 0.03), true) # The last jab, all the way out.
	d.unlock()
	d.impact_frame(d._enemy_visuals.head_top(), 3)
	await d.send_flying(forward, forward, side)
	await d._manifest(forward, side)
