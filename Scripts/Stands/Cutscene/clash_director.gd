# The clash when a stand bites while the player has a stand of their own (stand_encounter.gd makes one of
# these and awaits run()). Played as a cutscene with the shared building blocks (stand_cutscene.gd):
#
#   1. Burst: the wild stand erupts out of the water where it bit, glaring at the player.
#   2. Charge: it rockets at the player, right fist cocked, the world slowing as it closes in...
#   3. Punch: ...and throws it straight at the player's face.
#   4. Catch: only the left arm of the player's stand appears, catching the fist dead in its palm.
#   5. Hook: its right arm appears too and a right hook sends the wild stand flying away, tumbling.
#   6. Manifest: the whole stand appears in front of the player, squaring up, and the camera swings in
#      behind it, ready for the fight.
#
# Steps 4-6 are the player's stand's own (stand_body.gd get_clash(), a StandClash): the default is the
# catch, hook and manifest above, and a stand can save its user its own way (the Anchovy's school
# shielding them, the Squid's tentacles seizing the fist), using the helpers and poses here.
#
# Both stands are frozen and placed by hand while it plays (their torsos moved, poses played through their
# visuals); the player's stand is shown a part at a time with its visuals' set_part_fade(). Afterward
# both are unfrozen where they ended up, posing nothing, and the caller hands control over and frees this.
# Purely presentation.
# Generated by Claude Code.
class_name ClashDirector
extends StandCutscene

const StandShape := preload("res://Scripts/Stands/stand_shape.gd")
const PARTS := ["Torso", "Head", "UpperArmL", "UpperArmR", "ForearmL", "ForearmR", "ThighL", "ThighR", "ShinL", "ShinR"]
const TENTACLES := ["TentacleFL", "TentacleFR", "TentacleBL", "TentacleBR"] # On a stand that has them.

@export var charge_speed := 22.0 ## m/s the wild stand charges at (the charge lasts 0.4 to 1.2 s).
@export var knock_distance := 9.0 ## Meters the hook sends it.
@export var punch_time := 0.13 ## Game seconds the punch takes to reach full extension (in slow motion).

var enemy: Node3D # The wild stand (stand_body.gd).
var ally: Node3D # The player's stand.
var player: Node3D

var _enemy_visuals: Node
var _ally_visuals: Node
var _player_camera: Camera3D
var _locked := false # The wild stand's fist is held at lock_point...
## ...where it's held while locked (world): the player's stand's left palm unless a clash says otherwise.
var lock_point: Callable


## Plays the clash between `wild` (fished up, posed upright) and `own` (the player's stand, just brought
## out), in front of `user` (the player), starting from the view of `user_camera`.
func setup(wild: Node3D, own: Node3D, user: Node3D, user_camera: Camera3D) -> void:
	enemy = wild
	ally = own
	player = user
	_player_camera = user_camera
	_enemy_visuals = enemy.get_node("Visuals")
	_ally_visuals = ally.get_node("Visuals")
	stand_size = StandShape.size(enemy)
	lock_point = func() -> Vector3: return _ally_visuals.fist("L")


## Plays it from start to end. Await it.
func run() -> void:
	for stand: Node3D in [enemy, ally]:
		var torso: RigidBody3D = stand.torso
		torso.freeze = true
		torso.linear_velocity = Vector3.ZERO
		torso.angular_velocity = Vector3.ZERO
	for part: String in PARTS + TENTACLES:
		_ally_visuals.set_part_fade(part, 0.0)
	_ally_visuals.set_part_fade("Companion", 0.0)
	# Not their summons (with its effects): the clash poses them from here.
	_ally_visuals.play(StandFinisher.make_pose(DefaultStandMoves.GUARD, 0.01), true)
	_enemy_visuals.play(StandFinisher.make_pose(DefaultStandMoves.GUARD, 0.01), true)

	var forward := StandShape.flat(_enemy_at() - player.global_position) # From the player toward the wild stand.
	var side := forward.cross(Vector3.UP).normalized() # The player's right, looking at it.
	var eye := player.global_position + Vector3.UP * 0.6
	_place(ally, _ally_spot(forward))
	_face(ally, forward)
	_face(enemy, -forward)
	open_cutscene(_player_camera, _enemy_at())

	await _burst(forward, side, eye)
	await _charge(forward, side)
	var clash: StandClash = ally.get_clash() if ally.has_method("get_clash") else StandClash.new()
	await clash.perform(self, forward, side)

	_ally_visuals.clear_part_fades()
	_enemy_visuals.cancel()
	_ally_visuals.cancel()
	await close_cutscene()
	for stand: Node3D in [enemy, ally]:
		if is_instance_valid(stand):
			stand.torso.freeze = false
	finished.emit()


# 1: up out of the water where it bit, with a great splash, seen over the player's shoulder.
func _burst(forward: Vector3, side: Vector3, eye: Vector3) -> void:
	step("burst")
	var start := _enemy_at()
	var surface := ground_below(start)["position"] as Vector3
	var risen := Vector3(start.x, surface.y + stand_size * 0.45, start.z)
	enemy.torso.global_position = Vector3(start.x, surface.y - stand_size * 0.3, start.z)
	cut(eye - forward * 1.8 + side * 0.9 + Vector3.UP * 0.4, risen, 55.0)
	shot(eye - forward * 1.4 + side * 0.7 + Vector3.UP * 0.3, risen, 0.9, 42.0) # Pushing in on it.
	_enemy_visuals.play(StandFinisher.make_pose(DefaultStandMoves.on_guard({"Rig": Vector3(12, 0, 0), "Neck": Vector3(15, 0, 0),
		"ShoulderL": Vector3(-20, 0, -40), "ShoulderR": Vector3(-20, 0, 40),
		"ElbowL": Vector3(30, 0, 0), "ElbowR": Vector3(30, 0, 0)}), 0.1), true)
	var water := get_tree().get_first_node_in_group("water")
	if water:
		water.splash(risen, 1.0)
	effect("splash", surface, 0.8)
	effect("shockwave", surface, 0.5)
	await _move(enemy, risen, 0.35, Tween.TRANS_CUBIC, Tween.EASE_OUT)
	sfx("ZUOOO!", risen + Vector3.UP * stand_size * 0.4, Color(0.75, 0.9, 1.0), 0.9)
	await wait(0.55)


# 2-3: rockets at the player, fist cocked, slowing as it closes in, and throws the punch.
func _charge(forward: Vector3, side: Vector3) -> void:
	step("charge")
	var ally_at: Vector3 = ally.torso.global_position # Placed at the start (_ally_spot()).
	var strike_at := ally_at + forward * stand_size * 0.95 # Where its fist meets the palm, about.
	var from := _enemy_at()
	var seconds := clampf(from.distance_to(strike_at) / charge_speed, 0.4, 1.2)
	_enemy_visuals.play(make_charge(), true)
	effect("sonic_boom", from, 0.8, -forward)
	cut(player.global_position + side * 3.6 + forward * 1.2 + Vector3.UP * 0.5, _enemy_at, 62.0)
	shot(player.global_position + side * 2.4 + forward * 0.6 + Vector3.UP * 0.6,
		func() -> Vector3: return (_enemy_at() + player.global_position) * 0.5, seconds, 50.0)
	var arrive := _move(enemy, strike_at, seconds, Tween.TRANS_QUAD, Tween.EASE_IN)
	await wait(seconds * 0.7)
	slowmo(0.2, 1.6) # It's nearly on them...
	await arrive

	step("punch")
	slowmo(0.2, 1.6) # Its own slow motion, however long the charge took (the catch is in it too).
	_enemy_visuals.play(StandFinisher.make_pose(DefaultStandMoves.haymaker_strike(), punch_time), true)
	cut(player.global_position + side * 1.5 + forward * 0.4 + Vector3.UP * 0.75, func() -> Vector3: return _enemy_visuals.fist("R"), 48.0)
	await wait(punch_time + 0.03) # The fist all the way out before it's caught.


## Lets go of whatever holds the wild stand's fist.
func unlock() -> void:
	_locked = false


## Holds the wild stand's fist at lock_point until unlock().
func lock() -> void:
	_locked = true


# 4: only the left arm of the player's stand, catching the fist in its palm.
func _catch(forward: Vector3, side: Vector3) -> void:
	step("catch")
	_ally_visuals.play(make_catch(), true)
	_locked = true
	_fade_in(["UpperArmL", "ForearmL"], 0.08)
	var fist: Vector3 = _ally_visuals.fist("L")
	effect("impact", fist, 0.6)
	effect("shockwave", fist, 0.35)
	impact_frame(fist, 3)
	shake(0.6)
	sfx("CATCH!", fist + Vector3.UP * 0.6 + side * 0.4, Color(1.0, 0.95, 0.85), 0.85)
	var middle := func() -> Vector3: return (_enemy_at() + ally.torso.global_position) * 0.5
	cut(fist + side * 2.6 + forward * 0.2 + Vector3.UP * 0.35, middle, 42.0)
	_enemy_visuals.play(StandFinisher.make_pose(StandAnimation.over(DefaultStandMoves.haymaker_strike(), {"shake": 3.0}), 0.05), true) # Straining against it.
	await wait(0.22) # (In slow motion.)


# 5: the right arm appears too and hooks it away, tumbling, into the distance.
func _hook(forward: Vector3, side: Vector3) -> void:
	step("hook")
	Engine.time_scale = 1.0
	_fade_in(["UpperArmR", "ForearmR"], 0.1)
	_ally_visuals.play(make_hook_windup(), true)
	shot(ally.torso.global_position + side * 2.2 - forward * 1.4 + Vector3.UP * 0.6, _enemy_at, 0.25, 50.0)
	await wait(0.22)
	_ally_visuals.play(make_hook(), true)
	await wait(0.06)
	_locked = false
	var head: Vector3 = _enemy_visuals.head_top()
	effect("impact", head, 0.9)
	effect("shockwave", head, 0.6)
	impact_frame(head, 4)
	shake(1.2)
	sfx("BAM!", head + Vector3.UP * 0.4 - side * 0.6, Color(1.0, 0.85, 0.3), 1.1)
	await send_flying((forward * 0.85 - side * 0.5).normalized(), forward, side) # A right hook swings from its right to its left.


## The wild stand sent flying `away` (flat, unit) knock_distance, tumbling, until it lands (on the water
## with a splash) and shakes it off, facing the player's stand.
func send_flying(away: Vector3, forward: Vector3, side: Vector3) -> void:
	slowmo(0.35, 0.35)
	var landing := _enemy_at() + away * knock_distance
	var below := ground_below(landing)
	landing.y = maxf(landing.y, (below["position"] as Vector3).y + stand_size * 0.55)
	_enemy_visuals.play(make_tumble(), true)
	cut(ally.torso.global_position - forward * 3.0 + side * 1.2 + Vector3.UP * 1.0, _enemy_at, 55.0)
	await _move(enemy, landing + Vector3.UP * stand_size * 0.6, 0.45, Tween.TRANS_QUAD, Tween.EASE_OUT)
	await _move(enemy, landing, 0.3, Tween.TRANS_QUAD, Tween.EASE_IN)
	if below["water"]:
		var water := get_tree().get_first_node_in_group("water")
		if water:
			water.splash(landing, 0.8)
		effect("splash", below["position"], 0.6)
	_face(enemy, ally.torso.global_position - _enemy_at())
	_enemy_visuals.play(StandFinisher.make_pose(DefaultStandMoves.on_guard({"Rig": Vector3(10, 0, 0), "Neck": Vector3(-15, 0, 0)}), 0.25), true) # Shaking it off.


# 6: the whole stand appears, squaring up, and the camera swings in behind it.
func _manifest(forward: Vector3, _side: Vector3) -> void:
	step("manifest")
	_fade_in(PARTS + TENTACLES + ["Companion"], 0.35)
	effect("burst", ally.torso.global_position, 0.6)
	effect("ready", ally.torso.global_position, 0.5)
	_ally_visuals.play(StandFinisher.make_pose(DefaultStandMoves.GUARD, 0.25), true)
	_face(ally, _enemy_at() - ally.torso.global_position)
	var behind := func() -> Vector3:
		var to := StandShape.flat(_enemy_at() - ally.torso.global_position)
		return ally.torso.global_position - to * 4.5 + Vector3.UP * 1.6
	shot(behind, _enemy_at, 0.7, 60.0)
	await wait(0.9)
	_enemy_visuals.play(StandFinisher.make_pose(DefaultStandMoves.GUARD, 0.25), true)
	await wait(0.2)


func _process(delta: float) -> void:
	if _locked and is_instance_valid(enemy) and is_instance_valid(ally):
		# Its fist stays where it's held, whatever the poses do.
		enemy.torso.global_position += lock_point.call() - _enemy_visuals.fist("R")
	super(delta)


# --- Helpers -------------------------------------------------------------------------------------------

func _enemy_at() -> Vector3:
	return enemy.torso.global_position


# Where the player's stand stands for the clash (its middle): just in front of the player, clear of
# them, at the height a summon stands at (possession.gd), so it's free to fly off once it's handed over
# rather than stuck in the ground or the player.
func _ally_spot(forward: Vector3) -> Vector3:
	var size := StandShape.size(ally)
	var spot := player.global_position + forward * (0.6 + size * 0.35)
	spot.y = (ground_below(spot)["position"] as Vector3).y + size * 0.6
	return spot


# Fades `parts` of the player's stand in over `seconds`.
func _fade_in(parts: Array, seconds: float) -> void:
	for part: String in parts:
		var tween := create_tween()
		tween.tween_method(func(amount: float) -> void: _ally_visuals.set_part_fade(part, amount), 0.0, 1.0, seconds)


func _move(stand: Node3D, to: Vector3, seconds: float, trans := Tween.TRANS_QUAD, easing := Tween.EASE_IN_OUT) -> Signal:
	var torso: Node3D = stand.torso
	var tween := create_tween()
	tween.tween_method(func(at: Vector3) -> void: torso.global_position = at, torso.global_position, to, maxf(seconds, 0.001)) \
		.set_trans(trans).set_ease(easing)
	return tween.finished


func _place(stand: Node3D, at: Vector3) -> void:
	stand.torso.global_position = at


func _face(stand: Node3D, direction: Vector3) -> void:
	var flat := StandShape.flat(direction)
	stand.torso.global_basis = Basis.looking_at(flat, Vector3.UP)


# --- Poses ---------------------------------------------------------------------------------------------

## Charging: leaning hard into it, the right fist cocked back for the punch (leaving afterimages).
static func make_charge() -> StandKeyframeAnimation:
	var anim := StandFinisher.make_pose(StandAnimation.over(DefaultStandMoves.haymaker_wind_up(), {"Rig": Vector3(-30, -35, 0), "Neck": Vector3(-15, 0, 0),
		"HipL": Vector3(-15, 0, -4), "HipR": Vector3(-25, 0, 4), "KneeL": Vector3(-30, 0, 0), "KneeR": Vector3(-20, 0, 0)}), 0.05)
	anim.afterimages = true
	return anim


## Catching a punch: turned a little side-on, the left arm straight out with the palm open to it.
static func make_catch() -> StandKeyframeAnimation:
	return StandFinisher.make_pose(DefaultStandMoves.on_guard({"Rig": Vector3(-6, -20, 0), "Neck": Vector3(-5, 15, 0),
		"ShoulderL": Vector3(88, 0, 6), "ElbowL": Vector3(5, 0, 0),
		"KneeL": Vector3(-35, 0, 0), "KneeR": Vector3(-25, 0, 0)}), 0.03)


## Still holding the fist, turned away to load the right hook, the right arm drawn back and out.
static func make_hook_windup() -> StandKeyframeAnimation:
	return StandFinisher.make_pose(DefaultStandMoves.on_guard({"Rig": Vector3(-6, -40, 0), "Neck": Vector3(-5, 30, 0),
		"ShoulderL": Vector3(88, 0, 10), "ElbowL": Vector3(10, 0, 0),
		"ShoulderR": Vector3(30, 0, 70), "ElbowR": Vector3(95, 0, 0),
		"KneeL": Vector3(-40, 0, 0), "KneeR": Vector3(-30, 0, 0)}), 0.06)


## The right hook landing: turned hard left through it, the bent right arm swung round in front, the
## left hand let go and pulled back.
static func make_hook() -> StandKeyframeAnimation:
	return StandFinisher.make_pose(DefaultStandMoves.on_guard({"Rig": Vector3(-12, 45, 0), "Neck": Vector3(-5, -20, 0),
		"ShoulderL": Vector3(40, 0, -25), "ElbowL": Vector3(110, 0, 0),
		"ShoulderR": Vector3(85, 0, -30), "ElbowR": Vector3(80, 0, 0),
		"KneeL": Vector3(-20, 0, 0), "KneeR": Vector3(-35, 0, 0)}), 0.03)


## Sent flying: limbs flung out, tumbling head over heels.
static func make_tumble() -> StandKeyframeAnimation:
	var flung := {"Neck": Vector3(30, 0, 0),
		"ShoulderL": Vector3(150, 0, -50), "ShoulderR": Vector3(150, 0, 50),
		"ElbowL": Vector3(20, 0, 0), "ElbowR": Vector3(20, 0, 0),
		"HipL": Vector3(-30, 0, -20), "HipR": Vector3(20, 0, 20), "KneeL": Vector3(-50, 0, 0), "KneeR": Vector3(-20, 0, 0)}
	var anim := StandKeyframeAnimation.new()
	anim.duration = 60.0
	anim.blend_in = 0.03
	anim.blend_out = 0.2
	anim.keys = [
		StandKeyframeAnimation.key(0.0, StandAnimation.over(flung, {"Rig": Vector3(0, 0, 0)})),
		StandKeyframeAnimation.key(0.25, StandAnimation.over(flung, {"Rig": Vector3(200, 0, 0)})),
		StandKeyframeAnimation.key(0.5, StandAnimation.over(flung, {"Rig": Vector3(360, 0, 0)})),
		StandKeyframeAnimation.key(0.75, {"Rig": Vector3(370, 0, 0)}),
	]
	return anim
