# A rival's intro, when the player challenges one on his island (stand_encounter.gd duel() makes one of
# these and awaits run()). Short, about three seconds, with the shared cutscene blocks (stand_cutscene.gd):
#
#   1. Taunt: close on him as he points at the player, one line of his as a subtitle under his name.
#   2. Summon: a burst beside him and his stand is there ("spawn_rival", its name called out).
#   3. Answer: back behind the player, whose own stand comes out in front of them ("spawn_ally"), and
#      "FIGHT!".
#
# Both stands are frozen in place while it plays, and let go at the end. skip_cutscene jumps to the end.
# Purely presentation.
# Generated by Claude Code.
extends StandCutscene

const StandShape := preload("res://Scripts/Stands/stand_shape.gd")
const RivalState := preload("res://Scripts/World/rival_user.gd").State

## What a rival may say as he points (one, at random).
const LINES := [
	"This island's mine. Come take it, then!",
	"You've got a stand? So do I.",
	"Nobody lands here without a fight.",
	"Let's see what you fished up.",
	"Turn back now, or get knocked back.",
]

var rival: Node3D # rival_user.gd
var enemy: Node3D
var ally: Node3D

var _spawn_rival: Callable
var _spawn_ally: Callable
var _player: Node3D
var _player_camera: Camera3D
var _skipping := false
var _subtitle: Label
var _speaker: Label


## Plays the intro for `the_rival`, challenged by `the_player`, from `user_camera`'s view. `spawn_rival`
## and `spawn_ally` bring out his stand and the player's (each returns it) when the cutscene reaches them.
func setup(the_rival: Node3D, the_player: Node3D, user_camera: Camera3D, spawn_rival: Callable, spawn_ally: Callable) -> void:
	rival = the_rival
	_player = the_player
	_player_camera = user_camera
	_spawn_rival = spawn_rival
	_spawn_ally = spawn_ally


## Plays it from start to end. Await it.
func run() -> void:
	var front := StandShape.flat(_player.global_position - rival.global_position) # From him toward the player.
	var side := front.cross(Vector3.UP)
	var head: Vector3 = rival.head()
	open_cutscene(_player_camera, head)
	_build_subtitles()

	# 1: he points.
	step("taunt")
	rival.set_state(RivalState.TAUNT)
	cut(head + front * 2.6 + side * 1.3 + Vector3.DOWN * 0.1, head, 45.0)
	shot(head + front * 2.0 + side * 0.8, head, 1.6, 40.0)
	await _say(LINES.pick_random())

	# 2: his stand.
	step("summon")
	if _spawn_rival.is_valid():
		enemy = _spawn_rival.call()
	if enemy:
		_hold(enemy, front)
		var at: Vector3 = enemy.torso.global_position
		effect("burst", at, 1.0)
		cut(at + front * 5.0 + side * 2.5 + Vector3.UP * 0.8, at, 50.0)
		sfx(rival.stand_name().to_upper() + "!", at + Vector3.UP * 1.5, Color(1.0, 0.92, 0.3), 1.0)
		shake(0.3)
	_say_now("")
	await _beat(1.0)

	# 3: the player's stand answers.
	step("answer")
	if _spawn_ally.is_valid():
		ally = _spawn_ally.call()
	if ally:
		_hold(ally, -front)
	var player_at := _player.global_position
	cut(player_at - front * 2.5 + side * 1.2 + Vector3.UP * 1.6, rival.global_position + Vector3.UP * 1.2, 55.0)
	await _beat(0.5)
	var mid: Vector3 = (player_at + rival.global_position) * 0.5 + Vector3.UP * 2.0
	sfx("FIGHT!", mid, Color(1.0, 0.92, 0.3), 1.3)
	await _beat(0.7)

	_subtitle.visible = false
	_speaker.visible = false
	await close_cutscene()
	for stand: Node3D in [enemy, ally]:
		if is_instance_valid(stand):
			stand.torso.freeze = false
	finished.emit()


func _unhandled_input(event: InputEvent) -> void:
	if event.is_action_pressed("skip_cutscene") and not _skipping:
		_skipping = true
		get_viewport().set_input_as_handled()


# Waits `seconds`, or less once it's being skipped.
func _beat(seconds: float) -> void:
	var left := seconds
	while left > 0.0 and not _skipping:
		await get_tree().process_frame
		left -= get_process_delta_time()


# Shows `line` as his subtitle and gives it time to be read.
func _say(line: String) -> void:
	_say_now(line)
	await _beat(clampf(0.6 + line.length() * 0.04, 1.2, 2.4))


func _say_now(line: String) -> void:
	_subtitle.text = line
	_speaker.visible = line != ""
	_subtitle.visible = line != ""


# Freezes `stand` where it is (it's posed by hand), facing `facing`.
func _hold(stand: Node3D, facing: Vector3) -> void:
	var torso: RigidBody3D = stand.torso
	torso.freeze = true
	torso.linear_velocity = Vector3.ZERO
	torso.angular_velocity = Vector3.ZERO
	torso.global_basis = Basis.looking_at(StandShape.flat(facing), Vector3.UP)


# His name and a line of subtitle above the bottom bar.
func _build_subtitles() -> void:
	_speaker = HudStyle.label(24, String(rival.display_name).to_upper())
	_speaker.add_theme_color_override("font_color", Color(1.0, 0.82, 0.4))
	_subtitle = HudStyle.label(30, "")
	for label: Label in [_speaker, _subtitle]:
		_layer.add_child(label)
		label.set_anchors_and_offsets_preset(Control.PRESET_CENTER_BOTTOM)
		label.grow_horizontal = Control.GROW_DIRECTION_BOTH
		label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
		label.visible = false
	var bar := get_viewport().get_visible_rect().size.y * letterbox
	_speaker.offset_top = -bar - 92.0
	_speaker.offset_bottom = -bar - 62.0
	_subtitle.offset_top = -bar - 60.0
	_subtitle.offset_bottom = -bar - 16.0
