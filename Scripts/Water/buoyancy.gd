# Buoyancy for a RigidBody3D: add this as a child of the body. While the body is partly under the
# water surface it's pushed up in proportion to how much of it is submerged, and slowed by drag,
# so it bobs and settles floating instead of sinking. buoyancy_ratio is the upward force at full
# submersion as a multiple of the body's weight; above 1 the body floats, and it settles with
# about 1 / buoyancy_ratio of its height under water.
# The water reacts (water.gd): the body splashes as it drops in, sized by how fast, and
# leaves a wake while it moves through it (one wake for all the parts of the same thing).
# Generated by Claude Code.
extends Node

@export var body_height := 1.7 # Full vertical extent of the body, used to work out how submerged it is.
@export var buoyancy_ratio := 1.6
@export var water_drag := 2.0 # Slows movement while submerged.
@export var water_angular_drag := 2.0 # Slows spinning while submerged: the share of spin lost per second, as an exponential rate.
@export var splash_speed := 12.0 # m/s. Dropping into the water this fast makes the biggest splash; slower than 2 makes none.

var _body: RigidBody3D
var _water: Node
var _was_wet := false


func _ready() -> void:
	_body = get_parent() as RigidBody3D
	if _body == null:
		push_warning("buoyancy.gd must be a child of a RigidBody3D")
		set_physics_process(false)


func _physics_process(delta: float) -> void:
	if _water == null:
		_water = get_tree().get_first_node_in_group("water")
		if _water == null:
			return

	var surface: float = _water.surface_height_at(_body.global_position)
	var bottom := _body.global_position.y - body_height * 0.5
	var submerged := clampf((surface - bottom) / body_height, 0.0, 1.0)
	_react_water(submerged > 0.0)
	if submerged <= 0.0:
		return

	_body.sleeping = false
	var weight := -_body.get_gravity() * _body.mass
	_body.apply_central_force(weight * buoyancy_ratio * submerged)
	_body.apply_central_force(-_body.linear_velocity * water_drag * _body.mass * submerged)
	# Spin is slowed by decaying it directly rather than with a torque: a torque would have to be scaled
	# by the body's rotational inertia, and small or thin bodies (tiny inertia for their mass) would
	# overshoot every tick and spin up instead of down.
	_body.angular_velocity *= exp(-water_angular_drag * submerged * delta)


# Splashes as the body drops in, and leaves a wake (shared by all of one thing's parts) as it moves.
func _react_water(wet: bool) -> void:
	var velocity := _body.linear_velocity
	if wet and not _was_wet and velocity.y < -2.0:
		_water.splash(_body.global_position, clampf(-velocity.y / splash_speed, 0.1, 1.0))
	elif wet:
		_water.wake(_body.owner if _body.owner else _body, _body.global_position, velocity)
	_was_wet = wet
