# A one-shot water splash's droplets: a burst thrown up and out that falls back under gravity. The rings
# spreading across the surface are the water's own (water.gd ripples), so this is only the spray.
# `strength` (0-1) scales how many droplets there are and how high they fly, so a gentle drop makes a
# small plop and a full-speed arrow a proper splash. The water's visuals (water_visuals.gd) make these
# for every splash (water.gd splash()).
# Usage: add a new one to the scene, put it on the water surface, call play(strength). It frees
# itself when finished, so it can outlive whatever caused it (a reeled-in arrow, say).
# Purely presentation: nothing reads it.
# Generated by Claude Code.
extends Node3D

const DROPLET_COLOR := Color(0.85, 0.95, 1.0)

@export var droplets_min := 10 # Droplets for the weakest splash...
@export var droplets_max := 48 # ...and the strongest.
@export var droplet_speed_min := 1.5 # m/s upward for the weakest splash...
@export var droplet_speed_max := 7.0 # ...and the strongest.
@export var droplet_size := 0.05 # Meters (radius).

var _hidden := false # A prewarm splash: drawn, but too small to see (see prewarm).


## Plays an invisible splash just in front of `camera`. The first splash drawn makes the renderer compile
## its shaders, which stalls a frame or three; doing it while the level loads hides that hitch instead of
## it landing the first time an arrow hits the water. It is made invisible through its own settings
## (sub-pixel, motionless droplets), not by scaling the node: the droplets are
## simulated in world space, so a node scale would not shrink them. Only numbers change, not anything
## that shapes the shaders, so it compiles exactly what a real splash uses.
static func prewarm(camera: Camera3D) -> void:
	var splash: Node3D = load("res://Scripts/Water/water_splash.gd").new()
	camera.add_child(splash)
	splash.position = Vector3(0.0, 0.0, -1.0) # In view, so it really gets drawn.
	splash._hidden = true
	splash.play(1.0)


func play(strength: float) -> void:
	strength = clampf(strength, 0.0, 1.0)
	var droplet_life := _spawn_droplets(strength)
	get_tree().create_timer(droplet_life + 0.1).timeout.connect(queue_free)


# Droplets thrown up in a narrow cone. Returns how long the longest-lived one can last.
func _spawn_droplets(strength: float) -> float:
	var speed := lerpf(droplet_speed_min, droplet_speed_max, strength)
	# Long enough to rise and fall back to the surface.
	var lifetime := 2.0 * speed / 9.8 + 0.2

	var process := ParticleProcessMaterial.new()
	process.direction = Vector3.UP
	process.spread = 25.0
	process.initial_velocity_min = speed * 0.5
	process.initial_velocity_max = speed
	process.gravity = Vector3(0.0, -9.8, 0.0)
	process.emission_shape = ParticleProcessMaterial.EMISSION_SHAPE_SPHERE
	process.emission_sphere_radius = 0.1 + 0.15 * strength
	process.scale_min = 0.5
	process.scale_max = 1.3
	# Shrink away toward the end, rather than popping out.
	var shrink := Curve.new()
	shrink.add_point(Vector2(0.0, 1.0))
	shrink.add_point(Vector2(0.7, 0.8))
	shrink.add_point(Vector2(1.0, 0.0))
	var shrink_texture := CurveTexture.new()
	shrink_texture.curve = shrink
	process.scale_curve = shrink_texture
	if _hidden:
		process.scale_min = 0.001
		process.scale_max = 0.001
		process.initial_velocity_min = 0.0
		process.initial_velocity_max = 0.0

	var droplet := SphereMesh.new()
	droplet.radius = droplet_size
	droplet.height = droplet_size * 2.0
	droplet.radial_segments = 6 # Low-poly, like everything else.
	droplet.rings = 3
	var material := StandardMaterial3D.new()
	material.albedo_color = DROPLET_COLOR
	material.roughness = 0.15
	material.emission_enabled = true
	material.emission = DROPLET_COLOR * 0.25 # A little glow so droplets read against the blue water.
	droplet.material = material

	var particles := GPUParticles3D.new()
	particles.amount = roundi(lerpf(droplets_min, droplets_max, strength))
	particles.lifetime = lifetime
	particles.one_shot = true
	particles.explosiveness = 0.9
	particles.process_material = process
	particles.draw_pass_1 = droplet
	particles.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	# Big enough to hold the highest, widest droplets, so they're never culled mid-flight.
	var height := speed * speed / (2.0 * 9.8) + 1.0
	particles.visibility_aabb = AABB(Vector3(-height, -1.0, -height), Vector3(height * 2.0, height + 1.0, height * 2.0))
	add_child(particles)
	particles.emitting = true
	return lifetime

