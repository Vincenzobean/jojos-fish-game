# Scene changes (autoload `SceneLoader`): every switch to a new scene goes through change_scene(),
# which covers it with the loading screen so loads never show as a frozen frame, even ones that are
# quick today.
#
# A change runs in steps:
#   1. The loading screen fades in (or appears at once, for the very first load at boot).
#   2. The scene file is loaded on a background thread while the progress bar fills.
#   3. The old scene is removed and the new one is instanced and added. This step blocks the main
#      thread (island generation runs in its _ready), so a frame is drawn first to make sure the
#      screen is up.
#   4. Anything in the new scene that keeps loading after it is added (it joins the group
#      "loading_task", has is_loaded() and emits `loaded`) is waited for.
#   5. The loading screen fades out.
# The tree is unpaused when the old scene goes, so changing scene from the pause menu works.
# Generated by Claude Code.
extends Node

## A scene change began; the loading screen is about to cover the game.
signal load_started(path: String)
## The new scene is in place, fully loaded and the loading screen has faded out.
signal load_finished(path: String)

const LoadingScreenScene := preload("res://scenes/loading_screen.tscn")
const LOADING_TASK_GROUP := &"loading_task"
const FILE_LOAD_SHARE := 0.6 # How much of the progress bar reading the scene file fills...
const BUILD_SHARE := 0.85 # ...and how far it gets once the scene is instanced; the rest is loading tasks.

var _screen: CanvasLayer
var _busy := false


func _ready() -> void:
	process_mode = Node.PROCESS_MODE_ALWAYS
	_screen = LoadingScreenScene.instantiate()
	add_child(_screen)


## True while a scene change is under way.
func is_loading() -> bool:
	return _busy


## Swaps the current scene for the one at `path` behind the loading screen. With `instant_open` the
## screen appears without fading in (used at boot, where there's nothing to fade from).
func change_scene(path: String, instant_open := false) -> void:
	if _busy:
		push_warning("SceneLoader: already loading a scene, ignoring change to %s" % path)
		return
	_busy = true
	load_started.emit(path)

	await _screen.open(instant_open)
	_screen.status = "Loading..."

	var packed := await _load_file(path)
	if packed == null:
		push_error("SceneLoader: couldn't load %s" % path)
		await _screen.close()
		_busy = false
		return

	_screen.progress = FILE_LOAD_SHARE
	_screen.status = "Building the world..."
	# Instancing blocks until the new scene's _ready functions finish, so make sure the screen has
	# been drawn with its latest text first: a frame is drawn between two process_frame signals.
	await get_tree().process_frame
	await get_tree().process_frame

	var tree := get_tree()
	var old := tree.current_scene
	if old:
		old.get_parent().remove_child(old)
		old.queue_free()
	tree.paused = false
	var scene := packed.instantiate()
	tree.root.add_child(scene)
	tree.current_scene = scene
	_screen.progress = BUILD_SHARE

	_screen.status = "Almost there..."
	for task in tree.get_nodes_in_group(LOADING_TASK_GROUP):
		if is_instance_valid(task) and not task.is_loaded():
			await task.loaded
	_screen.progress = 1.0

	await _screen.close()
	_busy = false
	load_finished.emit(path)


# Reads the scene file on a background thread, feeding the progress bar. Returns null on failure.
# With sub-threads on, dependencies are loaded as their own tasks: without them, scripts that preload
# scenes sometimes failed to preload them ("Could not preload resource file") on about one boot in five.
func _load_file(path: String) -> PackedScene:
	if ResourceLoader.load_threaded_request(path, "", true) != OK:
		return null
	var progress := []
	while true:
		match ResourceLoader.load_threaded_get_status(path, progress):
			ResourceLoader.THREAD_LOAD_IN_PROGRESS:
				_screen.progress = progress[0] * FILE_LOAD_SHARE
				await get_tree().process_frame
			ResourceLoader.THREAD_LOAD_LOADED:
				return ResourceLoader.load_threaded_get(path) as PackedScene
			_:
				return null
	return null
