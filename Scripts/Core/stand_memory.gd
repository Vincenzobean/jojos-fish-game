# What the game's opponents have learned about how the player fights (autoload `StandMemory`), kept per
# kind of player stand (keyed by its scene path, like Skills) and shared by every opponent: wild stands
# (enemy_stand_brain.gd), target dummies (target_dummy.gd) and anything added later. Saved to
# user://stand_memory.cfg.
#
#   * Habits: the choices the player makes in a fight (stand_combat.gd `action_taken`: start a chain,
#     carry it on, its finisher, a heavy, barrage, block, counter, rush, special, stop, plus dash), each
#     counted after the choice before it and how far the nearest opponent was (close, mid, far). Only
#     choices made with an opponent near count, and never the moves a combo chain forces, so what's learned
#     is the player's own style. possession.gd feeds record_action(); predict() and read() say what the
#     player is likely to choose next. Counts fade after every fight (count_decay) so old habits are
#     forgotten, and a guess needs min_seen examples and is smoothed, so it takes repetition to be trusted.
#   * Familiarity (0..1): how well opponents know that stand. Every fight it finishes adds a share of
#     what's left (so it climbs over many fights and levels off, never reaching 1), and every other
#     stand's fades a little, so a stand left on the bench is slowly forgotten. Opponents read more often
#     and react faster the more familiar they are: this is what makes switching stands pay.
#   * Tactics and responses (small multi-armed bandits): how well each of an opponent's tactics, and each
#     way of answering a read, has done against that stand, weighted toward the most recent tries. They
#     mostly pick the best so far and keep trying others now and then.
# Gameplay only.
# Generated by Claude Code.
extends Node

## Opponents learned more about `key` (familiarity changed).
signal changed(key: String)

const VERSION := 2 # Saved; an older file's habits and scores are dropped.
const TACTICS: Array[String] = ["rush", "bait", "turtle", "zone"]
## Every choice that's counted (dash comes from stand_controller.gd's `dashed`).
const ACTIONS: Array[StringName] = [&"open", &"chain", &"finisher", &"heavy", &"barrage", &"block",
	&"counter", &"rush", &"special", &"stop", &"dash"]

var save_path := "user://stand_memory.cfg" ## Where it's kept ("" to not save at all, e.g. in tests).

@export var familiarity_gain := 0.08 ## Share of what's left that a full fight with a stand adds...
@export var familiarity_decay := 0.9 ## ...and what every other stand's keeps of its own each time.
@export var idle_gap := 1.5 ## Seconds without a choice after which the next counts as a fresh start.
@export var min_seen := 6 ## Choices seen after one in its context before predicting what follows.
@export var count_decay := 0.85 ## What a stand's habit counts keep after each fight it finishes...
@export var context_cap := 40.0 ## ...and the most one context holds (more is scaled back).
@export var max_read_chance := 0.5 ## Opponents never act on a read more often than this.
@export var score_rate := 0.25 ## How much each new score moves a tactic's or response's value.

var _familiarity := {} # Key -> 0..1.
var _habits := {} # Key -> {context "previous|band" -> {action -> count}}.
var _tactics := {} # Key -> {tactic -> {"value": float, "count": int}}.
var _responses := {} # Key -> {predicted action -> {response -> {"value": float, "count": int}}}.
var _last := {} # Key -> {"action": StringName, "time": float}: the latest choice, this session.


func _ready() -> void:
	load_memory()


## How well opponents know the stand kind `key`, 0 to 1.
func familiarity(key: String) -> float:
	return float(_familiarity.get(key, 0.0))


## How far apart a stand and its opponent are, sorted for the learning: `distance` meters, measured in
## lengths of the stand (`stand_size` meters): "close", "mid" or "far".
static func band(distance: float, stand_size: float) -> String:
	var lengths := distance / maxf(stand_size, 0.01)
	return "close" if lengths < 1.2 else ("mid" if lengths < 3.0 else "far")


## The player's stand of kind `key` made the choice `action` with the nearest opponent `band` away
## (band()).
func record_action(key: String, action: StringName, band: String) -> void:
	var now := Time.get_ticks_msec() / 1000.0
	var last: Dictionary = _last.get(key, {})
	var previous := String(last.get("action", &"start")) if now - float(last.get("time", -INF)) <= idle_gap else "start"
	var table: Dictionary = _habits.get_or_add(key, {})
	var counts: Dictionary = table.get_or_add(_context(previous, band), {})
	counts[String(action)] = float(counts.get(String(action), 0.0)) + 1.0
	var total := _total(counts)
	if total > context_cap:
		for name: String in counts:
			counts[name] = float(counts[name]) * context_cap / total
	_last[key] = {"action": action, "time": now}


## The latest choice the player's stand of kind `key` made (this session), or &"".
func last_action(key: String) -> StringName:
	return StringName((_last.get(key, {}) as Dictionary).get("action", &""))


## The choice most likely to follow `action` for stand kind `key` with the opponent `band` away, and how
## sure: its smoothed share of what has followed ("" and 0 until min_seen have).
func predict(key: String, action: StringName, band: String) -> Dictionary:
	var counts: Dictionary = (_habits.get(key, {}) as Dictionary).get(_context(String(action), band), {})
	var total := _total(counts)
	if total < min_seen:
		return {"action": &"", "confidence": 0.0}
	var best := ""
	for name: String in counts:
		if best == "" or float(counts[name]) > float(counts[best]):
			best = name
	return {"action": StringName(best), "confidence": (float(counts[best]) + 1.0) / (total + ACTIONS.size())}


## What an opponent should make of the player's stand of kind `key` having just chosen `action` with it
## `band` away: the choice likely next, the chance to act on that read (familiarity times confidence,
## eased, at most max_read_chance) and how long to take reacting (quicker the more familiar). The same for
## every opponent.
func read(key: String, action: StringName, band: String) -> Dictionary:
	var guess := predict(key, action, band)
	var known := familiarity(key)
	return {"action": guess["action"],
		"chance": minf(known * float(guess["confidence"]) * 0.8, max_read_chance),
		"delay": lerpf(0.35, 0.12, known) + randf_range(0.0, 0.08)}


## A tactic to try against stand kind `key`.
func pick_tactic(key: String) -> String:
	return _pick(_tactics.get_or_add(key, {}), TACTICS, familiarity(key))


## How a round of `tactic` went against stand kind `key`: `score` about -1 (badly) to 1 (well).
func reward(key: String, tactic: String, score: float) -> void:
	_score(_tactics.get_or_add(key, {}), tactic, score)


## How to answer a read that stand kind `key` will choose `predicted` next: one of `options`.
func pick_response(key: String, predicted: StringName, options: Array) -> String:
	var table: Dictionary = (_responses.get_or_add(key, {}) as Dictionary).get_or_add(String(predicted), {})
	return _pick(table, options, familiarity(key))


## How answering a read of `predicted` with `response` went: `score` -1 (got hit) to 1 (worked).
func reward_response(key: String, predicted: StringName, response: String, score: float) -> void:
	var table: Dictionary = (_responses.get_or_add(key, {}) as Dictionary).get_or_add(String(predicted), {})
	_score(table, response, score)


## The player's stand of kind `key` finished a fight (`weight` 1 for a battle with a wild stand, less for a
## lesser one): opponents know it a little better, every other stand a little less, and its old habits
## fade a little. Saves.
func note_fight(key: String, weight := 1.0) -> void:
	var fade := pow(familiarity_decay, weight)
	for other: String in _familiarity:
		if other != key:
			_familiarity[other] = float(_familiarity[other]) * fade
	var known := familiarity(key)
	_familiarity[key] = known + familiarity_gain * weight * (1.0 - known)
	var keep := pow(count_decay, weight)
	for context: String in (_habits.get(key, {}) as Dictionary):
		var counts: Dictionary = _habits[key][context]
		for name: String in counts:
			counts[name] = float(counts[name]) * keep
	save_memory()
	changed.emit(key)


## Forgets everything (not saved until something else changes): for tests.
func reset() -> void:
	_familiarity.clear()
	_habits.clear()
	_tactics.clear()
	_responses.clear()
	_last.clear()


func load_memory() -> void:
	reset()
	if save_path == "":
		return
	var file := ConfigFile.new()
	if file.load(save_path) != OK:
		return
	var current := int(file.get_value("memory", "version", 1)) == VERSION
	for key in file.get_sections():
		if key == "memory":
			continue
		var known := float(file.get_value(key, "familiarity", 0.0))
		_familiarity[key] = known if current else known * 0.5
		if current: # An older file's habits were counted differently: start them afresh.
			_habits[key] = file.get_value(key, "habits", {})
			_tactics[key] = file.get_value(key, "tactics", {})
			_responses[key] = file.get_value(key, "responses", {})


func save_memory() -> void:
	if save_path == "":
		return
	var file := ConfigFile.new()
	file.set_value("memory", "version", VERSION)
	var keys := {}
	for table in [_familiarity, _habits, _tactics, _responses]:
		for key in table:
			keys[key] = true
	for key: String in keys:
		file.set_value(key, "familiarity", familiarity(key))
		file.set_value(key, "habits", _habits.get(key, {}))
		file.set_value(key, "tactics", _tactics.get(key, {}))
		file.set_value(key, "responses", _responses.get(key, {}))
	file.save(save_path)


static func _context(previous: String, band: String) -> String:
	return previous + "|" + band


static func _total(counts: Dictionary) -> float:
	var total := 0.0
	for name: String in counts:
		total += float(counts[name])
	return total


# One of `options` from the `scores` table: any never tried first, otherwise mostly the best so far,
# exploring (picking at random) less the more `known` it is, but never less than 15% of the time.
static func _pick(scores: Dictionary, options: Array, known: float) -> String:
	var untried: Array = []
	for option in options:
		if not scores.has(String(option)):
			untried.append(String(option))
	if not untried.is_empty():
		return untried.pick_random()
	if randf() < lerpf(0.6, 0.15, known):
		return String(options.pick_random())
	var best := String(options[0])
	for option in options:
		if float(scores[String(option)]["value"]) > float(scores[best]["value"]):
			best = String(option)
	return best


# A new `score` for `name` in `scores`, weighted toward recent ones.
func _score(scores: Dictionary, name: String, score: float) -> void:
	var entry: Dictionary = scores.get_or_add(name, {"value": score, "count": 0})
	entry["count"] = int(entry["count"]) + 1
	entry["value"] = float(entry["value"]) + (score - float(entry["value"])) * score_rate
