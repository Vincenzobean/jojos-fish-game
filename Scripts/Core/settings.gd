# Player settings (autoload `Settings`): owns every option the settings menu shows, saves them to
# user://settings.cfg and applies them at startup and whenever one changes. Menus only call
# get_value()/set_value() (and rebind()/reset_keybinds() for keys) and listen to `changed`; they never
# touch the engine directly.
#
# What is applied here: bus volumes, window mode, vsync and the FPS cap, the root viewport's render
# scale, upscaler and anti-aliasing, and the shadow / SSAO / glow toggles. The last three live on
# scene nodes, so every WorldEnvironment and DirectionalLight3D that enters the tree is picked up
# through `node_added`; scenes need no extra scripts for them. Mouse sensitivity, invert Y and the
# field of view are read by player.gd.
#
# Choosing a quality preset (Low/Medium/High) sets the graphics options it covers; changing any of
# those by hand afterwards switches the preset to Custom.
#
# Key bindings: the project's Input Map is the default. A rebind replaces an action's events with
# the single new one, and every rebindable action's events are saved, so the map is restored on load.
# Generated by Claude Code.
extends Node

## A setting changed (from a menu, a preset or a reset). For key bindings `section` is KEYBINDS and
## `key` is the action name.
signal changed(section: String, key: String)

enum Quality { LOW, MEDIUM, HIGH, CUSTOM }
enum AntiAliasing { OFF, FXAA, MSAA_2X, MSAA_4X, TAA }
enum Shadows { OFF, LOW, HIGH }

const SAVE_PATH := "user://settings.cfg"
const KEYBINDS := "keybinds"

## Actions the player can rebind, in the order the menu lists them.
const REBINDABLE_ACTIONS: Array[StringName] = [
	&"move_up", &"move_down", &"move_left", &"move_right", &"jump", &"sprint", &"fire", &"reel",
	&"summon", &"descend", &"light_attack", &"heavy_attack", &"block", &"stand_special", &"stand_ultimate", &"challenge", &"inventory", &"skills",
]

# Option indexes stored in the settings map onto these.
const WINDOW_MODES := [
	DisplayServer.WINDOW_MODE_WINDOWED,
	DisplayServer.WINDOW_MODE_FULLSCREEN, # Borderless fullscreen.
	DisplayServer.WINDOW_MODE_EXCLUSIVE_FULLSCREEN,
]
const MAX_FPS_CHOICES := [30, 60, 120, 144, 0] # 0 means unlimited.
const UPSCALERS := [Viewport.SCALING_3D_MODE_BILINEAR, Viewport.SCALING_3D_MODE_FSR, Viewport.SCALING_3D_MODE_FSR2]
const SHADOW_ATLAS_SIZES := {Shadows.LOW: 2048, Shadows.HIGH: 4096}
const AUDIO_BUSES := {"master_volume": &"Master", "music_volume": &"Music", "sfx_volume": &"SFX"}
const VOICE_BUS := &"Voice" # Spoken lines (the tutorial's, tutorial.gd); "mute_voices" silences it.

# Every setting and its default. The graphics defaults match how the game looked before settings
# existed (no AA, shadows, SSAO or glow), so they come out as the Custom preset.
const DEFAULTS := {
	"audio": {"master_volume": 1.0, "music_volume": 1.0, "sfx_volume": 1.0, "mute_voices": false},
	"controls": {"mouse_sensitivity": 1.0, "invert_y": false},
	"display": {"window_mode": 0, "vsync": true, "max_fps": 4, "fov": 75.0},
	"graphics": {
		"quality": Quality.CUSTOM,
		"render_scale": 1.0,
		"upscaler": 0,
		"anti_aliasing": AntiAliasing.OFF,
		"shadows": Shadows.OFF,
		"ssao": false,
		"glow": false,
	},
}

const QUALITY_PRESETS := {
	Quality.LOW: {"render_scale": 0.75, "upscaler": 1, "anti_aliasing": AntiAliasing.FXAA, "shadows": Shadows.OFF, "ssao": false, "glow": false},
	Quality.MEDIUM: {"render_scale": 1.0, "upscaler": 0, "anti_aliasing": AntiAliasing.FXAA, "shadows": Shadows.LOW, "ssao": false, "glow": true},
	Quality.HIGH: {"render_scale": 1.0, "upscaler": 0, "anti_aliasing": AntiAliasing.MSAA_4X, "shadows": Shadows.HIGH, "ssao": true, "glow": true},
}

var _values := {}
var _default_events := {} # Action name -> its events as set in the project's Input Map.
var _save_queued := false


func _ready() -> void:
	process_mode = Node.PROCESS_MODE_ALWAYS
	for action in REBINDABLE_ACTIONS:
		_default_events[action] = InputMap.action_get_events(action)
	_values = DEFAULTS.duplicate(true)
	_load()
	get_tree().node_added.connect(_on_node_added)
	for section: String in _values:
		for key: String in _values[section]:
			_apply(section, key)


func get_value(section: String, key: String) -> Variant:
	return _values[section][key]


func set_value(section: String, key: String, value: Variant) -> void:
	if _values[section][key] == value:
		return
	_store(section, key, value)
	if section == "graphics":
		if key == "quality" and QUALITY_PRESETS.has(value):
			var preset: Dictionary = QUALITY_PRESETS[value]
			for preset_key: String in preset:
				if _values.graphics[preset_key] != preset[preset_key]:
					_store("graphics", preset_key, preset[preset_key])
		elif key != "quality" and _values.graphics.quality != Quality.CUSTOM:
			_store("graphics", "quality", Quality.CUSTOM)


## The action's current binding (the first of its events), or null if it has none.
func get_binding(action: StringName) -> InputEvent:
	var events := InputMap.action_get_events(action)
	return events[0] if not events.is_empty() else null


## Replaces every event on `action` with `event`.
func rebind(action: StringName, event: InputEvent) -> void:
	InputMap.action_erase_events(action)
	InputMap.action_add_event(action, event)
	changed.emit(KEYBINDS, String(action))
	_queue_save()


## Puts every rebindable action back to its Input Map default.
func reset_keybinds() -> void:
	for action in REBINDABLE_ACTIONS:
		_set_events(action, _default_events[action])
		changed.emit(KEYBINDS, String(action))
	_queue_save()


func _store(section: String, key: String, value: Variant) -> void:
	_values[section][key] = value
	_apply(section, key)
	changed.emit(section, key)
	_queue_save()


func _set_events(action: StringName, events: Array) -> void:
	InputMap.action_erase_events(action)
	for event in events:
		if event is InputEvent:
			InputMap.action_add_event(action, event)


# --- Saving and loading -----------------------------------------------------------------------

# Sliders change every frame while dragged, so saves are batched into one at the end of the frame.
func _queue_save() -> void:
	if not _save_queued:
		_save_queued = true
		_save.call_deferred()


func _save() -> void:
	_save_queued = false
	var config := ConfigFile.new()
	for section: String in _values:
		for key: String in _values[section]:
			config.set_value(section, key, _values[section][key])
	for action in REBINDABLE_ACTIONS:
		config.set_value(KEYBINDS, String(action), InputMap.action_get_events(action))
	var error := config.save(SAVE_PATH)
	if error != OK:
		push_warning("Settings: couldn't save %s (error %d)" % [SAVE_PATH, error])


# Missing or mistyped entries (an old or hand-edited file) keep their defaults.
func _load() -> void:
	var config := ConfigFile.new()
	if config.load(SAVE_PATH) != OK:
		return
	for section: String in _values:
		for key: String in _values[section]:
			if not config.has_section_key(section, key):
				continue
			var saved: Variant = config.get_value(section, key)
			var default: Variant = _values[section][key]
			if typeof(saved) == typeof(default):
				_values[section][key] = saved
			elif default is float and saved is int:
				_values[section][key] = float(saved)
	for action in REBINDABLE_ACTIONS:
		if not config.has_section_key(KEYBINDS, String(action)):
			continue # Saved before this action existed: keep its default.
		var saved: Variant = config.get_value(KEYBINDS, String(action))
		if saved is Array and not saved.is_empty():
			_set_events(action, saved)


# --- Applying ---------------------------------------------------------------------------------

func _apply(section: String, key: String) -> void:
	var value: Variant = _values[section][key]
	match section:
		"audio":
			if key == "mute_voices":
				var bus := AudioServer.get_bus_index(VOICE_BUS)
				if bus != -1:
					AudioServer.set_bus_mute(bus, value)
			else:
				_apply_volume(AUDIO_BUSES[key], value)
		"display":
			match key:
				"window_mode":
					var mode: DisplayServer.WindowMode = WINDOW_MODES[value]
					if DisplayServer.window_get_mode() != mode:
						DisplayServer.window_set_mode(mode)
				"vsync":
					DisplayServer.window_set_vsync_mode(DisplayServer.VSYNC_ENABLED if value else DisplayServer.VSYNC_DISABLED)
				"max_fps":
					Engine.max_fps = MAX_FPS_CHOICES[value]
		"graphics":
			match key:
				"render_scale", "upscaler":
					get_viewport().scaling_3d_scale = _values.graphics.render_scale
					get_viewport().scaling_3d_mode = UPSCALERS[_values.graphics.upscaler]
				"anti_aliasing":
					_apply_anti_aliasing(value)
				"shadows":
					if value != Shadows.OFF:
						RenderingServer.directional_shadow_atlas_set_size(SHADOW_ATLAS_SIZES[value], true)
						RenderingServer.directional_soft_shadow_filter_set_quality(
							RenderingServer.SHADOW_QUALITY_SOFT_LOW if value == Shadows.LOW else RenderingServer.SHADOW_QUALITY_SOFT_HIGH)
					for light in get_tree().root.find_children("*", "DirectionalLight3D", true, false):
						_apply_to_light(light)
				"ssao", "glow":
					for environment in get_tree().root.find_children("*", "WorldEnvironment", true, false):
						_apply_to_environment(environment)


func _apply_volume(bus_name: StringName, volume: float) -> void:
	var bus := AudioServer.get_bus_index(bus_name)
	if bus == -1:
		return
	AudioServer.set_bus_mute(bus, volume <= 0.0)
	AudioServer.set_bus_volume_db(bus, linear_to_db(maxf(volume, 0.0001)))


func _apply_anti_aliasing(mode: int) -> void:
	var viewport := get_viewport()
	match mode:
		AntiAliasing.MSAA_2X:
			viewport.msaa_3d = Viewport.MSAA_2X
		AntiAliasing.MSAA_4X:
			viewport.msaa_3d = Viewport.MSAA_4X
		_:
			viewport.msaa_3d = Viewport.MSAA_DISABLED
	viewport.screen_space_aa = Viewport.SCREEN_SPACE_AA_FXAA if mode == AntiAliasing.FXAA else Viewport.SCREEN_SPACE_AA_DISABLED
	viewport.use_taa = mode == AntiAliasing.TAA


func _apply_to_light(light: DirectionalLight3D) -> void:
	light.shadow_enabled = _values.graphics.shadows != Shadows.OFF


func _apply_to_environment(world_environment: WorldEnvironment) -> void:
	var environment := world_environment.environment
	if environment:
		environment.ssao_enabled = _values.graphics.ssao
		environment.glow_enabled = _values.graphics.glow


func _on_node_added(node: Node) -> void:
	if node is DirectionalLight3D:
		_apply_to_light(node)
	elif node is WorldEnvironment:
		_apply_to_environment(node)
