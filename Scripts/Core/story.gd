# Autoload "Story": how far the player has got through the story, as named flags, kept between sessions
# in save_path. So far there's "boss_defeated" (Lord Verity beaten on the final island: stand_encounter.gd)
# and "boss_met" (his intro has played once, so it can be skipped: boss_intro_director.gd).
# Generated by Claude Code.
extends Node

## A flag was set or cleared.
signal changed(flag: StringName, value: bool)

var save_path := "user://story.cfg" ## Where it's kept ("" to not save at all, e.g. in tests).

var _flags := {} # Flag -> true.


func _ready() -> void:
	load_progress()


func has_flag(flag: StringName) -> bool:
	return _flags.has(flag)


## Sets `flag` (or clears it, `value` false) and saves.
func set_flag(flag: StringName, value := true) -> void:
	if value == has_flag(flag):
		return
	if value:
		_flags[flag] = true
	else:
		_flags.erase(flag)
	save_progress()
	changed.emit(flag, value)


func save_progress() -> void:
	if save_path == "":
		return
	var config := ConfigFile.new()
	for flag: StringName in _flags:
		config.set_value("flags", String(flag), true)
	config.save(save_path)


func load_progress() -> void:
	_flags.clear()
	if save_path == "":
		return
	var config := ConfigFile.new()
	if config.load(save_path) != OK:
		return
	if config.has_section("flags"):
		for key in config.get_section_keys("flags"):
			if config.get_value("flags", key, false):
				_flags[StringName(key)] = true
