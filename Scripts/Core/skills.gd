# Skill progress (autoload `Skills`): one shared pool of skill points and the bought ranks of every skill
# tree, saved to user://progress.cfg. Trees are keyed: "player" is the player's own (PlayerSkillTree), and
# each stand kind's is keyed by its scene path (its body's get_skill_tree(): DefaultStandSkillTree, or its
# own). Each kind of stand has one tree, shared by every one of it you hold.
#
# Gameplay asks it what's been learned: allows(key, unlock) for abilities (a move, swimming: free unless
# the tree has a node that unlocks it), and
# scaled(key, stat, base) or bonus(key, stat) for numbers. The skill screen (skill_screen.gd) buys
# ranks with buy(), from the pool, in any tree.
#
# Points come from XP, and XP only from defeating an enemy (stand_encounter.gd for a wild stand,
# possession.gd for a target dummy), never from damage: grant_xp() fills the pool's bar of xp_to_next()
# and every time it's full the pool gets a point, each needing a little more XP than the last. A catch-up
# bonus encourages switching stands: every stand remembers the XP it has won (stand_xp()), and once the
# top stand has catch_up_threshold_xp, a win with a stand behind it earns more the further behind it is
# (catch_up_multiplier()), up to 1 + catch_up_max times for one with none. Losing a fight costs a little
# of the bar (lose_xp()). grant_points() (the F3 debug key, debug_skill_points.gd) gives points directly.
#
# The player's level is that same pool: every point it has ever gained is a level (level() is earned() + 1),
# so the XP bar is the level bar and the level is saved with it. Each level, besides its point, makes every
# stand the player summons a little stronger (LEVEL_STATS, folded into scaled() for stand trees: their max
# health and damage); wild stands, rivals and the boss aren't scaled by anything here. `leveled_up` fires
# once for each level reached.
# Generated by Claude Code.
extends Node

## Something changed: the pool (key "") or the tree `key`'s ranks.
signal changed(key: String)
## The stand `key` won `amount` XP for the pool (already times its catch-up `multiplier`), making
## `points_gained` points.
signal xp_gained(key: String, amount: int, multiplier: float, points_gained: int)
## The player reached `level` (once for each level, so several in a row for a big win).
signal leveled_up(level: int)

const PLAYER := "player"
const POOL := "pool" # The save section of the shared points and XP.
const RESERVED := ["points", "xp", "earned", "stand_xp"] # Save keys that aren't skill ids.
## What each level past the first adds to every one of the player's stands, as a share: +3% max health and
## +2% damage per level.
const LEVEL_STATS := {"max_health": 0.03, "damage": 0.02}

@export var catch_up_threshold_xp := 500 ## XP the top stand must have won before any catch-up.
@export var catch_up_max := 2.0 ## Extra XP share for a stand that has won nothing (x3 at 2.0).
@export var xp_base := 100 ## XP for the first point...
@export var xp_growth := 20 ## ...and this much more for each point earned.

var save_path := "user://progress.cfg" ## Where progress is kept ("" to not save at all, e.g. in tests).

var _points := 0 # Unspent points in the pool.
var _xp := 0 # XP toward the next point.
var _earned := 0 # Every point the pool has ever gained, spent or not.
var _stand_xp := {} # Stand key -> all the XP it has ever won.
var _ranks := {} # Key -> {node id -> rank}.
var _trees := {} # Key -> SkillTree, built on first use.


func _ready() -> void:
	load_progress()


## The tree for `key`: the player's, or a stand kind's (by its scene path). Null if there's no such stand.
func tree_for(key: String) -> SkillTree:
	if _trees.has(key):
		return _trees[key]
	var tree: SkillTree = null
	if key == PLAYER:
		tree = PlayerSkillTree.new()
	elif ResourceLoader.exists(key):
		var stand := (load(key) as PackedScene).instantiate()
		if stand.has_method("get_skill_tree"):
			tree = stand.get_skill_tree()
		stand.free()
	_trees[key] = tree
	return tree


## The pool's unspent points (any tree can spend them; `_key` is only kept for older callers).
func points(_key := "") -> int:
	return _points


## XP toward the pool's next point, and how much that point takes.
func xp(_key := "") -> int:
	return _xp


func xp_to_next(_key := "") -> int:
	return xp_base + xp_growth * _earned


## Every point the pool has ever gained, spent or not.
func earned(_key := "") -> int:
	return _earned


## The player's level: 1, plus one for every point the pool has ever gained.
func level() -> int:
	return _earned + 1


## What the player's level adds to `stat` for their stands, as a share (0.27 for +27%).
func level_bonus(stat: String) -> float:
	return float(LEVEL_STATS.get(stat, 0.0)) * (level() - 1)


## All the XP the stand kind `key` has ever won.
func stand_xp(key: String) -> int:
	return int(_stand_xp.get(key, 0))


## How much more XP a win with the stand kind `key` earns for being behind the stand that has won the
## most (1 if it isn't, for the player's tree, or until that stand has catch_up_threshold_xp). Compared on
## XP won, so holding points back doesn't change it.
func catch_up_multiplier(key: String) -> float:
	if key == PLAYER:
		return 1.0
	var top := 0
	for other: String in _stand_xp:
		top = maxi(top, stand_xp(other))
	if top < catch_up_threshold_xp:
		return 1.0
	return 1.0 + clampf(float(top - stand_xp(key)) / top, 0.0, 1.0) * catch_up_max


## A win with the stand kind `key` earns `amount` XP for the pool, times the stand's catch-up multiplier,
## every full bar turning into a point. `announce` false keeps it quiet (no xp_gained), for a caller that
## reports it itself. Returns {"amount": XP given, "multiplier", "points": points gained}.
func grant_xp(key: String, amount: float, announce := true) -> Dictionary:
	var multiplier := catch_up_multiplier(key)
	var given := roundi(maxf(amount, 0.0) * multiplier)
	_stand_xp[key] = stand_xp(key) + given
	_xp += given
	var gained := 0
	while _xp >= xp_to_next():
		_xp -= xp_to_next()
		_points += 1
		_earned += 1
		gained += 1
	_changed("")
	if announce:
		xp_gained.emit(key, given, multiplier, gained)
	_announce_levels(gained)
	return {"amount": given, "multiplier": multiplier, "points": gained}


## Takes up to `amount` XP off the pool's bar (losing a fight), never below empty and never a point already
## earned. Returns how much was lost.
func lose_xp(amount: int) -> int:
	var lost := clampi(amount, 0, _xp)
	if lost > 0:
		_xp -= lost
		_changed("")
	return lost


func rank(key: String, id: StringName) -> int:
	return int((_ranks.get(key, {}) as Dictionary).get(id, 0))


## Whether anything bought in `key`'s tree turns on `unlock`.
func has(key: String, unlock: StringName) -> bool:
	var tree := tree_for(key)
	if tree == null:
		return false
	for node in tree.nodes:
		if unlock in node.unlocks and rank(key, node.id) > 0:
			return true
	return false


## Whether `key` may use `unlock`: it has learned it, or nothing in its tree locks it in the first place
## (so a stand whose tree has no barrage node, say, keeps its barrage).
func allows(key: String, unlock: StringName) -> bool:
	var tree := tree_for(key)
	if tree == null:
		return true
	for node in tree.nodes:
		if unlock in node.unlocks:
			return has(key, unlock)
	return true


## The total `stat` added by everything bought in `key`'s tree (0 if nothing adds to it).
func bonus(key: String, stat: String) -> float:
	var tree := tree_for(key)
	if tree == null:
		return 0.0
	var total := 0.0
	for node in tree.nodes:
		if node.stats.has(stat):
			total += float(node.stats[stat]) * rank(key, node.id)
	return total


## `base` grown (or shrunk) by `stat`'s bonus as a share: base * (1 + bonus). A stand's tree also gets the
## player's level bonus (LEVEL_STATS).
func scaled(key: String, stat: String, base: float) -> float:
	var share := bonus(key, stat)
	if key != PLAYER:
		share += level_bonus(stat)
	return base * maxf(1.0 + share, 0.05)


## Why the next rank of node `id` can't be bought, or "" if it can.
func why_not(key: String, id: StringName) -> String:
	var tree := tree_for(key)
	var node := tree.get_node_by_id(id) if tree else null
	if node == null:
		return "No such skill"
	if rank(key, id) >= node.max_rank:
		return "Maxed"
	for need in node.requires:
		if rank(key, need) == 0:
			var needed := tree.get_node_by_id(need)
			return "Needs %s" % (needed.title if needed else String(need))
	if _points < node.cost:
		return "Needs %d point%s" % [node.cost, "" if node.cost == 1 else "s"]
	return ""


func can_buy(key: String, id: StringName) -> bool:
	return why_not(key, id) == ""


## Buys the next rank of node `id` in `key`'s tree, from the pool. Returns whether it worked.
func buy(key: String, id: StringName) -> bool:
	if not can_buy(key, id):
		return false
	var node := tree_for(key).get_node_by_id(id)
	_points -= node.cost
	if not _ranks.has(key):
		_ranks[key] = {}
	_ranks[key][id] = rank(key, id) + 1
	_changed(key)
	return true


## Gives the pool `count` more points to spend.
func grant_points(count: int) -> void:
	_points += count
	_earned += count
	_changed("")
	_announce_levels(count)


## Takes back everything bought in `key`'s tree, returning its points to the pool.
func refund_all(key: String) -> void:
	var tree := tree_for(key)
	if tree:
		for node in tree.nodes:
			_points += node.cost * rank(key, node.id)
	_ranks.erase(key)
	_changed(key)


## Buys every rank of every node in `key`'s tree for free: for tests and debugging.
func unlock_everything(key: String) -> void:
	var tree := tree_for(key)
	if tree == null:
		return
	_ranks[key] = {}
	for node in tree.nodes:
		_ranks[key][node.id] = node.max_rank
	_changed(key)


## Forgets all progress (not saved until something else changes): for tests.
func reset() -> void:
	_points = 0
	_xp = 0
	_earned = 0
	_stand_xp.clear()
	_ranks.clear()
	changed.emit(PLAYER)


func load_progress() -> void:
	_points = 0
	_xp = 0
	_earned = 0
	_stand_xp.clear()
	_ranks.clear()
	if save_path == "":
		return
	var file := ConfigFile.new()
	if file.load(save_path) != OK:
		return
	var pooled := file.has_section(POOL)
	if pooled:
		_points = int(file.get_value(POOL, "points", 0))
		_xp = int(file.get_value(POOL, "xp", 0))
		_earned = int(file.get_value(POOL, "earned", 0))
	for key in file.get_sections():
		if key == POOL:
			continue
		var ranks := {}
		for name in file.get_section_keys(key):
			if name not in RESERVED:
				ranks[StringName(name)] = int(file.get_value(key, name, 0))
		_ranks[key] = ranks
		if file.has_section_key(key, "stand_xp"):
			_stand_xp[key] = int(file.get_value(key, "stand_xp", 0))
		if not pooled: # Saved when every tree had its own points: they all go into the pool.
			_points += int(file.get_value(key, "points", 0))
			_xp += int(file.get_value(key, "xp", 0))
			var tree_earned := int(file.get_value(key, "earned", 0))
			if not file.has_section_key(key, "earned"): # Older still: about what it had, spent or not.
				tree_earned = int(file.get_value(key, "points", 0))
				for id: StringName in ranks:
					tree_earned += int(ranks[id])
			_earned += tree_earned
			if key != PLAYER and tree_earned > 0:
				_stand_xp[key] = tree_earned * xp_base


func save_progress() -> void:
	if save_path == "":
		return
	var file := ConfigFile.new()
	file.set_value(POOL, "points", _points)
	file.set_value(POOL, "xp", _xp)
	file.set_value(POOL, "earned", _earned)
	for key: String in _stand_xp:
		file.set_value(key, "stand_xp", stand_xp(key))
	for key: String in _ranks:
		for id: StringName in (_ranks[key] as Dictionary):
			file.set_value(key, String(id), _ranks[key][id])
	file.save(save_path)


# `count` levels were just gained: one leveled_up for each, in order.
func _announce_levels(count: int) -> void:
	for i in count:
		leveled_up.emit(level() - count + 1 + i)


func _changed(key: String) -> void:
	save_progress()
	changed.emit(key)
