// Ink outline for stands, drawn as a second pass after stand_manga.gdshader: the mesh is drawn again,
// back faces only, pushed outward along its smoothed normals (CUSTOM0) by a fixed number of screen
// pixels, so a constant-width dark line shows around the silhouette like a manga panel.
// Generated by Claude Code.
shader_type spatial;
render_mode unshaded, cull_front;

#include "res://assets/stands/stand_fade.gdshaderinc"

uniform vec4 ink_color : source_color = vec4(0.05, 0.05, 0.07, 1.0);
uniform float width_pixels = 2.5;

void vertex() {
	vec4 clip = PROJECTION_MATRIX * MODELVIEW_MATRIX * vec4(VERTEX, 1.0);
	vec3 normal = (MODELVIEW_MATRIX * vec4(CUSTOM0.xyz, 0.0)).xyz;
	vec2 push = (PROJECTION_MATRIX * vec4(normal, 0.0)).xy;
	if (length(push) > 0.0001) {
		clip.xy += normalize(push) / VIEWPORT_SIZE * width_pixels * 2.0 * clip.w;
	}
	POSITION = clip;
}

void fragment() {
	if (faded_out(FRAGCOORD.xy)) {
		discard;
	}
	ALBEDO = ink_color.rgb;
}
