// Fading a stand in or out without making it transparent: a dithered dissolve, like a manga screentone.
// `fade` is set per stand mesh (GeometryInstance3D.set_instance_shader_parameter), 1 fully there and 0
// gone; pixels whose spot in a 4 x 4 ordered-dither pattern (in 2-pixel cells) is above it are dropped.
// Included by stand_manga.gdshader and stand_outline.gdshader so the body and its outline fade together.
// Generated by Claude Code.

instance uniform float fade : hint_range(0.0, 1.0) = 1.0;

const float DITHER[16] = float[](
	0.0 / 16.0, 8.0 / 16.0, 2.0 / 16.0, 10.0 / 16.0,
	12.0 / 16.0, 4.0 / 16.0, 14.0 / 16.0, 6.0 / 16.0,
	3.0 / 16.0, 11.0 / 16.0, 1.0 / 16.0, 9.0 / 16.0,
	15.0 / 16.0, 7.0 / 16.0, 13.0 / 16.0, 5.0 / 16.0);

// True where this pixel should be dropped at the current fade.
bool faded_out(vec2 pixel) {
	if (fade >= 1.0) {
		return false;
	}
	ivec2 cell = ivec2(mod(floor(pixel / 2.0), 4.0));
	return fade <= DITHER[cell.x + cell.y * 4];
}
