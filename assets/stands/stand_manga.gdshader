// Manga-style shading for stands (stand_body_model.gd): instead of smooth lighting, each spot is either
// fully lit or in shadow (a hard cel edge), and shadow is drawn as diagonal ink hatching over a darker
// tone, cross-hatched where the surface turns furthest from the light. The hatching is laid out in
// screen pixels, like lines drawn on the page. Lighting uses the mesh's smoothed normals (CUSTOM0) so
// the shadow edge sweeps cleanly over the body instead of following every low-poly facet. Ambient light
// is off: the shadow tone is the only fill. The ink outline is a second pass (stand_outline.gdshader).
// Both dissolve in and out with the stand's `fade` (stand_fade.gdshaderinc).
// `flash` (per mesh, 0 to 1) washes the whole model out to paper white, for a flash on a cue or a hit.
// Generated by Claude Code.
shader_type spatial;
render_mode ambient_light_disabled, specular_disabled;

#include "res://assets/stands/stand_fade.gdshaderinc"

uniform float light_threshold = 0.1; // N.L above this is lit...
uniform float deep_threshold = -0.4; // ...and below this is cross-hatched.
uniform float shadow_tone : hint_range(0.0, 1.0) = 0.6; // Brightness of shadow between the hatch lines...
uniform float ink_tone : hint_range(0.0, 1.0) = 0.15; // ...and of the lines themselves.
uniform float hatch_spacing = 6.0; // Pixels between hatch lines.
uniform float hatch_width : hint_range(0.0, 1.0) = 0.3; // Share of that spacing that's line.
instance uniform float flash : hint_range(0.0, 1.0) = 0.0; // 1 flashes it white.

varying vec3 smooth_normal;

void vertex() {
	smooth_normal = (MODELVIEW_MATRIX * vec4(CUSTOM0.xyz, 0.0)).xyz;
}

void fragment() {
	if (faded_out(FRAGCOORD.xy)) {
		discard;
	}
	ALBEDO = COLOR.rgb;
	NORMAL = normalize(smooth_normal) * (FRONT_FACING ? 1.0 : -1.0);
	ROUGHNESS = 1.0;
	ALBEDO = mix(ALBEDO, vec3(1.0), flash);
	EMISSION = vec3(flash * 0.9);
}

float hatch(vec2 pixel, float direction) {
	return step(fract((pixel.x + direction * pixel.y) / hatch_spacing), hatch_width);
}

void light() {
	if (LIGHT_IS_DIRECTIONAL) {
		float facing = dot(NORMAL, LIGHT);
		float lit = step(light_threshold, facing) * step(0.5, ATTENUATION);
		float lines = hatch(FRAGCOORD.xy, 1.0);
		if (facing < deep_threshold) {
			lines = max(lines, hatch(FRAGCOORD.xy, -1.0));
		}
		DIFFUSE_LIGHT += vec3(mix(mix(shadow_tone, ink_tone, lines), 1.0, lit));
	}
}
