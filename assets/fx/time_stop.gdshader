// The world with time stopped (time_stop_visuals.gd): drained of colour and pushed toward a cold
// green-grey, darker at the edges, and as it starts (and ends) a ring of inverted colour sweeping out from
// `focus` (in screen UV) across the screen. Drawn over everything on a full-screen ColorRect in a CanvasLayer.
// Generated by Claude Code.
shader_type canvas_item;

uniform sampler2D screen : hint_screen_texture, filter_linear;
uniform float amount : hint_range(0.0, 1.0) = 0.0; // How stopped the world looks.
uniform vec2 focus = vec2(0.5, 0.5);
uniform float wave = -1.0; // Radius of the sweeping ring, in screen heights; below 0 there's none.
uniform float wave_width = 0.18;
uniform vec3 tint = vec3(0.62, 0.72, 0.66);

void fragment() {
	vec3 color = texture(screen, SCREEN_UV).rgb;
	float grey = dot(color, vec3(0.299, 0.587, 0.114));
	vec3 stopped = mix(vec3(grey), vec3(grey) * tint * 1.25, 0.6);
	vec2 aspect = vec2(SCREEN_PIXEL_SIZE.y / SCREEN_PIXEL_SIZE.x, 1.0);
	float edge = length((SCREEN_UV - 0.5) * aspect);
	stopped *= 1.0 - 0.45 * smoothstep(0.35, 0.95, edge); // Vignette.
	vec3 shown = mix(color, stopped, amount);
	if (wave >= 0.0) {
		float distance = length((SCREEN_UV - focus) * aspect);
		float ring = 1.0 - smoothstep(0.0, wave_width, abs(distance - wave));
		float inside = 1.0 - step(wave, distance);
		shown = mix(shown, 1.0 - shown, max(ring, inside * 0.35 * (1.0 - amount)));
	}
	COLOR = vec4(shown, 1.0);
}
