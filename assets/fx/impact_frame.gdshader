// A manga "impact frame" for the big hits of a finisher (finisher_director.gd): for a few frames the
// whole screen turns stark - inverted and crushed to pure black and white (`invert` 1), or just crushed
// (`invert` 0) - with ink speed lines bursting out from `focus` (in screen UV). Drawn over everything on a
// full-screen ColorRect in a CanvasLayer.
// Generated by Claude Code.
shader_type canvas_item;

uniform sampler2D screen : hint_screen_texture, filter_linear;
uniform float invert : hint_range(0.0, 1.0) = 1.0;
uniform float threshold : hint_range(0.0, 1.0) = 0.45; // Brightness above this is white, below is black.
uniform vec2 focus = vec2(0.5, 0.5);
uniform float lines = 90.0; // Speed lines round the focus.
uniform float seed = 0.0; // Changes the speed lines each frame.

float hash(float n) {
	return fract(sin(n * 12.9898 + seed * 78.233) * 43758.5453);
}

void fragment() {
	vec3 color = texture(screen, SCREEN_UV).rgb;
	float bright = dot(color, vec3(0.299, 0.587, 0.114));
	float ink = step(threshold, bright); // 1 white, 0 black.
	ink = mix(ink, 1.0 - ink, invert);
	// Speed lines: thin wedges round the focus, starting a little way out from it.
	vec2 aspect = vec2(SCREEN_PIXEL_SIZE.y / SCREEN_PIXEL_SIZE.x, 1.0);
	vec2 to = (SCREEN_UV - focus) * aspect;
	float angle = atan(to.y, to.x) / 6.28318 + 0.5;
	float slot = floor(angle * lines);
	float within = fract(angle * lines);
	float reach = 0.15 + 0.35 * hash(slot);
	float line = step(within, 0.25 * hash(slot + 7.0)) * step(reach, length(to)) * step(0.5, hash(slot + 3.0));
	ink = mix(ink, 1.0 - invert, line);
	COLOR = vec4(vec3(ink), 1.0);
}
