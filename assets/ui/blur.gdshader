// Full-screen blur for menus over the live game (the title screen panorama and the pause menu).
// Samples a blurrier mip of the screen with a small Gaussian kernel, then tints it slightly so menu
// text reads over bright water and sky. blur_amount 0 shows the screen unchanged.
// Generated by Claude Code.
shader_type canvas_item;

uniform sampler2D screen_texture : hint_screen_texture, filter_linear_mipmap;
uniform float blur_amount : hint_range(0.0, 1.0) = 1.0;
uniform float max_lod : hint_range(0.0, 6.0) = 3.0; // Mip level at full blur; each step halves the detail.
uniform vec4 tint : source_color = vec4(0.02, 0.08, 0.12, 0.35); // Alpha is how strongly it tints at full blur.

void fragment() {
	float lod = blur_amount * max_lod;
	// Spread the taps over about one texel of the sampled mip, so neighbouring taps blend smoothly.
	vec2 step_size = SCREEN_PIXEL_SIZE * exp2(lod);
	vec3 sum = vec3(0.0);
	float total = 0.0;
	for (int x = -2; x <= 2; x++) {
		for (int y = -2; y <= 2; y++) {
			vec2 offset = vec2(float(x), float(y));
			float weight = exp(-dot(offset, offset) / 4.0);
			sum += textureLod(screen_texture, SCREEN_UV + offset * step_size, lod).rgb * weight;
			total += weight;
		}
	}
	vec3 blurred = sum / total;
	COLOR = vec4(mix(blurred, tint.rgb, tint.a * blur_amount), 1.0);
}
