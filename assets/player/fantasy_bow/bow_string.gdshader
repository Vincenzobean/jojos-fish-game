// Bends the bow's string (the fantasy bow's straight "Cylinder_3" mesh) into a V when drawn.
// Each vertex is pushed back along +z (toward the archer) by `pull`, scaled down linearly to nothing at
// the limb tips (|y| = half_length), so the string stays tied to the tips and peaks at the nock (y = 0).
// Negative pull bows it forward, and `sway` bends it sideways the same way; both drive the vibration
// after release. Otherwise it's shaded like the original StandardMaterial3D (albedo texture, fully rough).
// Generated by Claude Code.
shader_type spatial;

uniform float pull = 0.0; // Mesh units (the bow model's own scale), + is toward the archer.
uniform float sway = 0.0; // Mesh units the middle is pushed sideways (+x), for the vibration after release.
uniform float half_length = 15.46; // Mesh units from the nock point to either limb tip.
uniform sampler2D albedo_texture : source_color, filter_linear_mipmap, repeat_enable;
uniform float roughness_value : hint_range(0.0, 1.0) = 1.0;

void vertex() {
	float along = clamp(abs(VERTEX.y) / half_length, 0.0, 1.0);
	float bend = 1.0 - along;
	VERTEX.z += pull * bend;
	VERTEX.x += sway * bend;
}

void fragment() {
	ALBEDO = texture(albedo_texture, UV).rgb;
	ROUGHNESS = roughness_value;
}
