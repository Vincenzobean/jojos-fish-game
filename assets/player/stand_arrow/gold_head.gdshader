// Recolors the grey steel of the Stand Arrow's head to metallic gold; the shaft is untouched.
// Generated by Claude Code.
shader_type spatial;
render_mode cull_disabled;

uniform sampler2D albedo_tex : source_color;
uniform sampler2D orm_tex;
uniform sampler2D normal_tex : hint_normal;
uniform vec3 gold : source_color = vec3(1.0, 0.77, 0.34);
// The arrow head lives in the left part of the UV sheet; the shaft is on the right.
uniform float head_uv_max = 0.47;

void fragment() {
	vec4 base = texture(albedo_tex, UV);
	float lum = dot(base.rgb, vec3(0.299, 0.587, 0.114));
	float sat = max(base.r, max(base.g, base.b)) - min(base.r, min(base.g, base.b));
	// Recolor only the grey steel pixels of the head, keep the existing gold and red details.
	float steel = step(UV.x, head_uv_max) * (1.0 - smoothstep(0.15, 0.3, sat));
	ALBEDO = mix(base.rgb, gold * (0.5 + lum), steel);
	vec3 orm = texture(orm_tex, UV).rgb;
	ROUGHNESS = mix(orm.g, 0.3, steel);
	METALLIC = mix(orm.b, 1.0, steel);
	NORMAL_MAP = texture(normal_tex, UV).rgb;
}
