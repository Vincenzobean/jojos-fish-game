// Procedural twisted-rope look: three strands spiraling around the rope, with fine fibers along each strand.
// Generated by Claude Code.
shader_type spatial;

// Length of the rope in meters; rope_visuals.gd updates this so the twist keeps its size as the rope
// pays out. UV.y runs 0-1 along the rope, UV.x around it.
uniform float rope_length = 1.0;
uniform float strands = 3.0;
uniform float twists_per_meter = 14.0;
uniform vec3 light_color : source_color = vec3(0.80, 0.66, 0.42);
uniform vec3 dark_color : source_color = vec3(0.30, 0.20, 0.10);

float hash(vec2 p) {
	return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453);
}

float value_noise(vec2 p) {
	vec2 i = floor(p);
	vec2 f = fract(p);
	f = f * f * (3.0 - 2.0 * f);
	return mix(mix(hash(i), hash(i + vec2(1.0, 0.0)), f.x),
			mix(hash(i + vec2(0.0, 1.0)), hash(i + vec2(1.0, 1.0)), f.x), f.y);
}

void fragment() {
	float along = UV.y * rope_length;
	float phase = UV.x * strands + along * twists_per_meter;
	float band = fract(phase);
	// Rounded strands with a dark groove where two strands meet.
	float ridge = pow(sin(band * 3.14159), 0.6);
	// Fibers run along the strand, so they follow lines of constant band.
	float fibers = value_noise(vec2(band * 40.0, along * 6.0));
	vec3 color = mix(dark_color, light_color, ridge) * (0.75 + 0.5 * fibers);
	ALBEDO = color;
	ROUGHNESS = 0.95;
}
