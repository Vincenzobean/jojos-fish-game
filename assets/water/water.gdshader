// Low-poly stylized water that really moves (Scripts/World/water.gd builds its mesh and feeds it): every
// vertex of the 2 m grid is lifted by the swells, the ripples spreading from wherever something
// disturbed the water, and pushed down under anything hovering low over it, using exactly the same
// sums as water.gd's surface_height_at(), so floating things ride what you see. Each triangle is shaded
// flat (its normal from the screen-space slope of the surface), so the facets tilt as the waves pass.
// Foam caps swell crests, rides ripple rings and rims the dents pushed into the surface; colour fades
// from shallow turquoise to deep blue by how much water is between the surface and whatever is behind
// it, and a foam line appears wherever land meets the surface.
// Generated by Claude Code.
shader_type spatial;
render_mode cull_disabled;

const int MAX_RIPPLES = 48;
const int MAX_PRESSES = 8;
const int SWELLS = 3;

uniform vec4 shallow_color : source_color = vec4(0.25, 0.85, 0.85, 1.0);
uniform vec4 deep_color : source_color = vec4(0.02, 0.32, 0.68, 1.0);
uniform vec4 foam_color : source_color = vec4(0.93, 0.98, 1.0, 1.0);
uniform float max_depth = 6.0; // Water thickness at which the colour is fully "deep".
uniform float shore_alpha = 0.35; // How see-through the water is right where it meets land.
uniform float body_alpha = 0.88; // How opaque it is once you're a little way from shore.
uniform float shore_fade = 0.6; // How far from shore (in meters of water) the water takes to become opaque.
uniform float foam_width = 0.4;
uniform float facet_color_variation = 0.05;
uniform float facet_tilt = 5.0; // Shading exaggerates how much each facet tilts, so gentle swells still read as facets.
uniform float swell_foam = 0.16; // Swells higher than this (meters) wear foam on their crests.
uniform float displace_from = 80.0; // Meters from the middle of the mesh the movement starts fading...
uniform float displace_to = 94.0; // ...and where it's gone (the coarse skirt stays flat).
uniform sampler2D depth_texture : hint_depth_texture, repeat_disable, filter_nearest;

// Fed every frame by water.gd.
uniform float water_time = 0.0;
uniform vec4 swells[SWELLS]; // direction x, direction z, wavelength, height.
uniform vec4 ripples[MAX_RIPPLES]; // x, z, start time, height.
uniform vec4 ripple_shapes[MAX_RIPPLES]; // wavelength, speed, damping, life.
uniform vec4 presses[MAX_PRESSES]; // x, z, radius, depth.

varying vec3 world_pos;
varying flat float foam; // One amount per facet.

float hash(vec2 p) {
	return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453);
}

// Mirrors water.gd _swell().
float swell(vec2 p) {
	float height = 0.0;
	for (int i = 0; i < SWELLS; i++) {
		vec4 s = swells[i];
		if (s.z <= 0.0) {
			continue;
		}
		float k = 6.2831853 / s.z;
		float omega = sqrt(9.8 * k);
		height += s.w * sin(k * dot(s.xy, p) - omega * water_time);
	}
	return height;
}

// Mirrors water.gd _ripple().
float ripple(vec2 p) {
	float height = 0.0;
	for (int i = 0; i < MAX_RIPPLES; i++) {
		vec4 r = ripples[i];
		vec4 shape = ripple_shapes[i];
		float age = water_time - r.z;
		if (r.w == 0.0 || age < 0.0 || age > shape.w) {
			continue;
		}
		float front = shape.y * age;
		float width = shape.x * 0.9 + front * 0.1;
		float dist = length(p - r.xy);
		if (abs(dist - front) > width * 2.5) {
			continue;
		}
		float envelope = exp(-pow((dist - front) / width, 2.0));
		float fade = exp(-age * shape.z) / sqrt(1.0 + front * 0.5) * smoothstep(0.0, 0.12, age) * (1.0 - smoothstep(shape.w * 0.7, shape.w, age));
		height += r.w * envelope * fade * cos(6.2831853 * (dist - front) / shape.x);
	}
	return height;
}

// Mirrors water.gd _pressed().
float pressed(vec2 p) {
	float depth = 0.0;
	for (int i = 0; i < MAX_PRESSES; i++) {
		vec4 q = presses[i];
		if (q.w == 0.0) {
			continue;
		}
		float dist = length(p - q.xy);
		depth += q.w * exp(-2.0 * pow(dist / q.z, 2.0));
	}
	return depth;
}

void vertex() {
	vec3 base = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
	float edge = max(abs(VERTEX.x), abs(VERTEX.z));
	float moving = 1.0 - smoothstep(displace_from, displace_to, edge);
	float s = 0.0;
	float r = 0.0;
	float d = 0.0;
	if (moving > 0.0) {
		s = swell(base.xz);
		r = ripple(base.xz);
		d = pressed(base.xz);
	}
	VERTEX.y += (s + r - d) * moving;
	world_pos = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
	// Foam: on the swells' crests, along ripple rings, and round the rim of a dent pushed in.
	float crest = smoothstep(swell_foam, swell_foam + 0.06, s);
	float rings = smoothstep(0.02, 0.09, abs(r));
	float rim = smoothstep(0.05, 0.25, d) * 0.8;
	foam = clamp(crest * 0.4 + rings + rim, 0.0, 1.0) * moving;
}

void fragment() {
	// Flat shading: the slope of the surface across this triangle, the same for all of it.
	vec3 facet = normalize(cross(dFdy(world_pos), dFdx(world_pos)));
	if (facet.y < 0.0) {
		facet = -facet;
	}
	facet = normalize(vec3(facet.x * facet_tilt, facet.y, facet.z * facet_tilt));
	NORMAL = (VIEW_MATRIX * vec4(facet, 0.0)).xyz;
	if (!FRONT_FACING) {
		NORMAL = -NORMAL; // Seen from underneath (sinking).
	}

	// How much water lies between the surface and the nearest thing behind it along the view ray.
	float scene_depth = texture(depth_texture, SCREEN_UV).x;
	vec3 ndc = vec3(SCREEN_UV * 2.0 - 1.0, scene_depth);
	vec4 view = INV_PROJECTION_MATRIX * vec4(ndc, 1.0);
	view.xyz /= view.w;
	float thickness = max(-view.z + VERTEX.z, 0.0);

	vec2 cell = floor(world_pos.xz / 2.0);
	vec3 colour = mix(shallow_color.rgb, deep_color.rgb, clamp(thickness / max_depth, 0.0, 1.0));
	colour *= 1.0 + (hash(cell) - 0.5) * 2.0 * facet_color_variation;
	float shore = 1.0 - smoothstep(0.0, foam_width, thickness);
	colour = mix(colour, foam_color.rgb, clamp(shore * 0.85 + foam * 0.8, 0.0, 1.0));

	ALBEDO = colour;
	ALPHA = mix(shore_alpha, body_alpha, smoothstep(0.0, shore_fade, thickness));
	ALPHA = max(ALPHA, foam * 0.9);
	ROUGHNESS = 0.2;
	SPECULAR = 0.6;
}
